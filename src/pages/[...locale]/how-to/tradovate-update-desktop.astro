---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-update-desktop";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Update the Tradovate Desktop App";
const META_DESCRIPTION =
  "Tradovate desktop app stuck on an old build? Apply the in-app update or reinstall the latest version in minutes and get back to trading fast.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Die Tradovate-Desktop-App aktualisieren", es: "Cómo actualizar la aplicación de escritorio de Tradovate", fr: "Mettre à jour l'application de bureau Tradovate", it: "Aggiornare l'app desktop di Tradovate" },
  dek: { en: "The Tradovate desktop platform is built to update itself. When that breaks, here's the reliable fix: take the in-app update when it appears, and if that stalls, fully quit and reinstall.", de: "Die Tradovate-Desktop-Plattform aktualisiert sich selbst. Wenn das nicht klappt, ist dies die zuverlässige Lösung: das In-App-Update annehmen, sobald es erscheint, und falls es hängt, die App vollständig beenden und neu installieren.", es: "La plataforma de escritorio de Tradovate está diseñada para actualizarse sola. Cuando eso falla, esta es la solución fiable: acepte la actualización integrada cuando aparezca y, si se atasca, cierre por completo la aplicación y reinstálela.", fr: "La plateforme de bureau Tradovate est conçue pour se mettre à jour toute seule. Quand cela ne fonctionne plus, voici la solution fiable : acceptez la mise à jour intégrée lorsqu'elle apparaît et, si elle se bloque, quittez complètement l'application puis réinstallez-la.", it: "La piattaforma desktop di Tradovate è progettata per aggiornarsi da sola. Quando non funziona, ecco la soluzione affidabile: accetti l'aggiornamento integrato quando compare e, se si blocca, chiuda completamente l'app e la reinstalli." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "The Tradovate desktop platform is built to update itself. Most days you just launch it, it grabs the newest build before you log in, and you're trading. When that breaks, the update prompt does nothing, or you're stuck on a stale version, the reliable fix is to take the in-app update when it appears, and if that stalls, fully quit the app and reinstall the current build from Tradovate's download page. Your orders live in the cloud, so reinstalling won't touch open positions." },
    { type: "heading", text: "How Tradovate Desktop Updates Work" },
    { type: "paragraph", html: "The app checks for a newer build every time it starts. When one's waiting, it patches itself before it lets you sign in, that's why you sometimes sit through a short update on launch. It's quick, usually under a minute. The trouble starts when that automatic path jams: the prompt shows up but nothing installs, or the app reopens on the same old version. Then you finish the job by hand." },
    { type: "heading", text: "Update the Tradovate Desktop App: Step by Step" },
    {
      type: "steps",
      items: [
        { title: "Confirm You're on an Old Build", html: "Before you reinstall anything, check what you're actually running. Open the app's <strong class='text-white'>About</strong> or version screen, usually tucked under a menu or the settings area, and note the build number. Compare it against the current version shown on Tradovate's download page. If they match, your app is already current and your problem is something else. If they don't, keep going." },
        { title: "Take the Built-In Update When It Appears", html: "Most of the time you don't have to do anything clever. Launch the desktop app and let it check for a new build. If an update prompt shows up, often a button labeled something like <strong class='text-white'>Install and relaunch</strong>, click it and let the app close, patch, and reopen by itself. Once it's back, recheck the version from Step 1. If you're current, you're done." },
        { title: "Fully Quit Tradovate if the Update Stalls", html: "Sometimes the prompt does nothing, or the app relaunches on the same stale build. When the auto-updater won't cooperate, close the app <em>completely</em>, not just the window. On Windows, right-click the taskbar icon and choose Close, or end the process from Task Manager. On Mac, quit from the menu bar or Force Quit so no copy keeps running in the background. A lingering process is the usual reason a fresh install \"doesn't take.\"" },
        { title: "Download the Current Installer", html: "Head to Tradovate's official devices/download page and grab the installer for your system, there's a separate <strong class='text-white'>Download Windows</strong> and <strong class='text-white'>Download Mac</strong> option. This is always the latest released build, so it skips past whatever jammed the in-app updater." },
        { title: "Reinstall and Sign Back In", html: "Run the downloaded installer and let it replace your old copy. Reopen the app, log in, and check the version one more time to confirm you're current. Your orders and account data live in Tradovate's cloud, not on your machine, so a clean reinstall won't touch open positions, working orders, or history, it only swaps the software." },
      ],
    },
    { type: "heading", text: "If the Update Still Won't Stick" },
    { type: "paragraph", html: "A couple of things trip up an otherwise clean update:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Your system clock is off.</strong> If your computer's time is wrong, the secure connection the updater and login rely on can fail. Set your clock to sync automatically, then try again.",
        "<strong class='text-white'>The screen goes black or blank after updating.</strong> That's usually a display or cache issue rather than a broken install.",
        "<strong class='text-white'>It freezes right after the new build.</strong> If the platform locks up mid-session on a fresh version, that often points to a platform-side hiccup, not your machine.",
      ],
    },
    { type: "paragraph", html: "One note for prop-firm and evaluation traders: your firm controls which platform build and features your account can use, and those rules vary by firm and account size. Check your firm's current requirements if a fresh install still won't connect." },
    { type: "heading", text: "Keep Your Automation Running Through Updates" },
    { type: "paragraph", html: "Here's the catch with desktop updates: your strategy stops the second the app closes to patch itself. PickMyTrade runs your TradingView-to-Tradovate automation server-side, so a routine update, or a full reinstall, never pauses your orders. Set it once and your validated trades keep routing whether the desktop app is open or not." },
  ], de: [
    { type: "paragraph",html: "Die Tradovate-Desktop-Plattform aktualisiert sich selbst. An den meisten Tagen starten Sie sie einfach, sie lädt vor der Anmeldung den neuesten Build, und Sie handeln. Wenn das nicht funktioniert, die Update-Aufforderung nichts bewirkt oder Sie auf einer veralteten Version festhängen, ist die zuverlässige Lösung, das In-App-Update anzunehmen, sobald es erscheint, und falls es hängt, die App vollständig zu beenden und den aktuellen Build von der Download-Seite von Tradovate neu zu installieren. Ihre Orders liegen in der Cloud, eine Neuinstallation berührt also keine offenen Positionen." },
    { type: "heading",text: "So funktionieren Tradovate-Desktop-Updates" },
    { type: "paragraph",html: "Die App prüft bei jedem Start, ob es einen neueren Build gibt. Wartet einer, aktualisiert sie sich selbst, bevor sie die Anmeldung zulässt, deshalb sitzen Sie beim Start manchmal ein kurzes Update aus. Das geht schnell, meist in unter einer Minute. Probleme beginnen, wenn dieser automatische Weg klemmt: Die Aufforderung erscheint, aber nichts wird installiert, oder die App öffnet sich wieder mit derselben alten Version. Dann erledigen Sie die Arbeit von Hand." },
    { type: "heading",text: "Die Tradovate-Desktop-App aktualisieren: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Prüfen, ob Sie einen alten Build verwenden", html: "Bevor Sie irgendetwas neu installieren, prüfen Sie, was tatsächlich läuft. Öffnen Sie den Bildschirm <strong class='text-white'>About</strong> bzw. den Versionsbildschirm der App, meist unter einem Menü oder im Einstellungsbereich versteckt, und notieren Sie die Build-Nummer. Vergleichen Sie sie mit der aktuellen Version auf der Download-Seite von Tradovate. Stimmen sie überein, ist Ihre App bereits aktuell und Ihr Problem liegt woanders. Wenn nicht, machen Sie weiter." },
        { title: "Das integrierte Update annehmen, sobald es erscheint", html: "Meistens müssen Sie nichts Besonderes tun. Starten Sie die Desktop-App und lassen Sie sie nach einem neuen Build suchen. Erscheint eine Update-Aufforderung, oft eine Schaltfläche mit einer Beschriftung wie <strong class='text-white'>Install and relaunch</strong>, klicken Sie darauf und lassen Sie die App sich schließen, aktualisieren und von selbst wieder öffnen. Sobald sie wieder läuft, prüfen Sie die Version erneut wie in Schritt 1. Sind Sie aktuell, sind Sie fertig." },
        { title: "Tradovate vollständig beenden, wenn das Update hängt", html: "Manchmal bewirkt die Aufforderung nichts, oder die App startet auf demselben veralteten Build neu. Wenn der automatische Updater nicht mitspielt, schließen Sie die App <em>vollständig</em>, nicht nur das Fenster. Unter Windows klicken Sie mit der rechten Maustaste auf das Taskleistensymbol und wählen Schließen, oder Sie beenden den Prozess im Task-Manager. Auf dem Mac beenden Sie die App über die Menüleiste oder per „Sofort beenden“, damit keine Kopie im Hintergrund weiterläuft. Ein verbliebener Prozess ist der übliche Grund dafür, dass eine frische Installation „nicht greift“." },
        { title: "Den aktuellen Installer herunterladen", html: "Rufen Sie die offizielle Geräte-/Download-Seite von Tradovate auf und laden Sie den Installer für Ihr System herunter, es gibt jeweils eine eigene Option <strong class='text-white'>Download Windows</strong> und <strong class='text-white'>Download Mac</strong>. Das ist immer der neueste veröffentlichte Build und umgeht damit alles, was den In-App-Updater blockiert hat." },
        { title: "Neu installieren und wieder anmelden", html: "Führen Sie den heruntergeladenen Installer aus und lassen Sie ihn Ihre alte Version ersetzen. Öffnen Sie die App erneut, melden Sie sich an und prüfen Sie die Version noch einmal, um zu bestätigen, dass Sie aktuell sind. Ihre Orders und Kontodaten liegen in der Cloud von Tradovate und nicht auf Ihrem Rechner, daher berührt eine saubere Neuinstallation weder offene Positionen noch aktive Orders noch den Verlauf, sie tauscht nur die Software aus." },
      ],
    },
    { type: "heading",text: "Wenn das Update nicht haften bleibt" },
    { type: "paragraph",html: "Ein paar Dinge bringen ein ansonsten sauberes Update aus dem Tritt:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Ihre Systemuhr geht falsch.</strong> Wenn die Uhrzeit Ihres Computers nicht stimmt, kann die sichere Verbindung scheitern, auf die sich Updater und Anmeldung stützen. Stellen Sie die Uhr auf automatische Synchronisierung und versuchen Sie es erneut.",
        "<strong class='text-white'>Der Bildschirm wird nach dem Update schwarz oder leer.</strong> Das ist meist ein Anzeige- oder Cache-Problem und keine defekte Installation.",
        "<strong class='text-white'>Es friert direkt nach dem neuen Build ein.</strong> Wenn die Plattform mitten in der Sitzung mit einer frischen Version hängen bleibt, deutet das oft auf ein Problem auf Seiten der Plattform hin, nicht auf Ihren Rechner.",
      ],
    },
    { type: "paragraph",html: "Ein Hinweis für Trader von Prop-Firmen und Evaluierungen: Ihre Firma bestimmt, welchen Plattform-Build und welche Funktionen Ihr Konto nutzen darf, und diese Regeln variieren je nach Firma und Kontogröße. Prüfen Sie die aktuellen Anforderungen Ihrer Firma, falls eine frische Installation sich trotzdem nicht verbindet." },
    { type: "heading",text: "So läuft Ihre Automatisierung bei Updates weiter" },
    { type: "paragraph",html: "Bei Desktop-Updates gibt es einen Haken: Ihre Strategie stoppt in dem Moment, in dem die App sich zum Aktualisieren schließt. PickMyTrade führt Ihre Automatisierung von TradingView zu Tradovate serverseitig aus, sodass ein routinemäßiges Update oder eine vollständige Neuinstallation Ihre Orders nie unterbricht. Richten Sie es einmal ein, und Ihre validierten Trades werden weitergeleitet, egal ob die Desktop-App geöffnet ist oder nicht." },
  ], es: [
    { type: "paragraph",html: "La plataforma de escritorio de Tradovate está diseñada para actualizarse sola. La mayoría de los días simplemente la abre, descarga la compilación más reciente antes de que inicie sesión, y ya está operando. Cuando eso falla, el aviso de actualización no hace nada o se queda en una versión obsoleta, la solución fiable es aceptar la actualización integrada cuando aparezca y, si se atasca, cerrar por completo la aplicación y reinstalar la compilación actual desde la página de descargas de Tradovate. Sus órdenes están en la nube, así que reinstalar no afectará a las posiciones abiertas." },
    { type: "heading",text: "Cómo funcionan las actualizaciones de escritorio de Tradovate" },
    { type: "paragraph",html: "La aplicación busca una compilación más reciente cada vez que se inicia. Cuando hay una esperando, se parchea sola antes de permitirle iniciar sesión; por eso a veces espera una breve actualización al arrancar. Es rápido, normalmente menos de un minuto. El problema empieza cuando ese camino automático se atasca: el aviso aparece pero no se instala nada, o la aplicación se reabre con la misma versión antigua. Entonces termina el trabajo a mano." },
    { type: "heading",text: "Cómo actualizar la aplicación de escritorio de Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Confirme que tiene una compilación antigua", html: "Antes de reinstalar nada, compruebe qué versión está ejecutando realmente. Abra la pantalla <strong class='text-white'>About</strong> o de versión de la aplicación, normalmente escondida bajo un menú o en el área de ajustes, y anote el número de compilación. Compárelo con la versión actual que aparece en la página de descargas de Tradovate. Si coinciden, su aplicación ya está al día y su problema es otro. Si no coinciden, continúe." },
        { title: "Acepte la actualización integrada cuando aparezca", html: "La mayoría de las veces no tiene que hacer nada ingenioso. Inicie la aplicación de escritorio y deje que busque una nueva compilación. Si aparece un aviso de actualización, a menudo un botón con un texto como <strong class='text-white'>Install and relaunch</strong>, haga clic en él y deje que la aplicación se cierre, se actualice y se reabra sola. Cuando vuelva, compruebe de nuevo la versión como en el paso 1. Si está al día, ha terminado." },
        { title: "Cierre Tradovate por completo si la actualización se atasca", html: "A veces el aviso no hace nada, o la aplicación se reinicia con la misma compilación obsoleta. Cuando el actualizador automático no coopera, cierre la aplicación <em>por completo</em>, no solo la ventana. En Windows, haga clic con el botón derecho en el icono de la barra de tareas y elija Cerrar, o finalice el proceso desde el Administrador de tareas. En Mac, salga desde la barra de menús o use Forzar salida para que ninguna copia siga ejecutándose en segundo plano. Un proceso residual es la razón habitual por la que una instalación nueva «no se aplica»." },
        { title: "Descargue el instalador actual", html: "Vaya a la página oficial de dispositivos/descargas de Tradovate y obtenga el instalador para su sistema; hay una opción independiente <strong class='text-white'>Download Windows</strong> y <strong class='text-white'>Download Mac</strong>. Esta es siempre la última compilación publicada, así que evita lo que haya atascado al actualizador integrado." },
        { title: "Reinstale e inicie sesión de nuevo", html: "Ejecute el instalador descargado y deje que reemplace su copia anterior. Vuelva a abrir la aplicación, inicie sesión y compruebe la versión una vez más para confirmar que está al día. Sus órdenes y datos de cuenta están en la nube de Tradovate, no en su equipo, así que una reinstalación limpia no afectará a las posiciones abiertas, las órdenes activas ni el historial; solo cambia el software." },
      ],
    },
    { type: "heading",text: "Si la actualización sigue sin aplicarse" },
    { type: "paragraph",html: "Un par de cosas pueden estropear una actualización que por lo demás es limpia:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>El reloj de su sistema está desajustado.</strong> Si la hora de su ordenador es incorrecta, la conexión segura en la que se apoyan el actualizador y el inicio de sesión puede fallar. Configure el reloj para que se sincronice automáticamente y vuelva a intentarlo.",
        "<strong class='text-white'>La pantalla se queda negra o en blanco tras actualizar.</strong> Suele ser un problema de pantalla o de caché más que una instalación rota.",
        "<strong class='text-white'>Se congela justo después de la nueva compilación.</strong> Si la plataforma se bloquea durante la sesión con una versión recién instalada, suele apuntar a un fallo del lado de la plataforma, no de su equipo.",
      ],
    },
    { type: "paragraph",html: "Una nota para los traders de prop firms y evaluaciones: su firma controla qué compilación de la plataforma y qué funciones puede usar su cuenta, y esas reglas varían según la firma y el tamaño de la cuenta. Consulte los requisitos vigentes de su firma si una instalación nueva sigue sin conectarse." },
    { type: "heading",text: "Mantenga su automatización en marcha durante las actualizaciones" },
    { type: "paragraph",html: "Este es el problema de las actualizaciones de escritorio: su estrategia se detiene en el momento en que la aplicación se cierra para parchearse. PickMyTrade ejecuta su automatización de TradingView a Tradovate en el servidor, así que una actualización rutinaria, o una reinstalación completa, nunca detiene sus órdenes. Configúrelo una vez y sus operaciones validadas seguirán enrutándose, esté o no abierta la aplicación de escritorio." },
  ], fr: [
    { type: "paragraph",html: "La plateforme de bureau Tradovate est conçue pour se mettre à jour toute seule. La plupart du temps, vous la lancez, elle récupère le build le plus récent avant votre connexion, et vous tradez. Quand cela ne fonctionne plus, que l'invite de mise à jour ne fait rien ou que vous restez bloqué sur une version obsolète, la solution fiable consiste à accepter la mise à jour intégrée lorsqu'elle apparaît puis, si elle se bloque, à quitter complètement l'application et à réinstaller le build actuel depuis la page de téléchargement de Tradovate. Vos ordres sont dans le cloud : réinstaller ne touchera donc pas aux positions ouvertes." },
    { type: "heading",text: "Comment fonctionnent les mises à jour de bureau de Tradovate" },
    { type: "paragraph",html: "L'application recherche un build plus récent à chaque démarrage. Lorsqu'il y en a un, elle se met à jour avant de vous laisser vous connecter ; c'est pourquoi vous patientez parfois pendant une brève mise à jour au lancement. C'est rapide, généralement moins d'une minute. Les problèmes commencent lorsque ce chemin automatique se grippe : l'invite s'affiche mais rien ne s'installe, ou l'application se rouvre avec la même ancienne version. Vous terminez alors le travail à la main." },
    { type: "heading",text: "Mettre à jour l'application de bureau Tradovate : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Vérifiez que vous utilisez un ancien build", html: "Avant de réinstaller quoi que ce soit, vérifiez ce que vous exécutez réellement. Ouvrez l'écran <strong class='text-white'>About</strong> ou version de l'application, généralement caché sous un menu ou dans la zone des paramètres, et notez le numéro de build. Comparez-le à la version actuelle indiquée sur la page de téléchargement de Tradovate. Si les deux correspondent, votre application est déjà à jour et votre problème est ailleurs. Sinon, poursuivez." },
        { title: "Acceptez la mise à jour intégrée lorsqu'elle apparaît", html: "La plupart du temps, vous n'avez rien d'ingénieux à faire. Lancez l'application de bureau et laissez-la rechercher un nouveau build. Si une invite de mise à jour s'affiche, souvent un bouton intitulé quelque chose comme <strong class='text-white'>Install and relaunch</strong>, cliquez dessus et laissez l'application se fermer, se mettre à jour et se rouvrir toute seule. Une fois de retour, revérifiez la version comme à l'étape 1. Si vous êtes à jour, c'est terminé." },
        { title: "Quittez complètement Tradovate si la mise à jour se bloque", html: "Parfois l'invite ne fait rien, ou l'application redémarre sur le même build obsolète. Quand le programme de mise à jour automatique ne coopère pas, fermez l'application <em>complètement</em>, et pas seulement la fenêtre. Sous Windows, faites un clic droit sur l'icône de la barre des tâches et choisissez Fermer, ou terminez le processus depuis le Gestionnaire des tâches. Sur Mac, quittez depuis la barre de menus ou utilisez Forcer à quitter afin qu'aucune copie ne continue de tourner en arrière-plan. Un processus persistant est la raison habituelle pour laquelle une installation toute neuve « ne prend pas »." },
        { title: "Téléchargez le programme d'installation actuel", html: "Rendez-vous sur la page officielle des appareils/téléchargements de Tradovate et récupérez le programme d'installation correspondant à votre système ; il existe une option <strong class='text-white'>Download Windows</strong> et une option <strong class='text-white'>Download Mac</strong> distinctes. Il s'agit toujours du dernier build publié, ce qui contourne ce qui a bloqué le programme de mise à jour intégré." },
        { title: "Réinstallez et reconnectez-vous", html: "Lancez le programme d'installation téléchargé et laissez-le remplacer votre ancienne copie. Rouvrez l'application, connectez-vous et vérifiez une dernière fois la version pour confirmer que vous êtes à jour. Vos ordres et les données de votre compte se trouvent dans le cloud de Tradovate, et non sur votre machine ; une réinstallation propre ne touchera donc ni aux positions ouvertes, ni aux ordres actifs, ni à l'historique, elle ne fait que remplacer le logiciel." },
      ],
    },
    { type: "heading",text: "Si la mise à jour ne passe toujours pas" },
    { type: "paragraph",html: "Quelques éléments peuvent faire échouer une mise à jour par ailleurs propre :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>L'horloge de votre système est décalée.</strong> Si l'heure de votre ordinateur est incorrecte, la connexion sécurisée sur laquelle reposent le programme de mise à jour et la connexion peut échouer. Réglez l'horloge pour qu'elle se synchronise automatiquement, puis réessayez.",
        "<strong class='text-white'>L'écran devient noir ou vide après la mise à jour.</strong> Il s'agit généralement d'un problème d'affichage ou de cache plutôt que d'une installation défectueuse.",
        "<strong class='text-white'>Elle se fige juste après le nouveau build.</strong> Si la plateforme se bloque en pleine session avec une version toute fraîche, cela renvoie souvent à un incident côté plateforme, et non à votre machine.",
      ],
    },
    { type: "paragraph",html: "Une remarque pour les traders de prop firms et d'évaluations : votre firme contrôle le build de la plateforme et les fonctionnalités que votre compte peut utiliser, et ces règles varient selon la firme et la taille du compte. Consultez les exigences en vigueur de votre firme si une installation toute neuve ne parvient toujours pas à se connecter." },
    { type: "heading",text: "Gardez votre automatisation active pendant les mises à jour" },
    { type: "paragraph",html: "Voici le piège des mises à jour de bureau : votre stratégie s'arrête à la seconde où l'application se ferme pour se mettre à jour. PickMyTrade exécute votre automatisation TradingView vers Tradovate côté serveur ; une mise à jour de routine, ou même une réinstallation complète, ne met donc jamais vos ordres en pause. Configurez-la une fois et vos trades validés continuent d'être acheminés, que l'application de bureau soit ouverte ou non." },
  ], it: [
    { type: "paragraph",html: "La piattaforma desktop di Tradovate è progettata per aggiornarsi da sola. Quasi sempre la avvia semplicemente, scarica la build più recente prima dell'accesso e inizia a operare. Quando non funziona, la richiesta di aggiornamento non fa nulla o resta su una versione obsoleta, la soluzione affidabile è accettare l'aggiornamento integrato quando compare e, se si blocca, chiudere completamente l'app e reinstallare la build attuale dalla pagina di download di Tradovate. I suoi ordini risiedono nel cloud, quindi reinstallare non toccherà le posizioni aperte." },
    { type: "heading",text: "Come funzionano gli aggiornamenti desktop di Tradovate" },
    { type: "paragraph",html: "L'app cerca una build più recente a ogni avvio. Quando ce n'è una disponibile, si aggiorna da sola prima di consentirle l'accesso, ed è per questo che a volte attende un breve aggiornamento all'avvio. È rapido, di solito meno di un minuto. I problemi iniziano quando questo percorso automatico si inceppa: la richiesta compare ma non si installa nulla, oppure l'app si riapre con la stessa vecchia versione. A quel punto completa il lavoro a mano." },
    { type: "heading",text: "Aggiornare l'app desktop di Tradovate: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Verifichi di avere una build obsoleta", html: "Prima di reinstallare qualsiasi cosa, controlli che cosa sta realmente eseguendo. Apra la schermata <strong class='text-white'>About</strong> o della versione dell'app, di solito nascosta in un menu o nell'area delle impostazioni, e annoti il numero di build. Lo confronti con la versione attuale mostrata nella pagina di download di Tradovate. Se coincidono, la sua app è già aggiornata e il problema è un altro. Se non coincidono, proceda." },
        { title: "Accetti l'aggiornamento integrato quando compare", html: "Per lo più non deve fare nulla di ingegnoso. Avvii l'app desktop e lasci che cerchi una nuova build. Se compare una richiesta di aggiornamento, spesso un pulsante con un'etichetta del tipo <strong class='text-white'>Install and relaunch</strong>, vi clicchi e lasci che l'app si chiuda, si aggiorni e si riapra da sola. Quando è tornata, ricontrolli la versione come al passaggio 1. Se è aggiornata, ha finito." },
        { title: "Chiuda completamente Tradovate se l'aggiornamento si blocca", html: "A volte la richiesta non fa nulla, oppure l'app si riavvia sulla stessa build obsoleta. Quando l'aggiornatore automatico non collabora, chiuda l'app <em>completamente</em>, non solo la finestra. Su Windows, faccia clic con il tasto destro sull'icona nella barra delle applicazioni e scelga Chiudi, oppure termini il processo da Gestione attività. Su Mac, esca dalla barra dei menu o usi Uscita forzata, in modo che nessuna copia continui a girare in background. Un processo rimasto attivo è il motivo abituale per cui un'installazione nuova «non ha effetto»." },
        { title: "Scarichi il programma di installazione attuale", html: "Vada alla pagina ufficiale dei dispositivi/download di Tradovate e scarichi il programma di installazione per il suo sistema: ci sono opzioni separate <strong class='text-white'>Download Windows</strong> e <strong class='text-white'>Download Mac</strong>. È sempre l'ultima build rilasciata, quindi aggira ciò che ha bloccato l'aggiornatore integrato." },
        { title: "Reinstalli e acceda di nuovo", html: "Esegua il programma di installazione scaricato e lasci che sostituisca la vecchia copia. Riapra l'app, acceda e ricontrolli la versione ancora una volta per confermare di essere aggiornato. I suoi ordini e i dati del conto risiedono nel cloud di Tradovate, non sul suo computer, quindi una reinstallazione pulita non toccherà posizioni aperte, ordini attivi o storico, ma sostituirà soltanto il software." },
      ],
    },
    { type: "heading",text: "Se l'aggiornamento continua a non funzionare" },
    { type: "paragraph",html: "Un paio di fattori possono far fallire un aggiornamento altrimenti pulito:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>L'orologio di sistema è sbagliato.</strong> Se l'ora del computer è errata, la connessione sicura su cui si basano l'aggiornatore e l'accesso può non riuscire. Imposti l'orologio in modo che si sincronizzi automaticamente, quindi riprovi.",
        "<strong class='text-white'>Lo schermo diventa nero o vuoto dopo l'aggiornamento.</strong> Di solito è un problema di visualizzazione o di cache più che di un'installazione danneggiata.",
        "<strong class='text-white'>Si blocca subito dopo la nuova build.</strong> Se la piattaforma si blocca a metà sessione su una versione appena installata, spesso indica un problema lato piattaforma, non del suo computer.",
      ],
    },
    { type: "paragraph",html: "Una nota per i trader di prop firm e valutazioni: la sua firm controlla quale build della piattaforma e quali funzionalità il suo conto può usare, e queste regole variano in base alla firm e alla dimensione del conto. Controlli i requisiti attuali della sua firm se una nuova installazione continua a non connettersi." },
    { type: "heading",text: "Mantenga attiva la sua automazione durante gli aggiornamenti" },
    { type: "paragraph",html: "Ecco il problema degli aggiornamenti desktop: la sua strategia si ferma nel momento in cui l'app si chiude per aggiornarsi. PickMyTrade esegue la sua automazione da TradingView a Tradovate lato server, quindi un aggiornamento di routine, o una reinstallazione completa, non mette mai in pausa i suoi ordini. La imposti una volta e i suoi trade validati continueranno a essere instradati, che l'app desktop sia aperta o meno." },
  ] },
  ctaHeading: { en: "Keep Trading Through Every Update", de: "Handeln Sie bei jedem Update weiter", es: "Siga operando durante cada actualización", fr: "Continuez à trader malgré chaque mise à jour", it: "Continui a fare trading durante ogni aggiornamento" },
  ctaText: { en: "PickMyTrade runs your TradingView-to-Tradovate automation server-side, so a desktop update never pauses your orders.", de: "PickMyTrade führt Ihre Automatisierung von TradingView zu Tradovate serverseitig aus, sodass ein Desktop-Update Ihre Orders nie unterbricht.", es: "PickMyTrade ejecuta su automatización de TradingView a Tradovate en el servidor, así que una actualización del escritorio nunca detiene sus órdenes.", fr: "PickMyTrade exécute votre automatisation TradingView vers Tradovate côté serveur : une mise à jour du bureau ne met donc jamais vos ordres en pause.", it: "PickMyTrade esegue la sua automazione da TradingView a Tradovate lato server, così un aggiornamento del desktop non mette mai in pausa i suoi ordini." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "How do I know which version of the desktop app I have?", a: "Open the app's About or version screen and note the build number, then compare it to the current version on Tradovate's download page. If the two differ, you're due for an update." },
    { q: "Will reinstalling the desktop app delete my orders or settings?", a: "No. Your account data, positions, and working orders are stored in Tradovate's cloud, not on your computer. A reinstall only replaces the app itself, so you'll see the same account after you log back in." },
