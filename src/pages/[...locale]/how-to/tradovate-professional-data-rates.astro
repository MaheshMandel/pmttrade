---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-professional-data-rates";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Tradovate Professional Market Data Rates";
const META_DESCRIPTION =
  "Professional futures data costs far more than non-pro. Learn who qualifies as non-professional and how to keep the low monthly market-data rate.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate: Gebühren für professionelle Marktdaten", es: "Tarifas de datos de mercado profesionales de Tradovate", fr: "Tarifs des données de marché professionnelles de Tradovate", it: "Tariffe dei dati di mercato professionali di Tradovate" },
  dek: { en: "Market data on Tradovate isn't one flat price. What you pay comes down to a single label: non-professional or professional subscriber. Here's how to get it right.", de: "Marktdaten bei Tradovate haben keinen einheitlichen Preis. Was Sie zahlen, hängt von einem einzigen Merkmal ab: Nicht-professioneller oder professioneller Abonnent. So ordnen Sie sich richtig ein.", es: "Los datos de mercado en Tradovate no tienen un precio único. Lo que paga depende de una sola etiqueta: suscriptor no profesional o profesional. Así se acierta con la categoría.", fr: "Les données de marché sur Tradovate n'ont pas un prix unique. Ce que vous payez dépend d'une seule étiquette : abonné non professionnel ou professionnel. Voici comment faire le bon choix.", it: "I dati di mercato su Tradovate non hanno un prezzo unico. Ciò che paga dipende da una sola etichetta: abbonato non professionale o professionale. Ecco come classificarsi correttamente." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Market data on Tradovate isn't one flat price. What you pay for live CME, CBOT, NYMEX and COMEX quotes comes down to a single label the exchanges attach to you: non-professional or professional subscriber. That label is the difference between a few dollars a month and a per-exchange fee that runs well over a hundred dollars. Get it right before you subscribe and you'll never overpay." },
    { type: "heading", text: "The Two Tiers, Side by Side" },
    { type: "paragraph", html: "Non-professional pricing is a small bundle. Professional pricing is charged separately for each exchange, so the total climbs fast if you want live data across all four CME Group markets." },
    {
      type: "table",
      headers: ["", "Non-professional", "Professional"],
      rows: [
        ["Typical monthly cost", "A small bundle for all four CME Group exchanges (around $12 for Level I / top-of-book, roughly $41 for Level II / depth)", "Charged per exchange, per month, at a much higher rate, well over $100 per exchange, in the region of $140 to $156"],
        ["How it's billed", "One bundled subscription, or a single exchange on its own (around $4 Level I / $16 Level II each)", "Each exchange billed separately, so all four means four separate charges"],
        ["Who it's for", "Individuals and small entities trading their own money", "Anyone who doesn't meet the non-professional test"],
        ["What you sign", "The non-professional Market Data Subscriber Certification", "The professional data agreement"],
      ],
    },
    { type: "paragraph", html: "Treat those dollar figures as a guide, not gospel. Exchange fees change and Tradovate updates its schedule over time, so confirm the current numbers on the subscription screen before you commit. The gap between the tiers, though, is always large, which is why your status matters so much." },
    { type: "heading", text: "Which Category Are You?" },
    { type: "paragraph", html: "Almost everyone trading their own account is non-professional. You tip into the professional tier the moment any one of these is true:" },
    {
      type: "list",
      items: [
        "You're registered or qualified with the SEC, CFTC, NFA, a state securities regulator, or any securities or futures exchange or association.",
        "You act as an investment adviser or asset manager, or you trade or manage money for other people.",
        "You receive or use the data for a business, or on behalf of another person or entity.",
        "You're employed in a role that uses market data professionally, or you're affiliated with a firm that would count as professional.",
      ],
    },
    { type: "paragraph", html: "One \"yes\" is enough to move you to the professional rate. Being self-employed doesn't disqualify you on its own. A sole trader, or a small LLC, trust, partnership or corporation trading its own capital, can still qualify as non-professional as long as none of the points above apply." },
    { type: "heading", text: "How to Lock In the Non-Professional Rate" },
    {
      type: "steps",
      items: [
        { title: "Open the Market Data Subscription Screen", html: "In the Tradovate web or desktop app, open the settings menu and look for Market Data Subscriptions, then choose the CME Group exchanges you want live quotes for. If you only trade the S&amp;P and Nasdaq futures, a single CME subscription may be all you need rather than the full bundle." },
        { title: "Complete the Non-Professional Certification", html: "During sign-up you self-declare your status on the Market Data Subscriber Certification (also shown as the Market Data Agreement). Choose Non-Professional and confirm the statements apply to you. If Tradovate asks, upload a clear photo or scan of the signed pages to your account dashboard. Answer honestly. A false non-professional declaration can trigger back-billing at the professional rate." },
        { title: "Keep a Live, Funded Account", html: "The low non-professional rate is tied to an active, funded live account. A demo-only or unfunded account can push you to delayed data or the higher tier. If your live orders are getting blocked until you sign a data agreement, that's this requirement in action." },
        { title: "Confirm Your Quotes Are Live, Not Delayed", html: "Once the subscription goes through, check that your symbols show live prices instead of a delayed marker. If quotes still lag, the subscription may not have taken effect yet." },
      ],
    },
    { type: "heading", text: "Prop Firm and Evaluation Accounts" },
    { type: "paragraph", html: "On a prop-firm evaluation or funded account, you usually don't buy market data yourself. The firm provisions it, and how the professional or non-professional side is handled varies by firm and account type. Check your firm's current rules rather than assuming Tradovate's direct-account pricing applies to you." },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Running an automated strategy and tired of babysitting data subscriptions and order rejections? <strong class='text-white'>PickMyTrade automates your Tradovate trades</strong> and lets your TradingView signals route straight to your account." },
  ], de: [
    { type: "paragraph",html: "Marktdaten bei Tradovate haben keinen einheitlichen Preis. Was Sie für Live-Kurse von CME, CBOT, NYMEX und COMEX zahlen, hängt von einem einzigen Merkmal ab, das die Börsen Ihnen zuordnen: nicht-professioneller oder professioneller Abonnent. Dieses Merkmal macht den Unterschied zwischen wenigen Dollar im Monat und einer Gebühr pro Börse von weit über hundert Dollar. Klären Sie es vor dem Abonnement richtig, und Sie zahlen nie zu viel." },
    { type: "heading",text: "Die beiden Stufen im Vergleich" },
    { type: "paragraph",html: "Die nicht-professionelle Preisgestaltung ist ein kleines Paket. Die professionelle Preisgestaltung wird für jede Börse einzeln berechnet, sodass die Summe schnell steigt, wenn Sie Live-Daten für alle vier CME-Group-Märkte möchten." },
    { type: "table", headers: ["","Nicht-professionell","Professionell"], rows: [
      ["Typische monatliche Kosten","Ein kleines Paket für alle vier CME-Group-Börsen (etwa 12 $ für Level I / Top-of-Book, rund 41 $ für Level II / Markttiefe)","Pro Börse und Monat zu einem deutlich höheren Satz berechnet, weit über 100 $ pro Börse, im Bereich von 140 bis 156 $"],
      ["Wie abgerechnet wird","Ein gebündeltes Abonnement oder eine einzelne Börse für sich (etwa 4 $ Level I / 16 $ Level II je Börse)","Jede Börse wird separat abgerechnet, sodass alle vier vier getrennte Abbuchungen bedeuten"],
      ["Für wen es gedacht ist","Privatpersonen und kleine Einheiten, die mit ihrem eigenen Geld handeln","Alle, die den Test für Nicht-Professionelle nicht erfüllen"],
      ["Was Sie unterzeichnen","Die Market Data Subscriber Certification für Nicht-Professionelle","Die Vereinbarung für professionelle Daten"],
    ] },
    { type: "paragraph",html: "Betrachten Sie diese Dollarbeträge als Richtwert, nicht als verbindliche Zahlen. Börsengebühren ändern sich, und Tradovate aktualisiert seine Preisliste im Lauf der Zeit. Prüfen Sie daher die aktuellen Beträge auf dem Abonnement-Bildschirm, bevor Sie sich festlegen. Der Abstand zwischen den Stufen ist jedoch immer groß, weshalb Ihr Status so wichtig ist." },
    { type: "heading",text: "Zu welcher Kategorie gehören Sie?" },
    { type: "paragraph",html: "Fast jeder, der sein eigenes Konto handelt, ist nicht-professionell. In die professionelle Stufe fallen Sie, sobald auch nur einer dieser Punkte zutrifft:" },
    {
      type: "list",
      items: [
        "Sie sind bei der SEC, der CFTC, der NFA, einer staatlichen Wertpapieraufsicht oder einer Wertpapier- bzw. Terminbörse oder einem entsprechenden Verband registriert oder qualifiziert.",
        "Sie handeln als Anlageberater oder Vermögensverwalter, oder Sie handeln mit dem Geld anderer Personen bzw. verwalten es.",
        "Sie erhalten oder nutzen die Daten für ein Unternehmen oder im Auftrag einer anderen Person oder Einheit.",
        "Sie sind in einer Funktion beschäftigt, die Marktdaten beruflich nutzt, oder mit einem Unternehmen verbunden, das als professionell gelten würde.",
      ],
    },
    { type: "paragraph",html: "Ein einziges „Ja“ genügt, um Sie in den professionellen Tarif zu versetzen. Selbstständigkeit allein schließt Sie nicht aus. Ein Einzelhändler oder eine kleine LLC, ein Trust, eine Partnerschaft oder Kapitalgesellschaft, die ihr eigenes Kapital handelt, kann weiterhin als nicht-professionell gelten, solange keiner der obigen Punkte zutrifft." },
    { type: "heading",text: "So sichern Sie sich den nicht-professionellen Tarif" },
    {
      type: "steps",
      items: [
        { title: "Den Bildschirm für Marktdaten-Abonnements öffnen", html: "Öffnen Sie in der Tradovate-Web- oder Desktop-App das Einstellungsmenü, suchen Sie nach Market Data Subscriptions und wählen Sie dann die CME-Group-Börsen aus, für die Sie Live-Kurse möchten. Wenn Sie nur die Futures auf S&amp;P und Nasdaq handeln, genügt möglicherweise ein einzelnes CME-Abonnement statt des vollständigen Pakets." },
        { title: "Die Zertifizierung als Nicht-Professioneller abschließen", html: "Bei der Anmeldung erklären Sie Ihren Status selbst in der Market Data Subscriber Certification (auch als Market Data Agreement angezeigt). Wählen Sie Non-Professional und bestätigen Sie, dass die Aussagen auf Sie zutreffen. Falls Tradovate dies verlangt, laden Sie ein gut lesbares Foto oder einen Scan der unterzeichneten Seiten in Ihr Konto-Dashboard hoch. Antworten Sie ehrlich. Eine falsche Erklärung als Nicht-Professioneller kann zu einer Nachberechnung zum professionellen Tarif führen." },
        { title: "Ein aktives, finanziertes Live-Konto führen", html: "Der niedrige nicht-professionelle Tarif ist an ein aktives, finanziertes Live-Konto gebunden. Ein reines Demo-Konto oder ein nicht finanziertes Konto kann Sie auf verzögerte Daten oder in die höhere Stufe zurückwerfen. Wenn Ihre Live-Orders blockiert werden, bis Sie eine Datenvereinbarung unterzeichnen, ist genau diese Anforderung der Grund." },
        { title: "Prüfen, ob Ihre Kurse live und nicht verzögert sind", html: "Sobald das Abonnement aktiv ist, prüfen Sie, ob Ihre Symbole Live-Preise statt einer Verzögerungsmarkierung anzeigen. Wenn die Kurse weiterhin hinterherhinken, ist das Abonnement möglicherweise noch nicht wirksam geworden." },
      ],
    },
    { type: "heading",text: "Prop-Firm- und Evaluierungskonten" },
    { type: "paragraph",html: "Bei einer Prop-Firm-Evaluierung oder einem finanzierten Konto kaufen Sie Marktdaten in der Regel nicht selbst. Die Firma stellt sie bereit, und wie die professionelle oder nicht-professionelle Seite gehandhabt wird, hängt von Firma und Kontotyp ab. Prüfen Sie die aktuellen Regeln Ihrer Firma, statt davon auszugehen, dass die Preise für direkte Tradovate-Konten für Sie gelten." },
    { type: "heading",text: "Mit PickMyTrade automatisieren" },
    { type: "paragraph",html: "Sie betreiben eine automatisierte Strategie und haben es satt, Datenabonnements und abgelehnte Orders zu überwachen? <strong class='text-white'>PickMyTrade automatisiert Ihre Tradovate-Trades</strong> und leitet Ihre TradingView-Signale direkt an Ihr Konto weiter." },
  ], es: [
    { type: "paragraph",html: "Los datos de mercado en Tradovate no tienen un precio único. Lo que paga por las cotizaciones en vivo de CME, CBOT, NYMEX y COMEX depende de una sola etiqueta que las bolsas le asignan: suscriptor no profesional o profesional. Esa etiqueta marca la diferencia entre unos pocos dólares al mes y una tarifa por bolsa que supera con creces los cien dólares. Acierte antes de suscribirse y nunca pagará de más." },
    { type: "heading",text: "Los dos niveles, lado a lado" },
    { type: "paragraph",html: "El precio no profesional es un paquete pequeño. El precio profesional se cobra por separado por cada bolsa, de modo que el total sube rápidamente si quiere datos en vivo de los cuatro mercados de CME Group." },
    { type: "table", headers: ["","No profesional","Profesional"], rows: [
      ["Coste mensual habitual","Un paquete pequeño para las cuatro bolsas de CME Group (unos 12 $ por Nivel I / mejor precio, aproximadamente 41 $ por Nivel II / profundidad)","Se cobra por bolsa y por mes a una tarifa mucho más alta, muy por encima de 100 $ por bolsa, en torno a 140 a 156 $"],
      ["Cómo se factura","Una suscripción agrupada, o una sola bolsa por separado (unos 4 $ Nivel I / 16 $ Nivel II cada una)","Cada bolsa se factura por separado, de modo que las cuatro suponen cuatro cargos independientes"],
      ["A quién va dirigido","Particulares y pequeñas entidades que operan con su propio dinero","Cualquiera que no cumpla el criterio de no profesional"],
      ["Qué firma","La certificación de suscriptor de datos de mercado (Market Data Subscriber Certification) para no profesionales","El acuerdo de datos profesional"],
    ] },
    { type: "paragraph",html: "Tome esas cifras en dólares como orientación, no como verdad absoluta. Las tarifas de las bolsas cambian y Tradovate actualiza su lista con el tiempo, así que confirme las cifras vigentes en la pantalla de suscripción antes de comprometerse. La diferencia entre niveles, sin embargo, siempre es grande, y por eso su estatus importa tanto." },
    { type: "heading",text: "¿A qué categoría pertenece?" },
    { type: "paragraph",html: "Casi todas las personas que operan su propia cuenta son no profesionales. Pasa al nivel profesional en cuanto se cumpla cualquiera de estos supuestos:" },
    {
      type: "list",
      items: [
        "Está registrado o habilitado ante la SEC, la CFTC, la NFA, un regulador estatal de valores o cualquier bolsa o asociación de valores o futuros.",
        "Actúa como asesor de inversiones o gestor de activos, u opera o gestiona dinero de otras personas.",
        "Recibe o utiliza los datos para una empresa o en nombre de otra persona o entidad.",
        "Trabaja en un puesto que utiliza datos de mercado de forma profesional, o está vinculado a una firma que se consideraría profesional.",
      ],
    },
    { type: "paragraph",html: "Un solo «sí» basta para pasar a la tarifa profesional. Ser autónomo no lo descalifica por sí solo. Un operador individual, o una pequeña LLC, fideicomiso, sociedad colectiva o empresa que opera con su propio capital, aún puede calificar como no profesional siempre que no se cumpla ninguno de los puntos anteriores." },
    { type: "heading",text: "Cómo asegurar la tarifa no profesional" },
    {
      type: "steps",
      items: [
        { title: "Abra la pantalla de suscripción de datos de mercado", html: "En la aplicación web o de escritorio de Tradovate, abra el menú de ajustes y busque Market Data Subscriptions; después elija las bolsas de CME Group para las que quiere cotizaciones en vivo. Si solo opera los futuros del S&amp;P y del Nasdaq, puede que le baste una única suscripción a CME en lugar del paquete completo." },
        { title: "Complete la certificación de no profesional", html: "Durante el registro declara su estatus en la Market Data Subscriber Certification (también mostrada como Market Data Agreement). Elija Non-Professional y confirme que las declaraciones le corresponden. Si Tradovate se lo solicita, suba una foto o un escaneo nítido de las páginas firmadas al panel de su cuenta. Responda con sinceridad. Una declaración falsa como no profesional puede dar lugar a una refacturación a la tarifa profesional." },
        { title: "Mantenga una cuenta real activa y fondeada", html: "La tarifa baja de no profesional está ligada a una cuenta real activa y con fondos. Una cuenta solo demo o sin fondos puede relegarle a datos con retraso o al nivel superior. Si sus órdenes reales se bloquean hasta que firme un acuerdo de datos, es este requisito en acción." },
        { title: "Confirme que sus cotizaciones están en vivo y no con retraso", html: "Cuando la suscripción se haya procesado, compruebe que sus símbolos muestran precios en vivo en lugar de un indicador de retraso. Si las cotizaciones siguen retrasadas, puede que la suscripción aún no haya surtido efecto." },
      ],
    },
    { type: "heading",text: "Cuentas de empresas de fondeo y de evaluación" },
    { type: "paragraph",html: "En una evaluación o cuenta fondeada de una empresa de fondeo (prop firm), normalmente usted no compra los datos de mercado. La firma los proporciona, y cómo se gestiona el lado profesional o no profesional varía según la firma y el tipo de cuenta. Consulte las reglas vigentes de su firma en lugar de suponer que se aplican los precios de las cuentas directas de Tradovate." },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "¿Ejecuta una estrategia automatizada y está harto de vigilar suscripciones de datos y rechazos de órdenes? <strong class='text-white'>PickMyTrade automatiza sus operaciones en Tradovate</strong> y envía sus señales de TradingView directamente a su cuenta." },
  ], fr: [
    { type: "paragraph",html: "Les données de marché sur Tradovate n'ont pas un prix unique. Ce que vous payez pour les cotations en direct du CME, du CBOT, du NYMEX et du COMEX dépend d'une seule étiquette que les bourses vous attribuent : abonné non professionnel ou professionnel. Cette étiquette fait la différence entre quelques dollars par mois et des frais par bourse qui dépassent largement la centaine de dollars. Faites le bon choix avant de vous abonner et vous ne paierez jamais trop." },
    { type: "heading",text: "Les deux niveaux côte à côte" },
    { type: "paragraph",html: "La tarification non professionnelle est un petit forfait. La tarification professionnelle est facturée séparément pour chaque bourse, de sorte que le total grimpe vite si vous voulez des données en direct sur les quatre marchés du CME Group." },
    { type: "table", headers: ["","Non professionnel","Professionnel"], rows: [
      ["Coût mensuel habituel","Un petit forfait pour les quatre bourses du CME Group (environ 12 $ pour le Niveau I / meilleur prix, environ 41 $ pour le Niveau II / profondeur)","Facturé par bourse et par mois à un tarif bien plus élevé, bien au-delà de 100 $ par bourse, de l'ordre de 140 à 156 $"],
      ["Mode de facturation","Un abonnement groupé, ou une seule bourse à part (environ 4 $ Niveau I / 16 $ Niveau II chacune)","Chaque bourse est facturée séparément, donc les quatre représentent quatre prélèvements distincts"],
      ["À qui cela s'adresse","Aux particuliers et aux petites entités qui tradent leur propre argent","À toute personne ne répondant pas au critère de non-professionnel"],
      ["Ce que vous signez","La certification d'abonné aux données de marché (Market Data Subscriber Certification) pour non-professionnels","L'accord de données professionnel"],
    ] },
    { type: "paragraph",html: "Considérez ces montants en dollars comme une indication, pas comme une vérité absolue. Les frais des bourses évoluent et Tradovate met à jour sa grille avec le temps ; confirmez donc les montants actuels sur l'écran d'abonnement avant de vous engager. L'écart entre les niveaux, lui, est toujours important, ce qui explique l'importance de votre statut." },
    { type: "heading",text: "Dans quelle catégorie êtes-vous ?" },
    { type: "paragraph",html: "Presque tous ceux qui tradent leur propre compte sont non professionnels. Vous passez au niveau professionnel dès que l'une de ces conditions est remplie :" },
    {
      type: "list",
      items: [
        "Vous êtes enregistré ou qualifié auprès de la SEC, de la CFTC, de la NFA, d'un régulateur boursier d'État ou de toute bourse ou association de valeurs mobilières ou de contrats à terme.",
        "Vous agissez en tant que conseiller en investissement ou gestionnaire d'actifs, ou vous tradez ou gérez l'argent d'autres personnes.",
        "Vous recevez ou utilisez les données pour une entreprise, ou pour le compte d'une autre personne ou entité.",
        "Vous occupez un poste qui utilise les données de marché à titre professionnel, ou vous êtes affilié à une société qui serait considérée comme professionnelle.",
      ],
    },
    { type: "paragraph",html: "Un seul « oui » suffit pour vous faire passer au tarif professionnel. Être indépendant ne vous disqualifie pas à lui seul. Un entrepreneur individuel, ou une petite LLC, un trust, une société de personnes ou une société de capitaux qui trade son propre capital, peut toujours être considéré comme non professionnel tant qu'aucun des points ci-dessus ne s'applique." },
    { type: "heading",text: "Comment obtenir le tarif non professionnel" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez l'écran d'abonnement aux données de marché", html: "Dans l'application web ou de bureau Tradovate, ouvrez le menu des paramètres et cherchez Market Data Subscriptions, puis choisissez les bourses du CME Group pour lesquelles vous voulez des cotations en direct. Si vous ne tradez que les contrats à terme sur le S&amp;P et le Nasdaq, un seul abonnement CME peut suffire au lieu du forfait complet." },
        { title: "Remplissez la certification de non-professionnel", html: "Lors de l'inscription, vous déclarez vous-même votre statut dans la Market Data Subscriber Certification (également affichée sous le nom Market Data Agreement). Choisissez Non-Professional et confirmez que les déclarations vous concernent. Si Tradovate le demande, téléversez une photo ou un scan net des pages signées sur le tableau de bord de votre compte. Répondez honnêtement. Une fausse déclaration de non-professionnel peut entraîner une refacturation au tarif professionnel." },
        { title: "Conservez un compte réel actif et approvisionné", html: "Le tarif non professionnel avantageux est lié à un compte réel actif et approvisionné. Un compte uniquement démo ou non approvisionné peut vous faire passer à des données différées ou au niveau supérieur. Si vos ordres réels sont bloqués tant que vous n'avez pas signé un accord de données, c'est cette exigence qui s'applique." },
        { title: "Vérifiez que vos cotations sont en direct et non différées", html: "Une fois l'abonnement validé, vérifiez que vos symboles affichent des prix en direct plutôt qu'un indicateur de différé. Si les cotations accusent encore du retard, il se peut que l'abonnement n'ait pas encore pris effet." },
      ],
    },
    { type: "heading",text: "Comptes de prop firm et d'évaluation" },
    { type: "paragraph",html: "Sur une évaluation ou un compte financé d'une prop firm, vous n'achetez généralement pas vous-même les données de marché. C'est la société qui les fournit, et la façon dont le statut professionnel ou non professionnel est géré varie selon la société et le type de compte. Vérifiez les règles actuelles de votre société plutôt que de supposer que la tarification des comptes Tradovate directs s'applique à vous." },
    { type: "heading",text: "Automatisez avec PickMyTrade" },
    { type: "paragraph",html: "Vous exécutez une stratégie automatisée et en avez assez de surveiller les abonnements de données et les rejets d'ordres ? <strong class='text-white'>PickMyTrade automatise vos trades Tradovate</strong> et achemine vos signaux TradingView directement vers votre compte." },
  ], it: [
    { type: "paragraph",html: "I dati di mercato su Tradovate non hanno un prezzo unico. Ciò che paga per le quotazioni in tempo reale di CME, CBOT, NYMEX e COMEX dipende da una sola etichetta che le borse le attribuiscono: abbonato non professionale o professionale. Quell'etichetta fa la differenza tra pochi dollari al mese e una tariffa per borsa che supera di gran lunga i cento dollari. La scelga correttamente prima di abbonarsi e non pagherà mai troppo." },
    { type: "heading",text: "I due livelli a confronto" },
    { type: "paragraph",html: "Il prezzo non professionale è un piccolo pacchetto. Il prezzo professionale viene addebitato separatamente per ciascuna borsa, quindi il totale sale in fretta se desidera dati in tempo reale su tutti e quattro i mercati di CME Group." },
    { type: "table", headers: ["","Non professionale","Professionale"], rows: [
      ["Costo mensile tipico","Un piccolo pacchetto per tutte e quattro le borse di CME Group (circa 12 $ per il Livello I / top-of-book, circa 41 $ per il Livello II / profondità)","Addebitato per borsa, al mese, a una tariffa molto più alta, ben oltre 100 $ per borsa, nell'ordine di 140-156 $"],
      ["Come viene fatturato","Un abbonamento in pacchetto, oppure una singola borsa a sé (circa 4 $ Livello I / 16 $ Livello II ciascuna)","Ogni borsa viene fatturata separatamente, quindi tutte e quattro comportano quattro addebiti distinti"],
      ["A chi si rivolge","A privati e piccole entità che fanno trading con il proprio denaro","A chiunque non soddisfi il criterio di non professionale"],
      ["Cosa si firma","La certificazione dell'abbonato ai dati di mercato (Market Data Subscriber Certification) per non professionali","L'accordo sui dati professionali"],
    ] },
    { type: "paragraph",html: "Consideri queste cifre in dollari come un'indicazione, non come un dato assoluto. Le tariffe delle borse cambiano e Tradovate aggiorna il proprio listino nel tempo, quindi confermi gli importi attuali nella schermata di abbonamento prima di impegnarsi. Il divario tra i livelli, però, è sempre ampio, ed è per questo che il suo status è così importante." },
    { type: "heading",text: "A quale categoria appartiene?" },
    { type: "paragraph",html: "Quasi tutti coloro che operano sul proprio conto sono non professionali. Passa al livello professionale non appena si verifica anche solo una di queste condizioni:" },
    {
      type: "list",
      items: [
        "È registrato o abilitato presso la SEC, la CFTC, la NFA, un'autorità statale sui titoli o qualsiasi borsa o associazione di titoli o futures.",
        "Agisce come consulente d'investimento o gestore patrimoniale, oppure opera o gestisce denaro per conto di altre persone.",
        "Riceve o utilizza i dati per un'attività commerciale, o per conto di un'altra persona o entità.",
        "Lavora in un ruolo che utilizza i dati di mercato a livello professionale, oppure è affiliato a una società che verrebbe considerata professionale.",
      ],
    },
    { type: "paragraph",html: "Basta un solo «sì» per passare alla tariffa professionale. Essere lavoratore autonomo non la squalifica di per sé. Un operatore individuale, o una piccola LLC, un trust, una partnership o una società che opera con il proprio capitale, può comunque qualificarsi come non professionale purché non si applichi nessuno dei punti precedenti." },
    { type: "heading",text: "Come ottenere la tariffa non professionale" },
    {
      type: "steps",
      items: [
        { title: "Apra la schermata di abbonamento ai dati di mercato", html: "Nell'app web o desktop di Tradovate, apra il menu delle impostazioni e cerchi Market Data Subscriptions, quindi scelga le borse di CME Group per le quali desidera quotazioni in tempo reale. Se opera solo sui futures S&amp;P e Nasdaq, può bastare un singolo abbonamento CME anziché il pacchetto completo." },
        { title: "Completi la certificazione di non professionale", html: "Durante la registrazione dichiara da sé il suo status nella Market Data Subscriber Certification (visualizzata anche come Market Data Agreement). Scelga Non-Professional e confermi che le dichiarazioni la riguardano. Se Tradovate lo richiede, carichi una foto o una scansione nitida delle pagine firmate nella dashboard del suo account. Risponda onestamente. Una falsa dichiarazione di non professionale può comportare una ri-fatturazione alla tariffa professionale." },
        { title: "Mantenga un conto reale attivo e finanziato", html: "La tariffa bassa non professionale è legata a un conto reale attivo e finanziato. Un conto solo demo o non finanziato può farla passare a dati ritardati o al livello superiore. Se i suoi ordini reali vengono bloccati finché non firma un accordo sui dati, è questo requisito in azione." },
        { title: "Verifichi che le quotazioni siano in tempo reale e non ritardate", html: "Una volta completato l'abbonamento, verifichi che i suoi simboli mostrino prezzi in tempo reale anziché un indicatore di ritardo. Se le quotazioni sono ancora in ritardo, l'abbonamento potrebbe non essere ancora entrato in vigore." },
      ],
    },
    { type: "heading",text: "Conti di prop firm e di valutazione" },
    { type: "paragraph",html: "Su una valutazione o un conto finanziato di una prop firm, di solito non acquista i dati di mercato da sé. Li fornisce la società, e il modo in cui viene gestito il lato professionale o non professionale varia in base alla società e al tipo di conto. Verifichi le regole attuali della sua società anziché dare per scontato che si applichi la tariffazione dei conti Tradovate diretti." },
    { type: "heading",text: "Automatizzi tutto con PickMyTrade" },
    { type: "paragraph",html: "Esegue una strategia automatizzata ed è stanco di sorvegliare abbonamenti ai dati e ordini rifiutati? <strong class='text-white'>PickMyTrade automatizza i suoi trade su Tradovate</strong> e instrada i suoi segnali di TradingView direttamente al suo conto." },
  ] },
