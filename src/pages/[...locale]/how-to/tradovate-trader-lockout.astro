---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-trader-lockout";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Use Trader Lockout to Lock Yourself Out of Trading";
const META_DESCRIPTION =
  "Trader Lockout flattens positions, cancels orders, and blocks new trades for a set time so you can stop revenge trading on sim accounts.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Trader Lockout: Sperren Sie sich selbst vom Handel aus", es: "Use Trader Lockout para bloquearse a sí mismo el trading", fr: "Utilisez Trader Lockout pour vous bloquer vous-même le trading", it: "Usi Trader Lockout per bloccarsi da soli il trading" },
  dek: { en: "Trader Lockout is the button that saves you from yourself. It slams the door on your account for a set stretch of time, no new orders, no exceptions. Here's how to set it up.", de: "Trader Lockout ist der Knopf, der Sie vor sich selbst schützt. Er schließt Ihr Konto für einen festgelegten Zeitraum ab: keine neuen Orders, keine Ausnahmen. So richten Sie ihn ein.", es: "Trader Lockout es el botón que lo protege de usted mismo. Cierra la puerta de su cuenta durante un tiempo determinado: sin nuevas órdenes y sin excepciones. Así se configura.", fr: "Trader Lockout est le bouton qui vous protège de vous-même. Il verrouille votre compte pour une durée définie : aucun nouvel ordre, aucune exception. Voici comment le configurer.", it: "Trader Lockout è il pulsante che la protegge da sé stesso. Chiude la porta del suo conto per un periodo stabilito: nessun nuovo ordine, nessuna eccezione. Ecco come impostarlo." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Some of the worst trades happen right after a big loss, when you're chasing it back, or right after a big win, when you feel untouchable. Trader Lockout is the button that saves you from yourself. It slams the door on your account for a set stretch of time, no new orders, no exceptions, not even a call to support gets you back in early. Here's how to set it up, and when it's actually worth pulling the trigger." },
    { type: "heading", text: "What Trader Lockout Does the Moment You Hit It" },
    { type: "paragraph", html: "When you confirm a lockout, three things happen at once:" },
    {
      type: "list",
      items: [
        "Every open position gets flattened.",
        "Every working order gets canceled.",
        "Every new order, from any platform connected to your account, gets rejected until the timer runs out.",
      ],
    },
    { type: "paragraph", html: "It's a hard stop, not a gentle nudge. The lock covers every account tied to your user profile, so you can't just hop to a second account and keep clicking." },
    { type: "heading", text: "Before You Start" },
    { type: "quote", html: "<strong class='text-white'>It's for simulated (evaluation) accounts.</strong> This is a discipline tool for sim and prop-eval accounts, not for live funded money.<br><br><strong class='text-white'>You can't undo it.</strong> Once the lockout is running, there's no early exit. Client Services can't lift it, and neither can you. You wait it out.<br><br><strong class='text-white'>The ceiling is 24 hours.</strong> Pick a preset or a custom length, but you can't lock yourself out for longer than a day at a time." },
    { type: "paragraph", html: "Prop-eval rules like daily loss caps and trailing drawdown vary by firm and account size, check your firm's current rules. Trader Lockout sits on top of those limits; it doesn't replace them." },
    { type: "heading", text: "How to Set a Trader Lockout" },
    {
      type: "steps",
      items: [
        { title: "Log in to Your Evaluation Account", html: "Open the Tradovate web trader or the mobile app and sign in to the sim/eval account you want to protect. The feature lives on web and mobile, the desktop app doesn't carry it right now, so use one of those two." },
        { title: "Open the Lockout Control", html: "On the web trader, look along the top of the screen for the lockout button, it's usually the orange one. On mobile, open the navigation drawer and find the same control. Tap it to open the lockout panel." },
        { title: "Pick How Long to Stay Out", html: "Choose your duration. The presets are 15 minutes, 30 minutes, 1 hour, or the rest of the session. Need something specific? Set a custom length up to the 24-hour max. Match the time to the reason, a short cooldown after a shaky setup, or the whole session once you've hit your number." },
        { title: "Confirm the Lock", html: "Hit <strong class='text-white'>Lock Account</strong> to arm it. This is the point of no return, the second you confirm, open trades flatten and the door closes. Double-check the duration is what you actually want before you tap it." },
        { title: "Watch the Timer, Then Let It Run", html: "Once it's live, a countdown shows at the top of the web trader. Click the timer to see the exact date and time the lock lifts. Then walk away, that's the whole point. When the clock hits zero, trading opens back up on its own." },
      ],
    },
    { type: "heading", text: "When It's Actually Worth Using" },
    { type: "paragraph", html: "The button only helps if you use it before you talk yourself out of it. A few honest triggers:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>You hit your profit target.</strong> A green day's a green day. Lock it and protect the number instead of handing it back.",
        "<strong class='text-white'>You're down and itching to make it back.</strong> A 30-minute lockout kills revenge trading before it starts.",
        "<strong class='text-white'>The tape's a mess.</strong> During news spikes or choppy swings, a 15-minute pause keeps you out of half-baked setups.",
        "<strong class='text-white'>You've got a hard cutoff.</strong> Locking at noon, or in the last 30 minutes, enforces the rule you keep breaking.",
      ],
    },
    { type: "paragraph", html: "Pair it with Tradovate's built-in guardrails: set hard daily and weekly loss limits, review your full account risk settings, and know how to flatten every position and cancel orders fast when you need to bail on your own terms." },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Tired of babysitting the platform to enforce your own rules? PickMyTrade automates your TradingView strategies into Tradovate so your entries, exits, and risk logic run the same way every time, without the emotional override." },
  ], de: [
    { type: "paragraph",html: "Einige der schlechtesten Trades passieren direkt nach einem großen Verlust, wenn Sie ihn zurückholen wollen, oder direkt nach einem großen Gewinn, wenn Sie sich unbesiegbar fühlen. Trader Lockout ist der Knopf, der Sie vor sich selbst schützt. Er schließt Ihr Konto für einen festgelegten Zeitraum ab: keine neuen Orders, keine Ausnahmen, nicht einmal ein Anruf beim Support verschafft Ihnen vorzeitig wieder Zutritt. So richten Sie ihn ein und so erkennen Sie, wann es sich wirklich lohnt, ihn zu betätigen." },
    { type: "heading",text: "Was Trader Lockout im Moment der Aktivierung bewirkt" },
    { type: "paragraph",html: "Wenn Sie eine Sperre bestätigen, passieren drei Dinge gleichzeitig:" },
    {
      type: "list",
      items: [
        "Jede offene Position wird glattgestellt.",
        "Jede aktive Order wird storniert.",
        "Jede neue Order, von jeder mit Ihrem Konto verbundenen Plattform, wird abgelehnt, bis der Timer abgelaufen ist.",
      ],
    },
    { type: "paragraph",html: "Das ist ein harter Stopp und kein sanfter Hinweis. Die Sperre gilt für jedes Konto, das mit Ihrem Benutzerprofil verknüpft ist, Sie können also nicht einfach zu einem zweiten Konto wechseln und weiterklicken." },
    { type: "heading",text: "Bevor Sie beginnen" },
    { type: "quote",html: "<strong class='text-white'>Es gilt für simulierte (Evaluierungs-)Konten.</strong> Dies ist ein Disziplinwerkzeug für Sim- und Prop-Evaluierungskonten, nicht für echtes finanziertes Kapital.<br><br><strong class='text-white'>Sie können es nicht rückgängig machen.</strong> Sobald die Sperre läuft, gibt es keinen vorzeitigen Ausstieg. Der Kundenservice kann sie nicht aufheben, und Sie auch nicht. Sie warten sie ab.<br><br><strong class='text-white'>Die Obergrenze beträgt 24 Stunden.</strong> Wählen Sie eine Voreinstellung oder eine benutzerdefinierte Dauer, aber Sie können sich nie länger als einen Tag am Stück sperren." },
    { type: "paragraph",html: "Regeln von Prop-Evaluierungen wie tägliche Verlustgrenzen und der nachlaufende Drawdown unterscheiden sich je nach Firma und Kontogröße, prüfen Sie daher die aktuellen Regeln Ihrer Firma. Trader Lockout wirkt zusätzlich zu diesen Limits; er ersetzt sie nicht." },
    { type: "heading",text: "So richten Sie eine Trader-Lockout-Sperre ein" },
    {
      type: "steps",
      items: [
        { title: "Bei Ihrem Evaluierungskonto anmelden", html: "Öffnen Sie den Tradovate Web Trader oder die Mobil-App und melden Sie sich bei dem Sim-/Evaluierungskonto an, das Sie schützen möchten. Die Funktion gibt es im Web und auf Mobilgeräten, die Desktop-App bietet sie derzeit nicht, nutzen Sie also eine dieser beiden Varianten." },
        { title: "Die Lockout-Steuerung öffnen", html: "Suchen Sie im Web Trader am oberen Bildschirmrand nach der Lockout-Schaltfläche, in der Regel ist es die orangefarbene. In der mobilen App öffnen Sie die Navigationsleiste und finden dasselbe Bedienelement. Tippen Sie darauf, um das Lockout-Fenster zu öffnen." },
        { title: "Wählen Sie, wie lange Sie draußen bleiben", html: "Wählen Sie Ihre Dauer. Die Voreinstellungen sind 15 Minuten, 30 Minuten, 1 Stunde oder der Rest der Sitzung. Brauchen Sie etwas Bestimmtes? Legen Sie eine benutzerdefinierte Dauer bis zum Maximum von 24 Stunden fest. Passen Sie die Zeit an den Anlass an: eine kurze Abkühlpause nach einem wackeligen Setup oder die gesamte Sitzung, sobald Sie Ihre Zielmarke erreicht haben." },
        { title: "Die Sperre bestätigen", html: "Klicken Sie auf <strong class='text-white'>Lock Account</strong>, um sie scharfzuschalten. Das ist der Punkt, an dem es kein Zurück mehr gibt: Sobald Sie bestätigen, werden offene Trades glattgestellt und die Tür schließt sich. Prüfen Sie noch einmal, ob die Dauer wirklich Ihren Wünschen entspricht, bevor Sie tippen." },
        { title: "Den Timer beobachten, dann einfach laufen lassen", html: "Sobald die Sperre aktiv ist, wird oben im Web Trader ein Countdown angezeigt. Klicken Sie auf den Timer, um das genaue Datum und die Uhrzeit zu sehen, zu der die Sperre endet. Danach gehen Sie einfach weg, das ist ja der Sinn der Sache. Wenn die Uhr bei null ankommt, wird der Handel von selbst wieder freigegeben." },
      ],
    },
    { type: "heading",text: "Wann es sich wirklich lohnt" },
    { type: "paragraph",html: "Der Knopf hilft nur, wenn Sie ihn drücken, bevor Sie sich selbst davon abbringen. Ein paar ehrliche Auslöser:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Sie haben Ihr Gewinnziel erreicht.</strong> Ein grüner Tag ist ein grüner Tag. Sperren Sie ihn und schützen Sie die Zahl, statt sie wieder herzugeben.",
        "<strong class='text-white'>Sie liegen im Minus und wollen es unbedingt zurückholen.</strong> Eine 30-minütige Sperre erstickt Revenge-Trading im Keim.",
        "<strong class='text-white'>Der Markt ist chaotisch.</strong> Bei Nachrichtenspitzen oder sprunghaften Schwankungen hält Sie eine 15-minütige Pause aus halbgaren Setups heraus.",
        "<strong class='text-white'>Sie haben eine feste Handelsschlussregel.</strong> Eine Sperre um zwölf Uhr mittags oder in den letzten 30 Minuten setzt die Regel durch, die Sie ständig brechen.",
      ],
    },
    { type: "paragraph",html: "Kombinieren Sie sie mit den integrierten Schutzmechanismen von Tradovate: Legen Sie feste tägliche und wöchentliche Verlustlimits fest, prüfen Sie Ihre vollständigen Kontorisiko-Einstellungen und wissen Sie, wie Sie schnell alle Positionen glattstellen und Orders stornieren, wenn Sie selbst aussteigen wollen." },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "Sie haben es satt, die Plattform zu überwachen, um Ihre eigenen Regeln durchzusetzen? PickMyTrade automatisiert Ihre TradingView-Strategien in Tradovate, damit Ihre Einstiege, Ausstiege und Ihre Risikologik jedes Mal gleich ablaufen, ohne emotionales Eingreifen." },
  ], es: [
    { type: "paragraph",html: "Algunas de las peores operaciones ocurren justo después de una gran pérdida, cuando intenta recuperarla, o justo después de una gran ganancia, cuando se siente invencible. Trader Lockout es el botón que lo protege de usted mismo. Cierra la puerta de su cuenta durante un tiempo determinado: sin nuevas órdenes, sin excepciones, ni siquiera una llamada a soporte le devuelve el acceso antes de tiempo. Así se configura y así sabrá cuándo realmente conviene pulsarlo." },
    { type: "heading",text: "Qué hace Trader Lockout en el momento en que lo activa" },
    { type: "paragraph",html: "Cuando confirma un bloqueo, ocurren tres cosas a la vez:" },
    {
      type: "list",
      items: [
        "Todas las posiciones abiertas se cierran.",
        "Todas las órdenes activas se cancelan.",
        "Toda orden nueva, desde cualquier plataforma conectada a su cuenta, se rechaza hasta que termine el temporizador.",
      ],
    },
    { type: "paragraph",html: "Es una parada total, no un simple aviso. El bloqueo abarca todas las cuentas vinculadas a su perfil de usuario, así que no puede saltar a una segunda cuenta y seguir operando." },
    { type: "heading",text: "Antes de empezar" },
    { type: "quote",html: "<strong class='text-white'>Es para cuentas simuladas (de evaluación).</strong> Es una herramienta de disciplina para cuentas de simulación y de evaluación de prop firms, no para dinero real fondeado.<br><br><strong class='text-white'>No se puede deshacer.</strong> Una vez que el bloqueo está en marcha, no hay salida anticipada. Ni el servicio de atención al cliente puede levantarlo, ni usted tampoco. Debe esperar a que termine.<br><br><strong class='text-white'>El máximo es de 24 horas.</strong> Elija un valor predefinido o una duración personalizada, pero no puede bloquearse durante más de un día seguido." },
    { type: "paragraph",html: "Las reglas de las evaluaciones de prop firms, como los límites de pérdida diaria y el drawdown dinámico, varían según la firma y el tamaño de la cuenta, así que consulte las reglas vigentes de su firma. Trader Lockout se suma a esos límites; no los sustituye." },
    { type: "heading",text: "Cómo configurar un Trader Lockout" },
    {
      type: "steps",
      items: [
        { title: "Inicie sesión en su cuenta de evaluación", html: "Abra el trader web de Tradovate o la aplicación móvil e inicie sesión en la cuenta de simulación o evaluación que desea proteger. La función está disponible en la web y en el móvil; la aplicación de escritorio no la incluye por ahora, así que use una de esas dos." },
        { title: "Abra el control de bloqueo", html: "En el trader web, busque en la parte superior de la pantalla el botón de bloqueo; suele ser el naranja. En el móvil, abra el cajón de navegación y encuentre el mismo control. Púlselo para abrir el panel de bloqueo." },
        { title: "Elija cuánto tiempo quedará fuera", html: "Elija la duración. Los valores predefinidos son 15 minutos, 30 minutos, 1 hora o el resto de la sesión. ¿Necesita algo concreto? Establezca una duración personalizada hasta el máximo de 24 horas. Ajuste el tiempo al motivo: una breve pausa tras una configuración dudosa, o toda la sesión una vez que haya alcanzado su cifra." },
        { title: "Confirme el bloqueo", html: "Pulse <strong class='text-white'>Lock Account</strong> para activarlo. Este es el punto sin retorno: en cuanto confirme, las operaciones abiertas se cierran y la puerta se cierra. Compruebe dos veces que la duración es realmente la que desea antes de pulsar." },
        { title: "Observe el temporizador y déjelo correr", html: "Una vez activo, aparece una cuenta atrás en la parte superior del trader web. Haga clic en el temporizador para ver la fecha y hora exactas en que termina el bloqueo. Después, aléjese; ese es el objetivo. Cuando el reloj llega a cero, el trading se reabre por sí solo." },
      ],
    },
    { type: "heading",text: "Cuándo vale realmente la pena usarlo" },
    { type: "paragraph",html: "El botón solo ayuda si lo usa antes de convencerse de no hacerlo. Algunos motivos honestos:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Ha alcanzado su objetivo de beneficio.</strong> Un día verde es un día verde. Bloquee y proteja la cifra en lugar de devolverla.",
        "<strong class='text-white'>Va en pérdidas y le pica la necesidad de recuperarlas.</strong> Un bloqueo de 30 minutos acaba con el revenge trading antes de que empiece.",
        "<strong class='text-white'>El mercado es un caos.</strong> Durante picos por noticias o vaivenes erráticos, una pausa de 15 minutos le mantiene fuera de configuraciones a medio cocer.",
        "<strong class='text-white'>Tiene una hora de corte estricta.</strong> Bloquear a mediodía, o en los últimos 30 minutos, impone la regla que siempre rompe.",
      ],
    },
    { type: "paragraph",html: "Combínelo con las protecciones integradas de Tradovate: establezca límites de pérdida diarios y semanales estrictos, revise todos los ajustes de riesgo de su cuenta y sepa cómo cerrar todas las posiciones y cancelar órdenes con rapidez cuando necesite salir por su cuenta." },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "¿Cansado de vigilar la plataforma para hacer cumplir sus propias reglas? PickMyTrade automatiza sus estrategias de TradingView en Tradovate para que sus entradas, salidas y lógica de riesgo se ejecuten siempre igual, sin la intervención emocional." },
  ], fr: [
    { type: "paragraph",html: "Certains des pires trades surviennent juste après une grosse perte, quand vous cherchez à vous refaire, ou juste après un gros gain, quand vous vous sentez invincible. Trader Lockout est le bouton qui vous protège de vous-même. Il verrouille votre compte pour une durée définie : aucun nouvel ordre, aucune exception, pas même un appel au support ne vous rend l'accès plus tôt. Voici comment le configurer, et quand il vaut vraiment la peine de l'activer." },
    { type: "heading",text: "Ce que fait Trader Lockout dès que vous l'activez" },
    { type: "paragraph",html: "Lorsque vous confirmez un verrouillage, trois choses se produisent en même temps :" },
    {
      type: "list",
      items: [
        "Toutes les positions ouvertes sont clôturées.",
        "Tous les ordres actifs sont annulés.",
        "Tout nouvel ordre, provenant de n'importe quelle plateforme connectée à votre compte, est rejeté jusqu'à la fin du minuteur.",
      ],
    },
    { type: "paragraph",html: "C'est un arrêt net, pas un simple rappel à l'ordre. Le verrouillage couvre tous les comptes liés à votre profil utilisateur : vous ne pouvez donc pas passer sur un second compte pour continuer à cliquer." },
    { type: "heading",text: "Avant de commencer" },
    { type: "quote",html: "<strong class='text-white'>Il est réservé aux comptes simulés (d'évaluation).</strong> C'est un outil de discipline pour les comptes de simulation et d'évaluation de prop firms, pas pour de l'argent réel financé.<br><br><strong class='text-white'>Vous ne pouvez pas l'annuler.</strong> Une fois le verrouillage lancé, il n'y a pas de sortie anticipée. Le service client ne peut pas le lever, et vous non plus. Vous devez attendre qu'il se termine.<br><br><strong class='text-white'>Le plafond est de 24 heures.</strong> Choisissez une durée prédéfinie ou personnalisée, mais vous ne pouvez pas vous verrouiller pour plus d'une journée à la fois." },
    { type: "paragraph",html: "Les règles des évaluations de prop firms, comme les plafonds de perte quotidienne et le drawdown suiveur, varient selon la firme et la taille du compte ; consultez donc les règles en vigueur de votre firme. Trader Lockout s'ajoute à ces limites ; il ne les remplace pas." },
    { type: "heading",text: "Comment configurer un Trader Lockout" },
    {
      type: "steps",
      items: [
        { title: "Connectez-vous à votre compte d'évaluation", html: "Ouvrez le trader web de Tradovate ou l'application mobile et connectez-vous au compte de simulation ou d'évaluation que vous souhaitez protéger. La fonctionnalité est disponible sur le web et sur mobile ; l'application de bureau ne la propose pas actuellement, utilisez donc l'une de ces deux options." },
        { title: "Ouvrez la commande de verrouillage", html: "Dans le trader web, repérez le bouton de verrouillage en haut de l'écran ; c'est généralement le bouton orange. Sur mobile, ouvrez le tiroir de navigation et trouvez la même commande. Appuyez dessus pour ouvrir le panneau de verrouillage." },
        { title: "Choisissez la durée de votre mise à l'écart", html: "Choisissez la durée. Les options prédéfinies sont 15 minutes, 30 minutes, 1 heure ou le reste de la session. Besoin d'une durée précise ? Définissez une durée personnalisée jusqu'au maximum de 24 heures. Adaptez la durée à la raison : un court temps de réflexion après un setup bancal, ou toute la session une fois votre objectif atteint." },
        { title: "Confirmez le verrouillage", html: "Cliquez sur <strong class='text-white'>Lock Account</strong> pour l'activer. C'est le point de non-retour : dès que vous confirmez, les trades ouverts sont clôturés et la porte se ferme. Vérifiez bien que la durée correspond à ce que vous voulez avant d'appuyer." },
        { title: "Surveillez le minuteur, puis laissez-le tourner", html: "Une fois le verrouillage actif, un compte à rebours s'affiche en haut du trader web. Cliquez sur le minuteur pour voir la date et l'heure exactes de la fin du verrouillage. Puis éloignez-vous : c'est tout l'intérêt. Quand l'horloge atteint zéro, le trading se rouvre de lui-même." },
      ],
    },
    { type: "heading",text: "Quand il vaut vraiment la peine de l'utiliser" },
    { type: "paragraph",html: "Le bouton n'aide que si vous l'utilisez avant de vous convaincre de ne pas le faire. Quelques déclencheurs sincères :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Vous avez atteint votre objectif de profit.</strong> Une journée verte est une journée verte. Verrouillez et protégez le chiffre au lieu de le rendre au marché.",
        "<strong class='text-white'>Vous êtes dans le rouge et vous brûlez de vous refaire.</strong> Un verrouillage de 30 minutes tue le revenge trading avant qu'il ne commence.",
        "<strong class='text-white'>Le marché est confus.</strong> Lors de pics liés aux actualités ou de mouvements erratiques, une pause de 15 minutes vous évite des setups bâclés.",
        "<strong class='text-white'>Vous avez une heure limite stricte.</strong> Verrouiller à midi, ou dans les 30 dernières minutes, impose la règle que vous enfreignez sans cesse.",
      ],
    },
    { type: "paragraph",html: "Associez-le aux garde-fous intégrés de Tradovate : fixez des limites de perte quotidiennes et hebdomadaires strictes, passez en revue l'ensemble de vos paramètres de risque du compte et sachez comment clôturer rapidement toutes vos positions et annuler vos ordres lorsque vous devez sortir de votre propre initiative." },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Fatigué de surveiller la plateforme pour faire respecter vos propres règles ? PickMyTrade automatise vos stratégies TradingView vers Tradovate afin que vos entrées, sorties et votre logique de risque s'exécutent toujours de la même manière, sans interférence émotionnelle." },
  ], it: [
    { type: "paragraph",html: "Alcuni dei trade peggiori avvengono subito dopo una grossa perdita, quando cerca di recuperarla, oppure subito dopo una grossa vincita, quando si sente imbattibile. Trader Lockout è il pulsante che la protegge da sé stesso. Chiude la porta del suo conto per un periodo stabilito: nessun nuovo ordine, nessuna eccezione, nemmeno una telefonata al supporto le restituisce l'accesso in anticipo. Ecco come impostarlo e quando vale davvero la pena premerlo." },
    { type: "heading",text: "Cosa fa Trader Lockout nel momento in cui lo attiva" },
    { type: "paragraph",html: "Quando conferma un blocco, accadono tre cose contemporaneamente:" },
    {
      type: "list",
