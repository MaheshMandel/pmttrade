---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-loss-limits";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Set Daily & Weekly Loss Limits in Tradovate";
const META_DESCRIPTION =
  "Tradovate loss limits: set daily and weekly loss caps and profit targets that auto-liquidate and lock your account before one bad session snowballs.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tägliche und wöchentliche Verlustlimits in Tradovate festlegen", es: "Configure límites de pérdida diarios y semanales en Tradovate", fr: "Définir des limites de perte quotidiennes et hebdomadaires dans Tradovate", it: "Impostare limiti di perdita giornalieri e settimanali in Tradovate" },
  dek: { en: "One ugly session can wipe out weeks of steady gains if you let it run. Here's how to set daily and weekly loss limits, plus profit targets, that automatically flatten your positions and lock the account the second you hit them.", de: "Eine einzige schlechte Session kann Wochen stetiger Gewinne zunichtemachen, wenn Sie sie laufen lassen. So legen Sie tägliche und wöchentliche Verlustlimits sowie Gewinnziele fest, die Ihre Positionen automatisch glattstellen und das Konto sperren, sobald sie erreicht werden.", es: "Una sola sesión mala puede borrar semanas de ganancias constantes si la deja correr. Así se configuran límites de pérdida diarios y semanales, además de objetivos de beneficio, que cierran automáticamente sus posiciones y bloquean la cuenta en cuanto se alcanzan.", fr: "Une seule mauvaise séance peut effacer des semaines de gains réguliers si vous la laissez courir. Voici comment définir des limites de perte quotidiennes et hebdomadaires, ainsi que des objectifs de profit, qui clôturent automatiquement vos positions et verrouillent le compte dès qu'ils sont atteints.", it: "Una sola brutta sessione può cancellare settimane di guadagni costanti se la lascia correre. Ecco come impostare limiti di perdita giornalieri e settimanali, oltre a obiettivi di profitto, che chiudono automaticamente le Sue posizioni e bloccano il conto non appena vengono raggiunti." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "One ugly session can wipe out weeks of steady gains if you let it run. Tradovate gives you a hard stop for exactly that problem. Whether you're enforcing your own discipline, protecting a funded account, or wiring up automation like PickMyTrade, you can set daily and weekly loss limits, plus profit targets, that automatically flatten your positions and lock the account the second you hit them. Here's how to set them up, and what to expect when one fires." },
    { type: "heading", text: "What Are Tradovate Loss Limits?" },
    { type: "paragraph", html: "Loss limits are account-level thresholds you configure under <strong class='text-white'>Risk Settings</strong>: a <strong class='text-white'>Daily Loss Limit</strong>, a <strong class='text-white'>Weekly Loss Limit</strong>, and matching profit triggers. Tradovate measures them on your real-time net P/L, commissions and fees included, not some rounded-off number after the fact. Hit a limit and the platform liquidates your open positions, cancels working orders, and locks the account until the next session. That last part matters: with the account locked, there's no talking yourself into one more revenge trade to \"make it back.\"" },
    { type: "heading", text: "Set Loss Limits in Tradovate: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open Risk Settings", html: "Log in to Tradovate, click the button in the upper-right corner to open <strong class='text-white'>Application Settings</strong>, then click <strong class='text-white'>Risk Settings</strong>.", image: { src: `${IMG}/tradovate-loss-limits-1.png`, alt: "Tradovate Application Settings menu showing the Risk Settings button" } },
        { title: "Choose the Account to Protect", html: "Pick the trading account you want to guard from the account selector, each account carries its own limits, so a setting on one won't cover another. These fields apply to live and demo Tradovate Brokerage accounts. On most prop-firm evaluation accounts the limits are pre-configured and controlled by the firm, so what you see varies by firm and account size. Check your firm's current rules before you touch anything.", image: { src: `${IMG}/tradovate-loss-limits-2.png`, alt: "Tradovate Risk Settings screen showing the account selector dropdown" } },
        { title: "Enable and Set Your Daily Loss Limit", html: "Toggle <strong class='text-white'>Daily Loss Limit</strong> on and enter the maximum net loss you're willing to take in a single session. Don't leave the field sitting at zero, an unset or zero value won't protect you the way you think. Tradovate's daily session runs from 5:00 PM CT to 3:45 PM CT the next day, and your P/L updates live as you trade, so the counter is always current.", image: { src: `${IMG}/tradovate-loss-limits-3.png`, alt: "Tradovate Risk Settings showing the Daily Loss Limit field enabled with a value" } },
        { title: "Add a Weekly Loss Limit", html: "Toggle <strong class='text-white'>Weekly Loss Limit</strong> on and enter your maximum cumulative loss for the week. The weekly session runs from 5:00 PM CT Sunday through 3:45 PM CT Friday. If your combined losses reach the cap, the account stays locked until it resets at 5:00 PM CT Sunday, a full stop for the rest of the week, not just the day.", image: { src: `${IMG}/tradovate-loss-limits-4.png`, alt: "Tradovate Risk Settings showing the Weekly Loss Limit field enabled with a value" } },
        { title: "Set Profit Targets and Save", html: "If you want to protect a good day, enable the <strong class='text-white'>Daily Profit Trigger</strong> and <strong class='text-white'>Weekly Profit Trigger</strong> to lock in gains once you're up by a set amount. When your platform offers a <strong class='text-white'>Lock Risk Settings</strong> toggle, turn it on so you can't quietly nudge a limit higher mid-session, that's the whole point of a hard rule. Then scroll down and click <strong class='text-white'>Save</strong> to apply everything.", image: { src: `${IMG}/tradovate-loss-limits-5.png`, alt: "Tradovate Risk Settings showing profit trigger fields and the Save button" } },
      ],
    },
    { type: "heading", text: "What Happens When a Limit Is Hit" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Auto-liquidation</strong>, your open positions are closed on a \"not held\" basis and any working orders are canceled.",
        "<strong class='text-white'>Account lock</strong>, no new positions until the next session: 5:00 PM CT for daily limits, 5:00 PM CT Sunday for weekly limits.",
        "<strong class='text-white'>Unlocking early</strong>, for a loss limit, raise the value or switch the setting off; a profit trigger that's already fired stays locked until the session resets.",
        "<strong class='text-white'>Margin still wins</strong>, your brokerage margin policy takes precedence, so a margin liquidation can fire before your custom loss limit ever does.",
      ],
    },
    { type: "heading", text: "Why You'd Need This" },
    {
      type: "list",
      items: [
        "Enforce hard discipline so a losing streak can't spiral into a big drawdown.",
        "Respect a funded account's daily and weekly loss rules without babysitting the balance every minute.",
        "Kill revenge trading outright, once you're locked out, you're done for the session.",
        "Bank a good day automatically by letting a profit trigger flatten and lock you out at your target.",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "PickMyTrade wires your TradingView alerts straight through to Tradovate, so your strategy's entries and exits fire on their own while your Risk Settings sit underneath as the hard backstop. No manual clicking, no second-guessing a stop when the tape gets fast." },
  ], de: [
    { type: "paragraph",html: "Eine einzige schlechte Session kann Wochen stetiger Gewinne zunichtemachen, wenn Sie sie laufen lassen. Tradovate bietet Ihnen genau dafür einen harten Stopp. Ob Sie Ihre eigene Disziplin durchsetzen, ein finanziertes Konto schützen oder Automatisierung wie PickMyTrade einrichten: Sie können tägliche und wöchentliche Verlustlimits sowie Gewinnziele festlegen, die Ihre Positionen automatisch glattstellen und das Konto sperren, sobald sie erreicht werden. So richten Sie sie ein und das erwartet Sie, wenn eines ausgelöst wird." },
    { type: "heading",text: "Was sind Verlustlimits in Tradovate?" },
    { type: "paragraph",html: "Verlustlimits sind Schwellenwerte auf Kontoebene, die Sie unter <strong class='text-white'>Risk Settings</strong> konfigurieren: ein <strong class='text-white'>Daily Loss Limit</strong>, ein <strong class='text-white'>Weekly Loss Limit</strong> und entsprechende Gewinn-Trigger. Tradovate misst sie am Echtzeit-Netto-P/L, einschließlich Provisionen und Gebühren, und nicht an einer nachträglich gerundeten Zahl. Wird ein Limit erreicht, liquidiert die Plattform Ihre offenen Positionen, storniert aktive Orders und sperrt das Konto bis zur nächsten Session. Das ist entscheidend: Bei gesperrtem Konto gibt es keinen Grund mehr, sich zu einem weiteren Rache-Trade zu überreden, um „es wieder reinzuholen“." },
    { type: "heading",text: "Verlustlimits in Tradovate festlegen: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Risk Settings öffnen", html: "Melden Sie sich bei Tradovate an, klicken Sie auf die Schaltfläche in der oberen rechten Ecke, um die <strong class='text-white'>Application Settings</strong> zu öffnen, und klicken Sie dann auf <strong class='text-white'>Risk Settings</strong>.", image: {"src":`${IMG}/tradovate-loss-limits-1.png`,"alt":"Tradovate-Menü Application Settings mit der Schaltfläche Risk Settings"} },
        { title: "Das zu schützende Konto auswählen", html: "Wählen Sie im Kontoauswahlmenü das Handelskonto aus, das Sie absichern möchten. Jedes Konto hat seine eigenen Limits, eine Einstellung bei einem Konto gilt also nicht für ein anderes. Diese Felder gelten für Live- und Demo-Konten bei Tradovate Brokerage. Bei den meisten Prop-Firm-Evaluierungskonten sind die Limits vorkonfiguriert und werden vom Unternehmen kontrolliert, sodass das, was Sie sehen, je nach Firma und Kontogröße variiert. Prüfen Sie die aktuellen Regeln Ihrer Firma, bevor Sie etwas ändern.", image: {"src":`${IMG}/tradovate-loss-limits-2.png`,"alt":"Tradovate-Bildschirm Risk Settings mit dem Dropdown zur Kontoauswahl"} },
        { title: "Daily Loss Limit aktivieren und festlegen", html: "Schalten Sie <strong class='text-white'>Daily Loss Limit</strong> ein und geben Sie den maximalen Nettoverlust ein, den Sie in einer einzelnen Session hinnehmen möchten. Lassen Sie das Feld nicht auf null stehen, ein nicht gesetzter oder auf null stehender Wert schützt Sie nicht so, wie Sie denken. Die tägliche Tradovate-Session läuft von 17:00 Uhr CT bis 15:45 Uhr CT am nächsten Tag, und Ihr P/L wird beim Handeln live aktualisiert, sodass der Zähler stets aktuell ist.", image: {"src":`${IMG}/tradovate-loss-limits-3.png`,"alt":"Tradovate Risk Settings mit aktiviertem Feld Daily Loss Limit und eingetragenem Wert"} },
        { title: "Weekly Loss Limit hinzufügen", html: "Schalten Sie <strong class='text-white'>Weekly Loss Limit</strong> ein und geben Sie Ihren maximalen kumulierten Verlust für die Woche ein. Die wöchentliche Session läuft von Sonntag 17:00 Uhr CT bis Freitag 15:45 Uhr CT. Erreichen Ihre aufaddierten Verluste das Limit, bleibt das Konto gesperrt, bis es am Sonntag um 17:00 Uhr CT zurückgesetzt wird, ein vollständiger Stopp für den Rest der Woche, nicht nur für den Tag.", image: {"src":`${IMG}/tradovate-loss-limits-4.png`,"alt":"Tradovate Risk Settings mit aktiviertem Feld Weekly Loss Limit und eingetragenem Wert"} },
        { title: "Gewinnziele festlegen und speichern", html: "Wenn Sie einen guten Tag absichern möchten, aktivieren Sie <strong class='text-white'>Daily Profit Trigger</strong> und <strong class='text-white'>Weekly Profit Trigger</strong>, um Gewinne zu sichern, sobald Sie einen bestimmten Betrag im Plus sind. Wenn Ihre Plattform einen Schalter <strong class='text-white'>Lock Risk Settings</strong> anbietet, schalten Sie ihn ein, damit Sie ein Limit mitten in der Session nicht heimlich nach oben schieben können, das ist der ganze Sinn einer harten Regel. Scrollen Sie anschließend nach unten und klicken Sie auf <strong class='text-white'>Save</strong>, um alles zu übernehmen.", image: {"src":`${IMG}/tradovate-loss-limits-5.png`,"alt":"Tradovate Risk Settings mit den Feldern für Gewinn-Trigger und der Schaltfläche Save"} },
      ],
    },
    { type: "heading",text: "Was passiert, wenn ein Limit erreicht wird" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Automatische Liquidation</strong>, Ihre offenen Positionen werden auf „Not held“-Basis geschlossen und alle aktiven Orders storniert.",
        "<strong class='text-white'>Kontosperre</strong>, keine neuen Positionen bis zur nächsten Session: 17:00 Uhr CT bei Tagesgrenzen, Sonntag 17:00 Uhr CT bei Wochengrenzen.",
        "<strong class='text-white'>Vorzeitiges Entsperren</strong>, bei einem Verlustlimit erhöhen Sie den Wert oder schalten die Einstellung aus; ein bereits ausgelöster Gewinn-Trigger bleibt bis zum Zurücksetzen der Session gesperrt.",
        "<strong class='text-white'>Die Margin hat Vorrang</strong>, die Margin-Richtlinie Ihres Brokers hat Vorrang, sodass eine Margin-Liquidation ausgelöst werden kann, bevor Ihr individuelles Verlustlimit überhaupt greift.",
      ],
    },
    { type: "heading",text: "Warum Sie das brauchen" },
    {
      type: "list",
      items: [
        "Setzen Sie harte Disziplin durch, damit eine Verlustserie nicht zu einem großen Drawdown eskaliert.",
        "Halten Sie die täglichen und wöchentlichen Verlustregeln eines finanzierten Kontos ein, ohne minütlich den Kontostand zu überwachen.",
        "Beenden Sie Revenge-Trading konsequent, sobald Sie gesperrt sind, ist die Session für Sie beendet.",
        "Sichern Sie einen guten Tag automatisch, indem ein Gewinn-Trigger Ihre Positionen bei Ihrem Ziel glattstellt und Sie aussperrt.",
      ],
    },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "PickMyTrade leitet Ihre TradingView-Alerts direkt an Tradovate weiter, sodass die Einstiege und Ausstiege Ihrer Strategie automatisch erfolgen, während Ihre Risk Settings darunter als hartes Sicherheitsnetz wirken. Kein manuelles Klicken, kein Zweifeln an einem Stopp, wenn der Markt schnell wird." },
  ], es: [
    { type: "paragraph",html: "Una sola sesión mala puede borrar semanas de ganancias constantes si la deja correr. Tradovate le ofrece un freno definitivo para ese problema. Ya sea que esté reforzando su propia disciplina, protegiendo una cuenta fondeada o configurando automatización como PickMyTrade, puede establecer límites de pérdida diarios y semanales, además de objetivos de beneficio, que cierran automáticamente sus posiciones y bloquean la cuenta en el instante en que se alcanzan. Así se configuran y qué esperar cuando uno se activa." },
    { type: "heading",text: "¿Qué son los límites de pérdida de Tradovate?" },
    { type: "paragraph",html: "Los límites de pérdida son umbrales a nivel de cuenta que usted configura en <strong class='text-white'>Risk Settings</strong>: un <strong class='text-white'>Daily Loss Limit</strong>, un <strong class='text-white'>Weekly Loss Limit</strong> y los activadores de beneficio correspondientes. Tradovate los mide sobre su P/L neto en tiempo real, con comisiones y tarifas incluidas, no sobre una cifra redondeada después. Si alcanza un límite, la plataforma liquida sus posiciones abiertas, cancela las órdenes activas y bloquea la cuenta hasta la siguiente sesión. Esto último es importante: con la cuenta bloqueada, no hay forma de convencerse de hacer una operación de venganza más para «recuperarlo»." },
    { type: "heading",text: "Configurar límites de pérdida en Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra Risk Settings", html: "Inicie sesión en Tradovate, haga clic en el botón de la esquina superior derecha para abrir <strong class='text-white'>Application Settings</strong> y luego haga clic en <strong class='text-white'>Risk Settings</strong>.", image: {"src":`${IMG}/tradovate-loss-limits-1.png`,"alt":"Menú Application Settings de Tradovate con el botón Risk Settings"} },
        { title: "Elija la cuenta que desea proteger", html: "Seleccione en el selector de cuentas la cuenta de trading que desea proteger; cada cuenta tiene sus propios límites, por lo que un ajuste en una no cubre a otra. Estos campos se aplican a cuentas reales y demo de Tradovate Brokerage. En la mayoría de las cuentas de evaluación de prop firms los límites están preconfigurados y los controla la firma, por lo que lo que vea variará según la firma y el tamaño de la cuenta. Consulte las reglas vigentes de su firma antes de tocar nada.", image: {"src":`${IMG}/tradovate-loss-limits-2.png`,"alt":"Pantalla Risk Settings de Tradovate con el desplegable del selector de cuentas"} },
        { title: "Active y establezca su Daily Loss Limit", html: "Active <strong class='text-white'>Daily Loss Limit</strong> e introduzca la pérdida neta máxima que está dispuesto a asumir en una sola sesión. No deje el campo en cero; un valor sin definir o en cero no le protegerá como cree. La sesión diaria de Tradovate va de las 5:00 PM CT a las 3:45 PM CT del día siguiente, y su P/L se actualiza en vivo mientras opera, por lo que el contador siempre está al día.", image: {"src":`${IMG}/tradovate-loss-limits-3.png`,"alt":"Risk Settings de Tradovate con el campo Daily Loss Limit activado y con un valor"} },
        { title: "Añada un Weekly Loss Limit", html: "Active <strong class='text-white'>Weekly Loss Limit</strong> e introduzca su pérdida acumulada máxima para la semana. La sesión semanal va de las 5:00 PM CT del domingo a las 3:45 PM CT del viernes. Si sus pérdidas combinadas alcanzan el tope, la cuenta permanece bloqueada hasta que se restablece a las 5:00 PM CT del domingo; es una parada total durante el resto de la semana, no solo del día.", image: {"src":`${IMG}/tradovate-loss-limits-4.png`,"alt":"Risk Settings de Tradovate con el campo Weekly Loss Limit activado y con un valor"} },
        { title: "Establezca objetivos de beneficio y guarde", html: "Si desea proteger un buen día, active <strong class='text-white'>Daily Profit Trigger</strong> y <strong class='text-white'>Weekly Profit Trigger</strong> para asegurar las ganancias una vez que supere un importe determinado. Cuando su plataforma ofrezca un interruptor <strong class='text-white'>Lock Risk Settings</strong>, actívelo para no poder subir un límite a escondidas a mitad de sesión; ese es precisamente el objetivo de una regla firme. Después desplácese hacia abajo y haga clic en <strong class='text-white'>Save</strong> para aplicar todo.", image: {"src":`${IMG}/tradovate-loss-limits-5.png`,"alt":"Risk Settings de Tradovate con los campos de activadores de beneficio y el botón Save"} },
      ],
    },
    { type: "heading",text: "Qué ocurre cuando se alcanza un límite" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Liquidación automática</strong>, sus posiciones abiertas se cierran sin mantenerlas («not held») y se cancelan las órdenes activas.",
        "<strong class='text-white'>Bloqueo de la cuenta</strong>, no se pueden abrir posiciones nuevas hasta la siguiente sesión: 5:00 PM CT para los límites diarios, domingo 5:00 PM CT para los semanales.",
        "<strong class='text-white'>Desbloqueo anticipado</strong>, en un límite de pérdida, aumente el valor o desactive el ajuste; un activador de beneficio que ya se disparó permanece bloqueado hasta que se restablece la sesión.",
        "<strong class='text-white'>El margen manda</strong>, la política de margen de su bróker tiene prioridad, por lo que una liquidación por margen puede activarse antes de que llegue su límite de pérdida personalizado.",
      ],
    },
    { type: "heading",text: "Por qué lo necesitaría" },
    {
      type: "list",
      items: [
        "Imponga una disciplina estricta para que una racha perdedora no derive en un gran drawdown.",
        "Respete las reglas de pérdida diaria y semanal de una cuenta fondeada sin vigilar el saldo cada minuto.",
        "Elimine de raíz el revenge trading: una vez bloqueado, ha terminado por esa sesión.",
        "Asegure un buen día automáticamente dejando que un activador de beneficio cierre sus posiciones y le bloquee al alcanzar su objetivo.",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "PickMyTrade conecta sus alertas de TradingView directamente con Tradovate, de modo que las entradas y salidas de su estrategia se ejecutan solas mientras sus Risk Settings actúan debajo como respaldo firme. Sin clics manuales y sin dudar de un stop cuando el mercado se acelera." },
  ], fr: [
    { type: "paragraph",html: "Une seule mauvaise séance peut effacer des semaines de gains réguliers si vous la laissez courir. Tradovate vous offre précisément un arrêt strict contre ce problème. Que vous cherchiez à faire respecter votre propre discipline, à protéger un compte financé ou à mettre en place une automatisation comme PickMyTrade, vous pouvez définir des limites de perte quotidiennes et hebdomadaires, ainsi que des objectifs de profit, qui clôturent automatiquement vos positions et verrouillent le compte à la seconde où ils sont atteints. Voici comment les configurer et à quoi vous attendre lorsqu'une limite se déclenche." },
    { type: "heading",text: "Que sont les limites de perte de Tradovate ?" },
    { type: "paragraph",html: "Les limites de perte sont des seuils au niveau du compte que vous configurez dans <strong class='text-white'>Risk Settings</strong> : un <strong class='text-white'>Daily Loss Limit</strong>, un <strong class='text-white'>Weekly Loss Limit</strong> et les déclencheurs de profit correspondants. Tradovate les mesure sur votre P/L net en temps réel, commissions et frais inclus, et non sur un chiffre arrondi après coup. Lorsqu'une limite est atteinte, la plateforme liquide vos positions ouvertes, annule les ordres en attente et verrouille le compte jusqu'à la séance suivante. Ce dernier point est essentiel : compte verrouillé, impossible de vous convaincre de faire un dernier trade de revanche pour « vous refaire »." },
    { type: "heading",text: "Définir des limites de perte dans Tradovate : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir Risk Settings", html: "Connectez-vous à Tradovate, cliquez sur le bouton situé dans le coin supérieur droit pour ouvrir <strong class='text-white'>Application Settings</strong>, puis cliquez sur <strong class='text-white'>Risk Settings</strong>.", image: {"src":`${IMG}/tradovate-loss-limits-1.png`,"alt":"Menu Application Settings de Tradovate affichant le bouton Risk Settings"} },
        { title: "Choisir le compte à protéger", html: "Sélectionnez le compte de trading à protéger dans le sélecteur de compte ; chaque compte possède ses propres limites, un réglage sur l'un ne couvre donc pas un autre. Ces champs s'appliquent aux comptes réels et démo de Tradovate Brokerage. Sur la plupart des comptes d'évaluation de prop firm, les limites sont préconfigurées et contrôlées par la société, de sorte que ce que vous voyez varie selon la firme et la taille du compte. Vérifiez les règles en vigueur de votre firme avant de toucher à quoi que ce soit.", image: {"src":`${IMG}/tradovate-loss-limits-2.png`,"alt":"Écran Risk Settings de Tradovate avec la liste déroulante du sélecteur de compte"} },
        { title: "Activer et définir votre Daily Loss Limit", html: "Activez <strong class='text-white'>Daily Loss Limit</strong> et saisissez la perte nette maximale que vous acceptez de subir en une seule séance. Ne laissez pas le champ à zéro : une valeur non définie ou nulle ne vous protège pas comme vous le pensez. La séance quotidienne de Tradovate s'étend de 17 h 00 CT à 15 h 45 CT le lendemain, et votre P/L se met à jour en direct pendant que vous tradez, si bien que le compteur est toujours à jour.", image: {"src":`${IMG}/tradovate-loss-limits-3.png`,"alt":"Risk Settings de Tradovate avec le champ Daily Loss Limit activé et une valeur renseignée"} },
        { title: "Ajouter un Weekly Loss Limit", html: "Activez <strong class='text-white'>Weekly Loss Limit</strong> et saisissez votre perte cumulée maximale pour la semaine. La séance hebdomadaire s'étend du dimanche 17 h 00 CT au vendredi 15 h 45 CT. Si vos pertes cumulées atteignent le plafond, le compte reste verrouillé jusqu'à sa réinitialisation le dimanche à 17 h 00 CT : un arrêt complet pour le reste de la semaine, pas seulement pour la journée.", image: {"src":`${IMG}/tradovate-loss-limits-4.png`,"alt":"Risk Settings de Tradovate avec le champ Weekly Loss Limit activé et une valeur renseignée"} },
