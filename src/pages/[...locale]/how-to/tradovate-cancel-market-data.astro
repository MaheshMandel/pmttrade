---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-cancel-market-data";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Cancel or Change Tradovate Market Data";
const META_DESCRIPTION =
  "Cancel a Tradovate market data renewal in Application Settings, keep live quotes through month-end, and stop next month's exchange data fee.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate-Marktdaten kündigen oder ändern", es: "Cancelar o cambiar los datos de mercado de Tradovate", fr: "Annuler ou modifier les données de marché Tradovate", it: "Annullare o modificare i dati di mercato Tradovate" },
  dek: { en: "Paying for a Tradovate exchange feed you've stopped using? You can turn the renewal off yourself in about a minute. Here's the exact path, plus the one detail that trips people up: when the cancellation actually kicks in.", de: "Zahlen Sie für einen Tradovate-Börsenfeed, den Sie nicht mehr nutzen? Sie können die Verlängerung in etwa einer Minute selbst abschalten. Hier ist der genaue Weg, plus das eine Detail, an dem viele stolpern: wann die Kündigung tatsächlich wirksam wird.", es: "¿Está pagando por un feed de bolsa de Tradovate que ya no usa? Puede desactivar la renovación usted mismo en aproximadamente un minuto. Aquí está la ruta exacta, además del detalle que suele confundir: cuándo entra realmente en vigor la cancelación.", fr: "Vous payez un flux boursier Tradovate que vous n’utilisez plus ? Vous pouvez désactiver le renouvellement vous-même en environ une minute. Voici le chemin exact, ainsi que le détail qui piège souvent : le moment où l’annulation prend réellement effet.", it: "Sta pagando un feed di borsa Tradovate che non usa più? Può disattivare il rinnovo da solo in circa un minuto. Ecco il percorso esatto, più il dettaglio che mette in difficoltà molti: quando l’annullamento diventa effettivo." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Paying for a Tradovate exchange feed you've stopped using? Or maybe you added Level II months ago and only need Level I now. Either way, you don't have to email support to fix it, you can turn the renewal off yourself in about a minute. Here's the exact path, plus one detail that trips people up: when the cancellation actually kicks in." },
    { type: "heading", text: "How Tradovate Market-Data Billing Works" },
    { type: "paragraph", html: "Live exchange data on Tradovate is a monthly subscription tied to your login. It renews on the <strong class='text-white'>1st of every month</strong>, and it's <strong class='text-white'>not prorated</strong>, you're charged the full amount for the month no matter which day you signed up or cancel. That's the key thing to understand: canceling doesn't refund the current month or cut off your data today. It stops the <em>next</em> renewal. Your feed stays live through the last day of the current month, then quietly expires." },
    { type: "heading", text: "Cancel a Tradovate Market-Data Subscription: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open Application Settings and Click Subscriptions", html: "Log into Tradovate on the web platform. Click the <strong class='text-white'>slider-bar icon</strong> in the upper-right corner to open <strong class='text-white'>Application Settings</strong>, then click the <strong class='text-white'>Subscriptions</strong> tab." },
        { title: "Scroll to Market Data and Review What's Active", html: "Scroll down to the <strong class='text-white'>Market Data</strong> section. This lists every live exchange package attached to your account, CME, EUREX, Level I, Level II, and so on. Take a second to read it before you touch anything, so you cancel the right feed and keep the ones you still use." },
        { title: "Select Cancel Renewal", html: "Find the subscription you want to drop and select <strong class='text-white'>Cancel Renewal</strong>. That's it for the cancel itself, you're telling Tradovate not to bill this feed again on the 1st. Because the charge already covers the whole current month, nothing changes on your screen right now." },
        { title: "Confirm the End-of-Month Expiration Date", html: "Once you cancel, Tradovate stamps the subscription with an <strong class='text-white'>expiration date on the last day of the current month</strong>. Check that it's there. Seeing that date is your confirmation that the feed won't renew, you keep live quotes until month-end, and no fresh charge posts on the 1st." },
      ],
    },
    { type: "heading", text: "Changing Your Data Instead of Canceling" },
    { type: "paragraph", html: "Want to swap packages rather than kill the feed entirely, drop Level II but keep Level I, say? In the same Market Data section, use the <strong class='text-white'>Change</strong> control to open your options. You can also set what next month looks like: select the upcoming month and uncheck <strong class='text-white'>\"Same as the current month\"</strong>, then pick the packages you want going forward. The current month stays as-is; your edits take effect on the 1st." },
    { type: "quote", html: "<strong class='text-white'>On a prop-firm or evaluation account?</strong> The Level I CME data on those accounts is enabled and managed by the firm that owns the account, not by you. Contact your provider to change or renew it. You can still add or drop optional Level II / EUREX packages yourself from the Subscriptions page." },
    { type: "heading", text: "Why Cancel or Change Your Market Data" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Trim recurring fees</strong>, if you've gone quiet for a while or only trade one exchange, there's no reason to keep paying for feeds you don't touch.",
        "<strong class='text-white'>Right-size your depth</strong>, plenty of traders start with Level II, then realize Level I is all their strategy needs. Downgrading is cleaner than paying for both.",
        "<strong class='text-white'>Avoid the surprise 1st-of-month charge</strong>, cancel before month-end and the next renewal simply never happens.",
        "<strong class='text-white'>Keep your data current</strong>, as your setup changes, your subscriptions should follow it instead of running on autopilot.",
      ],
    },
    { type: "heading", text: "Automate Your Tradovate Trading With PickMyTrade" },
    { type: "paragraph", html: "Once your data's sorted, PickMyTrade routes your TradingView alerts straight to Tradovate so entries, stops, and targets fire on their own, no sitting at the DOM waiting for a signal. Wire it up once and let your strategy run while you're away from the screen." },
  ], de: [
    { type: "paragraph",html: "Zahlen Sie für einen Tradovate-Börsenfeed, den Sie nicht mehr nutzen? Oder haben Sie vor Monaten Level II hinzugefügt und brauchen jetzt nur noch Level I? In beiden Fällen müssen Sie dem Support nicht schreiben: Sie können die Verlängerung in etwa einer Minute selbst abschalten. Hier ist der genaue Weg, plus ein Detail, an dem viele stolpern: wann die Kündigung tatsächlich wirksam wird." },
    { type: "heading",text: "So funktioniert die Abrechnung der Tradovate-Marktdaten" },
    { type: "paragraph",html: "Live-Börsendaten bei Tradovate sind ein Monatsabonnement, das an Ihren Login gebunden ist. Es verlängert sich am <strong class='text-white'>1. jedes Monats</strong> und wird <strong class='text-white'>nicht anteilig berechnet</strong>, Ihnen wird der volle Betrag für den Monat berechnet, egal an welchem Tag Sie sich anmelden oder kündigen. Das ist der entscheidende Punkt: Die Kündigung erstattet den laufenden Monat nicht und schaltet Ihre Daten nicht sofort ab. Sie stoppt die <em>nächste</em> Verlängerung. Ihr Feed bleibt bis zum letzten Tag des laufenden Monats aktiv und läuft dann still aus." },
    { type: "heading",text: "Ein Tradovate-Marktdatenabonnement kündigen: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Application Settings öffnen und auf Subscriptions klicken", html: "Melden Sie sich auf der Tradovate-Webplattform an. Klicken Sie oben rechts auf das <strong class='text-white'>Schieberegler-Symbol</strong>, um die <strong class='text-white'>Application Settings</strong> zu öffnen, und klicken Sie dann auf den Tab <strong class='text-white'>Subscriptions</strong>." },
        { title: "Zu Market Data scrollen und aktive Pakete prüfen", html: "Scrollen Sie nach unten zum Bereich <strong class='text-white'>Market Data</strong>. Dort sind alle aktiven Börsenpakete Ihres Kontos aufgelistet, CME, EUREX, Level I, Level II und so weiter. Nehmen Sie sich einen Moment Zeit, die Liste zu lesen, bevor Sie etwas anklicken, damit Sie den richtigen Feed kündigen und die Feeds behalten, die Sie noch nutzen." },
        { title: "Cancel Renewal auswählen", html: "Suchen Sie das Abonnement, das Sie beenden möchten, und wählen Sie <strong class='text-white'>Cancel Renewal</strong>. Das ist schon die ganze Kündigung, Sie teilen Tradovate mit, diesen Feed am 1. nicht erneut abzurechnen. Da die Gebühr bereits den gesamten laufenden Monat abdeckt, ändert sich auf Ihrem Bildschirm vorerst nichts." },
        { title: "Das Ablaufdatum zum Monatsende bestätigen", html: "Nach der Kündigung versieht Tradovate das Abonnement mit einem <strong class='text-white'>Ablaufdatum am letzten Tag des laufenden Monats</strong>. Prüfen Sie, ob es vorhanden ist. Dieses Datum ist Ihre Bestätigung, dass der Feed nicht verlängert wird, Sie behalten Live-Kurse bis zum Monatsende, und am 1. wird keine neue Gebühr gebucht." },
      ],
    },
    { type: "heading",text: "Daten ändern statt kündigen" },
    { type: "paragraph",html: "Möchten Sie Pakete tauschen, statt den Feed ganz zu beenden, etwa Level II abbestellen, aber Level I behalten? Nutzen Sie im selben Bereich Market Data das Steuerelement <strong class='text-white'>Change</strong>, um Ihre Optionen zu öffnen. Sie können auch festlegen, wie der nächste Monat aussieht: Wählen Sie den kommenden Monat aus, deaktivieren Sie <strong class='text-white'>\"Same as the current month\"</strong> und wählen Sie dann die Pakete, die Sie künftig haben möchten. Der laufende Monat bleibt unverändert; Ihre Änderungen gelten ab dem 1." },
    { type: "quote",html: "<strong class='text-white'>Prop-Firm- oder Evaluierungskonto?</strong> Die Level-I-CME-Daten dieser Konten werden von der Firma aktiviert und verwaltet, der das Konto gehört, nicht von Ihnen. Wenden Sie sich an Ihren Anbieter, um sie zu ändern oder zu verlängern. Optionale Level-II- bzw. EUREX-Pakete können Sie weiterhin selbst auf der Seite Subscriptions hinzufügen oder entfernen." },
    { type: "heading",text: "Warum Sie Ihre Marktdaten kündigen oder ändern sollten" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Laufende Gebühren senken</strong>, wenn Sie eine Weile pausieren oder nur eine Börse handeln, gibt es keinen Grund, für ungenutzte Feeds zu zahlen.",
        "<strong class='text-white'>Die Tiefe passend dimensionieren</strong>, viele Trader starten mit Level II und stellen dann fest, dass ihre Strategie nur Level I braucht. Ein Downgrade ist sauberer, als für beides zu zahlen.",
        "<strong class='text-white'>Die Überraschungsabbuchung am Monatsersten vermeiden</strong>, kündigen Sie vor Monatsende, und die nächste Verlängerung findet schlicht nicht statt.",
        "<strong class='text-white'>Ihre Daten aktuell halten</strong>, wenn sich Ihr Setup ändert, sollten Ihre Abonnements mitziehen, statt auf Autopilot weiterzulaufen.",
      ],
    },
    { type: "heading",text: "Tradovate-Trading mit PickMyTrade automatisieren" },
    { type: "paragraph",html: "Sobald Ihre Daten geregelt sind, leitet PickMyTrade Ihre TradingView-Alarme direkt an Tradovate weiter, sodass Einstiege, Stopps und Ziele von selbst ausgelöst werden, ohne dass Sie am DOM auf ein Signal warten müssen. Richten Sie es einmal ein und lassen Sie Ihre Strategie laufen, während Sie nicht am Bildschirm sind." },
  ], es: [
    { type: "paragraph",html: "¿Está pagando por un feed de bolsa de Tradovate que ya no usa? ¿O quizá añadió Level II hace meses y ahora solo necesita Level I? En cualquier caso, no tiene que escribir al soporte: puede desactivar la renovación usted mismo en aproximadamente un minuto. Aquí está la ruta exacta, además de un detalle que suele confundir: cuándo entra realmente en vigor la cancelación." },
    { type: "heading",text: "Cómo funciona la facturación de los datos de mercado de Tradovate" },
    { type: "paragraph",html: "Los datos de bolsa en vivo de Tradovate son una suscripción mensual vinculada a su inicio de sesión. Se renueva el <strong class='text-white'>día 1 de cada mes</strong> y <strong class='text-white'>no se prorratea</strong>, se le cobra el importe completo del mes sin importar qué día se suscriba o cancele. Esto es lo fundamental: cancelar no reembolsa el mes en curso ni corta sus datos hoy. Detiene la <em>siguiente</em> renovación. Su feed sigue activo hasta el último día del mes en curso y luego expira discretamente." },
    { type: "heading",text: "Cancelar una suscripción de datos de mercado de Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra Application Settings y haga clic en Subscriptions", html: "Inicie sesión en la plataforma web de Tradovate. Haga clic en el <strong class='text-white'>icono de barras deslizantes</strong> de la esquina superior derecha para abrir <strong class='text-white'>Application Settings</strong> y luego en la pestaña <strong class='text-white'>Subscriptions</strong>." },
        { title: "Desplácese hasta Market Data y revise lo que está activo", html: "Desplácese hacia abajo hasta la sección <strong class='text-white'>Market Data</strong>. Allí aparece cada paquete de bolsa activo en su cuenta: CME, EUREX, Level I, Level II, etc. Tómese un momento para leerlo antes de tocar nada, de modo que cancele el feed correcto y conserve los que todavía usa." },
        { title: "Seleccione Cancel Renewal", html: "Busque la suscripción que quiere dar de baja y seleccione <strong class='text-white'>Cancel Renewal</strong>. Eso es todo para la cancelación en sí: le indica a Tradovate que no vuelva a cobrar este feed el día 1. Como el cargo ya cubre todo el mes en curso, en su pantalla no cambia nada por ahora." },
        { title: "Confirme la fecha de vencimiento de fin de mes", html: "Una vez cancelada, Tradovate marca la suscripción con una <strong class='text-white'>fecha de vencimiento en el último día del mes en curso</strong>. Compruebe que aparezca. Ver esa fecha es su confirmación de que el feed no se renovará: conserva las cotizaciones en vivo hasta fin de mes y no se aplica ningún cargo nuevo el día 1." },
      ],
    },
    { type: "heading",text: "Cambiar sus datos en lugar de cancelar" },
    { type: "paragraph",html: "¿Quiere cambiar de paquete en lugar de eliminar el feed por completo, por ejemplo dejar Level II pero conservar Level I? En la misma sección Market Data, use el control <strong class='text-white'>Change</strong> para abrir sus opciones. También puede definir cómo será el mes siguiente: seleccione el mes próximo, desmarque <strong class='text-white'>\"Same as the current month\"</strong> y elija los paquetes que desea de ahora en adelante. El mes en curso se mantiene igual; sus cambios entran en vigor el día 1." },
    { type: "quote",html: "<strong class='text-white'>¿Cuenta de prop firm o de evaluación?</strong> Los datos CME de Level I de esas cuentas los activa y gestiona la firma propietaria de la cuenta, no usted. Contacte con su proveedor para cambiarlos o renovarlos. Aun así, puede añadir o quitar usted mismo los paquetes opcionales de Level II / EUREX desde la página Subscriptions." },
    { type: "heading",text: "Por qué cancelar o cambiar sus datos de mercado" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Reducir las tarifas recurrentes</strong>, si lleva un tiempo sin operar o solo opera una bolsa, no hay motivo para seguir pagando feeds que no usa.",
        "<strong class='text-white'>Ajustar la profundidad a sus necesidades</strong>, muchos traders empiezan con Level II y luego descubren que su estrategia solo necesita Level I. Bajar de plan es más limpio que pagar por ambos.",
        "<strong class='text-white'>Evitar el cargo sorpresa del día 1</strong>, cancele antes de fin de mes y la siguiente renovación sencillamente no se produce.",
        "<strong class='text-white'>Mantener sus datos al día</strong>, a medida que cambia su configuración, sus suscripciones deberían seguirla en lugar de funcionar en piloto automático.",
      ],
    },
    { type: "heading",text: "Automatice su trading en Tradovate con PickMyTrade" },
    { type: "paragraph",html: "Una vez resueltos sus datos, PickMyTrade enruta sus alertas de TradingView directamente a Tradovate para que las entradas, los stops y los objetivos se ejecuten solos, sin quedarse frente al DOM esperando una señal. Configúrelo una vez y deje que su estrategia funcione mientras usted está lejos de la pantalla." },
  ], fr: [
    { type: "paragraph",html: "Vous payez un flux boursier Tradovate que vous n’utilisez plus ? Ou peut-être avez-vous ajouté Level II il y a des mois et n’avez plus besoin que de Level I ? Dans les deux cas, inutile d’écrire au support : vous pouvez désactiver le renouvellement vous-même en environ une minute. Voici le chemin exact, ainsi qu’un détail qui piège souvent : le moment où l’annulation prend réellement effet." },
    { type: "heading",text: "Comment fonctionne la facturation des données de marché Tradovate" },
    { type: "paragraph",html: "Les données boursières en direct de Tradovate sont un abonnement mensuel lié à votre identifiant. Il se renouvelle le <strong class='text-white'>1er de chaque mois</strong> et n’est <strong class='text-white'>pas calculé au prorata</strong> : le montant total du mois vous est facturé, quel que soit le jour de votre souscription ou de votre annulation. C’est le point essentiel : annuler ne rembourse pas le mois en cours et ne coupe pas vos données aujourd’hui. Cela arrête le renouvellement <em>suivant</em>. Votre flux reste actif jusqu’au dernier jour du mois en cours, puis expire discrètement." },
    { type: "heading",text: "Annuler un abonnement de données de marché Tradovate : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez Application Settings et cliquez sur Subscriptions", html: "Connectez-vous à la plateforme web Tradovate. Cliquez sur l’<strong class='text-white'>icône à curseurs</strong> en haut à droite pour ouvrir <strong class='text-white'>Application Settings</strong>, puis cliquez sur l’onglet <strong class='text-white'>Subscriptions</strong>." },
        { title: "Faites défiler jusqu’à Market Data et vérifiez ce qui est actif", html: "Faites défiler jusqu’à la section <strong class='text-white'>Market Data</strong>. Elle répertorie chaque forfait boursier actif sur votre compte, CME, EUREX, Level I, Level II, etc. Prenez un instant pour la lire avant de toucher à quoi que ce soit, afin d’annuler le bon flux et de conserver ceux que vous utilisez encore." },
        { title: "Sélectionnez Cancel Renewal", html: "Trouvez l’abonnement que vous souhaitez résilier et sélectionnez <strong class='text-white'>Cancel Renewal</strong>. C’est tout pour l’annulation proprement dite : vous indiquez à Tradovate de ne plus facturer ce flux le 1er. Comme le montant couvre déjà tout le mois en cours, rien ne change à l’écran pour le moment." },
        { title: "Confirmez la date d’expiration en fin de mois", html: "Une fois l’abonnement annulé, Tradovate y appose une <strong class='text-white'>date d’expiration au dernier jour du mois en cours</strong>. Vérifiez qu’elle est bien présente. Voir cette date confirme que le flux ne sera pas renouvelé : vous conservez vos cotations en direct jusqu’à la fin du mois et aucun nouveau prélèvement n’est effectué le 1er." },
      ],
    },
    { type: "heading",text: "Modifier vos données au lieu d’annuler" },
    { type: "paragraph",html: "Vous souhaitez changer de forfait plutôt que de supprimer complètement le flux, par exemple abandonner Level II mais conserver Level I ? Dans la même section Market Data, utilisez la commande <strong class='text-white'>Change</strong> pour ouvrir vos options. Vous pouvez aussi définir la configuration du mois suivant : sélectionnez le mois à venir, décochez <strong class='text-white'>\"Same as the current month\"</strong>, puis choisissez les forfaits souhaités pour la suite. Le mois en cours reste inchangé ; vos modifications prennent effet le 1er." },
    { type: "quote",html: "<strong class='text-white'>Compte de prop firm ou d’évaluation ?</strong> Les données CME de Level I de ces comptes sont activées et gérées par la société propriétaire du compte, et non par vous. Contactez votre fournisseur pour les modifier ou les renouveler. Vous pouvez toujours ajouter ou retirer vous-même les forfaits optionnels Level II / EUREX depuis la page Subscriptions." },
    { type: "heading",text: "Pourquoi annuler ou modifier vos données de marché" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Réduire les frais récurrents</strong>, si vous êtes inactif depuis un moment ou ne tradez qu’une seule bourse, il n’y a aucune raison de continuer à payer des flux que vous n’utilisez pas.",
        "<strong class='text-white'>Dimensionner la profondeur au plus juste</strong>, beaucoup de traders commencent avec Level II, puis réalisent que Level I suffit à leur stratégie. Rétrograder est plus propre que de payer les deux.",
        "<strong class='text-white'>Éviter le prélèvement surprise du 1er du mois</strong>, annulez avant la fin du mois et le prochain renouvellement n’a tout simplement pas lieu.",
        "<strong class='text-white'>Garder vos données à jour</strong>, à mesure que votre configuration évolue, vos abonnements doivent suivre au lieu de tourner en pilotage automatique.",
      ],
    },
    { type: "heading",text: "Automatiser votre trading Tradovate avec PickMyTrade" },
    { type: "paragraph",html: "Une fois vos données réglées, PickMyTrade achemine vos alertes TradingView directement vers Tradovate afin que les entrées, les stops et les objectifs se déclenchent d’eux-mêmes, sans rester devant le DOM à attendre un signal. Configurez-le une fois et laissez votre stratégie tourner pendant que vous êtes loin de l’écran." },
  ], it: [
    { type: "paragraph",html: "Sta pagando un feed di borsa Tradovate che non usa più? O forse ha aggiunto Level II mesi fa e ora Le serve solo Level I? In ogni caso non deve scrivere al supporto: può disattivare il rinnovo da solo in circa un minuto. Ecco il percorso esatto, più un dettaglio che mette in difficoltà molti: quando l’annullamento diventa effettivo." },
    { type: "heading",text: "Come funziona la fatturazione dei dati di mercato Tradovate" },
    { type: "paragraph",html: "I dati di borsa in tempo reale di Tradovate sono un abbonamento mensile legato al Suo login. Si rinnova il <strong class='text-white'>1° di ogni mese</strong> e <strong class='text-white'>non è calcolato pro rata</strong>: Le viene addebitato l’importo intero del mese, indipendentemente dal giorno in cui si iscrive o annulla. È questo il punto chiave: annullare non rimborsa il mese in corso né interrompe i dati oggi. Ferma il rinnovo <em>successivo</em>. Il Suo feed resta attivo fino all’ultimo giorno del mese in corso, poi scade silenziosamente." },
    { type: "heading",text: "Annullare un abbonamento ai dati di mercato Tradovate: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Apra Application Settings e clicchi su Subscriptions", html: "Acceda alla piattaforma web di Tradovate. Clicchi sull’<strong class='text-white'>icona a cursori</strong> in alto a destra per aprire <strong class='text-white'>Application Settings</strong>, poi sulla scheda <strong class='text-white'>Subscriptions</strong>." },
        { title: "Scorra fino a Market Data e verifichi cosa è attivo", html: "Scorra verso il basso fino alla sezione <strong class='text-white'>Market Data</strong>. Elenca ogni pacchetto di borsa attivo sul Suo conto: CME, EUREX, Level I, Level II e così via. Si prenda un momento per leggerla prima di toccare qualsiasi cosa, così da annullare il feed giusto e mantenere quelli che usa ancora." },
        { title: "Selezioni Cancel Renewal", html: "Trovi l’abbonamento che desidera interrompere e selezioni <strong class='text-white'>Cancel Renewal</strong>. L’annullamento vero e proprio è tutto qui: dice a Tradovate di non addebitare più questo feed il giorno 1. Poiché l’addebito copre già l’intero mese in corso, per ora sullo schermo non cambia nulla." },
        { title: "Confermi la data di scadenza di fine mese", html: "Una volta annullato, Tradovate contrassegna l’abbonamento con una <strong class='text-white'>data di scadenza all’ultimo giorno del mese in corso</strong>. Verifichi che sia presente. Vedere quella data è la Sua conferma che il feed non si rinnoverà: mantiene le quotazioni in tempo reale fino a fine mese e nessun nuovo addebito viene registrato il giorno 1." },
      ],
    },
    { type: "heading",text: "Modificare i dati invece di annullare" },
    { type: "paragraph",html: "Vuole cambiare pacchetto invece di eliminare del tutto il feed, ad esempio rinunciare a Level II ma tenere Level I? Nella stessa sezione Market Data usi il controllo <strong class='text-white'>Change</strong> per aprire le opzioni. Può anche impostare come sarà il mese successivo: selezioni il mese prossimo, deselezioni <strong class='text-white'>\"Same as the current month\"</strong> e scelga i pacchetti che desidera per il futuro. Il mese in corso resta invariato; le Sue modifiche hanno effetto dal giorno 1." },
    { type: "quote",html: "<strong class='text-white'>Conto prop firm o di valutazione?</strong> I dati CME Level I su quei conti sono attivati e gestiti dalla società proprietaria del conto, non da Lei. Contatti il Suo fornitore per modificarli o rinnovarli. Può comunque aggiungere o rimuovere da solo i pacchetti opzionali Level II / EUREX dalla pagina Subscriptions." },
    { type: "heading",text: "Perché annullare o modificare i dati di mercato" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Ridurre i costi ricorrenti</strong>, se è rimasto inattivo per un po’ o opera su una sola borsa, non c’è motivo di continuare a pagare feed che non usa.",
        "<strong class='text-white'>Dimensionare correttamente la profondità</strong>, molti trader iniziano con Level II e poi si rendono conto che alla loro strategia basta Level I. Passare a un piano inferiore è più pulito che pagare entrambi.",
        "<strong class='text-white'>Evitare l’addebito a sorpresa del 1° del mese</strong>, annulli prima della fine del mese e il rinnovo successivo semplicemente non avviene.",
        "<strong class='text-white'>Mantenere aggiornati i dati</strong>, man mano che la Sua configurazione cambia, i Suoi abbonamenti dovrebbero seguirla invece di andare avanti col pilota automatico.",
      ],
    },
    { type: "heading",text: "Automatizzi il Suo trading Tradovate con PickMyTrade" },
    { type: "paragraph",html: "Una volta sistemati i dati, PickMyTrade instrada i Suoi alert di TradingView direttamente a Tradovate, così ingressi, stop e target scattano da soli, senza restare davanti al DOM ad aspettare un segnale. Lo configuri una volta e lasci che la Sua strategia lavori mentre è lontano dallo schermo." },
  ] },
  ctaHeading: { en: "Let Your Strategy Run While You're Away", de: "Lassen Sie Ihre Strategie laufen, während Sie unterwegs sind", es: "Deje que su estrategia funcione mientras usted no está", fr: "Laissez votre stratégie tourner en votre absence", it: "Lasci che la Sua strategia lavori mentre è via" },
  ctaText: { en: "Once your market data is sorted, let PickMyTrade route your TradingView alerts straight to Tradovate so entries, stops, and targets fire on their own.", de: "Sobald Ihre Marktdaten geregelt sind, lassen Sie PickMyTrade Ihre TradingView-Alarme direkt an Tradovate weiterleiten, sodass Einstiege, Stopps und Ziele von selbst ausgelöst werden.", es: "Una vez resueltos sus datos de mercado, deje que PickMyTrade enrute sus alertas de TradingView directamente a Tradovate para que las entradas, los stops y los objetivos se ejecuten solos.", fr: "Une fois vos données de marché réglées, laissez PickMyTrade acheminer vos alertes TradingView directement vers Tradovate afin que les entrées, les stops et les objectifs se déclenchent d’eux-mêmes.", it: "Una volta sistemati i dati di mercato, lasci che PickMyTrade instradi i Suoi alert di TradingView direttamente a Tradovate, così ingressi, stop e target scattano da soli." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Does canceling Tradovate market data give me a refund for this month?", a: "No. Data subscriptions are billed monthly and aren't prorated, so canceling doesn't refund the current month. Your feed stays live through the last day of the month, then expires without renewing." },
    { q: "When does my Tradovate data actually turn off after I cancel?", a: "At the end of the current month. Canceling renewal sets an expiration date on the month's final day. Until that date, your quotes keep updating normally; on the 1st, the feed just doesn't renew." },
    { q: "How do I cancel data on a prop-firm evaluation account?", a: "The included Level I CME data on evaluation and funded accounts is controlled by the prop firm, not by you, so reach out to your provider for those changes. Any optional Level II or EUREX packages you added can be canceled yourself from the Subscriptions page." },
  ], de: [
    { q: "Erhalte ich bei der Kündigung der Tradovate-Marktdaten eine Erstattung für diesen Monat?", a: "Nein. Datenabonnements werden monatlich abgerechnet und nicht anteilig berechnet, daher gibt es bei der Kündigung keine Erstattung für den laufenden Monat. Ihr Feed bleibt bis zum letzten Tag des Monats aktiv und läuft dann ohne Verlängerung aus." },
    { q: "Wann werden meine Tradovate-Daten nach der Kündigung tatsächlich abgeschaltet?", a: "Am Ende des laufenden Monats. Mit der Kündigung der Verlängerung wird ein Ablaufdatum auf den letzten Tag des Monats gesetzt. Bis dahin werden Ihre Kurse normal aktualisiert; am 1. wird der Feed einfach nicht mehr verlängert." },
    { q: "Wie kündige ich Daten bei einem Prop-Firm-Evaluierungskonto?", a: "Die enthaltenen Level-I-CME-Daten bei Evaluierungs- und Funded-Konten werden von der Prop Firm gesteuert, nicht von Ihnen. Wenden Sie sich für Änderungen daher an Ihren Anbieter. Zusätzlich gebuchte optionale Level-II- oder EUREX-Pakete können Sie selbst auf der Seite Subscriptions kündigen." },
  ], es: [
    { q: "¿Cancelar los datos de mercado de Tradovate me da un reembolso de este mes?", a: "No. Las suscripciones de datos se facturan mensualmente y no se prorratean, por lo que cancelar no reembolsa el mes en curso. Su feed sigue activo hasta el último día del mes y luego expira sin renovarse." },
    { q: "¿Cuándo se desactivan realmente mis datos de Tradovate después de cancelar?", a: "Al final del mes en curso. Al cancelar la renovación se fija una fecha de vencimiento en el último día del mes. Hasta esa fecha, sus cotizaciones se actualizan con normalidad; el día 1, el feed simplemente no se renueva." },
    { q: "¿Cómo cancelo los datos en una cuenta de evaluación de una prop firm?", a: "Los datos CME de Level I incluidos en las cuentas de evaluación y fondeadas los controla la prop firm, no usted, así que contacte con su proveedor para esos cambios. Cualquier paquete opcional de Level II o EUREX que haya añadido puede cancelarlo usted mismo desde la página Subscriptions." },
  ], fr: [
    { q: "L’annulation des données de marché Tradovate donne-t-elle droit à un remboursement pour ce mois ?", a: "Non. Les abonnements de données sont facturés mensuellement et ne sont pas calculés au prorata ; l’annulation ne rembourse donc pas le mois en cours. Votre flux reste actif jusqu’au dernier jour du mois, puis expire sans se renouveler." },
    { q: "Quand mes données Tradovate sont-elles réellement coupées après l’annulation ?", a: "À la fin du mois en cours. L’annulation du renouvellement fixe une date d’expiration au dernier jour du mois. Jusque-là, vos cotations continuent de se mettre à jour normalement ; le 1er, le flux ne se renouvelle simplement pas." },
    { q: "Comment annuler les données sur un compte d’évaluation de prop firm ?", a: "Les données CME de Level I incluses dans les comptes d’évaluation et financés sont gérées par la prop firm, et non par vous ; contactez donc votre fournisseur pour ces changements. Tous les forfaits optionnels Level II ou EUREX que vous avez ajoutés peuvent être annulés par vos soins depuis la page Subscriptions." },
  ], it: [
    { q: "Annullare i dati di mercato Tradovate dà diritto a un rimborso per questo mese?", a: "No. Gli abbonamenti ai dati vengono fatturati mensilmente e non sono calcolati pro rata, quindi l’annullamento non rimborsa il mese in corso. Il Suo feed resta attivo fino all’ultimo giorno del mese, poi scade senza rinnovarsi." },
    { q: "Quando si disattivano effettivamente i miei dati Tradovate dopo l’annullamento?", a: "Alla fine del mese in corso. L’annullamento del rinnovo imposta una data di scadenza all’ultimo giorno del mese. Fino a quella data le Sue quotazioni continuano ad aggiornarsi normalmente; il giorno 1 il feed semplicemente non si rinnova." },
    { q: "Come annullo i dati su un conto di valutazione di una prop firm?", a: "I dati CME Level I inclusi nei conti di valutazione e finanziati sono controllati dalla prop firm, non da Lei, quindi si rivolga al Suo fornitore per queste modifiche. Gli eventuali pacchetti opzionali Level II o EUREX che ha aggiunto possono essere annullati da Lei stesso dalla pagina Subscriptions." },
  ] },
  relatedHeading: { en: "Related Guides", de: "Ähnliche Anleitungen", es: "Guías relacionadas", fr: "Guides associés", it: "Guide correlate" },
  disclosureText: { en: `This guide is for educational and informational purposes only and is not financial, investment, or trading advice. Trading futures and other leveraged products carries a substantial risk of loss and is not suitable for every investor. PickMyTrade is an independent third-party automation platform and is not affiliated with, endorsed by, or sponsored by Tradovate, Inc. "Tradovate" and all related names, logos, and trademarks are the property of their respective owners. Platform features and steps change over time, so always confirm the current process in the official Tradovate platform and documentation before acting.`, de: "Dieser Leitfaden dient ausschließlich Bildungs- und Informationszwecken und stellt keine Finanz-, Anlage- oder Handelsberatung dar. Der Handel mit Futures und anderen gehebelten Produkten birgt ein erhebliches Verlustrisiko und ist nicht für jeden Anleger geeignet. PickMyTrade ist eine unabhängige Automatisierungsplattform eines Drittanbieters und steht in keiner Verbindung zu Tradovate, Inc., wird nicht von Tradovate, Inc. unterstützt oder gesponsert. „Tradovate“ und alle zugehörigen Namen, Logos und Marken sind Eigentum ihrer jeweiligen Inhaber. Funktionen und Schritte der Plattform ändern sich im Laufe der Zeit. Prüfen Sie daher stets den aktuellen Ablauf in der offiziellen Tradovate-Plattform und -Dokumentation, bevor Sie handeln.", es: "Esta guía tiene fines exclusivamente educativos e informativos y no constituye asesoramiento financiero, de inversión ni de trading. Operar con futuros y otros productos apalancados conlleva un riesgo sustancial de pérdida y no es adecuado para todos los inversores. PickMyTrade es una plataforma de automatización independiente de terceros y no está afiliada, respaldada ni patrocinada por Tradovate, Inc. «Tradovate» y todos los nombres, logotipos y marcas relacionados son propiedad de sus respectivos titulares. Las funciones y los pasos de la plataforma cambian con el tiempo, por lo que debe confirmar siempre el proceso actual en la plataforma y la documentación oficiales de Tradovate antes de actuar.", fr: "Ce guide est fourni à des fins strictement éducatives et informatives et ne constitue pas un conseil financier, d’investissement ou de trading. Le trading de contrats à terme et d’autres produits à effet de levier comporte un risque de perte important et ne convient pas à tous les investisseurs. PickMyTrade est une plateforme d’automatisation tierce indépendante, qui n’est ni affiliée à Tradovate, Inc., ni approuvée ou parrainée par celle-ci. « Tradovate » ainsi que tous les noms, logos et marques associés sont la propriété de leurs détenteurs respectifs. Les fonctionnalités et les étapes de la plateforme évoluent avec le temps ; vérifiez donc toujours la procédure actuelle sur la plateforme et dans la documentation officielles de Tradovate avant d’agir.", it: "Questa guida ha esclusivamente scopo educativo e informativo e non costituisce consulenza finanziaria, di investimento o di trading. Il trading di futures e di altri prodotti a leva comporta un rischio di perdita sostanziale e non è adatto a tutti gli investitori. PickMyTrade è una piattaforma di automazione indipendente di terze parti e non è affiliata, approvata né sponsorizzata da Tradovate, Inc. «Tradovate» e tutti i nomi, loghi e marchi correlati sono di proprietà dei rispettivi titolari. Le funzionalità e i passaggi della piattaforma cambiano nel tempo, quindi verifichi sempre la procedura attuale nella piattaforma e nella documentazione ufficiali di Tradovate prima di agire." },
};
const data: GuideArticleData = resolveGuideContent(content, locale, related);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: data.faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}${withSlash(localizedPath(locale))}` },
    { "@type": "ListItem", position: 2, name: "How-To", item: `${SITE_URL}${withSlash(localizedPath(locale, "how-to"))}` },
    { "@type": "ListItem", position: 3, name: content.h1[locale], item: `${SITE_URL}${withSlash(localizedPath(locale, `how-to/${SLUG}`))}` },
  ],
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: content.h1[locale],
  description: content.dek[locale],
  image: `${SITE_URL}/assets/og-default.webp`,
  publisher: { "@type": "Organization", name: "PickMyTrade", logo: { "@type": "ImageObject", url: `${SITE_URL}/assets/logo.png` } },
  datePublished: "2026-07-08",
  dateModified: "2026-07-08",
  mainEntityOfPage: { "@type": "WebPage", "@id": `${SITE_URL}${withSlash(localizedPath(locale, `how-to/${SLUG}`))}` },
};
---

<BaseLayout
  locale={locale}
