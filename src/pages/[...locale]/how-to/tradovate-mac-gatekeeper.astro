---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-mac-gatekeeper";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Open Tradovate on Mac When Gatekeeper Blocks It";
const META_DESCRIPTION =
  "Mac blocking the Tradovate desktop app? Right-click Open or use Privacy and Security to get past Gatekeeper and launch it in about a minute.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate auf dem Mac öffnen, wenn Gatekeeper es blockiert", es: "Cómo abrir Tradovate en Mac cuando Gatekeeper lo bloquea", fr: "Ouvrir Tradovate sur Mac lorsque Gatekeeper le bloque", it: "Aprire Tradovate su Mac quando Gatekeeper lo blocca" },
  dek: { en: "Your Mac says it \"could not verify this app is free of malware\" or that it's \"from an unidentified developer.\" Nothing is broken and you didn't grab a bad file. Here's how to get past Gatekeeper in about a minute.", de: "Ihr Mac meldet, er „konnte nicht überprüfen, ob die App frei von Schadsoftware ist“, oder dass sie „von einem nicht verifizierten Entwickler“ stammt. Nichts ist defekt, und Sie haben keine schlechte Datei geladen. So kommen Sie in etwa einer Minute an Gatekeeper vorbei.", es: "Su Mac dice que «no pudo verificar que la app esté libre de malware» o que es «de un desarrollador no identificado». Nada está roto y no descargó un archivo defectuoso. Así se supera Gatekeeper en aproximadamente un minuto.", fr: "Votre Mac indique qu’il « n’a pas pu vérifier que l’app est exempte de logiciels malveillants » ou qu’elle provient d’un « développeur non identifié ». Rien n’est cassé et vous n’avez pas téléchargé un mauvais fichier. Voici comment contourner Gatekeeper en une minute environ.", it: "Il Suo Mac segnala che «non è stato possibile verificare che l’app sia priva di malware» oppure che proviene da uno «sviluppatore non identificato». Nulla è rotto e non ha scaricato un file difettoso. Ecco come superare Gatekeeper in circa un minuto." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You downloaded the Tradovate desktop app, double-clicked it, and your Mac slammed the door: \"Apple could not verify this app is free of malware,\" or \"cannot be opened because it is from an unidentified developer.\" Nothing is broken and you didn't grab a bad file. That's Gatekeeper, the security check baked into macOS, and you can wave the app through in about a minute." },
    { type: "paragraph", html: "The quick version: on current macOS you approve the app once under <strong class='text-white'>System Settings &rsaquo; Privacy &amp; Security</strong>, and on older versions you Control-click the app and pick <strong class='text-white'>Open</strong>. Here's the exact path for both." },
    { type: "heading", text: "Why macOS Blocks It" },
    { type: "paragraph", html: "Every app you download outside the App Store gets checked for two things: a valid Developer ID signature and Apple's notarization stamp. When Gatekeeper can't confirm both, it stops the app on the first launch instead of opening it. The block is a caution, not proof that anything is wrong. Approve an app only when you trust where it came from, so pull the installer straight from Tradovate's official download page before you do any of this." },
    { type: "heading", text: "Steps to Get Past Gatekeeper (Current macOS)" },
    { type: "paragraph", html: "This is the path on macOS Sequoia (15) and macOS Tahoe (26), where the old right-click shortcut no longer works for unverified apps." },
    {
      type: "steps",
      items: [
        { title: "Download the Mac App from the Official Page", html: "Go to Tradovate's download page and choose <strong class='text-white'>Download Mac</strong>. Open the disk image and drag the Tradovate app into your Applications folder like any other Mac install." },
        { title: "Double-Click and Dismiss the First Warning", html: "Open the app once from Applications. macOS shows a warning that it can't verify the app. Click <strong class='text-white'>Done</strong> (or <strong class='text-white'>Cancel</strong>) to close it. This first attempt is what tells macOS to offer you an override in the next step, so don't skip it." },
        { title: "Open System Settings and Go to Privacy & Security", html: "Click the Apple menu in the top-left corner, choose <strong class='text-white'>System Settings</strong>, then <strong class='text-white'>Privacy &amp; Security</strong> in the sidebar. Scroll down to the <strong class='text-white'>Security</strong> section. You'll see a line that the Tradovate app \"was blocked to protect your Mac,\" with an <strong class='text-white'>Open Anyway</strong> button beside it." },
        { title: "Click Open Anyway and Confirm", html: "Click <strong class='text-white'>Open Anyway</strong>, then <strong class='text-white'>Open</strong> in the pop-up, and enter your Mac login password. macOS saves the app as an exception, so from now on it launches with a normal double-click. That override button only sticks around for about an hour after your first launch attempt, so if it's gone, just double-click the app again to bring it back." },
      ],
    },
    { type: "heading", text: "On Older macOS: Right-Click to Open" },
    { type: "paragraph", html: "If you're on macOS Sonoma, Ventura, or earlier, there's a faster route. In your Applications folder, Control-click (or right-click) the Tradovate app icon and choose <strong class='text-white'>Open</strong>. You get the same warning, but this time with an <strong class='text-white'>Open</strong> button that launches it and remembers your choice. Apple removed this shortcut for unverified apps starting in Sequoia, which is why newer Macs need the Privacy &amp; Security route above." },
    { type: "heading", text: "If \"Open Anyway\" Doesn't Show Up" },
    { type: "paragraph", html: "A few things to check when the button isn't there:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Launch it once first.</strong> The override only appears after you've tried to open the app and hit the warning. No attempt, no button.",
        "<strong class='text-white'>You're past the one-hour window.</strong> Double-click the app again, then head straight back to Privacy &amp; Security.",
        "<strong class='text-white'>You need admin rights.</strong> Approving an app takes an administrator password. A standard user account can't clear the block on its own.",
        "<strong class='text-white'>Skip the Mac install entirely.</strong> The Streaming Web version runs in any modern browser at trader.tradovate.com with nothing to download, which sidesteps Gatekeeper completely if you just need to trade now.",
      ],
    },
    { type: "paragraph", html: "One habit worth keeping: only push an app through Gatekeeper when you downloaded it yourself from the official source. Overriding the check on a random file is the most common way a Mac picks up malware, so treat that \"Open Anyway\" click as a deliberate decision, not a reflex." },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Want to skip the desktop app hassle and automate your Tradovate orders straight from TradingView alerts? <strong class='text-white'>PickMyTrade connects your strategy to Tradovate</strong> in minutes, no coding required." },
  ], de: [
    { type: "paragraph",html: "Sie haben die Tradovate-Desktop-App heruntergeladen, doppelt angeklickt, und Ihr Mac hat die Tür zugeschlagen: „Apple konnte nicht überprüfen, ob die App frei von Schadsoftware ist“ oder „kann nicht geöffnet werden, da sie von einem nicht verifizierten Entwickler stammt“. Nichts ist defekt, und Sie haben keine schlechte Datei geladen. Das ist Gatekeeper, die in macOS integrierte Sicherheitsprüfung, und Sie können die App in etwa einer Minute durchwinken." },
    { type: "paragraph",html: "Die Kurzfassung: Unter aktuellem macOS geben Sie die App einmalig unter <strong class='text-white'>System Settings &rsaquo; Privacy &amp; Security</strong> frei, und unter älteren Versionen klicken Sie bei gedrückter Control-Taste auf die App und wählen <strong class='text-white'>Open</strong>. Hier ist der genaue Weg für beide." },
    { type: "heading",text: "Warum macOS die App blockiert" },
    { type: "paragraph",html: "Jede App, die Sie außerhalb des App Store herunterladen, wird auf zwei Dinge geprüft: eine gültige Developer-ID-Signatur und den Notarisierungsstempel von Apple. Kann Gatekeeper nicht beides bestätigen, stoppt er die App beim ersten Start, statt sie zu öffnen. Die Sperre ist eine Warnung, kein Beweis dafür, dass etwas nicht stimmt. Geben Sie eine App nur frei, wenn Sie ihrer Herkunft vertrauen, und laden Sie daher den Installer direkt von der offiziellen Download-Seite von Tradovate, bevor Sie irgendetwas hiervon tun." },
    { type: "heading",text: "Schritte, um Gatekeeper zu umgehen (aktuelles macOS)" },
    { type: "paragraph",html: "Das ist der Weg unter macOS Sequoia (15) und macOS Tahoe (26), wo die alte Rechtsklick-Abkürzung für nicht verifizierte Apps nicht mehr funktioniert." },
    {
      type: "steps",
      items: [
        { title: "Die Mac-App von der offiziellen Seite herunterladen", html: "Rufen Sie die Download-Seite von Tradovate auf und wählen Sie <strong class='text-white'>Download Mac</strong>. Öffnen Sie das Disk-Image und ziehen Sie die Tradovate-App wie bei jeder anderen Mac-Installation in Ihren Programme-Ordner." },
        { title: "Doppelklicken und die erste Warnung schließen", html: "Öffnen Sie die App einmal aus dem Programme-Ordner. macOS zeigt eine Warnung, dass die App nicht überprüft werden kann. Klicken Sie auf <strong class='text-white'>Done</strong> (oder <strong class='text-white'>Cancel</strong>), um sie zu schließen. Erst dieser erste Versuch veranlasst macOS, Ihnen im nächsten Schritt eine Freigabe anzubieten, überspringen Sie ihn also nicht." },
        { title: "System Settings öffnen und zu Privacy & Security gehen", html: "Klicken Sie oben links auf das Apple-Menü, wählen Sie <strong class='text-white'>System Settings</strong> und dann in der Seitenleiste <strong class='text-white'>Privacy &amp; Security</strong>. Scrollen Sie nach unten zum Abschnitt <strong class='text-white'>Security</strong>. Dort sehen Sie eine Zeile, dass die Tradovate-App „zum Schutz Ihres Mac blockiert wurde“, mit einer Schaltfläche <strong class='text-white'>Open Anyway</strong> daneben." },
        { title: "Auf „Open Anyway“ klicken und bestätigen", html: "Klicken Sie auf <strong class='text-white'>Open Anyway</strong>, dann im Pop-up auf <strong class='text-white'>Open</strong> und geben Sie Ihr Mac-Anmeldepasswort ein. macOS speichert die App als Ausnahme, sodass sie künftig mit einem normalen Doppelklick startet. Diese Freigabe-Schaltfläche bleibt nur etwa eine Stunde nach Ihrem ersten Startversuch verfügbar. Ist sie weg, doppelklicken Sie die App einfach erneut, um sie zurückzuholen." },
      ],
    },
    { type: "heading",text: "Unter älterem macOS: Rechtsklick zum Öffnen" },
    { type: "paragraph",html: "Wenn Sie macOS Sonoma, Ventura oder früher nutzen, gibt es einen schnelleren Weg. Klicken Sie im Programme-Ordner bei gedrückter Control-Taste (oder per Rechtsklick) auf das Tradovate-App-Symbol und wählen Sie <strong class='text-white'>Open</strong>. Sie erhalten dieselbe Warnung, diesmal jedoch mit einer Schaltfläche <strong class='text-white'>Open</strong>, die die App startet und Ihre Entscheidung speichert. Apple hat diese Abkürzung für nicht verifizierte Apps ab Sequoia entfernt, weshalb neuere Macs den oben beschriebenen Weg über Privacy &amp; Security benötigen." },
    { type: "heading",text: "Wenn „Open Anyway“ nicht erscheint" },
    { type: "paragraph",html: "Einige Dinge, die Sie prüfen können, wenn die Schaltfläche fehlt:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Starten Sie die App zuerst einmal.</strong> Die Freigabe erscheint erst, nachdem Sie versucht haben, die App zu öffnen, und die Warnung gesehen haben. Kein Versuch, keine Schaltfläche.",
        "<strong class='text-white'>Sie sind über das Zeitfenster von einer Stunde hinaus.</strong> Doppelklicken Sie die App erneut und gehen Sie dann direkt zurück zu Privacy &amp; Security.",
        "<strong class='text-white'>Sie benötigen Administratorrechte.</strong> Zum Freigeben einer App ist ein Administratorpasswort erforderlich. Ein Standardbenutzerkonto kann die Sperre nicht selbst aufheben.",
        "<strong class='text-white'>Verzichten Sie ganz auf die Mac-Installation.</strong> Die Streaming-Web-Version läuft in jedem modernen Browser unter trader.tradovate.com ohne Download und umgeht Gatekeeper vollständig, wenn Sie einfach sofort handeln möchten.",
      ],
    },
    { type: "paragraph",html: "Eine Gewohnheit lohnt sich: Schieben Sie eine App nur dann an Gatekeeper vorbei, wenn Sie sie selbst aus der offiziellen Quelle heruntergeladen haben. Die Prüfung bei einer beliebigen Datei zu umgehen, ist der häufigste Weg, wie sich ein Mac Schadsoftware einfängt. Behandeln Sie diesen Klick auf „Open Anyway“ also als bewusste Entscheidung, nicht als Reflex." },
    { type: "heading",text: "Automatisieren Sie das mit PickMyTrade" },
    { type: "paragraph",html: "Möchten Sie sich den Ärger mit der Desktop-App sparen und Ihre Tradovate-Orders direkt aus TradingView-Alarmen automatisieren? <strong class='text-white'>PickMyTrade verbindet Ihre Strategie in wenigen Minuten mit Tradovate</strong>, ganz ohne Programmierung." },
  ], es: [
    { type: "paragraph",html: "Descargó la app de escritorio de Tradovate, hizo doble clic y su Mac le cerró la puerta: «Apple no pudo verificar que esta app esté libre de malware» o «no se puede abrir porque proviene de un desarrollador no identificado». Nada está roto y no descargó un archivo defectuoso. Eso es Gatekeeper, la comprobación de seguridad integrada en macOS, y puede dejar pasar la app en aproximadamente un minuto." },
    { type: "paragraph",html: "La versión rápida: en el macOS actual, aprueba la app una sola vez en <strong class='text-white'>System Settings &rsaquo; Privacy &amp; Security</strong>, y en versiones anteriores hace Control-clic en la app y elige <strong class='text-white'>Open</strong>. Aquí está la ruta exacta para ambos casos." },
    { type: "heading",text: "Por qué macOS la bloquea" },
    { type: "paragraph",html: "Toda app que descarga fuera de la App Store se comprueba en dos aspectos: una firma válida de Developer ID y el sello de notarización de Apple. Cuando Gatekeeper no puede confirmar ambos, detiene la app en el primer inicio en lugar de abrirla. El bloqueo es una precaución, no una prueba de que algo ande mal. Apruebe una app solo cuando confíe en su procedencia, así que obtenga el instalador directamente de la página oficial de descargas de Tradovate antes de hacer nada de esto." },
    { type: "heading",text: "Pasos para superar Gatekeeper (macOS actual)" },
    { type: "paragraph",html: "Esta es la ruta en macOS Sequoia (15) y macOS Tahoe (26), donde el antiguo atajo del clic derecho ya no funciona para apps sin verificar." },
    {
      type: "steps",
      items: [
        { title: "Descargue la app de Mac desde la página oficial", html: "Vaya a la página de descargas de Tradovate y elija <strong class='text-white'>Download Mac</strong>. Abra la imagen de disco y arrastre la app de Tradovate a su carpeta Aplicaciones como en cualquier otra instalación de Mac." },
        { title: "Haga doble clic y cierre la primera advertencia", html: "Abra la app una vez desde Aplicaciones. macOS muestra una advertencia de que no puede verificar la app. Haga clic en <strong class='text-white'>Done</strong> (o <strong class='text-white'>Cancel</strong>) para cerrarla. Este primer intento es lo que hace que macOS le ofrezca una excepción en el siguiente paso, así que no se lo salte." },
        { title: "Abra System Settings y vaya a Privacy & Security", html: "Haga clic en el menú Apple en la esquina superior izquierda, elija <strong class='text-white'>System Settings</strong> y luego <strong class='text-white'>Privacy &amp; Security</strong> en la barra lateral. Desplácese hasta la sección <strong class='text-white'>Security</strong>. Verá una línea que indica que la app de Tradovate «fue bloqueada para proteger su Mac», con un botón <strong class='text-white'>Open Anyway</strong> junto a ella." },
        { title: "Haga clic en Open Anyway y confirme", html: "Haga clic en <strong class='text-white'>Open Anyway</strong>, luego en <strong class='text-white'>Open</strong> en la ventana emergente e introduzca la contraseña de su Mac. macOS guarda la app como excepción, de modo que a partir de ahora se inicia con un doble clic normal. Ese botón solo permanece disponible durante aproximadamente una hora tras su primer intento de abrir la app; si ya no está, simplemente haga doble clic de nuevo en la app para recuperarlo." },
      ],
    },
    { type: "heading",text: "En macOS anteriores: clic derecho para abrir" },
    { type: "paragraph",html: "Si usa macOS Sonoma, Ventura o anterior, hay una ruta más rápida. En su carpeta Aplicaciones, haga Control-clic (o clic derecho) en el icono de la app de Tradovate y elija <strong class='text-white'>Open</strong>. Aparece la misma advertencia, pero esta vez con un botón <strong class='text-white'>Open</strong> que la inicia y recuerda su elección. Apple eliminó este atajo para apps sin verificar a partir de Sequoia, por lo que los Mac más nuevos necesitan la ruta de Privacy &amp; Security descrita arriba." },
    { type: "heading",text: "Si «Open Anyway» no aparece" },
    { type: "paragraph",html: "Algunas cosas que revisar cuando el botón no está:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Inicie la app una vez primero.</strong> La opción solo aparece después de intentar abrir la app y ver la advertencia. Sin intento, no hay botón.",
        "<strong class='text-white'>Ha pasado la ventana de una hora.</strong> Haga doble clic de nuevo en la app y vuelva directamente a Privacy &amp; Security.",
        "<strong class='text-white'>Necesita derechos de administrador.</strong> Aprobar una app requiere la contraseña de un administrador. Una cuenta de usuario estándar no puede levantar el bloqueo por sí sola.",
        "<strong class='text-white'>Omita por completo la instalación en Mac.</strong> La versión Streaming Web funciona en cualquier navegador moderno en trader.tradovate.com sin nada que descargar, lo que esquiva Gatekeeper por completo si solo necesita operar ahora.",
      ],
    },
    { type: "paragraph",html: "Un hábito que conviene mantener: solo deje pasar una app por Gatekeeper cuando la haya descargado usted mismo de la fuente oficial. Saltarse la comprobación con un archivo cualquiera es la forma más común de que un Mac contraiga malware, así que trate ese clic en «Open Anyway» como una decisión deliberada, no como un reflejo." },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "¿Quiere olvidarse de los problemas de la app de escritorio y automatizar sus órdenes de Tradovate directamente desde alertas de TradingView? <strong class='text-white'>PickMyTrade conecta su estrategia con Tradovate</strong> en minutos, sin necesidad de programar." },
  ], fr: [
    { type: "paragraph",html: "Vous avez téléchargé l’application de bureau Tradovate, double-cliqué dessus, et votre Mac vous a claqué la porte au nez : « Apple n’a pas pu vérifier que cette app est exempte de logiciels malveillants » ou « ne peut pas être ouverte car elle provient d’un développeur non identifié ». Rien n’est cassé et vous n’avez pas téléchargé un mauvais fichier. C’est Gatekeeper, le contrôle de sécurité intégré à macOS, et vous pouvez laisser passer l’app en une minute environ." },
    { type: "paragraph",html: "En bref : sur le macOS actuel, vous approuvez l’app une seule fois dans <strong class='text-white'>System Settings &rsaquo; Privacy &amp; Security</strong>, et sur les versions plus anciennes vous faites un Control-clic sur l’app et choisissez <strong class='text-white'>Open</strong>. Voici le chemin exact pour les deux cas." },
    { type: "heading",text: "Pourquoi macOS la bloque" },
    { type: "paragraph",html: "Chaque app téléchargée en dehors de l’App Store est contrôlée sur deux points : une signature Developer ID valide et le cachet de notarisation d’Apple. Lorsque Gatekeeper ne peut pas confirmer les deux, il bloque l’app au premier lancement au lieu de l’ouvrir. Ce blocage est une précaution, pas la preuve que quelque chose ne va pas. N’approuvez une app que si vous faites confiance à sa provenance ; récupérez donc l’installateur directement sur la page de téléchargement officielle de Tradovate avant de faire quoi que ce soit d’autre." },
    { type: "heading",text: "Étapes pour contourner Gatekeeper (macOS actuel)" },
    { type: "paragraph",html: "C’est le chemin sur macOS Sequoia (15) et macOS Tahoe (26), où l’ancien raccourci par clic droit ne fonctionne plus pour les apps non vérifiées." },
    {
      type: "steps",
      items: [
        { title: "Télécharger l’app Mac depuis la page officielle", html: "Rendez-vous sur la page de téléchargement de Tradovate et choisissez <strong class='text-white'>Download Mac</strong>. Ouvrez l’image disque et faites glisser l’app Tradovate dans votre dossier Applications comme pour n’importe quelle installation sur Mac." },
        { title: "Double-cliquer et fermer le premier avertissement", html: "Ouvrez l’app une fois depuis Applications. macOS affiche un avertissement indiquant qu’il ne peut pas vérifier l’app. Cliquez sur <strong class='text-white'>Done</strong> (ou <strong class='text-white'>Cancel</strong>) pour le fermer. C’est cette première tentative qui amène macOS à vous proposer une dérogation à l’étape suivante, ne la sautez donc pas." },
        { title: "Ouvrir System Settings et aller dans Privacy & Security", html: "Cliquez sur le menu Apple en haut à gauche, choisissez <strong class='text-white'>System Settings</strong>, puis <strong class='text-white'>Privacy &amp; Security</strong> dans la barre latérale. Faites défiler jusqu’à la section <strong class='text-white'>Security</strong>. Vous verrez une ligne indiquant que l’app Tradovate « a été bloquée pour protéger votre Mac », avec un bouton <strong class='text-white'>Open Anyway</strong> à côté." },
        { title: "Cliquer sur Open Anyway et confirmer", html: "Cliquez sur <strong class='text-white'>Open Anyway</strong>, puis sur <strong class='text-white'>Open</strong> dans la fenêtre contextuelle, et saisissez le mot de passe de votre Mac. macOS enregistre l’app comme exception, elle se lancera donc désormais par un simple double-clic. Ce bouton de dérogation n’est disponible qu’environ une heure après votre première tentative de lancement ; s’il a disparu, double-cliquez de nouveau sur l’app pour le faire réapparaître." },
      ],
    },
    { type: "heading",text: "Sur un macOS plus ancien : clic droit pour ouvrir" },
    { type: "paragraph",html: "Si vous êtes sur macOS Sonoma, Ventura ou antérieur, il existe une voie plus rapide. Dans votre dossier Applications, faites un Control-clic (ou clic droit) sur l’icône de l’app Tradovate et choisissez <strong class='text-white'>Open</strong>. Vous obtenez le même avertissement, mais cette fois avec un bouton <strong class='text-white'>Open</strong> qui la lance et mémorise votre choix. Apple a supprimé ce raccourci pour les apps non vérifiées à partir de Sequoia, c’est pourquoi les Mac plus récents nécessitent le chemin Privacy &amp; Security décrit plus haut." },
    { type: "heading",text: "Si « Open Anyway » n’apparaît pas" },
    { type: "paragraph",html: "Quelques points à vérifier lorsque le bouton est absent :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Lancez d’abord l’app une fois.</strong> La dérogation n’apparaît qu’après avoir tenté d’ouvrir l’app et vu l’avertissement. Pas de tentative, pas de bouton.",
        "<strong class='text-white'>Vous avez dépassé la fenêtre d’une heure.</strong> Double-cliquez de nouveau sur l’app, puis retournez directement dans Privacy &amp; Security.",
        "<strong class='text-white'>Vous avez besoin des droits d’administrateur.</strong> L’approbation d’une app exige un mot de passe d’administrateur. Un compte utilisateur standard ne peut pas lever le blocage seul.",
        "<strong class='text-white'>Évitez complètement l’installation sur Mac.</strong> La version Streaming Web fonctionne dans n’importe quel navigateur moderne à l’adresse trader.tradovate.com sans rien à télécharger, ce qui contourne totalement Gatekeeper si vous avez simplement besoin de trader maintenant.",
      ],
    },
    { type: "paragraph",html: "Une habitude à garder : ne forcez le passage d’une app dans Gatekeeper que si vous l’avez vous-même téléchargée depuis la source officielle. Contourner le contrôle sur un fichier quelconque est la façon la plus courante pour un Mac d’attraper un logiciel malveillant ; considérez donc ce clic sur « Open Anyway » comme une décision délibérée, pas comme un réflexe." },
    { type: "heading",text: "Automatisez tout cela avec PickMyTrade" },
    { type: "paragraph",html: "Vous voulez vous épargner les tracas de l’application de bureau et automatiser vos ordres Tradovate directement à partir des alertes TradingView ? <strong class='text-white'>PickMyTrade connecte votre stratégie à Tradovate</strong> en quelques minutes, sans aucun codage." },
  ], it: [
