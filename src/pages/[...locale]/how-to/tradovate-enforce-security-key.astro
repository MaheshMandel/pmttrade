---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-enforce-security-key";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Require a Security Key on Every Tradovate Login";
const META_DESCRIPTION =
  "Force a security key at every login to lock down your futures account. Step-by-step 2FA and hardware-key setup so a lost device never locks you out.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Bei jeder Tradovate-Anmeldung einen Sicherheitsschlüssel verlangen", es: "Exigir una llave de seguridad en cada inicio de sesión de Tradovate", fr: "Exiger une clé de sécurité à chaque connexion à Tradovate", it: "Richiedere una chiave di sicurezza a ogni accesso a Tradovate" },
  dek: { en: "Want Tradovate to demand a security key on every login, not just from a new device? Here's how to turn on that stricter setting, register a key, and make sure a lost device never locks you out.", de: "Sie möchten, dass Tradovate bei jeder Anmeldung einen Sicherheitsschlüssel verlangt, nicht nur von einem neuen Gerät? So aktivieren Sie diese strengere Einstellung, registrieren einen Schlüssel und stellen sicher, dass ein verlorenes Gerät Sie nie aussperrt.", es: "¿Quiere que Tradovate exija una llave de seguridad en cada inicio de sesión, y no solo desde un dispositivo nuevo? Así se activa este ajuste más estricto, se registra una llave y se evita que la pérdida de un dispositivo le deje fuera.", fr: "Vous voulez que Tradovate exige une clé de sécurité à chaque connexion, et pas seulement depuis un nouvel appareil ? Voici comment activer ce paramètre plus strict, enregistrer une clé et vous assurer qu'un appareil perdu ne vous bloque jamais.", it: "Desidera che Tradovate richieda una chiave di sicurezza a ogni accesso, non solo da un nuovo dispositivo? Ecco come attivare questa impostazione più rigorosa, registrare una chiave ed evitare che un dispositivo smarrito la lasci fuori." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "If someone gets hold of your Tradovate password, the only thing standing between them and your open positions is your second factor. Out of the box, Tradovate only asks for that second factor when it spots a new device. That's convenient, but it also leaves a gap: a saved session on a shared, borrowed, or stolen machine can walk right through the front door. Tradovate closes that gap with a setting that demands a registered security key on <em>every</em> login, not just the first one from a new device. Here's how to switch it on." },
    { type: "heading", text: "What You'll Need First" },
    {
      type: "list",
      items: [
        "A Tradovate account with two-factor authentication available. Some of the stronger security methods are tied to funded or live-account access, and prop-firm evaluation accounts can be managed differently, so check your firm's current rules if you're on one.",
        "A security key. That can be a hardware key over USB, NFC, or Bluetooth, Windows Hello on your PC, a passkey stored in your password manager, or an authenticator app on your phone.",
        "Ideally two keys or devices. Register a backup so a lost or dead key doesn't lock you out of your own account.",
      ],
    },
    { type: "paragraph", html: "New to signing in at all? Start with how Tradovate login works on web and mobile, then come back here to harden it." },
    { type: "heading", text: "Turn On the Security Key Requirement" },
    {
      type: "steps",
      items: [
        { title: "Open Security Settings and Switch on 2FA", html: "Open Application Settings and head to the <strong class='text-white'>Security</strong> page. Two-factor authentication is the foundation for everything else here, so if the 2FA toggle isn't already on, flip it on first. The security-key options live directly underneath it." },
        { title: "Register Your Security Key", html: "Scroll below the 2FA toggle to the security-key section and start the registration. From here your browser or operating system takes over: tap your hardware key, approve the Windows Hello prompt, or choose the passkey saved in your password manager. Give the key a name you'll actually recognize later, like \"YubiKey - desktop\" or \"Phone passkey.\"" },
        { title: "Require the Key on Every Login", html: "Now find the option that enforces the security key on <em>all</em> logins rather than only new devices, and turn it on. The exact label shifts a little between releases, so read what's on your own screen before you commit. Once it's active, Tradovate prompts for that key every time you sign in, whether that's web, desktop, or mobile. A leaked password on its own gets nobody anywhere." },
        { title: "Add a Backup, Then Test It", html: "Before you log out, register a second key or device. Then sign out completely and log back in to confirm the prompt shows up and your key actually works. This test matters: if you enforce a key on every login, register only one, and then lose it, your only way back in is a support ticket. Don't learn that the hard way at 9:29 a.m. before the open." },
      ],
    },
    { type: "heading", text: "What Changes After You Turn It On" },
    { type: "paragraph", html: "Every sign-in now triggers the key prompt, full stop. If you log in from a brand-new device, Tradovate can still send its approve-or-deny email on top of the key, so you're layered rather than swapping one check for another." },
    { type: "quote", html: "Keep in mind this hardens the interactive platform login. Automated trading through the Tradovate API uses its own access-token flow and isn't the same as the browser sign-in, so enforcing a login key won't quietly break a running bot." },
    { type: "heading", text: "If Something Goes Wrong" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Key not recognized:</strong> make sure the hardware key is seated in the port, Bluetooth is on for a wireless key, and you're using a browser that supports modern passkeys.",
        "<strong class='text-white'>Lost your only key:</strong> that's what the backup in Step 4 prevents. Without one, contact Tradovate support to recover access.",
        "<strong class='text-white'>Getting kicked between sessions:</strong> that's usually a separate device-limit issue, not the key.",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Want your strategy to keep firing while your account stays locked down tight? <strong class='text-white'>PickMyTrade routes your TradingView alerts straight into your Tradovate account</strong>, so signals fire without you leaving a browser session open all day." },
  ], de: [
    { type: "paragraph",html: "Wenn jemand Ihr Tradovate-Passwort in die Hände bekommt, steht zwischen ihm und Ihren offenen Positionen nur noch Ihr zweiter Faktor. Ab Werk fragt Tradovate diesen zweiten Faktor nur ab, wenn es ein neues Gerät erkennt. Das ist bequem, lässt aber eine Lücke: Eine gespeicherte Sitzung auf einem gemeinsam genutzten, geliehenen oder gestohlenen Rechner kann einfach durch die Vordertür hereinspazieren. Tradovate schließt diese Lücke mit einer Einstellung, die bei <em>jeder</em> Anmeldung einen registrierten Sicherheitsschlüssel verlangt, nicht nur beim ersten Mal von einem neuen Gerät. So aktivieren Sie sie." },
    { type: "heading",text: "Was Sie zuerst benötigen" },
    {
      type: "list",
      items: [
        "Ein Tradovate-Konto mit verfügbarer Zwei-Faktor-Authentifizierung. Einige der stärkeren Sicherheitsmethoden sind an den Zugang für finanzierte oder Live-Konten gebunden, und Prop-Firm-Evaluationskonten werden möglicherweise anders verwaltet. Prüfen Sie daher die aktuellen Regeln Ihrer Firma, falls Sie eines nutzen.",
        "Ein Sicherheitsschlüssel. Das kann ein Hardware-Schlüssel per USB, NFC oder Bluetooth sein, Windows Hello auf Ihrem PC, ein in Ihrem Passwortmanager gespeicherter Passkey oder eine Authenticator-App auf Ihrem Smartphone.",
        "Idealerweise zwei Schlüssel oder Geräte. Registrieren Sie einen Ersatz, damit ein verlorener oder defekter Schlüssel Sie nicht aus Ihrem eigenen Konto aussperrt.",
      ],
    },
    { type: "paragraph",html: "Sie melden sich zum ersten Mal an? Beginnen Sie mit der Funktionsweise der Tradovate-Anmeldung im Web und auf dem Smartphone und kehren Sie dann hierher zurück, um sie abzusichern." },
    { type: "heading",text: "Die Sicherheitsschlüssel-Pflicht aktivieren" },
    {
      type: "steps",
      items: [
        { title: "Sicherheitseinstellungen öffnen und 2FA einschalten", html: "Öffnen Sie die Application Settings und rufen Sie die Seite <strong class='text-white'>Security</strong> auf. Die Zwei-Faktor-Authentifizierung ist die Grundlage für alles Weitere. Wenn der 2FA-Schalter also noch nicht aktiv ist, schalten Sie ihn zuerst ein. Die Optionen für Sicherheitsschlüssel befinden sich direkt darunter." },
        { title: "Sicherheitsschlüssel registrieren", html: "Scrollen Sie unter den 2FA-Schalter zum Bereich für Sicherheitsschlüssel und starten Sie die Registrierung. Ab hier übernimmt Ihr Browser oder Betriebssystem: Tippen Sie auf Ihren Hardware-Schlüssel, bestätigen Sie die Windows-Hello-Abfrage oder wählen Sie den in Ihrem Passwortmanager gespeicherten Passkey. Geben Sie dem Schlüssel einen Namen, den Sie später wiedererkennen, etwa „YubiKey - Desktop“ oder „Smartphone-Passkey“." },
        { title: "Den Schlüssel bei jeder Anmeldung verlangen", html: "Suchen Sie nun die Option, die den Sicherheitsschlüssel bei <em>allen</em> Anmeldungen erzwingt und nicht nur bei neuen Geräten, und schalten Sie sie ein. Die genaue Bezeichnung ändert sich zwischen Versionen leicht. Lesen Sie daher, was auf Ihrem eigenen Bildschirm steht, bevor Sie bestätigen. Sobald die Option aktiv ist, fragt Tradovate bei jeder Anmeldung nach diesem Schlüssel, ob im Web, am Desktop oder mobil. Ein geleaktes Passwort allein bringt niemanden weiter." },
        { title: "Einen Ersatz hinzufügen, dann testen", html: "Registrieren Sie vor dem Abmelden einen zweiten Schlüssel oder ein zweites Gerät. Melden Sie sich anschließend vollständig ab und wieder an, um zu bestätigen, dass die Abfrage erscheint und Ihr Schlüssel funktioniert. Dieser Test ist wichtig: Wenn Sie den Schlüssel bei jeder Anmeldung erzwingen, nur einen registrieren und ihn dann verlieren, bleibt Ihnen nur ein Support-Ticket, um wieder hineinzukommen. Lernen Sie das nicht auf die harte Tour um 9:29 Uhr vor der Eröffnung." },
      ],
    },
    { type: "heading",text: "Was sich nach der Aktivierung ändert" },
    { type: "paragraph",html: "Jede Anmeldung löst jetzt die Schlüsselabfrage aus, ohne Ausnahme. Wenn Sie sich von einem brandneuen Gerät anmelden, kann Tradovate zusätzlich zum Schlüssel weiterhin seine E-Mail zum Bestätigen oder Ablehnen senden. Sie sind also mehrfach abgesichert, statt eine Prüfung gegen eine andere zu tauschen." },
    { type: "quote",html: "Bedenken Sie, dass dies die interaktive Plattform-Anmeldung absichert. Automatisierter Handel über die Tradovate-API nutzt einen eigenen Access-Token-Ablauf und entspricht nicht der Browser-Anmeldung. Das Erzwingen eines Login-Schlüssels bringt daher einen laufenden Bot nicht unbemerkt zum Absturz." },
    { type: "heading",text: "Wenn etwas schiefgeht" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Schlüssel nicht erkannt:</strong> Stellen Sie sicher, dass der Hardware-Schlüssel richtig im Anschluss steckt, Bluetooth für einen kabellosen Schlüssel aktiviert ist und Sie einen Browser verwenden, der moderne Passkeys unterstützt.",
        "<strong class='text-white'>Ihren einzigen Schlüssel verloren:</strong> Genau das verhindert der Ersatz aus Schritt 4. Ohne einen solchen wenden Sie sich an den Tradovate-Support, um den Zugang wiederherzustellen.",
        "<strong class='text-white'>Zwischen Sitzungen abgemeldet:</strong> Das liegt meist an einem separaten Geräte-Limit, nicht am Schlüssel.",
      ],
    },
    { type: "heading",text: "Automatisieren mit PickMyTrade" },
    { type: "paragraph",html: "Soll Ihre Strategie weiter auslösen, während Ihr Konto streng abgesichert bleibt? <strong class='text-white'>PickMyTrade leitet Ihre TradingView-Alerts direkt an Ihr Tradovate-Konto weiter</strong>, sodass Signale auslösen, ohne dass Sie den ganzen Tag eine Browser-Sitzung offen halten müssen." },
  ], es: [
    { type: "paragraph",html: "Si alguien se hace con su contraseña de Tradovate, lo único que lo separa de sus posiciones abiertas es su segundo factor. De fábrica, Tradovate solo solicita ese segundo factor cuando detecta un dispositivo nuevo. Es cómodo, pero deja una brecha: una sesión guardada en un equipo compartido, prestado o robado puede entrar por la puerta principal. Tradovate cierra esa brecha con un ajuste que exige una llave de seguridad registrada en <em>cada</em> inicio de sesión, no solo la primera vez desde un dispositivo nuevo. Así se activa." },
    { type: "heading",text: "Lo que necesita antes de empezar" },
    {
      type: "list",
      items: [
        "Una cuenta de Tradovate con autenticación en dos pasos disponible. Algunos de los métodos de seguridad más sólidos están vinculados al acceso a cuentas financiadas o reales, y las cuentas de evaluación de las prop firms pueden gestionarse de forma distinta, así que consulte las reglas vigentes de su firma si usa una.",
        "Una llave de seguridad. Puede ser una llave de hardware por USB, NFC o Bluetooth, Windows Hello en su PC, una passkey guardada en su gestor de contraseñas o una aplicación de autenticación en su teléfono.",
        "Idealmente, dos llaves o dispositivos. Registre una de respaldo para que una llave perdida o sin batería no le deje fuera de su propia cuenta.",
      ],
    },
    { type: "paragraph",html: "¿Es nuevo en el inicio de sesión? Empiece por cómo funciona el acceso a Tradovate en la web y en el móvil y vuelva aquí para reforzarlo." },
    { type: "heading",text: "Active el requisito de la llave de seguridad" },
    {
      type: "steps",
      items: [
        { title: "Abra los ajustes de seguridad y active la 2FA", html: "Abra Application Settings y vaya a la página <strong class='text-white'>Security</strong>. La autenticación en dos pasos es la base de todo lo demás, así que si el interruptor de 2FA aún no está activado, actívelo primero. Las opciones de llave de seguridad están justo debajo." },
        { title: "Registre su llave de seguridad", html: "Desplácese por debajo del interruptor de 2FA hasta la sección de llaves de seguridad e inicie el registro. A partir de aquí, su navegador o sistema operativo toma el control: toque su llave de hardware, apruebe el aviso de Windows Hello o elija la passkey guardada en su gestor de contraseñas. Póngale a la llave un nombre que reconozca más adelante, como \"YubiKey - escritorio\" o \"Passkey del teléfono\"." },
        { title: "Exija la llave en cada inicio de sesión", html: "Ahora busque la opción que obliga a usar la llave de seguridad en <em>todos</em> los inicios de sesión y no solo en dispositivos nuevos, y actívela. La etiqueta exacta varía un poco entre versiones, así que lea lo que aparece en su pantalla antes de confirmar. Una vez activa, Tradovate le pide esa llave cada vez que inicia sesión, ya sea en la web, en el escritorio o en el móvil. Una contraseña filtrada, por sí sola, no lleva a nadie a ninguna parte." },
        { title: "Añada una llave de respaldo y pruébela", html: "Antes de cerrar sesión, registre una segunda llave o dispositivo. Después cierre sesión por completo y vuelva a entrar para confirmar que aparece el aviso y que su llave funciona. Esta prueba importa: si obliga a usar una llave en cada inicio de sesión, registra solo una y la pierde, su única vía de vuelta es un ticket de soporte. No lo descubra por las malas a las 9:29 a. m., justo antes de la apertura." },
      ],
    },
    { type: "heading",text: "Qué cambia después de activarlo" },
    { type: "paragraph",html: "Cada inicio de sesión ahora activa el aviso de la llave, sin excepción. Si inicia sesión desde un dispositivo completamente nuevo, Tradovate aún puede enviar su correo de aprobar o denegar además de la llave, de modo que tiene capas de protección en lugar de cambiar una comprobación por otra." },
    { type: "quote",html: "Tenga en cuenta que esto refuerza el inicio de sesión interactivo en la plataforma. El trading automatizado mediante la API de Tradovate usa su propio flujo de token de acceso y no es lo mismo que el inicio de sesión en el navegador, por lo que exigir una llave al iniciar sesión no romperá en silencio un bot en funcionamiento." },
    { type: "heading",text: "Si algo sale mal" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>La llave no se reconoce:</strong> compruebe que la llave de hardware está bien insertada en el puerto, que el Bluetooth está activado si es una llave inalámbrica y que usa un navegador compatible con passkeys modernas.",
        "<strong class='text-white'>Perdió su única llave:</strong> para eso sirve la llave de respaldo del paso 4. Sin ella, contacte con el soporte de Tradovate para recuperar el acceso.",
        "<strong class='text-white'>Le desconectan entre sesiones:</strong> suele ser un problema distinto, de límite de dispositivos, y no de la llave.",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "¿Quiere que su estrategia siga ejecutándose mientras su cuenta permanece bien protegida? <strong class='text-white'>PickMyTrade envía sus alertas de TradingView directamente a su cuenta de Tradovate</strong>, de modo que las señales se ejecutan sin que tenga que dejar una sesión del navegador abierta todo el día." },
  ], fr: [
    { type: "paragraph",html: "Si quelqu'un met la main sur votre mot de passe Tradovate, seul votre second facteur le sépare de vos positions ouvertes. Par défaut, Tradovate ne demande ce second facteur que lorsqu'il détecte un nouvel appareil. C'est pratique, mais cela laisse une brèche : une session enregistrée sur une machine partagée, empruntée ou volée peut entrer par la grande porte. Tradovate comble cette brèche grâce à un paramètre qui exige une clé de sécurité enregistrée à <em>chaque</em> connexion, et non seulement lors de la première depuis un nouvel appareil. Voici comment l'activer." },
    { type: "heading",text: "Ce dont vous avez besoin au préalable" },
    {
      type: "list",
      items: [
        "Un compte Tradovate avec l'authentification à deux facteurs disponible. Certaines des méthodes de sécurité les plus robustes sont liées à l'accès aux comptes financés ou réels, et les comptes d'évaluation des prop firms peuvent être gérés différemment ; vérifiez donc les règles actuelles de votre société si vous en utilisez un.",
        "Une clé de sécurité. Il peut s'agir d'une clé matérielle via USB, NFC ou Bluetooth, de Windows Hello sur votre PC, d'une passkey stockée dans votre gestionnaire de mots de passe ou d'une application d'authentification sur votre téléphone.",
        "Idéalement, deux clés ou appareils. Enregistrez une clé de secours afin qu'une clé perdue ou déchargée ne vous bloque pas hors de votre propre compte.",
      ],
    },
    { type: "paragraph",html: "Vous débutez avec la connexion ? Commencez par comprendre le fonctionnement de la connexion à Tradovate sur le web et sur mobile, puis revenez ici pour la renforcer." },
    { type: "heading",text: "Activer l'exigence de clé de sécurité" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez les paramètres de sécurité et activez la 2FA", html: "Ouvrez Application Settings et rendez-vous sur la page <strong class='text-white'>Security</strong>. L'authentification à deux facteurs est le socle de tout le reste ; si l'interrupteur 2FA n'est pas déjà activé, activez-le d'abord. Les options de clé de sécurité se trouvent juste en dessous." },
        { title: "Enregistrez votre clé de sécurité", html: "Faites défiler sous l'interrupteur 2FA jusqu'à la section des clés de sécurité et lancez l'enregistrement. À partir de là, votre navigateur ou votre système d'exploitation prend le relais : touchez votre clé matérielle, validez l'invite Windows Hello ou choisissez la passkey enregistrée dans votre gestionnaire de mots de passe. Donnez à la clé un nom que vous reconnaîtrez plus tard, par exemple « YubiKey - bureau » ou « Passkey téléphone »." },
        { title: "Exigez la clé à chaque connexion", html: "Trouvez maintenant l'option qui impose la clé de sécurité à <em>toutes</em> les connexions plutôt qu'aux seuls nouveaux appareils, et activez-la. Le libellé exact varie légèrement d'une version à l'autre ; lisez donc ce qui s'affiche sur votre écran avant de valider. Une fois l'option active, Tradovate demande cette clé à chaque connexion, que ce soit sur le web, le bureau ou le mobile. Un mot de passe divulgué ne mène plus nulle part à lui seul." },
        { title: "Ajoutez une clé de secours, puis testez", html: "Avant de vous déconnecter, enregistrez une seconde clé ou un second appareil. Déconnectez-vous ensuite complètement, puis reconnectez-vous pour vérifier que l'invite apparaît et que votre clé fonctionne. Ce test est important : si vous imposez une clé à chaque connexion, n'en enregistrez qu'une seule et la perdez, votre seul recours est un ticket au support. Ne le découvrez pas à vos dépens à 9 h 29, juste avant l'ouverture." },
      ],
    },
    { type: "heading",text: "Ce qui change une fois l'option activée" },
    { type: "paragraph",html: "Chaque connexion déclenche désormais l'invite de la clé, sans exception. Si vous vous connectez depuis un tout nouvel appareil, Tradovate peut toujours envoyer son e-mail d'approbation ou de refus en plus de la clé : vous êtes donc protégé par plusieurs couches, au lieu de remplacer une vérification par une autre." },
    { type: "quote",html: "Gardez à l'esprit que cela renforce la connexion interactive à la plateforme. Le trading automatisé via l'API Tradovate utilise son propre flux de jeton d'accès et ne correspond pas à la connexion par navigateur ; imposer une clé à la connexion ne fera donc pas planter discrètement un bot en cours d'exécution." },
    { type: "heading",text: "En cas de problème" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Clé non reconnue :</strong> vérifiez que la clé matérielle est bien enfoncée dans le port, que le Bluetooth est activé pour une clé sans fil et que vous utilisez un navigateur compatible avec les passkeys modernes.",
        "<strong class='text-white'>Vous avez perdu votre unique clé :</strong> c'est précisément ce que la clé de secours de l'étape 4 permet d'éviter. Sans elle, contactez le support Tradovate pour récupérer l'accès.",
        "<strong class='text-white'>Déconnexions entre les sessions :</strong> il s'agit généralement d'un problème distinct de limite d'appareils, et non de la clé.",
      ],
    },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Vous voulez que votre stratégie continue de se déclencher alors que votre compte reste solidement verrouillé ? <strong class='text-white'>PickMyTrade achemine vos alertes TradingView directement vers votre compte Tradovate</strong>, de sorte que les signaux se déclenchent sans que vous ayez à laisser une session de navigateur ouverte toute la journée." },
  ], it: [
    { type: "paragraph",html: "Se qualcuno entra in possesso della sua password di Tradovate, tra lui e le sue posizioni aperte rimane solo il suo secondo fattore. Per impostazione predefinita, Tradovate richiede il secondo fattore soltanto quando rileva un nuovo dispositivo. È comodo, ma lascia una falla: una sessione salvata su un computer condiviso, preso in prestito o rubato può entrare dalla porta principale. Tradovate colma questa falla con un'impostazione che richiede una chiave di sicurezza registrata a <em>ogni</em> accesso, non solo la prima volta da un nuovo dispositivo. Ecco come attivarla." },
    { type: "heading",text: "Cosa serve prima di iniziare" },
    {
      type: "list",
      items: [
        "Un account Tradovate con autenticazione a due fattori disponibile. Alcuni dei metodi di sicurezza più robusti sono legati all'accesso ad account finanziati o live, e gli account di valutazione delle prop firm possono essere gestiti in modo diverso: verifichi le regole attuali della sua società, se ne utilizza una.",
        "Una chiave di sicurezza. Può essere una chiave hardware via USB, NFC o Bluetooth, Windows Hello sul suo PC, una passkey salvata nel suo gestore di password o un'app di autenticazione sul telefono.",
