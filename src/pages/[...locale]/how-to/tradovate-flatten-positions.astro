---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-flatten-positions";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Flatten All Positions & Cancel Orders in Tradovate";
const META_DESCRIPTION =
  "Flatten positions in Tradovate and cancel all working orders fast, exit one contract, clear the DOM, or flatten your entire account in a click.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Alle Positionen glattstellen und Orders stornieren in Tradovate", es: "Cierre todas las posiciones y cancele órdenes en Tradovate", fr: "Clôturer toutes les positions et annuler les ordres dans Tradovate", it: "Chiudere tutte le posizioni e annullare gli ordini in Tradovate" },
  dek: { en: "When the market rips against you and your order book is a mess, you want out fast. Here's every way to flatten positions and cancel orders in Tradovate.", de: "Wenn der Markt gegen Sie läuft und Ihr Orderbuch ein einziges Durcheinander ist, wollen Sie schnell raus. Hier sind alle Möglichkeiten, in Tradovate Positionen glattzustellen und Orders zu stornieren.", es: "Cuando el mercado se mueve en su contra y su libro de órdenes es un caos, quiere salir rápido. Estas son todas las formas de cerrar posiciones y cancelar órdenes en Tradovate.", fr: "Quand le marché part contre vous et que votre carnet d’ordres est en désordre, vous voulez sortir vite. Voici toutes les façons de clôturer vos positions et d’annuler vos ordres dans Tradovate.", it: "Quando il mercato va contro di Lei e il Suo book di ordini è in disordine, vuole uscire in fretta. Ecco tutti i modi per chiudere le posizioni e annullare gli ordini in Tradovate." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "When ES rips against you and your order book is a mess of stale limits and stops, you don't want to be hunting through menus. You want out, position closed, working orders gone, flat. Tradovate gives you a few ways to do exactly that, and this guide walks through each one: exit a single contract, clear the DOM, or flatten your whole account in a click. If you're wiring up automation with PickMyTrade, the same logic applies when an alert fires the exit for you." },
    { type: "heading", text: "What Does \"Flatten\" Mean in Tradovate?" },
    { type: "paragraph", html: "To <strong class='text-white'>flatten</strong> is to close your open positions back to zero and cancel any working (resting) orders tied to them. When you're flat, you're completely out of the market with nothing left to fill, no stray limit that trips two minutes later, no forgotten stop. Tradovate lets you flatten at three levels: a single position, every working order on an instrument, or your whole account at once. You can also schedule an automatic end-of-day flatten if you'd rather not rely on remembering." },
    { type: "heading", text: "Flatten Positions & Cancel Orders in Tradovate: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open the Positions Module", html: "Open the <strong class='text-white'>Positions</strong> module from the module menu. It shows every open position with its net quantity, average price, and open P&amp;L, right alongside any working orders. Think of it as your control panel, whether you're exiting a single contract or clearing the whole book, this is where you'll do it." },
        { title: "Flatten a Single Position (Exit at Market and Cancel)", html: "<strong class='text-white'>Right-click the position row</strong> to open its <strong class='text-white'>Actions</strong> menu, then choose <strong class='text-white'>Exit at Market and Cancel</strong>. Tradovate fires a market order to close that position and cancels every working order for that contract, both in one step. Only want out of part of a position? Skip the Actions menu and use the row's <strong class='text-white'>Close</strong> button instead, where you can set the exact quantity." },
        { title: "Cancel Working Orders From the DOM", html: "Sometimes you want to clear resting orders but leave the position alone. That's a job for the <strong class='text-white'>SuperDOM</strong>. Its batch-cancel buttons, <strong class='text-white'>CXL Buy</strong>, <strong class='text-white'>CXL Sell</strong>, and <strong class='text-white'>CXL All</strong>, wipe the buy side, the sell side, or every working order on that instrument. Need to pull just one order? Click it on the DOM (or hover its line on the chart) and hit <strong class='text-white'>Cancel</strong> or the <strong class='text-white'>X</strong>." },
        { title: "Flatten the Whole Account (Exit All Positions & Cancel All Orders)", html: "To dump everything at once, open the <strong class='text-white'>Equity / Open P&amp;L</strong> section at the top of the Trader and click <strong class='text-white'>Exit All Positions &amp; Cancel All Orders</strong>. Confirm the prompt and Tradovate market-exits every open position and cancels all working and suspended orders on that account. One thing to keep in mind: this button works on <strong class='text-white'>one account at a time</strong>. Trade several accounts? You'll need to flatten each one separately." },
        { title: "Schedule an Automatic Flatten (Flatten Today)", html: "Want a hard cutoff you can't forget? Tradovate's <strong class='text-white'>Flatten Today</strong> (timed flatten) lets you set a time at which it automatically cancels all pending orders and flattens all open positions across your connected accounts. It's the cleanest way to enforce a no-overnight-positions rule without babysitting the clock." },
      ],
    },
    { type: "heading", text: "Why You'd Need This" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Kill risk instantly</strong> when a trade or a news spike moves hard against you.",
        "<strong class='text-white'>Clear a tangled order book</strong> of stale limits and stops in one click.",
        "<strong class='text-white'>Exit cleanly at session end</strong> so nothing carries into higher overnight margin.",
        "<strong class='text-white'>Stay prop-firm compliant</strong> by flattening before a daily cutoff.",
        "<strong class='text-white'>Recover from a stuck bracket</strong> by exiting at market and cancelling the leftovers together.",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Manual flattening is fine, right up until an exit alert fires while you're away from the desk. PickMyTrade links your TradingView alerts straight to your Tradovate account, so a close or reverse signal flattens the position and cancels the leftover orders on its own. No scramble for the panic button." },
  ], de: [
    { type: "paragraph",html: "Wenn ES gegen Sie läuft und Ihr Orderbuch ein Durcheinander aus veralteten Limit- und Stop-Orders ist, wollen Sie nicht erst durch Menüs suchen. Sie wollen raus: Position geschlossen, aktive Orders weg, flat. Tradovate bietet Ihnen dafür mehrere Wege, und dieser Leitfaden führt Sie durch jeden einzelnen: einen einzelnen Kontrakt verlassen, das DOM leeren oder Ihr gesamtes Konto mit einem Klick glattstellen. Wenn Sie die Automatisierung mit PickMyTrade einrichten, gilt dieselbe Logik, sobald ein Alert den Ausstieg für Sie auslöst." },
    { type: "heading",text: "Was bedeutet „Flatten“ in Tradovate?" },
    { type: "paragraph",html: "<strong class='text-white'>Glattstellen</strong> (Flatten) bedeutet, Ihre offenen Positionen auf null zu schließen und alle aktiven (wartenden) Orders zu stornieren, die damit verknüpft sind. Wenn Sie flat sind, sind Sie vollständig aus dem Markt, und nichts kann mehr ausgeführt werden: keine vergessene Limit-Order, die zwei Minuten später greift, kein vergessener Stop. Tradovate lässt Sie auf drei Ebenen glattstellen: eine einzelne Position, jede aktive Order eines Instruments oder Ihr gesamtes Konto auf einmal. Sie können außerdem ein automatisches Glattstellen zum Handelsende planen, falls Sie sich nicht auf Ihr Gedächtnis verlassen möchten." },
    { type: "heading",text: "Positionen glattstellen und Orders stornieren in Tradovate: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Das Positions-Modul öffnen", html: "Öffnen Sie das Modul <strong class='text-white'>Positions</strong> im Modulmenü. Es zeigt jede offene Position mit Nettomenge, Durchschnittspreis und offenem G&amp;V, direkt neben allen aktiven Orders. Betrachten Sie es als Ihr Kontrollpult: Ob Sie einen einzelnen Kontrakt verlassen oder das gesamte Buch leeren, hier erledigen Sie es." },
        { title: "Eine einzelne Position glattstellen (Exit at Market and Cancel)", html: "<strong class='text-white'>Klicken Sie mit der rechten Maustaste auf die Positionszeile</strong>, um das Menü <strong class='text-white'>Actions</strong> zu öffnen, und wählen Sie dann <strong class='text-white'>Exit at Market and Cancel</strong>. Tradovate sendet eine Market-Order zum Schließen dieser Position und storniert alle aktiven Orders für diesen Kontrakt, beides in einem Schritt. Sie möchten nur einen Teil der Position verlassen? Überspringen Sie das Actions-Menü und nutzen Sie stattdessen die Schaltfläche <strong class='text-white'>Close</strong> der Zeile, mit der Sie die genaue Menge festlegen können." },
        { title: "Aktive Orders im DOM stornieren", html: "Manchmal möchten Sie wartende Orders entfernen, die Position aber unangetastet lassen. Dafür ist das <strong class='text-white'>SuperDOM</strong> da. Seine Sammelstorno-Schaltflächen <strong class='text-white'>CXL Buy</strong>, <strong class='text-white'>CXL Sell</strong> und <strong class='text-white'>CXL All</strong> entfernen die Kaufseite, die Verkaufsseite oder jede aktive Order dieses Instruments. Sie wollen nur eine einzelne Order zurückziehen? Klicken Sie sie im DOM an (oder fahren Sie im Chart über ihre Linie) und wählen Sie <strong class='text-white'>Cancel</strong> oder das <strong class='text-white'>X</strong>." },
        { title: "Das ganze Konto glattstellen (Exit All Positions & Cancel All Orders)", html: "Um alles auf einmal loszuwerden, öffnen Sie oben im Trader den Bereich <strong class='text-white'>Equity / Open P&amp;L</strong> und klicken Sie auf <strong class='text-white'>Exit All Positions &amp; Cancel All Orders</strong>. Bestätigen Sie die Abfrage, und Tradovate schließt jede offene Position zum Marktpreis und storniert alle aktiven und ausgesetzten Orders dieses Kontos. Beachten Sie dabei: Diese Schaltfläche wirkt jeweils auf <strong class='text-white'>ein Konto</strong>. Handeln Sie mehrere Konten? Dann müssen Sie jedes einzeln glattstellen." },
        { title: "Ein automatisches Glattstellen planen (Flatten Today)", html: "Möchten Sie eine feste Frist, die Sie nicht vergessen können? Mit <strong class='text-white'>Flatten Today</strong> (zeitgesteuertes Glattstellen) von Tradovate legen Sie eine Uhrzeit fest, zu der automatisch alle ausstehenden Orders storniert und alle offenen Positionen über Ihre verbundenen Konten hinweg glattgestellt werden. Es ist der sauberste Weg, eine Regel „keine Positionen über Nacht“ durchzusetzen, ohne die Uhr im Auge behalten zu müssen." },
      ],
    },
    { type: "heading",text: "Wann Sie das brauchen" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Risiko sofort beenden</strong>, wenn ein Trade oder ein Nachrichtenspike hart gegen Sie läuft.",
        "<strong class='text-white'>Ein verworrenes Orderbuch</strong> mit einem Klick von veralteten Limit- und Stop-Orders befreien.",
        "<strong class='text-white'>Sauber zum Sitzungsende aussteigen</strong>, damit nichts mit höherer Übernacht-Margin in die nächste Sitzung rutscht.",
        "<strong class='text-white'>Prop-Firm-konform bleiben</strong>, indem Sie vor einem täglichen Stichzeitpunkt glattstellen.",
        "<strong class='text-white'>Von einem hängenden Bracket erholen</strong>, indem Sie zum Marktpreis aussteigen und die übrigen Orders gleichzeitig stornieren.",
      ],
    },
    { type: "heading",text: "Automatisieren Sie das mit PickMyTrade" },
    { type: "paragraph",html: "Manuelles Glattstellen ist in Ordnung, bis ein Exit-Alert auslöst, während Sie nicht am Schreibtisch sind. PickMyTrade verbindet Ihre TradingView-Alerts direkt mit Ihrem Tradovate-Konto, sodass ein Close- oder Reverse-Signal die Position glattstellt und die übrigen Orders ganz von selbst storniert. Kein hektisches Suchen nach dem Panikknopf." },
  ], es: [
    { type: "paragraph",html: "Cuando ES se mueve en su contra y su libro de órdenes es un revoltijo de límites y stops obsoletos, no quiere perder tiempo buscando entre menús. Quiere salir: posición cerrada, órdenes activas eliminadas, plano. Tradovate le ofrece varias formas de hacerlo, y esta guía repasa cada una: salir de un solo contrato, limpiar el DOM o dejar plana toda su cuenta con un clic. Si está configurando la automatización con PickMyTrade, la misma lógica se aplica cuando una alerta dispara la salida por usted." },
    { type: "heading",text: "¿Qué significa «flatten» en Tradovate?" },
    { type: "paragraph",html: "<strong class='text-white'>Dejar plana</strong> (flatten) significa cerrar sus posiciones abiertas hasta cero y cancelar las órdenes activas (pendientes) vinculadas a ellas. Cuando está plano, está completamente fuera del mercado y no queda nada por ejecutarse: ningún límite olvidado que se active dos minutos después, ningún stop olvidado. Tradovate le permite dejar plana la cuenta en tres niveles: una sola posición, todas las órdenes activas de un instrumento o toda su cuenta a la vez. También puede programar un cierre automático de fin de día si prefiere no depender de su memoria." },
    { type: "heading",text: "Cerrar posiciones y cancelar órdenes en Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra el módulo Positions", html: "Abra el módulo <strong class='text-white'>Positions</strong> desde el menú de módulos. Muestra cada posición abierta con su cantidad neta, precio promedio y P&amp;L abierto, junto a las órdenes activas. Piense en él como su panel de control: tanto si sale de un solo contrato como si limpia todo el libro, aquí es donde lo hará." },
        { title: "Deje plana una sola posición (Exit at Market and Cancel)", html: "<strong class='text-white'>Haga clic con el botón derecho en la fila de la posición</strong> para abrir su menú <strong class='text-white'>Actions</strong> y elija <strong class='text-white'>Exit at Market and Cancel</strong>. Tradovate envía una orden de mercado para cerrar esa posición y cancela todas las órdenes activas de ese contrato, ambas cosas en un solo paso. ¿Solo quiere salir de una parte de la posición? Omita el menú Actions y utilice en su lugar el botón <strong class='text-white'>Close</strong> de la fila, donde puede fijar la cantidad exacta." },
        { title: "Cancele órdenes activas desde el DOM", html: "A veces quiere eliminar las órdenes pendientes pero dejar la posición intacta. Para eso sirve el <strong class='text-white'>SuperDOM</strong>. Sus botones de cancelación por lotes, <strong class='text-white'>CXL Buy</strong>, <strong class='text-white'>CXL Sell</strong> y <strong class='text-white'>CXL All</strong>, eliminan el lado comprador, el lado vendedor o todas las órdenes activas de ese instrumento. ¿Necesita retirar solo una orden? Haga clic en ella en el DOM (o pase el cursor sobre su línea en el gráfico) y pulse <strong class='text-white'>Cancel</strong> o la <strong class='text-white'>X</strong>." },
        { title: "Deje plana toda la cuenta (Exit All Positions & Cancel All Orders)", html: "Para deshacerse de todo a la vez, abra la sección <strong class='text-white'>Equity / Open P&amp;L</strong> en la parte superior del Trader y haga clic en <strong class='text-white'>Exit All Positions &amp; Cancel All Orders</strong>. Confirme el aviso y Tradovate sale a mercado de todas las posiciones abiertas y cancela todas las órdenes activas y suspendidas de esa cuenta. Tenga presente una cosa: este botón funciona con <strong class='text-white'>una cuenta a la vez</strong>. ¿Opera varias cuentas? Tendrá que dejar plana cada una por separado." },
        { title: "Programe un cierre automático (Flatten Today)", html: "¿Quiere un límite estricto que no pueda olvidar? <strong class='text-white'>Flatten Today</strong> (cierre programado) de Tradovate le permite fijar una hora a la que cancela automáticamente todas las órdenes pendientes y deja planas todas las posiciones abiertas en sus cuentas conectadas. Es la forma más limpia de hacer cumplir una regla de no mantener posiciones overnight sin tener que vigilar el reloj." },
      ],
    },
    { type: "heading",text: "Por qué lo necesitaría" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Eliminar el riesgo al instante</strong> cuando una operación o un pico de noticias se mueve con fuerza en su contra.",
        "<strong class='text-white'>Limpiar un libro de órdenes enredado</strong> de límites y stops obsoletos con un solo clic.",
        "<strong class='text-white'>Salir limpiamente al final de la sesión</strong> para que nada pase a un margen overnight más alto.",
        "<strong class='text-white'>Cumplir con la prop firm</strong> dejando todo plano antes de un corte diario.",
        "<strong class='text-white'>Recuperarse de un bracket atascado</strong> saliendo a mercado y cancelando juntos los restos.",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Cerrar manualmente está bien, hasta que una alerta de salida se dispara mientras usted está lejos del escritorio. PickMyTrade conecta sus alertas de TradingView directamente con su cuenta de Tradovate, de modo que una señal de cierre o de reversa deja plana la posición y cancela las órdenes restantes por sí sola. Sin correr a buscar el botón de pánico." },
  ], fr: [
    { type: "paragraph",html: "Quand ES part contre vous et que votre carnet d’ordres est un fouillis de limites et de stops périmés, vous n’avez pas envie de chercher dans les menus. Vous voulez sortir : position fermée, ordres actifs supprimés, à plat. Tradovate vous offre plusieurs moyens d’y parvenir, et ce guide présente chacun d’eux : sortir d’un seul contrat, vider le DOM ou mettre tout votre compte à plat en un clic. Si vous mettez en place l’automatisation avec PickMyTrade, la même logique s’applique lorsqu’une alerte déclenche la sortie à votre place." },
    { type: "heading",text: "Que signifie « flatten » dans Tradovate ?" },
    { type: "paragraph",html: "<strong class='text-white'>Mettre à plat</strong> (flatten) signifie ramener vos positions ouvertes à zéro et annuler tous les ordres actifs (en attente) qui leur sont liés. Quand vous êtes à plat, vous êtes totalement sorti du marché, sans rien qui puisse encore s’exécuter : pas de limite oubliée qui se déclenche deux minutes plus tard, pas de stop oublié. Tradovate vous permet de mettre à plat à trois niveaux : une seule position, tous les ordres actifs sur un instrument, ou tout votre compte d’un coup. Vous pouvez aussi programmer une mise à plat automatique en fin de journée si vous préférez ne pas compter sur votre mémoire." },
    { type: "heading",text: "Clôturer les positions et annuler les ordres dans Tradovate : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir le module Positions", html: "Ouvrez le module <strong class='text-white'>Positions</strong> depuis le menu des modules. Il affiche chaque position ouverte avec sa quantité nette, son prix moyen et son P&amp;L ouvert, juste à côté des ordres actifs. Considérez-le comme votre tableau de bord : que vous sortiez d’un seul contrat ou que vous vidiez tout le carnet, c’est ici que cela se passe." },
        { title: "Mettre à plat une seule position (Exit at Market and Cancel)", html: "<strong class='text-white'>Faites un clic droit sur la ligne de la position</strong> pour ouvrir son menu <strong class='text-white'>Actions</strong>, puis choisissez <strong class='text-white'>Exit at Market and Cancel</strong>. Tradovate envoie un ordre au marché pour fermer cette position et annule tous les ordres actifs de ce contrat, les deux en une seule étape. Vous ne voulez sortir que d’une partie de la position ? Ignorez le menu Actions et utilisez plutôt le bouton <strong class='text-white'>Close</strong> de la ligne, où vous pouvez définir la quantité exacte." },
        { title: "Annuler les ordres actifs depuis le DOM", html: "Parfois, vous voulez supprimer les ordres en attente tout en laissant la position intacte. C’est le rôle du <strong class='text-white'>SuperDOM</strong>. Ses boutons d’annulation groupée, <strong class='text-white'>CXL Buy</strong>, <strong class='text-white'>CXL Sell</strong> et <strong class='text-white'>CXL All</strong>, suppriment le côté achat, le côté vente ou tous les ordres actifs sur cet instrument. Vous ne voulez retirer qu’un seul ordre ? Cliquez dessus dans le DOM (ou survolez sa ligne sur le graphique) et appuyez sur <strong class='text-white'>Cancel</strong> ou sur le <strong class='text-white'>X</strong>." },
        { title: "Mettre tout le compte à plat (Exit All Positions & Cancel All Orders)", html: "Pour tout liquider d’un coup, ouvrez la section <strong class='text-white'>Equity / Open P&amp;L</strong> en haut du Trader et cliquez sur <strong class='text-white'>Exit All Positions &amp; Cancel All Orders</strong>. Confirmez l’invite et Tradovate sort de toutes les positions ouvertes au marché et annule tous les ordres actifs et suspendus de ce compte. Un point à garder à l’esprit : ce bouton agit sur <strong class='text-white'>un seul compte à la fois</strong>. Vous tradez plusieurs comptes ? Il faudra mettre chacun à plat séparément." },
        { title: "Programmer une mise à plat automatique (Flatten Today)", html: "Vous voulez une heure limite que vous ne pouvez pas oublier ? La fonction <strong class='text-white'>Flatten Today</strong> (mise à plat programmée) de Tradovate vous permet de fixer une heure à laquelle elle annule automatiquement tous les ordres en attente et met à plat toutes les positions ouvertes sur vos comptes connectés. C’est le moyen le plus propre d’appliquer une règle de « aucune position overnight » sans surveiller l’horloge." },
      ],
    },
    { type: "heading",text: "Pourquoi en avoir besoin" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Éliminer le risque instantanément</strong> lorsqu’un trade ou un pic d’actualité part fortement contre vous.",
        "<strong class='text-white'>Nettoyer un carnet d’ordres embrouillé</strong> de ses limites et stops périmés en un clic.",
        "<strong class='text-white'>Sortir proprement en fin de session</strong> pour que rien ne passe la nuit avec une marge plus élevée.",
        "<strong class='text-white'>Rester conforme à votre prop firm</strong> en vous mettant à plat avant une heure limite quotidienne.",
        "<strong class='text-white'>Se sortir d’un bracket bloqué</strong> en sortant au marché et en annulant les ordres restants en même temps.",
      ],
    },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "La mise à plat manuelle convient très bien, jusqu’à ce qu’une alerte de sortie se déclenche alors que vous êtes loin de votre bureau. PickMyTrade relie vos alertes TradingView directement à votre compte Tradovate, de sorte qu’un signal de clôture ou d’inversion met la position à plat et annule les ordres restants tout seul. Plus besoin de chercher le bouton d’urgence en catastrophe." },
  ], it: [
    { type: "paragraph",html: "Quando ES va contro di Lei e il Suo book di ordini è un groviglio di limit e stop obsoleti, non vuole cercare tra i menu. Vuole uscire: posizione chiusa, ordini attivi eliminati, flat. Tradovate Le offre diversi modi per farlo, e questa guida li illustra uno per uno: uscire da un singolo contratto, ripulire il DOM o portare tutto il conto flat con un clic. Se sta configurando l’automazione con PickMyTrade, la stessa logica vale quando è un alert a far scattare l’uscita al Suo posto." },
    { type: "heading",text: "Cosa significa «flatten» in Tradovate?" },
    { type: "paragraph",html: "<strong class='text-white'>Andare flat</strong> (flatten) significa riportare a zero le Sue posizioni aperte e annullare tutti gli ordini attivi (in attesa) collegati. Quando è flat, è completamente fuori dal mercato e non resta nulla da eseguire: nessun limit dimenticato che scatta due minuti dopo, nessuno stop dimenticato. Tradovate Le consente di andare flat a tre livelli: una singola posizione, ogni ordine attivo su uno strumento o l’intero conto in una volta. Può anche pianificare una chiusura automatica a fine giornata, se preferisce non affidarsi alla memoria." },
    { type: "heading",text: "Chiudere le posizioni e annullare gli ordini in Tradovate: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Aprire il modulo Positions", html: "Apra il modulo <strong class='text-white'>Positions</strong> dal menu dei moduli. Mostra ogni posizione aperta con quantità netta, prezzo medio e P&amp;L aperto, accanto a tutti gli ordini attivi. Lo consideri il Suo pannello di controllo: che debba uscire da un singolo contratto o ripulire l’intero book, è da qui che lo fa." },
        { title: "Chiudere una singola posizione (Exit at Market and Cancel)", html: "<strong class='text-white'>Faccia clic con il tasto destro sulla riga della posizione</strong> per aprire il relativo menu <strong class='text-white'>Actions</strong>, quindi scelga <strong class='text-white'>Exit at Market and Cancel</strong>. Tradovate invia un ordine a mercato per chiudere quella posizione e annulla tutti gli ordini attivi per quel contratto, entrambe le cose in un solo passaggio. Vuole uscire solo da una parte della posizione? Salti il menu Actions e usi invece il pulsante <strong class='text-white'>Close</strong> della riga, dove può impostare la quantità esatta." },
        { title: "Annullare gli ordini attivi dal DOM", html: "A volte vuole eliminare gli ordini in attesa ma lasciare la posizione intatta. Per questo c’è il <strong class='text-white'>SuperDOM</strong>. I suoi pulsanti di annullamento in blocco, <strong class='text-white'>CXL Buy</strong>, <strong class='text-white'>CXL Sell</strong> e <strong class='text-white'>CXL All</strong>, eliminano il lato acquisto, il lato vendita o ogni ordine attivo su quello strumento. Deve ritirare solo un ordine? Ci faccia clic sul DOM (o passi sulla sua linea nel grafico) e prema <strong class='text-white'>Cancel</strong> oppure la <strong class='text-white'>X</strong>." },
        { title: "Portare flat l’intero conto (Exit All Positions & Cancel All Orders)", html: "Per liberarsi di tutto in una volta, apra la sezione <strong class='text-white'>Equity / Open P&amp;L</strong> in alto nel Trader e faccia clic su <strong class='text-white'>Exit All Positions &amp; Cancel All Orders</strong>. Confermi la richiesta e Tradovate esce a mercato da ogni posizione aperta e annulla tutti gli ordini attivi e sospesi su quel conto. Una cosa da tenere a mente: questo pulsante agisce su <strong class='text-white'>un conto alla volta</strong>. Opera su più conti? Dovrà portare flat ciascuno separatamente." },
        { title: "Pianificare una chiusura automatica (Flatten Today)", html: "Vuole un limite rigido che non possa dimenticare? <strong class='text-white'>Flatten Today</strong> (chiusura a orario) di Tradovate Le permette di impostare un orario in cui annulla automaticamente tutti gli ordini in sospeso e porta flat tutte le posizioni aperte sui Suoi conti collegati. È il modo più pulito per far rispettare una regola di nessuna posizione overnight senza dover controllare l’orologio." },
