---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-pop-out-modules";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Pop Out & Arrange Tradovate Modules on Monitors";
const META_DESCRIPTION =
  "Pop out and arrange Tradovate modules across multiple monitors. A step-by-step setup for a cleaner, faster multi-screen futures trading layout.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate-Module auf Monitoren herauslösen & anordnen", es: "Cómo extraer y organizar los módulos de Tradovate en varios monitores", fr: "Détacher et organiser les modules Tradovate sur vos moniteurs", it: "Estrarre e disporre i moduli Tradovate sui monitor" },
  dek: { en: "If you trade on more than one screen, Tradovate lets you break modules out, drop them where you want, and spread your setup across monitors. Here's how to do it cleanly.", de: "Wenn Sie auf mehr als einem Bildschirm handeln, können Sie in Tradovate Module herauslösen, dort ablegen, wo Sie sie wollen, und Ihr Setup auf mehrere Monitore verteilen. So gelingt es sauber.", es: "Si opera con más de una pantalla, Tradovate le permite sacar los módulos, soltarlos donde quiera y repartir su configuración entre monitores. Así se hace con limpieza.", fr: "Si vous tradez sur plusieurs écrans, Tradovate vous permet de détacher des modules, de les déposer où vous voulez et de répartir votre configuration sur plusieurs moniteurs. Voici comment procéder proprement.", it: "Se opera su più di uno schermo, Tradovate Le permette di estrarre i moduli, rilasciarli dove vuole e distribuire la Sua configurazione su più monitor. Ecco come farlo in modo ordinato." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "If you trade on more than one screen, cramming every chart, ladder, and order ticket into a single window gets old fast. Tradovate lets you break modules out, drop them where you want, and spread your setup across monitors. Here's how to do it cleanly, plus the one thing that trips people up: the web version and the desktop app don't behave the same way." },
    { type: "heading", text: "Web Trader vs Desktop App: What Actually Spans Monitors" },
    { type: "paragraph", html: "The Tradovate Web Trader runs inside a single browser tab, so a module can't physically leave that browser window. You can still add, rearrange, resize, and tab modules inside it, and you can open a second browser window on your other monitor. For true pop-out windows that you drag onto a second display, use the Tradovate desktop download." },
    { type: "heading", text: "Arranging Modules Across Monitors: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Add the Module You Want to Place", html: "Click the <strong class='text-white'>New</strong> (<strong class='text-white'>+</strong>) button at the top-left of the workspace to open the module list. Pick what you need, Chart, SuperDOM, Order Ticket, Positions, and so on, then drop it into the workspace. Add every module you plan to arrange before you start moving things around, so you're shuffling a full layout rather than building it piece by piece.", image: { src: `${IMG}/tradovate-pop-out-modules-1.png`, alt: "Tradovate workspace with the New plus button open showing the list of modules to add" } },
        { title: "Move and Resize It Inside the Workspace", html: "Click and hold the module's title tab at the top, then drag it where you want it. Drop zones light up as you drag, so you can dock the module against the left, right, top, or bottom edge, or drop it into the center of an existing pane. Let go when the highlight matches the spot you're after. Grab an edge or corner to resize. Do this for each module until the layout inside the window feels right.", image: { src: `${IMG}/tradovate-pop-out-modules-2.png`, alt: "Dragging a Tradovate module by its tab with a highlighted drop zone showing where it will dock" } },
        { title: "Stack Modules Into Tabs (Optional)", html: "Want several charts in one slot without eating screen space? Drag one module directly on top of another and release in the center of the pane. The two now share the same spot as tabs you click between. It's handy for keeping, say, three timeframes of the same instrument in one corner while your DOM and ticket stay put.", image: { src: `${IMG}/tradovate-pop-out-modules-3.png`, alt: "Two Tradovate chart modules grouped as clickable tabs inside a single pane" } },
        { title: "Pop a Module Into Its Own Window", html: "This is the part the browser can't do. In the Tradovate desktop app, click a module's <strong class='text-white'>name</strong> to open it as its own floating window instead of dragging it inside the workspace. Once it's a standalone window, drag it onto your second or third monitor and size it to fill the screen. Repeat for every module you want on another display, a big chart on the left screen, the SuperDOM and order ticket dead center, positions and account info off to the side.", image: { src: `${IMG}/tradovate-pop-out-modules-4.png`, alt: "A Tradovate module opened as a separate desktop window dragged onto a second monitor" } },
        { title: "Save Your Workspace So the Layout Sticks", html: "Once your screens look right, save the arrangement. Open the workspace menu at the top-left, give the layout a clear name, and save it. Next login, load that workspace and your setup comes back instead of starting from a blank grid. On the desktop app, double-check that your separate windows land where you left them after loading, since window positions across monitors can shift; nudge any strays back into place.", image: { src: `${IMG}/tradovate-pop-out-modules-5.png`, alt: "Tradovate workspace menu with a named layout being saved so the multi-monitor arrangement persists" } },
      ],
    },
    { type: "heading", text: "Keep Your Multi-Monitor Layout Clean" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Name workspaces by intent</strong>, scalping, swing, news, so you can switch the whole board in one click.",
        "<strong class='text-white'>Put your hands where the action is</strong>, keep the DOM and order ticket on your primary screen and push reference charts to the side monitors.",
        "<strong class='text-white'>Lost a window?</strong> If a popped-out window slips behind another, use your operating system's window controls (or the taskbar) to bring it forward.",
        "<strong class='text-white'>Pair it with hotkeys</strong>, a spread-out layout plus keyboard shortcuts means fewer mouse trips across three screens.",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "A slick multi-monitor layout is great for watching the market, but you don't have to sit glued to it. <strong class='text-white'>PickMyTrade routes your TradingView alerts straight through to your Tradovate account</strong>, so your strategy fires on its own while your screens just confirm what's happening." },
  ], de: [
    { type: "paragraph",html: "Wenn Sie auf mehr als einem Bildschirm handeln, wird es schnell lästig, jeden Chart, jede Leiter und jedes Order Ticket in ein einziges Fenster zu quetschen. In Tradovate können Sie Module herauslösen, dort ablegen, wo Sie sie wollen, und Ihr Setup auf mehrere Monitore verteilen. So gelingt es sauber, dazu die eine Sache, über die viele stolpern: Die Webversion und die Desktop-App verhalten sich nicht gleich." },
    { type: "heading",text: "Web Trader vs. Desktop-App: Was sich tatsächlich über Monitore erstreckt" },
    { type: "paragraph",html: "Der Tradovate Web Trader läuft in einem einzigen Browser-Tab, daher kann ein Modul dieses Browserfenster physisch nicht verlassen. Sie können darin weiterhin Module hinzufügen, neu anordnen, in der Größe ändern und als Tabs gruppieren, und Sie können auf Ihrem anderen Monitor ein zweites Browserfenster öffnen. Für echte herausgelöste Fenster, die Sie auf einen zweiten Bildschirm ziehen, nutzen Sie den Tradovate-Desktop-Download." },
    { type: "heading",text: "Module auf Monitoren anordnen: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Das zu platzierende Modul hinzufügen", html: "Klicken Sie oben links im Workspace auf die Schaltfläche <strong class='text-white'>New</strong> (<strong class='text-white'>+</strong>), um die Modulliste zu öffnen. Wählen Sie, was Sie brauchen, Chart, SuperDOM, Order Ticket, Positions und so weiter, und legen Sie es im Workspace ab. Fügen Sie alle Module hinzu, die Sie anordnen möchten, bevor Sie anfangen, Dinge zu verschieben, damit Sie ein vollständiges Layout umordnen, statt es Stück für Stück aufzubauen.", image: {"src":`${IMG}/tradovate-pop-out-modules-1.png`,"alt":"Tradovate-Workspace mit geöffneter Schaltfläche New Plus, die die Liste der hinzufügbaren Module zeigt"} },
        { title: "Im Workspace verschieben und Größe ändern", html: "Klicken Sie oben auf den Titel-Tab des Moduls, halten Sie ihn gedrückt und ziehen Sie das Modul an die gewünschte Stelle. Beim Ziehen leuchten Ablagezonen auf, sodass Sie das Modul am linken, rechten, oberen oder unteren Rand andocken oder in die Mitte eines vorhandenen Bereichs ablegen können. Lassen Sie los, wenn die Markierung zur gewünschten Stelle passt. Ziehen Sie an einer Kante oder Ecke, um die Größe zu ändern. Tun Sie dies für jedes Modul, bis das Layout im Fenster stimmig ist.", image: {"src":`${IMG}/tradovate-pop-out-modules-2.png`,"alt":"Ziehen eines Tradovate-Moduls am Tab mit einer hervorgehobenen Ablagezone, die zeigt, wo es andockt"} },
        { title: "Module zu Tabs stapeln (optional)", html: "Sie möchten mehrere Charts in einem Slot, ohne Bildschirmplatz zu verbrauchen? Ziehen Sie ein Modul direkt auf ein anderes und lassen Sie es in der Mitte des Bereichs los. Beide teilen sich nun denselben Platz als Tabs, zwischen denen Sie klicken. Das ist praktisch, um etwa drei Zeitebenen desselben Instruments in einer Ecke zu halten, während DOM und Ticket an ihrem Platz bleiben.", image: {"src":`${IMG}/tradovate-pop-out-modules-3.png`,"alt":"Zwei Tradovate-Chart-Module als anklickbare Tabs in einem einzigen Bereich gruppiert"} },
        { title: "Ein Modul in ein eigenes Fenster herauslösen", html: "Das ist der Teil, den der Browser nicht kann. Klicken Sie in der Tradovate-Desktop-App auf den <strong class='text-white'>Namen</strong> eines Moduls, um es als eigenes schwebendes Fenster zu öffnen, statt es im Workspace zu ziehen. Sobald es ein eigenständiges Fenster ist, ziehen Sie es auf Ihren zweiten oder dritten Monitor und passen die Größe so an, dass es den Bildschirm füllt. Wiederholen Sie das für jedes Modul, das auf einem anderen Display liegen soll: ein großer Chart auf dem linken Bildschirm, SuperDOM und Order Ticket genau in der Mitte, Positionen und Kontoinformationen an der Seite.", image: {"src":`${IMG}/tradovate-pop-out-modules-4.png`,"alt":"Ein Tradovate-Modul, als separates Desktop-Fenster geöffnet und auf einen zweiten Monitor gezogen"} },
        { title: "Workspace speichern, damit das Layout bleibt", html: "Sobald Ihre Bildschirme richtig aussehen, speichern Sie die Anordnung. Öffnen Sie oben links das Workspace-Menü, geben Sie dem Layout einen klaren Namen und speichern Sie es. Beim nächsten Login laden Sie diesen Workspace, und Ihr Setup kommt zurück, statt mit einem leeren Raster zu beginnen. Prüfen Sie in der Desktop-App nach dem Laden, ob Ihre separaten Fenster dort landen, wo Sie sie hinterlassen haben, da sich Fensterpositionen über Monitore hinweg verschieben können; schieben Sie Ausreißer zurück an ihren Platz.", image: {"src":`${IMG}/tradovate-pop-out-modules-5.png`,"alt":"Tradovate-Workspace-Menü, in dem ein benanntes Layout gespeichert wird, damit die Multi-Monitor-Anordnung erhalten bleibt"} },
      ],
    },
    { type: "heading",text: "Halten Sie Ihr Multi-Monitor-Layout sauber" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Benennen Sie Workspaces nach Absicht</strong>, Scalping, Swing, News, damit Sie das gesamte Board mit einem Klick wechseln können.",
        "<strong class='text-white'>Legen Sie Ihre Hände dorthin, wo die Action ist</strong>, behalten Sie DOM und Order Ticket auf Ihrem Hauptbildschirm und schieben Sie Referenz-Charts auf die seitlichen Monitore.",
        "<strong class='text-white'>Ein Fenster verloren?</strong> Rutscht ein herausgelöstes Fenster hinter ein anderes, holen Sie es mit den Fenstersteuerungen Ihres Betriebssystems (oder über die Taskleiste) nach vorn.",
        "<strong class='text-white'>Kombinieren Sie es mit Hotkeys</strong>, ein verteiltes Layout plus Tastenkürzel bedeutet weniger Mauswege über drei Bildschirme.",
      ],
    },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "Ein elegantes Multi-Monitor-Layout ist ideal, um den Markt zu beobachten, aber Sie müssen nicht daran kleben. <strong class='text-white'>PickMyTrade leitet Ihre TradingView-Alerts direkt an Ihr Tradovate-Konto weiter</strong>, sodass Ihre Strategie von selbst ausgelöst wird, während Ihre Bildschirme nur bestätigen, was passiert." },
  ], es: [
    { type: "paragraph",html: "Si opera con más de una pantalla, meter todos los gráficos, escaleras y tickets de órdenes en una sola ventana cansa pronto. Tradovate le permite sacar los módulos, soltarlos donde quiera y repartir su configuración entre monitores. Así se hace con limpieza, además de lo único que suele confundir a la gente: la versión web y la aplicación de escritorio no se comportan igual." },
    { type: "heading",text: "Web Trader frente a la aplicación de escritorio: qué abarca realmente varios monitores" },
    { type: "paragraph",html: "El Tradovate Web Trader funciona dentro de una sola pestaña del navegador, por lo que un módulo no puede salir físicamente de esa ventana. Aun así, puede añadir, reorganizar, cambiar el tamaño y agrupar en pestañas los módulos dentro de ella, y puede abrir una segunda ventana del navegador en su otro monitor. Para ventanas emergentes reales que arrastre a una segunda pantalla, use la descarga de escritorio de Tradovate." },
    { type: "heading",text: "Organizar los módulos entre monitores: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Añada el módulo que quiere colocar", html: "Haga clic en el botón <strong class='text-white'>New</strong> (<strong class='text-white'>+</strong>) en la parte superior izquierda del espacio de trabajo para abrir la lista de módulos. Elija lo que necesite, Chart, SuperDOM, Order Ticket, Positions, etc., y suéltelo en el espacio de trabajo. Añada todos los módulos que piense organizar antes de empezar a moverlos, de modo que reorganice un diseño completo en lugar de construirlo pieza a pieza.", image: {"src":`${IMG}/tradovate-pop-out-modules-1.png`,"alt":"Espacio de trabajo de Tradovate con el botón New Plus abierto mostrando la lista de módulos que se pueden añadir"} },
        { title: "Muévalo y cambie su tamaño dentro del espacio de trabajo", html: "Haga clic y mantenga pulsada la pestaña de título del módulo en la parte superior y arrástrelo adonde quiera. Al arrastrar se iluminan zonas de colocación, de modo que puede acoplar el módulo contra el borde izquierdo, derecho, superior o inferior, o soltarlo en el centro de un panel existente. Suelte cuando el resaltado coincida con el lugar que busca. Agarre un borde o una esquina para cambiar el tamaño. Haga esto con cada módulo hasta que el diseño dentro de la ventana le convenza.", image: {"src":`${IMG}/tradovate-pop-out-modules-2.png`,"alt":"Arrastre de un módulo de Tradovate por su pestaña con una zona de colocación resaltada que muestra dónde se acoplará"} },
        { title: "Apile módulos en pestañas (opcional)", html: "¿Quiere varios gráficos en un mismo hueco sin ocupar espacio de pantalla? Arrastre un módulo directamente sobre otro y suéltelo en el centro del panel. Los dos compartirán el mismo sitio como pestañas entre las que puede hacer clic. Es útil para mantener, por ejemplo, tres temporalidades del mismo instrumento en una esquina mientras su DOM y su ticket permanecen en su sitio.", image: {"src":`${IMG}/tradovate-pop-out-modules-3.png`,"alt":"Dos módulos de gráfico de Tradovate agrupados como pestañas en las que se puede hacer clic dentro de un único panel"} },
        { title: "Saque un módulo a su propia ventana", html: "Esta es la parte que el navegador no puede hacer. En la aplicación de escritorio de Tradovate, haga clic en el <strong class='text-white'>nombre</strong> de un módulo para abrirlo como su propia ventana flotante en lugar de arrastrarlo dentro del espacio de trabajo. Cuando sea una ventana independiente, arrástrela a su segundo o tercer monitor y ajuste su tamaño para llenar la pantalla. Repita con cada módulo que quiera en otra pantalla: un gráfico grande en la pantalla izquierda, el SuperDOM y el order ticket justo en el centro, y posiciones e información de la cuenta a un lado.", image: {"src":`${IMG}/tradovate-pop-out-modules-4.png`,"alt":"Un módulo de Tradovate abierto como ventana de escritorio independiente y arrastrado a un segundo monitor"} },
        { title: "Guarde su workspace para que el diseño se mantenga", html: "Cuando sus pantallas estén como quiere, guarde la disposición. Abra el menú del workspace en la parte superior izquierda, dé al diseño un nombre claro y guárdelo. En el siguiente inicio de sesión, cargue ese workspace y su configuración volverá, en lugar de empezar con una cuadrícula en blanco. En la aplicación de escritorio, compruebe que sus ventanas independientes aparecen donde las dejó tras cargar, ya que las posiciones de las ventanas entre monitores pueden cambiar; devuelva a su sitio las que se hayan desviado.", image: {"src":`${IMG}/tradovate-pop-out-modules-5.png`,"alt":"Menú de workspace de Tradovate con un diseño con nombre guardándose para que la disposición multimonitor persista"} },
      ],
    },
    { type: "heading",text: "Mantenga limpio su diseño multimonitor" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Ponga nombre a los workspaces según su propósito</strong>, scalping, swing, noticias, para cambiar todo el tablero con un clic.",
        "<strong class='text-white'>Ponga las manos donde está la acción</strong>, mantenga el DOM y el order ticket en su pantalla principal y envíe los gráficos de referencia a los monitores laterales.",
        "<strong class='text-white'>¿Ha perdido una ventana?</strong> Si una ventana extraída queda detrás de otra, use los controles de ventana de su sistema operativo (o la barra de tareas) para traerla al frente.",
        "<strong class='text-white'>Combínelo con atajos de teclado</strong>, un diseño repartido más atajos significa menos viajes del ratón entre tres pantallas.",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Un buen diseño multimonitor es genial para vigilar el mercado, pero no tiene por qué estar pegado a él. <strong class='text-white'>PickMyTrade enruta sus alertas de TradingView directamente a su cuenta de Tradovate</strong>, de modo que su estrategia se ejecuta sola mientras sus pantallas solo confirman lo que ocurre." },
  ], fr: [
    { type: "paragraph",html: "Si vous tradez sur plus d’un écran, entasser chaque graphique, échelle et ticket d’ordre dans une seule fenêtre devient vite pénible. Tradovate vous permet de détacher des modules, de les déposer où vous voulez et de répartir votre configuration sur plusieurs moniteurs. Voici comment procéder proprement, ainsi que le point qui piège beaucoup d’utilisateurs : la version web et l’application de bureau ne se comportent pas de la même façon." },
    { type: "heading",text: "Web Trader ou application de bureau : ce qui s’étend réellement sur plusieurs moniteurs" },
    { type: "paragraph",html: "Le Tradovate Web Trader s’exécute dans un seul onglet de navigateur ; un module ne peut donc pas quitter physiquement cette fenêtre. Vous pouvez néanmoins y ajouter, réorganiser, redimensionner et regrouper des modules en onglets, et vous pouvez ouvrir une seconde fenêtre de navigateur sur votre autre moniteur. Pour de vraies fenêtres détachées que vous faites glisser sur un second écran, utilisez le téléchargement de bureau Tradovate." },
    { type: "heading",text: "Organiser les modules sur plusieurs moniteurs : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ajoutez le module que vous voulez placer", html: "Cliquez sur le bouton <strong class='text-white'>New</strong> (<strong class='text-white'>+</strong>) en haut à gauche de l’espace de travail pour ouvrir la liste des modules. Choisissez ce dont vous avez besoin, Chart, SuperDOM, Order Ticket, Positions, etc., puis déposez-le dans l’espace de travail. Ajoutez tous les modules que vous comptez organiser avant de commencer à les déplacer, afin de réarranger une disposition complète plutôt que de la construire pièce par pièce.", image: {"src":`${IMG}/tradovate-pop-out-modules-1.png`,"alt":"Espace de travail Tradovate avec le bouton New Plus ouvert affichant la liste des modules à ajouter"} },
        { title: "Déplacez-le et redimensionnez-le dans l’espace de travail", html: "Cliquez sur l’onglet de titre du module en haut, maintenez le clic, puis faites-le glisser où vous le souhaitez. Des zones de dépôt s’illuminent pendant le glissement : vous pouvez ancrer le module contre le bord gauche, droit, supérieur ou inférieur, ou le déposer au centre d’un volet existant. Relâchez lorsque la surbrillance correspond à l’emplacement voulu. Saisissez un bord ou un coin pour redimensionner. Faites-le pour chaque module jusqu’à ce que la disposition dans la fenêtre vous convienne.", image: {"src":`${IMG}/tradovate-pop-out-modules-2.png`,"alt":"Glissement d’un module Tradovate par son onglet avec une zone de dépôt en surbrillance indiquant où il s’ancrera"} },
        { title: "Empilez des modules en onglets (facultatif)", html: "Vous voulez plusieurs graphiques dans un seul emplacement sans prendre de place à l’écran ? Faites glisser un module directement sur un autre et relâchez au centre du volet. Les deux partagent alors le même emplacement sous forme d’onglets entre lesquels vous cliquez. C’est pratique pour garder, par exemple, trois unités de temps du même instrument dans un coin pendant que votre DOM et votre ticket restent en place.", image: {"src":`${IMG}/tradovate-pop-out-modules-3.png`,"alt":"Deux modules de graphique Tradovate regroupés en onglets cliquables dans un seul volet"} },
        { title: "Détachez un module dans sa propre fenêtre", html: "C’est la partie que le navigateur ne sait pas faire. Dans l’application de bureau Tradovate, cliquez sur le <strong class='text-white'>nom</strong> d’un module pour l’ouvrir comme fenêtre flottante distincte au lieu de le faire glisser dans l’espace de travail. Une fois devenu une fenêtre autonome, faites-le glisser sur votre deuxième ou troisième moniteur et dimensionnez-le pour remplir l’écran. Répétez l’opération pour chaque module que vous voulez sur un autre écran : un grand graphique sur l’écran de gauche, le SuperDOM et l’order ticket au centre, les positions et les informations de compte sur le côté.", image: {"src":`${IMG}/tradovate-pop-out-modules-4.png`,"alt":"Un module Tradovate ouvert comme fenêtre de bureau distincte et glissé sur un second moniteur"} },
        { title: "Enregistrez votre workspace pour que la disposition soit conservée", html: "Une fois vos écrans bien disposés, enregistrez l’agencement. Ouvrez le menu du workspace en haut à gauche, donnez un nom clair à la disposition et enregistrez-la. À la prochaine connexion, chargez ce workspace et votre configuration revient, au lieu de repartir d’une grille vide. Dans l’application de bureau, vérifiez après le chargement que vos fenêtres distinctes se placent là où vous les avez laissées, car les positions des fenêtres d’un moniteur à l’autre peuvent bouger ; replacez celles qui se sont égarées.", image: {"src":`${IMG}/tradovate-pop-out-modules-5.png`,"alt":"Menu workspace de Tradovate avec une disposition nommée en cours d’enregistrement afin que l’agencement multi-moniteurs soit conservé"} },
      ],
    },
    { type: "heading",text: "Gardez votre disposition multi-moniteurs propre" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Nommez vos workspaces selon leur usage</strong>, scalping, swing, actualités, pour changer tout le tableau en un clic.",
        "<strong class='text-white'>Placez vos mains là où se passe l’action</strong>, gardez le DOM et l’order ticket sur votre écran principal et reléguez les graphiques de référence sur les moniteurs latéraux.",
        "<strong class='text-white'>Une fenêtre perdue ?</strong> Si une fenêtre détachée passe derrière une autre, utilisez les commandes de fenêtre de votre système d’exploitation (ou la barre des tâches) pour la ramener au premier plan.",
        "<strong class='text-white'>Associez-la aux raccourcis clavier</strong>, une disposition étalée plus des raccourcis clavier, c’est moins d’allers-retours de souris sur trois écrans.",
      ],
    },
