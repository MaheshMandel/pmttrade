---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-oso-orders";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Place One-Sends-Other (OSO) Orders in Tradovate";
const META_DESCRIPTION =
  "Place an OSO (One-Sends-Other) order on the SuperDOM so a filled primary order automatically triggers its linked dependent order at a second price.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "One-Sends-Other-Orders (OSO) in Tradovate platzieren", es: "Cómo colocar órdenes One-Sends-Other (OSO) en Tradovate", fr: "Passer des ordres One-Sends-Other (OSO) dans Tradovate", it: "Inserire ordini One-Sends-Other (OSO) in Tradovate" },
  dek: { en: "Sometimes you don't want an order live yet. You want it to sit quiet and wake up only after something else happens first, your entry fills, and only then does a second order go to work. That's a One-Sends-Other order.", de: "Manchmal soll eine Order noch nicht aktiv sein. Sie soll ruhig warten und erst aufwachen, nachdem zuerst etwas anderes passiert ist: Ihr Einstieg wird ausgeführt, und erst dann geht eine zweite Order an den Start. Genau das ist eine One-Sends-Other-Order.", es: "A veces no quiere que una orden esté activa todavía. Quiere que espere en silencio y se active solo después de que ocurra otra cosa primero: se ejecuta su entrada y solo entonces se envía una segunda orden. Eso es una orden One-Sends-Other.", fr: "Parfois, vous ne voulez pas qu’un ordre soit actif tout de suite. Vous voulez qu’il reste en sommeil et ne se réveille qu’après qu’autre chose s’est produit : votre entrée est exécutée, et seulement alors un second ordre entre en jeu. C’est un ordre One-Sends-Other.", it: "A volte non vuole che un ordine sia ancora attivo. Vuole che resti in silenzio e si attivi solo dopo che è accaduto qualcos’altro: il suo ingresso viene eseguito e solo allora parte un secondo ordine. Questo è un ordine One-Sends-Other." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Sometimes you don't want an order live yet. You want it to sit quiet and wake up only <em>after</em> something else happens first, your entry fills, and only then does a second order go to work. That's what a One-Sends-Other order does, and Tradovate lets you build one right on the SuperDOM ladder." },
    { type: "paragraph", html: "<strong class='text-white'>OSO</strong> stands for <strong class='text-white'>One-Sends-Other</strong> (you'll also see it called Order-Sends-Order). You place a primary order and attach a single dependent order to it. The dependent one stays parked and suspended until the primary <em>fully fills</em>, then Tradovate releases it into the market. The fill is the trigger; no watching the screen for it." },
    { type: "heading", text: "OSO vs. OCO vs. ATM, Don't Mix Them Up" },
    { type: "paragraph", html: "These three get tangled together all the time, so here's the clean version:" },
    {
      type: "table",
      headers: ["Order type", "What it does"],
      rows: [
        ["OSO (One-Sends-Other)", "A filled primary order sends a dependent order. Sequential, the second one only exists after the first fills."],
        ["OCO (One-Cancels-Other)", "Two live orders linked so that when one fills, the other is cancelled. Used for a stop and a target together."],
        ["ATM Strategy", "A saved preset that drops a full stop-and-target bracket automatically the instant your entry fills."],
      ],
    },
    { type: "paragraph", html: "Lock this in: one-time OSO links <strong class='text-white'>one</strong> dependent order, not a whole bracket. Want a stop <em>and</em> a target on your entry? That's an ATM Strategy. OSO is for a single follow-on order, a scale-in, a fresh stop, a re-entry, that shouldn't exist until the first one is done." },
    { type: "heading", text: "How to Place a One-Time OSO on the SuperDOM" },
    { type: "paragraph", html: "Heads up before you start: at the time of writing, one-time OSO lives in the <strong class='text-white'>SuperDOM module of the Tradovate Web App</strong>. If you're new to the ladder itself, get comfortable clicking in orders on the SuperDOM before you try chaining them." },
    {
      type: "steps",
      items: [
        { title: "Open the SuperDOM for Your Contract", html: "Pull up the <strong class='text-white'>SuperDOM</strong> for the exact contract you're trading, right symbol, right expiry. Everything below happens on this ladder, so get it loaded and confirm the price is live before you arm anything." },
        { title: 'Select "OSO One-Time" from the ATM Dropdown', html: "Look at the bottom of the SuperDOM for the <strong class='text-white'>ATM dropdown</strong>. Open it and choose <strong class='text-white'>OSO One-Time</strong>. That arms the ladder, the next two orders you click in get linked as a One-Sends-Other pair instead of firing off independently. Nothing's submitted yet; you've just told Tradovate to connect what comes next." },
        { title: "Place Your Primary Order", html: "Click the price level where you want your <strong class='text-white'>primary (trigger) order</strong> to work. On the ladder, a <strong class='text-white'>left-click stages a limit</strong> and a <strong class='text-white'>right-click stages a stop</strong>, pick whichever fits your entry. This first order is a normal working order and can fill as soon as the market reaches it." },
        { title: "Attach the Dependent Order", html: "Now click the second price level, this is your <strong class='text-white'>dependent order</strong>, the one that should only go live after the primary fills. It shows up with a <strong class='text-white'>plus (+) marker</strong> next to the quantity. That plus means it's suspended: it will <em>not</em> be sent to the exchange until the primary order fully fills, even if price runs right through that level in the meantime. Order it however you need, a stop below your entry, a scale-in limit, whatever the plan calls for." },
        { title: "Confirm the Trigger and Re-Arm if Needed", html: "Glance at the <strong class='text-white'>Orders</strong> panel. You should see the primary listed as working and the dependent sitting as suspended. When the primary fills, Tradovate releases the dependent into the market on its own. One catch worth remembering: <strong class='text-white'>OSO one-time only lasts for that single pair</strong>, you have to re-select OSO One-Time from the ATM dropdown before you set up the next one." },
      ],
    },
    { type: "heading", text: "Gotchas Worth Knowing" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Place the two orders in sequence.</strong> Arm OSO One-Time, place the primary, then place the dependent. If you click somewhere else in the SuperDOM or the web app between the two, or wait too long, the OSO can quietly switch itself off, and you'll have to arm it again.",
        "<strong class='text-white'>Fill the primary before you attach the dependent and it can get rejected.</strong> If the trigger order has already filled by the time you click the dependent, there's nothing left to trigger it, so the dependent may be rejected. Set both up promptly.",
        "<strong class='text-white'>It's one dependent order, not a bracket.</strong> One-time OSO links a single follow-on order. Want a linked stop and target on your fill instead? Use an ATM Strategy, or attach a one-time OCO to the position after it opens.",
        "<strong class='text-white'>Prop-firm accounts have their own rules.</strong> Some firms require a stop on every position and cap your size or contract count. Those limits vary by firm and account size, check your firm's current rules before you build any workflow around them.",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Chaining orders by hand only works while you're watching the ladder. <strong class='text-white'>PickMyTrade routes your TradingView alerts straight into Tradovate</strong> and sends your entries and follow-on orders automatically, so the second leg lands the instant the first fills, whether you're at the screen or not." },
  ], de: [
    { type: "paragraph",html: "Manchmal soll eine Order noch nicht aktiv sein. Sie soll ruhig warten und erst aufwachen, <em>nachdem</em> zuerst etwas anderes passiert ist: Ihr Einstieg wird ausgeführt, und erst dann geht eine zweite Order an den Start. Genau das leistet eine One-Sends-Other-Order, und Tradovate lässt Sie eine solche direkt auf der SuperDOM-Leiter erstellen." },
    { type: "paragraph",html: "<strong class='text-white'>OSO</strong> steht für <strong class='text-white'>One-Sends-Other</strong> (auch als Order-Sends-Order bekannt). Sie platzieren eine Primärorder und hängen ihr eine einzelne abhängige Order an. Die abhängige Order bleibt geparkt und ausgesetzt, bis die Primärorder <em>vollständig ausgeführt</em> ist, dann gibt Tradovate sie in den Markt frei. Die Ausführung ist der Auslöser, Sie müssen den Bildschirm nicht beobachten." },
    { type: "heading",text: "OSO vs. OCO vs. ATM: Nicht verwechseln" },
    { type: "paragraph",html: "Diese drei werden ständig durcheinandergebracht, hier die klare Version:" },
    { type: "table", headers: ["Ordertyp","Was sie bewirkt"], rows: [
      ["OSO (One-Sends-Other)","Eine ausgeführte Primärorder sendet eine abhängige Order. Sequenziell: Die zweite existiert erst, nachdem die erste ausgeführt wurde."],
      ["OCO (One-Cancels-Other)","Zwei aktive Orders, die so verknüpft sind, dass die andere storniert wird, sobald eine ausgeführt wird. Wird für Stop und Kursziel gemeinsam verwendet."],
      ["ATM Strategy","Eine gespeicherte Vorlage, die in dem Moment, in dem Ihr Einstieg ausgeführt wird, automatisch ein komplettes Stop-und-Target-Bracket platziert."],
    ] },
    { type: "paragraph",html: "Merken Sie sich: Ein einmaliges OSO verknüpft <strong class='text-white'>eine</strong> abhängige Order, nicht ein ganzes Bracket. Möchten Sie einen Stop <em>und</em> ein Kursziel für Ihren Einstieg? Dann ist das eine ATM Strategy. OSO ist für eine einzelne Folgeorder gedacht, etwa eine Aufstockung, einen neuen Stop oder einen Wiedereinstieg, die erst existieren soll, wenn die erste erledigt ist." },
    { type: "heading",text: "So platzieren Sie ein einmaliges OSO im SuperDOM" },
    { type: "paragraph",html: "Vorab ein Hinweis: Zum Zeitpunkt der Erstellung befindet sich das einmalige OSO im <strong class='text-white'>SuperDOM-Modul der Tradovate Web App</strong>. Wenn Ihnen die Leiter selbst noch neu ist, machen Sie sich damit vertraut, Orders im SuperDOM per Klick zu platzieren, bevor Sie versuchen, sie zu verketten." },
    {
      type: "steps",
      items: [
        { title: "Das SuperDOM für Ihren Kontrakt öffnen", html: "Öffnen Sie das <strong class='text-white'>SuperDOM</strong> für genau den Kontrakt, den Sie handeln: richtiges Symbol, richtiger Verfall. Alles Weitere geschieht auf dieser Leiter. Laden Sie sie also und vergewissern Sie sich, dass der Kurs live ist, bevor Sie etwas scharf schalten." },
        { title: "„OSO One-Time“ im ATM-Dropdown auswählen", html: "Suchen Sie am unteren Rand des SuperDOM das <strong class='text-white'>ATM-Dropdown</strong>. Öffnen Sie es und wählen Sie <strong class='text-white'>OSO One-Time</strong>. Damit wird die Leiter scharf geschaltet: Die nächsten beiden Orders, die Sie anklicken, werden als One-Sends-Other-Paar verknüpft, statt unabhängig abgeschickt zu werden. Noch wird nichts gesendet; Sie haben Tradovate nur mitgeteilt, dass es verbinden soll, was als Nächstes kommt." },
        { title: "Primärorder platzieren", html: "Klicken Sie auf das Preisniveau, auf dem Ihre <strong class='text-white'>Primärorder (Auslöser)</strong> aktiv sein soll. Auf der Leiter <strong class='text-white'>platziert ein Linksklick ein Limit</strong> und <strong class='text-white'>ein Rechtsklick einen Stop</strong>. Wählen Sie, was zu Ihrem Einstieg passt. Diese erste Order ist eine normale aktive Order und kann ausgeführt werden, sobald der Markt sie erreicht." },
        { title: "Die abhängige Order anhängen", html: "Klicken Sie nun auf das zweite Preisniveau. Dies ist Ihre <strong class='text-white'>abhängige Order</strong>, die erst aktiv werden soll, nachdem die Primärorder ausgeführt wurde. Sie erscheint mit einem <strong class='text-white'>Plus-Symbol (+)</strong> neben der Menge. Dieses Plus bedeutet, dass sie ausgesetzt ist: Sie wird <em>nicht</em> an die Börse gesendet, bevor die Primärorder vollständig ausgeführt ist, selbst wenn der Kurs in der Zwischenzeit durch dieses Niveau läuft. Gestalten Sie sie nach Bedarf: ein Stop unter Ihrem Einstieg, ein Limit zum Aufstocken, was auch immer Ihr Plan verlangt." },
        { title: "Den Auslöser bestätigen und bei Bedarf neu scharf schalten", html: "Werfen Sie einen Blick auf das Panel <strong class='text-white'>Orders</strong>. Die Primärorder sollte als aktiv aufgeführt sein und die abhängige als ausgesetzt. Sobald die Primärorder ausgeführt ist, gibt Tradovate die abhängige Order von selbst in den Markt frei. Ein wichtiger Punkt: <strong class='text-white'>Das einmalige OSO gilt nur für dieses eine Paar</strong>, Sie müssen OSO One-Time im ATM-Dropdown erneut auswählen, bevor Sie das nächste einrichten." },
      ],
    },
    { type: "heading",text: "Wichtige Stolperfallen" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Platzieren Sie die beiden Orders nacheinander.</strong> Schalten Sie OSO One-Time scharf, platzieren Sie die Primärorder und dann die abhängige. Klicken Sie zwischen den beiden woanders ins SuperDOM oder in die Web App oder warten Sie zu lange, kann sich das OSO stillschweigend abschalten, und Sie müssen es erneut scharf schalten.",
        "<strong class='text-white'>Wird die Primärorder ausgeführt, bevor Sie die abhängige anhängen, kann sie abgelehnt werden.</strong> Wurde die Auslöserorder bereits ausgeführt, wenn Sie die abhängige anklicken, gibt es nichts mehr, was sie auslöst, sodass die abhängige Order abgelehnt werden kann. Richten Sie beide zügig ein.",
        "<strong class='text-white'>Es ist eine abhängige Order, kein Bracket.</strong> Ein einmaliges OSO verknüpft eine einzelne Folgeorder. Möchten Sie stattdessen einen verknüpften Stop und ein Kursziel für Ihre Ausführung? Verwenden Sie eine ATM Strategy oder hängen Sie ein einmaliges OCO an die Position an, nachdem sie eröffnet wurde.",
        "<strong class='text-white'>Prop-Firm-Konten haben eigene Regeln.</strong> Manche Firmen verlangen für jede Position einen Stop und begrenzen Ihre Größe oder Kontraktzahl. Diese Limits variieren je nach Firma und Kontogröße. Prüfen Sie die aktuellen Regeln Ihrer Firma, bevor Sie einen Ablauf darauf aufbauen.",
      ],
    },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "Orders von Hand zu verketten funktioniert nur, solange Sie die Leiter im Blick haben. <strong class='text-white'>PickMyTrade leitet Ihre TradingView-Alerts direkt an Tradovate weiter</strong> und sendet Ihre Einstiege und Folgeorders automatisch, sodass das zweite Bein in dem Moment landet, in dem das erste ausgeführt wird, ob Sie am Bildschirm sind oder nicht." },
  ], es: [
    { type: "paragraph",html: "A veces no quiere que una orden esté activa todavía. Quiere que espere en silencio y se active solo <em>después</em> de que ocurra otra cosa primero: se ejecuta su entrada y solo entonces se envía una segunda orden. Eso es lo que hace una orden One-Sends-Other, y Tradovate le permite crear una directamente en la escalera del SuperDOM." },
    { type: "paragraph",html: "<strong class='text-white'>OSO</strong> significa <strong class='text-white'>One-Sends-Other</strong> (también la verá llamada Order-Sends-Order). Usted coloca una orden principal y le asocia una única orden dependiente. La dependiente permanece aparcada y suspendida hasta que la principal se <em>ejecuta por completo</em>; entonces Tradovate la libera al mercado. La ejecución es el disparador; no hace falta vigilar la pantalla." },
    { type: "heading",text: "OSO vs. OCO vs. ATM: no los confunda" },
    { type: "paragraph",html: "Estos tres se mezclan constantemente, así que aquí va la versión clara:" },
    { type: "table", headers: ["Tipo de orden","Qué hace"], rows: [
      ["OSO (One-Sends-Other)","Una orden principal ejecutada envía una orden dependiente. Es secuencial: la segunda solo existe después de que se ejecuta la primera."],
      ["OCO (One-Cancels-Other)","Dos órdenes activas vinculadas de modo que, cuando una se ejecuta, la otra se cancela. Se usa para un stop y un objetivo a la vez."],
      ["ATM Strategy","Un preajuste guardado que coloca automáticamente un bracket completo de stop y objetivo en el instante en que se ejecuta su entrada."],
    ] },
    { type: "paragraph",html: "Tenga esto claro: el OSO de una sola vez vincula <strong class='text-white'>una</strong> orden dependiente, no un bracket completo. ¿Quiere un stop <em>y</em> un objetivo en su entrada? Eso es una ATM Strategy. OSO sirve para una única orden posterior, como un escalado, un nuevo stop o una reentrada, que no debería existir hasta que termine la primera." },
    { type: "heading",text: "Cómo colocar un OSO de una sola vez en el SuperDOM" },
    { type: "paragraph",html: "Una advertencia antes de empezar: en el momento de escribir esto, el OSO de una sola vez se encuentra en el <strong class='text-white'>módulo SuperDOM de la Tradovate Web App</strong>. Si la escalera es nueva para usted, familiarícese con colocar órdenes con un clic en el SuperDOM antes de intentar encadenarlas." },
    {
      type: "steps",
      items: [
        { title: "Abra el SuperDOM de su contrato", html: "Abra el <strong class='text-white'>SuperDOM</strong> del contrato exacto que opera: símbolo correcto, vencimiento correcto. Todo lo que sigue ocurre en esta escalera, así que cárguela y confirme que el precio está en vivo antes de armar nada." },
        { title: "Seleccione “OSO One-Time” en el menú desplegable ATM", html: "Busque en la parte inferior del SuperDOM el <strong class='text-white'>menú desplegable ATM</strong>. Ábralo y elija <strong class='text-white'>OSO One-Time</strong>. Eso arma la escalera: las dos órdenes siguientes que haga clic se vincularán como un par One-Sends-Other en lugar de enviarse de forma independiente. Todavía no se ha enviado nada; solo le ha indicado a Tradovate que conecte lo que viene a continuación." },
        { title: "Coloque su orden principal", html: "Haga clic en el nivel de precio donde quiere que actúe su <strong class='text-white'>orden principal (disparadora)</strong>. En la escalera, <strong class='text-white'>un clic izquierdo prepara un límite</strong> y <strong class='text-white'>un clic derecho prepara un stop</strong>; elija el que se ajuste a su entrada. Esta primera orden es una orden activa normal y puede ejecutarse en cuanto el mercado la alcance." },
        { title: "Asocie la orden dependiente", html: "Ahora haga clic en el segundo nivel de precio: esta es su <strong class='text-white'>orden dependiente</strong>, la que solo debe activarse después de que se ejecute la principal. Aparece con un <strong class='text-white'>marcador de más (+)</strong> junto a la cantidad. Ese más significa que está suspendida: <em>no</em> se enviará al mercado hasta que la orden principal se ejecute por completo, aunque el precio atraviese ese nivel mientras tanto. Configúrela como necesite: un stop por debajo de su entrada, un límite de escalado, lo que pida su plan." },
        { title: "Confirme el disparador y vuelva a armar si es necesario", html: "Eche un vistazo al panel <strong class='text-white'>Orders</strong>. Debería ver la principal como activa y la dependiente como suspendida. Cuando la principal se ejecuta, Tradovate libera la dependiente al mercado por sí solo. Un detalle que conviene recordar: <strong class='text-white'>el OSO de una sola vez solo dura para ese único par</strong>; debe volver a seleccionar OSO One-Time en el menú desplegable ATM antes de configurar el siguiente." },
      ],
    },
    { type: "heading",text: "Detalles que conviene conocer" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Coloque las dos órdenes en secuencia.</strong> Arme OSO One-Time, coloque la principal y después la dependiente. Si hace clic en otra parte del SuperDOM o de la aplicación web entre las dos, o tarda demasiado, el OSO puede desactivarse sin avisar y tendrá que armarlo de nuevo.",
        "<strong class='text-white'>Si se ejecuta la principal antes de asociar la dependiente, esta puede ser rechazada.</strong> Si la orden disparadora ya se ejecutó cuando hace clic en la dependiente, no queda nada que la dispare, por lo que la dependiente puede ser rechazada. Configure ambas con rapidez.",
        "<strong class='text-white'>Es una orden dependiente, no un bracket.</strong> El OSO de una sola vez vincula una única orden posterior. ¿Quiere en cambio un stop y un objetivo vinculados a su ejecución? Use una ATM Strategy o asocie un OCO de una sola vez a la posición después de que se abra.",
        "<strong class='text-white'>Las cuentas de prop firms tienen sus propias reglas.</strong> Algunas firmas exigen un stop en cada posición y limitan su tamaño o número de contratos. Esos límites varían según la firma y el tamaño de la cuenta; compruebe las reglas vigentes de su firma antes de construir cualquier flujo de trabajo en torno a ellos.",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Encadenar órdenes a mano solo funciona mientras vigila la escalera. <strong class='text-white'>PickMyTrade envía sus alertas de TradingView directamente a Tradovate</strong> y manda sus entradas y órdenes posteriores automáticamente, para que la segunda pata llegue en el instante en que se ejecuta la primera, esté o no frente a la pantalla." },
  ], fr: [
    { type: "paragraph",html: "Parfois, vous ne voulez pas qu’un ordre soit actif tout de suite. Vous voulez qu’il reste en sommeil et ne se réveille qu’<em>après</em> qu’autre chose s’est produit : votre entrée est exécutée, et seulement alors un second ordre entre en jeu. C’est ce que fait un ordre One-Sends-Other, et Tradovate vous permet d’en créer un directement sur l’échelle du SuperDOM." },
    { type: "paragraph",html: "<strong class='text-white'>OSO</strong> signifie <strong class='text-white'>One-Sends-Other</strong> (vous le verrez aussi appelé Order-Sends-Order). Vous passez un ordre principal et vous lui rattachez un seul ordre dépendant. L’ordre dépendant reste en attente et suspendu jusqu’à ce que l’ordre principal soit <em>entièrement exécuté</em>, puis Tradovate le libère sur le marché. L’exécution est le déclencheur ; inutile de surveiller l’écran." },
    { type: "heading",text: "OSO, OCO et ATM : ne les confondez pas" },
    { type: "paragraph",html: "Ces trois notions sont sans cesse mélangées ; voici la version claire :" },
    { type: "table", headers: ["Type d’ordre","Ce qu’il fait"], rows: [
      ["OSO (One-Sends-Other)","Un ordre principal exécuté envoie un ordre dépendant. Séquentiel : le second n’existe qu’une fois le premier exécuté."],
      ["OCO (One-Cancels-Other)","Deux ordres actifs liés de sorte que, lorsque l’un est exécuté, l’autre est annulé. Utilisé pour un stop et un objectif ensemble."],
      ["ATM Strategy","Un préréglage enregistré qui place automatiquement un bracket complet stop et objectif à l’instant où votre entrée est exécutée."],
    ] },
    { type: "paragraph",html: "Retenez bien : l’OSO ponctuel lie <strong class='text-white'>un</strong> ordre dépendant, pas un bracket entier. Vous voulez un stop <em>et</em> un objectif sur votre entrée ? C’est une ATM Strategy. L’OSO sert pour un seul ordre de suite, un renforcement, un nouveau stop, une ré-entrée, qui ne doit exister qu’une fois le premier terminé." },
    { type: "heading",text: "Comment passer un OSO ponctuel sur le SuperDOM" },
    { type: "paragraph",html: "Une précision avant de commencer : au moment de la rédaction, l’OSO ponctuel se trouve dans le <strong class='text-white'>module SuperDOM de la Tradovate Web App</strong>. Si l’échelle elle-même est nouvelle pour vous, familiarisez-vous avec la saisie d’ordres au clic sur le SuperDOM avant d’essayer de les enchaîner." },
    {
      type: "steps",
      items: [
        { title: "Ouvrir le SuperDOM de votre contrat", html: "Ouvrez le <strong class='text-white'>SuperDOM</strong> du contrat exact que vous tradez : bon symbole, bonne échéance. Tout ce qui suit se passe sur cette échelle ; chargez-la donc et vérifiez que le prix est en direct avant d’armer quoi que ce soit." },
        { title: "Sélectionner « OSO One-Time » dans la liste déroulante ATM", html: "Repérez en bas du SuperDOM la <strong class='text-white'>liste déroulante ATM</strong>. Ouvrez-la et choisissez <strong class='text-white'>OSO One-Time</strong>. Cela arme l’échelle : les deux prochains ordres sur lesquels vous cliquez seront liés en paire One-Sends-Other au lieu d’être envoyés indépendamment. Rien n’est encore soumis ; vous avez simplement indiqué à Tradovate de relier ce qui suit." },
        { title: "Passer votre ordre principal", html: "Cliquez sur le niveau de prix où vous voulez que votre <strong class='text-white'>ordre principal (déclencheur)</strong> soit actif. Sur l’échelle, <strong class='text-white'>un clic gauche prépare un ordre à cours limité</strong> et <strong class='text-white'>un clic droit prépare un stop</strong> ; choisissez celui qui convient à votre entrée. Ce premier ordre est un ordre actif normal et peut être exécuté dès que le marché l’atteint." },
        { title: "Rattacher l’ordre dépendant", html: "Cliquez maintenant sur le second niveau de prix : c’est votre <strong class='text-white'>ordre dépendant</strong>, celui qui ne doit devenir actif qu’après l’exécution de l’ordre principal. Il apparaît avec un <strong class='text-white'>marqueur plus (+)</strong> à côté de la quantité. Ce plus signifie qu’il est suspendu : il ne sera <em>pas</em> envoyé à la bourse tant que l’ordre principal n’est pas entièrement exécuté, même si le prix traverse ce niveau entre-temps. Réglez-le comme il vous convient : un stop sous votre entrée, un ordre à cours limité de renforcement, selon votre plan." },
        { title: "Confirmer le déclencheur et réarmer si nécessaire", html: "Jetez un œil au panneau <strong class='text-white'>Orders</strong>. Vous devriez voir l’ordre principal actif et l’ordre dépendant suspendu. Lorsque l’ordre principal est exécuté, Tradovate libère l’ordre dépendant sur le marché de lui-même. Un point à retenir : <strong class='text-white'>l’OSO ponctuel ne vaut que pour cette seule paire</strong> ; vous devez sélectionner de nouveau OSO One-Time dans la liste déroulante ATM avant de configurer la suivante." },
      ],
    },
    { type: "heading",text: "Pièges à connaître" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Passez les deux ordres à la suite.</strong> Armez OSO One-Time, passez l’ordre principal, puis l’ordre dépendant. Si vous cliquez ailleurs dans le SuperDOM ou l’application web entre les deux, ou si vous attendez trop longtemps, l’OSO peut se désactiver discrètement et il faudra le réarmer.",
        "<strong class='text-white'>Si l’ordre principal est exécuté avant que vous rattachiez l’ordre dépendant, celui-ci peut être rejeté.</strong> Si l’ordre déclencheur est déjà exécuté au moment où vous cliquez sur l’ordre dépendant, plus rien ne peut le déclencher, et l’ordre dépendant peut donc être rejeté. Configurez les deux rapidement.",
        "<strong class='text-white'>C’est un seul ordre dépendant, pas un bracket.</strong> L’OSO ponctuel lie un seul ordre de suite. Vous voulez plutôt un stop et un objectif liés à votre exécution ? Utilisez une ATM Strategy, ou rattachez un OCO ponctuel à la position après son ouverture.",
        "<strong class='text-white'>Les comptes de prop firm ont leurs propres règles.</strong> Certaines firmes exigent un stop sur chaque position et plafonnent votre taille ou votre nombre de contrats. Ces limites varient selon la firme et la taille du compte ; vérifiez les règles en vigueur de votre firme avant de construire un workflow autour d’elles.",
      ],
    },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Enchaîner des ordres à la main ne fonctionne que tant que vous surveillez l’échelle. <strong class='text-white'>PickMyTrade achemine vos alertes TradingView directement vers Tradovate</strong> et envoie automatiquement vos entrées et vos ordres de suite, pour que la seconde jambe arrive à l’instant où la première est exécutée, que vous soyez devant l’écran ou non." },
  ], it: [
    { type: "paragraph",html: "A volte non vuole che un ordine sia ancora attivo. Vuole che resti in silenzio e si attivi solo <em>dopo</em> che è accaduto qualcos’altro: il suo ingresso viene eseguito e solo allora parte un secondo ordine. È ciò che fa un ordine One-Sends-Other, e Tradovate le permette di crearne uno direttamente sulla ladder del SuperDOM." },
    { type: "paragraph",html: "<strong class='text-white'>OSO</strong> sta per <strong class='text-white'>One-Sends-Other</strong> (lo troverà chiamato anche Order-Sends-Order). Lei inserisce un ordine primario e gli collega un singolo ordine dipendente. L’ordine dipendente resta parcheggiato e sospeso finché il primario non è <em>eseguito per intero</em>, poi Tradovate lo rilascia nel mercato. L’esecuzione è il trigger: non serve controllare lo schermo." },
    { type: "heading",text: "OSO vs. OCO vs. ATM: non li confonda" },
    { type: "paragraph",html: "Questi tre vengono continuamente confusi, ecco la versione chiara:" },
    { type: "table", headers: ["Tipo di ordine","Cosa fa"], rows: [
      ["OSO (One-Sends-Other)","Un ordine primario eseguito invia un ordine dipendente. Sequenziale: il secondo esiste solo dopo che il primo è stato eseguito."],
      ["OCO (One-Cancels-Other)","Due ordini attivi collegati in modo che, quando uno viene eseguito, l’altro viene annullato. Usato per uno stop e un target insieme."],
      ["ATM Strategy","Un preset salvato che inserisce automaticamente un bracket completo di stop e target nell’istante in cui il suo ingresso viene eseguito."],
    ] },
    { type: "paragraph",html: "Si fissi bene questo: l’OSO una tantum collega <strong class='text-white'>un</strong> ordine dipendente, non un intero bracket. Vuole uno stop <em>e</em> un target sul suo ingresso? Quella è una ATM Strategy. L’OSO serve per un singolo ordine successivo, un incremento, un nuovo stop, un rientro, che non dovrebbe esistere finché il primo non è concluso." },
    { type: "heading",text: "Come inserire un OSO una tantum sul SuperDOM" },
    { type: "paragraph",html: "Un avvertimento prima di iniziare: al momento della stesura, l’OSO una tantum si trova nel <strong class='text-white'>modulo SuperDOM della Tradovate Web App</strong>. Se la ladder stessa è nuova per lei, prenda confidenza con l’inserimento di ordini a clic sul SuperDOM prima di provare a concatenarli." },
    {
      type: "steps",
      items: [
        { title: "Aprire il SuperDOM per il suo contratto", html: "Apra il <strong class='text-white'>SuperDOM</strong> per l’esatto contratto che sta operando: simbolo giusto, scadenza giusta. Tutto ciò che segue avviene su questa ladder, quindi la carichi e confermi che il prezzo sia live prima di armare qualsiasi cosa." },
        { title: "Selezionare “OSO One-Time” dal menu a discesa ATM", html: "Cerchi in basso nel SuperDOM il <strong class='text-white'>menu a discesa ATM</strong>. Lo apra e scelga <strong class='text-white'>OSO One-Time</strong>. Questo arma la ladder: i due ordini successivi su cui fa clic verranno collegati come coppia One-Sends-Other invece di partire in modo indipendente. Non è ancora stato inviato nulla; ha solo detto a Tradovate di collegare ciò che viene dopo." },
        { title: "Inserire l’ordine primario", html: "Faccia clic sul livello di prezzo in cui vuole che lavori il suo <strong class='text-white'>ordine primario (trigger)</strong>. Sulla ladder, <strong class='text-white'>un clic sinistro prepara un limite</strong> e <strong class='text-white'>un clic destro prepara uno stop</strong>: scelga quello adatto al suo ingresso. Questo primo ordine è un normale ordine in lavorazione e può essere eseguito non appena il mercato lo raggiunge." },
        { title: "Collegare l’ordine dipendente", html: "Ora faccia clic sul secondo livello di prezzo: è il suo <strong class='text-white'>ordine dipendente</strong>, quello che deve attivarsi solo dopo l’esecuzione del primario. Compare con un <strong class='text-white'>simbolo più (+)</strong> accanto alla quantità. Quel più significa che è sospeso: <em>non</em> verrà inviato alla borsa finché l’ordine primario non è eseguito per intero, anche se nel frattempo il prezzo attraversa quel livello. Lo imposti come serve: uno stop sotto il suo ingresso, un limite di incremento, quello che richiede il suo piano." },
        { title: "Confermare il trigger e riarmare se necessario", html: "Dia un’occhiata al pannello <strong class='text-white'>Orders</strong>. Dovrebbe vedere il primario in lavorazione e il dipendente sospeso. Quando il primario viene eseguito, Tradovate rilascia da solo l’ordine dipendente nel mercato. Un dettaglio da ricordare: <strong class='text-white'>l’OSO una tantum vale solo per quella singola coppia</strong>, deve selezionare di nuovo OSO One-Time dal menu a discesa ATM prima di impostare la successiva." },
      ],
    },
    { type: "heading",text: "Insidie da conoscere" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Inserisca i due ordini in sequenza.</strong> Armi OSO One-Time, inserisca il primario e poi il dipendente. Se fa clic altrove nel SuperDOM o nella web app tra i due, o aspetta troppo, l’OSO può disattivarsi silenziosamente e dovrà armarlo di nuovo.",
        "<strong class='text-white'>Se il primario viene eseguito prima che colleghi il dipendente, quest’ultimo può essere rifiutato.</strong> Se l’ordine trigger è già stato eseguito quando fa clic sul dipendente, non c’è più nulla che lo attivi, quindi il dipendente può essere rifiutato. Imposti entrambi tempestivamente.",
        "<strong class='text-white'>È un solo ordine dipendente, non un bracket.</strong> L’OSO una tantum collega un singolo ordine successivo. Vuole invece uno stop e un target collegati alla sua esecuzione? Usi una ATM Strategy, oppure colleghi un OCO una tantum alla posizione dopo la sua apertura.",
        "<strong class='text-white'>I conti delle prop firm hanno regole proprie.</strong> Alcune firm richiedono uno stop su ogni posizione e limitano la dimensione o il numero di contratti. Questi limiti variano in base alla firm e alla dimensione del conto: verifichi le regole attuali della sua firm prima di costruire qualsiasi flusso di lavoro attorno a essi.",
      ],
    },
    { type: "heading",text: "Automatizzi tutto con PickMyTrade" },
    { type: "paragraph",html: "Concatenare gli ordini a mano funziona solo finché tiene d’occhio la ladder. <strong class='text-white'>PickMyTrade instrada i suoi alert di TradingView direttamente su Tradovate</strong> e invia automaticamente i suoi ingressi e gli ordini successivi, così la seconda gamba arriva nell’istante in cui viene eseguita la prima, che lei sia davanti allo schermo o no." },
  ] },
  ctaHeading: { en: "Let the Second Leg Fire Itself", de: "Lassen Sie das zweite Bein selbst auslösen", es: "Deje que la segunda pata se dispare sola", fr: "Laissez la seconde jambe se déclencher seule", it: "Lasci che la seconda gamba parta da sola" },
  ctaText: { en: "PickMyTrade routes your TradingView alerts straight into Tradovate and sends your entries and follow-on orders automatically, so the second leg lands the instant the first fills.", de: "PickMyTrade leitet Ihre TradingView-Alerts direkt an Tradovate weiter und sendet Ihre Einstiege und Folgeorders automatisch, sodass das zweite Bein in dem Moment landet, in dem das erste ausgeführt wird.", es: "PickMyTrade envía sus alertas de TradingView directamente a Tradovate y manda sus entradas y órdenes posteriores automáticamente, para que la segunda pata llegue en el instante en que se ejecuta la primera.", fr: "PickMyTrade achemine vos alertes TradingView directement vers Tradovate et envoie automatiquement vos entrées et vos ordres de suite, pour que la seconde jambe arrive à l’instant où la première est exécutée.", it: "PickMyTrade instrada i suoi alert di TradingView direttamente su Tradovate e invia automaticamente i suoi ingressi e gli ordini successivi, così la seconda gamba arriva nell’istante in cui viene eseguita la prima." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Foire aux questions", it: "Domande frequenti" },
  faqs: { en: [
    { q: "What's the difference between OSO and OCO in Tradovate?", a: "OSO is sequential: a filled primary order sends a dependent order that didn't exist until the fill. OCO is two live orders linked so a fill on one cancels the other. OSO chains orders forward; OCO pairs a stop and a target." },
    { q: "Why does my dependent order show a plus sign?", a: "The plus (+) marker means it's suspended. It won't be sent to the exchange until the primary fully fills, even if the market trades through that price first. When the primary fills, the plus clears and the dependent goes to work." },
    { q: "Do I have to set up OSO again for each order pair?", a: "Yes. One-time OSO applies to a single pair, so re-select OSO One-Time from the ATM dropdown before setting up the next one." },
  ], de: [
    { q: "Was ist der Unterschied zwischen OSO und OCO in Tradovate?", a: "OSO ist sequenziell: Eine ausgeführte Primärorder sendet eine abhängige Order, die vor der Ausführung nicht existierte. OCO sind zwei aktive Orders, die so verknüpft sind, dass die Ausführung der einen die andere storniert. OSO verkettet Orders nacheinander; OCO koppelt einen Stop und ein Kursziel." },
    { q: "Warum zeigt meine abhängige Order ein Pluszeichen?", a: "Das Plus-Symbol (+) bedeutet, dass sie ausgesetzt ist. Sie wird erst an die Börse gesendet, wenn die Primärorder vollständig ausgeführt ist, selbst wenn der Markt vorher durch diesen Kurs läuft. Sobald die Primärorder ausgeführt ist, verschwindet das Plus und die abhängige Order wird aktiv." },
    { q: "Muss ich OSO für jedes Orderpaar neu einrichten?", a: "Ja. Ein einmaliges OSO gilt nur für ein einzelnes Paar. Wählen Sie daher OSO One-Time erneut aus dem ATM-Dropdown, bevor Sie das nächste einrichten." },
  ], es: [
    { q: "¿Cuál es la diferencia entre OSO y OCO en Tradovate?", a: "OSO es secuencial: una orden principal ejecutada envía una orden dependiente que no existía hasta la ejecución. OCO son dos órdenes activas vinculadas de modo que la ejecución de una cancela la otra. OSO encadena órdenes hacia adelante; OCO empareja un stop y un objetivo." },
    { q: "¿Por qué mi orden dependiente muestra un signo más?", a: "El marcador de más (+) significa que está suspendida. No se enviará al mercado hasta que la orden principal se ejecute por completo, aunque el precio atraviese ese nivel antes. Cuando la principal se ejecuta, el más desaparece y la dependiente se activa." },
    { q: "¿Tengo que configurar OSO de nuevo para cada par de órdenes?", a: "Sí. El OSO de una sola vez se aplica a un único par, así que vuelva a seleccionar OSO One-Time en el menú desplegable ATM antes de configurar el siguiente." },
  ], fr: [
    { q: "Quelle est la différence entre OSO et OCO dans Tradovate ?", a: "L’OSO est séquentiel : un ordre principal exécuté envoie un ordre dépendant qui n’existait pas avant l’exécution. L’OCO correspond à deux ordres actifs liés de sorte que l’exécution de l’un annule l’autre. L’OSO enchaîne les ordres vers l’avant ; l’OCO associe un stop et un objectif." },
    { q: "Pourquoi mon ordre dépendant affiche-t-il un signe plus ?", a: "Le marqueur plus (+) signifie qu’il est suspendu. Il ne sera pas envoyé à la bourse tant que l’ordre principal n’est pas entièrement exécuté, même si le marché traverse ce prix avant. Lorsque l’ordre principal est exécuté, le plus disparaît et l’ordre dépendant entre en jeu." },
    { q: "Dois-je reconfigurer l’OSO pour chaque paire d’ordres ?", a: "Oui. L’OSO ponctuel ne s’applique qu’à une seule paire : sélectionnez de nouveau OSO One-Time dans la liste déroulante ATM avant de configurer la suivante." },
  ], it: [
    { q: "Qual è la differenza tra OSO e OCO in Tradovate?", a: "L’OSO è sequenziale: un ordine primario eseguito invia un ordine dipendente che non esisteva prima dell’esecuzione. L’OCO sono due ordini attivi collegati in modo che l’esecuzione di uno annulli l’altro. L’OSO concatena gli ordini in avanti; l’OCO abbina uno stop e un target." },
    { q: "Perché il mio ordine dipendente mostra un segno più?", a: "Il simbolo più (+) significa che è sospeso. Non verrà inviato alla borsa finché l’ordine primario non è eseguito per intero, anche se il mercato attraversa prima quel prezzo. Quando l’ordine primario viene eseguito, il più scompare e l’ordine dipendente entra in lavorazione." },
    { q: "Devo configurare di nuovo l’OSO per ogni coppia di ordini?", a: "Sì. L’OSO una tantum vale per una singola coppia, quindi selezioni di nuovo OSO One-Time dal menu a discesa ATM prima di impostare la successiva." },
  ] },
  relatedHeading: { en: "Related Guides", de: "Verwandte Anleitungen", es: "Guías relacionadas", fr: "Guides associés", it: "Guide correlate" },
  disclosureText: { en: `This guide is for educational and informational purposes only and is not financial, investment, or trading advice. Trading futures and other leveraged products carries a substantial risk of loss and is not suitable for every investor. PickMyTrade is an independent third-party automation platform and is not affiliated with, endorsed by, or sponsored by Tradovate, Inc. "Tradovate" and all related names, logos, and trademarks are the property of their respective owners. Platform features and steps change over time, so always confirm the current process in the official Tradovate platform and documentation before acting.`, de: "Diese Anleitung dient ausschließlich Bildungs- und Informationszwecken und stellt keine Finanz-, Anlage- oder Handelsberatung dar. Der Handel mit Futures und anderen gehebelten Produkten birgt ein erhebliches Verlustrisiko und ist nicht für jeden Anleger geeignet. PickMyTrade ist eine unabhängige Automatisierungsplattform eines Drittanbieters und steht in keiner Verbindung zu Tradovate, Inc., wird von dieser weder unterstützt noch gesponsert. „Tradovate“ sowie alle zugehörigen Namen, Logos und Marken sind Eigentum ihrer jeweiligen Inhaber. Funktionen und Schritte der Plattform ändern sich im Laufe der Zeit. Bestätigen Sie daher stets den aktuellen Ablauf in der offiziellen Tradovate-Plattform und -Dokumentation, bevor Sie handeln.", es: "Esta guía tiene únicamente fines educativos e informativos y no constituye asesoramiento financiero, de inversión ni de trading. Operar con futuros y otros productos apalancados conlleva un riesgo sustancial de pérdida y no es adecuado para todos los inversores. PickMyTrade es una plataforma de automatización independiente de terceros y no está afiliada, respaldada ni patrocinada por Tradovate, Inc. “Tradovate” y todos los nombres, logotipos y marcas relacionados son propiedad de sus respectivos titulares. Las funciones y los pasos de la plataforma cambian con el tiempo, por lo que debe confirmar siempre el proceso actual en la plataforma y la documentación oficiales de Tradovate antes de actuar.", fr: "Ce guide est fourni à des fins éducatives et informatives uniquement et ne constitue pas un conseil financier, d’investissement ou de trading. Le trading de contrats à terme et d’autres produits à effet de levier comporte un risque de perte important et ne convient pas à tous les investisseurs. PickMyTrade est une plateforme d’automatisation tierce indépendante, non affiliée à Tradovate, Inc., ni approuvée ou parrainée par celle-ci. « Tradovate » ainsi que tous les noms, logos et marques associés sont la propriété de leurs détenteurs respectifs. Les fonctionnalités et les étapes de la plateforme évoluent avec le temps : vérifiez toujours la procédure actuelle sur la plateforme et dans la documentation officielles de Tradovate avant d’agir.", it: "Questa guida ha esclusivamente scopo educativo e informativo e non costituisce consulenza finanziaria, di investimento o di trading. Il trading di futures e di altri prodotti a leva comporta un rischio sostanziale di perdita e non è adatto a tutti gli investitori. PickMyTrade è una piattaforma di automazione indipendente di terze parti e non è affiliata, approvata né sponsorizzata da Tradovate, Inc. “Tradovate” e tutti i nomi, loghi e marchi correlati sono di proprietà dei rispettivi titolari. Le funzioni e i passaggi della piattaforma cambiano nel tempo, quindi confermi sempre la procedura attuale nella piattaforma e nella documentazione ufficiali di Tradovate prima di agire." },
};
const data: GuideArticleData = resolveGuideContent(content, locale, related);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: data.faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
