---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-my-devices";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Manage Devices & Login Alerts in Tradovate";
const META_DESCRIPTION =
  "Learn to read new-device login alerts, review every device signed into your futures account, and remove access you don't recognize in seconds.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Geräte und Anmeldebenachrichtigungen in Tradovate verwalten", es: "Gestione dispositivos y alertas de inicio de sesión en Tradovate", fr: "Gérer les appareils et les alertes de connexion dans Tradovate", it: "Gestire dispositivi e avvisi di accesso in Tradovate" },
  dek: { en: "Read new-device login alerts, review every device signed into your account, and cut off access you don't recognize from the My Devices panel.", de: "Lesen Sie Benachrichtigungen zu Anmeldungen von neuen Geräten, prüfen Sie jedes in Ihrem Konto angemeldete Gerät und sperren Sie den Zugriff für Geräte, die Sie nicht kennen, über das Panel My Devices.", es: "Lea las alertas de inicio de sesión desde dispositivos nuevos, revise cada dispositivo conectado a su cuenta y corte el acceso a los que no reconozca desde el panel My Devices.", fr: "Lisez les alertes de connexion depuis un nouvel appareil, passez en revue tous les appareils connectés à votre compte et coupez l'accès de ceux que vous ne reconnaissez pas depuis le panneau My Devices.", it: "Legga gli avvisi di accesso da nuovi dispositivi, controlli ogni dispositivo connesso al suo account e blocchi l'accesso a quelli che non riconosce dal pannello My Devices." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Someone signing into your futures account from a machine you've never touched is exactly the kind of thing you want to hear about the second it happens. Tradovate handles that two ways. It emails you whenever your username logs in from a new device, and it keeps a running list of every device that has accessed your account. That list lives in Application Settings under <strong class='text-white'>My Devices</strong>, and it's where you cut off anything you don't recognize." },
    { type: "paragraph", html: "The device list is available to live account holders. If you trade a prop-firm evaluation, some of these controls sit on the firm's side, so check your firm's current rules before you assume a setting is yours to change." },
    { type: "image", src: `${IMG}/tradovate-my-devices-1.png`, alt: "Tradovate web platform with the Application Settings gear icon highlighted" },
    { type: "heading", text: "What a New-Device Login Alert Looks Like" },
    { type: "paragraph", html: "The alert depends on whether you've turned on two-factor authentication." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Without 2FA:</strong> when your username logs in from a device Tradovate hasn't seen before, it sends an email letting you know a new device just signed in.",
        "<strong class='text-white'>With 2FA:</strong> that email also carries Approve and Deny buttons. On a live account with 2FA on, the new device can't finish logging in until you approve it, so an attacker with your password still gets stopped at the door.",
      ],
    },
    { type: "paragraph", html: "If you get one of these and it wasn't you, deny the device and change your password right away. It's the earliest warning you'll get that your credentials are floating around somewhere they shouldn't be." },
    { type: "heading", text: "How to Review and Manage Your Devices" },
    { type: "paragraph", html: "Here's the full walk-through, from opening settings to pulling access on a device you don't trust." },
    {
      type: "steps",
      items: [
        { title: "Open Application Settings", html: "Log in to the web platform and open the <strong class='text-white'>Application Settings</strong> menu, usually the gear/settings icon." },
        { title: "Open the My Devices Panel", html: "In the settings menu, open <strong class='text-white'>My Devices</strong>. On some builds it's grouped under a Security section of Application Settings, so if you don't see it right away, look there.", image: { src: `${IMG}/tradovate-my-devices-2.png`, alt: "Application Settings menu open with the My Devices option selected" } },
        { title: "Read Your Device List", html: "My Devices shows a row for every device that's accessed your account. Use the columns, Device, IP Address, Last location, Last Login Time, and Last App, to confirm each one is really yours." },
        { title: "Remove Access for a Device", html: "Look at the <strong class='text-white'>Manage</strong> column. An approved device shows <strong class='text-white'>Remove Access</strong>. Click it and that device can no longer use your username and password to get in. Do this for any laptop, phone, or borrowed machine you no longer use, and for anything you flat out don't recognize." },
        { title: "Handle Pending Devices and the Email Prompt", html: "A device waiting on approval shows <strong class='text-white'>Pending</strong> along with a <strong class='text-white'>Forget</strong> option. Clicking Forget resets it, so the next time a login is attempted from that device you get a fresh Approve-or-Deny email instead of it slipping through. Between the emailed buttons and the Manage column, you've got two places to shut a device out." },
      ],
    },
    {
      type: "table",
      headers: ["Column", "What it tells you"],
      rows: [
        ["Device", "The machine or app that signed in."],
        ["IP Address", "The address it connected from."],
        ["Last location", "The approximate location of that IP."],
        ["Last Login Time", "When that device last accessed your account."],
        ["Last App", "Handy for spotting when several apps run on one machine."],
      ],
    },
    { type: "image", src: `${IMG}/tradovate-my-devices-3.png`, alt: "Tradovate My Devices list showing Device, IP Address, Last location, Last Login Time and Last App columns" },
    { type: "heading", text: "Turn On 2FA So the List Actually Protects You" },
    { type: "paragraph", html: "My Devices is only half the story. The list tells you who got in, but 2FA is what stops the wrong device from getting in at all. Tradovate supports a few methods: trusted (previously authenticated) browsers, security keys over Bluetooth, NFC or USB, Windows Hello, and authenticator apps that generate time-based codes. Pick one, switch it on, and every new-device login turns into a decision you make instead of a notification you read after the fact." },
    { type: "paragraph", html: "One more thing worth knowing: running too many active sessions at once can trigger disconnects and frozen charts on its own. If you keep getting bumped, trimming things back to a single clean login usually clears it up." },
    { type: "paragraph", html: "Make a habit of opening My Devices every few weeks, especially after you've logged in from a hotel, a friend's computer, or a new VPS. It takes about a minute, and it's the cheapest security you'll ever add to a live trading account." },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Automating Tradovate from TradingView? Keep your logins tidy so your strategy never stalls on a device-approval prompt. <strong class='text-white'>PickMyTrade wires your TradingView alerts straight to your Tradovate account</strong>, so entries, exits, and brackets fire on their own." },
  ], de: [
    { type: "paragraph",html: "Dass sich jemand von einem Rechner, den Sie nie angefasst haben, in Ihr Futures-Konto einloggt, ist genau die Art von Ereignis, von der Sie in derselben Sekunde erfahren möchten. Tradovate regelt das auf zwei Wegen. Es sendet Ihnen eine E-Mail, sobald sich Ihr Benutzername von einem neuen Gerät aus anmeldet, und es führt eine fortlaufende Liste aller Geräte, die auf Ihr Konto zugegriffen haben. Diese Liste finden Sie in den Application Settings unter <strong class='text-white'>My Devices</strong>, und dort sperren Sie alles, was Sie nicht erkennen." },
    { type: "paragraph",html: "Die Geräteliste steht Inhabern von Live-Konten zur Verfügung. Wenn Sie eine Prop-Firm-Evaluierung handeln, liegen manche dieser Steuerungen auf Seiten der Firma. Prüfen Sie daher die aktuellen Regeln Ihrer Firma, bevor Sie davon ausgehen, dass Sie eine Einstellung selbst ändern dürfen." },
    { type: "image",src: `${IMG}/tradovate-my-devices-1.png`,alt: "Tradovate-Webplattform mit hervorgehobenem Zahnrad-Symbol der Application Settings" },
    { type: "heading",text: "So sieht eine Benachrichtigung über eine Anmeldung von einem neuen Gerät aus" },
    { type: "paragraph",html: "Die Benachrichtigung hängt davon ab, ob Sie die Zwei-Faktor-Authentifizierung aktiviert haben." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Ohne 2FA:</strong> Wenn sich Ihr Benutzername von einem Gerät anmeldet, das Tradovate noch nicht kennt, erhalten Sie eine E-Mail, die Sie darüber informiert, dass sich soeben ein neues Gerät angemeldet hat.",
        "<strong class='text-white'>Mit 2FA:</strong> Diese E-Mail enthält zusätzlich die Schaltflächen Approve und Deny. Bei einem Live-Konto mit aktivierter 2FA kann das neue Gerät die Anmeldung erst abschließen, wenn Sie es genehmigen. Ein Angreifer mit Ihrem Passwort wird also trotzdem an der Tür gestoppt.",
      ],
    },
    { type: "paragraph",html: "Wenn Sie eine solche Nachricht erhalten und Sie es nicht waren, lehnen Sie das Gerät ab und ändern Sie sofort Ihr Passwort. Es ist die früheste Warnung, die Sie erhalten, dass Ihre Zugangsdaten irgendwo kursieren, wo sie nicht hingehören." },
    { type: "heading",text: "So prüfen und verwalten Sie Ihre Geräte" },
    { type: "paragraph",html: "Hier ist die vollständige Anleitung, vom Öffnen der Einstellungen bis zum Entziehen des Zugriffs für ein Gerät, dem Sie nicht vertrauen." },
    {
      type: "steps",
      items: [
        { title: "Application Settings öffnen", html: "Melden Sie sich bei der Webplattform an und öffnen Sie das Menü <strong class='text-white'>Application Settings</strong>, meist das Zahnrad- bzw. Einstellungssymbol." },
        { title: "Das Panel My Devices öffnen", html: "Öffnen Sie im Einstellungsmenü <strong class='text-white'>My Devices</strong>. In manchen Versionen ist es unter einem Bereich Security der Application Settings zusammengefasst. Wenn Sie es nicht sofort sehen, suchen Sie dort.", image: {"src":`${IMG}/tradovate-my-devices-2.png`,"alt":"Application-Settings-Menü geöffnet, mit ausgewählter Option My Devices"} },
        { title: "Ihre Geräteliste lesen", html: "My Devices zeigt eine Zeile für jedes Gerät, das auf Ihr Konto zugegriffen hat. Anhand der Spalten Device, IP Address, Last location, Last Login Time und Last App prüfen Sie, ob jedes Gerät tatsächlich Ihnen gehört." },
        { title: "Zugriff für ein Gerät entziehen", html: "Sehen Sie sich die Spalte <strong class='text-white'>Manage</strong> an. Ein genehmigtes Gerät zeigt <strong class='text-white'>Remove Access</strong>. Klicken Sie darauf, und dieses Gerät kann sich mit Ihrem Benutzernamen und Passwort nicht mehr anmelden. Tun Sie das für jeden Laptop, jedes Telefon und jeden geliehenen Rechner, den Sie nicht mehr verwenden, und für alles, was Sie schlicht nicht erkennen." },
        { title: "Ausstehende Geräte und die E-Mail-Abfrage behandeln", html: "Ein Gerät, das auf Genehmigung wartet, zeigt <strong class='text-white'>Pending</strong> zusammen mit der Option <strong class='text-white'>Forget</strong>. Ein Klick auf Forget setzt es zurück, sodass Sie beim nächsten Anmeldeversuch von diesem Gerät eine neue E-Mail mit Approve oder Deny erhalten, statt dass es durchrutscht. Mit den E-Mail-Schaltflächen und der Spalte Manage haben Sie zwei Stellen, um ein Gerät auszusperren." },
      ],
    },
    { type: "table", headers: ["Spalte","Was sie Ihnen sagt"], rows: [
      ["Device","Der Rechner oder die App, der bzw. die sich angemeldet hat."],
      ["IP Address","Die Adresse, von der aus die Verbindung bestand."],
      ["Last location","Der ungefähre Standort dieser IP-Adresse."],
      ["Last Login Time","Wann dieses Gerät zuletzt auf Ihr Konto zugegriffen hat."],
      ["Last App","Praktisch, um zu erkennen, wenn mehrere Apps auf einem Rechner laufen."],
    ] },
    { type: "image",src: `${IMG}/tradovate-my-devices-3.png`,alt: "Tradovate-Liste My Devices mit den Spalten Device, IP Address, Last location, Last Login Time und Last App" },
    { type: "heading",text: "Aktivieren Sie 2FA, damit die Liste Sie wirklich schützt" },
    { type: "paragraph",html: "My Devices ist nur die halbe Wahrheit. Die Liste zeigt Ihnen, wer sich Zugang verschafft hat, aber erst 2FA verhindert, dass das falsche Gerät überhaupt hineinkommt. Tradovate unterstützt mehrere Methoden: vertrauenswürdige (zuvor authentifizierte) Browser, Sicherheitsschlüssel über Bluetooth, NFC oder USB, Windows Hello sowie Authenticator-Apps, die zeitbasierte Codes erzeugen. Wählen Sie eine aus und schalten Sie sie ein. Dann wird jede Anmeldung von einem neuen Gerät zu einer Entscheidung, die Sie treffen, statt zu einer Benachrichtigung, die Sie hinterher lesen." },
    { type: "paragraph",html: "Noch etwas Wissenswertes: Zu viele gleichzeitig aktive Sitzungen können für sich genommen Verbindungsabbrüche und eingefrorene Charts auslösen. Wenn Sie ständig rausfliegen, behebt eine Reduzierung auf eine einzige saubere Anmeldung das Problem meist." },
    { type: "paragraph",html: "Machen Sie es sich zur Gewohnheit, My Devices alle paar Wochen zu öffnen, besonders nachdem Sie sich in einem Hotel, am Computer eines Freundes oder auf einem neuen VPS angemeldet haben. Es dauert etwa eine Minute und ist die günstigste Sicherheitsmaßnahme, die Sie einem Live-Handelskonto je hinzufügen werden." },
    { type: "heading",text: "Mit PickMyTrade automatisieren" },
    { type: "paragraph",html: "Sie automatisieren Tradovate über TradingView? Halten Sie Ihre Anmeldungen in Ordnung, damit Ihre Strategie nie an einer Geräte-Freigabeaufforderung hängen bleibt. <strong class='text-white'>PickMyTrade verbindet Ihre TradingView-Alerts direkt mit Ihrem Tradovate-Konto</strong>, sodass Einstiege, Ausstiege und Brackets von selbst ausgelöst werden." },
  ], es: [
    { type: "paragraph",html: "Que alguien inicie sesión en su cuenta de futuros desde un equipo que nunca ha tocado es justo el tipo de cosa de la que quiere enterarse en el mismo instante en que ocurre. Tradovate lo gestiona de dos maneras. Le envía un correo electrónico cada vez que su nombre de usuario inicia sesión desde un dispositivo nuevo y mantiene una lista actualizada de todos los dispositivos que han accedido a su cuenta. Esa lista está en Application Settings, en <strong class='text-white'>My Devices</strong>, y es donde corta el acceso a todo lo que no reconozca." },
    { type: "paragraph",html: "La lista de dispositivos está disponible para los titulares de cuentas reales. Si opera una evaluación de una prop firm, algunos de estos controles dependen de la empresa, así que consulte las normas vigentes de su empresa antes de dar por hecho que puede cambiar un ajuste." },
    { type: "image",src: `${IMG}/tradovate-my-devices-1.png`,alt: "Plataforma web de Tradovate con el icono de engranaje de Application Settings resaltado" },
    { type: "heading",text: "Cómo es una alerta de inicio de sesión desde un dispositivo nuevo" },
    { type: "paragraph",html: "La alerta depende de si ha activado la autenticación en dos pasos." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Sin 2FA:</strong> cuando su nombre de usuario inicia sesión desde un dispositivo que Tradovate no ha visto antes, le envía un correo electrónico para avisarle de que un dispositivo nuevo acaba de iniciar sesión.",
        "<strong class='text-white'>Con 2FA:</strong> ese correo incluye además los botones Approve y Deny. En una cuenta real con 2FA activada, el dispositivo nuevo no puede completar el inicio de sesión hasta que usted lo apruebe, de modo que un atacante con su contraseña se queda igualmente en la puerta.",
      ],
    },
    { type: "paragraph",html: "Si recibe uno de estos avisos y no fue usted, rechace el dispositivo y cambie su contraseña de inmediato. Es la primera señal de que sus credenciales andan circulando por donde no deberían." },
    { type: "heading",text: "Cómo revisar y gestionar sus dispositivos" },
    { type: "paragraph",html: "Este es el recorrido completo, desde abrir los ajustes hasta retirar el acceso a un dispositivo en el que no confía." },
    {
      type: "steps",
      items: [
        { title: "Abra Application Settings", html: "Inicie sesión en la plataforma web y abra el menú <strong class='text-white'>Application Settings</strong>, normalmente el icono de engranaje o de ajustes." },
        { title: "Abra el panel My Devices", html: "En el menú de ajustes, abra <strong class='text-white'>My Devices</strong>. En algunas versiones está agrupado en una sección Security de Application Settings, así que si no lo ve de inmediato, búsquelo allí.", image: {"src":`${IMG}/tradovate-my-devices-2.png`,"alt":"Menú Application Settings abierto con la opción My Devices seleccionada"} },
        { title: "Lea su lista de dispositivos", html: "My Devices muestra una fila por cada dispositivo que ha accedido a su cuenta. Use las columnas Device, IP Address, Last location, Last Login Time y Last App para confirmar que cada uno es realmente suyo." },
        { title: "Retire el acceso a un dispositivo", html: "Fíjese en la columna <strong class='text-white'>Manage</strong>. Un dispositivo aprobado muestra <strong class='text-white'>Remove Access</strong>. Haga clic y ese dispositivo ya no podrá usar su nombre de usuario y contraseña para entrar. Hágalo con cualquier portátil, teléfono o equipo prestado que ya no use, y con todo lo que sencillamente no reconozca." },
        { title: "Gestione los dispositivos pendientes y el aviso por correo", html: "Un dispositivo que espera aprobación muestra <strong class='text-white'>Pending</strong> junto con la opción <strong class='text-white'>Forget</strong>. Al hacer clic en Forget se restablece, de modo que la próxima vez que se intente un inicio de sesión desde ese dispositivo recibirá un nuevo correo de Approve o Deny en lugar de que se cuele. Entre los botones del correo y la columna Manage, dispone de dos lugares para bloquear un dispositivo." },
      ],
    },
    { type: "table", headers: ["Columna","Qué le indica"], rows: [
      ["Device","El equipo o la aplicación que inició sesión."],
      ["IP Address","La dirección desde la que se conectó."],
      ["Last location","La ubicación aproximada de esa IP."],
      ["Last Login Time","Cuándo accedió por última vez ese dispositivo a su cuenta."],
      ["Last App","Útil para detectar cuándo varias aplicaciones se ejecutan en un mismo equipo."],
    ] },
    { type: "image",src: `${IMG}/tradovate-my-devices-3.png`,alt: "Lista My Devices de Tradovate con las columnas Device, IP Address, Last location, Last Login Time y Last App" },
    { type: "heading",text: "Active la 2FA para que la lista realmente le proteja" },
    { type: "paragraph",html: "My Devices es solo la mitad de la historia. La lista le dice quién ha entrado, pero la 2FA es lo que impide que el dispositivo equivocado entre. Tradovate admite varios métodos: navegadores de confianza (autenticados previamente), llaves de seguridad por Bluetooth, NFC o USB, Windows Hello y aplicaciones de autenticación que generan códigos basados en el tiempo. Elija uno y actívelo, y cada inicio de sesión desde un dispositivo nuevo se convertirá en una decisión que usted toma en lugar de una notificación que lee después." },
    { type: "paragraph",html: "Una cosa más que conviene saber: tener demasiadas sesiones activas a la vez puede provocar por sí solo desconexiones y gráficos congelados. Si le siguen expulsando, reducir todo a un único inicio de sesión limpio suele solucionarlo." },
    { type: "paragraph",html: "Adquiera el hábito de abrir My Devices cada pocas semanas, sobre todo después de haber iniciado sesión desde un hotel, el ordenador de un amigo o un VPS nuevo. Lleva alrededor de un minuto y es la medida de seguridad más barata que añadirá nunca a una cuenta de trading real." },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "¿Automatiza Tradovate desde TradingView? Mantenga sus inicios de sesión en orden para que su estrategia nunca se detenga ante un aviso de aprobación de dispositivo. <strong class='text-white'>PickMyTrade conecta sus alertas de TradingView directamente con su cuenta de Tradovate</strong>, de modo que las entradas, las salidas y los brackets se ejecutan solos." },
  ], fr: [
    { type: "paragraph",html: "Que quelqu'un se connecte à votre compte de futures depuis une machine que vous n'avez jamais touchée, c'est exactement le genre de chose dont vous voulez être averti à la seconde où elle se produit. Tradovate gère cela de deux façons. Il vous envoie un e-mail chaque fois que votre nom d'utilisateur se connecte depuis un nouvel appareil, et il tient à jour la liste de tous les appareils ayant accédé à votre compte. Cette liste se trouve dans Application Settings, sous <strong class='text-white'>My Devices</strong>, et c'est là que vous coupez l'accès à tout ce que vous ne reconnaissez pas." },
    { type: "paragraph",html: "La liste des appareils est disponible pour les titulaires de comptes réels. Si vous tradez une évaluation de prop firm, certains de ces contrôles relèvent de la société ; vérifiez donc les règles actuelles de votre société avant de supposer qu'un paramètre vous appartient." },
    { type: "image",src: `${IMG}/tradovate-my-devices-1.png`,alt: "Plateforme web Tradovate avec l'icône d'engrenage des Application Settings en surbrillance" },
    { type: "heading",text: "À quoi ressemble une alerte de connexion depuis un nouvel appareil" },
    { type: "paragraph",html: "L'alerte dépend de l'activation ou non de l'authentification à deux facteurs." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Sans 2FA :</strong> lorsque votre nom d'utilisateur se connecte depuis un appareil que Tradovate n'a jamais vu, il vous envoie un e-mail vous informant qu'un nouvel appareil vient de se connecter.",
        "<strong class='text-white'>Avec la 2FA :</strong> cet e-mail comporte aussi des boutons Approve et Deny. Sur un compte réel avec la 2FA activée, le nouvel appareil ne peut pas terminer sa connexion tant que vous ne l'avez pas approuvé : un pirate qui possède votre mot de passe est donc quand même arrêté à la porte.",
      ],
    },
    { type: "paragraph",html: "Si vous recevez ce message et que ce n'était pas vous, refusez l'appareil et changez immédiatement votre mot de passe. C'est le premier signal que vos identifiants circulent quelque part où ils ne devraient pas." },
    { type: "heading",text: "Comment passer en revue et gérer vos appareils" },
    { type: "paragraph",html: "Voici le parcours complet, de l'ouverture des paramètres au retrait d'accès d'un appareil auquel vous ne faites pas confiance." },
    {
      type: "steps",
      items: [
        { title: "Ouvrir Application Settings", html: "Connectez-vous à la plateforme web et ouvrez le menu <strong class='text-white'>Application Settings</strong>, généralement l'icône d'engrenage ou de paramètres." },
        { title: "Ouvrir le panneau My Devices", html: "Dans le menu des paramètres, ouvrez <strong class='text-white'>My Devices</strong>. Sur certaines versions, il est regroupé sous une section Security des Application Settings ; si vous ne le voyez pas tout de suite, cherchez-le là.", image: {"src":`${IMG}/tradovate-my-devices-2.png`,"alt":"Menu Application Settings ouvert avec l'option My Devices sélectionnée"} },
        { title: "Lire la liste de vos appareils", html: "My Devices affiche une ligne pour chaque appareil ayant accédé à votre compte. Servez-vous des colonnes Device, IP Address, Last location, Last Login Time et Last App pour vérifier que chacun est bien le vôtre." },
        { title: "Retirer l'accès d'un appareil", html: "Regardez la colonne <strong class='text-white'>Manage</strong>. Un appareil approuvé affiche <strong class='text-white'>Remove Access</strong>. Cliquez dessus et cet appareil ne pourra plus utiliser votre nom d'utilisateur et votre mot de passe pour se connecter. Faites-le pour tout ordinateur portable, téléphone ou machine empruntée que vous n'utilisez plus, et pour tout ce que vous ne reconnaissez tout simplement pas." },
        { title: "Traiter les appareils en attente et l'invite par e-mail", html: "Un appareil en attente d'approbation affiche <strong class='text-white'>Pending</strong> avec une option <strong class='text-white'>Forget</strong>. Cliquer sur Forget le réinitialise : la prochaine fois qu'une connexion est tentée depuis cet appareil, vous recevez un nouvel e-mail Approve ou Deny au lieu qu'elle passe inaperçue. Entre les boutons de l'e-mail et la colonne Manage, vous disposez de deux endroits pour bloquer un appareil." },
      ],
    },
    { type: "table", headers: ["Colonne","Ce qu'elle vous indique"], rows: [
      ["Device","La machine ou l'application qui s'est connectée."],
      ["IP Address","L'adresse depuis laquelle elle s'est connectée."],
      ["Last location","L'emplacement approximatif de cette adresse IP."],
      ["Last Login Time","Le moment où cet appareil a accédé pour la dernière fois à votre compte."],
      ["Last App","Pratique pour repérer plusieurs applications exécutées sur une même machine."],
    ] },
    { type: "image",src: `${IMG}/tradovate-my-devices-3.png`,alt: "Liste My Devices de Tradovate affichant les colonnes Device, IP Address, Last location, Last Login Time et Last App" },
    { type: "heading",text: "Activez la 2FA pour que la liste vous protège vraiment" },
    { type: "paragraph",html: "My Devices ne représente que la moitié du tableau. La liste vous dit qui est entré, mais c'est la 2FA qui empêche le mauvais appareil d'entrer. Tradovate prend en charge plusieurs méthodes : navigateurs de confiance (déjà authentifiés), clés de sécurité via Bluetooth, NFC ou USB, Windows Hello et applications d'authentification générant des codes temporels. Choisissez-en une et activez-la : chaque connexion depuis un nouvel appareil devient alors une décision que vous prenez, plutôt qu'une notification lue après coup." },
    { type: "paragraph",html: "Une dernière chose à savoir : avoir trop de sessions actives en même temps peut, à lui seul, provoquer des déconnexions et des graphiques figés. Si vous êtes régulièrement déconnecté, revenir à une seule connexion propre règle généralement le problème." },
    { type: "paragraph",html: "Prenez l'habitude d'ouvrir My Devices toutes les quelques semaines, surtout après vous être connecté depuis un hôtel, l'ordinateur d'un ami ou un nouveau VPS. Cela prend environ une minute et c'est la sécurité la moins chère que vous ajouterez jamais à un compte de trading réel." },
    { type: "heading",text: "Automatisez tout cela avec PickMyTrade" },
    { type: "paragraph",html: "Vous automatisez Tradovate depuis TradingView ? Gardez vos connexions en ordre pour que votre stratégie ne reste jamais bloquée sur une demande d'approbation d'appareil. <strong class='text-white'>PickMyTrade relie directement vos alertes TradingView à votre compte Tradovate</strong>, de sorte que les entrées, les sorties et les brackets se déclenchent d'eux-mêmes." },
  ], it: [
    { type: "paragraph",html: "Qualcuno che accede al suo conto futures da una macchina che non ha mai toccato è esattamente il tipo di evento di cui vuole essere informato nell'istante in cui accade. Tradovate lo gestisce in due modi. Le invia un'e-mail ogni volta che il suo nome utente accede da un nuovo dispositivo e mantiene un elenco aggiornato di tutti i dispositivi che hanno avuto accesso al suo account. Quell'elenco si trova in Application Settings, sotto <strong class='text-white'>My Devices</strong>, ed è lì che blocca tutto ciò che non riconosce." },
    { type: "paragraph",html: "L'elenco dei dispositivi è disponibile per i titolari di conti live. Se opera su una valutazione di una prop firm, alcuni di questi controlli sono gestiti dalla società, quindi verifichi le regole attuali della sua società prima di dare per scontato che un'impostazione sia modificabile da lei." },
    { type: "image",src: `${IMG}/tradovate-my-devices-1.png`,alt: "Piattaforma web di Tradovate con l'icona a ingranaggio di Application Settings evidenziata" },
    { type: "heading",text: "Come appare un avviso di accesso da un nuovo dispositivo" },
    { type: "paragraph",html: "L'avviso dipende dal fatto che abbia attivato l'autenticazione a due fattori." },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Senza 2FA:</strong> quando il suo nome utente accede da un dispositivo che Tradovate non ha mai visto, invia un'e-mail per informarla che un nuovo dispositivo ha appena effettuato l'accesso.",
        "<strong class='text-white'>Con la 2FA:</strong> quell'e-mail contiene anche i pulsanti Approve e Deny. Su un conto live con la 2FA attiva, il nuovo dispositivo non può completare l'accesso finché lei non lo approva, quindi un aggressore con la sua password viene comunque fermato alla porta.",
      ],
    },
    { type: "paragraph",html: "Se riceve uno di questi avvisi e non era lei, rifiuti il dispositivo e cambi subito la password. È il primo segnale che le sue credenziali circolano dove non dovrebbero." },
    { type: "heading",text: "Come controllare e gestire i suoi dispositivi" },
    { type: "paragraph",html: "Ecco la procedura completa, dall'apertura delle impostazioni alla revoca dell'accesso per un dispositivo di cui non si fida." },
    {
      type: "steps",
      items: [
        { title: "Aprire Application Settings", html: "Acceda alla piattaforma web e apra il menu <strong class='text-white'>Application Settings</strong>, di solito l'icona a ingranaggio o delle impostazioni." },
        { title: "Aprire il pannello My Devices", html: "Nel menu delle impostazioni, apra <strong class='text-white'>My Devices</strong>. In alcune versioni è raggruppato in una sezione Security di Application Settings, quindi se non lo vede subito, lo cerchi lì.", image: {"src":`${IMG}/tradovate-my-devices-2.png`,"alt":"Menu Application Settings aperto con l'opzione My Devices selezionata"} },
        { title: "Leggere l'elenco dei dispositivi", html: "My Devices mostra una riga per ogni dispositivo che ha avuto accesso al suo account. Usi le colonne Device, IP Address, Last location, Last Login Time e Last App per verificare che ciascuno sia davvero suo." },
        { title: "Revocare l'accesso a un dispositivo", html: "Guardi la colonna <strong class='text-white'>Manage</strong>. Un dispositivo approvato mostra <strong class='text-white'>Remove Access</strong>. Ci clicchi e quel dispositivo non potrà più usare il suo nome utente e la sua password per entrare. Lo faccia per ogni laptop, telefono o computer in prestito che non usa più, e per tutto ciò che semplicemente non riconosce." },
        { title: "Gestire i dispositivi in sospeso e la richiesta via e-mail", html: "Un dispositivo in attesa di approvazione mostra <strong class='text-white'>Pending</strong> insieme all'opzione <strong class='text-white'>Forget</strong>. Cliccando su Forget lo reimposta, così la prossima volta che viene tentato un accesso da quel dispositivo riceverà una nuova e-mail Approve o Deny invece di lasciarlo passare. Tra i pulsanti dell'e-mail e la colonna Manage, ha due punti in cui escludere un dispositivo." },
      ],
    },
    { type: "table", headers: ["Colonna","Cosa le indica"], rows: [
      ["Device","La macchina o l'app che ha effettuato l'accesso."],
      ["IP Address","L'indirizzo da cui si è connesso."],
      ["Last location","La posizione approssimativa di quell'IP."],
      ["Last Login Time","Quando quel dispositivo ha avuto accesso per l'ultima volta al suo account."],
      ["Last App","Utile per accorgersi di quando più app sono in esecuzione sulla stessa macchina."],
    ] },
    { type: "image",src: `${IMG}/tradovate-my-devices-3.png`,alt: "Elenco My Devices di Tradovate con le colonne Device, IP Address, Last location, Last Login Time e Last App" },
    { type: "heading",text: "Attivi la 2FA così l'elenco la protegge davvero" },
    { type: "paragraph",html: "My Devices è solo metà della storia. L'elenco le dice chi è entrato, ma è la 2FA a impedire che il dispositivo sbagliato entri. Tradovate supporta diversi metodi: browser attendibili (già autenticati), chiavi di sicurezza via Bluetooth, NFC o USB, Windows Hello e app di autenticazione che generano codici basati sul tempo. Ne scelga uno e lo attivi: ogni accesso da un nuovo dispositivo diventerà una decisione che prende lei anziché una notifica che legge a cose fatte." },
    { type: "paragraph",html: "Un'ultima cosa da sapere: avere troppe sessioni attive contemporaneamente può provocare da sole disconnessioni e grafici bloccati. Se continua a essere disconnesso, ridurre tutto a un solo accesso pulito di solito risolve il problema." },
    { type: "paragraph",html: "Prenda l'abitudine di aprire My Devices ogni poche settimane, soprattutto dopo aver effettuato l'accesso da un hotel, dal computer di un amico o da un nuovo VPS. Richiede circa un minuto ed è la misura di sicurezza più economica che aggiungerà mai a un conto di trading live." },
    { type: "heading",text: "Automatizzi tutto con PickMyTrade" },
    { type: "paragraph",html: "Automatizza Tradovate da TradingView? Mantenga in ordine i suoi accessi in modo che la sua strategia non si fermi mai davanti a una richiesta di approvazione del dispositivo. <strong class='text-white'>PickMyTrade collega direttamente i suoi alert di TradingView al suo conto Tradovate</strong>, così ingressi, uscite e bracket partono da soli." },
  ] },
