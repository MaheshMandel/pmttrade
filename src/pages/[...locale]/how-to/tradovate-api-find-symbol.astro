---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-api-find-symbol";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Find Contracts & Symbols With the Tradovate API";
const META_DESCRIPTION =
  "Tradovate API find symbol: use product/find and contract/find to resolve tickers and contract IDs so every futures order hits the right contract.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate API", de: "Tradovate API", es: "Tradovate API", fr: "Tradovate API", it: "Tradovate API" },
  h1: { en: META_TITLE, de: "Kontrakte & Symbole mit der Tradovate-API finden", es: "Encuentre contratos y símbolos con la API de Tradovate", fr: "Trouver contrats et symboles avec l’API Tradovate", it: "Trovare contratti e simboli con l’API di Tradovate" },
  dek: { en: "Before your code can pull a quote or fire an order, it has to name the exact contract Tradovate expects. Here's how to resolve symbols and contract IDs with product/find and contract/find, one step at a time.", de: "Bevor Ihr Code ein Quote abrufen oder eine Order auslösen kann, muss er den genauen Kontrakt benennen, den Tradovate erwartet. So lösen Sie Symbole und Kontrakt-IDs mit product/find und contract/find auf, Schritt für Schritt.", es: "Antes de que su código pueda obtener una cotización o lanzar una orden, tiene que nombrar el contrato exacto que Tradovate espera. Así se resuelven símbolos e ID de contrato con product/find y contract/find, paso a paso.", fr: "Avant que votre code puisse récupérer une cotation ou envoyer un ordre, il doit nommer le contrat exact attendu par Tradovate. Voici comment résoudre symboles et identifiants de contrat avec product/find et contract/find, étape par étape.", it: "Prima che il Suo codice possa recuperare una quotazione o inviare un ordine, deve indicare il contratto esatto che Tradovate si aspetta. Ecco come risolvere simboli e ID dei contratti con product/find e contract/find, passo dopo passo." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Before your code can pull a quote or fire an order, it has to name the exact contract Tradovate expects. If you're building a trading bot, mapping a numeric contract ID back to a readable ticker, or wiring up automation like PickMyTrade, this is where you start. Below, you'll resolve symbols and contract IDs with the <code>product/find</code> and <code>contract/find</code> endpoints, one step at a time." },
    { type: "heading", text: "What Are Products, Contracts, and Symbols in the Tradovate API?" },
    { type: "paragraph", html: "Tradovate splits the futures world into a small three-level hierarchy, and once it clicks the rest of the API gets a lot easier." },
    { type: "paragraph", html: "A <strong class='text-white'>product</strong> is the instrument family, \"ES\" or \"MES\", with no expiration attached. A <strong class='text-white'>contract</strong> is one specific maturity of that product, written as a symbol like <code>MESU5</code>, that's the thing you actually trade. And every contract carries a numeric <strong class='text-white'>contract ID</strong>, which is what the API hands back in positions, orders, and fills. Symbol lookup is just moving between those three: name a product, get its live contracts, and translate an ID back into something a human can read." },
    { type: "heading", text: "Finding Contracts & Symbols via the Tradovate API: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Authenticate and Get an Access Token", html: "Every lookup is an authenticated HTTPS request, so grab a bearer token first. POST your credentials and app details to <code>/auth/accessTokenRequest</code>; the response carries an <code>accessToken</code> that you attach to each later call in an <code>Authorization: Bearer</code> header. Send it to the matching host, <code>demo.tradovateapi.com/v1</code> for the simulation environment, or <code>live.tradovateapi.com/v1</code> when real money is on the line." },
        { title: "Look Up the Product with product/find", html: "Resolve the instrument family before anything else. Call <code>GET /product/find?name=MES</code> with your token, and Tradovate returns the product object, its numeric <code>id</code>, its <code>name</code>, and the product type. Hold onto that product <code>id</code>, because it's the key you reuse to enumerate every contract under the instrument. There's no public \"list every symbol\" endpoint, so you always start from a root you already know, ES, NQ, CL, and query outward from there." },
        { title: "Resolve the Active Contract with contract/find or contract/suggest", html: "Now turn that product into something tradable. <code>GET /contract/suggest?t=MES</code> returns matching contracts sorted with the best maturity first, index 0 is usually the front month. <code>GET /contract/find?name=MESU5</code> resolves one exact symbol string to its full contract object, including the numeric contract <code>id</code> you'll pass to order and market-data calls. One gotcha worth burning into memory: continuous chart tickers like <code>@MES</code> are fine for charting, but you can't trade them. You need the dated contract symbol that this step gives you." },
        { title: "Reverse an ID or Confirm Expiry with contract/item and contractMaturity", html: "Sometimes you're going the other direction, you've got a contract <code>id</code> off a position or an order, and you need the ticker. Call <code>GET /contract/item?id=&lt;id&gt;</code> to get the contract's <code>name</code>, <code>productId</code>, and <code>contractMaturityId</code>. Want to know how close it is to expiring? Pass that <code>contractMaturityId</code> to <code>GET /contractMaturity/item?id=&lt;id&gt;</code> and read the <code>expirationDate</code>. Rolling on days-to-expiration beats trusting a single \"front\" flag near rollover, when that flag can flip out from under you." },
      ],
    },
    { type: "heading", text: "How to Read a Tradovate Futures Symbol" },
    { type: "paragraph", html: "A dated futures symbol is just three parts jammed together with no spaces: <strong class='text-white'>instrument + month code + last digit of the year</strong>. So <code>MESU5</code> is MES (Micro E-mini S&amp;P 500) + U (September) + 5 (2025). The month codes never change year to year, so it's worth memorizing them once:" },
    {
      type: "table",
      headers: ["Code", "Month", "Code", "Month"],
      rows: [
        ["F", "January", "N", "July"],
        ["G", "February", "Q", "August"],
        ["H", "March", "U", "September"],
        ["J", "April", "V", "October"],
        ["K", "May", "X", "November"],
        ["M", "June", "Z", "December"],
      ],
    },
    { type: "heading", text: "Why You'd Need This" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Placing orders</strong>, every order needs a valid, non-expired contract symbol or ID, resolved before you send it.",
        "<strong class='text-white'>Subscribing to market data</strong>, quote and chart subscriptions key off the exact contract.",
        "<strong class='text-white'>Reading positions and fills</strong>, the API hands you numeric IDs, and you map them back to tickers for logs and dashboards.",
        "<strong class='text-white'>Automating rollovers</strong>, detect the front month and roll to the next contract as expiry closes in.",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Don't feel like juggling <code>product/find</code>, <code>contract/find</code>, contract IDs, and rollover logic yourself? <strong class='text-white'>PickMyTrade links your TradingView alerts straight to your Tradovate account</strong> and resolves the correct live contract for you, so orders fire on the right symbol automatically, without you writing a single line of API code." },
  ], de: [
    { type: "paragraph",html: "Bevor Ihr Code ein Quote abrufen oder eine Order auslösen kann, muss er den genauen Kontrakt benennen, den Tradovate erwartet. Wenn Sie einen Trading-Bot bauen, eine numerische Kontrakt-ID wieder einem lesbaren Ticker zuordnen oder Automatisierung wie PickMyTrade einrichten, beginnt hier Ihr Weg. Unten lösen Sie Symbole und Kontrakt-IDs mit den Endpunkten <code>product/find</code> und <code>contract/find</code> auf, Schritt für Schritt." },
    { type: "heading",text: "Was sind Produkte, Kontrakte und Symbole in der Tradovate-API?" },
    { type: "paragraph",html: "Tradovate gliedert die Futures-Welt in eine kleine dreistufige Hierarchie, und sobald Sie sie verstanden haben, wird der Rest der API deutlich einfacher." },
    { type: "paragraph",html: "Ein <strong class='text-white'>Produkt</strong> ist die Instrumentenfamilie, „ES“ oder „MES“, ohne Verfallsdatum. Ein <strong class='text-white'>Kontrakt</strong> ist eine bestimmte Fälligkeit dieses Produkts, geschrieben als Symbol wie <code>MESU5</code>, das ist das, was Sie tatsächlich handeln. Und jeder Kontrakt trägt eine numerische <strong class='text-white'>Kontrakt-ID</strong>, die die API in Positionen, Orders und Fills zurückgibt. Die Symbolsuche bewegt sich lediglich zwischen diesen dreien: ein Produkt benennen, seine aktuellen Kontrakte erhalten und eine ID in etwas übersetzen, das ein Mensch lesen kann." },
    { type: "heading",text: "Kontrakte & Symbole über die Tradovate-API finden: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Authentifizieren und ein Access-Token erhalten", html: "Jede Abfrage ist eine authentifizierte HTTPS-Anfrage, besorgen Sie sich daher zuerst ein Bearer-Token. Senden Sie Ihre Zugangsdaten und App-Details per POST an <code>/auth/accessTokenRequest</code>; die Antwort enthält ein <code>accessToken</code>, das Sie bei jedem weiteren Aufruf in einem <code>Authorization: Bearer</code>-Header mitsenden. Schicken Sie es an den passenden Host, <code>demo.tradovateapi.com/v1</code> für die Simulationsumgebung oder <code>live.tradovateapi.com/v1</code>, wenn echtes Geld im Spiel ist." },
        { title: "Das Produkt mit product/find nachschlagen", html: "Lösen Sie zuerst die Instrumentenfamilie auf. Rufen Sie <code>GET /product/find?name=MES</code> mit Ihrem Token auf, und Tradovate liefert das Produktobjekt zurück, seine numerische <code>id</code>, seinen <code>name</code> und den Produkttyp. Merken Sie sich die Produkt-<code>id</code>, denn mit ihr zählen Sie alle Kontrakte des Instruments auf. Es gibt keinen öffentlichen Endpunkt „alle Symbole auflisten“, Sie beginnen also immer mit einer Wurzel, die Sie bereits kennen, ES, NQ, CL, und fragen von dort aus nach außen ab." },
        { title: "Den aktiven Kontrakt mit contract/find oder contract/suggest auflösen", html: "Jetzt machen Sie aus diesem Produkt etwas Handelbares. <code>GET /contract/suggest?t=MES</code> liefert passende Kontrakte, sortiert mit der besten Fälligkeit zuerst, Index 0 ist in der Regel der Frontmonat. <code>GET /contract/find?name=MESU5</code> löst einen exakten Symbol-String zum vollständigen Kontraktobjekt auf, einschließlich der numerischen Kontrakt-<code>id</code>, die Sie an Order- und Marktdaten-Aufrufe übergeben. Ein Stolperstein, den Sie sich einprägen sollten: Fortlaufende Chart-Ticker wie <code>@MES</code> sind für das Charting in Ordnung, aber Sie können sie nicht handeln. Sie brauchen das datierte Kontraktsymbol, das dieser Schritt liefert." },
        { title: "Eine ID umkehren oder den Verfall mit contract/item und contractMaturity bestätigen", html: "Manchmal gehen Sie in die andere Richtung: Sie haben eine Kontrakt-<code>id</code> aus einer Position oder Order und benötigen den Ticker. Rufen Sie <code>GET /contract/item?id=&lt;id&gt;</code> auf, um <code>name</code>, <code>productId</code> und <code>contractMaturityId</code> des Kontrakts zu erhalten. Möchten Sie wissen, wie nah er am Verfall ist? Übergeben Sie diese <code>contractMaturityId</code> an <code>GET /contractMaturity/item?id=&lt;id&gt;</code> und lesen Sie das <code>expirationDate</code>. Den Roll anhand der Tage bis zum Verfall zu steuern ist besser, als sich nahe dem Roll auf ein einzelnes „Front“-Flag zu verlassen, das unter Ihnen umspringen kann." },
      ],
    },
    { type: "heading",text: "So lesen Sie ein Tradovate-Futures-Symbol" },
    { type: "paragraph",html: "Ein datiertes Futures-Symbol besteht aus drei Teilen, die ohne Leerzeichen aneinandergehängt sind: <strong class='text-white'>Instrument + Monatscode + letzte Ziffer des Jahres</strong>. <code>MESU5</code> ist also MES (Micro E-mini S&amp;P 500) + U (September) + 5 (2025). Die Monatscodes ändern sich von Jahr zu Jahr nicht, es lohnt sich also, sie einmal auswendig zu lernen:" },
    { type: "table", headers: ["Code","Monat","Code","Monat"], rows: [
      ["F","Januar","N","Juli"],
      ["G","Februar","Q","August"],
      ["H","März","U","September"],
      ["J","April","V","Oktober"],
      ["K","Mai","X","November"],
      ["M","Juni","Z","Dezember"],
    ] },
    { type: "heading",text: "Wofür Sie das brauchen" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Orders platzieren</strong>, jede Order braucht ein gültiges, nicht abgelaufenes Kontraktsymbol oder eine ID, die vor dem Senden aufgelöst wurde.",
        "<strong class='text-white'>Marktdaten abonnieren</strong>, Quote- und Chart-Abonnements beziehen sich auf den exakten Kontrakt.",
        "<strong class='text-white'>Positionen und Fills lesen</strong>, die API liefert numerische IDs, die Sie für Logs und Dashboards wieder auf Ticker abbilden.",
        "<strong class='text-white'>Rollovers automatisieren</strong>, den Frontmonat erkennen und auf den nächsten Kontrakt rollen, wenn der Verfall näher rückt.",
      ],
    },
    { type: "heading",text: "Automatisieren Sie das mit PickMyTrade" },
    { type: "paragraph",html: "Haben Sie keine Lust, <code>product/find</code>, <code>contract/find</code>, Kontrakt-IDs und Rollover-Logik selbst zu jonglieren? <strong class='text-white'>PickMyTrade verknüpft Ihre TradingView-Alerts direkt mit Ihrem Tradovate-Konto</strong> und löst den richtigen aktuellen Kontrakt für Sie auf, sodass Orders automatisch auf dem richtigen Symbol ausgelöst werden, ohne dass Sie eine einzige Zeile API-Code schreiben müssen." },
  ], es: [
    { type: "paragraph",html: "Antes de que su código pueda obtener una cotización o lanzar una orden, tiene que nombrar el contrato exacto que Tradovate espera. Si está creando un bot de trading, asociando un ID de contrato numérico con un ticker legible o configurando automatización como PickMyTrade, aquí es donde empieza todo. A continuación resolverá símbolos e ID de contrato con los endpoints <code>product/find</code> y <code>contract/find</code>, paso a paso." },
    { type: "heading",text: "¿Qué son los productos, contratos y símbolos en la API de Tradovate?" },
    { type: "paragraph",html: "Tradovate divide el mundo de los futuros en una pequeña jerarquía de tres niveles, y una vez que se entiende, el resto de la API resulta mucho más sencillo." },
    { type: "paragraph",html: "Un <strong class='text-white'>producto</strong> es la familia del instrumento, «ES» o «MES», sin vencimiento asociado. Un <strong class='text-white'>contrato</strong> es un vencimiento concreto de ese producto, escrito como un símbolo como <code>MESU5</code>, que es lo que realmente se opera. Y cada contrato lleva un <strong class='text-white'>ID de contrato</strong> numérico, que es lo que la API devuelve en posiciones, órdenes y fills. La búsqueda de símbolos consiste simplemente en moverse entre esos tres elementos: nombrar un producto, obtener sus contratos vigentes y traducir un ID a algo que una persona pueda leer." },
    { type: "heading",text: "Encuentre contratos y símbolos con la API de Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Autentíquese y obtenga un token de acceso", html: "Cada consulta es una solicitud HTTPS autenticada, así que obtenga primero un token bearer. Haga POST con sus credenciales y los datos de su aplicación a <code>/auth/accessTokenRequest</code>; la respuesta incluye un <code>accessToken</code> que debe adjuntar a cada llamada posterior en una cabecera <code>Authorization: Bearer</code>. Envíelo al host correspondiente, <code>demo.tradovateapi.com/v1</code> para el entorno de simulación o <code>live.tradovateapi.com/v1</code> cuando hay dinero real en juego." },
        { title: "Busque el producto con product/find", html: "Resuelva primero la familia del instrumento. Llame a <code>GET /product/find?name=MES</code> con su token y Tradovate devuelve el objeto de producto, su <code>id</code> numérico, su <code>name</code> y el tipo de producto. Conserve el <code>id</code> del producto, porque es la clave que reutilizará para enumerar todos los contratos del instrumento. No existe un endpoint público para «listar todos los símbolos», así que siempre parte de una raíz que ya conoce, ES, NQ, CL, y consulta hacia afuera desde ahí." },
        { title: "Resuelva el contrato activo con contract/find o contract/suggest", html: "Ahora convierta ese producto en algo operable. <code>GET /contract/suggest?t=MES</code> devuelve los contratos coincidentes ordenados con el mejor vencimiento primero; el índice 0 suele ser el mes frontal. <code>GET /contract/find?name=MESU5</code> resuelve una cadena de símbolo exacta al objeto de contrato completo, incluido el <code>id</code> numérico del contrato que pasará a las llamadas de órdenes y de datos de mercado. Un detalle que conviene grabarse: los tickers continuos de gráfico como <code>@MES</code> sirven para graficar, pero no se pueden operar. Necesita el símbolo del contrato con fecha que le da este paso." },
        { title: "Invierta un ID o confirme el vencimiento con contract/item y contractMaturity", html: "A veces va en la dirección contraria: tiene un <code>id</code> de contrato de una posición o una orden y necesita el ticker. Llame a <code>GET /contract/item?id=&lt;id&gt;</code> para obtener el <code>name</code>, el <code>productId</code> y el <code>contractMaturityId</code> del contrato. ¿Quiere saber lo cerca que está de vencer? Pase ese <code>contractMaturityId</code> a <code>GET /contractMaturity/item?id=&lt;id&gt;</code> y lea el <code>expirationDate</code>. Hacer el roll según los días hasta el vencimiento es mejor que fiarse de un único indicador «front» cerca del roll, cuando ese indicador puede cambiar de un momento a otro." },
      ],
    },
    { type: "heading",text: "Cómo leer un símbolo de futuros de Tradovate" },
    { type: "paragraph",html: "Un símbolo de futuros con fecha son tres partes pegadas sin espacios: <strong class='text-white'>instrumento + código de mes + último dígito del año</strong>. Así, <code>MESU5</code> es MES (Micro E-mini S&amp;P 500) + U (septiembre) + 5 (2025). Los códigos de mes no cambian de un año a otro, así que conviene memorizarlos una vez:" },
    { type: "table", headers: ["Código","Mes","Código","Mes"], rows: [
      ["F","Enero","N","Julio"],
      ["G","Febrero","Q","Agosto"],
      ["H","Marzo","U","Septiembre"],
      ["J","Abril","V","Octubre"],
      ["K","Mayo","X","Noviembre"],
      ["M","Junio","Z","Diciembre"],
    ] },
    { type: "heading",text: "Por qué lo necesitaría" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Colocar órdenes</strong>, cada orden necesita un símbolo o ID de contrato válido y no vencido, resuelto antes de enviarla.",
        "<strong class='text-white'>Suscribirse a datos de mercado</strong>, las suscripciones de cotizaciones y gráficos dependen del contrato exacto.",
        "<strong class='text-white'>Leer posiciones y fills</strong>, la API le entrega ID numéricos, y usted los asocia de nuevo a tickers para registros y paneles.",
        "<strong class='text-white'>Automatizar rollovers</strong>, detecte el mes frontal y haga el roll al siguiente contrato a medida que se acerca el vencimiento.",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "¿No quiere malabarear con <code>product/find</code>, <code>contract/find</code>, ID de contrato y lógica de rollover por su cuenta? <strong class='text-white'>PickMyTrade enlaza sus alertas de TradingView directamente con su cuenta de Tradovate</strong> y resuelve por usted el contrato vigente correcto, de modo que las órdenes se ejecutan automáticamente en el símbolo adecuado, sin que escriba una sola línea de código de API." },
  ], fr: [
    { type: "paragraph",html: "Avant que votre code puisse récupérer une cotation ou envoyer un ordre, il doit nommer le contrat exact attendu par Tradovate. Si vous construisez un bot de trading, associez un identifiant de contrat numérique à un ticker lisible ou mettez en place une automatisation comme PickMyTrade, c’est ici que tout commence. Ci-dessous, vous allez résoudre symboles et identifiants de contrat avec les endpoints <code>product/find</code> et <code>contract/find</code>, étape par étape." },
    { type: "heading",text: "Que sont les produits, contrats et symboles dans l’API Tradovate ?" },
    { type: "paragraph",html: "Tradovate découpe l’univers des contrats à terme en une petite hiérarchie à trois niveaux, et une fois celle-ci comprise, le reste de l’API devient bien plus simple." },
    { type: "paragraph",html: "Un <strong class='text-white'>produit</strong> est la famille d’instruments, « ES » ou « MES », sans échéance associée. Un <strong class='text-white'>contrat</strong> est une échéance précise de ce produit, écrite sous la forme d’un symbole comme <code>MESU5</code>, c’est ce que vous tradez réellement. Et chaque contrat porte un <strong class='text-white'>identifiant de contrat</strong> numérique, que l’API renvoie dans les positions, ordres et exécutions. La recherche de symboles consiste simplement à passer de l’un à l’autre : nommer un produit, obtenir ses contrats en vigueur et traduire un identifiant en quelque chose que l’on peut lire." },
    { type: "heading",text: "Trouver contrats et symboles via l’API Tradovate : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Authentifiez-vous et obtenez un jeton d’accès", html: "Chaque recherche est une requête HTTPS authentifiée ; procurez-vous donc d’abord un jeton bearer. Envoyez par POST vos identifiants et les détails de votre application à <code>/auth/accessTokenRequest</code> ; la réponse contient un <code>accessToken</code> que vous joignez à chaque appel suivant dans un en-tête <code>Authorization: Bearer</code>. Envoyez-le à l’hôte correspondant, <code>demo.tradovateapi.com/v1</code> pour l’environnement de simulation, ou <code>live.tradovateapi.com/v1</code> lorsque de l’argent réel est en jeu." },
        { title: "Recherchez le produit avec product/find", html: "Résolvez d’abord la famille d’instruments. Appelez <code>GET /product/find?name=MES</code> avec votre jeton, et Tradovate renvoie l’objet produit, son <code>id</code> numérique, son <code>name</code> et le type de produit. Conservez l’<code>id</code> du produit, car c’est la clé que vous réutiliserez pour énumérer tous les contrats de l’instrument. Il n’existe aucun endpoint public pour « lister tous les symboles » ; vous partez donc toujours d’une racine que vous connaissez déjà, ES, NQ, CL, et interrogez vers l’extérieur à partir de là." },
        { title: "Résolvez le contrat actif avec contract/find ou contract/suggest", html: "Transformez maintenant ce produit en quelque chose de négociable. <code>GET /contract/suggest?t=MES</code> renvoie les contrats correspondants triés avec la meilleure échéance en premier ; l’index 0 correspond généralement au mois en cours (front month). <code>GET /contract/find?name=MESU5</code> résout une chaîne de symbole exacte en objet contrat complet, y compris l’<code>id</code> numérique du contrat que vous transmettrez aux appels d’ordres et de données de marché. Un piège à graver dans votre mémoire : les tickers continus de graphique comme <code>@MES</code> conviennent pour les graphiques, mais vous ne pouvez pas les trader. Il vous faut le symbole du contrat daté que cette étape fournit." },
        { title: "Inversez un identifiant ou confirmez l’échéance avec contract/item et contractMaturity", html: "Parfois, vous allez dans l’autre sens : vous avez l’<code>id</code> d’un contrat issu d’une position ou d’un ordre, et il vous faut le ticker. Appelez <code>GET /contract/item?id=&lt;id&gt;</code> pour obtenir le <code>name</code>, le <code>productId</code> et le <code>contractMaturityId</code> du contrat. Vous voulez savoir si l’échéance approche ? Transmettez ce <code>contractMaturityId</code> à <code>GET /contractMaturity/item?id=&lt;id&gt;</code> et lisez l’<code>expirationDate</code>. Effectuer le roll en fonction du nombre de jours avant l’échéance vaut mieux que de se fier à un unique indicateur « front » près du roll, lorsque cet indicateur peut basculer sans prévenir." },
      ],
    },
    { type: "heading",text: "Comment lire un symbole de contrat à terme Tradovate" },
    { type: "paragraph",html: "Un symbole de contrat à terme daté est constitué de trois parties collées sans espace : <strong class='text-white'>instrument + code du mois + dernier chiffre de l’année</strong>. Ainsi, <code>MESU5</code> correspond à MES (Micro E-mini S&amp;P 500) + U (septembre) + 5 (2025). Les codes de mois ne changent pas d’une année à l’autre ; autant les mémoriser une bonne fois :" },
    { type: "table", headers: ["Code","Mois","Code","Mois"], rows: [
      ["F","Janvier","N","Juillet"],
      ["G","Février","Q","Août"],
      ["H","Mars","U","Septembre"],
      ["J","Avril","V","Octobre"],
      ["K","Mai","X","Novembre"],
