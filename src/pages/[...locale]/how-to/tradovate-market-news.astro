---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-market-news";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Access Market News Inside Tradovate";
const META_DESCRIPTION =
  "Open the built-in real-time futures news feed, read market-moving headlines, and dock a live news panel to your trading workspace in a few clicks.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Marktnachrichten direkt in Tradovate abrufen", es: "Acceda a las noticias del mercado dentro de Tradovate", fr: "Accéder aux actualités du marché dans Tradovate", it: "Accedere alle notizie di mercato in Tradovate" },
  dek: { en: "Futures move fast when a headline drops. Here's how to open Tradovate's built-in news feed, read the stories that matter, and keep a news panel on screen while you work the ladder.", de: "Futures bewegen sich schnell, sobald eine Schlagzeile erscheint. So öffnen Sie den integrierten Nachrichtenfeed von Tradovate, lesen die wichtigen Meldungen und behalten ein News-Panel im Blick, während Sie die Leiter handeln.", es: "Los futuros se mueven rápido cuando sale un titular. Así se abre el feed de noticias integrado de Tradovate, se leen las noticias que importan y se mantiene un panel de noticias en pantalla mientras trabaja en la escalera.", fr: "Les contrats à terme bougent vite dès qu'un titre tombe. Voici comment ouvrir le flux d'actualités intégré de Tradovate, lire les articles qui comptent et garder un panneau d'actualités à l'écran pendant que vous travaillez sur l'échelle.", it: "I futures si muovono in fretta quando esce un titolo. Ecco come aprire il feed di notizie integrato di Tradovate, leggere le notizie che contano e tenere un pannello news sullo schermo mentre lavora sulla ladder." },
  readTime: { en: "4 min read", de: "4 Min. Lesezeit", es: "Lectura de 4 min", fr: "Lecture : 4 min", it: "Lettura di 4 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Futures move fast when a headline drops, and jumping to a separate news site mid-trade is a good way to miss the fill you wanted. You don't need a second monitor or a paid news terminal for the basics. Tradovate has a live news feed baked right into the platform, and it pulls from more than a dozen sources. Here's how to open it, read the stories that matter, and keep a news panel on screen while you work the ladder." },
    { type: "quote", html: "<strong class='text-white'>Quick answer:</strong> Click the globe icon in the top-right corner of the Tradovate toolbar. That opens the current news feed with the latest headlines. Click any headline to read it, then choose <em>View Full Article</em> to open the full story in a new window." },
    { type: "heading", text: "What the Built-In News Feed Gives You" },
    { type: "paragraph", html: "The feed is a rolling list of headlines aggregated from an RSS mix of over a dozen providers, so you get general market coverage and economic-release chatter without leaving your trading screen. It's meant for staying aware, not for live quotes. Streaming prices are a separate thing tied to your market data subscription, so reading news won't cost you a data fee, but it also won't replace a real-time feed." },
    { type: "heading", text: "Open Tradovate Market News: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Find the Globe Icon", html: "Log in to Tradovate on web or desktop and look at the top-right corner of the main toolbar. The small globe icon is the shortcut for current news. It sits near the account and settings controls, away from the order and chart tools on the left.", image: { src: `${IMG}/tradovate-market-news-1.png`, alt: "Tradovate toolbar with the globe news icon highlighted in the top-right corner" } },
        { title: "Open the Headlines", html: "Click the globe. A panel drops down with the newest stories at the top, each showing a headline and a timestamp. Scroll to move back through older items. Because the feed blends more than a dozen sources, you'll see a broad spread of financial and economic coverage rather than a single wire.", image: { src: `${IMG}/tradovate-market-news-2.png`, alt: "Tradovate news feed panel showing a list of recent market headlines with timestamps" } },
        { title: "Read the Full Story", html: "Headlines alone rarely tell you enough. Click one to expand the preview, then click <em>View Full Article</em> to open the complete piece in a new browser window. Your Tradovate workspace stays exactly where you left it, so you can read the detail and flip straight back to your positions.", image: { src: `${IMG}/tradovate-market-news-3.png`, alt: "Expanded Tradovate news story with a View Full Article button to open the source in a new window" } },
        { title: "Keep a News Panel on Your Workspace", html: "If you'd rather have headlines always visible instead of clicking the globe each time, add News as a docked module. Click the <strong class='text-white'>+ (New)</strong> button at the top-left of the platform, find the News module, and drag and drop it anywhere in your layout. It behaves like any other panel, so you can resize it and save it with the rest of your workspace. Now it loads automatically every time you sign in.", image: { src: `${IMG}/tradovate-market-news-4.png`, alt: "Tradovate workspace with a docked News module sitting alongside a chart and the order ticket" } },
      ],
    },
    { type: "heading", text: "Managing News Pop-Ups" },
    { type: "paragraph", html: "Tradovate can flash a small pop-up when a fresh story lands, which is handy on quiet days and annoying during a busy session. If those alerts pull your attention at the wrong moment, open the platform settings and look for the news or notification toggle to turn them off. The exact wording of that control shifts between releases, so check the current settings menu rather than hunting for an old label." },
    { type: "heading", text: "Prop Firm and Evaluation Accounts" },
    { type: "paragraph", html: "The news feed itself works the same whether you're on a personal account or a prop-firm evaluation. What differs is your live data. Real-time quotes depend on a market-data subscription, and on evaluation accounts that entitlement is usually controlled by your firm, not by you. Data rules, delayed-vs-live status, and any fees vary by firm and account size, so check your firm's current rules if your prices look off while the news keeps flowing." },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Want headlines <em>and</em> hands-off execution? <strong class='text-white'>PickMyTrade wires your TradingView alerts straight to your Tradovate account</strong> so your signals fire automatically while you keep an eye on the news." },
  ], de: [
    { type: "paragraph",html: "Futures bewegen sich schnell, wenn eine Schlagzeile erscheint, und mitten im Trade auf eine separate Nachrichtenseite zu wechseln, ist ein guter Weg, den gewünschten Fill zu verpassen. Für die Grundlagen brauchen Sie weder einen zweiten Monitor noch ein kostenpflichtiges Nachrichtenterminal. Tradovate hat einen Live-Nachrichtenfeed fest in die Plattform integriert, der aus mehr als einem Dutzend Quellen speist. So öffnen Sie ihn, lesen die wichtigen Meldungen und behalten ein News-Panel im Blick, während Sie die Leiter handeln." },
    { type: "quote",html: "<strong class='text-white'>Kurze Antwort:</strong> Klicken Sie in der Tradovate-Symbolleiste oben rechts auf das Globus-Symbol. Damit öffnet sich der aktuelle Nachrichtenfeed mit den neuesten Schlagzeilen. Klicken Sie auf eine Schlagzeile, um sie zu lesen, und wählen Sie dann <em>View Full Article</em>, um den vollständigen Artikel in einem neuen Fenster zu öffnen." },
    { type: "heading",text: "Was der integrierte Nachrichtenfeed bietet" },
    { type: "paragraph",html: "Der Feed ist eine fortlaufende Liste von Schlagzeilen, die aus einem RSS-Mix von mehr als einem Dutzend Anbietern zusammengestellt wird. So erhalten Sie allgemeine Marktberichterstattung und Meldungen zu Wirtschaftsdaten, ohne Ihren Trading-Bildschirm zu verlassen. Er dient dazu, auf dem Laufenden zu bleiben, nicht für Live-Kurse. Streaming-Kurse sind eine separate Sache und hängen von Ihrem Marktdaten-Abonnement ab. Das Lesen von Nachrichten kostet Sie also keine Datengebühr, ersetzt aber auch keinen Echtzeit-Feed." },
    { type: "heading",text: "Tradovate-Marktnachrichten öffnen: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Das Globus-Symbol finden", html: "Melden Sie sich bei Tradovate im Web oder auf dem Desktop an und sehen Sie in die obere rechte Ecke der Hauptsymbolleiste. Das kleine Globus-Symbol ist die Verknüpfung zu den aktuellen Nachrichten. Es befindet sich in der Nähe der Konto- und Einstellungssteuerelemente, abseits der Order- und Chart-Werkzeuge auf der linken Seite.", image: {"src":`${IMG}/tradovate-market-news-1.png`,"alt":"Tradovate-Symbolleiste mit hervorgehobenem Globus-Nachrichtensymbol in der oberen rechten Ecke"} },
        { title: "Die Schlagzeilen öffnen", html: "Klicken Sie auf den Globus. Ein Panel klappt auf, in dem die neuesten Meldungen oben stehen, jeweils mit Schlagzeile und Zeitstempel. Scrollen Sie, um ältere Einträge zu sehen. Da der Feed mehr als ein Dutzend Quellen vereint, sehen Sie eine breite Auswahl an Finanz- und Wirtschaftsberichterstattung statt nur einer einzigen Agentur.", image: {"src":`${IMG}/tradovate-market-news-2.png`,"alt":"Tradovate-Nachrichtenfeed-Panel mit einer Liste aktueller Marktschlagzeilen samt Zeitstempeln"} },
        { title: "Die vollständige Meldung lesen", html: "Schlagzeilen allein sagen selten genug aus. Klicken Sie auf eine, um die Vorschau zu erweitern, und klicken Sie dann auf <em>View Full Article</em>, um den kompletten Beitrag in einem neuen Browserfenster zu öffnen. Ihr Tradovate-Arbeitsbereich bleibt genau so, wie Sie ihn verlassen haben, sodass Sie die Details lesen und direkt zu Ihren Positionen zurückwechseln können.", image: {"src":`${IMG}/tradovate-market-news-3.png`,"alt":"Erweiterte Tradovate-Nachricht mit einer View-Full-Article-Schaltfläche, um die Quelle in einem neuen Fenster zu öffnen"} },
        { title: "Ein News-Panel im Arbeitsbereich behalten", html: "Wenn Sie die Schlagzeilen lieber dauerhaft sichtbar haben, statt jedes Mal auf den Globus zu klicken, fügen Sie News als angedocktes Modul hinzu. Klicken Sie oben links in der Plattform auf die Schaltfläche <strong class='text-white'>+ (New)</strong>, suchen Sie das Modul News und ziehen Sie es per Drag-and-drop an eine beliebige Stelle Ihres Layouts. Es verhält sich wie jedes andere Panel: Sie können die Größe ändern und es zusammen mit dem Rest Ihres Arbeitsbereichs speichern. Danach wird es bei jeder Anmeldung automatisch geladen.", image: {"src":`${IMG}/tradovate-market-news-4.png`,"alt":"Tradovate-Arbeitsbereich mit einem angedockten News-Modul neben einem Chart und dem Order-Ticket"} },
      ],
    },
    { type: "heading",text: "Nachrichten-Pop-ups verwalten" },
    { type: "paragraph",html: "Tradovate kann ein kleines Pop-up einblenden, sobald eine neue Meldung eintrifft. Das ist an ruhigen Tagen praktisch und in einer hektischen Sitzung lästig. Wenn Sie diese Hinweise im falschen Moment ablenken, öffnen Sie die Plattformeinstellungen und suchen Sie nach dem Schalter für News oder Benachrichtigungen, um sie auszuschalten. Die genaue Bezeichnung dieser Option ändert sich zwischen den Versionen. Sehen Sie daher im aktuellen Einstellungsmenü nach, statt nach einer veralteten Bezeichnung zu suchen." },
    { type: "heading",text: "Prop-Firm- und Evaluierungskonten" },
    { type: "paragraph",html: "Der Nachrichtenfeed selbst funktioniert gleich, egal ob Sie ein persönliches Konto oder eine Prop-Firm-Evaluierung nutzen. Der Unterschied liegt in Ihren Live-Daten. Echtzeitkurse hängen von einem Marktdaten-Abonnement ab, und bei Evaluierungskonten wird diese Berechtigung in der Regel von Ihrer Firma gesteuert, nicht von Ihnen. Datenregeln, verzögerter oder Live-Status und etwaige Gebühren unterscheiden sich je nach Firma und Kontogröße. Prüfen Sie daher die aktuellen Regeln Ihrer Firma, falls Ihre Kurse nicht stimmen, während die Nachrichten weiterlaufen." },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "Möchten Sie Schlagzeilen <em>und</em> automatische Ausführung? <strong class='text-white'>PickMyTrade verbindet Ihre TradingView-Alerts direkt mit Ihrem Tradovate-Konto</strong>, sodass Ihre Signale automatisch ausgelöst werden, während Sie die Nachrichten im Auge behalten." },
  ], es: [
    { type: "paragraph",html: "Los futuros se mueven rápido cuando sale un titular, y saltar a un sitio de noticias aparte en plena operación es una buena forma de perder el fill que quería. No necesita un segundo monitor ni un terminal de noticias de pago para lo básico. Tradovate incluye un feed de noticias en vivo integrado en la plataforma, que reúne más de una docena de fuentes. Así se abre, se leen las noticias que importan y se mantiene un panel de noticias en pantalla mientras trabaja en la escalera." },
    { type: "quote",html: "<strong class='text-white'>Respuesta rápida:</strong> haga clic en el icono del globo en la esquina superior derecha de la barra de herramientas de Tradovate. Se abre el feed de noticias actual con los últimos titulares. Haga clic en cualquier titular para leerlo y luego elija <em>View Full Article</em> para abrir la noticia completa en una ventana nueva." },
    { type: "heading",text: "Lo que ofrece el feed de noticias integrado" },
    { type: "paragraph",html: "El feed es una lista continua de titulares agregados a partir de una combinación RSS de más de una docena de proveedores, de modo que obtiene cobertura general del mercado y comentarios sobre publicaciones económicas sin salir de su pantalla de trading. Está pensado para mantenerse informado, no para cotizaciones en vivo. Los precios en streaming son un asunto aparte, vinculado a su suscripción de datos de mercado, así que leer noticias no le costará una tarifa de datos, pero tampoco sustituye un feed en tiempo real." },
    { type: "heading",text: "Abrir las noticias de mercado de Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Localice el icono del globo", html: "Inicie sesión en Tradovate en la web o en el escritorio y mire la esquina superior derecha de la barra de herramientas principal. El pequeño icono del globo es el acceso directo a las noticias actuales. Se encuentra cerca de los controles de cuenta y configuración, lejos de las herramientas de órdenes y gráficos de la izquierda.", image: {"src":`${IMG}/tradovate-market-news-1.png`,"alt":"Barra de herramientas de Tradovate con el icono del globo de noticias resaltado en la esquina superior derecha"} },
        { title: "Abra los titulares", html: "Haga clic en el globo. Se despliega un panel con las noticias más recientes arriba, cada una con su titular y una marca de tiempo. Desplácese para retroceder por los elementos más antiguos. Como el feed combina más de una docena de fuentes, verá una amplia variedad de cobertura financiera y económica en lugar de una sola agencia.", image: {"src":`${IMG}/tradovate-market-news-2.png`,"alt":"Panel del feed de noticias de Tradovate con una lista de titulares de mercado recientes y marcas de tiempo"} },
        { title: "Lea la noticia completa", html: "Los titulares por sí solos rara vez bastan. Haga clic en uno para ampliar la vista previa y luego en <em>View Full Article</em> para abrir el artículo completo en una ventana nueva del navegador. Su espacio de trabajo de Tradovate queda exactamente donde lo dejó, así que puede leer el detalle y volver de inmediato a sus posiciones.", image: {"src":`${IMG}/tradovate-market-news-3.png`,"alt":"Noticia de Tradovate ampliada con un botón View Full Article para abrir la fuente en una ventana nueva"} },
        { title: "Mantenga un panel de noticias en su espacio de trabajo", html: "Si prefiere tener los titulares siempre visibles en lugar de hacer clic en el globo cada vez, agregue News como módulo acoplado. Haga clic en el botón <strong class='text-white'>+ (New)</strong> en la parte superior izquierda de la plataforma, busque el módulo News y arrástrelo y suéltelo en cualquier lugar de su diseño. Se comporta como cualquier otro panel, así que puede cambiarle el tamaño y guardarlo junto con el resto de su espacio de trabajo. A partir de entonces se cargará automáticamente cada vez que inicie sesión.", image: {"src":`${IMG}/tradovate-market-news-4.png`,"alt":"Espacio de trabajo de Tradovate con un módulo News acoplado junto a un gráfico y el ticket de órdenes"} },
      ],
    },
    { type: "heading",text: "Gestión de las ventanas emergentes de noticias" },
    { type: "paragraph",html: "Tradovate puede mostrar una pequeña ventana emergente cuando llega una noticia nueva, algo útil en días tranquilos y molesto durante una sesión intensa. Si esos avisos le distraen en el peor momento, abra la configuración de la plataforma y busque el interruptor de noticias o notificaciones para desactivarlos. El texto exacto de ese control cambia entre versiones, así que consulte el menú de configuración actual en lugar de buscar una etiqueta antigua." },
    { type: "heading",text: "Cuentas de prop firm y de evaluación" },
    { type: "paragraph",html: "El feed de noticias funciona igual tanto si tiene una cuenta personal como una evaluación de prop firm. Lo que cambia son sus datos en vivo. Las cotizaciones en tiempo real dependen de una suscripción de datos de mercado y, en las cuentas de evaluación, ese derecho suele controlarlo su firma, no usted. Las reglas de datos, el estado diferido o en vivo y las posibles tarifas varían según la firma y el tamaño de la cuenta, así que revise las reglas actuales de su firma si sus precios parecen incorrectos mientras las noticias siguen llegando." },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "¿Quiere titulares <em>y</em> ejecución automática? <strong class='text-white'>PickMyTrade conecta sus alertas de TradingView directamente con su cuenta de Tradovate</strong>, para que sus señales se ejecuten solas mientras usted sigue las noticias." },
  ], fr: [
    { type: "paragraph",html: "Les contrats à terme bougent vite quand un titre tombe, et passer sur un site d'actualités distinct en plein trade est un bon moyen de rater l'exécution souhaitée. Pour l'essentiel, vous n'avez besoin ni d'un second écran ni d'un terminal d'actualités payant. Tradovate intègre directement à la plateforme un flux d'actualités en direct, alimenté par plus d'une douzaine de sources. Voici comment l'ouvrir, lire les articles qui comptent et garder un panneau d'actualités à l'écran pendant que vous travaillez sur l'échelle." },
    { type: "quote",html: "<strong class='text-white'>Réponse rapide :</strong> cliquez sur l'icône du globe dans le coin supérieur droit de la barre d'outils Tradovate. Le flux d'actualités actuel s'ouvre avec les derniers titres. Cliquez sur un titre pour le lire, puis choisissez <em>View Full Article</em> pour ouvrir l'article complet dans une nouvelle fenêtre." },
    { type: "heading",text: "Ce que vous offre le flux d'actualités intégré" },
    { type: "paragraph",html: "Le flux est une liste défilante de titres agrégés à partir d'un ensemble RSS de plus d'une douzaine de fournisseurs. Vous obtenez ainsi une couverture générale du marché et les commentaires sur les publications économiques sans quitter votre écran de trading. Il sert à rester informé, pas à obtenir des cotations en direct. Les prix en streaming sont une autre affaire, liée à votre abonnement aux données de marché : lire les actualités ne vous coûtera donc aucun frais de données, mais ne remplace pas non plus un flux en temps réel." },
    { type: "heading",text: "Ouvrir les actualités de marché Tradovate : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Repérer l'icône du globe", html: "Connectez-vous à Tradovate sur le web ou le bureau et regardez le coin supérieur droit de la barre d'outils principale. La petite icône de globe est le raccourci vers les actualités du moment. Elle se trouve près des commandes de compte et de paramètres, à l'écart des outils d'ordres et de graphiques situés à gauche.", image: {"src":`${IMG}/tradovate-market-news-1.png`,"alt":"Barre d'outils Tradovate avec l'icône de globe des actualités mise en évidence dans le coin supérieur droit"} },
        { title: "Ouvrir les titres", html: "Cliquez sur le globe. Un panneau se déroule avec les articles les plus récents en haut, chacun avec un titre et un horodatage. Faites défiler pour remonter dans les éléments plus anciens. Comme le flux combine plus d'une douzaine de sources, vous voyez un large éventail de couverture financière et économique plutôt qu'une seule agence.", image: {"src":`${IMG}/tradovate-market-news-2.png`,"alt":"Panneau du flux d'actualités Tradovate affichant une liste de titres de marché récents avec horodatages"} },
        { title: "Lire l'article complet", html: "Les titres seuls en disent rarement assez. Cliquez sur l'un d'eux pour développer l'aperçu, puis sur <em>View Full Article</em> pour ouvrir l'article complet dans une nouvelle fenêtre de navigateur. Votre espace de travail Tradovate reste exactement dans l'état où vous l'avez laissé : vous pouvez lire le détail puis revenir aussitôt à vos positions.", image: {"src":`${IMG}/tradovate-market-news-3.png`,"alt":"Article Tradovate développé avec un bouton View Full Article pour ouvrir la source dans une nouvelle fenêtre"} },
        { title: "Garder un panneau d'actualités dans votre espace de travail", html: "Si vous préférez avoir les titres toujours visibles plutôt que de cliquer sur le globe à chaque fois, ajoutez News comme module ancré. Cliquez sur le bouton <strong class='text-white'>+ (New)</strong> en haut à gauche de la plateforme, trouvez le module News et faites-le glisser-déposer où vous voulez dans votre disposition. Il se comporte comme n'importe quel autre panneau : vous pouvez le redimensionner et l'enregistrer avec le reste de votre espace de travail. Il se chargera alors automatiquement à chaque connexion.", image: {"src":`${IMG}/tradovate-market-news-4.png`,"alt":"Espace de travail Tradovate avec un module News ancré à côté d'un graphique et du ticket d'ordre"} },
      ],
    },
    { type: "heading",text: "Gérer les fenêtres contextuelles d'actualités" },
    { type: "paragraph",html: "Tradovate peut afficher une petite fenêtre contextuelle lorsqu'un nouvel article arrive, ce qui est pratique les jours calmes et agaçant pendant une séance chargée. Si ces alertes détournent votre attention au mauvais moment, ouvrez les paramètres de la plateforme et cherchez l'option d'actualités ou de notifications pour les désactiver. Le libellé exact de cette commande change selon les versions : consultez donc le menu de paramètres actuel plutôt que de chercher une ancienne étiquette." },
    { type: "heading",text: "Comptes prop firm et d'évaluation" },
    { type: "paragraph",html: "Le flux d'actualités fonctionne de la même façon que vous soyez sur un compte personnel ou sur une évaluation de prop firm. Ce qui diffère, ce sont vos données en direct. Les cotations en temps réel dépendent d'un abonnement aux données de marché et, sur les comptes d'évaluation, ce droit est généralement contrôlé par votre firme, pas par vous. Les règles de données, le statut différé ou en direct et les frais éventuels varient selon la firme et la taille du compte ; vérifiez donc les règles actuelles de votre firme si vos prix semblent incorrects alors que les actualités continuent d'arriver." },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Vous voulez les titres <em>et</em> une exécution sans intervention ? <strong class='text-white'>PickMyTrade relie directement vos alertes TradingView à votre compte Tradovate</strong>, afin que vos signaux se déclenchent automatiquement pendant que vous gardez un œil sur l'actualité." },
  ], it: [
    { type: "paragraph",html: "I futures si muovono in fretta quando esce un titolo, e passare a un sito di notizie separato nel mezzo di un trade è un buon modo per perdere il fill che voleva. Per le basi non servono né un secondo monitor né un terminale di notizie a pagamento. Tradovate ha un feed di notizie in tempo reale integrato nella piattaforma, che attinge a più di una dozzina di fonti. Ecco come aprirlo, leggere le notizie che contano e tenere un pannello news sullo schermo mentre lavora sulla ladder." },
    { type: "quote",html: "<strong class='text-white'>Risposta rapida:</strong> faccia clic sull'icona del globo nell'angolo in alto a destra della barra degli strumenti di Tradovate. Si apre il feed di notizie attuale con gli ultimi titoli. Faccia clic su un titolo per leggerlo, quindi scelga <em>View Full Article</em> per aprire l'articolo completo in una nuova finestra." },
    { type: "heading",text: "Cosa offre il feed di notizie integrato" },
    { type: "paragraph",html: "Il feed è un elenco continuo di titoli aggregati da un mix RSS di oltre una dozzina di fornitori, così ottiene una copertura generale del mercato e i commenti sui rilasci economici senza lasciare lo schermo di trading. Serve a rimanere aggiornati, non per le quotazioni in tempo reale. I prezzi in streaming sono un'altra cosa, legata al suo abbonamento ai dati di mercato: leggere le notizie non comporta quindi alcun costo per i dati, ma non sostituisce nemmeno un feed in tempo reale." },
    { type: "heading",text: "Aprire le notizie di mercato di Tradovate: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Trovi l'icona del globo", html: "Acceda a Tradovate dal web o dal desktop e guardi l'angolo in alto a destra della barra degli strumenti principale. La piccola icona del globo è la scorciatoia per le notizie attuali. Si trova vicino ai controlli di account e impostazioni, lontano dagli strumenti per ordini e grafici sulla sinistra.", image: {"src":`${IMG}/tradovate-market-news-1.png`,"alt":"Barra degli strumenti di Tradovate con l'icona del globo delle notizie evidenziata nell'angolo in alto a destra"} },
        { title: "Apra i titoli", html: "Faccia clic sul globo. Si apre un pannello con le notizie più recenti in alto, ciascuna con un titolo e un orario. Scorra per tornare agli elementi più vecchi. Poiché il feed unisce più di una dozzina di fonti, vedrà un'ampia gamma di copertura finanziaria ed economica anziché una singola agenzia.", image: {"src":`${IMG}/tradovate-market-news-2.png`,"alt":"Pannello del feed di notizie di Tradovate con un elenco di titoli di mercato recenti e orari"} },
        { title: "Legga la notizia completa", html: "I titoli da soli raramente bastano. Ne selezioni uno per espandere l'anteprima, poi faccia clic su <em>View Full Article</em> per aprire l'articolo completo in una nuova finestra del browser. Il suo spazio di lavoro Tradovate resta esattamente dove lo ha lasciato, così può leggere i dettagli e tornare subito alle sue posizioni.", image: {"src":`${IMG}/tradovate-market-news-3.png`,"alt":"Notizia di Tradovate espansa con un pulsante View Full Article per aprire la fonte in una nuova finestra"} },
        { title: "Tenga un pannello news nel suo spazio di lavoro", html: "Se preferisce avere i titoli sempre visibili invece di fare clic ogni volta sul globo, aggiunga News come modulo ancorato. Faccia clic sul pulsante <strong class='text-white'>+ (New)</strong> in alto a sinistra nella piattaforma, trovi il modulo News e lo trascini dove vuole nel suo layout. Si comporta come qualsiasi altro pannello: può ridimensionarlo e salvarlo insieme al resto dello spazio di lavoro. Da quel momento si caricherà automaticamente a ogni accesso.", image: {"src":`${IMG}/tradovate-market-news-4.png`,"alt":"Spazio di lavoro di Tradovate con un modulo News ancorato accanto a un grafico e al ticket degli ordini"} },
      ],
    },
    { type: "heading",text: "Gestire i pop-up delle notizie" },
    { type: "paragraph",html: "Tradovate può mostrare un piccolo pop-up quando arriva una notizia nuova, utile nei giorni tranquilli e fastidioso durante una sessione intensa. Se questi avvisi la distraggono nel momento sbagliato, apra le impostazioni della piattaforma e cerchi l'interruttore delle notizie o delle notifiche per disattivarli. La dicitura esatta di questo controllo cambia da una versione all'altra, quindi consulti il menu delle impostazioni attuale anziché cercare un'etichetta vecchia." },
    { type: "heading",text: "Account prop firm e di valutazione" },
    { type: "paragraph",html: "Il feed di notizie funziona allo stesso modo sia che abbia un account personale sia una valutazione con una prop firm. Ciò che cambia sono i suoi dati in tempo reale. Le quotazioni in tempo reale dipendono da un abbonamento ai dati di mercato e, sugli account di valutazione, tale diritto è di solito controllato dalla sua firm, non da lei. Le regole sui dati, lo stato ritardato o in tempo reale ed eventuali costi variano in base alla firm e alle dimensioni dell'account, quindi controlli le regole attuali della sua firm se i prezzi le sembrano errati mentre le notizie continuano ad arrivare." },
    { type: "heading",text: "Automatizzi tutto con PickMyTrade" },
    { type: "paragraph",html: "Vuole i titoli <em>e</em> un'esecuzione senza interventi? <strong class='text-white'>PickMyTrade collega i suoi alert di TradingView direttamente al suo account Tradovate</strong>, così i suoi segnali partono in automatico mentre lei tiene d'occhio le notizie." },
  ] },
  ctaHeading: { en: "Trade the News, Automate the Execution", de: "Handeln Sie die Nachrichten, automatisieren Sie die Ausführung", es: "Opere con las noticias, automatice la ejecución", fr: "Tradez l'actualité, automatisez l'exécution", it: "Operi sulle notizie, automatizzi l'esecuzione" },
  ctaText: { en: "Keep the news feed open for context, and let PickMyTrade turn your TradingView alerts into automatic entries, exits, and brackets.", de: "Lassen Sie den Nachrichtenfeed für den Kontext geöffnet und PickMyTrade Ihre TradingView-Alerts in automatische Einstiege, Ausstiege und Brackets verwandeln.", es: "Mantenga abierto el feed de noticias para tener contexto y deje que PickMyTrade convierta sus alertas de TradingView en entradas, salidas y brackets automáticos.", fr: "Gardez le flux d'actualités ouvert pour le contexte et laissez PickMyTrade transformer vos alertes TradingView en entrées, sorties et brackets automatiques.", it: "Tenga aperto il feed di notizie per avere il contesto e lasci che PickMyTrade trasformi i suoi alert di TradingView in ingressi, uscite e bracket automatici." },
