  ctaHeading: { en: "Stop Babysitting Your Charts", de: "Hören Sie auf, Ihre Charts zu bewachen", es: "Deje de vigilar sus gráficos", fr: "Cessez de surveiller vos graphiques", it: "Smetta di sorvegliare i suoi grafici" },
