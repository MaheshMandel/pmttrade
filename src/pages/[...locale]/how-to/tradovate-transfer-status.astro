---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-transfer-status";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Check Deposit & Withdrawal Status in Tradovate";
const META_DESCRIPTION =
  "Deposit or withdrawal pending? Track every transfer's status, pending, locked, or completed, in Transfer History in about a minute.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Einzahlungs- und Auszahlungsstatus in Tradovate prüfen", es: "Cómo consultar el estado de depósitos y retiros en Tradovate", fr: "Vérifier le statut des dépôts et retraits dans Tradovate", it: "Controllare lo stato di depositi e prelievi in Tradovate" },
  dek: { en: "Sent an ACH deposit and it still hasn't shown up? Requested a payout and want to know if it's actually moving? Here's how to read your deposit and withdrawal status in Transfer History.", de: "ACH-Einzahlung gesendet und sie ist immer noch nicht da? Eine Auszahlung beantragt und möchten wissen, ob sie tatsächlich unterwegs ist? So lesen Sie Ihren Einzahlungs- und Auszahlungsstatus im Transfer History ab.", es: "¿Envió un depósito ACH y todavía no aparece? ¿Solicitó un retiro y quiere saber si realmente está en camino? Así se lee el estado de sus depósitos y retiros en Transfer History.", fr: "Vous avez envoyé un dépôt ACH et il n'est toujours pas arrivé ? Vous avez demandé un retrait et voulez savoir s'il est réellement en cours ? Voici comment lire le statut de vos dépôts et retraits dans Transfer History.", it: "Ha inviato un deposito ACH e non è ancora arrivato? Ha richiesto un payout e vuole sapere se è davvero in corso? Ecco come leggere lo stato di depositi e prelievi in Transfer History." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Sent an ACH deposit and it still hasn't shown up? Requested a payout and want to know if it's actually moving? Tradovate keeps a full record of every transfer you make, and checking where yours stands takes about a minute. Here's how to read your deposit and withdrawal status in Transfer History, and what each status actually means." },
    { type: "heading", text: "Where Tradovate Tracks Your Transfers" },
    { type: "paragraph", html: "Every deposit you make, ACH, debit card, or check, and every withdrawal you request by ACH or wire gets logged in one place: the <strong class='text-white'>Transfer History</strong> page inside your account settings. It shows the amount, the method, the date, and the part you actually care about: the current status of each transfer. This lives in the web app, so if you normally trade on mobile or a connected platform, log in through a browser to see it. One thing to keep straight, prop-firm evaluation and funded accounts don't deposit or pay out here. Those transfers run through your firm, not Tradovate's transfer page." },
    { type: "heading", text: "How to Check Your Transfer Status: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open Application Settings > Transfers & Payments", html: "Log in to the Tradovate web app and click <strong class='text-white'>Application Settings</strong> in the top-right corner. Open the <strong class='text-white'>Transfers &amp; Payments</strong> tab, some builds label the header simply <strong class='text-white'>Transfers</strong>. It's the same screen you use to move money in and out, so both deposits and withdrawals show up from here." },
        { title: "Open Transfer History", html: "On the Transfers &amp; Payments page, look for the <strong class='text-white'>Transfer Money</strong> section and click <strong class='text-white'>Transfer History</strong>. Tradovate pulls up a running list of every deposit and withdrawal tied to your account, with the most recent at the top. If you hold more than one account, make sure you're looking at the right one." },
        { title: "Read the Status of Each Transfer", html: "Each row shows the transfer type, the amount, the date, and its status. A <strong class='text-white'>pending</strong> status means the request is in but the money hasn't fully cleared yet, perfectly normal for a deposit that's still settling or a withdrawal waiting on the next processing run. A <strong class='text-white'>completed</strong> (you may see it worded as processed) status means it's done: the funds have landed in your account or left it. If a transfer failed or was returned, it gets flagged here too, and that's your cue to reach out to support." },
        { title: "Match the Status to the Expected Timing", html: "A pending status usually just means the clock is still running. Deposits are generally processed within one to two business days, and ACH deposits requested before the daily cutoff, around <strong class='text-white'>1:30 PM Central</strong>, are processed the same business day. Withdrawals submitted before <strong class='text-white'>12:00 PM Central</strong> on a business day process that same day; later ones roll to the next. If an ACH deposit shows as <strong class='text-white'>locked</strong>, don't panic, that's a routine hold. Tradovate can't instantly verify the funds, so it sits for about three business days (released by 5:00 PM Central on the unlock day) before it clears for trading. Exact cutoffs shift over time, so confirm the current times in Tradovate's help center." },
      ],
    },
    { type: "heading", text: "Why You'd Check This" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Confirm a deposit</strong> before you size up a trade that depends on it.",
        "<strong class='text-white'>Know a payout is moving</strong> instead of quietly stuck.",
        "<strong class='text-white'>Catch a failed or returned transfer</strong> early, before it throws off your plan.",
        "<strong class='text-white'>Keep a clean paper trail</strong> of every deposit and withdrawal for your journal and taxes.",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Checking transfers is a manual, once-in-a-while chore, but your entries and exits shouldn't be. PickMyTrade routes your TradingView alerts straight into Tradovate, so trades fire on their own while you're busy handling the housekeeping or away from the desk." },
  ], de: [
    { type: "paragraph",html: "ACH-Einzahlung gesendet und sie ist immer noch nicht da? Eine Auszahlung beantragt und möchten wissen, ob sie tatsächlich unterwegs ist? Tradovate führt eine vollständige Aufzeichnung jedes von Ihnen veranlassten Transfers, und die Prüfung des Stands dauert etwa eine Minute. So lesen Sie Ihren Einzahlungs- und Auszahlungsstatus im Transfer History ab und das bedeutet jeder Status wirklich." },
    { type: "heading",text: "Wo Tradovate Ihre Transfers verfolgt" },
    { type: "paragraph",html: "Jede Einzahlung, die Sie vornehmen, per ACH, Debitkarte oder Scheck, und jede Auszahlung, die Sie per ACH oder Überweisung beantragen, wird an einer Stelle erfasst: auf der Seite <strong class='text-white'>Transfer History</strong> in Ihren Kontoeinstellungen. Dort sehen Sie Betrag, Methode, Datum und das, was Sie tatsächlich interessiert: den aktuellen Status jedes Transfers. Das befindet sich in der Web-App. Wenn Sie normalerweise mobil oder über eine verbundene Plattform handeln, melden Sie sich also über einen Browser an, um es zu sehen. Eines sollten Sie auseinanderhalten: Evaluierungs- und finanzierte Konten von Prop-Firmen zahlen hier nichts ein und aus. Diese Transfers laufen über Ihre Firma, nicht über die Transferseite von Tradovate." },
    { type: "heading",text: "So prüfen Sie Ihren Transferstatus: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Application Settings > Transfers & Payments öffnen", html: "Melden Sie sich in der Tradovate-Web-App an und klicken Sie oben rechts auf <strong class='text-white'>Application Settings</strong>. Öffnen Sie den Tab <strong class='text-white'>Transfers &amp; Payments</strong>, manche Versionen beschriften die Kopfzeile einfach mit <strong class='text-white'>Transfers</strong>. Es ist derselbe Bildschirm, den Sie zum Ein- und Auszahlen von Geld verwenden, daher erscheinen von hier aus sowohl Einzahlungen als auch Auszahlungen." },
        { title: "Transfer History öffnen", html: "Suchen Sie auf der Seite Transfers &amp; Payments den Bereich <strong class='text-white'>Transfer Money</strong> und klicken Sie auf <strong class='text-white'>Transfer History</strong>. Tradovate zeigt eine fortlaufende Liste jeder mit Ihrem Konto verknüpften Einzahlung und Auszahlung an, die neueste steht oben. Wenn Sie mehr als ein Konto besitzen, stellen Sie sicher, dass Sie das richtige ansehen." },
        { title: "Den Status jedes Transfers lesen", html: "Jede Zeile zeigt Transferart, Betrag, Datum und Status. Der Status <strong class='text-white'>pending</strong> bedeutet, dass die Anfrage eingegangen ist, das Geld aber noch nicht vollständig verbucht wurde, völlig normal bei einer Einzahlung, die noch abgewickelt wird, oder einer Auszahlung, die auf den nächsten Verarbeitungslauf wartet. Der Status <strong class='text-white'>completed</strong> (möglicherweise lesen Sie ihn als processed) bedeutet, dass der Vorgang abgeschlossen ist: Das Geld ist auf Ihrem Konto eingegangen oder hat es verlassen. Ist ein Transfer fehlgeschlagen oder zurückgebucht worden, wird er hier ebenfalls markiert, und das ist Ihr Signal, sich an den Support zu wenden." },
        { title: "Den Status mit dem erwarteten Zeitrahmen abgleichen", html: "Ein Status pending bedeutet meist nur, dass die Uhr noch läuft. Einzahlungen werden in der Regel innerhalb von ein bis zwei Geschäftstagen bearbeitet, und ACH-Einzahlungen, die vor der täglichen Frist beauftragt werden, etwa <strong class='text-white'>13:30 Uhr Central Time</strong>, werden am selben Geschäftstag bearbeitet. Auszahlungen, die an einem Geschäftstag vor <strong class='text-white'>12:00 Uhr Central Time</strong> eingereicht werden, werden am selben Tag bearbeitet; spätere rücken auf den nächsten Tag. Wenn eine ACH-Einzahlung als <strong class='text-white'>locked</strong> angezeigt wird, keine Panik, das ist eine routinemäßige Sperre. Tradovate kann die Mittel nicht sofort verifizieren, daher liegt die Einzahlung etwa drei Geschäftstage lang fest (am Freigabetag um 17:00 Uhr Central Time freigegeben), bevor sie für den Handel verfügbar ist. Die genauen Fristen ändern sich im Laufe der Zeit, bestätigen Sie die aktuellen Zeiten daher im Hilfe-Center von Tradovate." },
      ],
    },
    { type: "heading",text: "Warum Sie das prüfen sollten" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Eine Einzahlung bestätigen</strong>, bevor Sie eine Positionsgröße erhöhen, die davon abhängt.",
        "<strong class='text-white'>Wissen, dass eine Auszahlung unterwegs ist</strong>, statt dass sie unbemerkt hängt.",
        "<strong class='text-white'>Einen fehlgeschlagenen oder zurückgebuchten Transfer früh bemerken</strong>, bevor er Ihren Plan durcheinanderbringt.",
        "<strong class='text-white'>Einen sauberen Nachweis führen</strong> über jede Einzahlung und Auszahlung für Ihr Journal und Ihre Steuern.",
      ],
    },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "Transfers zu prüfen ist eine manuelle Aufgabe, die nur hin und wieder anfällt, Ihre Einstiege und Ausstiege sollten es aber nicht sein. PickMyTrade leitet Ihre TradingView-Alarme direkt an Tradovate weiter, sodass Trades von selbst ausgelöst werden, während Sie sich um die Verwaltung kümmern oder nicht am Schreibtisch sind." },
  ], es: [
    { type: "paragraph",html: "¿Envió un depósito ACH y todavía no aparece? ¿Solicitó un retiro y quiere saber si realmente está en camino? Tradovate mantiene un registro completo de cada transferencia que realiza, y comprobar en qué punto está la suya lleva alrededor de un minuto. Así se lee el estado de sus depósitos y retiros en Transfer History, y qué significa realmente cada estado." },
    { type: "heading",text: "Dónde registra Tradovate sus transferencias" },
    { type: "paragraph",html: "Cada depósito que realiza, ya sea por ACH, tarjeta de débito o cheque, y cada retiro que solicita por ACH o transferencia bancaria queda registrado en un solo lugar: la página <strong class='text-white'>Transfer History</strong> dentro de los ajustes de su cuenta. Muestra el importe, el método, la fecha y lo que realmente le interesa: el estado actual de cada transferencia. Está en la aplicación web, así que si normalmente opera desde el móvil o una plataforma conectada, inicie sesión desde un navegador para verlo. Una cosa que debe tener clara: las cuentas de evaluación y fondeadas de las prop firms no depositan ni cobran aquí. Esas transferencias pasan por su firma, no por la página de transferencias de Tradovate." },
    { type: "heading",text: "Cómo consultar el estado de su transferencia: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra Application Settings > Transfers & Payments", html: "Inicie sesión en la aplicación web de Tradovate y haga clic en <strong class='text-white'>Application Settings</strong> en la esquina superior derecha. Abra la pestaña <strong class='text-white'>Transfers &amp; Payments</strong>; algunas versiones rotulan el encabezado simplemente como <strong class='text-white'>Transfers</strong>. Es la misma pantalla que usa para mover dinero hacia dentro y fuera, así que desde aquí aparecen tanto depósitos como retiros." },
        { title: "Abra Transfer History", html: "En la página Transfers &amp; Payments, busque la sección <strong class='text-white'>Transfer Money</strong> y haga clic en <strong class='text-white'>Transfer History</strong>. Tradovate muestra una lista continua de todos los depósitos y retiros asociados a su cuenta, con el más reciente arriba. Si tiene más de una cuenta, asegúrese de estar mirando la correcta." },
        { title: "Lea el estado de cada transferencia", html: "Cada fila muestra el tipo de transferencia, el importe, la fecha y su estado. Un estado <strong class='text-white'>pending</strong> significa que la solicitud ha entrado, pero el dinero aún no se ha acreditado por completo, algo perfectamente normal en un depósito que aún se está liquidando o en un retiro que espera al siguiente ciclo de procesamiento. Un estado <strong class='text-white'>completed</strong> (puede aparecer como processed) significa que ya está hecho: los fondos han llegado a su cuenta o la han abandonado. Si una transferencia falló o fue devuelta, también se señala aquí, y esa es su señal para contactar con soporte." },
        { title: "Relacione el estado con los plazos previstos", html: "Un estado pending suele significar simplemente que el reloj sigue corriendo. Los depósitos generalmente se procesan en uno o dos días hábiles, y los depósitos ACH solicitados antes del corte diario, alrededor de las <strong class='text-white'>1:30 PM hora Central</strong>, se procesan el mismo día hábil. Los retiros enviados antes de las <strong class='text-white'>12:00 PM hora Central</strong> de un día hábil se procesan ese mismo día; los posteriores pasan al siguiente. Si un depósito ACH aparece como <strong class='text-white'>locked</strong>, no se alarme, es una retención rutinaria. Tradovate no puede verificar los fondos al instante, así que el depósito queda retenido unos tres días hábiles (liberado a las 5:00 PM hora Central del día de desbloqueo) antes de estar disponible para operar. Los horarios de corte exactos cambian con el tiempo, así que confirme los horarios vigentes en el centro de ayuda de Tradovate." },
      ],
    },
    { type: "heading",text: "Por qué conviene revisarlo" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Confirmar un depósito</strong> antes de aumentar el tamaño de una operación que depende de él.",
        "<strong class='text-white'>Saber que un retiro está en camino</strong> en lugar de estar atascado sin que se note.",
        "<strong class='text-white'>Detectar a tiempo una transferencia fallida o devuelta</strong>, antes de que altere su plan.",
        "<strong class='text-white'>Mantener un registro limpio</strong> de cada depósito y retiro para su diario y sus impuestos.",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Revisar las transferencias es una tarea manual y ocasional, pero sus entradas y salidas no deberían serlo. PickMyTrade enruta sus alertas de TradingView directamente a Tradovate, para que las operaciones se ejecuten solas mientras usted se ocupa de las gestiones o está lejos del escritorio." },
  ], fr: [
    { type: "paragraph",html: "Vous avez envoyé un dépôt ACH et il n'est toujours pas arrivé ? Vous avez demandé un retrait et voulez savoir s'il est réellement en cours ? Tradovate conserve un historique complet de chaque transfert que vous effectuez, et vérifier où en est le vôtre prend environ une minute. Voici comment lire le statut de vos dépôts et retraits dans Transfer History, et ce que signifie réellement chaque statut." },
    { type: "heading",text: "Où Tradovate suit vos transferts" },
    { type: "paragraph",html: "Chaque dépôt que vous effectuez, par ACH, carte de débit ou chèque, et chaque retrait que vous demandez par ACH ou virement est enregistré au même endroit : la page <strong class='text-white'>Transfer History</strong> dans les paramètres de votre compte. Elle indique le montant, la méthode, la date et ce qui vous intéresse vraiment : le statut actuel de chaque transfert. Cette page se trouve dans l'application web ; si vous tradez habituellement sur mobile ou via une plateforme connectée, connectez-vous donc via un navigateur pour la consulter. Un point à bien garder en tête : les comptes d'évaluation et financés des prop firms ne déposent ni ne retirent ici. Ces transferts passent par votre firme, et non par la page de transferts de Tradovate." },
    { type: "heading",text: "Comment vérifier le statut de votre transfert : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez Application Settings > Transfers & Payments", html: "Connectez-vous à l'application web Tradovate et cliquez sur <strong class='text-white'>Application Settings</strong> dans le coin supérieur droit. Ouvrez l'onglet <strong class='text-white'>Transfers &amp; Payments</strong> ; certaines versions l'intitulent simplement <strong class='text-white'>Transfers</strong>. C'est le même écran que celui que vous utilisez pour déplacer de l'argent, de sorte que les dépôts comme les retraits y apparaissent." },
        { title: "Ouvrez Transfer History", html: "Sur la page Transfers &amp; Payments, repérez la section <strong class='text-white'>Transfer Money</strong> et cliquez sur <strong class='text-white'>Transfer History</strong>. Tradovate affiche une liste continue de tous les dépôts et retraits liés à votre compte, le plus récent en haut. Si vous détenez plusieurs comptes, assurez-vous de consulter le bon." },
        { title: "Lisez le statut de chaque transfert", html: "Chaque ligne indique le type de transfert, le montant, la date et son statut. Un statut <strong class='text-white'>pending</strong> signifie que la demande est enregistrée mais que l'argent n'est pas encore entièrement crédité, ce qui est tout à fait normal pour un dépôt en cours de règlement ou un retrait en attente du prochain traitement. Un statut <strong class='text-white'>completed</strong> (vous pouvez aussi voir processed) signifie que l'opération est terminée : les fonds sont arrivés sur votre compte ou l'ont quitté. Si un transfert a échoué ou a été renvoyé, il est aussi signalé ici, et c'est le signal pour contacter le support." },
        { title: "Rapprochez le statut du délai prévu", html: "Un statut pending signifie généralement que le délai est simplement en cours. Les dépôts sont en général traités sous un à deux jours ouvrés, et les dépôts ACH demandés avant l'heure limite quotidienne, vers <strong class='text-white'>13 h 30, heure du Centre</strong>, sont traités le jour ouvré même. Les retraits soumis avant <strong class='text-white'>12 h 00, heure du Centre</strong> un jour ouvré sont traités le jour même ; les suivants passent au lendemain. Si un dépôt ACH apparaît comme <strong class='text-white'>locked</strong>, pas de panique : c'est une retenue de routine. Tradovate ne peut pas vérifier instantanément les fonds ; le dépôt reste donc bloqué environ trois jours ouvrés (libéré à 17 h 00, heure du Centre, le jour du déblocage) avant d'être disponible pour le trading. Les heures limites exactes évoluent avec le temps ; confirmez donc les horaires en vigueur dans le centre d'aide de Tradovate." },
      ],
    },
    { type: "heading",text: "Pourquoi vérifier cela" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Confirmer un dépôt</strong> avant d'augmenter la taille d'un trade qui en dépend.",
        "<strong class='text-white'>Savoir qu'un retrait est en cours</strong> plutôt que de le croire discrètement bloqué.",
        "<strong class='text-white'>Repérer tôt un transfert échoué ou renvoyé</strong>, avant qu'il ne bouleverse votre plan.",
        "<strong class='text-white'>Conserver une trace claire</strong> de chaque dépôt et retrait pour votre journal et vos impôts.",
      ],
    },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Vérifier les transferts est une corvée manuelle et ponctuelle, mais vos entrées et sorties ne devraient pas l'être. PickMyTrade achemine vos alertes TradingView directement vers Tradovate, pour que les trades se déclenchent seuls pendant que vous gérez l'intendance ou que vous êtes loin de votre bureau." },
  ], it: [
    { type: "paragraph",html: "Ha inviato un deposito ACH e non è ancora arrivato? Ha richiesto un payout e vuole sapere se è davvero in corso? Tradovate conserva un registro completo di ogni trasferimento che effettua, e controllare a che punto è il suo richiede circa un minuto. Ecco come leggere lo stato di depositi e prelievi in Transfer History e che cosa significa davvero ogni stato." },
    { type: "heading",text: "Dove Tradovate tiene traccia dei suoi trasferimenti" },
    { type: "paragraph",html: "Ogni deposito che effettua, tramite ACH, carta di debito o assegno, e ogni prelievo che richiede tramite ACH o bonifico viene registrato in un unico posto: la pagina <strong class='text-white'>Transfer History</strong> all'interno delle impostazioni del suo conto. Mostra l'importo, il metodo, la data e ciò che davvero le interessa: lo stato attuale di ciascun trasferimento. Si trova nell'app web, quindi se di solito opera da mobile o da una piattaforma collegata, acceda tramite un browser per vederlo. Una cosa da tenere chiara: i conti di valutazione e finanziati delle prop firm non depositano né incassano qui. Quei trasferimenti passano dalla sua firm, non dalla pagina trasferimenti di Tradovate." },
    { type: "heading",text: "Come controllare lo stato del trasferimento: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Apra Application Settings > Transfers & Payments", html: "Acceda all'app web di Tradovate e clicchi su <strong class='text-white'>Application Settings</strong> nell'angolo in alto a destra. Apra la scheda <strong class='text-white'>Transfers &amp; Payments</strong>; in alcune versioni l'intestazione è semplicemente <strong class='text-white'>Transfers</strong>. È la stessa schermata che usa per spostare denaro in entrata e in uscita, quindi da qui compaiono sia i depositi sia i prelievi." },
        { title: "Apra Transfer History", html: "Nella pagina Transfers &amp; Payments, cerchi la sezione <strong class='text-white'>Transfer Money</strong> e clicchi su <strong class='text-white'>Transfer History</strong>. Tradovate mostra un elenco continuo di tutti i depositi e prelievi associati al suo conto, con il più recente in alto. Se possiede più di un conto, si assicuri di guardare quello giusto." },
        { title: "Legga lo stato di ciascun trasferimento", html: "Ogni riga mostra il tipo di trasferimento, l'importo, la data e lo stato. Uno stato <strong class='text-white'>pending</strong> significa che la richiesta è stata inoltrata ma il denaro non è ancora stato accreditato del tutto, una situazione perfettamente normale per un deposito ancora in fase di regolamento o per un prelievo in attesa del successivo ciclo di elaborazione. Uno stato <strong class='text-white'>completed</strong> (potrebbe vederlo indicato come processed) significa che l'operazione è conclusa: i fondi sono arrivati sul suo conto o ne sono usciti. Se un trasferimento è fallito o è stato restituito, viene segnalato anche qui, ed è il momento di contattare il supporto." },
        { title: "Confronti lo stato con le tempistiche previste", html: "Uno stato pending di solito significa solo che il tempo sta ancora scorrendo. I depositi vengono in genere elaborati entro uno o due giorni lavorativi, e i depositi ACH richiesti prima del limite giornaliero, intorno alle <strong class='text-white'>13:30 ora Central</strong>, vengono elaborati lo stesso giorno lavorativo. I prelievi inviati prima delle <strong class='text-white'>12:00 ora Central</strong> in un giorno lavorativo vengono elaborati lo stesso giorno; quelli successivi passano al giorno seguente. Se un deposito ACH risulta <strong class='text-white'>locked</strong>, non si allarmi: è una trattenuta di routine. Tradovate non può verificare subito i fondi, quindi il deposito resta fermo per circa tre giorni lavorativi (rilasciato entro le 17:00 ora Central del giorno di sblocco) prima di diventare disponibile per il trading. Gli orari limite esatti cambiano nel tempo, quindi confermi gli orari attuali nel centro assistenza di Tradovate." },
      ],
