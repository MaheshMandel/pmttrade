---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-apex-credentials";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Get Tradovate Credentials for an Apex Eval";
const META_DESCRIPTION =
  "Apex Tradovate credentials made simple: grab your username and password from the Apex dashboard, sign in, and start your evaluation the right way.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate API", de: "Tradovate API", es: "Tradovate API", fr: "Tradovate API", it: "Tradovate API" },
  h1: { en: META_TITLE, de: "Tradovate-Zugangsdaten für eine Apex-Evaluierung erhalten", es: "Obtenga las credenciales de Tradovate para una evaluación de Apex", fr: "Obtenir les identifiants Tradovate pour une évaluation Apex", it: "Ottenere le credenziali Tradovate per una valutazione Apex" },
  dek: { en: "Need to find your Apex Tradovate credentials and get logged in to your evaluation? Here's exactly where your username and password live inside the Apex dashboard and how to sign in cleanly the first time.", de: "Sie suchen Ihre Apex-Tradovate-Zugangsdaten und möchten sich bei Ihrer Evaluierung anmelden? Hier erfahren Sie genau, wo Benutzername und Passwort im Apex-Dashboard stehen und wie Sie sich gleich beim ersten Mal sauber anmelden.", es: "¿Necesita encontrar sus credenciales de Apex Tradovate e iniciar sesión en su evaluación? Aquí le mostramos exactamente dónde están su usuario y contraseña dentro del panel de Apex y cómo iniciar sesión sin problemas a la primera.", fr: "Vous devez retrouver vos identifiants Apex Tradovate et vous connecter à votre évaluation ? Voici exactement où se trouvent votre nom d’utilisateur et votre mot de passe dans le tableau de bord Apex, et comment vous connecter proprement dès la première fois.", it: "Ha bisogno di trovare le sue credenziali Apex Tradovate e accedere alla sua valutazione? Ecco esattamente dove si trovano nome utente e password nella dashboard Apex e come accedere correttamente al primo tentativo." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Need to find your Apex Tradovate credentials and get logged in to your evaluation? Maybe you're starting a fresh eval, maybe you just switched machines, or maybe you're wiring up automation like PickMyTrade. Whatever brought you here, this guide shows you exactly where your Tradovate username and password live inside the Apex dashboard and how to sign in cleanly the first time so you're not chasing login errors." },
    { type: "heading", text: "What Are Apex Tradovate Credentials?" },
    { type: "paragraph", html: "Buy an evaluation from Apex Trader Funding, pick Tradovate as your platform, and Apex spins up a Tradovate login for you. You don't create these yourself. They're issued by Apex, and they're a completely separate set of details from your Apex account email and from any Rithmic login you might also have. You use them to sign in to the Tradovate web platform and trade your evaluation in simulation." },
    { type: "heading", text: "Getting Apex Tradovate Credentials: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open Your Apex Dashboard and Find Your Tradovate Account", html: "Log in to your Apex Trader Funding dashboard and open the account you want to trade. Apex tucks your Tradovate username and password into the account details, usually in a panel named for your Tradovate account or behind a <strong class='text-white'>Get Credentials</strong> option. Don't see them yet? Your account is probably still provisioning after purchase, so give it a little time and refresh." },
        { title: "Copy Your Tradovate Username and Password Exactly", html: "Copy the username and password carefully, because two small things trip up most people here. First, grab the <strong class='text-white'>Tradovate</strong> credentials, not the Rithmic ones. They're different accounts and they are not interchangeable. Second, watch for <strong class='text-white'>extra spaces</strong> at the start or end of either field. A stray space you can't even see is one of the most common reasons a login fails." },
        { title: "Sign In at the Tradovate Web Platform", html: "Open the Tradovate web platform in a desktop browser. Skip the mobile app for this first-time setup. Enter the username and password you copied from Apex, and paste them rather than retyping, so you don't reintroduce a typo. Then submit the login form." },
        { title: "Choose Non-Professional and Sign the Data Agreements", html: "On your first login, Tradovate asks you to complete the market-data subscriber agreements. Pick <strong class='text-white'>Non-Professional</strong> unless you genuinely qualify as a professional subscriber. Choosing Professional triggers much higher exchange data fees, and those fees vary by exchange and change over time, so check the current rates before you commit. Accept the required agreements to kick off data activation." },
        { title: "Launch Your Apex Account in Simulation", html: "Apex evaluations live in Tradovate's demo/simulation environment. Try to force live mode and you'll just get authentication errors, so don't fight it. Find your Apex account in the simulation list and launch it. Live data usually switches on a short while after you sign the agreements, often somewhere in the 10 to 90 minute range, though the timing varies, so lean on your firm's current guidance. Symbols that already have live data look normal, while symbols still waiting on activation get flagged, often shown in orange." },
      ],
    },
    { type: "heading", text: "Why You'd Need This" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Starting a new eval</strong>, your first login after buying an Apex account.",
        "<strong class='text-white'>Signing in on a new device</strong>, re-entering credentials on a fresh browser or machine.",
        "<strong class='text-white'>Fixing a failed login</strong>, ruling out the wrong-account and extra-space traps.",
        "<strong class='text-white'>Connecting third-party tools</strong>, TradingView, NinjaTrader, or an automation bridge all need these exact credentials.",
        "<strong class='text-white'>Confirming data is live</strong>, verifying your subscriber agreement and activation before you place a trade.",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Once you're logged in, <strong class='text-white'>PickMyTrade wires your TradingView alerts straight to your Apex Tradovate account</strong>. Entries, stops, and targets fire on their own, so there are no manual clicks and no fills slipping past you while you're away from the screen. Your credentials stay in one place and the bridge handles the routing." },
  ], de: [
    { type: "paragraph",html: "Sie suchen Ihre Apex-Tradovate-Zugangsdaten und möchten sich bei Ihrer Evaluierung anmelden? Vielleicht starten Sie eine neue Evaluierung, haben gerade den Rechner gewechselt oder richten eine Automatisierung wie PickMyTrade ein. Was auch immer Sie hierher geführt hat: Dieser Leitfaden zeigt Ihnen genau, wo Ihr Tradovate-Benutzername und Ihr Passwort im Apex-Dashboard stehen und wie Sie sich gleich beim ersten Mal sauber anmelden, damit Sie keinen Login-Fehlern hinterherjagen müssen." },
    { type: "heading",text: "Was sind Apex-Tradovate-Zugangsdaten?" },
    { type: "paragraph",html: "Kaufen Sie bei Apex Trader Funding eine Evaluierung und wählen Tradovate als Plattform, richtet Apex für Sie ein Tradovate-Login ein. Sie erstellen diese Daten nicht selbst. Sie werden von Apex ausgestellt und sind völlig getrennt von der E-Mail-Adresse Ihres Apex-Kontos und von einem eventuell vorhandenen Rithmic-Login. Mit ihnen melden Sie sich an der Tradovate-Webplattform an und handeln Ihre Evaluierung in der Simulation." },
    { type: "heading",text: "Apex-Tradovate-Zugangsdaten erhalten: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Apex-Dashboard öffnen und Tradovate-Konto finden", html: "Melden Sie sich in Ihrem Apex-Trader-Funding-Dashboard an und öffnen Sie das Konto, das Sie handeln möchten. Apex legt Ihren Tradovate-Benutzernamen und Ihr Passwort in den Kontodetails ab, meist in einem Bereich, der nach Ihrem Tradovate-Konto benannt ist, oder hinter einer Option <strong class='text-white'>Get Credentials</strong>. Sehen Sie sie noch nicht? Dann wird Ihr Konto nach dem Kauf wahrscheinlich noch bereitgestellt. Geben Sie ihm etwas Zeit und aktualisieren Sie die Seite." },
        { title: "Tradovate-Benutzernamen und -Passwort exakt kopieren", html: "Kopieren Sie Benutzernamen und Passwort sorgfältig, denn zwei Kleinigkeiten bringen die meisten zu Fall. Erstens: Nehmen Sie die <strong class='text-white'>Tradovate</strong>-Zugangsdaten, nicht die Rithmic-Daten. Es sind verschiedene Konten, und sie sind nicht austauschbar. Zweitens: Achten Sie auf <strong class='text-white'>zusätzliche Leerzeichen</strong> am Anfang oder Ende eines der beiden Felder. Ein unsichtbares Leerzeichen ist eine der häufigsten Ursachen für fehlgeschlagene Logins." },
        { title: "An der Tradovate-Webplattform anmelden", html: "Öffnen Sie die Tradovate-Webplattform in einem Desktop-Browser. Lassen Sie die Mobile-App für diese Ersteinrichtung außen vor. Geben Sie den bei Apex kopierten Benutzernamen und das Passwort ein, und fügen Sie sie per Einfügen ein, statt sie neu zu tippen, damit sich kein Tippfehler einschleicht. Senden Sie anschließend das Anmeldeformular ab." },
        { title: "Non-Professional wählen und die Datenvereinbarungen unterzeichnen", html: "Bei der ersten Anmeldung bittet Tradovate Sie, die Vereinbarungen für Marktdaten-Abonnenten auszufüllen. Wählen Sie <strong class='text-white'>Non-Professional</strong>, es sei denn, Sie qualifizieren sich tatsächlich als professioneller Abonnent. Die Wahl von Professional löst deutlich höhere Börsendatengebühren aus, die je nach Börse variieren und sich mit der Zeit ändern. Prüfen Sie daher die aktuellen Sätze, bevor Sie sich festlegen. Akzeptieren Sie die erforderlichen Vereinbarungen, um die Datenaktivierung anzustoßen." },
        { title: "Apex-Konto in der Simulation starten", html: "Apex-Evaluierungen laufen in der Demo-/Simulationsumgebung von Tradovate. Wenn Sie versuchen, den Live-Modus zu erzwingen, erhalten Sie nur Authentifizierungsfehler, kämpfen Sie also nicht dagegen an. Suchen Sie Ihr Apex-Konto in der Simulationsliste und starten Sie es. Live-Daten werden meist kurze Zeit nach der Unterzeichnung der Vereinbarungen freigeschaltet, oft innerhalb von 10 bis 90 Minuten; der Zeitraum variiert jedoch, orientieren Sie sich daher an den aktuellen Hinweisen Ihrer Firma. Symbole mit bereits aktiven Live-Daten sehen normal aus, während Symbole, die noch auf die Aktivierung warten, markiert sind, oft in Orange." },
      ],
    },
    { type: "heading",text: "Wann Sie das brauchen" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Eine neue Evaluierung starten</strong>, Ihre erste Anmeldung nach dem Kauf eines Apex-Kontos.",
        "<strong class='text-white'>Auf einem neuen Gerät anmelden</strong>, die Zugangsdaten in einem frischen Browser oder auf einem neuen Rechner erneut eingeben.",
        "<strong class='text-white'>Einen fehlgeschlagenen Login beheben</strong>, die Fallen „falsches Konto“ und „zusätzliches Leerzeichen“ ausschließen.",
        "<strong class='text-white'>Tools von Drittanbietern verbinden</strong>, TradingView, NinjaTrader oder eine Automatisierungsbrücke benötigen genau diese Zugangsdaten.",
        "<strong class='text-white'>Prüfen, ob die Daten live sind</strong>, Ihre Abonnentenvereinbarung und die Aktivierung bestätigen, bevor Sie einen Trade platzieren.",
      ],
    },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "Sobald Sie angemeldet sind, <strong class='text-white'>verbindet PickMyTrade Ihre TradingView-Alerts direkt mit Ihrem Apex-Tradovate-Konto</strong>. Einstiege, Stopps und Ziele werden von selbst ausgeführt, ohne manuelle Klicks und ohne Fills, die Ihnen entgehen, während Sie nicht am Bildschirm sind. Ihre Zugangsdaten bleiben an einem Ort, und die Bridge übernimmt das Routing." },
  ], es: [
    { type: "paragraph",html: "¿Necesita encontrar sus credenciales de Apex Tradovate e iniciar sesión en su evaluación? Quizá empiece una evaluación nueva, quizá acabe de cambiar de equipo o quizá esté configurando una automatización como PickMyTrade. Sea cual sea el motivo, esta guía le muestra exactamente dónde están su usuario y contraseña de Tradovate dentro del panel de Apex y cómo iniciar sesión sin problemas a la primera para no perseguir errores de acceso." },
    { type: "heading",text: "¿Qué son las credenciales de Apex Tradovate?" },
    { type: "paragraph",html: "Compre una evaluación en Apex Trader Funding, elija Tradovate como plataforma y Apex le crea un acceso de Tradovate. Usted no las crea. Las emite Apex y son un conjunto de datos totalmente distinto del correo de su cuenta de Apex y de cualquier acceso de Rithmic que pueda tener. Las utiliza para iniciar sesión en la plataforma web de Tradovate y operar su evaluación en simulación." },
    { type: "heading",text: "Cómo obtener las credenciales de Apex Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra su panel de Apex y localice su cuenta de Tradovate", html: "Inicie sesión en su panel de Apex Trader Funding y abra la cuenta con la que quiere operar. Apex guarda su usuario y contraseña de Tradovate en los detalles de la cuenta, normalmente en un panel con el nombre de su cuenta de Tradovate o tras una opción <strong class='text-white'>Get Credentials</strong>. ¿Todavía no las ve? Es probable que su cuenta aún se esté aprovisionando tras la compra, así que dele un poco de tiempo y actualice la página." },
        { title: "Copie su usuario y contraseña de Tradovate exactamente", html: "Copie el usuario y la contraseña con cuidado, porque dos detalles pequeños hacen tropezar a la mayoría. Primero, tome las credenciales de <strong class='text-white'>Tradovate</strong>, no las de Rithmic. Son cuentas distintas y no son intercambiables. Segundo, vigile los <strong class='text-white'>espacios adicionales</strong> al principio o al final de cualquiera de los campos. Un espacio que ni siquiera se ve es una de las causas más habituales de que falle un inicio de sesión." },
        { title: "Inicie sesión en la plataforma web de Tradovate", html: "Abra la plataforma web de Tradovate en un navegador de escritorio. Evite la aplicación móvil para esta primera configuración. Introduzca el usuario y la contraseña que copió de Apex, y péguelos en lugar de volver a escribirlos para no introducir de nuevo un error tipográfico. Después envíe el formulario de acceso." },
        { title: "Elija Non-Professional y firme los acuerdos de datos", html: "En su primer acceso, Tradovate le pide completar los acuerdos de suscriptor de datos de mercado. Elija <strong class='text-white'>Non-Professional</strong> a menos que realmente cumpla los requisitos de suscriptor profesional. Elegir Professional conlleva tarifas de datos de bolsa mucho más altas, que varían según la bolsa y cambian con el tiempo, así que consulte las tarifas actuales antes de comprometerse. Acepte los acuerdos requeridos para iniciar la activación de los datos." },
        { title: "Inicie su cuenta de Apex en simulación", html: "Las evaluaciones de Apex residen en el entorno demo/de simulación de Tradovate. Si intenta forzar el modo real, solo obtendrá errores de autenticación, así que no se empeñe. Localice su cuenta de Apex en la lista de simulación e inícela. Los datos en vivo suelen activarse poco después de firmar los acuerdos, a menudo en un margen de 10 a 90 minutos, aunque el plazo varía, así que guíese por las indicaciones actuales de su firma. Los símbolos que ya tienen datos en vivo se ven normales, mientras que los que aún esperan su activación aparecen marcados, a menudo en naranja." },
      ],
    },
    { type: "heading",text: "Por qué lo necesitaría" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Empezar una nueva evaluación</strong>, su primer acceso tras comprar una cuenta de Apex.",
        "<strong class='text-white'>Iniciar sesión en un dispositivo nuevo</strong>, volver a introducir las credenciales en un navegador o equipo nuevo.",
        "<strong class='text-white'>Solucionar un acceso fallido</strong>, descartar las trampas de cuenta equivocada y espacio adicional.",
        "<strong class='text-white'>Conectar herramientas de terceros</strong>, TradingView, NinjaTrader o un puente de automatización necesitan estas credenciales exactas.",
        "<strong class='text-white'>Confirmar que los datos están activos</strong>, verificar su acuerdo de suscriptor y la activación antes de colocar una operación.",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Una vez iniciada la sesión, <strong class='text-white'>PickMyTrade conecta sus alertas de TradingView directamente con su cuenta de Apex Tradovate</strong>. Las entradas, stops y objetivos se ejecutan por sí solos, sin clics manuales y sin fills que se le escapen mientras está lejos de la pantalla. Sus credenciales permanecen en un solo lugar y el puente se encarga del enrutamiento." },
  ], fr: [
    { type: "paragraph",html: "Vous devez retrouver vos identifiants Apex Tradovate et vous connecter à votre évaluation ? Peut-être démarrez-vous une nouvelle évaluation, venez-vous de changer de machine, ou mettez-vous en place une automatisation comme PickMyTrade. Quelle que soit la raison, ce guide vous montre exactement où se trouvent votre nom d’utilisateur et votre mot de passe Tradovate dans le tableau de bord Apex et comment vous connecter proprement dès la première fois, sans courir après les erreurs de connexion." },
    { type: "heading",text: "Que sont les identifiants Apex Tradovate ?" },
    { type: "paragraph",html: "Achetez une évaluation auprès d’Apex Trader Funding, choisissez Tradovate comme plateforme, et Apex crée un identifiant Tradovate pour vous. Vous ne les créez pas vous-même. Ils sont émis par Apex et constituent un ensemble de données totalement distinct de l’e-mail de votre compte Apex et de tout identifiant Rithmic que vous pourriez également avoir. Vous les utilisez pour vous connecter à la plateforme web Tradovate et trader votre évaluation en simulation." },
    { type: "heading",text: "Obtenir les identifiants Apex Tradovate : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez votre tableau de bord Apex et trouvez votre compte Tradovate", html: "Connectez-vous à votre tableau de bord Apex Trader Funding et ouvrez le compte que vous souhaitez trader. Apex place votre nom d’utilisateur et votre mot de passe Tradovate dans les détails du compte, généralement dans un panneau portant le nom de votre compte Tradovate ou derrière une option <strong class='text-white'>Get Credentials</strong>. Vous ne les voyez pas encore ? Votre compte est probablement encore en cours de provisionnement après l’achat ; laissez-lui un peu de temps et actualisez la page." },
        { title: "Copiez exactement votre nom d’utilisateur et votre mot de passe Tradovate", html: "Copiez le nom d’utilisateur et le mot de passe avec soin, car deux petits détails piègent la plupart des gens. Premièrement, prenez les identifiants <strong class='text-white'>Tradovate</strong>, pas ceux de Rithmic. Ce sont des comptes différents et ils ne sont pas interchangeables. Deuxièmement, méfiez-vous des <strong class='text-white'>espaces superflus</strong> au début ou à la fin de l’un ou l’autre champ. Un espace parasite que vous ne voyez même pas est l’une des causes les plus fréquentes d’échec de connexion." },
        { title: "Connectez-vous à la plateforme web Tradovate", html: "Ouvrez la plateforme web Tradovate dans un navigateur de bureau. Laissez de côté l’application mobile pour cette première configuration. Saisissez le nom d’utilisateur et le mot de passe copiés depuis Apex, en les collant plutôt qu’en les retapant, afin de ne pas réintroduire de faute de frappe. Puis validez le formulaire de connexion." },
        { title: "Choisissez Non-Professional et signez les accords de données", html: "Lors de votre première connexion, Tradovate vous demande de remplir les accords d’abonné aux données de marché. Choisissez <strong class='text-white'>Non-Professional</strong> sauf si vous remplissez réellement les conditions d’un abonné professionnel. Choisir Professional entraîne des frais de données boursières bien plus élevés, qui varient selon la bourse et évoluent avec le temps ; vérifiez donc les tarifs actuels avant de vous engager. Acceptez les accords requis pour lancer l’activation des données." },
        { title: "Lancez votre compte Apex en simulation", html: "Les évaluations Apex se déroulent dans l’environnement de démonstration/simulation de Tradovate. Si vous essayez de forcer le mode réel, vous n’obtiendrez que des erreurs d’authentification ; ne vous y obstinez donc pas. Trouvez votre compte Apex dans la liste de simulation et lancez-le. Les données en direct s’activent généralement peu après la signature des accords, souvent dans une fourchette de 10 à 90 minutes, bien que le délai varie ; fiez-vous donc aux consignes actuelles de votre firme. Les symboles disposant déjà de données en direct s’affichent normalement, tandis que ceux qui attendent encore l’activation sont signalés, souvent en orange." },
      ],
    },
    { type: "heading",text: "Pourquoi vous en auriez besoin" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Démarrer une nouvelle évaluation</strong>, votre première connexion après l’achat d’un compte Apex.",
        "<strong class='text-white'>Se connecter sur un nouvel appareil</strong>, ressaisir les identifiants sur un nouveau navigateur ou une nouvelle machine.",
        "<strong class='text-white'>Corriger une connexion échouée</strong>, écarter les pièges du mauvais compte et de l’espace superflu.",
        "<strong class='text-white'>Connecter des outils tiers</strong>, TradingView, NinjaTrader ou un pont d’automatisation ont tous besoin de ces identifiants exacts.",
        "<strong class='text-white'>Confirmer que les données sont actives</strong>, vérifier votre accord d’abonné et l’activation avant de passer un trade.",
      ],
    },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Une fois connecté, <strong class='text-white'>PickMyTrade relie vos alertes TradingView directement à votre compte Apex Tradovate</strong>. Les entrées, stops et objectifs s’exécutent d’eux-mêmes, sans clic manuel et sans exécutions qui vous échappent pendant que vous êtes loin de l’écran. Vos identifiants restent au même endroit et le pont gère l’acheminement." },
  ], it: [
    { type: "paragraph",html: "Ha bisogno di trovare le sue credenziali Apex Tradovate e accedere alla sua valutazione? Forse sta iniziando una nuova valutazione, ha appena cambiato computer o sta configurando un’automazione come PickMyTrade. Qualunque sia il motivo, questa guida le mostra esattamente dove si trovano nome utente e password Tradovate nella dashboard Apex e come accedere correttamente al primo tentativo, senza inseguire errori di login." },
    { type: "heading",text: "Che cosa sono le credenziali Apex Tradovate?" },
    { type: "paragraph",html: "Acquisti una valutazione da Apex Trader Funding, scelga Tradovate come piattaforma e Apex crea un login Tradovate per lei. Non le crea lei stesso. Sono emesse da Apex e costituiscono un insieme di dati completamente separato dall’e-mail del suo conto Apex e da qualsiasi login Rithmic che potrebbe avere. Le usa per accedere alla piattaforma web di Tradovate e operare la sua valutazione in simulazione." },
    { type: "heading",text: "Ottenere le credenziali Apex Tradovate: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Apra la dashboard Apex e trovi il suo conto Tradovate", html: "Acceda alla sua dashboard Apex Trader Funding e apra il conto con cui vuole operare. Apex inserisce nome utente e password Tradovate nei dettagli del conto, di solito in un pannello con il nome del suo conto Tradovate o dietro un’opzione <strong class='text-white'>Get Credentials</strong>. Non le vede ancora? Probabilmente il conto è ancora in fase di provisioning dopo l’acquisto: gli dia un po’ di tempo e aggiorni la pagina." },
        { title: "Copi esattamente nome utente e password Tradovate", html: "Copi nome utente e password con attenzione, perché due piccole cose fanno inciampare la maggior parte delle persone. Primo, prenda le credenziali <strong class='text-white'>Tradovate</strong>, non quelle Rithmic. Sono conti diversi e non sono intercambiabili. Secondo, faccia attenzione agli <strong class='text-white'>spazi in più</strong> all’inizio o alla fine di uno dei due campi. Uno spazio vagante che non riesce nemmeno a vedere è una delle cause più comuni di login fallito." },
        { title: "Acceda alla piattaforma web Tradovate", html: "Apra la piattaforma web di Tradovate in un browser desktop. Per questa prima configurazione eviti l’app mobile. Inserisca nome utente e password copiati da Apex, incollandoli anziché riscriverli, così da non reintrodurre un errore di battitura. Poi invii il modulo di accesso." },
        { title: "Scelga Non-Professional e firmi gli accordi sui dati", html: "Al primo accesso, Tradovate le chiede di completare gli accordi di sottoscrizione dei dati di mercato. Scelga <strong class='text-white'>Non-Professional</strong> a meno che non si qualifichi davvero come abbonato professionale. Scegliere Professional comporta costi dei dati di borsa molto più alti, che variano in base alla borsa e cambiano nel tempo, quindi verifichi le tariffe attuali prima di impegnarsi. Accetti gli accordi richiesti per avviare l’attivazione dei dati." },
        { title: "Avvii il suo conto Apex in simulazione", html: "Le valutazioni Apex risiedono nell’ambiente demo/di simulazione di Tradovate. Se prova a forzare la modalità live otterrà solo errori di autenticazione, quindi non si ostini. Trovi il suo conto Apex nell’elenco della simulazione e lo avvii. I dati live di solito si attivano poco dopo la firma degli accordi, spesso in un intervallo di 10-90 minuti, anche se i tempi variano, quindi si affidi alle indicazioni attuali della sua firm. I simboli che hanno già dati live appaiono normali, mentre quelli che attendono ancora l’attivazione vengono segnalati, spesso in arancione." },
      ],
    },
    { type: "heading",text: "Perché potrebbe servirle" },
