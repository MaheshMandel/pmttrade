---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-auto-breakeven";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Set Up Auto-Breakeven in a Tradovate ATM Strategy";
const META_DESCRIPTION =
  "Tradovate auto-breakeven made simple: set the Profit Trigger and offset in an ATM strategy to move your stop to breakeven and lock in a risk-free trade.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Auto-Breakeven in einer Tradovate-ATM-Strategie einrichten", es: "Configure el auto-breakeven en una estrategia ATM de Tradovate", fr: "Configurer l’auto-breakeven dans une stratégie ATM Tradovate", it: "Configurare l’auto-breakeven in una strategia ATM di Tradovate" },
  dek: { en: "You've got a winner on your hands and want to protect it the second price moves your way. Here's exactly how to wire auto-breakeven into a Tradovate ATM strategy, step by step, so your stop jumps to breakeven on its own the moment you're in profit.", de: "Sie haben einen Gewinner im Trade und möchten ihn schützen, sobald der Kurs in Ihre Richtung läuft. So binden Sie Auto-Breakeven Schritt für Schritt in eine Tradovate-ATM-Strategie ein, damit Ihr Stop von selbst auf Breakeven springt, sobald Sie im Gewinn sind.", es: "Tiene una operación ganadora y quiere protegerla en cuanto el precio se mueva a su favor. Así se integra el auto-breakeven en una estrategia ATM de Tradovate, paso a paso, para que su stop salte solo a breakeven en el momento en que esté en beneficio.", fr: "Vous avez un trade gagnant et vous voulez le protéger dès que le prix évolue en votre faveur. Voici, pas à pas, comment intégrer l’auto-breakeven dans une stratégie ATM Tradovate, pour que votre stop passe tout seul à breakeven dès que vous êtes en profit.", it: "Ha un trade vincente e vuole proteggerlo non appena il prezzo si muove a Suo favore. Ecco, passo dopo passo, come integrare l’auto-breakeven in una strategia ATM di Tradovate, così che il Suo stop salti da solo a breakeven nel momento in cui è in profitto." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You've got a winner on your hands and you want to protect it the second price moves your way. Auto-breakeven is how you do that in Tradovate without babysitting the chart. Whether you're scalping ES, swinging NQ, or running your entries through automation like PickMyTrade, this guide walks you through wiring auto-breakeven into a Tradovate ATM strategy step by step, so your stop jumps to breakeven on its own the moment you're in profit." },
    { type: "heading", text: "What Is Auto-Breakeven in a Tradovate ATM Strategy?" },
    { type: "paragraph", html: "Auto-breakeven is one of Tradovate's ATM (Advanced Trade Management) <strong class='text-white'>Stop Loss Types</strong>. It's a stop-market order that relocates to the breakeven price of your position, your average entry price, the moment your open profit hits a level you define, called the <strong class='text-white'>Profit Trigger</strong>. There's also an optional offset, which lets the stop land a little above or below true breakeven. The payoff: a trade that's working for you turns risk-free without you ever touching the chart." },
    { type: "heading", text: "Set Up Auto-Breakeven in Tradovate: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open the ATM Strategy Editor", html: "Pull up a <strong class='text-white'>Chart</strong> or <strong class='text-white'>SuperDOM</strong> module and find the <strong class='text-white'>ATM</strong> dropdown in the order-entry panel. Click the <strong class='text-white'>ATM Settings</strong> cogwheel button right next to it. That opens the ATM strategy editor, where every strategy you've saved lives." },
        { title: "Create and Name a New Strategy", html: "Hit the <strong class='text-white'>plus (+)</strong> button to spin up a new strategy, then give it a name you'll actually recognize mid-session, something like \"Auto BE 10 ticks.\" Now pick your unit: <strong class='text-white'>Ticks</strong>, <strong class='text-white'>Delta Price</strong>, or <strong class='text-white'>$Value</strong>. Whatever you choose, every distance you enter after this uses that same measurement, so set it before you start typing numbers." },
        { title: "Add a Stop Loss and Set the Type to Auto Breakeven", html: "Enter a starting stop-loss distance, this is your initial protective stop, the one that's live the instant you're filled. Then open the <strong class='text-white'>Stop Loss Type</strong> dropdown and select <strong class='text-white'>Auto Breakeven</strong>. That single choice is what tells Tradovate to move the stop to breakeven once your trigger condition is met, instead of leaving it parked at your initial level." },
        { title: "Set the Profit Trigger and Offset", html: "In the <strong class='text-white'>Profit Trigger</strong> field, enter how far into profit price has to travel before the stop moves, say, 10 ticks. Want the stop to sit slightly beyond breakeven? Use the offset field, which Tradovate labels <strong class='text-white'>\"Plus.\"</strong> A positive number moves the stop to breakeven plus that amount; a negative number drops it below. Leave it at zero and you get an exact breakeven stop." },
        { title: "Save and Select the Strategy", html: "Click <strong class='text-white'>OK</strong> to save. Then, before you place a trade, choose your new strategy from the <strong class='text-white'>ATM</strong> dropdown, this is the step people forget. Once your entry order fills, Tradovate attaches the stop and profit target for you, and the stop slides to breakeven the instant your Profit Trigger is reached." },
      ],
    },
    { type: "heading", text: "Why You'd Need This" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Lock in a risk-free trade</strong>, once price moves your way, your worst case becomes breakeven instead of a loss.",
        "<strong class='text-white'>Take emotion out of it</strong>, the stop moves on rules, not on a nervous manual drag in the middle of a move.",
        "<strong class='text-white'>Scalp faster</strong>, keep both hands on entries and exits instead of babysitting one stop.",
        "<strong class='text-white'>Standardize your plan</strong>, save the ATM profile once and reuse the exact same breakeven logic on every trade.",
      ],
    },
    { type: "paragraph", html: "One behavior worth knowing before you rely on it: Tradovate won't place the auto-breakeven stop ahead of current price action. If your offset would put the stop above the market on a long (or below it on a short), the stop only relocates once price actually trades through that level. So keep your Profit Trigger and offset realistic for how the instrument moves, a tight trigger on a fast contract behaves very differently than a wide one on something quiet." },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Auto-breakeven is powerful, but it still assumes you're at the desk to place the entry. <strong class='text-white'>PickMyTrade wires your TradingView alerts straight into your Tradovate account</strong>, so entries fire on their own and a breakeven offset can move your stop to protect the position, no manual clicks, no missed triggers. Same \"make the trade risk-free the moment it works\" logic, running while you're away from the screen." },
  ], de: [
    { type: "paragraph",html: "Sie haben einen Gewinner im Trade und möchten ihn schützen, sobald der Kurs in Ihre Richtung läuft. Mit Auto-Breakeven gelingt das in Tradovate, ohne dass Sie den Chart überwachen müssen. Ob Sie ES scalpen, NQ über mehrere Tage halten oder Ihre Einstiege über eine Automatisierung wie PickMyTrade laufen lassen: Diese Anleitung zeigt Ihnen Schritt für Schritt, wie Sie Auto-Breakeven in eine Tradovate-ATM-Strategie einbinden, damit Ihr Stop von selbst auf Breakeven springt, sobald Sie im Gewinn sind." },
    { type: "heading",text: "Was ist Auto-Breakeven in einer Tradovate-ATM-Strategie?" },
    { type: "paragraph",html: "Auto-Breakeven ist einer der <strong class='text-white'>Stop Loss Types</strong> der ATM (Advanced Trade Management) von Tradovate. Es handelt sich um eine Stop-Market-Order, die auf den Breakeven-Preis Ihrer Position, also Ihren durchschnittlichen Einstiegskurs, verschoben wird, sobald Ihr offener Gewinn eine von Ihnen festgelegte Schwelle erreicht, den <strong class='text-white'>Profit Trigger</strong>. Optional gibt es einen Offset, mit dem der Stop etwas über oder unter dem echten Breakeven landet. Der Vorteil: Ein Trade, der für Sie läuft, wird risikofrei, ohne dass Sie den Chart anfassen müssen." },
    { type: "heading",text: "Auto-Breakeven in Tradovate einrichten: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Den ATM-Strategie-Editor öffnen", html: "Öffnen Sie ein <strong class='text-white'>Chart</strong>- oder <strong class='text-white'>SuperDOM</strong>-Modul und suchen Sie das Dropdown <strong class='text-white'>ATM</strong> im Orderbereich. Klicken Sie direkt daneben auf das Zahnrad <strong class='text-white'>ATM Settings</strong>. Damit öffnet sich der ATM-Strategie-Editor, in dem alle von Ihnen gespeicherten Strategien liegen." },
        { title: "Eine neue Strategie erstellen und benennen", html: "Klicken Sie auf die Schaltfläche <strong class='text-white'>plus (+)</strong>, um eine neue Strategie anzulegen, und geben Sie ihr einen Namen, den Sie mitten in der Sitzung sofort erkennen, etwa „Auto BE 10 ticks“. Wählen Sie nun Ihre Einheit: <strong class='text-white'>Ticks</strong>, <strong class='text-white'>Delta Price</strong> oder <strong class='text-white'>$Value</strong>. Was auch immer Sie wählen, jeder Abstand, den Sie danach eingeben, verwendet dieselbe Maßeinheit. Legen Sie sie daher fest, bevor Sie Zahlen eintippen." },
        { title: "Stop-Loss hinzufügen und den Typ auf Auto Breakeven setzen", html: "Geben Sie einen anfänglichen Stop-Loss-Abstand ein, das ist Ihr erster Schutz-Stop, der sofort nach der Ausführung aktiv ist. Öffnen Sie dann das Dropdown <strong class='text-white'>Stop Loss Type</strong> und wählen Sie <strong class='text-white'>Auto Breakeven</strong>. Diese eine Auswahl sorgt dafür, dass Tradovate den Stop auf Breakeven verschiebt, sobald Ihre Auslösebedingung erfüllt ist, statt ihn auf dem ursprünglichen Niveau zu belassen." },
        { title: "Profit Trigger und Offset festlegen", html: "Geben Sie im Feld <strong class='text-white'>Profit Trigger</strong> ein, wie weit der Kurs in den Gewinn laufen muss, bevor der Stop verschoben wird, zum Beispiel 10 Ticks. Soll der Stop etwas jenseits von Breakeven liegen? Dann nutzen Sie das Offset-Feld, das Tradovate mit <strong class='text-white'>„Plus“</strong> bezeichnet. Eine positive Zahl verschiebt den Stop auf Breakeven plus diesen Betrag, eine negative setzt ihn darunter. Bei null erhalten Sie einen exakten Breakeven-Stop." },
        { title: "Speichern und die Strategie auswählen", html: "Klicken Sie auf <strong class='text-white'>OK</strong>, um zu speichern. Wählen Sie dann, bevor Sie einen Trade platzieren, Ihre neue Strategie im Dropdown <strong class='text-white'>ATM</strong> aus. Genau diesen Schritt vergessen viele. Sobald Ihre Einstiegsorder ausgeführt ist, hängt Tradovate Stop und Gewinnziel für Sie an, und der Stop rutscht auf Breakeven, sobald Ihr Profit Trigger erreicht ist." },
      ],
    },
    { type: "heading",text: "Warum Sie das brauchen" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Einen risikofreien Trade sichern</strong>: Sobald der Kurs in Ihre Richtung läuft, ist Ihr schlimmster Fall Breakeven statt Verlust.",
        "<strong class='text-white'>Emotionen herausnehmen</strong>: Der Stop bewegt sich nach Regeln und nicht durch ein nervöses manuelles Ziehen mitten in der Bewegung.",
        "<strong class='text-white'>Schneller scalpen</strong>: Konzentrieren Sie sich auf Ein- und Ausstiege, statt einen einzelnen Stop zu überwachen.",
        "<strong class='text-white'>Ihren Plan standardisieren</strong>: Speichern Sie das ATM-Profil einmal und nutzen Sie dieselbe Breakeven-Logik bei jedem Trade.",
      ],
    },
    { type: "paragraph",html: "Ein Verhalten sollten Sie kennen, bevor Sie sich darauf verlassen: Tradovate platziert den Auto-Breakeven-Stop nicht vor der aktuellen Kursbewegung. Würde Ihr Offset den Stop bei einer Long-Position über den Markt (oder bei einer Short-Position darunter) setzen, wird der Stop erst verschoben, wenn der Kurs dieses Niveau tatsächlich handelt. Halten Sie Ihren Profit Trigger und Offset daher realistisch für die Bewegung des Instruments: Ein enger Trigger bei einem schnellen Kontrakt verhält sich ganz anders als ein weiter bei einem ruhigen." },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "Auto-Breakeven ist leistungsstark, setzt aber voraus, dass Sie für den Einstieg am Schreibtisch sitzen. <strong class='text-white'>PickMyTrade leitet Ihre TradingView-Alerts direkt in Ihr Tradovate-Konto</strong>, sodass Einstiege von selbst ausgelöst werden und ein Breakeven-Offset Ihren Stop zum Schutz der Position verschieben kann, ohne manuelle Klicks und ohne verpasste Trigger. Dieselbe Logik, den Trade risikofrei zu machen, sobald er funktioniert, läuft weiter, während Sie nicht am Bildschirm sind." },
  ], es: [
    { type: "paragraph",html: "Tiene una operación ganadora y quiere protegerla en cuanto el precio se mueva a su favor. El auto-breakeven es la forma de hacerlo en Tradovate sin vigilar el gráfico. Ya sea que haga scalping en ES, opere NQ a varios días o canalice sus entradas mediante automatización como PickMyTrade, esta guía le explica paso a paso cómo integrar el auto-breakeven en una estrategia ATM de Tradovate, para que su stop salte solo a breakeven en el momento en que esté en beneficio." },
    { type: "heading",text: "¿Qué es el auto-breakeven en una estrategia ATM de Tradovate?" },
    { type: "paragraph",html: "El auto-breakeven es uno de los <strong class='text-white'>Stop Loss Types</strong> de la ATM (Advanced Trade Management) de Tradovate. Es una orden stop de mercado que se reubica en el precio de breakeven de su posición, su precio medio de entrada, en cuanto su beneficio abierto alcanza un nivel que usted define, llamado <strong class='text-white'>Profit Trigger</strong>. También hay un desfase opcional, que permite que el stop quede un poco por encima o por debajo del breakeven real. La ventaja: una operación que va a su favor se vuelve libre de riesgo sin que usted toque el gráfico." },
    { type: "heading",text: "Configure el auto-breakeven en Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra el editor de estrategias ATM", html: "Abra un módulo <strong class='text-white'>Chart</strong> o <strong class='text-white'>SuperDOM</strong> y localice el desplegable <strong class='text-white'>ATM</strong> en el panel de introducción de órdenes. Haga clic en el botón de engranaje <strong class='text-white'>ATM Settings</strong> justo al lado. Se abre el editor de estrategias ATM, donde residen todas las estrategias que ha guardado." },
        { title: "Cree y nombre una nueva estrategia", html: "Pulse el botón <strong class='text-white'>plus (+)</strong> para crear una nueva estrategia y póngale un nombre que reconozca en plena sesión, algo como «Auto BE 10 ticks». Ahora elija su unidad: <strong class='text-white'>Ticks</strong>, <strong class='text-white'>Delta Price</strong> o <strong class='text-white'>$Value</strong>. Elija la que elija, cada distancia que introduzca a partir de ahí usa la misma medida, así que defínala antes de empezar a escribir números." },
        { title: "Añada un stop loss y establezca el tipo en Auto Breakeven", html: "Introduzca una distancia inicial de stop loss: es su stop protector inicial, el que está activo en cuanto se ejecuta la orden. Después abra el desplegable <strong class='text-white'>Stop Loss Type</strong> y seleccione <strong class='text-white'>Auto Breakeven</strong>. Esa única elección es lo que indica a Tradovate que mueva el stop a breakeven una vez cumplida su condición de activación, en lugar de dejarlo en su nivel inicial." },
        { title: "Establezca el Profit Trigger y el desfase", html: "En el campo <strong class='text-white'>Profit Trigger</strong>, introduzca cuánto debe avanzar el precio en beneficio antes de que se mueva el stop, por ejemplo, 10 ticks. ¿Quiere que el stop quede ligeramente más allá del breakeven? Use el campo de desfase, que Tradovate etiqueta como <strong class='text-white'>«Plus»</strong>. Un número positivo mueve el stop a breakeven más esa cantidad; uno negativo lo coloca por debajo. Si lo deja en cero, obtiene un stop de breakeven exacto." },
        { title: "Guarde y seleccione la estrategia", html: "Haga clic en <strong class='text-white'>OK</strong> para guardar. Después, antes de colocar una operación, elija su nueva estrategia en el desplegable <strong class='text-white'>ATM</strong>; es el paso que la gente olvida. Una vez ejecutada su orden de entrada, Tradovate adjunta el stop y el objetivo de beneficio por usted, y el stop se desliza a breakeven en cuanto se alcanza su Profit Trigger." },
      ],
    },
    { type: "heading",text: "Por qué lo necesita" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Asegurar una operación libre de riesgo</strong>: cuando el precio se mueve a su favor, su peor caso pasa a ser breakeven en lugar de una pérdida.",
        "<strong class='text-white'>Quitar la emoción</strong>: el stop se mueve según reglas, no por un arrastre manual nervioso en mitad del movimiento.",
        "<strong class='text-white'>Hacer scalping más rápido</strong>: mantenga la atención en entradas y salidas en lugar de vigilar un único stop.",
        "<strong class='text-white'>Estandarizar su plan</strong>: guarde el perfil ATM una vez y reutilice exactamente la misma lógica de breakeven en cada operación.",
      ],
    },
    { type: "paragraph",html: "Un comportamiento que conviene conocer antes de depender de esta función: Tradovate no colocará el stop de auto-breakeven por delante de la acción actual del precio. Si su desfase pusiera el stop por encima del mercado en una posición larga (o por debajo en una corta), el stop solo se reubica cuando el precio realmente negocia a través de ese nivel. Por eso, mantenga su Profit Trigger y su desfase realistas según cómo se mueva el instrumento: un trigger ajustado en un contrato rápido se comporta de forma muy distinta a uno amplio en un contrato tranquilo." },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "El auto-breakeven es potente, pero sigue suponiendo que usted está en el escritorio para colocar la entrada. <strong class='text-white'>PickMyTrade conecta sus alertas de TradingView directamente con su cuenta de Tradovate</strong>, de modo que las entradas se lanzan solas y un desfase de breakeven puede mover su stop para proteger la posición, sin clics manuales ni activaciones perdidas. La misma lógica de «hacer la operación libre de riesgo en cuanto funciona», ejecutándose mientras usted está lejos de la pantalla." },
  ], fr: [
    { type: "paragraph",html: "Vous avez un trade gagnant et vous voulez le protéger dès que le prix évolue en votre faveur. L’auto-breakeven est la façon de le faire dans Tradovate sans surveiller le graphique. Que vous scalpiez l’ES, détentiez du NQ sur plusieurs jours ou fassiez passer vos entrées par une automatisation comme PickMyTrade, ce guide vous explique pas à pas comment intégrer l’auto-breakeven dans une stratégie ATM Tradovate, pour que votre stop passe tout seul à breakeven dès que vous êtes en profit." },
    { type: "heading",text: "Qu’est-ce que l’auto-breakeven dans une stratégie ATM Tradovate ?" },
    { type: "paragraph",html: "L’auto-breakeven est l’un des <strong class='text-white'>Stop Loss Types</strong> de l’ATM (Advanced Trade Management) de Tradovate. C’est un ordre stop au marché qui se déplace au prix de breakeven de votre position, votre prix d’entrée moyen, dès que votre profit latent atteint un niveau que vous définissez, appelé <strong class='text-white'>Profit Trigger</strong>. Il existe aussi un décalage optionnel, qui permet au stop de se placer un peu au-dessus ou en dessous du véritable breakeven. L’avantage : un trade qui évolue en votre faveur devient sans risque sans que vous ayez à toucher au graphique." },
    { type: "heading",text: "Configurer l’auto-breakeven dans Tradovate : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir l’éditeur de stratégies ATM", html: "Ouvrez un module <strong class='text-white'>Chart</strong> ou <strong class='text-white'>SuperDOM</strong> et repérez la liste déroulante <strong class='text-white'>ATM</strong> dans le panneau de saisie d’ordres. Cliquez sur le bouton en forme de rouage <strong class='text-white'>ATM Settings</strong> juste à côté. L’éditeur de stratégies ATM s’ouvre ; c’est là que résident toutes les stratégies que vous avez enregistrées." },
        { title: "Créer et nommer une nouvelle stratégie", html: "Cliquez sur le bouton <strong class='text-white'>plus (+)</strong> pour créer une nouvelle stratégie, puis donnez-lui un nom que vous reconnaîtrez en pleine séance, par exemple « Auto BE 10 ticks ». Choisissez ensuite votre unité : <strong class='text-white'>Ticks</strong>, <strong class='text-white'>Delta Price</strong> ou <strong class='text-white'>$Value</strong>. Quel que soit votre choix, chaque distance saisie ensuite utilise la même mesure ; définissez-la donc avant de commencer à taper des chiffres." },
        { title: "Ajouter un stop loss et définir le type sur Auto Breakeven", html: "Saisissez une distance de stop loss initiale : c’est votre stop de protection de départ, celui qui est actif dès que vous êtes exécuté. Ouvrez ensuite la liste déroulante <strong class='text-white'>Stop Loss Type</strong> et sélectionnez <strong class='text-white'>Auto Breakeven</strong>. Ce seul choix indique à Tradovate de déplacer le stop à breakeven une fois votre condition de déclenchement remplie, au lieu de le laisser à son niveau initial." },
        { title: "Définir le Profit Trigger et le décalage", html: "Dans le champ <strong class='text-white'>Profit Trigger</strong>, saisissez de combien le prix doit progresser en profit avant que le stop ne se déplace, par exemple 10 ticks. Vous voulez que le stop se place légèrement au-delà du breakeven ? Utilisez le champ de décalage, que Tradovate intitule <strong class='text-white'>« Plus »</strong>. Un nombre positif déplace le stop à breakeven plus ce montant ; un nombre négatif le place en dessous. Laissé à zéro, vous obtenez un stop à breakeven exact." },
        { title: "Enregistrer et sélectionner la stratégie", html: "Cliquez sur <strong class='text-white'>OK</strong> pour enregistrer. Puis, avant de passer un trade, choisissez votre nouvelle stratégie dans la liste déroulante <strong class='text-white'>ATM</strong> ; c’est l’étape que l’on oublie. Une fois votre ordre d’entrée exécuté, Tradovate attache le stop et l’objectif de profit pour vous, et le stop glisse à breakeven dès que votre Profit Trigger est atteint." },
      ],
    },
    { type: "heading",text: "Pourquoi en avez-vous besoin" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Verrouiller un trade sans risque</strong> : dès que le prix évolue en votre faveur, votre pire scénario devient le breakeven au lieu d’une perte.",
        "<strong class='text-white'>Éliminer l’émotion</strong> : le stop se déplace selon des règles, et non par un déplacement manuel nerveux en plein mouvement.",
        "<strong class='text-white'>Scalper plus vite</strong> : gardez vos deux mains sur les entrées et les sorties au lieu de surveiller un seul stop.",
        "<strong class='text-white'>Standardiser votre plan</strong> : enregistrez le profil ATM une fois et réutilisez exactement la même logique de breakeven à chaque trade.",
      ],
    },
    { type: "paragraph",html: "Un comportement à connaître avant de vous y fier : Tradovate ne placera pas le stop d’auto-breakeven au-delà de l’évolution actuelle du prix. Si votre décalage plaçait le stop au-dessus du marché sur une position longue (ou en dessous sur une position courte), le stop ne se déplace que lorsque le prix négocie réellement à travers ce niveau. Gardez donc votre Profit Trigger et votre décalage réalistes par rapport au comportement de l’instrument : un déclencheur serré sur un contrat rapide se comporte très différemment d’un déclencheur large sur un contrat calme." },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "L’auto-breakeven est puissant, mais il suppose toujours que vous êtes devant votre écran pour passer l’entrée. <strong class='text-white'>PickMyTrade relie vos alertes TradingView directement à votre compte Tradovate</strong>, de sorte que les entrées se déclenchent seules et qu’un décalage de breakeven puisse déplacer votre stop pour protéger la position, sans clics manuels ni déclenchements manqués. La même logique « rendre le trade sans risque dès qu’il fonctionne », qui tourne pendant que vous êtes loin de l’écran." },
  ], it: [
    { type: "paragraph",html: "Ha un trade vincente e vuole proteggerlo non appena il prezzo si muove a Suo favore. L’auto-breakeven è il modo per farlo in Tradovate senza dover sorvegliare il grafico. Che faccia scalping su ES, tenga NQ per più giorni o instradi i Suoi ingressi tramite un’automazione come PickMyTrade, questa guida Le mostra passo dopo passo come integrare l’auto-breakeven in una strategia ATM di Tradovate, così che il Suo stop salti da solo a breakeven nel momento in cui è in profitto." },
    { type: "heading",text: "Cos’è l’auto-breakeven in una strategia ATM di Tradovate?" },
    { type: "paragraph",html: "L’auto-breakeven è uno degli <strong class='text-white'>Stop Loss Types</strong> dell’ATM (Advanced Trade Management) di Tradovate. È un ordine stop a mercato che si sposta al prezzo di breakeven della Sua posizione, il Suo prezzo medio di ingresso, nel momento in cui il profitto aperto raggiunge un livello da Lei definito, chiamato <strong class='text-white'>Profit Trigger</strong>. Esiste anche un offset opzionale, che consente allo stop di posizionarsi un po’ sopra o sotto il vero breakeven. Il vantaggio: un trade che funziona diventa privo di rischio senza che Lei debba toccare il grafico." },
    { type: "heading",text: "Configurare l’auto-breakeven in Tradovate: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Apra l’editor delle strategie ATM", html: "Apra un modulo <strong class='text-white'>Chart</strong> o <strong class='text-white'>SuperDOM</strong> e trovi il menu a discesa <strong class='text-white'>ATM</strong> nel pannello di inserimento ordini. Clicchi sul pulsante a forma di ingranaggio <strong class='text-white'>ATM Settings</strong> subito accanto. Si apre l’editor delle strategie ATM, dove si trovano tutte le strategie che ha salvato." },
        { title: "Crei e assegni un nome a una nuova strategia", html: "Prema il pulsante <strong class='text-white'>plus (+)</strong> per creare una nuova strategia, quindi le dia un nome che riconoscerà a metà sessione, ad esempio «Auto BE 10 ticks». Scelga ora l’unità: <strong class='text-white'>Ticks</strong>, <strong class='text-white'>Delta Price</strong> o <strong class='text-white'>$Value</strong>. Qualunque sia la scelta, ogni distanza che inserirà in seguito userà la stessa misura, quindi la imposti prima di iniziare a digitare i numeri." },
        { title: "Aggiunga uno stop loss e imposti il tipo su Auto Breakeven", html: "Inserisca una distanza iniziale di stop loss: è il Suo stop di protezione iniziale, quello attivo nell’istante in cui l’ordine viene eseguito. Quindi apra il menu a discesa <strong class='text-white'>Stop Loss Type</strong> e selezioni <strong class='text-white'>Auto Breakeven</strong>. Questa singola scelta indica a Tradovate di spostare lo stop a breakeven una volta soddisfatta la condizione di attivazione, invece di lasciarlo al livello iniziale." },
        { title: "Imposti il Profit Trigger e l’offset", html: "Nel campo <strong class='text-white'>Profit Trigger</strong> inserisca di quanto il prezzo deve avanzare in profitto prima che lo stop si sposti, ad esempio 10 tick. Vuole che lo stop si collochi leggermente oltre il breakeven? Usi il campo offset, che Tradovate etichetta come <strong class='text-white'>«Plus»</strong>. Un numero positivo sposta lo stop a breakeven più quell’importo; un numero negativo lo porta al di sotto. Se lo lascia a zero, ottiene uno stop a breakeven esatto." },
        { title: "Salvi e selezioni la strategia", html: "Clicchi su <strong class='text-white'>OK</strong> per salvare. Poi, prima di aprire un trade, scelga la Sua nuova strategia dal menu a discesa <strong class='text-white'>ATM</strong>: è il passaggio che molti dimenticano. Una volta eseguito l’ordine di ingresso, Tradovate allega per Lei stop e target di profitto, e lo stop scivola a breakeven nel momento in cui il Profit Trigger viene raggiunto." },
      ],
    },
    { type: "heading",text: "Perché Le serve" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Bloccare un trade privo di rischio</strong>: quando il prezzo si muove a Suo favore, il caso peggiore diventa il breakeven invece di una perdita.",
        "<strong class='text-white'>Eliminare l’emotività</strong>: lo stop si sposta secondo regole, non con un trascinamento manuale nervoso nel bel mezzo del movimento.",
        "<strong class='text-white'>Fare scalping più velocemente</strong>: si concentri su ingressi e uscite invece di sorvegliare un singolo stop.",
        "<strong class='text-white'>Standardizzare il Suo piano</strong>: salvi il profilo ATM una volta e riutilizzi la stessa identica logica di breakeven a ogni trade.",
      ],
    },
    { type: "paragraph",html: "Un comportamento da conoscere prima di farci affidamento: Tradovate non posizionerà lo stop di auto-breakeven davanti all’andamento attuale del prezzo. Se il Suo offset collocasse lo stop sopra il mercato su una posizione long (o sotto su una short), lo stop si sposta solo quando il prezzo scambia effettivamente attraverso quel livello. Mantenga quindi realistici il Profit Trigger e l’offset in base a come si muove lo strumento: un trigger stretto su un contratto veloce si comporta in modo molto diverso da uno ampio su un contratto tranquillo." },
    { type: "heading",text: "Automatizzi tutto questo con PickMyTrade" },
    { type: "paragraph",html: "L’auto-breakeven è potente, ma presuppone comunque che Lei sia alla scrivania per eseguire l’ingresso. <strong class='text-white'>PickMyTrade collega i Suoi alert di TradingView direttamente al Suo conto Tradovate</strong>, così gli ingressi partono da soli e un offset di breakeven può spostare lo stop per proteggere la posizione, senza clic manuali e senza attivazioni perse. La stessa logica «rendere il trade privo di rischio nel momento in cui funziona», in esecuzione mentre Lei è lontano dallo schermo." },
  ] },
  ctaHeading: { en: "Automate the Entry Behind the Breakeven", de: "Automatisieren Sie den Einstieg hinter dem Breakeven", es: "Automatice la entrada detrás del breakeven", fr: "Automatisez l’entrée derrière le breakeven", it: "Automatizzi l’ingresso dietro il breakeven" },
  ctaText: { en: "Auto-breakeven protects the trade once you're in. Let PickMyTrade fire the entry itself from your TradingView alerts.", de: "Auto-Breakeven schützt den Trade, sobald Sie drin sind. Lassen Sie PickMyTrade den Einstieg selbst aus Ihren TradingView-Alerts auslösen.", es: "El auto-breakeven protege la operación una vez dentro. Deje que PickMyTrade lance la propia entrada desde sus alertas de TradingView.", fr: "L’auto-breakeven protège le trade une fois en position. Laissez PickMyTrade déclencher l’entrée elle-même à partir de vos alertes TradingView.", it: "L’auto-breakeven protegge il trade una volta entrati. Lasci che PickMyTrade attivi l’ingresso stesso dai Suoi alert di TradingView." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "What's the difference between the Profit Trigger and the offset?", a: "The Profit Trigger decides when the stop moves, how far into profit price has to go first. The offset, Tradovate's \"Plus\" field, decides where the stop lands: at breakeven, or breakeven plus or minus that amount." },
    { q: "Why didn't my auto-breakeven stop move?", a: "Usually one of two things. Either price never reached the Profit Trigger, or your offset would have placed the stop ahead of price. Tradovate won't set a stop ahead of the market, so it waits until price trades to that level." },
    { q: "Can I combine breakeven with a trailing stop?", a: "Yes. Tradovate also offers an \"Auto BreakEven + AutoTrail\" stop type that first jumps to breakeven, then trails the market after a further profit trigger. Exact labels can change, so confirm the current options in your ATM editor." },
  ], de: [
    { q: "Was ist der Unterschied zwischen Profit Trigger und Offset?", a: "Der Profit Trigger bestimmt, wann der Stop verschoben wird, also wie weit der Kurs zuerst in den Gewinn laufen muss. Der Offset, in Tradovate das Feld „Plus“, bestimmt, wo der Stop landet: auf Breakeven oder auf Breakeven plus bzw. minus diesem Betrag." },
    { q: "Warum hat sich mein Auto-Breakeven-Stop nicht bewegt?", a: "Meist liegt es an einem von zwei Gründen. Entweder hat der Kurs den Profit Trigger nie erreicht, oder Ihr Offset hätte den Stop vor den Kurs gesetzt. Tradovate platziert keinen Stop vor dem Markt und wartet daher, bis der Kurs diese Marke handelt." },
    { q: "Kann ich Breakeven mit einem Trailing-Stop kombinieren?", a: "Ja. Tradovate bietet auch den Stop-Typ „Auto BreakEven + AutoTrail“, der zuerst auf Breakeven springt und nach einem weiteren Profit Trigger dem Markt nachzieht. Die genauen Bezeichnungen können sich ändern, prüfen Sie daher die aktuellen Optionen in Ihrem ATM-Editor." },
  ], es: [
    { q: "¿Cuál es la diferencia entre el Profit Trigger y el desfase (offset)?", a: "El Profit Trigger decide cuándo se mueve el stop, es decir, cuánto debe avanzar el precio en beneficio primero. El desfase, el campo «Plus» de Tradovate, decide dónde queda el stop: en breakeven, o en breakeven más o menos esa cantidad." },
    { q: "¿Por qué no se movió mi stop de auto-breakeven?", a: "Normalmente por una de dos razones. O bien el precio nunca alcanzó el Profit Trigger, o bien su desfase habría colocado el stop por delante del precio. Tradovate no coloca un stop por delante del mercado, así que espera hasta que el precio negocie en ese nivel." },
    { q: "¿Puedo combinar el breakeven con un trailing stop?", a: "Sí. Tradovate también ofrece un tipo de stop «Auto BreakEven + AutoTrail» que primero salta a breakeven y luego sigue al mercado tras un nuevo Profit Trigger. Las etiquetas exactas pueden cambiar, así que confirme las opciones actuales en su editor ATM." },
  ], fr: [
    { q: "Quelle est la différence entre le Profit Trigger et le décalage (offset) ?", a: "Le Profit Trigger détermine quand le stop se déplace, c’est-à-dire de combien le prix doit d’abord progresser en profit. Le décalage, le champ « Plus » de Tradovate, détermine où le stop se place : à breakeven, ou à breakeven plus ou moins ce montant." },
    { q: "Pourquoi mon stop d’auto-breakeven ne s’est-il pas déplacé ?", a: "En général pour l’une de ces deux raisons. Soit le prix n’a jamais atteint le Profit Trigger, soit votre décalage aurait placé le stop au-delà du prix. Tradovate ne place pas de stop au-delà du marché ; il attend donc que le prix négocie à ce niveau." },
    { q: "Puis-je combiner le breakeven avec un stop suiveur ?", a: "Oui. Tradovate propose aussi un type de stop « Auto BreakEven + AutoTrail » qui passe d’abord à breakeven, puis suit le marché après un nouveau Profit Trigger. Les libellés exacts peuvent changer ; confirmez donc les options actuelles dans votre éditeur ATM." },
  ], it: [
    { q: "Qual è la differenza tra il Profit Trigger e l’offset?", a: "Il Profit Trigger decide quando si sposta lo stop, ovvero quanto il prezzo deve prima avanzare in profitto. L’offset, il campo «Plus» di Tradovate, decide dove si posiziona lo stop: a breakeven, oppure a breakeven più o meno quell’importo." },
    { q: "Perché il mio stop di auto-breakeven non si è spostato?", a: "Di solito per uno di due motivi. O il prezzo non ha mai raggiunto il Profit Trigger, oppure il Suo offset avrebbe collocato lo stop davanti al prezzo. Tradovate non imposta uno stop davanti al mercato, quindi attende finché il prezzo non scambia a quel livello." },
    { q: "Posso combinare il breakeven con un trailing stop?", a: "Sì. Tradovate offre anche un tipo di stop «Auto BreakEven + AutoTrail» che prima salta a breakeven e poi segue il mercato dopo un ulteriore Profit Trigger. Le etichette esatte possono cambiare, quindi verifichi le opzioni attuali nel Suo editor ATM." },
  ] },
