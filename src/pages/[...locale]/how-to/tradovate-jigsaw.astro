---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-jigsaw";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Connect Tradovate to Jigsaw Daytradr";
const META_DESCRIPTION =
  "Add a Tradovate connection in Jigsaw Daytradr fast: open Connection Manager, choose Demo or Live, clear 2FA, and start live DOM order-flow trading.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate mit Jigsaw Daytradr verbinden", es: "Conecte Tradovate a Jigsaw Daytradr", fr: "Connecter Tradovate à Jigsaw Daytradr", it: "Collegare Tradovate a Jigsaw Daytradr" },
  dek: { en: "Jigsaw Daytradr talks to Tradovate directly, no bridge software or middleman platform to babysit. Here's the exact path from a blank Connection Manager to a live DOM.", de: "Jigsaw Daytradr kommuniziert direkt mit Tradovate, ohne Bridge-Software oder Zwischenplattform, die Sie beaufsichtigen müssten. Hier ist der genaue Weg vom leeren Connection Manager zum Live-DOM.", es: "Jigsaw Daytradr se comunica directamente con Tradovate, sin software puente ni plataforma intermediaria que vigilar. Este es el camino exacto desde un Connection Manager vacío hasta un DOM en vivo.", fr: "Jigsaw Daytradr communique directement avec Tradovate, sans logiciel passerelle ni plateforme intermédiaire à surveiller. Voici le chemin exact, du Connection Manager vide jusqu'au DOM en direct.", it: "Jigsaw Daytradr dialoga direttamente con Tradovate, senza software bridge né piattaforme intermedie da controllare. Ecco il percorso esatto dal Connection Manager vuoto a un DOM in tempo reale." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Jigsaw Daytradr talks to Tradovate directly, so there's no bridge software or middleman platform to babysit. Once you've licensed Daytradr and have your Tradovate login handy, wiring the two together takes about five minutes. Here's the exact path from a blank Connection Manager to a live DOM printing bids and offers." },
    { type: "heading", text: "What You'll Need First" },
    {
      type: "list",
      items: [
        "A licensed copy of Jigsaw Daytradr on Windows. It's a native Windows app; on a Mac you'll run it through Bootcamp or Parallels.",
        "The latest Daytradr build. Older versions throw connection errors against Tradovate, so update before you start.",
        "Your Tradovate user name and password, the same ones you use on the Tradovate web platform.",
        "A live market-data subscription if you're on a funded or live account. A simulated account streams data without it. Market-data access varies by account type, and for prop accounts it varies by firm, so check your firm's current rules.",
      ],
    },
    { type: "heading", text: "Connecting Tradovate to Daytradr: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open the Connection Manager", html: "Launch Daytradr and click the Connection Manager icon on the dashboard. The menu path is <strong class='text-white'>daytradr Toolset &rsaquo; Connection Manager</strong>. This window is home base for every data feed and broker connection you set up." },
        { title: "Add a Tradovate Connection", html: "Click <strong class='text-white'>+ Add connection</strong> and choose <strong class='text-white'>Tradovate &amp; TSTrader</strong> from the connection-type list. Tradovate and TSTrader run on the same driver, so they share a single entry. You'll see the other feeds there too (CQG, Rithmic, Interactive Brokers, and so on) but Tradovate is the one you want." },
        { title: "Enter Your Connection Details", html: "Fill in the connection form. Name it something you'll recognize, like \"Tradovate Live\" or \"Tradovate Sim.\" Enter your Tradovate <strong class='text-white'>User Name</strong> and <strong class='text-white'>Password</strong> (newer Daytradr builds make this optional and prompt you at connect time instead of storing it). Set <strong class='text-white'>Server</strong> to <strong class='text-white'>Demo</strong> for a simulated account or <strong class='text-white'>Live</strong> for a funded/real account, and leave the <strong class='text-white'>Host</strong> field alone, it fills in automatically. Get the Server right the first time: a Demo login won't authenticate against a Live account, and the reverse is true too, which is the single most common reason a connection sits on \"Pending\" and never lands. If you plan to replay old sessions, tick the <strong class='text-white'>Market Replay</strong> box here as well so you can pull expired contracts into Market Replay later." },
        { title: "Clear Two-Factor Authentication", html: "If 2FA is switched on for your Tradovate account, tick <strong class='text-white'>Login with 2FA</strong> on the connection. The first connect attempt is meant to fail. It only fires off Tradovate's authentication email. Open that email, approve the device, then come back to Daytradr and disconnect and reconnect. The second attempt goes through. Skip this step entirely if you don't have 2FA enabled." },
        { title: "Connect and Test on a DOM", html: "Double-click the connection to connect. Watch the status color: sky blue means connecting, green means connected, and red means it failed. Once you're green, open a Depth &amp; Sales (DOM) window, load a front-month contract like ES or NQ, and confirm the ladder is printing live bids and offers. To prove order routing end to end, place a limit order a few ticks away from price, then cancel it." },
      ],
    },
    { type: "heading", text: "Connection Won't Land? Check These" },
    { type: "paragraph", html: "If Daytradr hangs on \"Pending\" or throws \"Connection Failed,\" it's almost always one of three things:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Old build.</strong> Download and install the current Daytradr version, then try again.",
        "<strong class='text-white'>Wrong Server.</strong> Confirm Demo vs Live matches the account you're logging into.",
        "<strong class='text-white'>2FA not cleared.</strong> Approve the device email, then disconnect and reconnect.",
      ],
    },
    { type: "paragraph", html: "If it still won't connect after all three, the Daytradr side is handled by Jigsaw's own support." },
    { type: "heading", text: "Automate the Same Tradovate Account with PickMyTrade" },
    { type: "paragraph", html: "Jigsaw is built for hands-on, discretionary order-flow trading. If you also want a TradingView strategy firing into that same Tradovate account on its own, PickMyTrade routes those alerts straight through, so your automated setup runs alongside your manual DOM work without you clicking a thing." },
  ], de: [
    { type: "paragraph",html: "Jigsaw Daytradr kommuniziert direkt mit Tradovate, sodass keine Bridge-Software oder Zwischenplattform zu beaufsichtigen ist. Sobald Sie Daytradr lizenziert haben und Ihre Tradovate-Zugangsdaten bereithalten, dauert die Verbindung beider etwa fünf Minuten. Hier ist der genaue Weg vom leeren Connection Manager zu einem Live-DOM, das Bids und Offers anzeigt." },
    { type: "heading",text: "Was Sie zuerst benötigen" },
    {
      type: "list",
      items: [
        "Eine lizenzierte Kopie von Jigsaw Daytradr unter Windows. Es ist eine native Windows-Anwendung; auf einem Mac nutzen Sie sie über Bootcamp oder Parallels.",
        "Der aktuelle Daytradr-Build. Ältere Versionen erzeugen Verbindungsfehler mit Tradovate, aktualisieren Sie also vor dem Start.",
        "Ihr Tradovate-Benutzername und Ihr Passwort, dieselben, die Sie auf der Tradovate-Webplattform verwenden.",
        "Ein Live-Marktdaten-Abonnement, wenn Sie ein finanziertes oder Live-Konto haben. Ein simuliertes Konto streamt Daten auch ohne. Der Zugriff auf Marktdaten variiert je nach Kontotyp und bei Prop-Konten je nach Firma, prüfen Sie daher die aktuellen Regeln Ihrer Firma.",
      ],
    },
    { type: "heading",text: "Tradovate mit Daytradr verbinden: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Den Connection Manager öffnen", html: "Starten Sie Daytradr und klicken Sie auf dem Dashboard auf das Symbol des Connection Managers. Der Menüpfad lautet <strong class='text-white'>daytradr Toolset &rsaquo; Connection Manager</strong>. Dieses Fenster ist die Zentrale für jeden Datenfeed und jede Broker-Verbindung, die Sie einrichten." },
        { title: "Eine Tradovate-Verbindung hinzufügen", html: "Klicken Sie auf <strong class='text-white'>+ Add connection</strong> und wählen Sie <strong class='text-white'>Tradovate &amp; TSTrader</strong> aus der Liste der Verbindungstypen. Tradovate und TSTrader laufen über denselben Treiber und teilen sich daher einen einzigen Eintrag. Sie sehen dort auch die anderen Feeds (CQG, Rithmic, Interactive Brokers usw.), aber Tradovate ist der, den Sie brauchen." },
        { title: "Ihre Verbindungsdaten eingeben", html: "Füllen Sie das Verbindungsformular aus. Geben Sie ihm einen wiedererkennbaren Namen, etwa „Tradovate Live“ oder „Tradovate Sim“. Geben Sie Ihren Tradovate-<strong class='text-white'>User Name</strong> und Ihr <strong class='text-white'>Password</strong> ein (neuere Daytradr-Builds machen dies optional und fragen beim Verbinden danach, statt es zu speichern). Setzen Sie <strong class='text-white'>Server</strong> auf <strong class='text-white'>Demo</strong> für ein simuliertes Konto oder auf <strong class='text-white'>Live</strong> für ein finanziertes bzw. echtes Konto und lassen Sie das Feld <strong class='text-white'>Host</strong> unverändert, es wird automatisch ausgefüllt. Wählen Sie den Server gleich beim ersten Mal richtig: Ein Demo-Login authentifiziert sich nicht an einem Live-Konto und umgekehrt, und das ist der häufigste Grund, warum eine Verbindung auf „Pending“ hängen bleibt und nie zustande kommt. Wenn Sie alte Sitzungen wiedergeben möchten, aktivieren Sie hier auch das Kontrollkästchen <strong class='text-white'>Market Replay</strong>, damit Sie später abgelaufene Kontrakte in Market Replay laden können." },
        { title: "Die Zwei-Faktor-Authentifizierung bestätigen", html: "Wenn 2FA für Ihr Tradovate-Konto aktiviert ist, aktivieren Sie bei der Verbindung <strong class='text-white'>Login with 2FA</strong>. Der erste Verbindungsversuch soll fehlschlagen. Er löst lediglich die Authentifizierungs-E-Mail von Tradovate aus. Öffnen Sie diese E-Mail, bestätigen Sie das Gerät, kehren Sie dann zu Daytradr zurück und trennen Sie die Verbindung und stellen Sie sie neu her. Der zweite Versuch klappt. Überspringen Sie diesen Schritt ganz, wenn Sie 2FA nicht aktiviert haben." },
        { title: "Verbinden und an einem DOM testen", html: "Doppelklicken Sie auf die Verbindung, um sich zu verbinden. Achten Sie auf die Statusfarbe: Himmelblau bedeutet Verbindungsaufbau, Grün verbunden und Rot fehlgeschlagen. Sobald es grün ist, öffnen Sie ein Fenster Depth &amp; Sales (DOM), laden Sie einen Front-Month-Kontrakt wie ES oder NQ und prüfen Sie, ob die Leiter Live-Bids und -Offers anzeigt. Um das Order-Routing durchgängig zu prüfen, platzieren Sie eine Limit-Order einige Ticks vom Kurs entfernt und stornieren Sie sie anschließend." },
      ],
    },
    { type: "heading",text: "Verbindung kommt nicht zustande? Prüfen Sie Folgendes" },
    { type: "paragraph",html: "Wenn Daytradr auf „Pending“ hängt oder „Connection Failed“ meldet, liegt es fast immer an einer von drei Ursachen:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Alter Build.</strong> Laden Sie die aktuelle Daytradr-Version herunter, installieren Sie sie und versuchen Sie es erneut.",
        "<strong class='text-white'>Falscher Server.</strong> Stellen Sie sicher, dass Demo vs. Live zu dem Konto passt, bei dem Sie sich anmelden.",
        "<strong class='text-white'>2FA nicht bestätigt.</strong> Bestätigen Sie die Geräte-E-Mail, trennen Sie dann die Verbindung und verbinden Sie sich neu.",
      ],
    },
    { type: "paragraph",html: "Wenn es nach allen drei Punkten immer noch nicht klappt, ist für die Daytradr-Seite der eigene Support von Jigsaw zuständig." },
    { type: "heading",text: "Dasselbe Tradovate-Konto mit PickMyTrade automatisieren" },
    { type: "paragraph",html: "Jigsaw ist für den manuellen, diskretionären Orderflow-Handel gebaut. Wenn Sie zusätzlich eine TradingView-Strategie eigenständig in dasselbe Tradovate-Konto feuern lassen möchten, leitet PickMyTrade diese Alarme direkt durch, sodass Ihr automatisiertes Setup parallel zu Ihrer manuellen DOM-Arbeit läuft, ohne dass Sie etwas anklicken müssen." },
  ], es: [
    { type: "paragraph",html: "Jigsaw Daytradr se comunica directamente con Tradovate, por lo que no hay software puente ni plataforma intermediaria que vigilar. Una vez que tenga licencia de Daytradr y sus credenciales de Tradovate a mano, conectar ambos lleva unos cinco minutos. Este es el camino exacto desde un Connection Manager vacío hasta un DOM en vivo mostrando bids y offers." },
    { type: "heading",text: "Lo que necesita primero" },
    {
      type: "list",
      items: [
        "Una copia con licencia de Jigsaw Daytradr en Windows. Es una aplicación nativa de Windows; en un Mac deberá ejecutarla mediante Bootcamp o Parallels.",
        "La última versión de Daytradr. Las versiones anteriores generan errores de conexión con Tradovate, así que actualice antes de empezar.",
        "Su nombre de usuario y contraseña de Tradovate, los mismos que utiliza en la plataforma web de Tradovate.",
        "Una suscripción de datos de mercado en vivo si utiliza una cuenta fondeada o real. Una cuenta simulada transmite datos sin ella. El acceso a datos de mercado varía según el tipo de cuenta y, en las cuentas de prop firm, según la firma, así que consulte las reglas vigentes de su firma.",
      ],
    },
    { type: "heading",text: "Conectar Tradovate a Daytradr: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra el Connection Manager", html: "Inicie Daytradr y haga clic en el icono del Connection Manager en el panel. La ruta de menú es <strong class='text-white'>daytradr Toolset &rsaquo; Connection Manager</strong>. Esta ventana es la base de cada fuente de datos y conexión con bróker que configure." },
        { title: "Añada una conexión de Tradovate", html: "Haga clic en <strong class='text-white'>+ Add connection</strong> y elija <strong class='text-white'>Tradovate &amp; TSTrader</strong> en la lista de tipos de conexión. Tradovate y TSTrader funcionan con el mismo controlador, por lo que comparten una única entrada. También verá allí otras fuentes (CQG, Rithmic, Interactive Brokers, etc.), pero Tradovate es la que necesita." },
        { title: "Introduzca los datos de su conexión", html: "Rellene el formulario de conexión. Póngale un nombre que reconozca, como «Tradovate Live» o «Tradovate Sim». Introduzca su <strong class='text-white'>User Name</strong> y su <strong class='text-white'>Password</strong> de Tradovate (las versiones recientes de Daytradr lo hacen opcional y se lo piden al conectar en lugar de guardarlo). Establezca <strong class='text-white'>Server</strong> en <strong class='text-white'>Demo</strong> para una cuenta simulada o en <strong class='text-white'>Live</strong> para una cuenta fondeada o real, y deje el campo <strong class='text-white'>Host</strong> como está, se rellena automáticamente. Acierte con el Server a la primera: un inicio de sesión Demo no se autentica en una cuenta Live, y a la inversa, que es el motivo más común por el que una conexión se queda en «Pending» y nunca se completa. Si piensa reproducir sesiones antiguas, marque también aquí la casilla <strong class='text-white'>Market Replay</strong> para poder cargar contratos vencidos en Market Replay más adelante." },
        { title: "Complete la autenticación de dos factores", html: "Si 2FA está activada en su cuenta de Tradovate, marque <strong class='text-white'>Login with 2FA</strong> en la conexión. El primer intento de conexión está pensado para fallar. Solo dispara el correo de autenticación de Tradovate. Abra ese correo, apruebe el dispositivo, vuelva a Daytradr y desconecte y vuelva a conectar. El segundo intento se completa. Omita este paso por completo si no tiene 2FA activada." },
        { title: "Conéctese y pruebe en un DOM", html: "Haga doble clic en la conexión para conectarse. Observe el color del estado: azul cielo significa conectando, verde conectado y rojo fallido. Cuando esté en verde, abra una ventana Depth &amp; Sales (DOM), cargue un contrato del mes frontal como ES o NQ y confirme que la escalera muestra bids y offers en vivo. Para comprobar el enrutamiento de órdenes de extremo a extremo, coloque una orden limit a unos ticks del precio y luego cancélela." },
      ],
    },
    { type: "heading",text: "¿No se completa la conexión? Revise esto" },
    { type: "paragraph",html: "Si Daytradr se queda en «Pending» o muestra «Connection Failed», casi siempre se trata de una de tres cosas:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Versión antigua.</strong> Descargue e instale la versión actual de Daytradr y vuelva a intentarlo.",
        "<strong class='text-white'>Server incorrecto.</strong> Confirme que Demo o Live coincide con la cuenta en la que inicia sesión.",
        "<strong class='text-white'>2FA sin completar.</strong> Apruebe el correo del dispositivo y luego desconecte y vuelva a conectar.",
      ],
    },
    { type: "paragraph",html: "Si sigue sin conectarse después de revisar las tres, la parte de Daytradr corresponde al soporte propio de Jigsaw." },
    { type: "heading",text: "Automatice la misma cuenta de Tradovate con PickMyTrade" },
    { type: "paragraph",html: "Jigsaw está diseñado para el trading de order flow manual y discrecional. Si además desea que una estrategia de TradingView opere por sí sola en esa misma cuenta de Tradovate, PickMyTrade enruta esas alertas directamente, de modo que su configuración automatizada funciona junto a su trabajo manual en el DOM sin que tenga que hacer clic en nada." },
  ], fr: [
    { type: "paragraph",html: "Jigsaw Daytradr communique directement avec Tradovate, il n'y a donc aucun logiciel passerelle ni plateforme intermédiaire à surveiller. Une fois Daytradr sous licence et vos identifiants Tradovate à portée de main, relier les deux prend environ cinq minutes. Voici le chemin exact, d'un Connection Manager vide jusqu'à un DOM en direct affichant les bids et les offers." },
    { type: "heading",text: "Ce dont vous avez besoin au préalable" },
    {
      type: "list",
      items: [
        "Une copie sous licence de Jigsaw Daytradr sous Windows. C'est une application Windows native ; sur un Mac, vous l'exécuterez via Bootcamp ou Parallels.",
        "La dernière version de Daytradr. Les versions plus anciennes génèrent des erreurs de connexion avec Tradovate ; mettez donc à jour avant de commencer.",
        "Votre nom d'utilisateur et votre mot de passe Tradovate, ceux que vous utilisez sur la plateforme web de Tradovate.",
        "Un abonnement aux données de marché en direct si vous utilisez un compte financé ou réel. Un compte simulé diffuse des données sans cela. L'accès aux données de marché varie selon le type de compte et, pour les comptes de prop firm, selon la firme ; vérifiez donc les règles en vigueur de votre firme.",
      ],
    },
    { type: "heading",text: "Connecter Tradovate à Daytradr : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir le Connection Manager", html: "Lancez Daytradr et cliquez sur l'icône du Connection Manager sur le tableau de bord. Le chemin de menu est <strong class='text-white'>daytradr Toolset &rsaquo; Connection Manager</strong>. Cette fenêtre est le point central de chaque flux de données et de chaque connexion courtier que vous configurez." },
        { title: "Ajouter une connexion Tradovate", html: "Cliquez sur <strong class='text-white'>+ Add connection</strong> et choisissez <strong class='text-white'>Tradovate &amp; TSTrader</strong> dans la liste des types de connexion. Tradovate et TSTrader utilisent le même pilote et partagent donc une seule entrée. Vous y verrez aussi les autres flux (CQG, Rithmic, Interactive Brokers, etc.), mais Tradovate est celui qu'il vous faut." },
        { title: "Saisir les détails de votre connexion", html: "Remplissez le formulaire de connexion. Donnez-lui un nom que vous reconnaîtrez, comme « Tradovate Live » ou « Tradovate Sim ». Saisissez votre <strong class='text-white'>User Name</strong> et votre <strong class='text-white'>Password</strong> Tradovate (les versions récentes de Daytradr rendent cela facultatif et vous les demandent à la connexion au lieu de les enregistrer). Réglez <strong class='text-white'>Server</strong> sur <strong class='text-white'>Demo</strong> pour un compte simulé ou sur <strong class='text-white'>Live</strong> pour un compte financé ou réel, et laissez le champ <strong class='text-white'>Host</strong> tel quel, il se remplit automatiquement. Choisissez le bon Server dès le départ : un identifiant Demo ne s'authentifie pas sur un compte Live, et inversement, ce qui est la raison la plus fréquente pour laquelle une connexion reste sur « Pending » sans jamais aboutir. Si vous prévoyez de rejouer d'anciennes séances, cochez aussi ici la case <strong class='text-white'>Market Replay</strong> afin de pouvoir charger plus tard des contrats expirés dans Market Replay." },
        { title: "Valider l'authentification à deux facteurs", html: "Si la 2FA est activée sur votre compte Tradovate, cochez <strong class='text-white'>Login with 2FA</strong> sur la connexion. La première tentative de connexion est censée échouer. Elle ne fait que déclencher l'e-mail d'authentification de Tradovate. Ouvrez cet e-mail, approuvez l'appareil, puis revenez dans Daytradr, déconnectez-vous et reconnectez-vous. La seconde tentative aboutit. Ignorez complètement cette étape si vous n'avez pas activé la 2FA." },
        { title: "Se connecter et tester sur un DOM", html: "Double-cliquez sur la connexion pour vous connecter. Surveillez la couleur du statut : bleu ciel signifie connexion en cours, vert connecté et rouge échec. Une fois au vert, ouvrez une fenêtre Depth &amp; Sales (DOM), chargez un contrat du mois rapproché comme ES ou NQ et vérifiez que l'échelle affiche des bids et des offers en direct. Pour valider le routage des ordres de bout en bout, placez un ordre à cours limité à quelques ticks du prix, puis annulez-le." },
      ],
    },
    { type: "heading",text: "La connexion n'aboutit pas ? Vérifiez ceci" },
    { type: "paragraph",html: "Si Daytradr reste sur « Pending » ou affiche « Connection Failed », c'est presque toujours l'une de ces trois causes :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Ancienne version.</strong> Téléchargez et installez la version actuelle de Daytradr, puis réessayez.",
        "<strong class='text-white'>Mauvais Server.</strong> Vérifiez que Demo ou Live correspond au compte auquel vous vous connectez.",
        "<strong class='text-white'>2FA non validée.</strong> Approuvez l'e-mail de l'appareil, puis déconnectez-vous et reconnectez-vous.",
      ],
    },
    { type: "paragraph",html: "Si la connexion ne fonctionne toujours pas après ces trois vérifications, le côté Daytradr relève du support propre à Jigsaw." },
    { type: "heading",text: "Automatiser le même compte Tradovate avec PickMyTrade" },
    { type: "paragraph",html: "Jigsaw est conçu pour le trading d'order flow manuel et discrétionnaire. Si vous souhaitez en plus qu'une stratégie TradingView s'exécute seule sur ce même compte Tradovate, PickMyTrade achemine ces alertes directement, de sorte que votre configuration automatisée fonctionne en parallèle de votre travail manuel sur le DOM, sans que vous ayez à cliquer." },
  ], it: [
    { type: "paragraph",html: "Jigsaw Daytradr dialoga direttamente con Tradovate, quindi non c'è alcun software bridge o piattaforma intermedia da controllare. Una volta ottenuta la licenza di Daytradr e con le credenziali Tradovate a portata di mano, collegare i due richiede circa cinque minuti. Ecco il percorso esatto da un Connection Manager vuoto a un DOM in tempo reale che mostra bid e offer." },
    { type: "heading",text: "Che cosa le serve prima" },
    {
      type: "list",
      items: [
        "Una copia con licenza di Jigsaw Daytradr su Windows. È un'applicazione Windows nativa; su un Mac la eseguirà tramite Bootcamp o Parallels.",
        "L'ultima build di Daytradr. Le versioni più vecchie generano errori di connessione con Tradovate, quindi aggiorni prima di iniziare.",
        "Il suo nome utente e la sua password Tradovate, gli stessi che usa sulla piattaforma web di Tradovate.",
