---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-logout";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "How to Log Out of Tradovate";
const META_DESCRIPTION =
  "How to log out of Tradovate on web, desktop, mobile, and TradingView. A quick menu walkthrough to end your session and free up a login slot.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "So melden Sie sich von Tradovate ab", es: "Cómo cerrar sesión en Tradovate", fr: "Comment se déconnecter de Tradovate", it: "Come disconnettersi da Tradovate" },
  dek: { en: "Logging out of Tradovate is a two-click job once you know where the button lives, but it sits in a different spot on each platform. Here's how to end your session cleanly wherever you're signed in.", de: "Sich von Tradovate abzumelden ist in zwei Klicks erledigt, sobald Sie wissen, wo die Schaltfläche sitzt, doch sie befindet sich auf jeder Plattform an einer anderen Stelle. So beenden Sie Ihre Sitzung sauber, wo auch immer Sie angemeldet sind.", es: "Cerrar sesión en Tradovate son dos clics una vez que sabe dónde está el botón, pero se encuentra en un lugar distinto en cada plataforma. Así es como termina su sesión de forma limpia dondequiera que haya iniciado sesión.", fr: "Se déconnecter de Tradovate se fait en deux clics une fois que vous savez où se trouve le bouton, mais il est placé à un endroit différent sur chaque plateforme. Voici comment terminer proprement votre session, où que vous soyez connecté.", it: "Disconnettersi da Tradovate richiede due clic, una volta che sa dove si trova il pulsante, ma questo si trova in un punto diverso su ciascuna piattaforma. Ecco come terminare la Sua sessione in modo pulito ovunque abbia effettuato l’accesso." },
  readTime: { en: "4 min read", de: "4 Min. Lesezeit", es: "Lectura de 4 min", fr: "Lecture : 4 min", it: "Lettura di 4 min" },
  lastUpdated: "2026-07-10",
  blocks: { en: [
    { type: "paragraph", html: "Logging out of Tradovate is a two-click job once you know where the button lives. It's the same idea on web, desktop, and mobile: open your account menu and hit Logout. The reason it trips people up is that the control sits in a different spot on each platform, and Tradovate also runs behind TradingView and prop-firm dashboards, so \"logging out\" can mean a few different things. Here's how to end your session cleanly wherever you're signed in." },
    { type: "heading", text: "When You Actually Need to Log Out" },
    { type: "paragraph", html: "You don't have to sign out every time you step away, but there are a handful of moments where it matters:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Shared or public computer</strong>, never leave a live trading session open behind you.",
        "<strong class='text-white'>Freeing a session slot.</strong> Tradovate limits how many places you can be logged in at once. If you're bouncing between the web app, the desktop app, mobile, and a TradingView connection, a stale session can trigger disconnects and a DeviceQuotaReached error. Logging out where you're not actively trading frees that slot.",
        "<strong class='text-white'>Switching accounts</strong>, say, moving from a personal account to a prop-firm evaluation login.",
        "<strong class='text-white'>Fixing a login loop.</strong> A clean log out and back in clears a surprising number of frozen-chart and stuck-session problems.",
      ],
    },
    { type: "heading", text: "How to Log Out of Tradovate: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open the Account Menu (Web & Desktop)", html: "In the Tradovate web platform or the downloadable desktop app, look to the top corner of the screen for your <strong class='text-white'>account name or avatar</strong>. Click it to drop open the account menu. This is the same menu that holds your settings and profile, so if you've ever adjusted risk settings, you've been here before.", image: { src: `${IMG}/tradovate-logout-1.png`, alt: "Tradovate web platform with the account menu open in the top corner showing the Logout option" } },
        { title: "Click Logout", html: "Select <strong class='text-white'>Logout</strong> from the menu. Tradovate closes your session and drops you back at the login screen. One important thing to know: logging out does <strong class='text-white'>not</strong> flatten your positions or cancel your working orders. Resting stops, targets, and any open trades live on the broker's servers, not in your browser, so they keep running after you sign out. If you want to be flat before you leave, close your positions and cancel orders first, then log out.", image: { src: `${IMG}/tradovate-logout-2.png`, alt: "Tradovate login screen shown after selecting Logout, confirming the session has ended" } },
        { title: "Log Out of the Mobile App", html: "On the Tradovate mobile app, the menu sits on the opposite side. Tap the <strong class='text-white'>Menu (hamburger) icon</strong> in the top-left corner to slide out the navigation panel, then tap <strong class='text-white'>Logout</strong> at the bottom. Same result as the desktop: your session ends and the app returns to the sign-in screen.", image: { src: `${IMG}/tradovate-logout-3.jpg`, alt: "Tradovate mobile app side menu opened from the top-left hamburger icon with the Logout option visible" } },
        { title: "Sign Out From a TradingView Connection", html: "If you route your Tradovate account through <strong class='text-white'>TradingView</strong>, closing the Tradovate web app doesn't disconnect that link. Open your chart, find the <strong class='text-white'>Tradovate tab</strong> in the trading panel at the bottom, and click the dropdown or gear next to your connected account. Choose <strong class='text-white'>Log Out</strong> to cut the broker connection. Do this whenever you're wrestling with session conflicts, since each TradingView browser tab can count as its own session." },
      ],
    },
    { type: "heading", text: "Does Tradovate Log You Out on Its Own?" },
    { type: "paragraph", html: "There's no aggressive inactivity timer that boots you after a few idle minutes, so a session can stay open for a long stretch. If you're getting kicked out unexpectedly, the usual culprits aren't a Tradovate timeout at all: a browser putting an inactive tab to sleep, an unstable connection, or hitting the concurrent-session limit from being logged in on too many devices at once. Signing out of the places you're not using is the quickest fix. Session and device limits vary by account and prop firm, so check your firm's current rules if you're on an evaluation." },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "The catch with signing off is that your strategy signs off too. <strong class='text-white'>PickMyTrade runs in the cloud</strong>, so it routes your TradingView alerts straight into Tradovate and keeps executing even when you've closed every tab and shut the laptop." },
  ], de: [
    { type: "paragraph",html: "Sich von Tradovate abzumelden ist in zwei Klicks erledigt, sobald Sie wissen, wo die Schaltfläche sitzt. Das Prinzip ist im Web, auf dem Desktop und mobil dasselbe: Öffnen Sie Ihr Kontomenü und klicken Sie auf Logout. Es sorgt deshalb für Verwirrung, weil sich das Steuerelement auf jeder Plattform an anderer Stelle befindet und Tradovate zudem hinter TradingView und Prop-Firm-Dashboards läuft, sodass „Abmelden“ mehrere Dinge bedeuten kann. So beenden Sie Ihre Sitzung sauber, wo auch immer Sie angemeldet sind." },
    { type: "heading",text: "Wann Sie sich tatsächlich abmelden müssen" },
    { type: "paragraph",html: "Sie müssen sich nicht jedes Mal abmelden, wenn Sie sich entfernen, aber in einigen Momenten ist es wichtig:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Gemeinsam genutzter oder öffentlicher Computer</strong>, lassen Sie niemals eine aktive Handelssitzung hinter sich geöffnet.",
        "<strong class='text-white'>Einen Sitzungsplatz freigeben.</strong> Tradovate begrenzt, an wie vielen Orten Sie gleichzeitig angemeldet sein können. Wenn Sie zwischen Web-App, Desktop-App, Mobil und einer TradingView-Verbindung wechseln, kann eine veraltete Sitzung Verbindungsabbrüche und einen DeviceQuotaReached-Fehler auslösen. Die Abmeldung dort, wo Sie nicht aktiv handeln, gibt diesen Platz frei.",
        "<strong class='text-white'>Konten wechseln</strong>, etwa von einem persönlichen Konto zu einem Prop-Firm-Evaluierungs-Login.",
        "<strong class='text-white'>Eine Login-Schleife beheben.</strong> Eine saubere Abmeldung und erneute Anmeldung löst erstaunlich viele Probleme mit eingefrorenen Charts und hängenden Sitzungen.",
      ],
    },
    { type: "heading",text: "So melden Sie sich von Tradovate ab: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Öffnen Sie das Kontomenü (Web & Desktop)", html: "Suchen Sie in der Tradovate-Webplattform oder der herunterladbaren Desktop-App in der oberen Ecke des Bildschirms nach Ihrem <strong class='text-white'>Kontonamen oder Avatar</strong>. Klicken Sie darauf, um das Kontomenü zu öffnen. Es ist dasselbe Menü, das Ihre Einstellungen und Ihr Profil enthält. Wenn Sie also schon einmal Risikoeinstellungen angepasst haben, waren Sie bereits hier.", image: {"src":`${IMG}/tradovate-logout-1.png`,"alt":"Tradovate-Webplattform mit geöffnetem Kontomenü in der oberen Ecke und der Option Logout"} },
        { title: "Klicken Sie auf Logout", html: "Wählen Sie im Menü <strong class='text-white'>Logout</strong>. Tradovate beendet Ihre Sitzung und bringt Sie zurück zum Anmeldebildschirm. Wichtig zu wissen: Die Abmeldung schließt Ihre Positionen <strong class='text-white'>nicht</strong> und storniert Ihre aktiven Orders nicht. Ruhende Stops, Ziele und alle offenen Trades liegen auf den Servern des Brokers, nicht in Ihrem Browser, und laufen daher nach der Abmeldung weiter. Wenn Sie vor dem Verlassen flat sein möchten, schließen Sie zuerst Ihre Positionen und stornieren Sie Orders, und melden Sie sich dann ab.", image: {"src":`${IMG}/tradovate-logout-2.png`,"alt":"Tradovate-Anmeldebildschirm nach Auswahl von Logout, der bestätigt, dass die Sitzung beendet wurde"} },
        { title: "Melden Sie sich in der Mobil-App ab", html: "In der Tradovate-Mobil-App befindet sich das Menü auf der gegenüberliegenden Seite. Tippen Sie oben links auf das <strong class='text-white'>Menüsymbol (Hamburger)</strong>, um das Navigationspanel auszufahren, und tippen Sie dann unten auf <strong class='text-white'>Logout</strong>. Das Ergebnis ist wie am Desktop: Ihre Sitzung endet und die App kehrt zum Anmeldebildschirm zurück.", image: {"src":`${IMG}/tradovate-logout-3.jpg`,"alt":"Seitenmenü der Tradovate-Mobil-App, geöffnet über das Hamburger-Symbol oben links, mit sichtbarer Option Logout"} },
        { title: "Melden Sie sich von einer TradingView-Verbindung ab", html: "Wenn Sie Ihr Tradovate-Konto über <strong class='text-white'>TradingView</strong> nutzen, trennt das Schließen der Tradovate-Web-App diese Verbindung nicht. Öffnen Sie Ihren Chart, suchen Sie im Handelspanel unten den <strong class='text-white'>Tradovate-Tab</strong> und klicken Sie auf das Dropdown oder Zahnrad neben Ihrem verbundenen Konto. Wählen Sie <strong class='text-white'>Log Out</strong>, um die Broker-Verbindung zu trennen. Tun Sie dies immer, wenn Sie mit Sitzungskonflikten kämpfen, da jeder TradingView-Browser-Tab als eigene Sitzung zählen kann." },
      ],
    },
    { type: "heading",text: "Meldet Tradovate Sie von selbst ab?" },
    { type: "paragraph",html: "Es gibt keinen aggressiven Inaktivitäts-Timer, der Sie nach wenigen Minuten Leerlauf hinauswirft, sodass eine Sitzung lange geöffnet bleiben kann. Wenn Sie unerwartet hinausgeworfen werden, sind die üblichen Ursachen gar kein Tradovate-Timeout: ein Browser, der einen inaktiven Tab in den Ruhezustand versetzt, eine instabile Verbindung oder das Erreichen des Limits gleichzeitiger Sitzungen, weil Sie auf zu vielen Geräten gleichzeitig angemeldet sind. Das Abmelden von nicht genutzten Orten ist die schnellste Lösung. Sitzungs- und Gerätelimits variieren je nach Konto und Prop Firm. Prüfen Sie daher die aktuellen Regeln Ihrer Firma, wenn Sie sich in einer Evaluierung befinden." },
    { type: "heading",text: "Automatisieren Sie das mit PickMyTrade" },
    { type: "paragraph",html: "Der Haken beim Abmelden ist, dass sich Ihre Strategie mit abmeldet. <strong class='text-white'>PickMyTrade läuft in der Cloud</strong> und leitet Ihre TradingView-Alarme direkt an Tradovate weiter und führt sie weiter aus, selbst wenn Sie alle Tabs geschlossen und den Laptop zugeklappt haben." },
  ], es: [
    { type: "paragraph",html: "Cerrar sesión en Tradovate son dos clics una vez que sabe dónde está el botón. Es la misma idea en la web, el escritorio y el móvil: abra el menú de su cuenta y pulse Logout. Lo que confunde a la gente es que el control está en un lugar distinto en cada plataforma, y que Tradovate también funciona detrás de TradingView y de los paneles de las empresas de fondeo, por lo que «cerrar sesión» puede significar varias cosas. Así es como termina su sesión de forma limpia dondequiera que haya iniciado sesión." },
    { type: "heading",text: "Cuándo necesita realmente cerrar sesión" },
    { type: "paragraph",html: "No tiene que cerrar sesión cada vez que se aleja, pero hay un puñado de momentos en los que importa:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Ordenador compartido o público</strong>, nunca deje una sesión de trading activa abierta a sus espaldas.",
        "<strong class='text-white'>Liberar un espacio de sesión.</strong> Tradovate limita en cuántos lugares puede tener la sesión iniciada a la vez. Si alterna entre la aplicación web, la de escritorio, el móvil y una conexión de TradingView, una sesión obsoleta puede provocar desconexiones y un error DeviceQuotaReached. Cerrar sesión donde no esté operando activamente libera ese espacio.",
        "<strong class='text-white'>Cambiar de cuenta</strong>, por ejemplo, pasar de una cuenta personal a un inicio de sesión de evaluación de una empresa de fondeo.",
        "<strong class='text-white'>Solucionar un bucle de inicio de sesión.</strong> Cerrar sesión y volver a entrar resuelve un número sorprendente de problemas de gráficos congelados y sesiones atascadas.",
      ],
    },
    { type: "heading",text: "Cómo cerrar sesión en Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra el menú de la cuenta (web y escritorio)", html: "En la plataforma web de Tradovate o en la aplicación de escritorio descargable, busque en la esquina superior de la pantalla su <strong class='text-white'>nombre de cuenta o avatar</strong>. Haga clic para desplegar el menú de la cuenta. Es el mismo menú que contiene su configuración y su perfil, así que si alguna vez ha ajustado la configuración de riesgo, ya ha estado aquí.", image: {"src":`${IMG}/tradovate-logout-1.png`,"alt":"Plataforma web de Tradovate con el menú de la cuenta abierto en la esquina superior mostrando la opción Logout"} },
        { title: "Haga clic en Logout", html: "Seleccione <strong class='text-white'>Logout</strong> en el menú. Tradovate cierra su sesión y le devuelve a la pantalla de inicio de sesión. Algo importante que debe saber: cerrar sesión <strong class='text-white'>no</strong> cierra sus posiciones ni cancela sus órdenes activas. Los stops, objetivos y cualquier operación abierta residen en los servidores del bróker, no en su navegador, por lo que siguen funcionando después de cerrar sesión. Si quiere estar flat antes de irse, cierre primero sus posiciones y cancele las órdenes, y luego cierre sesión.", image: {"src":`${IMG}/tradovate-logout-2.png`,"alt":"Pantalla de inicio de sesión de Tradovate tras seleccionar Logout, confirmando que la sesión ha terminado"} },
        { title: "Cierre sesión en la aplicación móvil", html: "En la aplicación móvil de Tradovate, el menú está en el lado opuesto. Toque el <strong class='text-white'>icono de menú (hamburguesa)</strong> en la esquina superior izquierda para desplegar el panel de navegación y luego toque <strong class='text-white'>Logout</strong> en la parte inferior. El resultado es el mismo que en el escritorio: su sesión termina y la aplicación vuelve a la pantalla de inicio de sesión.", image: {"src":`${IMG}/tradovate-logout-3.jpg`,"alt":"Menú lateral de la aplicación móvil de Tradovate abierto desde el icono de hamburguesa en la esquina superior izquierda con la opción Logout visible"} },
        { title: "Cierre sesión desde una conexión de TradingView", html: "Si enruta su cuenta de Tradovate a través de <strong class='text-white'>TradingView</strong>, cerrar la aplicación web de Tradovate no desconecta ese enlace. Abra su gráfico, busque la <strong class='text-white'>pestaña Tradovate</strong> en el panel de trading de la parte inferior y haga clic en el menú desplegable o el engranaje junto a su cuenta conectada. Elija <strong class='text-white'>Log Out</strong> para cortar la conexión con el bróker. Haga esto siempre que tenga conflictos de sesión, ya que cada pestaña del navegador de TradingView puede contar como una sesión propia." },
      ],
    },
    { type: "heading",text: "¿Tradovate cierra la sesión por sí solo?" },
    { type: "paragraph",html: "No existe un temporizador agresivo de inactividad que le expulse tras unos minutos sin actividad, por lo que una sesión puede permanecer abierta durante mucho tiempo. Si le expulsan de forma inesperada, los culpables habituales no son en absoluto un tiempo de espera de Tradovate: un navegador que suspende una pestaña inactiva, una conexión inestable o alcanzar el límite de sesiones simultáneas por estar conectado en demasiados dispositivos a la vez. Cerrar sesión en los lugares que no usa es la solución más rápida. Los límites de sesión y de dispositivos varían según la cuenta y la empresa de fondeo, así que consulte las reglas actuales de su empresa si está en una evaluación." },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "El inconveniente de desconectarse es que su estrategia también se desconecta. <strong class='text-white'>PickMyTrade se ejecuta en la nube</strong>, por lo que enruta sus alertas de TradingView directamente a Tradovate y sigue ejecutándose incluso cuando ha cerrado todas las pestañas y el portátil." },
  ], fr: [
    { type: "paragraph",html: "Se déconnecter de Tradovate se fait en deux clics une fois que vous savez où se trouve le bouton. C’est le même principe sur le web, le bureau et le mobile : ouvrez le menu de votre compte et appuyez sur Logout. Cela déroute parce que la commande se trouve à un endroit différent sur chaque plateforme, et que Tradovate fonctionne aussi derrière TradingView et les tableaux de bord de prop firm ; « se déconnecter » peut donc signifier plusieurs choses. Voici comment terminer proprement votre session, où que vous soyez connecté." },
    { type: "heading",text: "Quand vous devez réellement vous déconnecter" },
    { type: "paragraph",html: "Il n’est pas nécessaire de vous déconnecter chaque fois que vous vous éloignez, mais il existe quelques situations où cela compte :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Ordinateur partagé ou public</strong>, ne laissez jamais une session de trading active ouverte derrière vous.",
        "<strong class='text-white'>Libérer un emplacement de session.</strong> Tradovate limite le nombre d’endroits où vous pouvez être connecté simultanément. Si vous passez d’une application web à l’application de bureau, au mobile et à une connexion TradingView, une session obsolète peut provoquer des déconnexions et une erreur DeviceQuotaReached. Se déconnecter là où vous ne tradez pas activement libère cet emplacement.",
        "<strong class='text-white'>Changer de compte</strong>, par exemple passer d’un compte personnel à une connexion d’évaluation de prop firm.",
        "<strong class='text-white'>Résoudre une boucle de connexion.</strong> Une déconnexion suivie d’une reconnexion règle étonnamment de problèmes de graphiques figés et de sessions bloquées.",
      ],
    },
    { type: "heading",text: "Comment se déconnecter de Tradovate : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez le menu du compte (web et bureau)", html: "Dans la plateforme web Tradovate ou l’application de bureau téléchargeable, repérez dans le coin supérieur de l’écran votre <strong class='text-white'>nom de compte ou avatar</strong>. Cliquez dessus pour ouvrir le menu du compte. C’est le même menu que celui qui contient vos paramètres et votre profil ; si vous avez déjà ajusté vos paramètres de risque, vous y êtes donc déjà allé.", image: {"src":`${IMG}/tradovate-logout-1.png`,"alt":"Plateforme web Tradovate avec le menu du compte ouvert dans le coin supérieur affichant l’option Logout"} },
        { title: "Cliquez sur Logout", html: "Sélectionnez <strong class='text-white'>Logout</strong> dans le menu. Tradovate ferme votre session et vous ramène à l’écran de connexion. Point important : la déconnexion ne clôture <strong class='text-white'>pas</strong> vos positions et n’annule pas vos ordres actifs. Les stops, objectifs et trades ouverts en attente résident sur les serveurs du courtier, et non dans votre navigateur ; ils continuent donc de fonctionner après la déconnexion. Si vous souhaitez être à plat avant de partir, clôturez d’abord vos positions et annulez vos ordres, puis déconnectez-vous.", image: {"src":`${IMG}/tradovate-logout-2.png`,"alt":"Écran de connexion Tradovate affiché après la sélection de Logout, confirmant que la session est terminée"} },
        { title: "Déconnectez-vous de l’application mobile", html: "Dans l’application mobile Tradovate, le menu se trouve du côté opposé. Touchez l’<strong class='text-white'>icône de menu (hamburger)</strong> en haut à gauche pour faire glisser le panneau de navigation, puis touchez <strong class='text-white'>Logout</strong> en bas. Même résultat que sur le bureau : votre session se termine et l’application revient à l’écran de connexion.", image: {"src":`${IMG}/tradovate-logout-3.jpg`,"alt":"Menu latéral de l’application mobile Tradovate ouvert depuis l’icône hamburger en haut à gauche avec l’option Logout visible"} },
        { title: "Déconnectez-vous d’une connexion TradingView", html: "Si vous acheminez votre compte Tradovate via <strong class='text-white'>TradingView</strong>, la fermeture de l’application web Tradovate ne coupe pas cette liaison. Ouvrez votre graphique, repérez l’<strong class='text-white'>onglet Tradovate</strong> dans le panneau de trading en bas, puis cliquez sur le menu déroulant ou l’engrenage à côté de votre compte connecté. Choisissez <strong class='text-white'>Log Out</strong> pour couper la connexion au courtier. Faites-le chaque fois que vous êtes confronté à des conflits de session, car chaque onglet de navigateur TradingView peut compter comme une session à part entière." },
      ],
    },
    { type: "heading",text: "Tradovate vous déconnecte-t-il de lui-même ?" },
    { type: "paragraph",html: "Il n’existe aucun minuteur d’inactivité agressif qui vous éjecte après quelques minutes d’inactivité ; une session peut donc rester ouverte très longtemps. Si vous êtes déconnecté de façon inattendue, les causes habituelles n’ont rien à voir avec un délai d’expiration de Tradovate : un navigateur qui met en veille un onglet inactif, une connexion instable ou l’atteinte de la limite de sessions simultanées parce que vous êtes connecté sur trop d’appareils à la fois. Vous déconnecter des endroits que vous n’utilisez pas est la solution la plus rapide. Les limites de session et d’appareils varient selon le compte et la prop firm ; consultez donc les règles actuelles de votre société si vous êtes en évaluation." },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "L’inconvénient de la déconnexion, c’est que votre stratégie se déconnecte aussi. <strong class='text-white'>PickMyTrade fonctionne dans le cloud</strong> : il achemine donc vos alertes TradingView directement vers Tradovate et continue de s’exécuter même lorsque vous avez fermé tous les onglets et votre ordinateur portable." },
  ], it: [
    { type: "paragraph",html: "Disconnettersi da Tradovate richiede due clic, una volta che sa dove si trova il pulsante. L’idea è la stessa su web, desktop e mobile: apra il menu del Suo conto e prema Logout. Ciò che confonde è che il controllo si trova in un punto diverso su ciascuna piattaforma e che Tradovate funziona anche dietro TradingView e le dashboard delle prop firm, quindi «disconnettersi» può significare cose diverse. Ecco come terminare la Sua sessione in modo pulito ovunque abbia effettuato l’accesso." },
    { type: "heading",text: "Quando deve davvero disconnettersi" },
    { type: "paragraph",html: "Non deve disconnettersi ogni volta che si allontana, ma ci sono alcuni momenti in cui è importante:" },
    {
      type: "list",
      items: [
