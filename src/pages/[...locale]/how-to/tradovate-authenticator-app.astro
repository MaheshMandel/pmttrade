---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-authenticator-app";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Set Up an Authenticator App for Tradovate 2FA";
const META_DESCRIPTION =
  "Secure your futures account logins with a TOTP authenticator app: scan the QR code, verify a six-digit code, and set a backup method to avoid lockouts.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Authenticator-App für die Tradovate-2FA einrichten", es: "Configure una app de autenticación para la 2FA de Tradovate", fr: "Configurer une application d’authentification pour la 2FA de Tradovate", it: "Configurare un’app di autenticazione per la 2FA di Tradovate" },
  dek: { en: "Email codes get the job done, but they're slow and only as safe as your inbox. Here's how to switch your Tradovate account over to a time-based one-time password (TOTP) app, and how to set a backup so a lost or wiped phone never locks you out.", de: "E-Mail-Codes erfüllen ihren Zweck, sind aber langsam und nur so sicher wie Ihr Posteingang. So stellen Sie Ihr Tradovate-Konto auf eine App für zeitbasierte Einmalpasswörter (TOTP) um und richten eine Sicherung ein, damit ein verlorenes oder zurückgesetztes Smartphone Sie nie aussperrt.", es: "Los códigos por correo cumplen su función, pero son lentos y solo tan seguros como su bandeja de entrada. Así puede pasar su cuenta de Tradovate a una app de contraseñas de un solo uso basadas en tiempo (TOTP) y configurar un respaldo para que un teléfono perdido o restablecido nunca le deje sin acceso.", fr: "Les codes par e-mail font l’affaire, mais ils sont lents et aussi sûrs que votre boîte de réception. Voici comment faire passer votre compte Tradovate à une application de mots de passe à usage unique basés sur le temps (TOTP) et comment définir une solution de secours pour qu’un téléphone perdu ou réinitialisé ne vous bloque jamais.", it: "I codici via e-mail funzionano, ma sono lenti e sicuri quanto la Sua casella di posta. Ecco come passare il Suo conto Tradovate a un’app di password monouso basate sul tempo (TOTP) e come impostare un backup, così che un telefono perso o ripristinato non La escluda mai dall’account." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Email codes get the job done, but they're slow and they're only as safe as your inbox. An authenticator app fixes both problems. It runs on your phone, generates a fresh six-digit code every 30 seconds, and works even when you have no signal. So when you log in from a new device, you approve it in a couple of taps instead of alt-tabbing to your email and waiting for a message to land." },
    { type: "paragraph", html: "Here's how to switch your Tradovate account over to a time-based one-time password (TOTP) app, and how to set a backup so a lost or wiped phone never locks you out of your own account." },
    { type: "heading", text: "Before You Start" },
    {
      type: "list",
      items: [
        "A phone with an authenticator app installed. Google Authenticator, Microsoft Authenticator, and Authy all follow the same TOTP standard, so pick whichever you already use.",
        "Access to the Tradovate web or desktop platform, logged in on a device you trust.",
        "A second contact method (a phone number for SMS, or a security key) to register as your backup.",
      ],
    },
    { type: "quote", html: "Trading through a prop firm? Some firms manage login and security on the accounts they issue, so the Security page may look different or be locked down. If your options are greyed out, check your firm's current rules before changing anything." },
    { type: "heading", text: "Set Up an Authenticator App for Tradovate 2FA: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Install a TOTP Authenticator App", html: "Grab an authenticator app from the App Store or Google Play if you don't have one yet. Any TOTP app will pair with Tradovate the same way, so there's no wrong choice here. If you already use one for your email or exchange logins, stick with it and keep everything in one place." },
        { title: "Open the Security Page", html: "In the platform, open <strong class='text-white'>Application Settings</strong> and go to the <strong class='text-white'>Security</strong> page. This is the same place you manage your standard 2FA, trusted devices, and any security keys. Scroll down until you see the 2FA toggle near the top of the security options." },
        { title: "Start the Authenticator Setup", html: "Scroll just below the 2FA toggle. Along with Trusted Devices, Security Keys, and SMS, you'll find the option to add an <strong class='text-white'>Authenticator App</strong>. Start its setup and, if prompted, pick your phone's platform so Tradovate shows the right instructions. It'll then generate a QR code for you to scan." },
        { title: "Scan the QR Code", html: "Open your authenticator app, tap to add a new account, and choose the option to scan a QR code. Point your camera at the code on screen. Within a second, a new entry labeled <strong class='text-white'>Tradovate</strong> shows up in your app with a six-digit code that refreshes on a timer. If you can't scan for any reason, most apps also let you type in a setup key manually." },
        { title: "Confirm the Code and Set a Backup", html: "Type the current six-digit code from your app into Tradovate to prove the pairing works, then confirm. You'll also be asked to set a <strong class='text-white'>backup method</strong>. Don't skip this. If you ever lose your phone or reset it, the backup, whether that's a trusted device, a security key, or an SMS number, is how you get back in. Pick one you'll still have access to a year from now." },
      ],
    },
    { type: "heading", text: "What Happens on Your Next New-Device Login" },
    { type: "paragraph", html: "2FA only kicks in when you sign in from a device or browser Tradovate hasn't seen before. When that happens, you'll usually get an email asking you to approve or deny the new device. Approve it, then enter the six-digit code from the Tradovate entry in your authenticator app. On devices you use every day, you can mark them as trusted so you're not typing a code every session." },
    { type: "heading", text: "If Something Goes Wrong" },
    { type: "paragraph", html: "The most common issue is a code that's rejected as invalid, and it's almost always a clock problem. TOTP codes depend on accurate time, so if your phone's clock has drifted, the codes won't match. Turn on automatic date and time on your phone (and in Google Authenticator's settings there's a \"time correction for codes\" option). Beyond that, keep at least two methods live at all times so a single lost device never becomes a lockout." },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Once your login is locked down, put your trading on autopilot too. <strong class='text-white'>PickMyTrade automates Tradovate orders straight from TradingView alerts</strong>, no code required." },
  ], de: [
    { type: "paragraph",html: "E-Mail-Codes erfüllen ihren Zweck, sind aber langsam und nur so sicher wie Ihr Posteingang. Eine Authenticator-App löst beide Probleme. Sie läuft auf Ihrem Smartphone, erzeugt alle 30 Sekunden einen neuen sechsstelligen Code und funktioniert auch ohne Empfang. Wenn Sie sich also von einem neuen Gerät anmelden, bestätigen Sie es mit wenigen Fingertipps, statt zum E-Mail-Postfach zu wechseln und auf eine Nachricht zu warten." },
    { type: "paragraph",html: "So stellen Sie Ihr Tradovate-Konto auf eine App für zeitbasierte Einmalpasswörter (TOTP) um und richten eine Sicherung ein, damit ein verlorenes oder zurückgesetztes Smartphone Sie nie aus Ihrem eigenen Konto aussperrt." },
    { type: "heading",text: "Bevor Sie beginnen" },
    {
      type: "list",
      items: [
        "Ein Smartphone mit installierter Authenticator-App. Google Authenticator, Microsoft Authenticator und Authy folgen alle demselben TOTP-Standard, wählen Sie also die App, die Sie ohnehin nutzen.",
        "Zugang zur Tradovate-Web- oder Desktop-Plattform, angemeldet auf einem Gerät, dem Sie vertrauen.",
        "Eine zweite Kontaktmethode (eine Telefonnummer für SMS oder ein Sicherheitsschlüssel), die Sie als Sicherung registrieren.",
      ],
    },
    { type: "quote",html: "Sie handeln über eine Prop-Firma? Manche Firmen verwalten Login und Sicherheit der von ihnen ausgegebenen Konten selbst, sodass die Seite „Security“ anders aussehen oder gesperrt sein kann. Wenn Ihre Optionen ausgegraut sind, prüfen Sie die aktuellen Regeln Ihrer Firma, bevor Sie etwas ändern." },
    { type: "heading",text: "Authenticator-App für die Tradovate-2FA einrichten: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "TOTP-Authenticator-App installieren", html: "Laden Sie eine Authenticator-App aus dem App Store oder von Google Play herunter, falls Sie noch keine haben. Jede TOTP-App lässt sich auf dieselbe Weise mit Tradovate koppeln, Sie können also nichts falsch machen. Wenn Sie bereits eine für Ihre E-Mail- oder Börsen-Logins verwenden, bleiben Sie dabei und halten Sie alles an einem Ort." },
        { title: "Die Seite „Security“ öffnen", html: "Öffnen Sie in der Plattform die <strong class='text-white'>Application Settings</strong> und gehen Sie zur Seite <strong class='text-white'>Security</strong>. Hier verwalten Sie auch Ihre Standard-2FA, vertrauenswürdige Geräte und etwaige Sicherheitsschlüssel. Scrollen Sie nach unten, bis Sie oben in den Sicherheitsoptionen den 2FA-Schalter sehen." },
        { title: "Die Authenticator-Einrichtung starten", html: "Scrollen Sie knapp unter den 2FA-Schalter. Neben Trusted Devices, Security Keys und SMS finden Sie die Option zum Hinzufügen einer <strong class='text-white'>Authenticator App</strong>. Starten Sie die Einrichtung und wählen Sie bei Aufforderung die Plattform Ihres Smartphones, damit Tradovate die passende Anleitung anzeigt. Anschließend wird ein QR-Code zum Scannen erzeugt." },
        { title: "QR-Code scannen", html: "Öffnen Sie Ihre Authenticator-App, tippen Sie auf „Neues Konto hinzufügen“ und wählen Sie das Scannen eines QR-Codes. Richten Sie die Kamera auf den Code auf dem Bildschirm. Innerhalb einer Sekunde erscheint in Ihrer App ein neuer Eintrag mit der Bezeichnung <strong class='text-white'>Tradovate</strong> samt sechsstelligem Code, der sich zeitgesteuert erneuert. Falls das Scannen nicht klappt, lässt sich bei den meisten Apps auch ein Einrichtungsschlüssel manuell eingeben." },
        { title: "Code bestätigen und Sicherung festlegen", html: "Geben Sie den aktuellen sechsstelligen Code aus Ihrer App in Tradovate ein, um zu belegen, dass die Kopplung funktioniert, und bestätigen Sie. Außerdem werden Sie aufgefordert, eine <strong class='text-white'>Sicherungsmethode</strong> festzulegen. Überspringen Sie das nicht. Wenn Sie Ihr Smartphone verlieren oder zurücksetzen, ist die Sicherung, ob vertrauenswürdiges Gerät, Sicherheitsschlüssel oder SMS-Nummer, Ihr Weg zurück ins Konto. Wählen Sie eine Methode, auf die Sie auch in einem Jahr noch Zugriff haben." },
      ],
    },
    { type: "heading",text: "Was bei Ihrer nächsten Anmeldung mit einem neuen Gerät passiert" },
    { type: "paragraph",html: "Die 2FA greift nur, wenn Sie sich von einem Gerät oder Browser anmelden, den Tradovate noch nicht kennt. In diesem Fall erhalten Sie in der Regel eine E-Mail, in der Sie das neue Gerät genehmigen oder ablehnen können. Genehmigen Sie es und geben Sie dann den sechsstelligen Code aus dem Tradovate-Eintrag in Ihrer Authenticator-App ein. Geräte, die Sie täglich nutzen, können Sie als vertrauenswürdig markieren, damit Sie nicht in jeder Sitzung einen Code eintippen müssen." },
    { type: "heading",text: "Wenn etwas schiefgeht" },
    { type: "paragraph",html: "Das häufigste Problem ist ein Code, der als ungültig abgelehnt wird, und fast immer liegt es an der Uhrzeit. TOTP-Codes setzen eine genaue Zeit voraus; ist die Uhr Ihres Smartphones abgewichen, stimmen die Codes nicht überein. Aktivieren Sie auf Ihrem Smartphone die automatische Datums- und Zeiteinstellung (in den Einstellungen von Google Authenticator gibt es außerdem die Option „Zeitkorrektur für Codes“). Halten Sie darüber hinaus immer mindestens zwei Methoden aktiv, damit ein einzelnes verlorenes Gerät nie zur Aussperrung wird." },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "Sobald Ihr Login abgesichert ist, bringen Sie auch Ihren Handel auf Autopilot. <strong class='text-white'>PickMyTrade automatisiert Tradovate-Orders direkt aus TradingView-Alerts</strong>, ganz ohne Code." },
  ], es: [
    { type: "paragraph",html: "Los códigos por correo cumplen su función, pero son lentos y solo tan seguros como su bandeja de entrada. Una app de autenticación resuelve ambos problemas. Funciona en su teléfono, genera un código nuevo de seis dígitos cada 30 segundos y funciona incluso sin cobertura. Así, cuando inicie sesión desde un dispositivo nuevo, lo aprueba con un par de toques en lugar de cambiar a su correo y esperar a que llegue un mensaje." },
    { type: "paragraph",html: "Así puede pasar su cuenta de Tradovate a una app de contraseñas de un solo uso basadas en tiempo (TOTP) y configurar un respaldo para que un teléfono perdido o restablecido nunca le deje fuera de su propia cuenta." },
    { type: "heading",text: "Antes de empezar" },
    {
      type: "list",
      items: [
        "Un teléfono con una app de autenticación instalada. Google Authenticator, Microsoft Authenticator y Authy siguen el mismo estándar TOTP, así que elija la que ya utilice.",
        "Acceso a la plataforma web o de escritorio de Tradovate, con la sesión iniciada en un dispositivo de confianza.",
        "Un segundo método de contacto (un número de teléfono para SMS o una llave de seguridad) para registrarlo como respaldo.",
      ],
    },
    { type: "quote",html: "¿Opera a través de una prop firm? Algunas firmas gestionan el inicio de sesión y la seguridad de las cuentas que emiten, por lo que la página Security puede verse distinta o estar bloqueada. Si sus opciones aparecen en gris, consulte las reglas vigentes de su firma antes de cambiar nada." },
    { type: "heading",text: "Configure una app de autenticación para la 2FA de Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Instale una app de autenticación TOTP", html: "Descargue una app de autenticación desde App Store o Google Play si aún no tiene una. Cualquier app TOTP se vincula con Tradovate de la misma manera, así que no hay una elección incorrecta. Si ya usa una para su correo o para los accesos a bolsas, quédese con ella y mantenga todo en un solo lugar." },
        { title: "Abra la página Security", html: "En la plataforma, abra <strong class='text-white'>Application Settings</strong> y vaya a la página <strong class='text-white'>Security</strong>. Es el mismo lugar donde gestiona su 2FA estándar, los dispositivos de confianza y las llaves de seguridad. Desplácese hacia abajo hasta ver el interruptor de 2FA en la parte superior de las opciones de seguridad." },
        { title: "Inicie la configuración del autenticador", html: "Desplácese justo debajo del interruptor de 2FA. Junto a Trusted Devices, Security Keys y SMS, encontrará la opción para añadir una <strong class='text-white'>Authenticator App</strong>. Inicie su configuración y, si se le solicita, elija la plataforma de su teléfono para que Tradovate muestre las instrucciones correctas. A continuación generará un código QR para escanear." },
        { title: "Escanee el código QR", html: "Abra su app de autenticación, toque para añadir una cuenta nueva y elija la opción de escanear un código QR. Apunte la cámara al código en pantalla. En un segundo aparecerá en su app una nueva entrada llamada <strong class='text-white'>Tradovate</strong> con un código de seis dígitos que se renueva con un temporizador. Si por algún motivo no puede escanear, la mayoría de las apps también permiten escribir manualmente una clave de configuración." },
        { title: "Confirme el código y configure un respaldo", html: "Escriba en Tradovate el código actual de seis dígitos de su app para comprobar que la vinculación funciona y confirme. También se le pedirá configurar un <strong class='text-white'>método de respaldo</strong>. No lo omita. Si alguna vez pierde su teléfono o lo restablece, el respaldo, ya sea un dispositivo de confianza, una llave de seguridad o un número de SMS, es la forma de volver a entrar. Elija uno al que seguirá teniendo acceso dentro de un año." },
      ],
    },
    { type: "heading",text: "Qué ocurre en su próximo inicio de sesión desde un dispositivo nuevo" },
    { type: "paragraph",html: "La 2FA solo se activa cuando inicia sesión desde un dispositivo o navegador que Tradovate no ha visto antes. Cuando eso sucede, normalmente recibirá un correo para aprobar o rechazar el dispositivo nuevo. Apruébelo e introduzca después el código de seis dígitos de la entrada de Tradovate en su app de autenticación. En los dispositivos que usa a diario puede marcarlos como de confianza para no tener que escribir un código en cada sesión." },
    { type: "heading",text: "Si algo sale mal" },
    { type: "paragraph",html: "El problema más habitual es un código rechazado por no ser válido, y casi siempre se debe al reloj. Los códigos TOTP dependen de la hora exacta, por lo que si el reloj de su teléfono se ha desajustado, los códigos no coincidirán. Active la fecha y hora automáticas en su teléfono (y en los ajustes de Google Authenticator hay una opción de «corrección de hora para códigos»). Además, mantenga siempre al menos dos métodos activos para que perder un solo dispositivo nunca se convierta en un bloqueo." },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Una vez protegido su inicio de sesión, ponga también su trading en piloto automático. <strong class='text-white'>PickMyTrade automatiza las órdenes de Tradovate directamente desde alertas de TradingView</strong>, sin necesidad de código." },
  ], fr: [
    { type: "paragraph",html: "Les codes par e-mail font l’affaire, mais ils sont lents et aussi sûrs que votre boîte de réception. Une application d’authentification règle ces deux problèmes. Elle s’exécute sur votre téléphone, génère un nouveau code à six chiffres toutes les 30 secondes et fonctionne même sans réseau. Ainsi, lorsque vous vous connectez depuis un nouvel appareil, vous l’approuvez en quelques pressions au lieu de basculer vers votre messagerie et d’attendre l’arrivée d’un message." },
    { type: "paragraph",html: "Voici comment faire passer votre compte Tradovate à une application de mots de passe à usage unique basés sur le temps (TOTP) et comment définir une solution de secours pour qu’un téléphone perdu ou réinitialisé ne vous bloque jamais l’accès à votre propre compte." },
    { type: "heading",text: "Avant de commencer" },
    {
      type: "list",
      items: [
        "Un téléphone avec une application d’authentification installée. Google Authenticator, Microsoft Authenticator et Authy suivent tous la même norme TOTP ; choisissez donc celle que vous utilisez déjà.",
        "Un accès à la plateforme web ou de bureau Tradovate, connecté depuis un appareil de confiance.",
        "Une seconde méthode de contact (un numéro de téléphone pour les SMS ou une clé de sécurité) à enregistrer comme solution de secours.",
      ],
    },
    { type: "quote",html: "Vous tradez via une prop firm ? Certaines firmes gèrent la connexion et la sécurité des comptes qu’elles émettent ; la page Security peut donc sembler différente ou verrouillée. Si vos options sont grisées, vérifiez les règles en vigueur de votre firme avant de modifier quoi que ce soit." },
    { type: "heading",text: "Configurer une application d’authentification pour la 2FA de Tradovate : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Installer une application d’authentification TOTP", html: "Téléchargez une application d’authentification depuis l’App Store ou Google Play si vous n’en avez pas encore. N’importe quelle application TOTP s’associe à Tradovate de la même manière, il n’y a donc pas de mauvais choix. Si vous en utilisez déjà une pour votre messagerie ou vos connexions aux bourses, gardez-la et conservez tout au même endroit." },
        { title: "Ouvrir la page Security", html: "Dans la plateforme, ouvrez <strong class='text-white'>Application Settings</strong> et rendez-vous sur la page <strong class='text-white'>Security</strong>. C’est le même endroit où vous gérez votre 2FA standard, vos appareils de confiance et vos éventuelles clés de sécurité. Faites défiler jusqu’à voir l’interrupteur 2FA en haut des options de sécurité." },
        { title: "Lancer la configuration de l’authentificateur", html: "Faites défiler juste en dessous de l’interrupteur 2FA. Avec Trusted Devices, Security Keys et SMS, vous trouverez l’option permettant d’ajouter une <strong class='text-white'>Authenticator App</strong>. Lancez sa configuration et, si on vous le demande, choisissez la plateforme de votre téléphone pour que Tradovate affiche les bonnes instructions. Un code QR à scanner sera alors généré." },
        { title: "Scanner le code QR", html: "Ouvrez votre application d’authentification, appuyez pour ajouter un nouveau compte et choisissez l’option de scan d’un code QR. Dirigez l’appareil photo vers le code affiché à l’écran. En une seconde, une nouvelle entrée intitulée <strong class='text-white'>Tradovate</strong> apparaît dans votre application, avec un code à six chiffres qui se renouvelle selon un minuteur. Si vous ne pouvez pas scanner pour une raison quelconque, la plupart des applications permettent aussi de saisir manuellement une clé de configuration." },
        { title: "Confirmer le code et définir une solution de secours", html: "Saisissez dans Tradovate le code à six chiffres actuel de votre application pour prouver que l’association fonctionne, puis confirmez. On vous demandera aussi de définir une <strong class='text-white'>méthode de secours</strong>. Ne l’ignorez pas. Si vous perdez un jour votre téléphone ou le réinitialisez, la solution de secours, qu’il s’agisse d’un appareil de confiance, d’une clé de sécurité ou d’un numéro SMS, est votre moyen de rentrer. Choisissez-en une à laquelle vous aurez encore accès dans un an." },
      ],
    },
    { type: "heading",text: "Ce qui se passe lors de votre prochaine connexion depuis un nouvel appareil" },
    { type: "paragraph",html: "La 2FA ne se déclenche que lorsque vous vous connectez depuis un appareil ou un navigateur que Tradovate n’a jamais vu. Dans ce cas, vous recevez généralement un e-mail vous demandant d’approuver ou de refuser le nouvel appareil. Approuvez-le, puis saisissez le code à six chiffres de l’entrée Tradovate dans votre application d’authentification. Sur les appareils que vous utilisez chaque jour, vous pouvez les marquer comme de confiance pour ne pas avoir à taper un code à chaque session." },
    { type: "heading",text: "En cas de problème" },
    { type: "paragraph",html: "Le problème le plus courant est un code rejeté comme invalide, et c’est presque toujours une question d’horloge. Les codes TOTP dépendent d’une heure exacte ; si l’horloge de votre téléphone a dérivé, les codes ne correspondront pas. Activez la date et l’heure automatiques sur votre téléphone (et dans les paramètres de Google Authenticator, une option « correction de l’heure pour les codes » existe). Par ailleurs, gardez en permanence au moins deux méthodes actives pour qu’un seul appareil perdu ne devienne jamais un blocage." },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Une fois votre connexion sécurisée, mettez aussi votre trading en pilote automatique. <strong class='text-white'>PickMyTrade automatise les ordres Tradovate directement à partir des alertes TradingView</strong>, sans aucun code." },
  ], it: [
    { type: "paragraph",html: "I codici via e-mail funzionano, ma sono lenti e sicuri solo quanto la Sua casella di posta. Un’app di autenticazione risolve entrambi i problemi. Funziona sul Suo telefono, genera un nuovo codice a sei cifre ogni 30 secondi e va anche senza segnale. Così, quando accede da un nuovo dispositivo, lo approva con un paio di tocchi invece di passare alla posta e attendere l’arrivo di un messaggio." },
    { type: "paragraph",html: "Ecco come passare il Suo conto Tradovate a un’app di password monouso basate sul tempo (TOTP) e come impostare un backup, così che un telefono perso o ripristinato non La escluda mai dal Suo stesso account." },
    { type: "heading",text: "Prima di iniziare" },
    {
      type: "list",
      items: [
        "Un telefono con un’app di autenticazione installata. Google Authenticator, Microsoft Authenticator e Authy seguono tutti lo stesso standard TOTP, quindi scelga quella che già utilizza.",
