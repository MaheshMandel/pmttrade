---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-ira-account";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Open a Tradovate Futures IRA Account";
const META_DESCRIPTION =
  "Open and fund a futures IRA through the Equity Trust custodian, step by step, and trade futures inside a tax-advantaged retirement account.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Ein Tradovate-Futures-IRA-Konto eröffnen", es: "Abra una cuenta IRA de futuros en Tradovate", fr: "Ouvrir un compte IRA de contrats à terme Tradovate", it: "Aprire un conto IRA futures Tradovate" },
  dek: { en: "Trading futures inside a retirement account has a few more moving parts than a regular account. Here's how Tradovate handles it through the Equity Trust custodian, step by step.", de: "Der Futures-Handel in einem Altersvorsorgekonto hat ein paar bewegliche Teile mehr als bei einem normalen Konto. So läuft es bei Tradovate über den Verwahrer Equity Trust, Schritt für Schritt.", es: "Operar con futuros dentro de una cuenta de jubilación tiene algunas piezas más que una cuenta normal. Así lo gestiona Tradovate a través del custodio Equity Trust, paso a paso.", fr: "Négocier des contrats à terme dans un compte retraite comporte quelques rouages de plus qu'un compte classique. Voici comment Tradovate procède via le dépositaire Equity Trust, étape par étape.", it: "Fare trading di futures all'interno di un conto pensionistico comporta qualche passaggio in più rispetto a un conto normale. Ecco come Tradovate lo gestisce tramite il custode Equity Trust, passo dopo passo." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-10",
  blocks: { en: [
    { type: "paragraph", html: "Trading futures inside a retirement account sounds complicated, and the setup does have a few more moving parts than a regular account. The reason is simple: your IRA can't just live inside a normal brokerage login. It needs a custodian to legally hold the money and keep it inside IRS rules. Tradovate handles that through Equity Trust, a custodian that specializes in futures and forex IRAs. Once you know who does what, the process is straightforward. Here's how to open one and fund it." },
    { type: "heading", text: "What Is a Tradovate Futures IRA?" },
    { type: "paragraph", html: "A Tradovate futures IRA is a self-directed retirement account that lets you trade futures with tax-advantaged money. Equity Trust Company acts as the custodian: it holds the funds, keeps the records, and makes sure the account stays inside IRS guidelines while you place trades on the Tradovate platform. Your personal cash and your IRA cash never mix, and every dollar in or out moves through Equity Trust rather than straight into the trading platform. Because you're putting retirement money into a leveraged product, treat position sizing conservatively." },
    { type: "heading", text: "How to Open a Tradovate Futures IRA: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open and Fund a Self-Directed IRA with Equity Trust", html: "Start with the custodian. Open a self-directed IRA with Equity Trust Company, since the trading account has to be set up with them involved. You can fund that IRA three ways: a direct contribution, a transfer from an existing IRA, or a rollover from an old 401(k). Equity Trust ties a Trust Tax ID to the account rather than your Social Security number, which is what keeps it a genuine retirement account in the eyes of the IRS. Get this piece moving first, because transfers and rollovers can take a while to clear." },
        { title: "Start a Separate Tradovate Live Account Application", html: "Even if you already trade on Tradovate, you can't reuse your existing login for the IRA. You have to complete a brand-new live account application specifically for the retirement account. IRA money and personal money can't share an account, so Tradovate treats this as a fresh application from the ground up. Open the account application from Tradovate's site and begin a new live account." },
        { title: "Choose IRA as the Account Type and Enter Equity Trust as the Custodian", html: "This is the step that turns a normal application into a retirement account. On the application, set the <strong class='text-white'>Account Type</strong> to <strong class='text-white'>IRA</strong>. When the form asks for your <strong class='text-white'>Account Custodian</strong>, enter <strong class='text-white'>Equity Trust</strong>. That tells Tradovate to title the account correctly and route it through the custodian instead of treating it as a personal account. Get this field right, or the account won't be established as an IRA." },
        { title: "Fund the Trading Account Through Equity Trust", html: "Money never goes straight from your bank into the Tradovate IRA. It flows through Equity Trust. The trading account gets titled something like \"Equity Trust Company Custodian FBO [Your Name] [Equity Trust Account Number],\" which is the paper trail that keeps it compliant. Any time you add or pull funds later, you route it through your Equity Trust account, not the platform. One practical rule worth remembering: keep enough liquid cash in the IRA to cover margin. If the account comes up short, you can't top it off with personal money the way you would in a standard account." },
      ],
    },
    { type: "heading", text: "Why You'd Need This" },
    {
      type: "list",
      items: [
        "Trading futures with tax-advantaged retirement money instead of a taxable account",
        "Rolling an old 401(k) into an account you can actively trade",
        "Keeping retirement funds legally separate and IRS-compliant through a custodian",
        "Diversifying a retirement portfolio beyond stocks and mutual funds",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Once your Tradovate IRA is live and funded, PickMyTrade connects your TradingView alerts straight to it, so entries, exits and bracket orders fire automatically inside the retirement account with no manual clicking during the session." },
  ], de: [
    { type: "paragraph",html: "Futures in einem Altersvorsorgekonto zu handeln klingt kompliziert, und die Einrichtung hat tatsächlich ein paar bewegliche Teile mehr als bei einem normalen Konto. Der Grund ist einfach: Ihr IRA kann nicht einfach in einem gewöhnlichen Brokerage-Login liegen. Es braucht einen Verwahrer, der das Geld rechtlich hält und die IRS-Regeln einhält. Tradovate wickelt das über Equity Trust ab, einen Verwahrer, der auf Futures- und Forex-IRAs spezialisiert ist. Sobald Sie wissen, wer was erledigt, ist der Prozess unkompliziert. So eröffnen und finanzieren Sie eines." },
    { type: "heading",text: "Was ist ein Tradovate-Futures-IRA?" },
    { type: "paragraph",html: "Ein Tradovate-Futures-IRA ist ein selbstverwaltetes Altersvorsorgekonto, mit dem Sie Futures mit steuerbegünstigtem Geld handeln können. Die Equity Trust Company fungiert als Verwahrer: Sie hält die Gelder, führt die Unterlagen und stellt sicher, dass das Konto den IRS-Richtlinien entspricht, während Sie Trades auf der Tradovate-Plattform platzieren. Ihr privates Bargeld und Ihr IRA-Bargeld vermischen sich nie, und jeder Dollar, der hinein- oder herausfließt, läuft über Equity Trust und nicht direkt in die Handelsplattform. Da Sie Altersvorsorgegeld in ein gehebeltes Produkt investieren, sollten Sie die Positionsgrößen konservativ wählen." },
    { type: "heading",text: "So eröffnen Sie ein Tradovate-Futures-IRA: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Ein selbstverwaltetes IRA bei Equity Trust eröffnen und finanzieren", html: "Beginnen Sie beim Verwahrer. Eröffnen Sie ein selbstverwaltetes IRA bei der Equity Trust Company, da das Handelskonto unter deren Beteiligung eingerichtet werden muss. Sie können dieses IRA auf drei Wegen finanzieren: durch eine direkte Einzahlung, eine Übertragung von einem bestehenden IRA oder einen Rollover aus einem alten 401(k). Equity Trust verknüpft das Konto mit einer Trust-Steuernummer statt mit Ihrer Sozialversicherungsnummer, wodurch es aus Sicht des IRS ein echtes Altersvorsorgekonto bleibt. Bringen Sie diesen Teil zuerst ins Rollen, denn Übertragungen und Rollovers können eine Weile dauern." },
        { title: "Einen separaten Tradovate-Live-Konto-Antrag starten", html: "Selbst wenn Sie bereits bei Tradovate handeln, können Sie Ihren bestehenden Zugang nicht für das IRA wiederverwenden. Sie müssen einen völlig neuen Live-Konto-Antrag speziell für das Altersvorsorgekonto ausfüllen. IRA-Gelder und private Gelder dürfen sich kein Konto teilen, daher behandelt Tradovate dies als Neuantrag von Grund auf. Öffnen Sie den Kontoantrag über die Website von Tradovate und beginnen Sie ein neues Live-Konto." },
        { title: "IRA als Kontotyp wählen und Equity Trust als Verwahrer eintragen", html: "Dieser Schritt macht aus einem normalen Antrag ein Altersvorsorgekonto. Setzen Sie im Antrag den <strong class='text-white'>Account Type</strong> auf <strong class='text-white'>IRA</strong>. Wenn das Formular nach Ihrem <strong class='text-white'>Account Custodian</strong> fragt, tragen Sie <strong class='text-white'>Equity Trust</strong> ein. Damit weiß Tradovate, dass das Konto korrekt betitelt und über den Verwahrer geführt werden muss, statt es als privates Konto zu behandeln. Füllen Sie dieses Feld korrekt aus, sonst wird das Konto nicht als IRA eingerichtet." },
        { title: "Das Handelskonto über Equity Trust finanzieren", html: "Geld fließt nie direkt von Ihrer Bank in das Tradovate-IRA. Es läuft über Equity Trust. Das Handelskonto wird etwa mit „Equity Trust Company Custodian FBO [Your Name] [Equity Trust Account Number]“ betitelt, was die Dokumentation darstellt, die es regelkonform hält. Wann immer Sie später Gelder einzahlen oder abheben, leiten Sie dies über Ihr Equity-Trust-Konto und nicht über die Plattform. Eine praktische Regel, die Sie sich merken sollten: Halten Sie im IRA genügend liquide Mittel zur Deckung der Margin vor. Reicht das Konto nicht aus, können Sie es nicht wie bei einem Standardkonto mit privatem Geld auffüllen." },
      ],
    },
    { type: "heading",text: "Wofür Sie dies benötigen" },
    {
      type: "list",
      items: [
        "Futures mit steuerbegünstigtem Altersvorsorgegeld statt über ein steuerpflichtiges Konto handeln",
        "Ein altes 401(k) in ein Konto überführen, das Sie aktiv handeln können",
        "Altersvorsorgegelder über einen Verwahrer rechtlich getrennt und IRS-konform halten",
        "Ein Altersvorsorgeportfolio über Aktien und Investmentfonds hinaus diversifizieren",
      ],
    },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "Sobald Ihr Tradovate-IRA aktiv und finanziert ist, verbindet PickMyTrade Ihre TradingView-Alarme direkt damit, sodass Einstiege, Ausstiege und Bracket-Orders automatisch im Altersvorsorgekonto ausgelöst werden, ohne manuelles Klicken während der Handelssitzung." },
  ], es: [
    { type: "paragraph",html: "Operar con futuros dentro de una cuenta de jubilación suena complicado, y la configuración sí tiene algunas piezas más que una cuenta normal. La razón es sencilla: su IRA no puede vivir simplemente dentro de un acceso de bróker corriente. Necesita un custodio que mantenga legalmente el dinero y lo mantenga dentro de las normas del IRS. Tradovate lo gestiona a través de Equity Trust, un custodio especializado en IRA de futuros y forex. Una vez que sabe quién hace qué, el proceso es directo. Así se abre y se fondea una." },
    { type: "heading",text: "¿Qué es una IRA de futuros de Tradovate?" },
    { type: "paragraph",html: "Una IRA de futuros de Tradovate es una cuenta de jubilación autodirigida que le permite operar con futuros utilizando dinero con ventajas fiscales. Equity Trust Company actúa como custodio: mantiene los fondos, lleva los registros y se asegura de que la cuenta cumpla las directrices del IRS mientras usted realiza operaciones en la plataforma de Tradovate. Su efectivo personal y el de su IRA nunca se mezclan, y cada dólar que entra o sale pasa por Equity Trust en lugar de ir directamente a la plataforma de trading. Como está invirtiendo dinero de jubilación en un producto apalancado, dimensione sus posiciones de forma conservadora." },
    { type: "heading",text: "Cómo abrir una IRA de futuros en Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra y fondee una IRA autodirigida con Equity Trust", html: "Empiece por el custodio. Abra una IRA autodirigida con Equity Trust Company, ya que la cuenta de trading debe configurarse con su participación. Puede fondear esa IRA de tres maneras: una aportación directa, una transferencia desde una IRA existente o un traspaso desde un antiguo 401(k). Equity Trust asocia un Trust Tax ID a la cuenta en lugar de su número de Seguridad Social, lo que la mantiene como una cuenta de jubilación genuina a ojos del IRS. Ponga en marcha esta parte primero, porque las transferencias y los traspasos pueden tardar en completarse." },
        { title: "Inicie una solicitud de cuenta real de Tradovate independiente", html: "Aunque ya opere en Tradovate, no puede reutilizar su acceso actual para la IRA. Debe completar una solicitud de cuenta real completamente nueva específicamente para la cuenta de jubilación. El dinero de la IRA y el personal no pueden compartir cuenta, por lo que Tradovate lo trata como una solicitud nueva desde cero. Abra la solicitud de cuenta desde el sitio de Tradovate y comience una nueva cuenta real." },
        { title: "Elija IRA como tipo de cuenta e introduzca Equity Trust como custodio", html: "Este es el paso que convierte una solicitud normal en una cuenta de jubilación. En la solicitud, establezca el <strong class='text-white'>Account Type</strong> en <strong class='text-white'>IRA</strong>. Cuando el formulario le pida su <strong class='text-white'>Account Custodian</strong>, introduzca <strong class='text-white'>Equity Trust</strong>. Eso indica a Tradovate que debe titular la cuenta correctamente y canalizarla a través del custodio en lugar de tratarla como una cuenta personal. Complete bien este campo, o la cuenta no se establecerá como IRA." },
        { title: "Fondee la cuenta de trading a través de Equity Trust", html: "El dinero nunca va directamente de su banco a la IRA de Tradovate. Fluye a través de Equity Trust. La cuenta de trading se titula con algo parecido a «Equity Trust Company Custodian FBO [Your Name] [Equity Trust Account Number]», que es el rastro documental que la mantiene en cumplimiento. Siempre que añada o retire fondos más adelante, hágalo a través de su cuenta de Equity Trust, no de la plataforma. Una regla práctica que conviene recordar: mantenga suficiente efectivo líquido en la IRA para cubrir el margen. Si la cuenta se queda corta, no puede completarla con dinero personal como haría en una cuenta estándar." },
      ],
    },
    { type: "heading",text: "Por qué la necesitaría" },
    {
      type: "list",
      items: [
        "Operar con futuros con dinero de jubilación con ventajas fiscales en lugar de en una cuenta sujeta a impuestos",
        "Traspasar un antiguo 401(k) a una cuenta con la que pueda operar activamente",
        "Mantener los fondos de jubilación legalmente separados y conformes con el IRS mediante un custodio",
        "Diversificar una cartera de jubilación más allá de acciones y fondos de inversión",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Una vez que su IRA de Tradovate esté activa y fondeada, PickMyTrade conecta sus alertas de TradingView directamente con ella, de modo que las entradas, salidas y órdenes bracket se ejecutan automáticamente dentro de la cuenta de jubilación, sin clics manuales durante la sesión." },
  ], fr: [
    { type: "paragraph",html: "Négocier des contrats à terme dans un compte retraite semble compliqué, et la mise en place comporte effectivement quelques rouages de plus qu'un compte classique. La raison est simple : votre IRA ne peut pas simplement se trouver derrière un identifiant de courtage ordinaire. Il lui faut un dépositaire qui détient légalement les fonds et les maintient dans le cadre des règles de l'IRS. Tradovate s'en charge via Equity Trust, un dépositaire spécialisé dans les IRA de contrats à terme et de forex. Une fois que vous savez qui fait quoi, la démarche est simple. Voici comment en ouvrir un et l'approvisionner." },
    { type: "heading",text: "Qu'est-ce qu'un IRA de contrats à terme Tradovate ?" },
    { type: "paragraph",html: "Un IRA de contrats à terme Tradovate est un compte retraite autogéré qui vous permet de négocier des contrats à terme avec de l'argent à fiscalité avantageuse. Equity Trust Company agit comme dépositaire : elle détient les fonds, tient les registres et veille à ce que le compte reste conforme aux directives de l'IRS pendant que vous passez vos ordres sur la plateforme Tradovate. Vos liquidités personnelles et celles de votre IRA ne se mélangent jamais, et chaque dollar entrant ou sortant transite par Equity Trust plutôt que directement vers la plateforme de trading. Comme vous placez de l'argent de retraite dans un produit à effet de levier, dimensionnez vos positions avec prudence." },
    { type: "heading",text: "Comment ouvrir un IRA de contrats à terme Tradovate : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir et approvisionner un IRA autogéré auprès d'Equity Trust", html: "Commencez par le dépositaire. Ouvrez un IRA autogéré auprès d'Equity Trust Company, car le compte de trading doit être configuré avec son intervention. Vous pouvez approvisionner cet IRA de trois façons : un versement direct, un transfert depuis un IRA existant ou un transfert d'un ancien 401(k). Equity Trust associe un Trust Tax ID au compte plutôt que votre numéro de sécurité sociale, ce qui en fait un véritable compte retraite aux yeux de l'IRS. Lancez cette étape en premier, car les transferts peuvent prendre du temps à aboutir." },
        { title: "Lancer une demande de compte réel Tradovate distincte", html: "Même si vous négociez déjà sur Tradovate, vous ne pouvez pas réutiliser votre identifiant existant pour l'IRA. Vous devez remplir une toute nouvelle demande de compte réel spécifiquement pour le compte retraite. L'argent de l'IRA et l'argent personnel ne peuvent pas partager un compte ; Tradovate traite donc cela comme une nouvelle demande à part entière. Ouvrez la demande de compte depuis le site de Tradovate et commencez un nouveau compte réel." },
        { title: "Choisir IRA comme type de compte et saisir Equity Trust comme dépositaire", html: "C'est l'étape qui transforme une demande ordinaire en compte retraite. Dans la demande, réglez l'<strong class='text-white'>Account Type</strong> sur <strong class='text-white'>IRA</strong>. Lorsque le formulaire vous demande votre <strong class='text-white'>Account Custodian</strong>, saisissez <strong class='text-white'>Equity Trust</strong>. Cela indique à Tradovate d'intituler correctement le compte et de le faire transiter par le dépositaire au lieu de le traiter comme un compte personnel. Renseignez ce champ correctement, sinon le compte ne sera pas établi comme un IRA." },
        { title: "Approvisionner le compte de trading via Equity Trust", html: "L'argent ne va jamais directement de votre banque vers l'IRA Tradovate. Il transite par Equity Trust. Le compte de trading est intitulé de la forme « Equity Trust Company Custodian FBO [Your Name] [Equity Trust Account Number] », ce qui constitue la trace documentaire qui garantit sa conformité. Chaque fois que vous ajoutez ou retirez des fonds par la suite, passez par votre compte Equity Trust et non par la plateforme. Une règle pratique à retenir : conservez suffisamment de liquidités dans l'IRA pour couvrir la marge. Si le compte est à court, vous ne pouvez pas le réapprovisionner avec de l'argent personnel comme sur un compte standard." },
      ],
    },
    { type: "heading",text: "Pourquoi en auriez-vous besoin" },
    {
      type: "list",
      items: [
        "Négocier des contrats à terme avec de l'argent de retraite à fiscalité avantageuse plutôt que sur un compte imposable",
        "Transférer un ancien 401(k) vers un compte que vous pouvez négocier activement",
        "Maintenir les fonds de retraite légalement séparés et conformes à l'IRS grâce à un dépositaire",
        "Diversifier un portefeuille de retraite au-delà des actions et des fonds communs de placement",
      ],
    },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Une fois votre IRA Tradovate actif et approvisionné, PickMyTrade y relie directement vos alertes TradingView, de sorte que les entrées, les sorties et les ordres bracket se déclenchent automatiquement dans le compte retraite, sans clic manuel pendant la séance." },
  ], it: [
    { type: "paragraph",html: "Fare trading di futures all'interno di un conto pensionistico sembra complicato, e la configurazione ha davvero qualche passaggio in più rispetto a un conto normale. Il motivo è semplice: il suo IRA non può semplicemente trovarsi dentro un normale accesso a un broker. Serve un custode che detenga legalmente il denaro e lo mantenga entro le regole dell'IRS. Tradovate se ne occupa tramite Equity Trust, un custode specializzato in IRA per futures e forex. Una volta chiaro chi fa cosa, il processo è semplice. Ecco come aprirne uno e finanziarlo." },
    { type: "heading",text: "Che cos'è un IRA futures Tradovate?" },
    { type: "paragraph",html: "Un IRA futures Tradovate è un conto pensionistico autogestito che le consente di fare trading di futures con denaro a tassazione agevolata. Equity Trust Company agisce come custode: detiene i fondi, tiene i registri e garantisce che il conto resti entro le linee guida dell'IRS mentre lei piazza operazioni sulla piattaforma Tradovate. Il suo denaro personale e quello dell'IRA non si mescolano mai, e ogni dollaro in entrata o in uscita passa attraverso Equity Trust anziché direttamente nella piattaforma di trading. Poiché sta investendo denaro pensionistico in un prodotto a leva, dimensioni le posizioni in modo prudente." },
    { type: "heading",text: "Come aprire un IRA futures Tradovate: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Aprire e finanziare un IRA autogestito con Equity Trust", html: "Parta dal custode. Apra un IRA autogestito con Equity Trust Company, poiché il conto di trading deve essere impostato con il suo coinvolgimento. Può finanziare quell'IRA in tre modi: un versamento diretto, un trasferimento da un IRA esistente o un rollover da un vecchio 401(k). Equity Trust associa al conto un Trust Tax ID anziché il suo numero di previdenza sociale, ed è questo che lo mantiene un vero conto pensionistico agli occhi dell'IRS. Avvii per prima questa parte, perché trasferimenti e rollover possono richiedere del tempo per essere completati." },
        { title: "Avviare una richiesta di conto reale Tradovate separata", html: "Anche se fa già trading su Tradovate, non può riutilizzare il suo accesso esistente per l'IRA. Deve compilare una richiesta di conto reale completamente nuova, specifica per il conto pensionistico. Il denaro dell'IRA e quello personale non possono condividere un conto, quindi Tradovate la tratta come una richiesta nuova da zero. Apra la richiesta di conto dal sito di Tradovate e avvii un nuovo conto reale." },
        { title: "Scegliere IRA come tipo di conto e inserire Equity Trust come custode", html: "Questo è il passaggio che trasforma una richiesta normale in un conto pensionistico. Nella richiesta, imposti l'<strong class='text-white'>Account Type</strong> su <strong class='text-white'>IRA</strong>. Quando il modulo chiede il suo <strong class='text-white'>Account Custodian</strong>, inserisca <strong class='text-white'>Equity Trust</strong>. Questo indica a Tradovate di intestare correttamente il conto e di instradarlo attraverso il custode anziché trattarlo come un conto personale. Compili correttamente questo campo, altrimenti il conto non verrà costituito come IRA." },
        { title: "Finanziare il conto di trading tramite Equity Trust", html: "Il denaro non va mai direttamente dalla sua banca all'IRA Tradovate. Passa attraverso Equity Trust. Il conto di trading viene intestato in modo simile a \"Equity Trust Company Custodian FBO [Your Name] [Equity Trust Account Number]\", che è la traccia documentale che lo mantiene conforme. Ogni volta che in seguito aggiunge o preleva fondi, lo faccia tramite il suo conto Equity Trust, non dalla piattaforma. Una regola pratica da ricordare: mantenga nell'IRA liquidità sufficiente a coprire il margine. Se il conto risulta scoperto, non può reintegrarlo con denaro personale come farebbe in un conto standard." },
      ],
    },
    { type: "heading",text: "Perché potrebbe servirle" },
    {
      type: "list",
      items: [
        "Fare trading di futures con denaro pensionistico a tassazione agevolata anziché con un conto tassabile",
        "Trasferire un vecchio 401(k) in un conto su cui può operare attivamente",
        "Mantenere i fondi pensionistici legalmente separati e conformi all'IRS tramite un custode",
        "Diversificare un portafoglio pensionistico oltre azioni e fondi comuni",
      ],
    },
    { type: "heading",text: "Automatizzi tutto questo con PickMyTrade" },
