---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-hotkeys";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Enable & Configure Hotkeys in Tradovate";
const META_DESCRIPTION =
  "Tradovate hotkeys let you fire buy, sell, and flatten orders in one keystroke. Learn to enable, assign, and toggle them per module in minutes.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Hotkeys in Tradovate aktivieren und konfigurieren", es: "Cómo activar y configurar las teclas de acceso rápido en Tradovate", fr: "Activer et configurer les raccourcis clavier dans Tradovate", it: "Abilitare e configurare le scorciatoie da tastiera in Tradovate" },
  dek: { en: "Want to fire orders in Tradovate without reaching for your mouse? This guide walks you through turning hotkeys on, mapping keys to actions, and arming them inside each panel, step by step.", de: "Sie möchten Orders in Tradovate auslösen, ohne zur Maus zu greifen? Diese Anleitung zeigt Ihnen Schritt für Schritt, wie Sie Hotkeys einschalten, Tasten Aktionen zuweisen und sie in jedem Panel scharfschalten.", es: "¿Quiere enviar órdenes en Tradovate sin tocar el ratón? Esta guía le explica paso a paso cómo activar las teclas de acceso rápido, asignar teclas a acciones y armarlas dentro de cada panel.", fr: "Vous voulez passer des ordres dans Tradovate sans toucher à la souris ? Ce guide vous explique pas à pas comment activer les raccourcis clavier, associer des touches à des actions et les armer dans chaque panneau.", it: "Vuole inviare ordini in Tradovate senza toccare il mouse? Questa guida le mostra passo dopo passo come attivare le scorciatoie da tastiera, assegnare i tasti alle azioni e armarle all'interno di ogni pannello." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Want to fire a market order, flatten a position, or cancel everything in Tradovate without reaching for your mouse? When ES or NQ is moving, the half-second it takes to find a button is the half-second you lose. This guide walks you through turning hotkeys on, mapping keys to actions, and arming them inside each panel, step by step." },
    { type: "heading", text: "What Are Tradovate Hotkeys?" },
    { type: "paragraph", html: "A Tradovate hotkey maps a single key or key combination to a trading or chart action. Place a market order, flatten a position, cancel every working order, flip a chart to a different timeframe, all in one keystroke instead of clicking around the interface." },
    { type: "paragraph", html: "Here's the part that trips people up: hotkeys live in two places. There's a global on/off switch buried in your settings, and there's a per-module \"H\" toggle that arms hotkeys inside an individual DOM, chart, or order-entry panel. Both have to be on before a shortcut will fire. Keep that in mind and the rest of this is easy." },
    { type: "heading", text: "Enable & Configure Hotkeys in Tradovate: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Enable Hotkeys in Application Settings", html: "Open Application Settings from the gear icon, switch to the Application Preferences tab, and scroll down until you hit the Hotkeys heading. Click the control to turn hotkeys on. That's the master switch. Nothing else you do here matters until it's flipped." },
        { title: "Open the Hotkey Editor", html: "Click the Edit Hotkeys button and the full list of mappable actions opens, grouped into sections like Chart Actions, DOM Actions, and Order Entry. Toggle a section heading and you enable or disable that entire group at once. Expand a section instead and you can see and reconfigure every individual action inside it. Start broad, then drill down to the specific actions you actually trade with." },
        { title: "Assign a Key Combination", html: "Toggle the action you want, click its blank text box, then press your key or combination all at once, not one key after another. Plain keys work, and so do modifiers like Alt, Ctrl, and Alt + Shift, which is how you keep your buy and sell shortcuts from firing by accident. Click anywhere else on the page to save. A green banner confirms it stuck. If the combination collides with something you've already mapped, a message tells you exactly what conflicts so you can pick another." },
        { title: "Arm Hotkeys Inside a Module With the \"H\" Toggle", html: "This is the step most people miss. Plenty of hotkeys are tied to a specific module, and they stay dormant until you arm that module. Click the \"H\" toggle in the top corner of the DOM, chart, or order-entry panel, or the one at the top of the whole module stack, to switch hotkeys on for it. When they're live, a small keyboard icon shows up next to the contract symbol. No keyboard icon, no active hotkeys, check the toggle." },
        { title: "Reset or Remove a Hotkey", html: "Changed your mind about a mapping? Reopen Edit Hotkeys, find the action, and click the Reset button next to its text box to clear or restore it. Do the same for any other binding you want to change, then close the editor. Your layout is worth revisiting every few weeks as your setup evolves." },
      ],
    },
    { type: "heading", text: "Why You'd Need This" },
    {
      type: "list",
      items: [
        "Get in and out of fast-moving futures like ES or NQ without dragging your mouse to a button.",
        "Flatten a position or cancel every working order the instant the market turns on you.",
        "Keep your eyes on price and the order book instead of the toolbar.",
        "Build the same muscle-memory layout across every chart and DOM you trade.",
        "Cut down on fat-finger mistakes by mapping only the actions you really use.",
      ],
    },
    { type: "heading", text: "Automate This With PickMyTrade" },
    { type: "paragraph", html: "Hotkeys make your manual clicks faster, but they still need a hand on the keyboard. If you'd rather your entries, stops, and exits fire on their own, <strong class='text-white'>PickMyTrade wires your TradingView alerts straight to your Tradovate account</strong> so trades execute automatically, no keystroke required." },
  ], de: [
    { type: "paragraph",html: "Sie möchten in Tradovate eine Market-Order auslösen, eine Position glattstellen oder alles stornieren, ohne zur Maus zu greifen? Wenn sich ES oder NQ bewegt, ist die halbe Sekunde, die Sie für das Finden einer Schaltfläche brauchen, die halbe Sekunde, die Sie verlieren. Diese Anleitung zeigt Ihnen Schritt für Schritt, wie Sie Hotkeys einschalten, Tasten Aktionen zuweisen und sie in jedem Panel scharfschalten." },
    { type: "heading",text: "Was sind Tradovate-Hotkeys?" },
    { type: "paragraph",html: "Ein Tradovate-Hotkey ordnet einer einzelnen Taste oder Tastenkombination eine Handels- oder Chartaktion zu. Eine Market-Order platzieren, eine Position glattstellen, jede aktive Order stornieren, einen Chart auf einen anderen Zeitrahmen umschalten, alles mit einem einzigen Tastendruck statt mit Klicks durch die Oberfläche." },
    { type: "paragraph",html: "Hier stolpern viele: Hotkeys befinden sich an zwei Stellen. Es gibt einen globalen Ein-/Aus-Schalter tief in Ihren Einstellungen, und es gibt einen \"H\"-Schalter pro Modul, der Hotkeys in einem einzelnen DOM-, Chart- oder Order-Entry-Panel scharfschaltet. Beide müssen eingeschaltet sein, bevor eine Tastenkombination auslöst. Behalten Sie das im Hinterkopf, dann ist der Rest einfach." },
    { type: "heading",text: "Hotkeys in Tradovate aktivieren und konfigurieren: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Hotkeys in den Anwendungseinstellungen aktivieren", html: "Öffnen Sie über das Zahnradsymbol die Application Settings, wechseln Sie zum Tab Application Preferences und scrollen Sie nach unten, bis Sie die Überschrift Hotkeys erreichen. Klicken Sie auf das Bedienelement, um Hotkeys einzuschalten. Das ist der Hauptschalter. Nichts anderes, was Sie hier tun, spielt eine Rolle, solange er nicht umgelegt ist." },
        { title: "Den Hotkey-Editor öffnen", html: "Klicken Sie auf die Schaltfläche Edit Hotkeys, und die vollständige Liste der zuordenbaren Aktionen öffnet sich, gruppiert in Abschnitte wie Chart Actions, DOM Actions und Order Entry. Wenn Sie eine Abschnittsüberschrift umschalten, aktivieren oder deaktivieren Sie die gesamte Gruppe auf einmal. Wenn Sie stattdessen einen Abschnitt aufklappen, sehen Sie jede einzelne Aktion darin und können sie neu konfigurieren. Beginnen Sie breit und gehen Sie dann zu den konkreten Aktionen über, mit denen Sie tatsächlich handeln." },
        { title: "Eine Tastenkombination zuweisen", html: "Schalten Sie die gewünschte Aktion ein, klicken Sie in ihr leeres Textfeld und drücken Sie dann Ihre Taste oder Kombination gleichzeitig, nicht nacheinander. Einzelne Tasten funktionieren, ebenso Modifikatoren wie Alt, Ctrl und Alt + Shift, womit Sie verhindern, dass Ihre Buy- und Sell-Kürzel versehentlich auslösen. Klicken Sie irgendwo anders auf die Seite, um zu speichern. Ein grünes Banner bestätigt, dass es übernommen wurde. Kollidiert die Kombination mit etwas, das Sie bereits zugeordnet haben, zeigt eine Meldung genau, was in Konflikt steht, sodass Sie eine andere wählen können." },
        { title: "Hotkeys in einem Modul mit dem \"H\"-Schalter scharfschalten", html: "Das ist der Schritt, den die meisten übersehen. Viele Hotkeys sind an ein bestimmtes Modul gebunden und bleiben inaktiv, bis Sie dieses Modul scharfschalten. Klicken Sie auf den \"H\"-Schalter in der oberen Ecke des DOM-, Chart- oder Order-Entry-Panels oder auf den ganz oben im gesamten Modulstapel, um Hotkeys dafür einzuschalten. Sind sie aktiv, erscheint neben dem Kontraktsymbol ein kleines Tastatursymbol. Kein Tastatursymbol, keine aktiven Hotkeys, prüfen Sie den Schalter." },
        { title: "Einen Hotkey zurücksetzen oder entfernen", html: "Haben Sie Ihre Meinung über eine Zuordnung geändert? Öffnen Sie Edit Hotkeys erneut, suchen Sie die Aktion und klicken Sie neben ihrem Textfeld auf die Schaltfläche Reset, um sie zu löschen oder wiederherzustellen. Gehen Sie bei jeder anderen Zuordnung, die Sie ändern möchten, genauso vor, und schließen Sie dann den Editor. Es lohnt sich, Ihr Layout alle paar Wochen zu überprüfen, wenn sich Ihr Setup weiterentwickelt." },
      ],
    },
    { type: "heading",text: "Warum Sie das brauchen" },
    {
      type: "list",
      items: [
        "Steigen Sie in schnelle Futures wie ES oder NQ ein und aus, ohne die Maus zu einer Schaltfläche zu ziehen.",
        "Stellen Sie eine Position glatt oder stornieren Sie jede aktive Order in dem Moment, in dem der Markt gegen Sie dreht.",
        "Behalten Sie Kurs und Orderbuch im Blick statt der Symbolleiste.",
        "Bauen Sie dasselbe Muskelgedächtnis-Layout über alle Charts und DOMs auf, die Sie handeln.",
        "Verringern Sie Vertipper, indem Sie nur die Aktionen zuordnen, die Sie wirklich nutzen.",
      ],
    },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "Hotkeys machen Ihre manuellen Klicks schneller, erfordern aber weiterhin eine Hand auf der Tastatur. Wenn Ihre Einstiege, Stopps und Ausstiege lieber von selbst auslösen sollen, <strong class='text-white'>verbindet PickMyTrade Ihre TradingView-Alerts direkt mit Ihrem Tradovate-Konto</strong>, sodass Trades automatisch ausgeführt werden, ganz ohne Tastendruck." },
  ], es: [
    { type: "paragraph",html: "¿Quiere enviar una orden a mercado, cerrar una posición o cancelarlo todo en Tradovate sin tocar el ratón? Cuando el ES o el NQ se están moviendo, el medio segundo que se tarda en encontrar un botón es el medio segundo que pierde. Esta guía le explica paso a paso cómo activar las teclas de acceso rápido, asignar teclas a acciones y armarlas dentro de cada panel." },
    { type: "heading",text: "¿Qué son las teclas de acceso rápido de Tradovate?" },
    { type: "paragraph",html: "Una tecla de acceso rápido de Tradovate asigna una sola tecla o una combinación de teclas a una acción de trading o de gráfico. Colocar una orden a mercado, cerrar una posición, cancelar todas las órdenes activas, cambiar un gráfico a otra temporalidad, todo con una sola pulsación en lugar de hacer clic por la interfaz." },
    { type: "paragraph",html: "Aquí es donde tropieza mucha gente: las teclas de acceso rápido viven en dos lugares. Hay un interruptor global de activación en sus ajustes, y hay un interruptor \"H\" por módulo que arma las teclas dentro de un DOM, un gráfico o un panel de entrada de órdenes concreto. Ambos deben estar activados para que un atajo funcione. Tenga esto presente y el resto será sencillo." },
    { type: "heading",text: "Cómo activar y configurar las teclas de acceso rápido en Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Active las teclas de acceso rápido en los ajustes de la aplicación", html: "Abra Application Settings desde el icono de engranaje, cambie a la pestaña Application Preferences y desplácese hacia abajo hasta llegar al encabezado Hotkeys. Haga clic en el control para activar las teclas de acceso rápido. Ese es el interruptor maestro. Nada de lo que haga aquí importa hasta que lo active." },
        { title: "Abra el editor de teclas de acceso rápido", html: "Haga clic en el botón Edit Hotkeys y se abrirá la lista completa de acciones asignables, agrupadas en secciones como Chart Actions, DOM Actions y Order Entry. Si activa el encabezado de una sección, habilita o deshabilita todo ese grupo a la vez. Si en cambio la expande, puede ver y reconfigurar cada acción individual que contiene. Empiece por lo general y luego baje a las acciones concretas con las que opera." },
        { title: "Asigne una combinación de teclas", html: "Active la acción que quiera, haga clic en su cuadro de texto vacío y pulse la tecla o la combinación a la vez, no una tecla tras otra. Funcionan las teclas simples y también los modificadores como Alt, Ctrl y Alt + Shift, que es la forma de evitar que sus atajos de compra y venta se disparen por accidente. Haga clic en cualquier otro punto de la página para guardar. Un banner verde confirma que se ha guardado. Si la combinación choca con algo que ya asignó, un mensaje le indica exactamente qué entra en conflicto para que pueda elegir otra." },
        { title: "Arme las teclas de acceso rápido dentro de un módulo con el interruptor \"H\"", html: "Este es el paso que casi todos pasan por alto. Muchas teclas de acceso rápido están vinculadas a un módulo concreto y permanecen inactivas hasta que usted arma ese módulo. Haga clic en el interruptor \"H\" en la esquina superior del panel de DOM, gráfico o entrada de órdenes, o en el de la parte superior de toda la pila de módulos, para activar las teclas en él. Cuando están activas, aparece un pequeño icono de teclado junto al símbolo del contrato. Sin icono de teclado no hay teclas activas: revise el interruptor." },
        { title: "Restablezca o elimine una tecla de acceso rápido", html: "¿Ha cambiado de idea sobre una asignación? Vuelva a abrir Edit Hotkeys, localice la acción y haga clic en el botón Reset junto a su cuadro de texto para borrarla o restaurarla. Haga lo mismo con cualquier otra asignación que quiera cambiar y cierre el editor. Conviene revisar su distribución cada pocas semanas a medida que evoluciona su configuración." },
      ],
    },
    { type: "heading",text: "Por qué lo necesitaría" },
    {
      type: "list",
      items: [
        "Entre y salga de futuros rápidos como el ES o el NQ sin arrastrar el ratón hasta un botón.",
        "Cierre una posición o cancele todas las órdenes activas en el instante en que el mercado gira en su contra.",
        "Mantenga la vista en el precio y en el libro de órdenes en lugar de en la barra de herramientas.",
        "Cree la misma distribución de memoria muscular en todos los gráficos y DOM con los que opera.",
        "Reduzca los errores de dedo asignando solo las acciones que realmente utiliza.",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Las teclas de acceso rápido agilizan sus clics manuales, pero aun así requieren una mano en el teclado. Si prefiere que sus entradas, stops y salidas se ejecuten solas, <strong class='text-white'>PickMyTrade conecta sus alertas de TradingView directamente con su cuenta de Tradovate</strong> para que las operaciones se ejecuten automáticamente, sin pulsar ninguna tecla." },
  ], fr: [
    { type: "paragraph",html: "Vous voulez passer un ordre au marché, clôturer une position ou tout annuler dans Tradovate sans toucher à la souris ? Quand l'ES ou le NQ bouge, la demi-seconde nécessaire pour trouver un bouton est la demi-seconde que vous perdez. Ce guide vous explique pas à pas comment activer les raccourcis clavier, associer des touches à des actions et les armer dans chaque panneau." },
    { type: "heading",text: "Que sont les raccourcis clavier de Tradovate ?" },
    { type: "paragraph",html: "Un raccourci clavier Tradovate associe une touche ou une combinaison de touches à une action de trading ou de graphique. Passer un ordre au marché, clôturer une position, annuler tous les ordres en attente, basculer un graphique sur une autre unité de temps, tout cela en une seule frappe plutôt qu'en cliquant dans l'interface." },
    { type: "paragraph",html: "Voici ce qui piège beaucoup de monde : les raccourcis se trouvent à deux endroits. Il y a un interrupteur général marche/arrêt enfoui dans vos paramètres, et il y a un bouton « H » par module qui arme les raccourcis dans un DOM, un graphique ou un panneau de saisie d'ordres donné. Les deux doivent être activés pour qu'un raccourci se déclenche. Gardez cela en tête et le reste est facile." },
    { type: "heading",text: "Activer et configurer les raccourcis clavier dans Tradovate : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Activez les raccourcis clavier dans les paramètres de l'application", html: "Ouvrez Application Settings depuis l'icône en forme d'engrenage, passez à l'onglet Application Preferences et faites défiler jusqu'à l'intitulé Hotkeys. Cliquez sur la commande pour activer les raccourcis. C'est l'interrupteur principal. Rien de ce que vous faites ici n'a d'effet tant qu'il n'est pas activé." },
        { title: "Ouvrez l'éditeur de raccourcis", html: "Cliquez sur le bouton Edit Hotkeys : la liste complète des actions pouvant être associées s'ouvre, regroupées en sections comme Chart Actions, DOM Actions et Order Entry. En basculant l'intitulé d'une section, vous activez ou désactivez tout le groupe d'un coup. En la développant plutôt, vous pouvez voir et reconfigurer chaque action individuelle qu'elle contient. Commencez large, puis descendez vers les actions précises que vous utilisez réellement pour trader." },
        { title: "Attribuez une combinaison de touches", html: "Activez l'action souhaitée, cliquez dans sa zone de texte vide, puis appuyez sur votre touche ou votre combinaison en une seule fois, et non l'une après l'autre. Les touches simples fonctionnent, tout comme les modificateurs tels que Alt, Ctrl et Alt + Shift, ce qui vous évite de déclencher vos raccourcis d'achat et de vente par accident. Cliquez n'importe où ailleurs sur la page pour enregistrer. Une bannière verte confirme que c'est pris en compte. Si la combinaison entre en conflit avec une association existante, un message vous indique précisément ce qui pose problème afin que vous puissiez en choisir une autre." },
        { title: "Armez les raccourcis dans un module avec le bouton « H »", html: "C'est l'étape que la plupart des gens manquent. De nombreux raccourcis sont liés à un module précis et restent inactifs tant que vous n'armez pas ce module. Cliquez sur le bouton « H » dans le coin supérieur du panneau DOM, graphique ou saisie d'ordres, ou sur celui situé tout en haut de la pile de modules, pour activer les raccourcis dans ce module. Lorsqu'ils sont actifs, une petite icône de clavier apparaît à côté du symbole du contrat. Pas d'icône de clavier, pas de raccourcis actifs : vérifiez le bouton." },
        { title: "Réinitialisez ou supprimez un raccourci", html: "Vous avez changé d'avis sur une association ? Rouvrez Edit Hotkeys, repérez l'action et cliquez sur le bouton Reset à côté de sa zone de texte pour l'effacer ou la restaurer. Faites de même pour toute autre association à modifier, puis fermez l'éditeur. Il vaut la peine de revoir votre disposition toutes les quelques semaines à mesure que votre configuration évolue." },
      ],
    },
    { type: "heading",text: "Pourquoi vous en auriez besoin" },
    {
      type: "list",
      items: [
        "Entrez et sortez des futures rapides comme l'ES ou le NQ sans déplacer votre souris vers un bouton.",
        "Clôturez une position ou annulez tous les ordres en attente à la seconde où le marché se retourne contre vous.",
        "Gardez les yeux sur le prix et sur le carnet d'ordres plutôt que sur la barre d'outils.",
        "Construisez la même disposition basée sur la mémoire musculaire sur tous les graphiques et DOM que vous tradez.",
        "Réduisez les erreurs de manipulation en n'associant que les actions que vous utilisez vraiment.",
      ],
    },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Les raccourcis clavier accélèrent vos clics manuels, mais ils exigent toujours une main sur le clavier. Si vous préférez que vos entrées, vos stops et vos sorties se déclenchent d'eux-mêmes, <strong class='text-white'>PickMyTrade relie vos alertes TradingView directement à votre compte Tradovate</strong> afin que les trades s'exécutent automatiquement, sans la moindre frappe." },
  ], it: [
    { type: "paragraph",html: "Vuole inviare un ordine a mercato, chiudere una posizione o annullare tutto in Tradovate senza toccare il mouse? Quando l'ES o l'NQ si muove, il mezzo secondo che serve per trovare un pulsante è il mezzo secondo che perde. Questa guida le mostra passo dopo passo come attivare le scorciatoie da tastiera, assegnare i tasti alle azioni e armarle all'interno di ogni pannello." },
    { type: "heading",text: "Che cosa sono le scorciatoie da tastiera di Tradovate?" },
    { type: "paragraph",html: "Una scorciatoia da tastiera di Tradovate associa un singolo tasto o una combinazione di tasti a un'azione di trading o di grafico. Inviare un ordine a mercato, chiudere una posizione, annullare ogni ordine attivo, portare un grafico su un altro timeframe, tutto con una sola pressione di tasto anziché cliccando in giro per l'interfaccia." },
    { type: "paragraph",html: "Ecco il punto su cui molti inciampano: le scorciatoie si trovano in due posti. C'è un interruttore globale on/off nascosto nelle impostazioni, e c'è un interruttore \"H\" per ogni modulo che arma le scorciatoie all'interno di un singolo pannello DOM, grafico o di inserimento ordini. Entrambi devono essere attivi perché una scorciatoia funzioni. Tenga a mente questo e il resto sarà semplice." },
    { type: "heading",text: "Abilitare e configurare le scorciatoie da tastiera in Tradovate: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Attivi le scorciatoie nelle impostazioni dell'applicazione", html: "Apra Application Settings dall'icona a forma di ingranaggio, passi alla scheda Application Preferences e scorra verso il basso fino al titolo Hotkeys. Clicchi sul controllo per attivare le scorciatoie. È l'interruttore principale. Nulla di ciò che fa qui conta finché non lo attiva." },
        { title: "Apra l'editor delle scorciatoie", html: "Clicchi sul pulsante Edit Hotkeys e si aprirà l'elenco completo delle azioni assegnabili, raggruppate in sezioni come Chart Actions, DOM Actions e Order Entry. Attivando o disattivando il titolo di una sezione, abilita o disabilita l'intero gruppo in un colpo solo. Espandendo invece una sezione, può vedere e riconfigurare ogni singola azione al suo interno. Parta dal generale, poi scenda alle azioni specifiche con cui opera davvero." },
        { title: "Assegni una combinazione di tasti", html: "Attivi l'azione desiderata, clicchi nella sua casella di testo vuota, poi prema il tasto o la combinazione tutti insieme, non uno dopo l'altro. Funzionano i tasti singoli e anche i modificatori come Alt, Ctrl e Alt + Shift, ed è così che evita che le sue scorciatoie di acquisto e vendita scattino per errore. Clicchi in un altro punto qualsiasi della pagina per salvare. Un banner verde conferma che è stato registrato. Se la combinazione entra in conflitto con qualcosa che ha già assegnato, un messaggio le indica esattamente che cosa è in conflitto, così può sceglierne un'altra." },
        { title: "Armi le scorciatoie all'interno di un modulo con l'interruttore \"H\"", html: "È il passaggio che quasi tutti trascurano. Molte scorciatoie sono associate a un modulo specifico e restano inattive finché non arma quel modulo. Clicchi sull'interruttore \"H\" nell'angolo in alto del pannello DOM, grafico o di inserimento ordini, oppure su quello in cima all'intera pila di moduli, per attivare le scorciatoie al suo interno. Quando sono attive, accanto al simbolo del contratto compare una piccola icona di tastiera. Nessuna icona di tastiera, nessuna scorciatoia attiva: controlli l'interruttore." },
        { title: "Reimposti o rimuova una scorciatoia", html: "Ha cambiato idea su un'assegnazione? Riapra Edit Hotkeys, trovi l'azione e clicchi sul pulsante Reset accanto alla sua casella di testo per cancellarla o ripristinarla. Faccia lo stesso per qualsiasi altra associazione che desidera modificare, poi chiuda l'editor. Vale la pena rivedere il suo layout ogni poche settimane man mano che la sua configurazione evolve." },
      ],
    },
    { type: "heading",text: "Perché le servirebbe" },
