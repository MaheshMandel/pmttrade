---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-roll-contract";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Roll or Change the Contract Month in Tradovate";
const META_DESCRIPTION =
  "Roll futures contracts forward in Tradovate and read the month-code symbol format so expiring contracts don't trigger order rejections.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Kontraktmonat in Tradovate rollen oder wechseln", es: "Cómo hacer roll o cambiar el mes del contrato en Tradovate", fr: "Rouler ou changer le mois du contrat dans Tradovate", it: "Come fare il roll o cambiare il mese del contratto in Tradovate" },
  dek: { en: "Every futures contract expires. Here's how Tradovate writes its contract symbols, how to change the month on a quote, and how to roll an open position before it goes liquidation-only.", de: "Jeder Futures-Kontrakt läuft aus. So schreibt Tradovate seine Kontraktsymbole, so ändern Sie den Monat in einer Kursanzeige und so rollen Sie eine offene Position, bevor sie in den Liquidation-only-Modus wechselt.", es: "Todo contrato de futuros vence. Aquí le explicamos cómo escribe Tradovate los símbolos de contrato, cómo cambiar el mes en una cotización y cómo hacer roll de una posición abierta antes de que pase a solo liquidación.", fr: "Chaque contrat à terme expire. Voici comment Tradovate écrit ses symboles de contrat, comment changer le mois d’une cotation et comment rouler une position ouverte avant qu’elle ne passe en liquidation seule.", it: "Ogni contratto future scade. Ecco come Tradovate scrive i simboli dei contratti, come cambiare il mese di una quotazione e come fare il roll di una posizione aperta prima che passi in sola liquidazione." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Every futures contract has an expiration date. Trade the same market long enough and the contract you're holding will age out, and if you don't move to the next one in time, Tradovate stops letting you open new positions on it. Rolling is how you hop from the expiring month to the active one. Below is how Tradovate writes its contract symbols, how to change the month on a quote, and how to carry an open position across without getting stuck in a liquidation-only lockout." },
    { type: "heading", text: "Why Rolling Matters" },
    { type: "paragraph", html: "The contract closest to expiration is the <strong class='text-white'>front month</strong>, usually where the volume sits, and where you want to be. As expiration nears, the exchange restricts new trading in the expiring contract. In Tradovate that shows up as an order rejection worded something like \"Liquidation only, contract is about to expire.\" Once you see that, you can only close a position, not open one. So you roll <em>before</em> you hit that wall, not after." },
    { type: "paragraph", html: "Tradovate sends roll alerts ahead of expiration, and its default continuous symbol shifts to the new month based on volume, once the next contract trades more than the expiring one, the default follows it. Your open position doesn't move on its own, though. That part's on you." },
    { type: "quote", html: "On a prop or evaluation account, roll timing and any extra restrictions can vary by firm and account size. Check your firm's current rules before expiration week." },
    { type: "heading", text: "How Tradovate Contract Symbols Work" },
    { type: "paragraph", html: "A futures symbol is three parts: the root, a one-letter month code, and a two-digit year. So <strong class='text-white'>ESM26</strong> is the E-mini S&amp;P 500 for June 2026, and <strong class='text-white'>NQZ26</strong> is the E-mini Nasdaq-100 for December 2026. Get the month code wrong and you're looking at the wrong contract, or one you can't trade. Here's the full set of codes:" },
    {
      type: "table",
      headers: ["Code", "Month", "Code", "Month"],
      rows: [
        ["F", "January", "N", "July"],
        ["G", "February", "Q", "August"],
        ["H", "March", "U", "September"],
        ["J", "April", "V", "October"],
        ["K", "May", "X", "November"],
        ["M", "June", "Z", "December"],
      ],
    },
    { type: "paragraph", html: "The equity-index futures most traders live in, ES, NQ, YM, RTY, run on a quarterly cycle: March (H), June (M), September (U), and December (Z). Energies and metals roll monthly, so check the specific product's schedule." },
    { type: "heading", text: "How to Roll or Change the Contract Month" },
    {
      type: "steps",
      items: [
        { title: "Find the Current Front-Month Contract", html: "Open the symbol on a chart, DOM, or quote board and look at the volume. The front month is the one carrying the heavy volume. Around roll week, watch the next month's volume climb, when it passes the expiring contract, the active month has shifted and it's time to move.", image: { src: `${IMG}/tradovate-roll-contract-1.png`, alt: "Tradovate quote board showing two contract months of the same symbol with volume figures to identify the front month" } },
        { title: "Roll the Displayed Month Forward or Backward", html: "Right-click the symbol in your Quote Board, or open the contract's settings menu (the gear icon on the DOM or chart), and pick <strong class='text-white'>Roll Forward</strong> to jump to the next expiration, or <strong class='text-white'>Roll Backward</strong> to step back to the previous one. This changes the month your quote, chart, and DOM are showing so you're working with the right contract.", image: { src: `${IMG}/tradovate-roll-contract-2.png`, alt: "Tradovate right-click menu on a quote with Roll Forward and Roll Backward options highlighted" } },
        { title: "Or Type the Exact Contract Symbol", html: "Want to go straight to a specific month instead? Click the symbol field and type the full symbol, root plus month code plus year, like <strong class='text-white'>ESU26</strong>. Tradovate loads that exact contract. This is the fastest route when you need to jump more than one expiration out, or when you already know the code you want.", image: { src: `${IMG}/tradovate-roll-contract-3.png`, alt: "Typing the full contract symbol ESU26 into the Tradovate instrument search field" } },
        { title: "Move Your Open Position to the New Contract", html: "Here's the part people miss: changing the quote doesn't move your position, it only changes what you're looking at. To actually roll a position, flatten (close) your contracts in the expiring month, then open the same size in the new month. Do it before the old contract flips to liquidation-only, so you're never stuck holding something you can't manage normally.", image: { src: `${IMG}/tradovate-roll-contract-4.png`, alt: "Tradovate positions panel showing a flattened expiring contract and a new position opened in the next month" } },
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Rolling every quarter by hand gets old fast. If you fire entries from TradingView, <strong class='text-white'>PickMyTrade can route your alerts to the right Tradovate contract automatically</strong>." },
    { type: "paragraph", html: "A few habits keep rollover painless: know your contract's expiration before the week it lands, roll a couple of sessions early, and always confirm you're on the active month before you send an order. If an order still bounces, our guide to the \"liquidation only, contract about to expire\" rejection and the fix for the \"non-tradable symbol\" error on TradingView walk through it step by step. And if quotes look frozen or delayed on the new contract, you may just need to subscribe to real-time market data for it." },
  ], de: [
    { type: "paragraph",html: "Jeder Futures-Kontrakt hat ein Verfallsdatum. Wer lange genug denselben Markt handelt, dessen Kontrakt läuft irgendwann aus, und wenn Sie nicht rechtzeitig zum nächsten wechseln, lässt Tradovate keine neuen Positionen mehr darin zu. Rollen bedeutet, vom auslaufenden Monat in den aktiven Monat zu wechseln. Nachfolgend erfahren Sie, wie Tradovate seine Kontraktsymbole schreibt, wie Sie den Monat in einer Kursanzeige ändern und wie Sie eine offene Position übertragen, ohne in einer Liquidation-only-Sperre festzustecken." },
    { type: "heading",text: "Warum das Rollen wichtig ist" },
    { type: "paragraph",html: "Der Kontrakt mit dem nächsten Verfall ist der <strong class='text-white'>Frontmonat</strong>, meist dort, wo das Volumen liegt und wo Sie sein möchten. Kurz vor dem Verfall schränkt die Börse den Neuhandel im auslaufenden Kontrakt ein. In Tradovate zeigt sich das als Orderablehnung mit etwa dem Wortlaut „Liquidation only, contract is about to expire.“ Sobald Sie das sehen, können Sie eine Position nur noch schließen, nicht mehr eröffnen. Rollen Sie also <em>bevor</em> Sie an diese Wand stoßen, nicht danach." },
    { type: "paragraph",html: "Tradovate sendet Roll-Benachrichtigungen vor dem Verfall, und das standardmäßige Continuous-Symbol wechselt anhand des Volumens in den neuen Monat: Sobald der nächste Kontrakt mehr Volumen hat als der auslaufende, folgt der Standard ihm. Ihre offene Position wandert jedoch nicht von selbst mit. Das liegt bei Ihnen." },
    { type: "quote",html: "Bei Prop- oder Evaluierungskonten können Roll-Zeitpunkt und zusätzliche Einschränkungen je nach Firma und Kontogröße abweichen. Prüfen Sie die aktuellen Regeln Ihrer Firma vor der Verfallswoche." },
    { type: "heading",text: "So funktionieren Tradovate-Kontraktsymbole" },
    { type: "paragraph",html: "Ein Futures-Symbol besteht aus drei Teilen: dem Basiswert-Kürzel, einem Buchstaben als Monatscode und einer zweistelligen Jahreszahl. <strong class='text-white'>ESM26</strong> ist also der E-mini S&amp;P 500 für Juni 2026, und <strong class='text-white'>NQZ26</strong> ist der E-mini Nasdaq-100 für Dezember 2026. Wenn Sie den Monatscode falsch wählen, sehen Sie den falschen Kontrakt oder einen, den Sie nicht handeln können. Hier alle Codes:" },
    { type: "table", headers: ["Code","Monat","Code","Monat"], rows: [
      ["F","Januar","N","Juli"],
      ["G","Februar","Q","August"],
      ["H","März","U","September"],
      ["J","April","V","Oktober"],
      ["K","Mai","X","November"],
      ["M","Juni","Z","Dezember"],
    ] },
    { type: "paragraph",html: "Die Aktienindex-Futures, in denen die meisten Trader zu Hause sind, ES, NQ, YM, RTY, folgen einem Quartalszyklus: März (H), Juni (M), September (U) und Dezember (Z). Energie- und Metallkontrakte werden monatlich gerollt, prüfen Sie daher den Zeitplan des jeweiligen Produkts." },
    { type: "heading",text: "So rollen oder wechseln Sie den Kontraktmonat" },
    {
      type: "steps",
      items: [
        { title: "Den aktuellen Frontmonat-Kontrakt finden", html: "Öffnen Sie das Symbol in einem Chart, DOM oder Quote Board und achten Sie auf das Volumen. Der Frontmonat ist der mit dem hohen Volumen. In der Rollwoche beobachten Sie, wie das Volumen des nächsten Monats steigt. Sobald es den auslaufenden Kontrakt übertrifft, hat sich der aktive Monat verschoben und es ist Zeit zu wechseln.", image: {"src":`${IMG}/tradovate-roll-contract-1.png`,"alt":"Tradovate-Quote-Board mit zwei Kontraktmonaten desselben Symbols und Volumenangaben zur Bestimmung des Frontmonats"} },
        { title: "Den angezeigten Monat vor- oder zurückrollen", html: "Klicken Sie mit der rechten Maustaste auf das Symbol im Quote Board oder öffnen Sie das Einstellungsmenü des Kontrakts (das Zahnradsymbol am DOM oder Chart) und wählen Sie <strong class='text-white'>Roll Forward</strong>, um zum nächsten Verfall zu springen, oder <strong class='text-white'>Roll Backward</strong>, um zum vorherigen zurückzugehen. Damit ändern Sie den Monat, den Quote, Chart und DOM anzeigen, sodass Sie mit dem richtigen Kontrakt arbeiten.", image: {"src":`${IMG}/tradovate-roll-contract-2.png`,"alt":"Tradovate-Kontextmenü auf einem Quote mit hervorgehobenen Optionen Roll Forward und Roll Backward"} },
        { title: "Oder das exakte Kontraktsymbol eingeben", html: "Möchten Sie direkt zu einem bestimmten Monat? Klicken Sie in das Symbolfeld und geben Sie das vollständige Symbol ein, Basiswert plus Monatscode plus Jahr, zum Beispiel <strong class='text-white'>ESU26</strong>. Tradovate lädt genau diesen Kontrakt. Das ist der schnellste Weg, wenn Sie mehr als einen Verfall weiter springen möchten oder den gewünschten Code bereits kennen.", image: {"src":`${IMG}/tradovate-roll-contract-3.png`,"alt":"Eingabe des vollständigen Kontraktsymbols ESU26 in das Instrumenten-Suchfeld von Tradovate"} },
        { title: "Ihre offene Position in den neuen Kontrakt übertragen", html: "Das übersehen viele: Das Ändern der Kursanzeige verschiebt Ihre Position nicht, es ändert nur, was Sie sehen. Um eine Position tatsächlich zu rollen, schließen (flatten) Sie Ihre Kontrakte im auslaufenden Monat und eröffnen dann dieselbe Größe im neuen Monat. Tun Sie das, bevor der alte Kontrakt in den Liquidation-only-Modus wechselt, damit Sie nie etwas halten, das Sie nicht normal verwalten können.", image: {"src":`${IMG}/tradovate-roll-contract-4.png`,"alt":"Tradovate-Positionsfenster mit einem geschlossenen auslaufenden Kontrakt und einer neu eröffneten Position im nächsten Monat"} },
      ],
    },
    { type: "heading",text: "Mit PickMyTrade automatisieren" },
    { type: "paragraph",html: "Jedes Quartal von Hand zu rollen nervt schnell. Wenn Sie Einstiege über TradingView auslösen, kann <strong class='text-white'>PickMyTrade Ihre Alerts automatisch an den richtigen Tradovate-Kontrakt weiterleiten</strong>." },
    { type: "paragraph",html: "Ein paar Gewohnheiten machen den Rollover unkompliziert: Kennen Sie den Verfall Ihres Kontrakts schon vor der Verfallswoche, rollen Sie ein paar Sitzungen früher und prüfen Sie vor jeder Order, dass Sie sich im aktiven Monat befinden. Wenn eine Order trotzdem abgelehnt wird, führen unsere Anleitung zur Ablehnung „liquidation only, contract about to expire“ und zur Behebung des Fehlers „non-tradable symbol“ in TradingView Sie Schritt für Schritt durch. Und wenn Kurse im neuen Kontrakt eingefroren oder verzögert wirken, müssen Sie womöglich nur Echtzeit-Marktdaten dafür abonnieren." },
  ], es: [
    { type: "paragraph",html: "Todo contrato de futuros tiene una fecha de vencimiento. Si opera el mismo mercado el tiempo suficiente, el contrato que mantiene acabará venciendo y, si no pasa al siguiente a tiempo, Tradovate dejará de permitirle abrir nuevas posiciones en él. Hacer roll es la forma de pasar del mes que vence al mes activo. A continuación verá cómo escribe Tradovate sus símbolos de contrato, cómo cambiar el mes en una cotización y cómo trasladar una posición abierta sin quedarse bloqueado en solo liquidación." },
    { type: "heading",text: "Por qué es importante hacer el roll" },
    { type: "paragraph",html: "El contrato más cercano al vencimiento es el <strong class='text-white'>mes frontal</strong> (front month), normalmente donde está el volumen y donde usted quiere estar. A medida que se acerca el vencimiento, el mercado restringe las nuevas operaciones en el contrato que vence. En Tradovate esto aparece como un rechazo de orden con un texto parecido a \"Liquidation only, contract is about to expire.\" Cuando lo vea, solo podrá cerrar una posición, no abrirla. Por eso se hace el roll <em>antes</em> de llegar a ese muro, no después." },
    { type: "paragraph",html: "Tradovate envía avisos de roll antes del vencimiento y su símbolo continuo predeterminado pasa al nuevo mes según el volumen: cuando el siguiente contrato negocia más que el que vence, el valor predeterminado lo sigue. Sin embargo, su posición abierta no se mueve sola. Eso corre de su cuenta." },
    { type: "quote",html: "En una cuenta prop o de evaluación, el momento del roll y las restricciones adicionales pueden variar según la firma y el tamaño de la cuenta. Consulte las reglas vigentes de su firma antes de la semana de vencimiento." },
    { type: "heading",text: "Cómo funcionan los símbolos de contrato de Tradovate" },
    { type: "paragraph",html: "Un símbolo de futuros tiene tres partes: la raíz, un código de mes de una letra y el año con dos dígitos. Así, <strong class='text-white'>ESM26</strong> es el E-mini S&amp;P 500 de junio de 2026 y <strong class='text-white'>NQZ26</strong> es el E-mini Nasdaq-100 de diciembre de 2026. Si se equivoca con el código de mes, verá el contrato equivocado o uno que no puede operar. Estos son todos los códigos:" },
    { type: "table", headers: ["Código","Mes","Código","Mes"], rows: [
      ["F","Enero","N","Julio"],
      ["G","Febrero","Q","Agosto"],
      ["H","Marzo","U","Septiembre"],
      ["J","Abril","V","Octubre"],
      ["K","Mayo","X","Noviembre"],
      ["M","Junio","Z","Diciembre"],
    ] },
    { type: "paragraph",html: "Los futuros de índices bursátiles con los que opera la mayoría, ES, NQ, YM, RTY, siguen un ciclo trimestral: marzo (H), junio (M), septiembre (U) y diciembre (Z). Los de energía y metales vencen cada mes, así que consulte el calendario de cada producto." },
    { type: "heading",text: "Cómo hacer roll o cambiar el mes del contrato" },
    {
      type: "steps",
      items: [
        { title: "Encuentre el contrato del mes frontal actual", html: "Abra el símbolo en un gráfico, DOM o tablero de cotizaciones y observe el volumen. El mes frontal es el que concentra el volumen elevado. Durante la semana del roll, vea cómo sube el volumen del mes siguiente: cuando supera al contrato que vence, el mes activo ha cambiado y es hora de pasar.", image: {"src":`${IMG}/tradovate-roll-contract-1.png`,"alt":"Tablero de cotizaciones de Tradovate con dos meses de contrato del mismo símbolo y cifras de volumen para identificar el mes frontal"} },
        { title: "Avance o retroceda el mes mostrado", html: "Haga clic derecho en el símbolo de su Quote Board o abra el menú de ajustes del contrato (el icono de engranaje en el DOM o el gráfico) y elija <strong class='text-white'>Roll Forward</strong> para saltar al siguiente vencimiento o <strong class='text-white'>Roll Backward</strong> para volver al anterior. Esto cambia el mes que muestran su cotización, gráfico y DOM, de modo que trabaje con el contrato correcto.", image: {"src":`${IMG}/tradovate-roll-contract-2.png`,"alt":"Menú contextual de Tradovate sobre una cotización con las opciones Roll Forward y Roll Backward resaltadas"} },
        { title: "O escriba el símbolo exacto del contrato", html: "¿Prefiere ir directamente a un mes concreto? Haga clic en el campo del símbolo y escriba el símbolo completo, raíz más código de mes más año, como <strong class='text-white'>ESU26</strong>. Tradovate carga exactamente ese contrato. Es la vía más rápida cuando necesita saltar más de un vencimiento o cuando ya conoce el código que quiere.", image: {"src":`${IMG}/tradovate-roll-contract-3.png`,"alt":"Escritura del símbolo de contrato completo ESU26 en el campo de búsqueda de instrumentos de Tradovate"} },
        { title: "Traslade su posición abierta al nuevo contrato", html: "Esto es lo que mucha gente pasa por alto: cambiar la cotización no mueve su posición, solo cambia lo que está viendo. Para hacer roll de una posición de verdad, cierre (flatten) sus contratos del mes que vence y abra después el mismo tamaño en el nuevo mes. Hágalo antes de que el contrato antiguo pase a solo liquidación, para no quedarse con algo que no puede gestionar con normalidad.", image: {"src":`${IMG}/tradovate-roll-contract-4.png`,"alt":"Panel de posiciones de Tradovate con un contrato que vence cerrado y una nueva posición abierta en el mes siguiente"} },
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Hacer el roll a mano cada trimestre cansa enseguida. Si lanza sus entradas desde TradingView, <strong class='text-white'>PickMyTrade puede enrutar sus alertas al contrato de Tradovate correcto de forma automática</strong>." },
    { type: "paragraph",html: "Unos pocos hábitos hacen que el roll sea sencillo: conozca el vencimiento de su contrato antes de la semana en que llega, haga el roll un par de sesiones antes y confirme siempre que está en el mes activo antes de enviar una orden. Si una orden aun así es rechazada, nuestra guía sobre el rechazo \"liquidation only, contract about to expire\" y la solución al error \"non-tradable symbol\" en TradingView le guían paso a paso. Y si las cotizaciones del nuevo contrato aparecen congeladas o con retraso, quizá solo necesite suscribirse a los datos de mercado en tiempo real de ese contrato." },
  ], fr: [
    { type: "paragraph",html: "Chaque contrat à terme a une date d’expiration. À force de trader le même marché, le contrat que vous détenez finira par arriver à échéance et, si vous ne passez pas au suivant à temps, Tradovate ne vous laissera plus ouvrir de nouvelles positions dessus. Rouler consiste à passer du mois qui expire au mois actif. Vous trouverez ci-dessous comment Tradovate écrit ses symboles de contrat, comment changer le mois d’une cotation et comment reporter une position ouverte sans vous retrouver bloqué en liquidation seule." },
    { type: "heading",text: "Pourquoi le roll est important" },
    { type: "paragraph",html: "Le contrat le plus proche de l’expiration est le <strong class='text-white'>mois de front</strong> (front month), généralement celui où se concentre le volume et où vous voulez être. À l’approche de l’expiration, la bourse restreint les nouvelles transactions sur le contrat expirant. Dans Tradovate, cela apparaît sous la forme d’un rejet d’ordre dont le libellé ressemble à « Liquidation only, contract is about to expire. » Une fois que vous le voyez, vous ne pouvez plus que clôturer une position, pas en ouvrir. Il faut donc rouler <em>avant</em> d’atteindre ce mur, pas après." },
    { type: "paragraph",html: "Tradovate envoie des alertes de roll avant l’expiration et son symbole continu par défaut bascule vers le nouveau mois en fonction du volume : dès que le contrat suivant s’échange davantage que celui qui expire, le symbole par défaut le suit. Votre position ouverte, en revanche, ne bouge pas toute seule. Cette partie vous incombe." },
    { type: "quote",html: "Sur un compte prop ou d’évaluation, le moment du roll et les éventuelles restrictions supplémentaires peuvent varier selon la firme et la taille du compte. Vérifiez les règles actuelles de votre firme avant la semaine d’expiration." },
    { type: "heading",text: "Comment fonctionnent les symboles de contrat Tradovate" },
    { type: "paragraph",html: "Un symbole de contrat à terme comporte trois parties : la racine, un code de mois d’une lettre et l’année sur deux chiffres. Ainsi, <strong class='text-white'>ESM26</strong> est l’E-mini S&amp;P 500 de juin 2026 et <strong class='text-white'>NQZ26</strong> est l’E-mini Nasdaq-100 de décembre 2026. Si vous vous trompez de code de mois, vous regardez le mauvais contrat, ou un contrat que vous ne pouvez pas trader. Voici l’ensemble des codes :" },
    { type: "table", headers: ["Code","Mois","Code","Mois"], rows: [
      ["F","Janvier","N","Juillet"],
      ["G","Février","Q","Août"],
      ["H","Mars","U","Septembre"],
      ["J","Avril","V","Octobre"],
      ["K","Mai","X","Novembre"],
      ["M","Juin","Z","Décembre"],
    ] },
    { type: "paragraph",html: "Les contrats à terme sur indices actions que la plupart des traders utilisent, ES, NQ, YM, RTY, suivent un cycle trimestriel : mars (H), juin (M), septembre (U) et décembre (Z). Les énergies et les métaux se roulent chaque mois ; vérifiez donc le calendrier du produit concerné." },
    { type: "heading",text: "Comment rouler ou changer le mois du contrat" },
    {
      type: "steps",
      items: [
        { title: "Repérez le contrat du mois de front actuel", html: "Ouvrez le symbole sur un graphique, un DOM ou un tableau de cotations et regardez le volume. Le mois de front est celui qui porte le gros du volume. Pendant la semaine du roll, surveillez la hausse du volume du mois suivant : quand il dépasse celui du contrat expirant, le mois actif a changé et il est temps de basculer.", image: {"src":`${IMG}/tradovate-roll-contract-1.png`,"alt":"Tableau de cotations Tradovate affichant deux mois de contrat du même symbole avec les volumes pour identifier le mois de front"} },
        { title: "Faire avancer ou reculer le mois affiché", html: "Faites un clic droit sur le symbole dans votre Quote Board ou ouvrez le menu de réglages du contrat (l’icône en forme d’engrenage sur le DOM ou le graphique), puis choisissez <strong class='text-white'>Roll Forward</strong> pour passer à l’expiration suivante ou <strong class='text-white'>Roll Backward</strong> pour revenir à la précédente. Cela change le mois affiché par votre cotation, votre graphique et votre DOM afin que vous travailliez avec le bon contrat.", image: {"src":`${IMG}/tradovate-roll-contract-2.png`,"alt":"Menu contextuel Tradovate sur une cotation avec les options Roll Forward et Roll Backward en surbrillance"} },
        { title: "Ou saisissez le symbole exact du contrat", html: "Vous voulez aller directement à un mois précis ? Cliquez dans le champ du symbole et saisissez le symbole complet, racine plus code de mois plus année, par exemple <strong class='text-white'>ESU26</strong>. Tradovate charge exactement ce contrat. C’est le chemin le plus rapide quand vous devez sauter plus d’une expiration ou que vous connaissez déjà le code voulu.", image: {"src":`${IMG}/tradovate-roll-contract-3.png`,"alt":"Saisie du symbole de contrat complet ESU26 dans le champ de recherche d’instrument de Tradovate"} },
        { title: "Reportez votre position ouverte sur le nouveau contrat", html: "Voici ce que beaucoup oublient : changer la cotation ne déplace pas votre position, cela change seulement ce que vous regardez. Pour réellement rouler une position, clôturez (flatten) vos contrats du mois expirant, puis ouvrez la même taille sur le nouveau mois. Faites-le avant que l’ancien contrat ne passe en liquidation seule, afin de ne jamais rester bloqué avec une position que vous ne pouvez plus gérer normalement.", image: {"src":`${IMG}/tradovate-roll-contract-4.png`,"alt":"Panneau des positions Tradovate montrant un contrat expirant clôturé et une nouvelle position ouverte sur le mois suivant"} },
      ],
    },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Rouler à la main chaque trimestre devient vite lassant. Si vous déclenchez vos entrées depuis TradingView, <strong class='text-white'>PickMyTrade peut acheminer vos alertes automatiquement vers le bon contrat Tradovate</strong>." },
    { type: "paragraph",html: "Quelques habitudes rendent le rollover indolore : connaissez l’expiration de votre contrat avant la semaine où elle tombe, roulez quelques séances plus tôt et vérifiez toujours que vous êtes sur le mois actif avant d’envoyer un ordre. Si un ordre est tout de même rejeté, notre guide sur le rejet « liquidation only, contract about to expire » et la solution à l’erreur « non-tradable symbol » sur TradingView vous guident pas à pas. Et si les cotations semblent figées ou retardées sur le nouveau contrat, il vous suffit peut-être de vous abonner aux données de marché en temps réel pour celui-ci." },
  ], it: [
    { type: "paragraph",html: "Ogni contratto future ha una data di scadenza. Se opera sullo stesso mercato abbastanza a lungo, il contratto che detiene arriverà a scadenza e, se non passa al successivo in tempo, Tradovate non Le permetterà più di aprire nuove posizioni su di esso. Il roll è il modo per passare dal mese in scadenza al mese attivo. Di seguito trova come Tradovate scrive i simboli dei contratti, come cambiare il mese di una quotazione e come trasferire una posizione aperta senza restare bloccato in sola liquidazione." },
    { type: "heading",text: "Perché il roll è importante" },
    { type: "paragraph",html: "Il contratto più vicino alla scadenza è il <strong class='text-white'>mese front</strong> (front month), di solito quello in cui si concentra il volume e in cui vuole stare. Con l’avvicinarsi della scadenza, la borsa limita le nuove operazioni sul contratto in scadenza. In Tradovate questo appare come un rifiuto dell’ordine con un testo simile a \"Liquidation only, contract is about to expire.\" Quando lo vede, può solo chiudere una posizione, non aprirla. Si fa quindi il roll <em>prima</em> di arrivare a quel muro, non dopo." },
    { type: "paragraph",html: "Tradovate invia avvisi di roll prima della scadenza e il suo simbolo continuo predefinito passa al nuovo mese in base al volume: quando il contratto successivo scambia più di quello in scadenza, il predefinito lo segue. La Sua posizione aperta, però, non si sposta da sola. Questa parte spetta a Lei." },
    { type: "quote",html: "Su un conto prop o di valutazione, i tempi del roll ed eventuali restrizioni aggiuntive possono variare in base alla società e alla dimensione del conto. Verifichi le regole attuali della Sua società prima della settimana di scadenza." },
    { type: "heading",text: "Come funzionano i simboli dei contratti Tradovate" },
    { type: "paragraph",html: "Un simbolo future è composto da tre parti: la radice, un codice del mese di una lettera e l’anno a due cifre. Quindi <strong class='text-white'>ESM26</strong> è l’E-mini S&amp;P 500 di giugno 2026 e <strong class='text-white'>NQZ26</strong> è l’E-mini Nasdaq-100 di dicembre 2026. Se sbaglia il codice del mese, sta guardando il contratto sbagliato o uno che non può negoziare. Ecco tutti i codici:" },
    { type: "table", headers: ["Codice","Mese","Codice","Mese"], rows: [
      ["F","Gennaio","N","Luglio"],
      ["G","Febbraio","Q","Agosto"],
      ["H","Marzo","U","Settembre"],
      ["J","Aprile","V","Ottobre"],
      ["K","Maggio","X","Novembre"],
      ["M","Giugno","Z","Dicembre"],
    ] },
    { type: "paragraph",html: "I future sugli indici azionari in cui opera la maggior parte dei trader, ES, NQ, YM, RTY, seguono un ciclo trimestrale: marzo (H), giugno (M), settembre (U) e dicembre (Z). Energia e metalli hanno scadenza mensile, quindi controlli il calendario del singolo prodotto." },
    { type: "heading",text: "Come fare il roll o cambiare il mese del contratto" },
    {
      type: "steps",
      items: [
        { title: "Individui il contratto del mese front attuale", html: "Apra il simbolo su un grafico, un DOM o una quote board e osservi il volume. Il mese front è quello che concentra il volume elevato. Nella settimana del roll, osservi la crescita del volume del mese successivo: quando supera il contratto in scadenza, il mese attivo è cambiato ed è il momento di passare.", image: {"src":`${IMG}/tradovate-roll-contract-1.png`,"alt":"Quote board di Tradovate con due mesi di contratto dello stesso simbolo e i dati di volume per individuare il mese front"} },
        { title: "Faccia avanzare o retrocedere il mese visualizzato", html: "Faccia clic con il tasto destro sul simbolo nel Quote Board oppure apra il menu delle impostazioni del contratto (l’icona a forma di ingranaggio sul DOM o sul grafico) e scelga <strong class='text-white'>Roll Forward</strong> per passare alla scadenza successiva o <strong class='text-white'>Roll Backward</strong> per tornare alla precedente. Questo cambia il mese mostrato da quotazione, grafico e DOM, così lavora con il contratto giusto.", image: {"src":`${IMG}/tradovate-roll-contract-2.png`,"alt":"Menu contestuale di Tradovate su una quotazione con le opzioni Roll Forward e Roll Backward evidenziate"} },
        { title: "Oppure digiti il simbolo esatto del contratto", html: "Vuole andare direttamente a un mese specifico? Faccia clic nel campo del simbolo e digiti il simbolo completo, radice più codice del mese più anno, ad esempio <strong class='text-white'>ESU26</strong>. Tradovate carica esattamente quel contratto. È la via più rapida quando deve saltare più di una scadenza o conosce già il codice desiderato.", image: {"src":`${IMG}/tradovate-roll-contract-3.png`,"alt":"Inserimento del simbolo completo del contratto ESU26 nel campo di ricerca strumenti di Tradovate"} },
        { title: "Sposti la posizione aperta sul nuovo contratto", html: "Ecco ciò che molti trascurano: cambiare la quotazione non sposta la Sua posizione, cambia solo ciò che sta guardando. Per fare davvero il roll di una posizione, chiuda (flatten) i contratti nel mese in scadenza e poi apra la stessa quantità nel nuovo mese. Lo faccia prima che il vecchio contratto passi in sola liquidazione, così non resterà mai con una posizione che non può gestire normalmente.", image: {"src":`${IMG}/tradovate-roll-contract-4.png`,"alt":"Pannello posizioni di Tradovate con un contratto in scadenza chiuso e una nuova posizione aperta nel mese successivo"} },
      ],
    },
    { type: "heading",text: "Automatizzi tutto con PickMyTrade" },
    { type: "paragraph",html: "Fare il roll a mano ogni trimestre stanca in fretta. Se lancia le entrate da TradingView, <strong class='text-white'>PickMyTrade può instradare i Suoi alert automaticamente verso il contratto Tradovate corretto</strong>." },
    { type: "paragraph",html: "Poche abitudini rendono il rollover indolore: conosca la scadenza del Suo contratto prima della settimana in cui cade, faccia il roll un paio di sessioni prima e verifichi sempre di essere sul mese attivo prima di inviare un ordine. Se un ordine viene comunque rifiutato, la nostra guida sul rifiuto \"liquidation only, contract about to expire\" e la soluzione all’errore \"non-tradable symbol\" su TradingView La accompagnano passo dopo passo. E se le quotazioni sul nuovo contratto appaiono bloccate o in ritardo, potrebbe bastare sottoscrivere i dati di mercato in tempo reale per quel contratto." },
  ] },
  ctaHeading: { en: "Automate Your Contract Rolls", de: "Automatisieren Sie Ihre Kontrakt-Rollovers", es: "Automatice sus rolls de contrato", fr: "Automatisez vos rollovers de contrat", it: "Automatizzi i roll dei contratti" },
  ctaText: { en: "Rolling every quarter by hand gets old fast. If you fire entries from TradingView, PickMyTrade can route your alerts to the right Tradovate contract automatically.", de: "Jedes Quartal von Hand zu rollen nervt schnell. Wenn Sie Einstiege über TradingView auslösen, kann PickMyTrade Ihre Alerts automatisch an den richtigen Tradovate-Kontrakt weiterleiten.", es: "Hacer el roll a mano cada trimestre cansa enseguida. Si lanza sus entradas desde TradingView, PickMyTrade puede enrutar sus alertas al contrato de Tradovate correcto de forma automática.", fr: "Rouler à la main chaque trimestre devient vite lassant. Si vous déclenchez vos entrées depuis TradingView, PickMyTrade peut acheminer vos alertes automatiquement vers le bon contrat Tradovate.", it: "Fare il roll a mano ogni trimestre stanca in fretta. Se lancia le entrate da TradingView, PickMyTrade può instradare i Suoi alert automaticamente verso il contratto Tradovate corretto." },
