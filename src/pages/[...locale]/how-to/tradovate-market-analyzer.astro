---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-market-analyzer";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Use the Tradovate Market Analyzer Scanner";
const META_DESCRIPTION =
  "Set up the Tradovate Market Analyzer: add your futures symbols, pick the columns you need, and color-link the scanner to your chart, DOM, and Tick Stream.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Den Tradovate Market Analyzer als Scanner nutzen", es: "Use el escáner Market Analyzer de Tradovate", fr: "Utiliser le scanner Market Analyzer de Tradovate", it: "Usare lo scanner Market Analyzer di Tradovate" },
  dek: { en: "The Market Analyzer is Tradovate's quote scanner, a live grid where you watch a whole list of futures side by side. Here's how to populate it, pick your columns, and color-link it to the rest of your workspace.", de: "Der Market Analyzer ist der Kurs-Scanner von Tradovate, ein Live-Raster, in dem Sie eine ganze Liste von Futures nebeneinander beobachten. So füllen Sie ihn, wählen Ihre Spalten und verknüpfen ihn per Farbe mit dem Rest Ihres Arbeitsbereichs.", es: "El Market Analyzer es el escáner de cotizaciones de Tradovate, una cuadrícula en vivo donde observa una lista completa de futuros en paralelo. Así se llena, se eligen las columnas y se vincula por colores con el resto de su espacio de trabajo.", fr: "Le Market Analyzer est le scanner de cotations de Tradovate, une grille en direct où vous suivez côte à côte toute une liste de contrats à terme. Voici comment le remplir, choisir vos colonnes et le lier par couleur au reste de votre espace de travail.", it: "Il Market Analyzer è lo scanner di quotazioni di Tradovate, una griglia live in cui osserva un'intera lista di futures affiancati. Ecco come popolarla, scegliere le colonne e collegarla tramite colore al resto del Suo spazio di lavoro." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-10",
  blocks: { en: [
    { type: "paragraph", html: "The Market Analyzer is Tradovate's quote scanner, a live grid where you watch a whole list of futures side by side instead of flipping between charts. Set it up once and you can eyeball last price, net change, volume, and more across your entire watchlist, then click any row to fire that symbol straight into your chart and DOM. Here's how to populate it and wire it up." },
    { type: "heading", text: "What Is the Market Analyzer?" },
    { type: "paragraph", html: "Think of it as your command center for quotes. Each row is an instrument, each column is a data field, and the whole thing updates in real time. If you've used it before under its old name, the Quote Board, it's the same tool. The real payoff comes from color linking, which turns the scanner into a remote control for the rest of your workspace. Let's build one." },
    { type: "heading", text: "Set Up the Market Analyzer Scanner: Step by Step" },
    {
      type: "steps",
      items: [
        { title: "Open the Market Analyzer Module", html: "Head to the <strong class='text-white'>New +</strong> menu at the top-left of the platform. Find the <strong class='text-white'>Market Analyzer</strong> icon, then drag it into your workspace and drop it wherever you want it docked. It opens as an empty grid, ready for symbols.", image: { src: `${IMG}/tradovate-market-analyzer-1.png`, alt: "Tradovate New + menu with the Market Analyzer module being dragged into the workspace" } },
        { title: "Add Your Instruments", html: "Click into the <strong class='text-white'>search bar</strong> on the module and type a symbol or keyword, ES, NQ, CL, GC, whatever you trade. Pick the active <strong class='text-white'>front-month contract</strong> from the results and it drops into the grid as a new row. Repeat until your whole watchlist is loaded. A couple of things worth knowing: add the current contract rather than a continuous symbol so your quotes stay live through rollover, and right-click any row later if you want to remove it or insert another.", image: { src: `${IMG}/tradovate-market-analyzer-2.png`, alt: "Tradovate Market Analyzer search bar adding a futures symbol as a new row in the grid" } },
        { title: "Choose Your Columns", html: "Out of the box you'll see the basics, but you decide what shows. Click the <strong class='text-white'>View Settings</strong> gear (the cogwheel at the top-right of the module) and choose <strong class='text-white'>Select Columns</strong>. You'll get two lists, <strong class='text-white'>Available</strong> and <strong class='text-white'>Visible</strong>. Drag a field from Available into Visible to show it, or drag it back out to hide it. The top-to-bottom order in the Visible list sets the left-to-right order in your grid, so put the fields you glance at most near the top.", image: { src: `${IMG}/tradovate-market-analyzer-3.png`, alt: "Tradovate Market Analyzer Select Columns panel with Available and Visible field lists" } },
        { title: "Name and Save Your List", html: "Once the grid looks the way you want, save it. Click the <strong class='text-white'>drop-down arrow</strong> on the module and choose <strong class='text-white'>Name It</strong>, type a name like \"Index Futures\" or \"Metals,\" and save. Now you can build several named lists, one for the instruments you trade at the open, another for overnight, another for a specific setup, and switch between them in a click instead of rebuilding the grid every time.", image: { src: `${IMG}/tradovate-market-analyzer-4.png`, alt: "Tradovate Market Analyzer drop-down menu with the Name It option for saving a named instrument list" } },
        { title: "Color-Link the Scanner to Your Other Modules", html: "This is the part that makes the scanner earn its spot. Every module, Market Analyzer, Chart, DOM, Tick Stream, has a small <strong class='text-white'>color dropdown</strong> next to the instrument name in its tab. Assign the <strong class='text-white'>same color</strong> to the Market Analyzer and the modules you want it to drive. From then on, clicking a row in the scanner instantly loads that symbol into every module wearing the same color. You get up to six colors to build separate linked groups, and <strong class='text-white'>gray</strong> means a module is unlinked and won't follow along.", image: { src: `${IMG}/tradovate-market-analyzer-5.png`, alt: "Tradovate module tab color dropdown used to link the Market Analyzer to a chart and DOM" } },
      ],
    },
    { type: "heading", text: "Why Color Linking Is the Whole Point" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>One click, full context</strong>, select a symbol in the scanner and your linked chart and DOM jump to it, no retyping.",
        "<strong class='text-white'>Multiple groups at once</strong>, run a red group on your index futures and a green group on metals, each driving its own chart and DOM.",
        "<strong class='text-white'>Cleaner scanning</strong>, keep the scanner as your list-of-lists, and let the heavy modules react to it instead of cluttering the screen.",
        "<strong class='text-white'>Faster rotation</strong>, when a mover shows up in the grid, you're one click from a tradable chart and ladder.",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Scanning a watchlist is great for finding the trade. Placing it the instant your signal fires is where PickMyTrade comes in. <strong class='text-white'>Wire your TradingView alerts to your Tradovate account</strong> and every entry, stop, and target routes automatically, you spot the setup in the Market Analyzer, and the order goes in without you racing the mouse." },
  ], de: [
    { type: "paragraph",html: "Der Market Analyzer ist der Kurs-Scanner von Tradovate, ein Live-Raster, in dem Sie eine ganze Liste von Futures nebeneinander beobachten, statt zwischen Charts hin- und herzuspringen. Richten Sie ihn einmal ein, und Sie überblicken letzten Kurs, Nettoveränderung, Volumen und mehr für Ihre gesamte Watchlist. Mit einem Klick auf eine Zeile übergeben Sie das Symbol direkt an Ihren Chart und das DOM. So füllen und verknüpfen Sie ihn." },
    { type: "heading",text: "Was ist der Market Analyzer?" },
    { type: "paragraph",html: "Stellen Sie ihn sich als Ihre Kommandozentrale für Kurse vor. Jede Zeile ist ein Instrument, jede Spalte ein Datenfeld, und das Ganze aktualisiert sich in Echtzeit. Wenn Sie ihn schon unter seinem alten Namen, dem Quote Board, kennen: Es ist dasselbe Werkzeug. Der eigentliche Gewinn liegt in der Farbverknüpfung, die den Scanner in eine Fernbedienung für den Rest Ihres Arbeitsbereichs verwandelt. Bauen wir einen." },
    { type: "heading",text: "Den Market-Analyzer-Scanner einrichten: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Das Modul Market Analyzer öffnen", html: "Öffnen Sie das Menü <strong class='text-white'>New +</strong> oben links in der Plattform. Suchen Sie das Symbol <strong class='text-white'>Market Analyzer</strong>, ziehen Sie es in Ihren Arbeitsbereich und legen Sie es dort ab, wo es andocken soll. Es öffnet sich als leeres Raster, bereit für Symbole.", image: {"src":`${IMG}/tradovate-market-analyzer-1.png`,"alt":"Tradovate-Menü New + mit dem Modul Market Analyzer, das in den Arbeitsbereich gezogen wird"} },
        { title: "Ihre Instrumente hinzufügen", html: "Klicken Sie in die <strong class='text-white'>Suchleiste</strong> des Moduls und geben Sie ein Symbol oder Stichwort ein, ES, NQ, CL, GC, was immer Sie handeln. Wählen Sie aus den Ergebnissen den aktiven <strong class='text-white'>Front-Month-Kontrakt</strong>, und er erscheint als neue Zeile im Raster. Wiederholen Sie dies, bis Ihre gesamte Watchlist geladen ist. Zwei Dinge sind gut zu wissen: Fügen Sie den aktuellen Kontrakt statt eines fortlaufenden Symbols hinzu, damit Ihre Kurse auch über den Rollover hinweg live bleiben, und klicken Sie später mit der rechten Maustaste auf eine Zeile, wenn Sie sie entfernen oder eine weitere einfügen möchten.", image: {"src":`${IMG}/tradovate-market-analyzer-2.png`,"alt":"Suchleiste des Tradovate Market Analyzer, die ein Futures-Symbol als neue Zeile im Raster hinzufügt"} },
        { title: "Ihre Spalten auswählen", html: "Standardmäßig sehen Sie die Grundlagen, aber Sie entscheiden, was angezeigt wird. Klicken Sie auf das Zahnrad <strong class='text-white'>View Settings</strong> (oben rechts im Modul) und wählen Sie <strong class='text-white'>Select Columns</strong>. Sie erhalten zwei Listen, <strong class='text-white'>Available</strong> und <strong class='text-white'>Visible</strong>. Ziehen Sie ein Feld von Available nach Visible, um es anzuzeigen, oder wieder heraus, um es auszublenden. Die Reihenfolge von oben nach unten in der Liste Visible bestimmt die Reihenfolge von links nach rechts in Ihrem Raster. Setzen Sie die Felder, auf die Sie am häufigsten schauen, also nach oben.", image: {"src":`${IMG}/tradovate-market-analyzer-3.png`,"alt":"Bereich Select Columns des Tradovate Market Analyzer mit den Feldlisten Available und Visible"} },
        { title: "Ihre Liste benennen und speichern", html: "Sobald das Raster so aussieht, wie Sie es möchten, speichern Sie es. Klicken Sie auf den <strong class='text-white'>Dropdown-Pfeil</strong> des Moduls und wählen Sie <strong class='text-white'>Name It</strong>, geben Sie einen Namen wie „Index Futures“ oder „Metals“ ein und speichern Sie. Nun können Sie mehrere benannte Listen anlegen, eine für die Instrumente, die Sie zur Eröffnung handeln, eine für die Nacht, eine für ein bestimmtes Setup, und mit einem Klick zwischen ihnen wechseln, statt das Raster jedes Mal neu aufzubauen.", image: {"src":`${IMG}/tradovate-market-analyzer-4.png`,"alt":"Dropdown-Menü des Tradovate Market Analyzer mit der Option Name It zum Speichern einer benannten Instrumentenliste"} },
        { title: "Den Scanner per Farbe mit Ihren anderen Modulen verknüpfen", html: "Hier verdient sich der Scanner seinen Platz. Jedes Modul, Market Analyzer, Chart, DOM, Tick Stream, hat neben dem Instrumentennamen in seiner Registerkarte ein kleines <strong class='text-white'>Farb-Dropdown</strong>. Weisen Sie dem Market Analyzer und den Modulen, die er steuern soll, die <strong class='text-white'>gleiche Farbe</strong> zu. Von da an lädt ein Klick auf eine Zeile im Scanner das Symbol sofort in jedes Modul mit derselben Farbe. Sie haben bis zu sechs Farben, um getrennte verknüpfte Gruppen zu bilden, und <strong class='text-white'>Grau</strong> bedeutet, dass ein Modul nicht verknüpft ist und nicht mitläuft.", image: {"src":`${IMG}/tradovate-market-analyzer-5.png`,"alt":"Farb-Dropdown in der Modul-Registerkarte von Tradovate zur Verknüpfung des Market Analyzer mit Chart und DOM"} },
      ],
    },
    { type: "heading",text: "Warum die Farbverknüpfung der eigentliche Punkt ist" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Ein Klick, voller Kontext</strong>, wählen Sie ein Symbol im Scanner aus, und Ihr verknüpfter Chart und das DOM springen dorthin, ohne erneutes Eintippen.",
        "<strong class='text-white'>Mehrere Gruppen gleichzeitig</strong>, betreiben Sie eine rote Gruppe für Ihre Index-Futures und eine grüne für Metalle, die jeweils ihren eigenen Chart und ihr eigenes DOM steuern.",
        "<strong class='text-white'>Übersichtlicheres Scannen</strong>, nutzen Sie den Scanner als Ihre Liste der Listen und lassen Sie die schweren Module darauf reagieren, statt den Bildschirm zu überladen.",
        "<strong class='text-white'>Schnellere Rotation</strong>, sobald im Raster ein Mover auftaucht, sind Sie einen Klick von einem handelbaren Chart und einer Ladder entfernt.",
      ],
    },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "Eine Watchlist zu scannen ist ideal, um den Trade zu finden. Ihn in dem Moment zu platzieren, in dem Ihr Signal auslöst, ist die Aufgabe von PickMyTrade. <strong class='text-white'>Verbinden Sie Ihre TradingView-Alerts mit Ihrem Tradovate-Konto</strong>, und jeder Einstieg, Stopp und jedes Ziel wird automatisch geroutet: Sie erkennen das Setup im Market Analyzer, und die Order geht raus, ohne dass Sie gegen die Maus anrennen." },
  ], es: [
    { type: "paragraph",html: "El Market Analyzer es el escáner de cotizaciones de Tradovate, una cuadrícula en vivo donde observa una lista completa de futuros en paralelo en lugar de saltar entre gráficos. Configúrelo una vez y podrá revisar el último precio, el cambio neto, el volumen y más de toda su lista de seguimiento; después, haga clic en cualquier fila para enviar ese símbolo directamente a su gráfico y a su DOM. Así se llena y se conecta." },
    { type: "heading",text: "¿Qué es el Market Analyzer?" },
    { type: "paragraph",html: "Piense en él como su centro de mando de cotizaciones. Cada fila es un instrumento, cada columna es un campo de datos y todo se actualiza en tiempo real. Si ya lo usó con su nombre antiguo, Quote Board, es la misma herramienta. El verdadero beneficio llega con la vinculación por colores, que convierte el escáner en un mando a distancia para el resto de su espacio de trabajo. Vamos a construir uno." },
    { type: "heading",text: "Configure el escáner Market Analyzer: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra el módulo Market Analyzer", html: "Vaya al menú <strong class='text-white'>New +</strong> en la parte superior izquierda de la plataforma. Busque el icono de <strong class='text-white'>Market Analyzer</strong>, arrástrelo a su espacio de trabajo y suéltelo donde desee acoplarlo. Se abre como una cuadrícula vacía, lista para recibir símbolos.", image: {"src":`${IMG}/tradovate-market-analyzer-1.png`,"alt":"Menú New + de Tradovate con el módulo Market Analyzer arrastrado al espacio de trabajo"} },
        { title: "Añada sus instrumentos", html: "Haga clic en la <strong class='text-white'>barra de búsqueda</strong> del módulo y escriba un símbolo o una palabra clave, ES, NQ, CL, GC, lo que opere. Elija el <strong class='text-white'>contrato del mes frontal</strong> activo en los resultados y se añadirá a la cuadrícula como una nueva fila. Repita hasta cargar toda su lista de seguimiento. Un par de cosas que conviene saber: añada el contrato actual en lugar de un símbolo continuo para que sus cotizaciones sigan en vivo durante el rollover, y haga clic con el botón derecho en cualquier fila más adelante si desea eliminarla o insertar otra.", image: {"src":`${IMG}/tradovate-market-analyzer-2.png`,"alt":"Barra de búsqueda del Market Analyzer de Tradovate añadiendo un símbolo de futuros como nueva fila en la cuadrícula"} },
        { title: "Elija sus columnas", html: "De fábrica verá lo básico, pero usted decide qué se muestra. Haga clic en el engranaje <strong class='text-white'>View Settings</strong> (la rueda dentada en la parte superior derecha del módulo) y elija <strong class='text-white'>Select Columns</strong>. Verá dos listas, <strong class='text-white'>Available</strong> y <strong class='text-white'>Visible</strong>. Arrastre un campo de Available a Visible para mostrarlo, o sáquelo para ocultarlo. El orden de arriba abajo en la lista Visible determina el orden de izquierda a derecha en su cuadrícula, así que coloque arriba los campos que más consulta.", image: {"src":`${IMG}/tradovate-market-analyzer-3.png`,"alt":"Panel Select Columns del Market Analyzer de Tradovate con las listas de campos Available y Visible"} },
        { title: "Ponga nombre a su lista y guárdela", html: "Cuando la cuadrícula tenga el aspecto que desea, guárdela. Haga clic en la <strong class='text-white'>flecha desplegable</strong> del módulo y elija <strong class='text-white'>Name It</strong>, escriba un nombre como «Index Futures» o «Metals» y guarde. Ahora puede crear varias listas con nombre, una para los instrumentos que opera en la apertura, otra para la sesión nocturna, otra para una configuración concreta, y cambiar entre ellas con un clic en lugar de reconstruir la cuadrícula cada vez.", image: {"src":`${IMG}/tradovate-market-analyzer-4.png`,"alt":"Menú desplegable del Market Analyzer de Tradovate con la opción Name It para guardar una lista de instrumentos con nombre"} },
        { title: "Vincule el escáner por color a sus otros módulos", html: "Esta es la parte que justifica el escáner. Cada módulo, Market Analyzer, Chart, DOM, Tick Stream, tiene un pequeño <strong class='text-white'>desplegable de color</strong> junto al nombre del instrumento en su pestaña. Asigne el <strong class='text-white'>mismo color</strong> al Market Analyzer y a los módulos que desea que controle. A partir de ahí, al hacer clic en una fila del escáner se carga al instante ese símbolo en todos los módulos del mismo color. Dispone de hasta seis colores para crear grupos vinculados independientes, y el <strong class='text-white'>gris</strong> significa que un módulo no está vinculado y no seguirá los cambios.", image: {"src":`${IMG}/tradovate-market-analyzer-5.png`,"alt":"Desplegable de color en la pestaña de un módulo de Tradovate para vincular el Market Analyzer con un gráfico y el DOM"} },
      ],
    },
    { type: "heading",text: "Por qué la vinculación por colores es lo fundamental" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Un clic, contexto completo</strong>, seleccione un símbolo en el escáner y su gráfico y su DOM vinculados saltan a él, sin volver a escribirlo.",
        "<strong class='text-white'>Varios grupos a la vez</strong>, mantenga un grupo rojo para sus futuros de índices y uno verde para metales, cada uno controlando su propio gráfico y DOM.",
        "<strong class='text-white'>Escaneo más limpio</strong>, use el escáner como su lista de listas y deje que los módulos pesados reaccionen a él en lugar de saturar la pantalla.",
        "<strong class='text-white'>Rotación más rápida</strong>, cuando aparece un valor en movimiento en la cuadrícula, está a un clic de un gráfico y una escalera operables.",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Escanear una lista de seguimiento es ideal para encontrar la operación. Colocarla en el instante en que se dispara su señal es donde entra PickMyTrade. <strong class='text-white'>Conecte sus alertas de TradingView con su cuenta de Tradovate</strong> y cada entrada, stop y objetivo se enruta automáticamente: usted detecta la configuración en el Market Analyzer y la orden entra sin que tenga que correr tras el ratón." },
  ], fr: [
    { type: "paragraph",html: "Le Market Analyzer est le scanner de cotations de Tradovate, une grille en direct où vous suivez côte à côte toute une liste de contrats à terme au lieu de passer d'un graphique à l'autre. Configurez-le une fois et vous pouvez parcourir du regard le dernier cours, la variation nette, le volume et bien plus sur l'ensemble de votre liste de suivi, puis cliquer sur n'importe quelle ligne pour envoyer ce symbole directement vers votre graphique et votre DOM. Voici comment le remplir et le connecter." },
    { type: "heading",text: "Qu'est-ce que le Market Analyzer ?" },
    { type: "paragraph",html: "Voyez-le comme votre centre de commande des cotations. Chaque ligne est un instrument, chaque colonne un champ de données, et l'ensemble se met à jour en temps réel. Si vous l'avez déjà utilisé sous son ancien nom, Quote Board, c'est le même outil. Le véritable avantage vient du lien par couleur, qui transforme le scanner en télécommande pour le reste de votre espace de travail. Construisons-en un." },
    { type: "heading",text: "Configurer le scanner Market Analyzer : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir le module Market Analyzer", html: "Rendez-vous dans le menu <strong class='text-white'>New +</strong> en haut à gauche de la plateforme. Repérez l'icône <strong class='text-white'>Market Analyzer</strong>, puis faites-la glisser dans votre espace de travail et déposez-la à l'endroit où vous souhaitez l'ancrer. Il s'ouvre sous forme de grille vide, prête à recevoir des symboles.", image: {"src":`${IMG}/tradovate-market-analyzer-1.png`,"alt":"Menu New + de Tradovate avec le module Market Analyzer glissé dans l'espace de travail"} },
        { title: "Ajouter vos instruments", html: "Cliquez dans la <strong class='text-white'>barre de recherche</strong> du module et saisissez un symbole ou un mot-clé, ES, NQ, CL, GC, ce que vous tradez. Sélectionnez le <strong class='text-white'>contrat du mois rapproché</strong> actif dans les résultats et il s'ajoute à la grille sous forme de nouvelle ligne. Répétez jusqu'à ce que toute votre liste de suivi soit chargée. Deux points à connaître : ajoutez le contrat en cours plutôt qu'un symbole continu pour que vos cotations restent en direct lors du roulement, et faites un clic droit sur une ligne plus tard pour la supprimer ou en insérer une autre.", image: {"src":`${IMG}/tradovate-market-analyzer-2.png`,"alt":"Barre de recherche du Market Analyzer de Tradovate ajoutant un symbole de contrat à terme comme nouvelle ligne de la grille"} },
        { title: "Choisir vos colonnes", html: "Par défaut, vous voyez l'essentiel, mais c'est vous qui décidez de ce qui s'affiche. Cliquez sur l'engrenage <strong class='text-white'>View Settings</strong> (la roue dentée en haut à droite du module) et choisissez <strong class='text-white'>Select Columns</strong>. Vous obtenez deux listes, <strong class='text-white'>Available</strong> et <strong class='text-white'>Visible</strong>. Faites glisser un champ de Available vers Visible pour l'afficher, ou hors de la liste pour le masquer. L'ordre de haut en bas dans la liste Visible détermine l'ordre de gauche à droite dans votre grille ; placez donc en haut les champs que vous consultez le plus.", image: {"src":`${IMG}/tradovate-market-analyzer-3.png`,"alt":"Panneau Select Columns du Market Analyzer de Tradovate avec les listes de champs Available et Visible"} },
        { title: "Nommer et enregistrer votre liste", html: "Une fois la grille telle que vous la souhaitez, enregistrez-la. Cliquez sur la <strong class='text-white'>flèche du menu déroulant</strong> du module et choisissez <strong class='text-white'>Name It</strong>, saisissez un nom comme « Index Futures » ou « Metals », puis enregistrez. Vous pouvez désormais créer plusieurs listes nommées, une pour les instruments que vous tradez à l'ouverture, une autre pour la nuit, une autre pour une configuration précise, et passer de l'une à l'autre en un clic au lieu de reconstruire la grille à chaque fois.", image: {"src":`${IMG}/tradovate-market-analyzer-4.png`,"alt":"Menu déroulant du Market Analyzer de Tradovate avec l'option Name It pour enregistrer une liste d'instruments nommée"} },
        { title: "Lier le scanner par couleur à vos autres modules", html: "C'est ce qui justifie la présence du scanner. Chaque module, Market Analyzer, Chart, DOM, Tick Stream, possède une petite <strong class='text-white'>liste déroulante de couleur</strong> à côté du nom de l'instrument dans son onglet. Attribuez la <strong class='text-white'>même couleur</strong> au Market Analyzer et aux modules que vous voulez lui faire piloter. Dès lors, un clic sur une ligne du scanner charge instantanément ce symbole dans tous les modules de la même couleur. Vous disposez de jusqu'à six couleurs pour créer des groupes liés distincts, et le <strong class='text-white'>gris</strong> signifie qu'un module n'est pas lié et ne suivra pas.", image: {"src":`${IMG}/tradovate-market-analyzer-5.png`,"alt":"Liste déroulante de couleur dans l'onglet d'un module Tradovate pour lier le Market Analyzer à un graphique et au DOM"} },
