  ctaHeading: { en: "Stop Racing the Mouse", de: "Schluss mit dem Wettlauf gegen die Maus", es: "Deje de correr tras el ratón", fr: "Cessez de courir après la souris", it: "Smetta di rincorrere il mouse" },
