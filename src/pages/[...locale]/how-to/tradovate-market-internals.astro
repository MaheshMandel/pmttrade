---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-market-internals";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Chart Market Internals: TICK, TVOL & DVOL";
const META_DESCRIPTION =
  "Chart TICK, TVOL, UVOL and DVOL market internals to read NYSE breadth and time index-futures entries with real-time market context.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Marktinternals im Chart: TICK, TVOL & DVOL", es: "Gráfico de Market Internals: TICK, TVOL y DVOL", fr: "Graphique des Market Internals : TICK, TVOL et DVOL", it: "Grafico dei Market Internals: TICK, TVOL e DVOL" },
  dek: { en: "If you trade index futures like ES or NQ, the futures chart tells you only half the story. Here's how to turn on the market-internals feed and get TICK, TVOL, UVOL, and DVOL on a chart in about two minutes.", de: "Wenn Sie Index-Futures wie ES oder NQ handeln, erzählt Ihnen der Futures-Chart nur die halbe Geschichte. So aktivieren Sie den Market-Internals-Feed und bringen TICK, TVOL, UVOL und DVOL in etwa zwei Minuten auf einen Chart.", es: "Si opera futuros de índices como ES o NQ, el gráfico de futuros solo le cuenta la mitad de la historia. Así se activa el feed de market internals y se muestran TICK, TVOL, UVOL y DVOL en un gráfico en unos dos minutos.", fr: "Si vous tradez des contrats à terme sur indices comme l’ES ou le NQ, le graphique des futures ne vous raconte que la moitié de l’histoire. Voici comment activer le flux de market internals et afficher TICK, TVOL, UVOL et DVOL sur un graphique en environ deux minutes.", it: "Se opera sui futures degli indici come ES o NQ, il grafico dei futures le racconta solo metà della storia. Ecco come attivare il feed dei market internals e visualizzare TICK, TVOL, UVOL e DVOL su un grafico in circa due minuti." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-10",
  blocks: { en: [
    { type: "paragraph", html: "If you trade index futures like ES or NQ, the futures chart tells you only half the story. Market internals, TICK, TVOL, UVOL, and DVOL, show what the broader stock market is doing underneath the index. When breadth pushes hard one way, your setup has the wind at its back; when it's split, that \"clean\" breakout is far more likely to fail. Tradovate carries these feeds, and once you know where to switch them on, getting one on a chart takes about two minutes." },
    { type: "heading", text: "What Are Market Internals in Tradovate?" },
    { type: "paragraph", html: "Market internals measure the internal health of the stock market, how many stocks are rising versus falling, and how much volume sits behind each side. They're pulled from the underlying NYSE-listed stocks, not from the futures contract itself, so they read the market in a way the ES chart alone can't. The four you'll lean on most:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>^TICK</strong>, NYSE stocks on an uptick minus those on a downtick, right now. Big positive spikes mean broad buying; deep negatives mean broad selling.",
        "<strong class='text-white'>^TVOL</strong>, total volume across every issue on the exchange for the session. A gauge of how much participation is behind the day's move.",
        "<strong class='text-white'>^UVOL</strong>, up (advancing) volume: the combined volume of every stock trading higher on the day.",
        "<strong class='text-white'>^DVOL</strong>, down (declining) volume: the combined volume of every stock trading lower.",
      ],
    },
    { type: "paragraph", html: "Read UVOL against DVOL and you see which side is winning on volume. Note the caret (<code>^</code>) prefix, that's how Tradovate flags an index or internal symbol rather than a tradable contract. You can't buy or sell these; they're context only. The ticker list can shift over time, so if a symbol doesn't resolve in the search bar, confirm the current spelling in the platform." },
    { type: "heading", text: "How to Chart Market Internals in Tradovate: Step by Step" },
    {
      type: "steps",
      items: [
        { title: "Turn On the Market-Internals Data Feed", html: "Internals ride on their own data subscription, so switch that on first. Open <strong class='text-white'>Application Settings</strong>, go to the <strong class='text-white'>Subscriptions</strong> tab, find the <strong class='text-white'>Market Data</strong> section, and subscribe to the indices feed that carries the internals, Tradovate groups these under a <strong class='text-white'>Dow Jones &amp; Key Indices</strong> package. Data pricing varies by account type and firm, so check what your plan covers first." },
        { title: "Open a Chart Module", html: "Back in your workspace, click the <strong class='text-white'>+ (New)</strong> button in the top-left and drop a <strong class='text-white'>Chart</strong> module where you want it. Already have a chart open? Just add a new tab inside it instead of opening a whole new module." },
        { title: "Load an Internals Symbol", html: "Click into the chart's <strong class='text-white'>search bar</strong> and type the internal you want, start with <code>^TICK</code>. Pick it from the results and the chart redraws as a running TICK line. TICK works best on a short interval, like a 1-minute chart, since the whole point is watching it swing in real time." },
        { title: "Chart TVOL, UVOL, and DVOL", html: "Run the same search for <code>^TVOL</code>, <code>^UVOL</code>, and <code>^DVOL</code>, each in its own chart or tab, using line style. Tradovate charts each internal on its own, there's no built-in symbol that subtracts DVOL from UVOL into a single net-volume line, so put UVOL and DVOL next to each other and watch the gap between them widen or flip as the session runs." },
      ],
    },
    { type: "heading", text: "Quick Symbol Reference" },
    {
      type: "table",
      headers: ["Symbol", "What it shows", "How you'd read it"],
      rows: [
        ["^TICK", "NYSE upticks minus downticks, live", "Spikes past +/-800 to +/-1000 flag breadth extremes and stretched moves"],
        ["^TVOL", "Total exchange volume for the session", "Confirms whether real participation backs the move"],
        ["^UVOL", "Advancing (up) volume", "Rising far above DVOL = buyers in control"],
        ["^DVOL", "Declining (down) volume", "Rising far above UVOL = sellers in control"],
      ],
    },
    { type: "paragraph", html: "Tradovate carries a few more internals in the same feed, an Arms Index (TRIN) and advancing/declining issue counts among them, though availability differs across web, desktop, and mobile. If you rely on a specific one, confirm it loads on the app you trade from." },
    { type: "heading", text: "Why You'd Bother with Internals" },
    {
      type: "list",
      items: [
        "Confirm an ES or NQ breakout with broad-market breadth instead of trusting price alone.",
        "Spot exhaustion, a TICK spike into an extreme while price stalls often marks a turn.",
        "Judge conviction: a rally on thin UVOL is a different trade than one on heavy UVOL.",
        "Filter out chop on days when breadth keeps flipping and there's no real edge.",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Internals sharpen your read, but you still have to act before the move gets away. <strong class='text-white'>PickMyTrade wires your TradingView alerts straight into your Tradovate account</strong>, so once your breadth-confirmed setup triggers, the order fires automatically, no scramble to click. You keep watching the tape; the execution takes care of itself." },
  ], de: [
    { type: "paragraph",html: "Wenn Sie Index-Futures wie ES oder NQ handeln, erzählt Ihnen der Futures-Chart nur die halbe Geschichte. Market Internals, also TICK, TVOL, UVOL und DVOL, zeigen, was der breite Aktienmarkt unter dem Index tatsächlich macht. Wenn die Marktbreite kräftig in eine Richtung drückt, hat Ihr Setup Rückenwind; ist sie gespalten, scheitert dieser „saubere“ Ausbruch deutlich wahrscheinlicher. Tradovate bietet diese Feeds an, und wenn Sie wissen, wo Sie sie einschalten, ist ein Chart in etwa zwei Minuten eingerichtet." },
    { type: "heading",text: "Was sind Market Internals in Tradovate?" },
    { type: "paragraph",html: "Market Internals messen die innere Verfassung des Aktienmarkts: wie viele Aktien steigen im Vergleich zu fallenden und wie viel Volumen auf jeder Seite steht. Sie werden aus den zugrunde liegenden NYSE-Aktien gezogen, nicht aus dem Futures-Kontrakt selbst, und zeigen den Markt daher auf eine Weise, die der ES-Chart allein nicht kann. Die vier wichtigsten:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>^TICK</strong>, NYSE-Aktien mit Aufwärts-Tick minus jene mit Abwärts-Tick, aktuell. Große positive Ausschläge bedeuten breite Käufe, tiefe negative breite Verkäufe.",
        "<strong class='text-white'>^TVOL</strong>, Gesamtvolumen über alle Titel der Börse in der Sitzung. Ein Maß dafür, wie viel Beteiligung hinter der Tagesbewegung steht.",
        "<strong class='text-white'>^UVOL</strong>, Aufwärtsvolumen (steigende Titel): das kombinierte Volumen aller Aktien, die an diesem Tag höher handeln.",
        "<strong class='text-white'>^DVOL</strong>, Abwärtsvolumen (fallende Titel): das kombinierte Volumen aller Aktien, die an diesem Tag tiefer handeln.",
      ],
    },
    { type: "paragraph",html: "Lesen Sie UVOL im Vergleich zu DVOL, und Sie sehen, welche Seite beim Volumen die Oberhand hat. Beachten Sie das Caret-Präfix (<code>^</code>): So kennzeichnet Tradovate ein Index- oder Internals-Symbol statt eines handelbaren Kontrakts. Sie können diese nicht kaufen oder verkaufen; sie dienen nur dem Kontext. Die Ticker-Liste kann sich mit der Zeit ändern. Wenn ein Symbol in der Suchleiste nicht aufgelöst wird, prüfen Sie die aktuelle Schreibweise in der Plattform." },
    { type: "heading",text: "Market Internals in Tradovate charten: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Den Market-Internals-Datenfeed aktivieren", html: "Internals laufen über ein eigenes Datenabonnement, schalten Sie es also zuerst ein. Öffnen Sie <strong class='text-white'>Application Settings</strong>, wechseln Sie zum Tab <strong class='text-white'>Subscriptions</strong>, suchen Sie den Bereich <strong class='text-white'>Market Data</strong> und abonnieren Sie den Indizes-Feed, der die Internals enthält. Tradovate fasst diese in einem Paket namens <strong class='text-white'>Dow Jones &amp; Key Indices</strong> zusammen. Die Datenpreise variieren je nach Kontotyp und Firma; prüfen Sie daher zuerst, was Ihr Tarif abdeckt." },
        { title: "Ein Chart-Modul öffnen", html: "Klicken Sie zurück in Ihrem Workspace oben links auf die Schaltfläche <strong class='text-white'>+ (New)</strong> und platzieren Sie ein <strong class='text-white'>Chart</strong>-Modul an der gewünschten Stelle. Haben Sie bereits einen Chart geöffnet? Fügen Sie dann einfach einen neuen Tab darin hinzu, statt ein ganzes neues Modul zu öffnen." },
        { title: "Ein Internals-Symbol laden", html: "Klicken Sie in die <strong class='text-white'>Suchleiste</strong> des Charts und geben Sie das gewünschte Internal ein, beginnen Sie mit <code>^TICK</code>. Wählen Sie es aus den Ergebnissen aus, und der Chart wird als laufende TICK-Linie neu gezeichnet. TICK funktioniert am besten in einem kurzen Intervall, etwa einem 1-Minuten-Chart, da es gerade darum geht, die Ausschläge in Echtzeit zu beobachten." },
        { title: "TVOL, UVOL und DVOL charten", html: "Führen Sie dieselbe Suche für <code>^TVOL</code>, <code>^UVOL</code> und <code>^DVOL</code> durch, jeweils in einem eigenen Chart oder Tab, im Linienstil. Tradovate stellt jedes Internal einzeln dar; es gibt kein eingebautes Symbol, das DVOL von UVOL zu einer einzigen Netto-Volumen-Linie subtrahiert. Legen Sie also UVOL und DVOL nebeneinander und beobachten Sie, wie sich der Abstand zwischen beiden im Sitzungsverlauf vergrößert oder umkehrt." },
      ],
    },
    { type: "heading",text: "Kurzübersicht der Symbole" },
    { type: "table", headers: ["Symbol","Was es zeigt","Wie Sie es lesen"], rows: [
      ["^TICK","NYSE-Aufwärts-Ticks minus Abwärts-Ticks, live","Ausschläge über +/-800 bis +/-1000 markieren Extreme der Marktbreite und überdehnte Bewegungen"],
      ["^TVOL","Gesamtbörsenvolumen der Sitzung","Bestätigt, ob echte Beteiligung die Bewegung stützt"],
      ["^UVOL","Aufwärtsvolumen (steigende Titel)","Deutlich über DVOL steigend = Käufer haben die Kontrolle"],
      ["^DVOL","Abwärtsvolumen (fallende Titel)","Deutlich über UVOL steigend = Verkäufer haben die Kontrolle"],
    ] },
    { type: "paragraph",html: "Tradovate bietet im selben Feed noch einige weitere Internals an, darunter einen Arms Index (TRIN) und die Anzahl steigender/fallender Titel, wobei die Verfügbarkeit zwischen Web, Desktop und Mobile variiert. Wenn Sie sich auf ein bestimmtes verlassen, prüfen Sie, ob es in der App lädt, mit der Sie handeln." },
    { type: "heading",text: "Warum sich der Aufwand mit Internals lohnt" },
    {
      type: "list",
      items: [
        "Bestätigen Sie einen ES- oder NQ-Ausbruch mit der breiten Marktbreite, statt allein dem Preis zu vertrauen.",
        "Erkennen Sie Erschöpfung: Ein TICK-Ausschlag in ein Extrem, während der Preis stockt, markiert oft eine Wende.",
        "Beurteilen Sie die Überzeugung: Ein Anstieg bei dünnem UVOL ist ein anderer Trade als einer bei hohem UVOL.",
        "Filtern Sie Seitwärtsphasen heraus, an Tagen, an denen die Marktbreite ständig kippt und kein echter Vorteil besteht.",
      ],
    },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "Internals schärfen Ihre Einschätzung, aber Sie müssen handeln, bevor die Bewegung davonläuft. <strong class='text-white'>PickMyTrade verbindet Ihre TradingView-Alerts direkt mit Ihrem Tradovate-Konto</strong>, sodass die Order automatisch ausgelöst wird, sobald Ihr durch die Marktbreite bestätigtes Setup eintritt, ohne hektisches Klicken. Sie beobachten weiter den Markt; die Ausführung erledigt sich von selbst." },
  ], es: [
    { type: "paragraph",html: "Si opera futuros de índices como ES o NQ, el gráfico de futuros solo le cuenta la mitad de la historia. Los market internals, TICK, TVOL, UVOL y DVOL, muestran qué está haciendo el mercado bursátil en general por debajo del índice. Cuando la amplitud empuja con fuerza en una dirección, su configuración tiene el viento a favor; cuando está dividida, esa ruptura «limpia» tiene muchas más probabilidades de fallar. Tradovate ofrece estos feeds y, una vez que sabe dónde activarlos, mostrar uno en un gráfico lleva unos dos minutos." },
    { type: "heading",text: "¿Qué son los market internals en Tradovate?" },
    { type: "paragraph",html: "Los market internals miden la salud interna del mercado bursátil: cuántas acciones suben frente a cuántas bajan y cuánto volumen respalda a cada lado. Se obtienen de las acciones subyacentes cotizadas en la NYSE, no del contrato de futuros en sí, por lo que leen el mercado de una manera que el gráfico de ES por sí solo no puede. Los cuatro en los que más se apoyará:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>^TICK</strong>, acciones de la NYSE con un uptick menos las que tienen un downtick, en este momento. Grandes picos positivos significan compras generalizadas; fuertes valores negativos, ventas generalizadas.",
        "<strong class='text-white'>^TVOL</strong>, volumen total de todos los valores de la bolsa en la sesión. Un indicador de cuánta participación respalda el movimiento del día.",
        "<strong class='text-white'>^UVOL</strong>, volumen alcista (de acciones al alza): el volumen combinado de todas las acciones que cotizan al alza en el día.",
        "<strong class='text-white'>^DVOL</strong>, volumen bajista (de acciones a la baja): el volumen combinado de todas las acciones que cotizan a la baja.",
      ],
    },
    { type: "paragraph",html: "Lea UVOL frente a DVOL y verá qué lado gana en volumen. Fíjese en el prefijo de acento circunflejo (<code>^</code>): así señala Tradovate un símbolo de índice o interno en lugar de un contrato negociable. No puede comprar ni vender estos símbolos; solo sirven de contexto. La lista de tickers puede cambiar con el tiempo, así que, si un símbolo no se resuelve en la barra de búsqueda, confirme la grafía actual en la plataforma." },
    { type: "heading",text: "Cómo graficar los market internals en Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Active el feed de datos de market internals", html: "Los internals viajan en su propia suscripción de datos, así que actívela primero. Abra <strong class='text-white'>Application Settings</strong>, vaya a la pestaña <strong class='text-white'>Subscriptions</strong>, busque la sección <strong class='text-white'>Market Data</strong> y suscríbase al feed de índices que incluye los internals; Tradovate los agrupa en un paquete llamado <strong class='text-white'>Dow Jones &amp; Key Indices</strong>. El precio de los datos varía según el tipo de cuenta y la firma, así que compruebe primero qué cubre su plan." },
        { title: "Abra un módulo de gráfico", html: "De vuelta en su espacio de trabajo, haga clic en el botón <strong class='text-white'>+ (New)</strong> de la esquina superior izquierda y coloque un módulo <strong class='text-white'>Chart</strong> donde desee. ¿Ya tiene un gráfico abierto? Simplemente añada una nueva pestaña dentro de él en lugar de abrir un módulo nuevo." },
        { title: "Cargue un símbolo de internals", html: "Haga clic en la <strong class='text-white'>barra de búsqueda</strong> del gráfico y escriba el internal que desea; empiece con <code>^TICK</code>. Selecciónelo en los resultados y el gráfico se redibujará como una línea de TICK en curso. TICK funciona mejor en un intervalo corto, como un gráfico de 1 minuto, ya que la idea es ver sus oscilaciones en tiempo real." },
        { title: "Grafique TVOL, UVOL y DVOL", html: "Realice la misma búsqueda para <code>^TVOL</code>, <code>^UVOL</code> y <code>^DVOL</code>, cada uno en su propio gráfico o pestaña, con estilo de línea. Tradovate grafica cada internal por separado; no hay ningún símbolo integrado que reste DVOL de UVOL en una única línea de volumen neto, así que coloque UVOL y DVOL uno junto al otro y observe cómo la brecha entre ambos se amplía o se invierte a lo largo de la sesión." },
      ],
    },
    { type: "heading",text: "Referencia rápida de símbolos" },
    { type: "table", headers: ["Símbolo","Qué muestra","Cómo se interpreta"], rows: [
      ["^TICK","Upticks menos downticks de la NYSE, en vivo","Picos por encima de +/-800 a +/-1000 señalan extremos de amplitud y movimientos sobreextendidos"],
      ["^TVOL","Volumen total de la bolsa en la sesión","Confirma si hay participación real detrás del movimiento"],
      ["^UVOL","Volumen alcista (de acciones al alza)","Muy por encima de DVOL = los compradores tienen el control"],
      ["^DVOL","Volumen bajista (de acciones a la baja)","Muy por encima de UVOL = los vendedores tienen el control"],
    ] },
    { type: "paragraph",html: "Tradovate ofrece algunos internals más en el mismo feed, entre ellos un Arms Index (TRIN) y recuentos de valores al alza/a la baja, aunque la disponibilidad varía entre web, escritorio y móvil. Si depende de uno en concreto, confirme que carga en la aplicación desde la que opera." },
    { type: "heading",text: "Por qué vale la pena usar los internals" },
    {
      type: "list",
      items: [
        "Confirme una ruptura de ES o NQ con la amplitud del mercado general en lugar de fiarse solo del precio.",
        "Detecte agotamiento: un pico de TICK hacia un extremo mientras el precio se estanca suele marcar un giro.",
        "Mida la convicción: un rally con UVOL escaso es un trade distinto a uno con UVOL elevado.",
        "Filtre el ruido lateral en los días en que la amplitud cambia constantemente y no hay una ventaja real.",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Los internals afinan su lectura, pero aún debe actuar antes de que el movimiento se escape. <strong class='text-white'>PickMyTrade conecta sus alertas de TradingView directamente con su cuenta de Tradovate</strong>, de modo que, en cuanto se active su configuración confirmada por la amplitud, la orden se envía automáticamente, sin apresurarse a hacer clic. Usted sigue observando el mercado; la ejecución se encarga sola." },
  ], fr: [
    { type: "paragraph",html: "Si vous tradez des contrats à terme sur indices comme l’ES ou le NQ, le graphique des futures ne vous raconte que la moitié de l’histoire. Les market internals, TICK, TVOL, UVOL et DVOL, montrent ce que fait réellement le marché actions sous l’indice. Lorsque la largeur du marché pousse fortement dans un sens, votre configuration a le vent dans le dos ; lorsqu’elle est partagée, cette cassure « propre » a beaucoup plus de chances d’échouer. Tradovate propose ces flux, et une fois que vous savez où les activer, en afficher un sur un graphique prend environ deux minutes." },
    { type: "heading",text: "Que sont les market internals dans Tradovate ?" },
    { type: "paragraph",html: "Les market internals mesurent la santé interne du marché actions : combien d’actions montent par rapport à celles qui baissent, et quel volume se trouve derrière chaque camp. Ils sont tirés des actions sous-jacentes cotées au NYSE, et non du contrat à terme lui-même ; ils lisent donc le marché d’une manière que le seul graphique de l’ES ne peut pas offrir. Les quatre sur lesquels vous vous appuierez le plus :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>^TICK</strong>, actions du NYSE en uptick moins celles en downtick, à l’instant. De grands pics positifs signifient des achats généralisés ; des valeurs profondément négatives, des ventes généralisées.",
        "<strong class='text-white'>^TVOL</strong>, volume total de tous les titres de la bourse sur la séance. Un indicateur de la participation qui soutient le mouvement du jour.",
        "<strong class='text-white'>^UVOL</strong>, volume haussier (des titres en hausse) : le volume cumulé de toutes les actions qui progressent sur la journée.",
        "<strong class='text-white'>^DVOL</strong>, volume baissier (des titres en baisse) : le volume cumulé de toutes les actions qui reculent sur la journée.",
      ],
    },
    { type: "paragraph",html: "Lisez UVOL par rapport à DVOL et vous voyez quel camp l’emporte en volume. Notez le préfixe en accent circonflexe (<code>^</code>) : c’est ainsi que Tradovate signale un symbole d’indice ou d’internals plutôt qu’un contrat négociable. Vous ne pouvez ni les acheter ni les vendre ; ils ne servent que de contexte. La liste des tickers peut évoluer avec le temps ; si un symbole ne se résout pas dans la barre de recherche, vérifiez son orthographe actuelle dans la plateforme." },
    { type: "heading",text: "Comment afficher les market internals dans Tradovate : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Activer le flux de données des market internals", html: "Les internals reposent sur leur propre abonnement de données ; activez-le donc en premier. Ouvrez <strong class='text-white'>Application Settings</strong>, allez dans l’onglet <strong class='text-white'>Subscriptions</strong>, trouvez la section <strong class='text-white'>Market Data</strong> et abonnez-vous au flux d’indices qui contient les internals ; Tradovate les regroupe dans un forfait intitulé <strong class='text-white'>Dow Jones &amp; Key Indices</strong>. Les tarifs des données varient selon le type de compte et la société ; vérifiez d’abord ce que couvre votre forfait." },
        { title: "Ouvrir un module Chart", html: "De retour dans votre espace de travail, cliquez sur le bouton <strong class='text-white'>+ (New)</strong> en haut à gauche et déposez un module <strong class='text-white'>Chart</strong> à l’endroit souhaité. Vous avez déjà un graphique ouvert ? Ajoutez simplement un nouvel onglet à l’intérieur plutôt que d’ouvrir un module entier." },
        { title: "Charger un symbole d’internals", html: "Cliquez dans la <strong class='text-white'>barre de recherche</strong> du graphique et saisissez l’internal souhaité, en commençant par <code>^TICK</code>. Sélectionnez-le dans les résultats et le graphique se redessine sous la forme d’une ligne TICK en continu. Le TICK fonctionne mieux sur un intervalle court, comme un graphique à 1 minute, puisque tout l’intérêt est de suivre ses oscillations en temps réel." },
        { title: "Afficher TVOL, UVOL et DVOL", html: "Effectuez la même recherche pour <code>^TVOL</code>, <code>^UVOL</code> et <code>^DVOL</code>, chacun dans son propre graphique ou onglet, en style ligne. Tradovate affiche chaque internal séparément ; il n’existe aucun symbole intégré qui soustrait DVOL à UVOL en une seule ligne de volume net. Placez donc UVOL et DVOL côte à côte et observez l’écart entre les deux s’élargir ou s’inverser au fil de la séance." },
      ],
    },
    { type: "heading",text: "Référence rapide des symboles" },
    { type: "table", headers: ["Symbole","Ce qu’il montre","Comment le lire"], rows: [
      ["^TICK","Upticks moins downticks du NYSE, en direct","Des pics au-delà de +/-800 à +/-1000 signalent des extrêmes de largeur de marché et des mouvements étirés"],
      ["^TVOL","Volume total de la bourse sur la séance","Confirme si une vraie participation soutient le mouvement"],
      ["^UVOL","Volume haussier (des titres en hausse)","Nettement au-dessus de DVOL = les acheteurs ont le contrôle"],
      ["^DVOL","Volume baissier (des titres en baisse)","Nettement au-dessus de UVOL = les vendeurs ont le contrôle"],
