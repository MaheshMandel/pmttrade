---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-commission-rates";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Tradovate Commission Rates: Micros vs Minis";
const META_DESCRIPTION =
  "Tradovate commission rates explained: compare per-side pricing for micro vs standard futures contracts across every plan and see your all-in cost.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate-Kommissionssätze: Micros vs. Minis", es: "Comisiones de Tradovate: micros vs minis", fr: "Commissions Tradovate : micros vs minis", it: "Commissioni Tradovate: micro vs mini" },
  dek: { en: "Want to know exactly what each Tradovate trade costs you? Here's how the commission rates for micro and standard futures contracts break down, plan by plan.", de: "Sie möchten genau wissen, was jeder Tradovate-Trade kostet? So setzen sich die Kommissionssätze für Micro- und Standard-Futures-Kontrakte zusammen, Tarif für Tarif.", es: "¿Quiere saber exactamente cuánto le cuesta cada operación en Tradovate? Así se desglosan las comisiones de los contratos de futuros micro y estándar, plan por plan.", fr: "Vous voulez savoir exactement ce que coûte chaque trade chez Tradovate ? Voici le détail des commissions pour les contrats à terme micro et standard, forfait par forfait.", it: "Vuole sapere esattamente quanto Le costa ogni trade su Tradovate? Ecco come si articolano le commissioni per i contratti futures micro e standard, piano per piano." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Want to know exactly what each Tradovate trade costs you? Whether you're weighing up plans, budgeting a scalping strategy, or wiring your alerts into automation like PickMyTrade, this guide breaks down Tradovate's commission rates for micro and standard (mini) futures contracts, plan by plan." },
    { type: "heading", text: "What Are Tradovate Commission Rates?" },
    { type: "paragraph", html: "Tradovate charges a flat, per-side commission every time you enter or exit a futures contract. Two things set that rate: your membership plan and your contract size (micro versus standard/mini). Exchange, clearing, and NFA fees get billed separately on top, so your true cost always lands a little higher than the commission by itself." },
    { type: "heading", text: "Finding Your Tradovate Commission Rate: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Identify Your Membership Plan", html: "Tradovate sells its brokerage on three membership tiers, and each one comes with its own commission schedule. As of July 2026, those tiers are the Free plan ($0/month), the Monthly plan ($99/month), and the Lifetime plan (a one-time $1,499, or four installments of $499). Nail down which plan you're on before you read any rate. A Free-plan trader and a Lifetime member pay very different commissions on the exact same trade." },
        { title: "Read the Per-Side Rate for Your Contract Type", html: "Micro contracts like MES or MNQ are cheaper per side than standard/mini contracts like ES or NQ. And because the commission hits <em>per side</em>, a full round turn, one entry plus one exit, runs you roughly double the figure in the table below. Tradovate lists even lower per-side rates for nano and event contracts too. These numbers are current as of July 2026 and they do change, so pull up Tradovate's official pricing page and confirm the live figures before you calculate a strategy's cost." },
        { title: "Add Exchange, NFA, and Clearing Fees", html: "The commission is only half the story. Every fill also carries exchange fees (set by the CME and other exchanges), a small NFA regulatory fee, and clearing fees. Tradovate doesn't set these pass-through fees, they apply on every plan, and they get revised from time to time, so treat them as their own line item and check the current schedule instead of memorizing a dollar amount. Commission plus these fees is what makes up your \"all-in\" rate." },
        { title: "Verify the Actual Charge on Your Fills", html: "Don't take the estimate on faith, check what you were actually billed. Open your Orders/Fills report or account statement in Tradovate and look at the commission column next to each execution. This is also where prop-firm traders will spot that their evaluation or funded account runs on the firm's own commission schedule, which varies by firm and plan. Check your firm's current rules rather than assuming the retail rates above apply." },
      ],
    },
    { type: "table", headers: ["Plan", "Membership cost", "Micro (per side)", "Standard / mini (per side)"], rows: [
      ["Free", "$0 / month", "$0.39", "$1.29"],
      ["Monthly", "$99 / month", "$0.29", "$0.99"],
      ["Lifetime", "$1,499 one-time", "$0.09", "$0.59"],
    ] },
    { type: "heading", text: "Why You'd Need This" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Sizing a strategy</strong>, high-frequency and scalping systems live or die on per-trade cost, so the micro-versus-standard gap matters a lot.",
        "<strong class='text-white'>Choosing a plan</strong>, heavy traders often earn back the Monthly or Lifetime fee through the lower commissions alone.",
        "<strong class='text-white'>Reconciling statements</strong>, matching billed commissions against your own records at tax time.",
        "<strong class='text-white'>Comparing brokers or prop firms</strong>, knowing the true all-in rate lets you compare apples to apples.",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Once you know your per-side cost, the next job is making every entry and exit fire cleanly. <strong class='text-white'>PickMyTrade links your TradingView alerts straight to your Tradovate account</strong>, so orders route automatically at your plan's commission rate, no manual clicks, no missed fills, and no fat-finger size errors that quietly inflate your costs." },
  ], de: [
    { type: "paragraph",html: "Sie möchten genau wissen, was jeder Tradovate-Trade kostet? Ob Sie Tarife vergleichen, eine Scalping-Strategie budgetieren oder Ihre Alerts in eine Automatisierung wie PickMyTrade einbinden: Dieser Leitfaden schlüsselt die Kommissionssätze von Tradovate für Micro- und Standard-Futures-Kontrakte (Mini) auf, Tarif für Tarif." },
    { type: "heading",text: "Was sind Tradovate-Kommissionssätze?" },
    { type: "paragraph",html: "Tradovate erhebt bei jedem Einstieg in einen Futures-Kontrakt und jedem Ausstieg eine pauschale Kommission pro Seite. Zwei Faktoren bestimmen den Satz: Ihr Mitgliedschaftstarif und Ihre Kontraktgröße (Micro oder Standard/Mini). Börsen-, Clearing- und NFA-Gebühren werden zusätzlich separat berechnet, Ihre tatsächlichen Kosten liegen daher immer etwas über der reinen Kommission." },
    { type: "heading",text: "So finden Sie Ihren Tradovate-Kommissionssatz: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Ihren Mitgliedschaftstarif ermitteln", html: "Tradovate bietet sein Brokerage in drei Mitgliedschaftsstufen an, und jede hat ihre eigene Kommissionstabelle. Stand Juli 2026 sind das der Free-Tarif ($0/Monat), der Monthly-Tarif ($99/Monat) und der Lifetime-Tarif (einmalig $1,499 oder vier Raten zu $499). Klären Sie, in welchem Tarif Sie sind, bevor Sie einen Satz ablesen. Ein Trader im Free-Tarif und ein Lifetime-Mitglied zahlen für genau denselben Trade sehr unterschiedliche Kommissionen." },
        { title: "Den Satz pro Seite für Ihren Kontrakttyp ablesen", html: "Micro-Kontrakte wie MES oder MNQ sind pro Seite günstiger als Standard-/Mini-Kontrakte wie ES oder NQ. Und weil die Kommission <em>pro Seite</em> anfällt, kostet ein vollständiger Round Turn, also ein Einstieg plus ein Ausstieg, in etwa das Doppelte des Werts in der folgenden Tabelle. Für Nano- und Event-Kontrakte nennt Tradovate sogar noch niedrigere Sätze pro Seite. Diese Zahlen gelten Stand Juli 2026 und ändern sich. Rufen Sie daher die offizielle Preisseite von Tradovate auf und bestätigen Sie die aktuellen Werte, bevor Sie die Kosten einer Strategie berechnen." },
        { title: "Börsen-, NFA- und Clearing-Gebühren hinzurechnen", html: "Die Kommission ist nur die halbe Wahrheit. Jeder Fill trägt außerdem Börsengebühren (von der CME und anderen Börsen festgelegt), eine kleine regulatorische NFA-Gebühr und Clearing-Gebühren. Diese durchgereichten Gebühren setzt Tradovate nicht fest, sie fallen in jedem Tarif an und werden von Zeit zu Zeit angepasst. Behandeln Sie sie daher als eigene Position und prüfen Sie die aktuelle Gebührentabelle, statt sich einen Dollarbetrag zu merken. Kommission plus diese Gebühren ergeben Ihren „All-in“-Satz." },
        { title: "Die tatsächliche Belastung in Ihren Fills prüfen", html: "Verlassen Sie sich nicht auf die Schätzung, sondern prüfen Sie, was Ihnen tatsächlich berechnet wurde. Öffnen Sie in Tradovate Ihren Orders-/Fills-Bericht oder Kontoauszug und sehen Sie sich die Spalte „Commission“ neben jeder Ausführung an. Hier fällt Prop-Firm-Tradern auch auf, dass ihr Evaluierungs- oder Funded-Konto nach der Kommissionstabelle der Firma abgerechnet wird, die je nach Firma und Tarif variiert. Prüfen Sie die aktuellen Regeln Ihrer Firma, statt davon auszugehen, dass die oben genannten Privatkundensätze gelten." },
      ],
    },
    { type: "table", headers: ["Tarif","Mitgliedschaftskosten","Micro (pro Seite)","Standard / Mini (pro Seite)"], rows: [
      ["Free","$0 / Monat","$0.39","$1.29"],
      ["Monthly","$99 / Monat","$0.29","$0.99"],
      ["Lifetime","$1,499 einmalig","$0.09","$0.59"],
    ] },
    { type: "heading",text: "Warum Sie das brauchen" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Strategie dimensionieren</strong>, Hochfrequenz- und Scalping-Systeme stehen und fallen mit den Kosten pro Trade, daher ist der Abstand zwischen Micro und Standard sehr relevant.",
        "<strong class='text-white'>Tarif wählen</strong>, Vielhändler holen die Monthly- oder Lifetime-Gebühr oft allein durch die niedrigeren Kommissionen wieder herein.",
        "<strong class='text-white'>Abrechnungen abstimmen</strong>, berechnete Kommissionen zur Steuererklärung mit Ihren eigenen Aufzeichnungen abgleichen.",
        "<strong class='text-white'>Broker oder Prop Firms vergleichen</strong>, wer den echten All-in-Satz kennt, kann Äpfel mit Äpfeln vergleichen.",
      ],
    },
    { type: "heading",text: "Automatisieren Sie das mit PickMyTrade" },
    { type: "paragraph",html: "Sobald Sie Ihre Kosten pro Seite kennen, geht es darum, dass jeder Einstieg und Ausstieg sauber ausgelöst wird. <strong class='text-white'>PickMyTrade verbindet Ihre TradingView-Alerts direkt mit Ihrem Tradovate-Konto</strong>, sodass Orders automatisch zum Kommissionssatz Ihres Tarifs ausgeführt werden, ohne manuelle Klicks, ohne verpasste Fills und ohne Tippfehler bei der Größe, die Ihre Kosten unbemerkt in die Höhe treiben." },
  ], es: [
    { type: "paragraph",html: "¿Quiere saber exactamente cuánto le cuesta cada operación en Tradovate? Tanto si está comparando planes, presupuestando una estrategia de scalping o conectando sus alertas a una automatización como PickMyTrade, esta guía desglosa las comisiones de Tradovate para contratos de futuros micro y estándar (mini), plan por plan." },
    { type: "heading",text: "¿Qué son las comisiones de Tradovate?" },
    { type: "paragraph",html: "Tradovate cobra una comisión fija por lado cada vez que entra o sale de un contrato de futuros. Dos factores determinan la tarifa: su plan de membresía y el tamaño del contrato (micro frente a estándar/mini). Las tarifas de bolsa, de compensación y de la NFA se facturan por separado además de la comisión, por lo que su coste real siempre queda algo por encima de la comisión por sí sola." },
    { type: "heading",text: "Cómo encontrar su comisión en Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Identifique su plan de membresía", html: "Tradovate vende su servicio de corretaje en tres niveles de membresía, y cada uno tiene su propio esquema de comisiones. A julio de 2026, esos niveles son el plan Free ($0/mes), el plan Monthly ($99/mes) y el plan Lifetime (un pago único de $1,499 o cuatro cuotas de $499). Determine en qué plan está antes de leer ninguna tarifa. Un trader del plan Free y un miembro Lifetime pagan comisiones muy distintas por exactamente la misma operación." },
        { title: "Lea la tarifa por lado de su tipo de contrato", html: "Los contratos micro como MES o MNQ son más baratos por lado que los contratos estándar/mini como ES o NQ. Y como la comisión se aplica <em>por lado</em>, un round turn completo, una entrada más una salida, le cuesta aproximadamente el doble de la cifra de la tabla siguiente. Tradovate también indica tarifas por lado aún más bajas para los contratos nano y de eventos. Estas cifras están vigentes a julio de 2026 y cambian, así que abra la página oficial de precios de Tradovate y confirme los valores actuales antes de calcular el coste de una estrategia." },
        { title: "Sume las tarifas de bolsa, NFA y compensación", html: "La comisión es solo la mitad de la historia. Cada ejecución también lleva tarifas de bolsa (fijadas por el CME y otras bolsas), una pequeña tarifa regulatoria de la NFA y tarifas de compensación. Tradovate no fija estas tarifas repercutidas, se aplican en todos los planes y se revisan de vez en cuando, así que trátelas como una partida aparte y consulte el esquema vigente en lugar de memorizar una cifra. La comisión más estas tarifas forma su tarifa «todo incluido»." },
        { title: "Verifique el cargo real en sus ejecuciones", html: "No dé la estimación por buena: compruebe lo que realmente le cobraron. Abra en Tradovate su informe de órdenes/ejecuciones (Orders/Fills) o su extracto de cuenta y mire la columna de comisión junto a cada ejecución. Aquí también los traders de prop firms comprobarán que su cuenta de evaluación o financiada funciona con el esquema de comisiones de la propia firma, que varía según la firma y el plan. Consulte las reglas vigentes de su firma en lugar de asumir que se aplican las tarifas minoristas anteriores." },
      ],
    },
    { type: "table", headers: ["Plan","Coste de membresía","Micro (por lado)","Estándar / mini (por lado)"], rows: [
      ["Free","$0 / mes","$0.39","$1.29"],
      ["Monthly","$99 / mes","$0.29","$0.99"],
      ["Lifetime","$1,499 pago único","$0.09","$0.59"],
    ] },
    { type: "heading",text: "Por qué lo necesitaría" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Dimensionar una estrategia</strong>, los sistemas de alta frecuencia y scalping viven o mueren por el coste por operación, así que la diferencia entre micro y estándar importa mucho.",
        "<strong class='text-white'>Elegir un plan</strong>, los traders muy activos suelen recuperar la cuota Monthly o Lifetime solo con las comisiones más bajas.",
        "<strong class='text-white'>Conciliar extractos</strong>, cotejar las comisiones facturadas con sus propios registros en la época de impuestos.",
        "<strong class='text-white'>Comparar brokers o prop firms</strong>, conocer la tarifa real todo incluido le permite comparar en igualdad de condiciones.",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Una vez que conoce su coste por lado, el siguiente trabajo es lograr que cada entrada y salida se ejecute limpiamente. <strong class='text-white'>PickMyTrade conecta sus alertas de TradingView directamente con su cuenta de Tradovate</strong>, de modo que las órdenes se envían automáticamente a la comisión de su plan, sin clics manuales, sin ejecuciones perdidas y sin errores de tamaño por dedazo que inflan sus costes sin que lo note." },
  ], fr: [
    { type: "paragraph",html: "Vous voulez savoir exactement ce que coûte chaque trade chez Tradovate ? Que vous compariez des forfaits, budgétiez une stratégie de scalping ou connectiez vos alertes à une automatisation comme PickMyTrade, ce guide détaille les commissions de Tradovate pour les contrats à terme micro et standard (mini), forfait par forfait." },
    { type: "heading",text: "Que sont les commissions Tradovate ?" },
    { type: "paragraph",html: "Tradovate facture une commission forfaitaire par côté chaque fois que vous entrez ou sortez d'un contrat à terme. Deux éléments déterminent ce tarif : votre forfait d'adhésion et la taille de votre contrat (micro ou standard/mini). Les frais de bourse, de compensation et de la NFA sont facturés séparément en sus ; votre coût réel est donc toujours un peu supérieur à la seule commission." },
    { type: "heading",text: "Trouver votre commission Tradovate : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Identifiez votre forfait d'adhésion", html: "Tradovate propose son courtage sur trois niveaux d'adhésion, chacun avec sa propre grille de commissions. En juillet 2026, ces niveaux sont le forfait Free ($0/mois), le forfait Monthly ($99/mois) et le forfait Lifetime (un paiement unique de $1,499, ou quatre versements de $499). Déterminez votre forfait avant de lire le moindre tarif. Un trader du forfait Free et un membre Lifetime paient des commissions très différentes pour exactement le même trade." },
        { title: "Lisez le tarif par côté de votre type de contrat", html: "Les contrats micro comme MES ou MNQ sont moins chers par côté que les contrats standard/mini comme ES ou NQ. Et comme la commission s'applique <em>par côté</em>, un aller-retour complet, une entrée plus une sortie, vous coûte environ le double du chiffre du tableau ci-dessous. Tradovate affiche aussi des tarifs par côté encore plus bas pour les contrats nano et d'événements. Ces chiffres sont à jour en juillet 2026 et ils changent : consultez la page de tarifs officielle de Tradovate et confirmez les valeurs en vigueur avant de calculer le coût d'une stratégie." },
        { title: "Ajoutez les frais de bourse, de la NFA et de compensation", html: "La commission ne raconte que la moitié de l'histoire. Chaque exécution comporte aussi des frais de bourse (fixés par le CME et d'autres bourses), une petite redevance réglementaire de la NFA et des frais de compensation. Tradovate ne fixe pas ces frais répercutés, ils s'appliquent sur tous les forfaits et sont révisés de temps à autre ; traitez-les donc comme une ligne à part et consultez la grille en vigueur plutôt que de retenir un montant en dollars. La commission plus ces frais constitue votre tarif « tout compris »." },
        { title: "Vérifiez le montant réellement facturé sur vos exécutions", html: "Ne vous fiez pas à l'estimation : vérifiez ce qui vous a réellement été facturé. Ouvrez dans Tradovate votre rapport Orders/Fills ou votre relevé de compte et regardez la colonne de commission à côté de chaque exécution. C'est aussi là que les traders de prop firm constateront que leur compte d'évaluation ou financé fonctionne selon la grille de commissions propre à la firme, qui varie selon la firme et le forfait. Vérifiez les règles en vigueur de votre firme plutôt que de supposer que les tarifs grand public ci-dessus s'appliquent." },
      ],
    },
    { type: "table", headers: ["Forfait","Coût d'adhésion","Micro (par côté)","Standard / mini (par côté)"], rows: [
      ["Free","$0 / mois","$0.39","$1.29"],
      ["Monthly","$99 / mois","$0.29","$0.99"],
      ["Lifetime","$1,499 paiement unique","$0.09","$0.59"],
    ] },
    { type: "heading",text: "Pourquoi vous en avez besoin" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Dimensionner une stratégie</strong>, les systèmes haute fréquence et de scalping vivent ou meurent selon le coût par trade, l'écart entre micro et standard compte donc beaucoup.",
        "<strong class='text-white'>Choisir un forfait</strong>, les traders très actifs rentabilisent souvent le forfait Monthly ou Lifetime grâce aux seules commissions réduites.",
        "<strong class='text-white'>Rapprocher vos relevés</strong>, comparer les commissions facturées à vos propres enregistrements au moment des impôts.",
        "<strong class='text-white'>Comparer des courtiers ou des prop firms</strong>, connaître le vrai tarif tout compris permet de comparer ce qui est comparable.",
      ],
    },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Une fois votre coût par côté connu, il s'agit ensuite de faire en sorte que chaque entrée et sortie s'exécute proprement. <strong class='text-white'>PickMyTrade relie directement vos alertes TradingView à votre compte Tradovate</strong>, de sorte que les ordres sont routés automatiquement à la commission de votre forfait, sans clics manuels, sans exécutions manquées et sans erreurs de taille par maladresse qui gonflent discrètement vos coûts." },
  ], it: [
    { type: "paragraph",html: "Vuole sapere esattamente quanto Le costa ogni trade su Tradovate? Che stia confrontando i piani, preventivando una strategia di scalping o collegando i Suoi alert a un'automazione come PickMyTrade, questa guida illustra le commissioni di Tradovate per i contratti futures micro e standard (mini), piano per piano." },
    { type: "heading",text: "Che cosa sono le commissioni Tradovate?" },
    { type: "paragraph",html: "Tradovate addebita una commissione fissa per lato ogni volta che entra o esce da un contratto futures. Due fattori determinano la tariffa: il Suo piano di abbonamento e la dimensione del contratto (micro oppure standard/mini). Le commissioni di borsa, di clearing e della NFA vengono fatturate separatamente in aggiunta, quindi il Suo costo reale risulta sempre un po' più alto della sola commissione." },
    { type: "heading",text: "Come trovare la Sua commissione Tradovate: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Identifichi il Suo piano di abbonamento", html: "Tradovate offre il suo brokeraggio su tre livelli di abbonamento, e ciascuno ha un proprio schema di commissioni. A luglio 2026 questi livelli sono il piano Free ($0/mese), il piano Monthly ($99/mese) e il piano Lifetime (un pagamento unico di $1,499, oppure quattro rate da $499). Stabilisca a quale piano appartiene prima di leggere qualsiasi tariffa. Un trader del piano Free e un membro Lifetime pagano commissioni molto diverse per lo stesso identico trade." },
        { title: "Legga la tariffa per lato del Suo tipo di contratto", html: "I contratti micro come MES o MNQ costano meno per lato dei contratti standard/mini come ES o NQ. E poiché la commissione si applica <em>per lato</em>, un round turn completo, un ingresso più un'uscita, Le costa circa il doppio della cifra nella tabella sottostante. Tradovate indica anche tariffe per lato ancora più basse per i contratti nano e per gli eventi. Questi numeri sono aggiornati a luglio 2026 e cambiano: apra la pagina ufficiale dei prezzi di Tradovate e confermi i valori correnti prima di calcolare il costo di una strategia." },
        { title: "Aggiunga le commissioni di borsa, NFA e clearing", html: "La commissione è solo metà della storia. Ogni esecuzione comporta anche commissioni di borsa (stabilite dal CME e da altre borse), una piccola tassa regolamentare della NFA e commissioni di clearing. Tradovate non stabilisce queste commissioni passanti, si applicano su ogni piano e vengono riviste di tanto in tanto, quindi le tratti come una voce a sé e controlli lo schema corrente invece di memorizzare un importo in dollari. La commissione più queste spese costituisce la Sua tariffa «all-in»." },
        { title: "Verifichi l'addebito effettivo sulle Sue esecuzioni", html: "Non si fidi della stima: controlli quanto Le è stato effettivamente addebitato. Apra in Tradovate il Suo report Orders/Fills o l'estratto conto e guardi la colonna della commissione accanto a ogni esecuzione. È anche qui che i trader di prop firm noteranno che il loro account di valutazione o finanziato opera con lo schema di commissioni della firm, che varia in base alla firm e al piano. Controlli le regole correnti della Sua firm invece di dare per scontato che si applichino le tariffe retail sopra indicate." },
      ],
    },
    { type: "table", headers: ["Piano","Costo dell'abbonamento","Micro (per lato)","Standard / mini (per lato)"], rows: [
      ["Free","$0 / mese","$0.39","$1.29"],
      ["Monthly","$99 / mese","$0.29","$0.99"],
      ["Lifetime","$1,499 una tantum","$0.09","$0.59"],
    ] },
    { type: "heading",text: "Perché Le serve saperlo" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Dimensionare una strategia</strong>, i sistemi ad alta frequenza e di scalping vivono o muoiono in base al costo per trade, quindi il divario tra micro e standard conta molto.",
