---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-historical-data";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "How Much Historical Data Tradovate Provides";
const META_DESCRIPTION =
  "How far back charts load tick, intraday, and daily bars, why back-scrolling is slow, and how to pull up older historical price data faster.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Wie viele historische Daten Tradovate bereitstellt", es: "Cuántos datos históricos ofrece Tradovate", fr: "Quelle quantité de données historiques Tradovate fournit", it: "Quanti dati storici fornisce Tradovate" },
  dek: { en: "Tradovate charts don't hold unlimited history, and how far back you can go depends entirely on the timeframe. Here's what you get and how to load older bars faster.", de: "Tradovate-Charts halten keine unbegrenzte Historie vor, und wie weit Sie zurückgehen können, hängt ganz vom Zeitrahmen ab. Hier erfahren Sie, was Sie bekommen und wie Sie ältere Kerzen schneller laden.", es: "Los gráficos de Tradovate no guardan un historial ilimitado, y hasta dónde puede retroceder depende por completo de la temporalidad. Aquí le explicamos qué obtiene y cómo cargar velas antiguas más rápido.", fr: "Les graphiques Tradovate ne conservent pas un historique illimité, et la profondeur que vous pouvez atteindre dépend entièrement de l'unité de temps. Voici ce que vous obtenez et comment charger plus vite des bougies plus anciennes.", it: "I grafici di Tradovate non conservano uno storico illimitato, e quanto indietro può spingersi dipende interamente dal timeframe. Ecco che cosa ottiene e come caricare più rapidamente le candele più vecchie." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-10",
  blocks: { en: [
    { type: "paragraph", html: "Tradovate charts don't hold unlimited history, and how far back you can go depends entirely on the timeframe. Daily, weekly, and monthly charts reach back years. Minute and hourly charts stop after roughly the last three months. Tick, range, and volume charts hold only about the last week and a half unless you turn on an add-on. Here's what you get, why scrolling back feels so slow, and how to pull up older bars without fighting the mouse wheel." },
    { type: "heading", text: "How Far Back Each Chart Type Loads" },
    { type: "paragraph", html: "The limit is tied to the bar type, not to your plan or balance. Larger bars cover more calendar time, so they stretch further into the past. Smaller and tick-based bars eat through their allowance fast." },
    {
      type: "table",
      headers: ["Chart / bar type", "Roughly how far back it loads"],
      rows: [
        ["Daily, weekly, monthly (multi-day)", "Many years back, effectively the full available history of the contract"],
        ["Minute and hourly (intraday)", "About the last 90 days"],
        ["Tick, volume, range, and other tick-based bars", "About the last 10 days, extendable to roughly a year with the tick-data add-on"],
      ],
    },
    { type: "paragraph", html: "Treat those figures as current defaults, not a promise carved in stone. They've changed before and can change again. They're also the platform's own chart limits, not anything your prop firm sets, so if you trade a funded or evaluation account and a chart looks shorter than expected, check your firm's current rules too." },
    { type: "heading", text: "Why Scrolling Back Feels So Slow" },
    { type: "paragraph", html: "The frustrating part isn't the limit itself, it's getting to it. Tradovate charts have no \"go to this date\" input. To see April's price action on a 1-minute chart, you scroll or drag the chart left and wait while it streams older bars in. On a low timeframe that's thousands of bars per week, so the further you drag, the more it crawls." },
    { type: "paragraph", html: "A couple of things make it worse. The chart only preloads a set number of bars, and everything older has to load on demand as you scroll. Switch instruments or timeframes often and each fresh chart restarts from that same preload window, so you're back to dragging. And if bars show up with empty gaps on load, that's usually the same streaming lag catching up, not missing history." },
    { type: "heading", text: "How to Load Older Bars on a Tradovate Chart" },
    {
      type: "steps",
      items: [
        { title: "Pick the Highest Timeframe That Still Shows What You Need", html: "Before you start dragging, ask whether you really need 1-minute bars. A daily chart reaches back years and loads almost instantly. A 1-minute chart covers the same span with sixty times the bars and grinds to get there. Answer the question on a higher timeframe first, then drill down only on the specific day you care about." },
        { title: "Raise the Bars-to-Load Setting in Chart Settings", html: "Open the chart's settings and look for the field that controls how many bars load up front. Raising it tells the chart to preload more history before you touch the mouse wheel, so more of the past is already sitting there when you scroll. There's a ceiling on how many bars it will hold, so push it up but don't expect it to load a full year of ticks in one shot." },
        { title: "Scroll or Drag Back to Stream in Older Data", html: "With a sensible timeframe and a higher preload set, scroll the mouse wheel back or drag the chart to the left. Older bars load in chunks. When you reach the current edge of loaded data, pause a second so the next block streams in, then keep going. It's still manual, but starting on the right timeframe means dragging across a lot less empty space." },
        { title: "Jump to a Specific Date With Market Replay", html: "If you need a precise past date rather than a general scroll-back, skip the dragging entirely and use <strong class='text-white'>Market Replay</strong>. Set the start date and time, and the platform loads the market at that exact moment so you can study or trade over that session. It's the cleanest way to land on, say, a specific news day without wearing out your scroll wheel." },
      ],
    },
    { type: "heading", text: "Extending Tick History With the Add-On" },
    { type: "paragraph", html: "Ten days of tick data is fine for reading the current week, but it won't cover a proper back-test. Tradovate offers an add-on that stretches tick data to roughly a year, enabled from the application settings under the add-ons area. Whether it carries a fee and exactly where the toggle lives can change, so confirm the current option and pricing in your own settings first." },
    { type: "heading", text: "When the Charts Can't Reach Far Enough" },
    { type: "paragraph", html: "Chart history is built for reviewing and trading, not for pulling long data sets or running a strategy hands-free. If your plan is to react to signals across sessions rather than sit and scroll, automating execution takes the chart out of the critical path. PickMyTrade links your TradingView alerts straight to your Tradovate account, so your setups fire the moment they trigger, whether or not you've got the right window scrolled up." },
  ], de: [
    { type: "paragraph",html: "Tradovate-Charts halten keine unbegrenzte Historie vor, und wie weit Sie zurückgehen können, hängt ganz vom Zeitrahmen ab. Tages-, Wochen- und Monatscharts reichen Jahre zurück. Minuten- und Stundencharts enden nach etwa den letzten drei Monaten. Tick-, Range- und Volumencharts halten nur etwa die letzten anderthalb Wochen vor, es sei denn, Sie aktivieren ein Add-on. Hier erfahren Sie, was Sie bekommen, warum das Zurückscrollen so zäh wirkt und wie Sie ältere Kerzen aufrufen, ohne mit dem Mausrad zu kämpfen." },
    { type: "heading",text: "Wie weit zurück jeder Charttyp lädt" },
    { type: "paragraph",html: "Das Limit hängt am Kerzentyp, nicht an Ihrem Tarif oder Kontostand. Größere Kerzen decken mehr Kalenderzeit ab und reichen daher weiter in die Vergangenheit. Kleinere und tickbasierte Kerzen verbrauchen ihr Kontingent schnell." },
    { type: "table", headers: ["Chart-/Kerzentyp","Etwa so weit zurück lädt er"], rows: [
      ["Tag, Woche, Monat (mehrtägig)","Viele Jahre zurück, praktisch die gesamte verfügbare Historie des Kontrakts"],
      ["Minute und Stunde (Intraday)","Etwa die letzten 90 Tage"],
      ["Tick, Volumen, Range und andere tickbasierte Kerzen","Etwa die letzten 10 Tage, mit dem Tick-Daten-Add-on auf rund ein Jahr erweiterbar"],
    ] },
    { type: "paragraph",html: "Betrachten Sie diese Werte als aktuelle Standardeinstellungen, nicht als in Stein gemeißeltes Versprechen. Sie haben sich schon geändert und können sich wieder ändern. Es sind außerdem die plattformeigenen Chartlimits und keine Vorgaben Ihrer Prop-Firma. Wenn Sie also ein Funded- oder Evaluation-Konto handeln und ein Chart kürzer wirkt als erwartet, prüfen Sie auch die aktuellen Regeln Ihrer Firma." },
    { type: "heading",text: "Warum das Zurückscrollen so zäh ist" },
    { type: "paragraph",html: "Das Frustrierende ist nicht das Limit selbst, sondern der Weg dorthin. Tradovate-Charts haben keine Eingabe für \"gehe zu diesem Datum\". Um die Kursbewegung vom April auf einem 1-Minuten-Chart zu sehen, scrollen oder ziehen Sie den Chart nach links und warten, während ältere Kerzen nachgeladen werden. Auf einem niedrigen Zeitrahmen sind das Tausende Kerzen pro Woche, sodass es immer zäher wird, je weiter Sie ziehen." },
    { type: "paragraph",html: "Ein paar Dinge verschlimmern das. Der Chart lädt nur eine feste Anzahl an Kerzen vor, und alles Ältere wird beim Scrollen bei Bedarf nachgeladen. Wenn Sie häufig Instrumente oder Zeitrahmen wechseln, startet jeder neue Chart wieder mit demselben Vorlade-Fenster, und Sie müssen erneut ziehen. Und wenn beim Laden Kerzen mit leeren Lücken erscheinen, ist das meist derselbe Streaming-Rückstand, der aufholt, und keine fehlende Historie." },
    { type: "heading",text: "So laden Sie ältere Kerzen in einem Tradovate-Chart" },
    {
      type: "steps",
      items: [
        { title: "Wählen Sie den höchsten Zeitrahmen, der noch zeigt, was Sie brauchen", html: "Bevor Sie anfangen zu ziehen, fragen Sie sich, ob Sie wirklich 1-Minuten-Kerzen brauchen. Ein Tageschart reicht Jahre zurück und lädt fast sofort. Ein 1-Minuten-Chart deckt denselben Zeitraum mit sechzigmal so vielen Kerzen ab und quält sich dorthin. Beantworten Sie die Frage zuerst auf einem höheren Zeitrahmen und gehen Sie nur für den konkreten Tag, der Sie interessiert, in die Tiefe." },
        { title: "Erhöhen Sie die Einstellung für zu ladende Kerzen in den Chart-Einstellungen", html: "Öffnen Sie die Chart-Einstellungen und suchen Sie das Feld, das steuert, wie viele Kerzen vorab geladen werden. Wenn Sie den Wert erhöhen, lädt der Chart mehr Historie vor, bevor Sie das Mausrad berühren, sodass beim Scrollen mehr Vergangenheit bereits vorliegt. Es gibt eine Obergrenze dafür, wie viele Kerzen gehalten werden. Erhöhen Sie ihn also, erwarten Sie aber nicht, dass ein ganzes Jahr an Ticks auf einmal geladen wird." },
        { title: "Scrollen oder ziehen Sie zurück, um ältere Daten nachzuladen", html: "Scrollen Sie mit einem sinnvollen Zeitrahmen und einem höheren Vorladewert mit dem Mausrad zurück oder ziehen Sie den Chart nach links. Ältere Kerzen werden in Blöcken geladen. Wenn Sie den aktuellen Rand der geladenen Daten erreichen, warten Sie eine Sekunde, damit der nächste Block nachgeladen wird, und machen Sie dann weiter. Es bleibt Handarbeit, aber wenn Sie im richtigen Zeitrahmen starten, ziehen Sie über deutlich weniger leeren Raum." },
        { title: "Springen Sie mit Market Replay zu einem bestimmten Datum", html: "Wenn Sie ein präzises Datum aus der Vergangenheit brauchen statt eines allgemeinen Zurückscrollens, verzichten Sie ganz auf das Ziehen und nutzen Sie <strong class='text-white'>Market Replay</strong>. Legen Sie Startdatum und Uhrzeit fest, und die Plattform lädt den Markt genau zu diesem Zeitpunkt, sodass Sie diese Sitzung analysieren oder handeln können. Es ist der sauberste Weg, zum Beispiel einen bestimmten Nachrichtentag anzusteuern, ohne das Mausrad abzunutzen." },
      ],
    },
    { type: "heading",text: "Tick-Historie mit dem Add-on erweitern" },
    { type: "paragraph",html: "Zehn Tage Tick-Daten reichen, um die aktuelle Woche zu lesen, aber nicht für einen ordentlichen Backtest. Tradovate bietet ein Add-on an, das die Tick-Daten auf etwa ein Jahr ausdehnt und sich in den Anwendungseinstellungen im Bereich der Add-ons aktivieren lässt. Ob dafür eine Gebühr anfällt und wo genau sich der Schalter befindet, kann sich ändern. Bestätigen Sie daher zuerst die aktuelle Option und den Preis in Ihren eigenen Einstellungen." },
    { type: "heading",text: "Wenn die Charts nicht weit genug reichen" },
    { type: "paragraph",html: "Die Chart-Historie ist zum Auswerten und Handeln gedacht, nicht zum Abrufen großer Datensätze oder für einen vollautomatischen Strategiebetrieb. Wenn Sie über mehrere Sitzungen hinweg auf Signale reagieren möchten, statt zu sitzen und zu scrollen, nimmt die Automatisierung der Ausführung den Chart aus dem kritischen Pfad. PickMyTrade verbindet Ihre TradingView-Alerts direkt mit Ihrem Tradovate-Konto, sodass Ihre Setups in dem Moment auslösen, in dem sie eintreten, egal ob Sie das richtige Fenster aufgescrollt haben oder nicht." },
  ], es: [
    { type: "paragraph",html: "Los gráficos de Tradovate no guardan un historial ilimitado, y hasta dónde puede retroceder depende por completo de la temporalidad. Los gráficos diarios, semanales y mensuales alcanzan años atrás. Los gráficos de minutos y de horas se detienen tras aproximadamente los últimos tres meses. Los gráficos de ticks, rango y volumen solo conservan cerca de los últimos diez días, salvo que active un complemento. Aquí le explicamos qué obtiene, por qué retroceder resulta tan lento y cómo cargar velas antiguas sin pelearse con la rueda del ratón." },
    { type: "heading",text: "Hasta dónde carga cada tipo de gráfico" },
    { type: "paragraph",html: "El límite depende del tipo de vela, no de su plan ni de su saldo. Las velas más grandes cubren más tiempo de calendario, por lo que llegan más atrás en el pasado. Las velas más pequeñas y las basadas en ticks consumen su cupo enseguida." },
    { type: "table", headers: ["Tipo de gráfico / vela","Hasta dónde carga aproximadamente"], rows: [
      ["Diario, semanal, mensual (multidía)","Muchos años atrás, en la práctica todo el historial disponible del contrato"],
      ["Minuto y hora (intradía)","Aproximadamente los últimos 90 días"],
      ["Tick, volumen, rango y otras velas basadas en ticks","Aproximadamente los últimos 10 días, ampliable a cerca de un año con el complemento de datos de ticks"],
    ] },
    { type: "paragraph",html: "Tome esas cifras como valores predeterminados actuales, no como una promesa grabada en piedra. Han cambiado antes y pueden volver a cambiar. Además, son los límites de gráficos de la propia plataforma, no algo que fije su prop firm, así que si opera una cuenta fondeada o de evaluación y un gráfico le parece más corto de lo esperado, revise también las reglas vigentes de su firma." },
    { type: "heading",text: "Por qué retroceder resulta tan lento" },
    { type: "paragraph",html: "Lo frustrante no es el límite en sí, sino llegar hasta él. Los gráficos de Tradovate no tienen una entrada para \"ir a esta fecha\". Para ver la acción del precio de abril en un gráfico de 1 minuto, debe desplazar o arrastrar el gráfico hacia la izquierda y esperar mientras se descargan velas antiguas. En una temporalidad baja son miles de velas por semana, así que cuanto más arrastra, más se ralentiza." },
    { type: "paragraph",html: "Un par de cosas lo empeoran. El gráfico solo precarga un número fijo de velas, y todo lo anterior se carga bajo demanda a medida que se desplaza. Si cambia a menudo de instrumento o de temporalidad, cada gráfico nuevo vuelve a empezar desde esa misma ventana de precarga y tiene que arrastrar otra vez. Y si al cargar aparecen velas con huecos vacíos, suele ser el mismo retraso de transmisión poniéndose al día, no un historial que falte." },
    { type: "heading",text: "Cómo cargar velas antiguas en un gráfico de Tradovate" },
    {
      type: "steps",
      items: [
        { title: "Elija la temporalidad más alta que aún muestre lo que necesita", html: "Antes de empezar a arrastrar, pregúntese si de verdad necesita velas de 1 minuto. Un gráfico diario alcanza años atrás y carga casi al instante. Un gráfico de 1 minuto cubre el mismo periodo con sesenta veces más velas y le cuesta llegar. Responda primero la pregunta en una temporalidad mayor y baje de nivel solo en el día concreto que le interesa." },
        { title: "Aumente el ajuste de velas a cargar en la configuración del gráfico", html: "Abra la configuración del gráfico y busque el campo que controla cuántas velas se cargan al inicio. Si lo aumenta, el gráfico precarga más historial antes de que toque la rueda del ratón, de modo que haya más pasado disponible cuando se desplace. Existe un tope en el número de velas que puede mantener, así que súbalo, pero no espere que cargue un año completo de ticks de una sola vez." },
        { title: "Desplácese o arrastre hacia atrás para descargar datos antiguos", html: "Con una temporalidad razonable y una precarga mayor, retroceda con la rueda del ratón o arrastre el gráfico hacia la izquierda. Las velas antiguas se cargan por bloques. Cuando llegue al borde actual de los datos cargados, haga una pausa de un segundo para que se descargue el siguiente bloque y luego continúe. Sigue siendo manual, pero empezar en la temporalidad correcta significa arrastrar por mucho menos espacio vacío." },
        { title: "Salte a una fecha concreta con Market Replay", html: "Si necesita una fecha pasada precisa en lugar de un retroceso general, olvídese de arrastrar y use <strong class='text-white'>Market Replay</strong>. Fije la fecha y la hora de inicio, y la plataforma carga el mercado en ese momento exacto para que pueda estudiar u operar esa sesión. Es la forma más limpia de llegar, por ejemplo, a un día concreto de noticias sin desgastar la rueda del ratón." },
      ],
    },
    { type: "heading",text: "Ampliar el historial de ticks con el complemento" },
    { type: "paragraph",html: "Diez días de datos de ticks bastan para leer la semana en curso, pero no cubren un backtest en condiciones. Tradovate ofrece un complemento que amplía los datos de ticks a cerca de un año, y se activa desde la configuración de la aplicación, en el área de complementos. Si tiene coste y dónde se encuentra exactamente el interruptor puede cambiar, así que confirme primero la opción y el precio vigentes en su propia configuración." },
    { type: "heading",text: "Cuando los gráficos no llegan lo bastante lejos" },
    { type: "paragraph",html: "El historial del gráfico está pensado para revisar y operar, no para extraer grandes conjuntos de datos ni para ejecutar una estrategia en piloto automático. Si su plan es reaccionar a señales a lo largo de varias sesiones en lugar de sentarse a desplazarse, automatizar la ejecución saca el gráfico de la ruta crítica. PickMyTrade conecta sus alertas de TradingView directamente con su cuenta de Tradovate, de modo que sus configuraciones se ejecutan en cuanto se activan, tenga o no la ventana correcta desplazada." },
  ], fr: [
    { type: "paragraph",html: "Les graphiques Tradovate ne conservent pas un historique illimité, et la profondeur que vous pouvez atteindre dépend entièrement de l'unité de temps. Les graphiques journaliers, hebdomadaires et mensuels remontent sur des années. Les graphiques en minutes et en heures s'arrêtent après environ les trois derniers mois. Les graphiques en ticks, en range et en volume ne conservent qu'environ les dix derniers jours, sauf si vous activez un module complémentaire. Voici ce que vous obtenez, pourquoi le défilement vers le passé paraît si lent et comment afficher des bougies plus anciennes sans lutter avec la molette de la souris." },
    { type: "heading",text: "Jusqu'où chaque type de graphique charge l'historique" },
    { type: "paragraph",html: "La limite dépend du type de bougie, pas de votre formule ni de votre solde. Les bougies plus grandes couvrent davantage de temps calendaire et remontent donc plus loin dans le passé. Les bougies plus petites et celles basées sur les ticks épuisent rapidement leur quota." },
    { type: "table", headers: ["Type de graphique / de bougie","Profondeur de chargement approximative"], rows: [
      ["Journalier, hebdomadaire, mensuel (multi-jours)","Plusieurs années, en pratique tout l'historique disponible du contrat"],
      ["Minute et heure (intraday)","Environ les 90 derniers jours"],
      ["Tick, volume, range et autres bougies basées sur les ticks","Environ les 10 derniers jours, extensible à près d'un an avec le module complémentaire de données de ticks"],
    ] },
    { type: "paragraph",html: "Considérez ces chiffres comme les valeurs par défaut actuelles, et non comme une promesse gravée dans le marbre. Elles ont déjà changé et peuvent changer de nouveau. Ce sont aussi les limites de graphiques propres à la plateforme, et non des règles fixées par votre prop firm : si vous tradez un compte financé ou d'évaluation et qu'un graphique paraît plus court que prévu, vérifiez aussi les règles en vigueur de votre firme." },
    { type: "heading",text: "Pourquoi le défilement vers le passé est si lent" },
    { type: "paragraph",html: "Le plus frustrant n'est pas la limite elle-même, c'est d'y arriver. Les graphiques Tradovate n'ont pas de champ « aller à cette date ». Pour voir l'évolution des prix d'avril sur un graphique 1 minute, vous faites défiler ou glisser le graphique vers la gauche et vous attendez que les bougies plus anciennes arrivent. Sur une petite unité de temps, cela représente des milliers de bougies par semaine : plus vous remontez, plus cela ralentit." },
    { type: "paragraph",html: "Plusieurs facteurs aggravent la situation. Le graphique ne précharge qu'un nombre fixe de bougies, et tout ce qui est plus ancien se charge à la demande au fil du défilement. Si vous changez souvent d'instrument ou d'unité de temps, chaque nouveau graphique repart de la même fenêtre de préchargement et vous devez à nouveau faire glisser. Et si des bougies apparaissent avec des trous au chargement, c'est généralement le même retard de diffusion qui se résorbe, et non un historique manquant." },
    { type: "heading",text: "Comment charger des bougies plus anciennes sur un graphique Tradovate" },
    {
      type: "steps",
      items: [
        { title: "Choisissez l'unité de temps la plus élevée qui montre encore ce dont vous avez besoin", html: "Avant de commencer à faire glisser, demandez-vous si vous avez vraiment besoin de bougies 1 minute. Un graphique journalier remonte sur des années et se charge presque instantanément. Un graphique 1 minute couvre la même période avec soixante fois plus de bougies et peine à y arriver. Répondez d'abord à la question sur une unité de temps supérieure, puis descendez seulement sur la journée précise qui vous intéresse." },
        { title: "Augmentez le paramètre du nombre de bougies à charger dans les réglages du graphique", html: "Ouvrez les réglages du graphique et repérez le champ qui contrôle le nombre de bougies chargées d'emblée. En l'augmentant, vous demandez au graphique de précharger davantage d'historique avant que vous ne touchiez la molette, de sorte que plus de passé est déjà disponible lorsque vous faites défiler. Il existe un plafond au nombre de bougies conservées : montez la valeur, mais n'espérez pas charger une année entière de ticks d'un seul coup." },
        { title: "Faites défiler ou glissez vers l'arrière pour charger des données plus anciennes", html: "Avec une unité de temps raisonnable et un préchargement plus élevé, remontez avec la molette ou faites glisser le graphique vers la gauche. Les bougies plus anciennes se chargent par blocs. Lorsque vous atteignez le bord actuel des données chargées, marquez une pause d'une seconde pour laisser le bloc suivant arriver, puis continuez. C'est toujours manuel, mais partir de la bonne unité de temps vous évite de faire glisser sur beaucoup d'espace vide." },
        { title: "Accédez à une date précise avec Market Replay", html: "Si vous avez besoin d'une date passée précise plutôt que d'un simple défilement vers l'arrière, laissez tomber le glissement et utilisez <strong class='text-white'>Market Replay</strong>. Définissez la date et l'heure de début, et la plateforme charge le marché à cet instant exact afin que vous puissiez étudier ou trader cette séance. C'est le moyen le plus propre d'atterrir, par exemple, sur une journée d'actualités précise sans user votre molette." },
      ],
    },
    { type: "heading",text: "Étendre l'historique de ticks avec le module complémentaire" },
    { type: "paragraph",html: "Dix jours de données de ticks suffisent pour lire la semaine en cours, mais pas pour un vrai backtest. Tradovate propose un module complémentaire qui étend les données de ticks à environ un an, activable depuis les paramètres de l'application, dans la zone des modules complémentaires. L'existence d'un tarif et l'emplacement exact de l'option peuvent changer : confirmez donc d'abord l'option et le prix en vigueur dans vos propres paramètres." },
    { type: "heading",text: "Quand les graphiques ne remontent pas assez loin" },
    { type: "paragraph",html: "L'historique des graphiques est conçu pour analyser et trader, pas pour extraire de gros jeux de données ni pour faire tourner une stratégie en mode automatique. Si votre objectif est de réagir à des signaux sur plusieurs séances plutôt que de rester assis à faire défiler, automatiser l'exécution retire le graphique du chemin critique. PickMyTrade relie vos alertes TradingView directement à votre compte Tradovate, de sorte que vos configurations se déclenchent à l'instant où elles se produisent, que vous ayez ou non la bonne fenêtre affichée." },
  ], it: [
    { type: "paragraph",html: "I grafici di Tradovate non conservano uno storico illimitato, e quanto indietro può spingersi dipende interamente dal timeframe. I grafici giornalieri, settimanali e mensili risalgono a molti anni fa. I grafici a minuti e a ore si fermano dopo circa gli ultimi tre mesi. I grafici tick, range e volume conservano solo circa gli ultimi dieci giorni, a meno che non attivi un componente aggiuntivo. Ecco che cosa ottiene, perché lo scorrimento all'indietro sembra così lento e come richiamare le candele più vecchie senza litigare con la rotellina del mouse." },
    { type: "heading",text: "Quanto indietro carica ogni tipo di grafico" },
    { type: "paragraph",html: "Il limite dipende dal tipo di candela, non dal suo piano né dal suo saldo. Le candele più grandi coprono più tempo di calendario e quindi si spingono più indietro nel passato. Le candele più piccole e quelle basate sui tick consumano in fretta la loro dotazione." },
    { type: "table", headers: ["Tipo di grafico / candela","Quanto indietro carica, indicativamente"], rows: [
      ["Giornaliero, settimanale, mensile (multi-giorno)","Molti anni indietro, di fatto l'intero storico disponibile del contratto"],
      ["Minuto e ora (intraday)","Circa gli ultimi 90 giorni"],
      ["Tick, volume, range e altre candele basate sui tick","Circa gli ultimi 10 giorni, estendibili a circa un anno con il componente aggiuntivo dei dati tick"],
    ] },
    { type: "paragraph",html: "Consideri queste cifre come impostazioni predefinite attuali, non come una promessa scolpita nella pietra. Sono già cambiate in passato e possono cambiare di nuovo. Sono inoltre i limiti dei grafici della piattaforma stessa, non qualcosa stabilito dalla sua prop firm: se opera con un conto funded o di valutazione e un grafico le sembra più corto del previsto, controlli anche le regole attuali della sua società." },
    { type: "heading",text: "Perché lo scorrimento all'indietro è così lento" },
    { type: "paragraph",html: "La parte frustrante non è il limite in sé, ma raggiungerlo. I grafici di Tradovate non hanno un campo \"vai a questa data\". Per vedere l'andamento dei prezzi di aprile su un grafico a 1 minuto, deve scorrere o trascinare il grafico verso sinistra e attendere mentre le candele più vecchie vengono caricate. Su un timeframe basso sono migliaia di candele a settimana, quindi più si spinge indietro, più rallenta." },
    { type: "paragraph",html: "Un paio di fattori peggiorano la situazione. Il grafico precarica solo un numero fisso di candele, e tutto ciò che è più vecchio viene caricato su richiesta mentre scorre. Se cambia spesso strumento o timeframe, ogni nuovo grafico riparte dalla stessa finestra di precaricamento e deve trascinare di nuovo. E se al caricamento compaiono candele con buchi vuoti, di solito è lo stesso ritardo di streaming che si sta recuperando, non uno storico mancante." },
    { type: "heading",text: "Come caricare candele più vecchie su un grafico Tradovate" },
    {
      type: "steps",
      items: [
        { title: "Scelga il timeframe più alto che mostri ancora ciò che le serve", html: "Prima di iniziare a trascinare, si chieda se ha davvero bisogno di candele a 1 minuto. Un grafico giornaliero risale a molti anni fa e si carica quasi all'istante. Un grafico a 1 minuto copre lo stesso intervallo con sessanta volte più candele e fatica ad arrivarci. Risponda prima alla domanda su un timeframe superiore e scenda di livello solo sul giorno specifico che le interessa." },
        { title: "Aumenti l'impostazione delle candele da caricare nelle impostazioni del grafico", html: "Apra le impostazioni del grafico e cerchi il campo che controlla quante candele vengono caricate all'inizio. Aumentandolo, dice al grafico di precaricare più storico prima che lei tocchi la rotellina, così più passato è già disponibile quando scorre. Esiste un tetto al numero di candele che può contenere: lo alzi, ma non si aspetti di caricare un intero anno di tick in un colpo solo." },
        { title: "Scorra o trascini all'indietro per caricare i dati più vecchi", html: "Con un timeframe sensato e un precaricamento più alto, scorra all'indietro con la rotellina o trascini il grafico verso sinistra. Le candele più vecchie si caricano a blocchi. Quando raggiunge il margine attuale dei dati caricati, si fermi un secondo per lasciare arrivare il blocco successivo, poi prosegua. Resta un'operazione manuale, ma partire dal timeframe giusto significa trascinare su molto meno spazio vuoto." },
        { title: "Salti a una data specifica con Market Replay", html: "Se le serve una data passata precisa anziché un generico scorrimento all'indietro, salti del tutto il trascinamento e usi <strong class='text-white'>Market Replay</strong>. Imposti data e ora di inizio, e la piattaforma carica il mercato in quell'esatto momento in modo che possa studiare od operare quella sessione. È il modo più pulito per arrivare, ad esempio, a un giorno di notizie specifico senza consumare la rotellina." },
      ],
    },
    { type: "heading",text: "Estendere lo storico dei tick con il componente aggiuntivo" },
    { type: "paragraph",html: "Dieci giorni di dati tick vanno bene per leggere la settimana in corso, ma non coprono un backtest vero e proprio. Tradovate offre un componente aggiuntivo che estende i dati tick a circa un anno, attivabile dalle impostazioni dell'applicazione, nell'area dei componenti aggiuntivi. Se preveda un costo e dove si trovi esattamente l'interruttore può cambiare, quindi confermi prima l'opzione e il prezzo attuali nelle sue impostazioni." },
    { type: "heading",text: "Quando i grafici non arrivano abbastanza indietro" },
    { type: "paragraph",html: "Lo storico dei grafici è pensato per rivedere e operare, non per estrarre grandi insiemi di dati né per eseguire una strategia in automatico. Se il suo piano è reagire ai segnali nell'arco di più sessioni anziché restare seduto a scorrere, automatizzare l'esecuzione toglie il grafico dal percorso critico. PickMyTrade collega i suoi alert di TradingView direttamente al suo conto Tradovate, così i suoi setup scattano nel momento in cui si attivano, che lei abbia o meno la finestra giusta in primo piano." },
  ] },
  ctaHeading: { en: "Trade the Moment It Triggers", de: "Handeln Sie genau in dem Moment, in dem es auslöst", es: "Opere en el momento exacto en que se activa", fr: "Tradez à l'instant même où le signal se déclenche", it: "Operi nel momento esatto in cui scatta il segnale" },
  ctaText: { en: "PickMyTrade links your TradingView alerts straight to your Tradovate account, so setups fire whether or not you're scrolled to the right window.", de: "PickMyTrade verbindet Ihre TradingView-Alerts direkt mit Ihrem Tradovate-Konto, sodass Setups auslösen, egal ob Sie gerade im richtigen Zeitfenster gescrollt haben oder nicht.", es: "PickMyTrade conecta sus alertas de TradingView directamente con su cuenta de Tradovate, de modo que sus configuraciones se ejecutan estén o no desplazadas a la ventana correcta.", fr: "PickMyTrade relie vos alertes TradingView directement à votre compte Tradovate : vos configurations se déclenchent, que vous soyez ou non positionné sur la bonne fenêtre.", it: "PickMyTrade collega i suoi alert di TradingView direttamente al suo conto Tradovate, così i setup scattano a prescindere dal fatto che lei sia posizionato sulla finestra giusta." },
  ctaButtonText: { en: "Start Your Free Trial", de: "Starten Sie Ihre kostenlose Testphase", es: "Comience su prueba gratuita", fr: "Commencez votre essai gratuit", it: "Inizi la prova gratuita" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Can I make Tradovate charts load a full year of 1-minute data?", a: "Not directly on the chart. Intraday bars are capped at roughly the last 90 days, so a full year of 1-minute history isn't available through normal charting. For anything older, work on a higher timeframe or pull data another way." },
    { q: "Is there a way to type in a date instead of scrolling?", a: "Not on a standard chart. There's no jump-to-date box, so you either drag back or use Market Replay, which lets you set an exact start date and time." },
  ], de: [
    { q: "Kann ich Tradovate-Charts dazu bringen, ein ganzes Jahr an 1-Minuten-Daten zu laden?", a: "Nicht direkt im Chart. Intraday-Kerzen sind auf etwa die letzten 90 Tage begrenzt, daher ist ein ganzes Jahr an 1-Minuten-Historie über das normale Charting nicht verfügbar. Für ältere Daten arbeiten Sie mit einem höheren Zeitrahmen oder beziehen die Daten auf anderem Weg." },
    { q: "Gibt es eine Möglichkeit, ein Datum einzugeben, statt zu scrollen?", a: "Nicht in einem Standard-Chart. Es gibt kein Feld zum Springen zu einem Datum, daher ziehen Sie entweder zurück oder nutzen Market Replay, womit Sie ein exaktes Startdatum und eine exakte Uhrzeit festlegen können." },
  ], es: [
    { q: "¿Puedo hacer que los gráficos de Tradovate carguen un año completo de datos de 1 minuto?", a: "No directamente en el gráfico. Las velas intradía están limitadas a aproximadamente los últimos 90 días, por lo que un año completo de historial de 1 minuto no está disponible mediante los gráficos normales. Para datos más antiguos, trabaje con una temporalidad mayor u obtenga los datos por otra vía." },
    { q: "¿Hay forma de escribir una fecha en lugar de desplazarme?", a: "No en un gráfico estándar. No existe un cuadro para saltar a una fecha, así que o arrastra hacia atrás o usa Market Replay, que le permite fijar una fecha y hora de inicio exactas." },
  ], fr: [
    { q: "Puis-je faire charger à mes graphiques Tradovate une année complète de données 1 minute ?", a: "Pas directement sur le graphique. Les bougies intraday sont plafonnées aux 90 derniers jours environ, donc une année complète d'historique 1 minute n'est pas disponible via le graphique habituel. Pour des données plus anciennes, travaillez sur une unité de temps supérieure ou récupérez les données autrement." },
    { q: "Existe-t-il un moyen de saisir une date au lieu de faire défiler ?", a: "Pas sur un graphique standard. Il n'y a pas de champ pour aller à une date : vous faites donc glisser le graphique en arrière, ou vous utilisez Market Replay, qui vous permet de définir une date et une heure de début exactes." },
  ], it: [
    { q: "Posso far caricare ai grafici di Tradovate un intero anno di dati a 1 minuto?", a: "Non direttamente sul grafico. Le candele intraday sono limitate agli ultimi 90 giorni circa, quindi un intero anno di storico a 1 minuto non è disponibile con il normale charting. Per dati più vecchi, lavori su un timeframe superiore oppure ottenga i dati in un altro modo." },
    { q: "Esiste un modo per digitare una data invece di scorrere?", a: "Non su un grafico standard. Non c'è una casella per saltare a una data, quindi o trascini all'indietro oppure usi Market Replay, che le permette di impostare data e ora di inizio esatte." },
  ] },
  relatedHeading: { en: "Related Guides", de: "Verwandte Anleitungen", es: "Guías relacionadas", fr: "Guides associés", it: "Guide correlate" },
