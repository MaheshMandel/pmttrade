---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "1099-pdf-password-protected";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Tradovate 1099 PDF Password-Protected (Use SSN)";
const META_DESCRIPTION =
  "Tradovate 1099 PDF asking for a password? Open it with your 9-digit Social Security Number, no dashes. Account-type passwords, steps, and fixes.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate-1099-PDF passwortgeschützt (SSN verwenden)", es: "PDF 1099 de Tradovate protegido con contraseña (use el SSN)", fr: "PDF 1099 Tradovate protégé par mot de passe (utilisez le SSN)", it: "PDF 1099 di Tradovate protetto da password (usi l'SSN)" },
  dek: { en: "Your Tradovate 1099 PDF won't open without a password nobody emailed you. Here's the exact number to type for your account type, and what to check if it still gets rejected.", de: "Ihre Tradovate-1099-PDF lässt sich nicht ohne ein Passwort öffnen, das Ihnen niemand geschickt hat. Hier steht die genaue Nummer für Ihren Kontotyp und was Sie prüfen sollten, wenn sie trotzdem abgelehnt wird.", es: "Su PDF 1099 de Tradovate no se abre sin una contraseña que nadie le envió. Aquí está el número exacto que debe escribir según su tipo de cuenta y qué revisar si aun así es rechazado.", fr: "Votre PDF 1099 Tradovate ne s'ouvre pas sans un mot de passe que personne ne vous a envoyé. Voici le numéro exact à saisir selon votre type de compte, et les points à vérifier s'il est toujours refusé.", it: "Il suo PDF 1099 di Tradovate non si apre senza una password che nessuno le ha inviato. Ecco il numero esatto da digitare per il suo tipo di conto e cosa controllare se viene comunque rifiutato." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-08",
  heroImage: { src: `${IMG}/1099-pdf-password-protected-1.png`, alt: { en: "PDF reader showing a password prompt when opening a Tradovate 1099 tax form", de: "PDF reader showing a password prompt when opening a Tradovate 1099 tax form", es: "PDF reader showing a password prompt when opening a Tradovate 1099 tax form", fr: "PDF reader showing a password prompt when opening a Tradovate 1099 tax form", it: "PDF reader showing a password prompt when opening a Tradovate 1099 tax form" } },
  blocks: { en: [
    { type: "paragraph", html: "You finally tracked down your Tradovate 1099, clicked to open it, and instead of your tax numbers you got a password box staring back at you. No password was emailed, nothing on the download page mentions one, and tax season doesn't exactly leave room for guessing games. Here's the fast answer: for an individual account, the password is your <strong class='text-white'>Social Security Number typed as nine digits with no dashes and no spaces</strong>. So if your SSN is 123-45-6789, you type <strong class='text-white'>123456789</strong>. That's it, the file opens, and you can get on with filing." },
    { type: "paragraph", html: "Below I'll cover exactly why the PDF is locked, the right password for every account type (LLC, Trust, and IRA are different), and what to do when the number you're sure is correct still gets rejected." },
    {
      type: "checklist",
      heading: "Quick Fix for the Password Prompt",
      items: [
        "<strong class='text-white'>Individual account:</strong> enter your <strong class='text-white'>full 9-digit SSN, no dashes, no spaces</strong> (123456789, not 123-45-6789).",
        "<strong class='text-white'>Type it, don't paste it</strong>, a copied value can drag in a hidden space that breaks the match.",
        "<strong class='text-white'>Open it on a desktop</strong> in a real PDF reader (Adobe Acrobat Reader, Preview), not a phone or a browser preview pane.",
        "<strong class='text-white'>If nine digits fail,</strong> try the <strong class='text-white'>last four digits</strong> of the SSN, a few tax documents use that shorter format.",
        "<strong class='text-white'>Business or retirement account?</strong> The password is an EIN, not your personal SSN. See the table below.",
        "<strong class='text-white'>Still stuck?</strong> Confirm the exact format with Tradovate support before you assume the file is corrupt.",
      ],
    },
    { type: "heading", text: "Why Your Tradovate 1099 Is Password-Protected" },
    { type: "paragraph", html: "This isn't a glitch, and your download didn't come through broken. A 1099 is one of the most sensitive documents you'll handle all year, it carries your name, your tax ID, and a full accounting of your trading proceeds. To protect that, the PDF ships <strong class='text-white'>encrypted</strong>, and the encryption key is tied to the tax identifier on the account." },
    { type: "paragraph", html: "The logic is simple. Tax forms get emailed, saved to shared drives, and forwarded to accountants. If an unencrypted 1099 landed in the wrong inbox, anyone could read it. By locking the file to the number that only the account holder should know, the document stays useless to anyone who isn't you. It's the same approach most brokerages and clearing firms use for year-end tax statements, so if you trade at more than one shop, you've probably hit this prompt before." },
    { type: "paragraph", html: "The catch is that the password almost never shows up next to the download link, and no email spells it out. That silence is what sends most people hunting, not the encryption itself, just the missing instruction that the key is your own tax ID." },
    { type: "heading", text: "The Right Password for Each Account Type" },
    { type: "paragraph", html: "The identifier depends on how the account is registered. Get this part right and the file opens on the first try. In every case, strip out the dashes and spaces, you want a plain run of digits." },
    {
      type: "table",
      headers: ["Account type", "Password to enter", "Format"],
      rows: [
        ["<strong class='text-white'>Individual</strong>", "Your Social Security Number", "9 digits, no dashes (123456789)"],
        ["<strong class='text-white'>LLC / business</strong>", "The company's EIN", "9 digits, no dashes"],
        ["<strong class='text-white'>Trust</strong>", "SSN of the individual who opened the account", "9 digits, no dashes"],
        ["<strong class='text-white'>IRA</strong>", "Your custodian's EIN (not your personal SSN)", "9 digits, no dashes"],
      ],
    },
    { type: "paragraph", html: "One note on IRAs: the password is the <strong class='text-white'>custodian's</strong> EIN, so it's a number your retirement-account custodian holds, not your own SSN. If you don't have it written down, your custodian can give it to you, it's the same EIN used across your account paperwork. Different custodians have different EINs, so grab yours from your account's own documents rather than a number you saw quoted somewhere online." },
    { type: "heading", text: "How to Open the Locked 1099, Step by Step" },
    {
      type: "steps",
      items: [
        { title: "Download the file to your computer first", html: "Don't try to open the 1099 inside the download pop-up or a browser preview. Save it to your desktop or Downloads folder first. Browser preview panes and quick-look windows sometimes mishandle the password layer, and you'll get a vague error instead of a clean prompt. Downloading first gives you a normal, well-behaved PDF to work with." },
        { title: "Open it in a proper PDF reader", html: "Use a full desktop reader, Adobe Acrobat Reader on Windows, or Preview on a Mac both work fine. Make sure the reader is <strong class='text-white'>up to date</strong>; an old version can choke on the encryption and throw a misleading &ldquo;damaged file&rdquo; message when the file is perfectly fine. Avoid opening the 1099 on a phone or tablet for this step. Mobile PDF viewers are the most common reason a correct password appears to &ldquo;not work.&rdquo;" },
        { title: "Type your tax ID as the password", html: "When the box appears, enter the identifier for your account type from the table above, for most people, that's the <strong class='text-white'>9-digit SSN with no dashes</strong>. Type it by hand instead of pasting. A pasted value can carry an invisible trailing space, and the reader will reject it without telling you why. Double-check that you haven't accidentally added dashes out of habit (123-45-6789 will fail; 123456789 will work)." },
        { title: "Save an unlocked copy for your accountant", html: "Once the file opens, you may want a copy you can share without handing over your SSN every time. In most readers you can print the open document to a new PDF, or use the reader's &ldquo;remove security&rdquo; option, to save a version that no longer prompts for a password. Keep that unlocked copy somewhere private, it's convenient for your accountant, but it's still your full tax statement, so treat it accordingly." },
      ],
    },
    { type: "image", src: `${IMG}/1099-pdf-password-protected-3.png`, alt: "Unlocked Tradovate 1099-B tax form displayed after entering the correct password" },
    { type: "heading", text: "When the Password Still Won't Work" },
    { type: "paragraph", html: "If you're certain you've got the right number and the file still won't budge, run through this list before deciding something's broken." },
    {
      type: "table",
      headers: ["Symptom", "Likely cause", "Fix"],
      rows: [
        ["Password rejected even though the SSN is right", "Dashes or spaces got included", "Enter 9 digits only, no dashes, no spaces (123456789)"],
        ["&ldquo;Damaged&rdquo; or &ldquo;can't open&rdquo; error", "Outdated or incompatible PDF reader", "Update Acrobat Reader / Preview, or try a different desktop reader"],
        ["Prompt loops or won't accept anything on a phone", "Mobile PDF viewer mishandling encryption", "Open the file on a laptop or desktop instead"],
        ["SSN fails on a business account", "Wrong identifier for the account type", "Use the company EIN (LLC) or custodian EIN (IRA), no dashes"],
        ["Full 9 digits rejected", "Document uses the short format", "Try the last 4 digits of the SSN"],
        ["Nothing works after all of the above", "Unusual registration or a re-issued form", "Contact Tradovate support to confirm the exact password for your account"],
      ],
    },
    { type: "paragraph", html: "One more thing worth knowing: whether a given tax year's 1099 arrives encrypted can change over time. Older tax-year PDFs have been sent out as password-protected files. If a more recent download opens with no prompt at all, that's not a mistake, and if it does prompt, the tax-ID rule for your account type still applies. When in doubt, confirm the current process against Tradovate's own tax-form documentation." },
    { type: "image", src: `${IMG}/1099-pdf-password-protected-4.png`, alt: "Tradovate reports section showing the 1099 tax form download for a selected tax year" },
    { type: "heading", text: "Can't Find the 1099 to Begin With?" },
    { type: "paragraph", html: "If the password isn't your problem because you can't even locate the form, the 1099 lives in the reports area of your <strong class='text-white'>live</strong> Tradovate account, a simulated or demo account won't have one. Log in, open the Reports (or account/tax documents) section, pick the tax year you need, and download the PDF. The exact menu wording shifts from time to time, so hunt for the reports or statements area rather than a button labeled word-for-word the way an old guide describes it. For the full walk-through, see <a href='https://pickmytrade.trade/how-to/tradovate-1099-tax-form/'>Find &amp; Download Your Tradovate 1099 Tax Form</a>." },
    { type: "heading", text: "Keep Your Trading on Autopilot Year-Round with PickMyTrade" },
    { type: "paragraph", html: "Tax paperwork is a once-a-year headache. Your execution shouldn't be a daily one. PickMyTrade takes the strategies you already run on TradingView and fires them straight into Tradovate, so you're not glued to a screen waiting to click:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>TradingView-to-Tradovate automation</strong>, your alerts become live orders without manual entry.",
        "<strong class='text-white'>Set-and-forget execution</strong>, trades fire even when you've stepped away from the desk.",
        "<strong class='text-white'>Quantity &amp; risk controls</strong>, keep automated orders inside your account's position and risk limits.",
        "<strong class='text-white'>Multi-account sync</strong>, mirror one setup across every account you trade.",
      ],
    },
  ], de: [
    { type: "paragraph",html: "Sie haben endlich Ihre Tradovate-1099 gefunden, klicken zum Öffnen und statt Ihrer Steuerzahlen sehen Sie ein Passwortfeld. Es wurde kein Passwort per E-Mail verschickt, auf der Download-Seite steht nichts davon, und in der Steuersaison hat man keine Zeit für Ratespiele. Die schnelle Antwort: Bei einem Einzelkonto ist das Passwort Ihre <strong class='text-white'>Social Security Number, eingegeben als neun Ziffern ohne Bindestriche und ohne Leerzeichen</strong>. Lautet Ihre SSN also 123-45-6789, geben Sie <strong class='text-white'>123456789</strong> ein. Das war's, die Datei öffnet sich und Sie können mit Ihrer Steuererklärung weitermachen." },
    { type: "paragraph",html: "Im Folgenden erkläre ich, warum die PDF gesperrt ist, welches Passwort für jeden Kontotyp gilt (LLC, Trust und IRA unterscheiden sich) und was Sie tun können, wenn die Nummer, die Sie für korrekt halten, trotzdem abgelehnt wird." },
    {
      type: "checklist",
      heading: "Schnelle Lösung für die Passwortabfrage",
      items: [
        "<strong class='text-white'>Einzelkonto:</strong> Geben Sie Ihre <strong class='text-white'>vollständige 9-stellige SSN ohne Bindestriche und ohne Leerzeichen</strong> ein (123456789, nicht 123-45-6789).",
        "<strong class='text-white'>Tippen Sie es ein, fügen Sie es nicht ein</strong>, denn ein kopierter Wert kann ein verstecktes Leerzeichen enthalten, das den Abgleich verhindert.",
        "<strong class='text-white'>Öffnen Sie die Datei an einem Desktop-Rechner</strong> in einem richtigen PDF-Programm (Adobe Acrobat Reader, Vorschau), nicht auf dem Smartphone oder in einer Browser-Vorschau.",
        "<strong class='text-white'>Wenn neun Ziffern fehlschlagen,</strong> versuchen Sie die <strong class='text-white'>letzten vier Ziffern</strong> der SSN, einige Steuerdokumente verwenden dieses kürzere Format.",
        "<strong class='text-white'>Geschäfts- oder Altersvorsorgekonto?</strong> Das Passwort ist eine EIN, nicht Ihre persönliche SSN. Siehe die Tabelle unten.",
        "<strong class='text-white'>Immer noch ratlos?</strong> Lassen Sie sich das genaue Format vom Tradovate-Support bestätigen, bevor Sie davon ausgehen, dass die Datei beschädigt ist.",
      ],
    },
    { type: "heading",text: "Warum Ihre Tradovate-1099 passwortgeschützt ist" },
    { type: "paragraph",html: "Das ist keine Störung, und Ihr Download ist nicht fehlerhaft angekommen. Eine 1099 ist eines der sensibelsten Dokumente, mit denen Sie im Laufe des Jahres zu tun haben: Sie enthält Ihren Namen, Ihre Steuer-ID und eine vollständige Aufstellung Ihrer Handelserlöse. Zum Schutz wird die PDF <strong class='text-white'>verschlüsselt</strong> ausgeliefert, und der Schlüssel ist an die Steuerkennung des Kontos gebunden." },
    { type: "paragraph",html: "Die Logik ist einfach. Steuerformulare werden per E-Mail verschickt, auf gemeinsamen Laufwerken gespeichert und an Steuerberater weitergeleitet. Würde eine unverschlüsselte 1099 im falschen Posteingang landen, könnte jeder sie lesen. Indem die Datei an die Nummer gebunden wird, die nur der Kontoinhaber kennen sollte, bleibt das Dokument für alle anderen nutzlos. Die meisten Broker und Clearingstellen gehen bei Jahressteuerauszügen genauso vor. Wenn Sie bei mehr als einem Anbieter handeln, ist Ihnen diese Abfrage wahrscheinlich schon begegnet." },
    { type: "paragraph",html: "Der Haken: Das Passwort steht fast nie neben dem Download-Link, und keine E-Mail nennt es. Dieses Schweigen lässt die meisten suchen, nicht die Verschlüsselung selbst, sondern der fehlende Hinweis, dass der Schlüssel Ihre eigene Steuer-ID ist." },
    { type: "heading",text: "Das richtige Passwort für jeden Kontotyp" },
    { type: "paragraph",html: "Die Kennung hängt davon ab, wie das Konto registriert ist. Wenn Sie das richtig machen, öffnet sich die Datei beim ersten Versuch. Entfernen Sie in jedem Fall Bindestriche und Leerzeichen, Sie benötigen eine reine Ziffernfolge." },
    { type: "table", headers: ["Kontotyp","Einzugebendes Passwort","Format"], rows: [
      ["<strong class='text-white'>Einzelkonto</strong>","Ihre Social Security Number","9 Ziffern, keine Bindestriche (123456789)"],
      ["<strong class='text-white'>LLC / Unternehmen</strong>","Die EIN des Unternehmens","9 Ziffern, keine Bindestriche"],
      ["<strong class='text-white'>Trust</strong>","SSN der Person, die das Konto eröffnet hat","9 Ziffern, keine Bindestriche"],
      ["<strong class='text-white'>IRA</strong>","EIN Ihres Verwahrers (nicht Ihre persönliche SSN)","9 Ziffern, keine Bindestriche"],
    ] },
    { type: "paragraph",html: "Ein Hinweis zu IRAs: Das Passwort ist die EIN des <strong class='text-white'>Verwahrers</strong>, also eine Nummer, die Ihr Altersvorsorge-Verwahrer führt, nicht Ihre eigene SSN. Wenn Sie sie nicht notiert haben, kann Ihr Verwahrer sie Ihnen mitteilen. Es ist dieselbe EIN, die in Ihren Kontounterlagen verwendet wird. Verschiedene Verwahrer haben unterschiedliche EINs, entnehmen Sie Ihre daher den eigenen Kontounterlagen und nicht einer Nummer, die Sie irgendwo online gesehen haben." },
    { type: "heading",text: "So öffnen Sie die gesperrte 1099 Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Laden Sie die Datei zuerst auf Ihren Computer herunter", html: "Versuchen Sie nicht, die 1099 im Download-Popup oder in einer Browser-Vorschau zu öffnen. Speichern Sie sie zuerst auf Ihrem Desktop oder im Ordner Downloads. Browser-Vorschaufenster und Schnellansichten verarbeiten die Passwortebene manchmal fehlerhaft, und Sie erhalten eine unklare Fehlermeldung statt einer sauberen Abfrage. Wenn Sie zuerst herunterladen, arbeiten Sie mit einer normalen, zuverlässigen PDF." },
        { title: "Öffnen Sie sie in einem richtigen PDF-Programm", html: "Verwenden Sie ein vollwertiges Desktop-Programm, Adobe Acrobat Reader unter Windows oder Vorschau auf dem Mac funktionieren beide einwandfrei. Achten Sie darauf, dass das Programm <strong class='text-white'>auf dem neuesten Stand</strong> ist; eine alte Version kann an der Verschlüsselung scheitern und eine irreführende Meldung &ldquo;Datei beschädigt&rdquo; anzeigen, obwohl die Datei völlig in Ordnung ist. Öffnen Sie die 1099 für diesen Schritt nicht auf einem Smartphone oder Tablet. Mobile PDF-Viewer sind der häufigste Grund, warum ein korrektes Passwort scheinbar &ldquo;nicht funktioniert&rdquo;." },
        { title: "Geben Sie Ihre Steuer-ID als Passwort ein", html: "Wenn das Feld erscheint, geben Sie die Kennung für Ihren Kontotyp aus der Tabelle oben ein, für die meisten ist das die <strong class='text-white'>9-stellige SSN ohne Bindestriche</strong>. Tippen Sie sie von Hand ein, statt sie einzufügen. Ein eingefügter Wert kann ein unsichtbares Leerzeichen am Ende enthalten, und das Programm lehnt ihn ab, ohne den Grund zu nennen. Prüfen Sie, dass Sie nicht aus Gewohnheit Bindestriche eingegeben haben (123-45-6789 schlägt fehl; 123456789 funktioniert)." },
        { title: "Speichern Sie eine entsperrte Kopie für Ihren Steuerberater", html: "Sobald sich die Datei öffnet, möchten Sie vielleicht eine Kopie, die Sie weitergeben können, ohne jedes Mal Ihre SSN preiszugeben. In den meisten PDF-Programmen können Sie das geöffnete Dokument in eine neue PDF drucken oder die Option &ldquo;Sicherheit entfernen&rdquo; verwenden, um eine Version zu speichern, die kein Passwort mehr abfragt. Bewahren Sie diese entsperrte Kopie an einem privaten Ort auf, für Ihren Steuerberater ist sie praktisch, aber es bleibt Ihre vollständige Steuerauskunft, behandeln Sie sie entsprechend." },
      ],
    },
    { type: "image",src: `${IMG}/1099-pdf-password-protected-3.png`,alt: "Entsperrtes Tradovate-1099-B-Steuerformular, das nach Eingabe des korrekten Passworts angezeigt wird" },
    { type: "heading",text: "Wenn das Passwort trotzdem nicht funktioniert" },
    { type: "paragraph",html: "Wenn Sie sicher sind, die richtige Nummer zu verwenden, und sich die Datei dennoch nicht öffnen lässt, gehen Sie diese Liste durch, bevor Sie von einem Defekt ausgehen." },
    { type: "table", headers: ["Symptom","Wahrscheinliche Ursache","Lösung"], rows: [
      ["Passwort wird abgelehnt, obwohl die SSN stimmt","Bindestriche oder Leerzeichen wurden mit eingegeben","Nur 9 Ziffern eingeben, keine Bindestriche, keine Leerzeichen (123456789)"],
      ["Fehlermeldung &ldquo;beschädigt&rdquo; oder &ldquo;kann nicht geöffnet werden&rdquo;","Veraltetes oder inkompatibles PDF-Programm","Acrobat Reader / Vorschau aktualisieren oder ein anderes Desktop-Programm ausprobieren"],
      ["Abfrage wiederholt sich oder nimmt auf dem Smartphone nichts an","Mobiler PDF-Viewer verarbeitet die Verschlüsselung fehlerhaft","Datei stattdessen auf einem Laptop oder Desktop-Rechner öffnen"],
      ["SSN schlägt bei einem Geschäftskonto fehl","Falsche Kennung für den Kontotyp","Die EIN des Unternehmens (LLC) oder die EIN des Verwahrers (IRA) verwenden, ohne Bindestriche"],
      ["Alle 9 Ziffern werden abgelehnt","Dokument verwendet das kurze Format","Die letzten 4 Ziffern der SSN versuchen"],
      ["Nichts funktioniert nach alledem","Ungewöhnliche Registrierung oder neu ausgestelltes Formular","Tradovate-Support kontaktieren, um das genaue Passwort für Ihr Konto bestätigen zu lassen"],
    ] },
    { type: "paragraph",html: "Noch ein wichtiger Hinweis: Ob die 1099 eines bestimmten Steuerjahres verschlüsselt ankommt, kann sich im Laufe der Zeit ändern. PDFs älterer Steuerjahre wurden als passwortgeschützte Dateien versandt. Wenn sich ein neuerer Download ohne jede Abfrage öffnet, ist das kein Fehler, und wenn eine Abfrage erscheint, gilt weiterhin die Steuer-ID-Regel für Ihren Kontotyp. Im Zweifel gleichen Sie das aktuelle Verfahren mit der eigenen Dokumentation von Tradovate zu Steuerformularen ab." },
    { type: "image",src: `${IMG}/1099-pdf-password-protected-4.png`,alt: "Tradovate-Bereich Reports mit dem Download des 1099-Steuerformulars für ein ausgewähltes Steuerjahr" },
    { type: "heading",text: "Sie finden die 1099 gar nicht erst?" },
    { type: "paragraph",html: "Wenn das Passwort nicht Ihr Problem ist, weil Sie das Formular gar nicht finden: Die 1099 befindet sich im Berichtsbereich Ihres <strong class='text-white'>Live</strong>-Tradovate-Kontos, ein Simulations- oder Demokonto hat keine. Melden Sie sich an, öffnen Sie den Bereich Reports (bzw. Konto-/Steuerdokumente), wählen Sie das gewünschte Steuerjahr und laden Sie die PDF herunter. Die genaue Menübezeichnung ändert sich gelegentlich, suchen Sie daher nach dem Bereich für Berichte oder Kontoauszüge statt nach einer Schaltfläche, die wörtlich so heißt, wie es eine alte Anleitung beschreibt. Die vollständige Anleitung finden Sie unter <a href='https://pickmytrade.trade/how-to/tradovate-1099-tax-form/'>Tradovate-1099-Steuerformular finden &amp; herunterladen</a>." },
    { type: "heading",text: "Halten Sie Ihren Handel mit PickMyTrade das ganze Jahr über im Autopilot" },
    { type: "paragraph",html: "Steuerunterlagen sind ein Ärgernis, das nur einmal im Jahr auftritt. Ihre Ausführung sollte nicht täglich eines sein. PickMyTrade nimmt die Strategien, die Sie bereits in TradingView betreiben, und sendet sie direkt an Tradovate, damit Sie nicht an den Bildschirm gefesselt sind und aufs Klicken warten:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>TradingView-zu-Tradovate-Automatisierung</strong>, Ihre Alerts werden ohne manuelle Eingabe zu Live-Orders.",
        "<strong class='text-white'>Set-and-forget-Ausführung</strong>, Trades werden auch dann ausgelöst, wenn Sie sich vom Schreibtisch entfernt haben.",
        "<strong class='text-white'>Mengen- &amp; Risikokontrollen</strong>, halten Sie automatisierte Orders innerhalb der Positions- und Risikolimits Ihres Kontos.",
        "<strong class='text-white'>Multi-Konto-Synchronisierung</strong>, spiegeln Sie ein Setup auf alle Konten, die Sie handeln.",
      ],
    },
  ], es: [
    { type: "paragraph",html: "Por fin encontró su 1099 de Tradovate, hizo clic para abrirlo y, en lugar de sus cifras fiscales, apareció un cuadro de contraseña. No le enviaron ninguna contraseña por correo, la página de descarga no menciona nada y en temporada de impuestos no hay tiempo para adivinar. La respuesta rápida: para una cuenta individual, la contraseña es su <strong class='text-white'>Social Security Number escrito como nueve dígitos sin guiones ni espacios</strong>. Si su SSN es 123-45-6789, escriba <strong class='text-white'>123456789</strong>. Eso es todo: el archivo se abre y puede continuar con su declaración." },
    { type: "paragraph",html: "A continuación explico exactamente por qué el PDF está bloqueado, cuál es la contraseña correcta para cada tipo de cuenta (LLC, Trust e IRA son diferentes) y qué hacer cuando el número que usted cree correcto sigue siendo rechazado." },
    {
      type: "checklist",
      heading: "Solución rápida para la solicitud de contraseña",
      items: [
        "<strong class='text-white'>Cuenta individual:</strong> introduzca su <strong class='text-white'>SSN completo de 9 dígitos, sin guiones ni espacios</strong> (123456789, no 123-45-6789).",
        "<strong class='text-white'>Escríbalo, no lo pegue</strong>, un valor copiado puede arrastrar un espacio oculto que impide la coincidencia.",
        "<strong class='text-white'>Ábralo en un ordenador</strong> con un lector de PDF real (Adobe Acrobat Reader, Vista Previa), no en un teléfono ni en un panel de vista previa del navegador.",
        "<strong class='text-white'>Si fallan los nueve dígitos,</strong> pruebe con los <strong class='text-white'>últimos cuatro dígitos</strong> del SSN, algunos documentos fiscales usan ese formato más corto.",
        "<strong class='text-white'>¿Cuenta empresarial o de jubilación?</strong> La contraseña es un EIN, no su SSN personal. Consulte la tabla de abajo.",
        "<strong class='text-white'>¿Sigue sin funcionar?</strong> Confirme el formato exacto con el soporte de Tradovate antes de suponer que el archivo está dañado.",
      ],
    },
    { type: "heading",text: "Por qué su 1099 de Tradovate está protegido con contraseña" },
    { type: "paragraph",html: "Esto no es un fallo, y su descarga no llegó dañada. Un 1099 es uno de los documentos más sensibles que manejará en todo el año: contiene su nombre, su identificación fiscal y un desglose completo de los ingresos de su operativa. Para protegerlo, el PDF se entrega <strong class='text-white'>cifrado</strong>, y la clave de cifrado está vinculada al identificador fiscal de la cuenta." },
    { type: "paragraph",html: "La lógica es sencilla. Los formularios fiscales se envían por correo, se guardan en unidades compartidas y se reenvían a contadores. Si un 1099 sin cifrar llegara a una bandeja de entrada equivocada, cualquiera podría leerlo. Al bloquear el archivo con el número que solo debería conocer el titular de la cuenta, el documento resulta inútil para cualquier otra persona. Es el mismo enfoque que usan la mayoría de los brokers y casas de compensación para los estados fiscales de fin de año, así que si opera con más de una firma, probablemente ya se ha encontrado con esta solicitud." },
    { type: "paragraph",html: "El problema es que la contraseña casi nunca aparece junto al enlace de descarga y ningún correo la indica. Ese silencio es lo que lleva a la mayoría a buscar, no el cifrado en sí, sino la falta de la indicación de que la clave es su propia identificación fiscal." },
    { type: "heading",text: "La contraseña correcta para cada tipo de cuenta" },
    { type: "paragraph",html: "El identificador depende de cómo esté registrada la cuenta. Si acierta en esto, el archivo se abre a la primera. En todos los casos, elimine los guiones y los espacios, necesita una serie simple de dígitos." },
    { type: "table", headers: ["Tipo de cuenta","Contraseña que debe introducir","Formato"], rows: [
      ["<strong class='text-white'>Individual</strong>","Su Social Security Number","9 dígitos, sin guiones (123456789)"],
      ["<strong class='text-white'>LLC / empresa</strong>","El EIN de la empresa","9 dígitos, sin guiones"],
      ["<strong class='text-white'>Trust</strong>","SSN de la persona que abrió la cuenta","9 dígitos, sin guiones"],
      ["<strong class='text-white'>IRA</strong>","El EIN de su custodio (no su SSN personal)","9 dígitos, sin guiones"],
    ] },
    { type: "paragraph",html: "Una nota sobre las IRA: la contraseña es el EIN del <strong class='text-white'>custodio</strong>, es decir, un número que posee el custodio de su cuenta de jubilación, no su propio SSN. Si no lo tiene anotado, su custodio puede facilitárselo; es el mismo EIN que aparece en la documentación de su cuenta. Cada custodio tiene un EIN distinto, así que tómelo de los documentos de su propia cuenta y no de un número que haya visto citado en internet." },
    { type: "heading",text: "Cómo abrir el 1099 bloqueado, paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Descargue primero el archivo en su ordenador", html: "No intente abrir el 1099 dentro de la ventana emergente de descarga ni en una vista previa del navegador. Guárdelo primero en el escritorio o en la carpeta Descargas. Los paneles de vista previa del navegador y las ventanas de vista rápida a veces gestionan mal la capa de contraseña y obtendrá un error vago en lugar de una solicitud limpia. Al descargarlo primero, trabaja con un PDF normal y bien comportado." },
        { title: "Ábralo en un lector de PDF adecuado", html: "Use un lector de escritorio completo; Adobe Acrobat Reader en Windows o Vista Previa en Mac funcionan bien. Asegúrese de que el lector esté <strong class='text-white'>actualizado</strong>; una versión antigua puede fallar con el cifrado y mostrar un mensaje engañoso de &ldquo;archivo dañado&rdquo; cuando el archivo está perfectamente bien. Evite abrir el 1099 en un teléfono o tableta para este paso. Los visores de PDF móviles son la causa más común de que una contraseña correcta parezca &ldquo;no funcionar&rdquo;." },
        { title: "Escriba su identificación fiscal como contraseña", html: "Cuando aparezca el cuadro, introduzca el identificador de su tipo de cuenta de la tabla anterior; para la mayoría de las personas es el <strong class='text-white'>SSN de 9 dígitos sin guiones</strong>. Escríbalo a mano en lugar de pegarlo. Un valor pegado puede llevar un espacio final invisible, y el lector lo rechazará sin decirle por qué. Compruebe que no ha añadido guiones por costumbre (123-45-6789 fallará; 123456789 funcionará)." },
        { title: "Guarde una copia desbloqueada para su contador", html: "Una vez abierto el archivo, quizá quiera una copia que pueda compartir sin entregar su SSN cada vez. En la mayoría de los lectores puede imprimir el documento abierto a un nuevo PDF, o usar la opción &ldquo;quitar seguridad&rdquo; del lector, para guardar una versión que ya no solicite contraseña. Guarde esa copia desbloqueada en un lugar privado; es cómoda para su contador, pero sigue siendo su declaración fiscal completa, así que trátela en consecuencia." },
      ],
    },
    { type: "image",src: `${IMG}/1099-pdf-password-protected-3.png`,alt: "Formulario fiscal 1099-B de Tradovate desbloqueado, mostrado tras introducir la contraseña correcta" },
    { type: "heading",text: "Cuando la contraseña sigue sin funcionar" },
    { type: "paragraph",html: "Si está seguro de que tiene el número correcto y el archivo sigue sin abrirse, repase esta lista antes de concluir que algo está roto." },
    { type: "table", headers: ["Síntoma","Causa probable","Solución"], rows: [
      ["Contraseña rechazada aunque el SSN es correcto","Se incluyeron guiones o espacios","Introduzca solo 9 dígitos, sin guiones ni espacios (123456789)"],
      ["Error de &ldquo;dañado&rdquo; o &ldquo;no se puede abrir&rdquo;","Lector de PDF obsoleto o incompatible","Actualice Acrobat Reader / Vista Previa o pruebe con otro lector de escritorio"],
      ["La solicitud se repite o no acepta nada en un teléfono","El visor de PDF móvil gestiona mal el cifrado","Abra el archivo en un portátil o en un ordenador de escritorio"],
      ["El SSN falla en una cuenta empresarial","Identificador incorrecto para el tipo de cuenta","Use el EIN de la empresa (LLC) o el EIN del custodio (IRA), sin guiones"],
      ["Se rechazan los 9 dígitos completos","El documento usa el formato corto","Pruebe con los últimos 4 dígitos del SSN"],
      ["Nada funciona después de todo lo anterior","Registro inusual o formulario reemitido","Contacte con el soporte de Tradovate para confirmar la contraseña exacta de su cuenta"],
    ] },
    { type: "paragraph",html: "Una cosa más que conviene saber: que el 1099 de un año fiscal determinado llegue cifrado puede cambiar con el tiempo. Los PDF de años fiscales anteriores se han enviado como archivos protegidos con contraseña. Si una descarga más reciente se abre sin ninguna solicitud, no es un error, y si la solicita, la regla de la identificación fiscal para su tipo de cuenta sigue aplicándose. En caso de duda, confirme el proceso vigente en la propia documentación de formularios fiscales de Tradovate." },
    { type: "image",src: `${IMG}/1099-pdf-password-protected-4.png`,alt: "Sección Reports de Tradovate que muestra la descarga del formulario fiscal 1099 para un año fiscal seleccionado" },
    { type: "heading",text: "¿No encuentra el 1099 para empezar?" },
    { type: "paragraph",html: "Si la contraseña no es su problema porque ni siquiera encuentra el formulario, el 1099 se encuentra en el área de informes de su cuenta <strong class='text-white'>real</strong> de Tradovate; una cuenta simulada o de demostración no tiene ninguno. Inicie sesión, abra la sección Reports (o documentos de cuenta/fiscales), elija el año fiscal que necesita y descargue el PDF. La redacción exacta del menú cambia de vez en cuando, así que busque el área de informes o estados de cuenta en lugar de un botón con el nombre literal que describe una guía antigua. Para el recorrido completo, consulte <a href='https://pickmytrade.trade/how-to/tradovate-1099-tax-form/'>Encontrar &amp; descargar su formulario fiscal 1099 de Tradovate</a>." },
    { type: "heading",text: "Mantenga su trading en piloto automático todo el año con PickMyTrade" },
    { type: "paragraph",html: "El papeleo fiscal es un dolor de cabeza anual. Su ejecución no debería serlo a diario. PickMyTrade toma las estrategias que ya ejecuta en TradingView y las envía directamente a Tradovate, para que no tenga que estar pegado a una pantalla esperando para hacer clic:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Automatización de TradingView a Tradovate</strong>, sus alertas se convierten en órdenes reales sin introducción manual.",
        "<strong class='text-white'>Ejecución sin supervisión</strong>, las operaciones se disparan incluso cuando se ha alejado del escritorio.",
        "<strong class='text-white'>Controles de cantidad &amp; riesgo</strong>, mantenga las órdenes automatizadas dentro de los límites de posición y riesgo de su cuenta.",
        "<strong class='text-white'>Sincronización multicuenta</strong>, replique una misma configuración en todas las cuentas que opera.",
      ],
    },
  ], fr: [
    { type: "paragraph",html: "Vous avez enfin retrouvé votre 1099 Tradovate, cliqué pour l'ouvrir et, au lieu de vos chiffres fiscaux, une boîte de mot de passe s'affiche. Aucun mot de passe ne vous a été envoyé par e-mail, la page de téléchargement n'en parle pas, et la saison fiscale ne laisse pas de place aux devinettes. Voici la réponse rapide : pour un compte individuel, le mot de passe est votre <strong class='text-white'>Social Security Number saisi en neuf chiffres, sans tirets ni espaces</strong>. Si votre SSN est 123-45-6789, saisissez <strong class='text-white'>123456789</strong>. C'est tout : le fichier s'ouvre et vous pouvez poursuivre votre déclaration." },
    { type: "paragraph",html: "Ci-dessous, j'explique pourquoi le PDF est verrouillé, quel est le bon mot de passe pour chaque type de compte (LLC, Trust et IRA sont différents) et que faire lorsque le numéro dont vous êtes certain est tout de même refusé." },
    {
      type: "checklist",
      heading: "Solution rapide pour l'invite de mot de passe",
      items: [
        "<strong class='text-white'>Compte individuel :</strong> saisissez votre <strong class='text-white'>SSN complet à 9 chiffres, sans tirets ni espaces</strong> (123456789, et non 123-45-6789).",
        "<strong class='text-white'>Tapez-le, ne le collez pas</strong>, une valeur copiée peut entraîner un espace caché qui empêche la correspondance.",
        "<strong class='text-white'>Ouvrez-le sur un ordinateur</strong> avec un vrai lecteur PDF (Adobe Acrobat Reader, Aperçu), et non sur un téléphone ou dans un volet d'aperçu du navigateur.",
        "<strong class='text-white'>Si neuf chiffres échouent,</strong> essayez les <strong class='text-white'>quatre derniers chiffres</strong> du SSN, quelques documents fiscaux utilisent ce format plus court.",
        "<strong class='text-white'>Compte professionnel ou de retraite ?</strong> Le mot de passe est un EIN, et non votre SSN personnel. Voir le tableau ci-dessous.",
        "<strong class='text-white'>Toujours bloqué ?</strong> Faites confirmer le format exact par le support Tradovate avant de supposer que le fichier est corrompu.",
      ],
    },
    { type: "heading",text: "Pourquoi votre 1099 Tradovate est protégé par mot de passe" },
    { type: "paragraph",html: "Il ne s'agit pas d'un bogue, et votre téléchargement n'est pas arrivé corrompu. Un 1099 est l'un des documents les plus sensibles que vous manipulerez de l'année : il contient votre nom, votre identifiant fiscal et le détail complet de vos produits de trading. Pour le protéger, le PDF est livré <strong class='text-white'>chiffré</strong>, et la clé de chiffrement est liée à l'identifiant fiscal du compte." },
    { type: "paragraph",html: "La logique est simple. Les formulaires fiscaux sont envoyés par e-mail, enregistrés sur des disques partagés et transmis aux comptables. Si un 1099 non chiffré atterrissait dans la mauvaise boîte de réception, n'importe qui pourrait le lire. En verrouillant le fichier avec le numéro que seul le titulaire du compte devrait connaître, le document reste inutilisable pour toute autre personne. C'est la même approche que la plupart des courtiers et des chambres de compensation utilisent pour les relevés fiscaux de fin d'année ; si vous tradez chez plusieurs courtiers, vous avez donc probablement déjà rencontré cette invite." },
    { type: "paragraph",html: "Le problème, c'est que le mot de passe n'apparaît presque jamais à côté du lien de téléchargement et qu'aucun e-mail ne l'indique. C'est ce silence qui pousse la plupart des gens à chercher, et non le chiffrement lui-même, mais l'absence de la précision que la clé est votre propre identifiant fiscal." },
    { type: "heading",text: "Le bon mot de passe pour chaque type de compte" },
    { type: "paragraph",html: "L'identifiant dépend de la façon dont le compte est enregistré. Si vous réussissez cette étape, le fichier s'ouvre du premier coup. Dans tous les cas, supprimez les tirets et les espaces : il vous faut une simple suite de chiffres." },
    { type: "table", headers: ["Type de compte","Mot de passe à saisir","Format"], rows: [
      ["<strong class='text-white'>Individuel</strong>","Votre Social Security Number","9 chiffres, sans tirets (123456789)"],
      ["<strong class='text-white'>LLC / entreprise</strong>","L'EIN de la société","9 chiffres, sans tirets"],
      ["<strong class='text-white'>Trust</strong>","SSN de la personne qui a ouvert le compte","9 chiffres, sans tirets"],
      ["<strong class='text-white'>IRA</strong>","L'EIN de votre dépositaire (et non votre SSN personnel)","9 chiffres, sans tirets"],
    ] },
    { type: "paragraph",html: "Une remarque sur les IRA : le mot de passe est l'EIN du <strong class='text-white'>dépositaire</strong>, c'est-à-dire un numéro que détient le dépositaire de votre compte retraite, et non votre propre SSN. Si vous ne l'avez pas noté, votre dépositaire peut vous le fournir ; il s'agit du même EIN que celui utilisé dans les documents de votre compte. Chaque dépositaire a un EIN différent ; relevez donc le vôtre dans les documents de votre propre compte plutôt qu'un numéro cité quelque part en ligne." },
    { type: "heading",text: "Comment ouvrir le 1099 verrouillé, étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Téléchargez d'abord le fichier sur votre ordinateur", html: "N'essayez pas d'ouvrir le 1099 dans la fenêtre contextuelle de téléchargement ni dans un aperçu du navigateur. Enregistrez-le d'abord sur votre bureau ou dans le dossier Téléchargements. Les volets d'aperçu du navigateur et les fenêtres de coup d'œil rapide gèrent parfois mal la couche de mot de passe, et vous obtenez une erreur vague au lieu d'une invite claire. En téléchargeant d'abord, vous disposez d'un PDF normal et fiable." },
        { title: "Ouvrez-le dans un lecteur PDF adapté", html: "Utilisez un lecteur de bureau complet : Adobe Acrobat Reader sous Windows ou Aperçu sur Mac fonctionnent très bien. Assurez-vous que le lecteur est <strong class='text-white'>à jour</strong> ; une ancienne version peut buter sur le chiffrement et afficher un message trompeur de &ldquo;fichier endommagé&rdquo; alors que le fichier est parfaitement sain. Évitez d'ouvrir le 1099 sur un téléphone ou une tablette pour cette étape. Les lecteurs PDF mobiles sont la raison la plus fréquente pour laquelle un mot de passe correct semble &ldquo;ne pas fonctionner&rdquo;." },
        { title: "Saisissez votre identifiant fiscal comme mot de passe", html: "Lorsque la boîte apparaît, saisissez l'identifiant de votre type de compte indiqué dans le tableau ci-dessus ; pour la plupart des gens, il s'agit du <strong class='text-white'>SSN à 9 chiffres sans tirets</strong>. Tapez-le à la main plutôt que de le coller. Une valeur collée peut contenir un espace final invisible, et le lecteur la refusera sans vous dire pourquoi. Vérifiez que vous n'avez pas ajouté de tirets par habitude (123-45-6789 échouera ; 123456789 fonctionnera)." },
        { title: "Enregistrez une copie déverrouillée pour votre comptable", html: "Une fois le fichier ouvert, vous voudrez peut-être une copie que vous pouvez partager sans communiquer votre SSN à chaque fois. Dans la plupart des lecteurs, vous pouvez imprimer le document ouvert vers un nouveau PDF, ou utiliser l'option &ldquo;supprimer la sécurité&rdquo; du lecteur, pour enregistrer une version qui ne demande plus de mot de passe. Conservez cette copie déverrouillée dans un endroit privé : elle est pratique pour votre comptable, mais elle reste votre relevé fiscal complet ; traitez-la en conséquence." },
      ],
    },
    { type: "image",src: `${IMG}/1099-pdf-password-protected-3.png`,alt: "Formulaire fiscal Tradovate 1099-B déverrouillé, affiché après la saisie du bon mot de passe" },
    { type: "heading",text: "Lorsque le mot de passe ne fonctionne toujours pas" },
    { type: "paragraph",html: "Si vous êtes certain d'avoir le bon numéro et que le fichier ne s'ouvre toujours pas, parcourez cette liste avant de conclure que quelque chose est cassé." },
    { type: "table", headers: ["Symptôme","Cause probable","Solution"], rows: [
      ["Mot de passe refusé alors que le SSN est correct","Des tirets ou des espaces ont été inclus","Saisissez uniquement 9 chiffres, sans tirets ni espaces (123456789)"],
      ["Erreur &ldquo;endommagé&rdquo; ou &ldquo;impossible d'ouvrir&rdquo;","Lecteur PDF obsolète ou incompatible","Mettez à jour Acrobat Reader / Aperçu, ou essayez un autre lecteur de bureau"],
      ["L'invite boucle ou n'accepte rien sur un téléphone","Le lecteur PDF mobile gère mal le chiffrement","Ouvrez le fichier sur un ordinateur portable ou de bureau"],
      ["Le SSN échoue sur un compte professionnel","Mauvais identifiant pour le type de compte","Utilisez l'EIN de la société (LLC) ou l'EIN du dépositaire (IRA), sans tirets"],
      ["Les 9 chiffres complets sont refusés","Le document utilise le format court","Essayez les 4 derniers chiffres du SSN"],
      ["Rien ne fonctionne après tout cela","Enregistrement inhabituel ou formulaire réémis","Contactez le support Tradovate pour confirmer le mot de passe exact de votre compte"],
    ] },
    { type: "paragraph",html: "Une dernière chose à savoir : le fait que le 1099 d'une année fiscale donnée soit chiffré peut changer avec le temps. Les PDF des années fiscales précédentes ont été envoyés sous forme de fichiers protégés par mot de passe. Si un téléchargement plus récent s'ouvre sans aucune invite, ce n'est pas une erreur, et s'il en demande une, la règle de l'identifiant fiscal correspondant à votre type de compte s'applique toujours. En cas de doute, vérifiez la procédure en vigueur dans la documentation de Tradovate sur les formulaires fiscaux." },
    { type: "image",src: `${IMG}/1099-pdf-password-protected-4.png`,alt: "Section Reports de Tradovate affichant le téléchargement du formulaire fiscal 1099 pour une année fiscale sélectionnée" },
    { type: "heading",text: "Vous ne trouvez pas le 1099 pour commencer ?" },
    { type: "paragraph",html: "Si le mot de passe n'est pas votre problème parce que vous ne parvenez même pas à localiser le formulaire, le 1099 se trouve dans la section des rapports de votre compte Tradovate <strong class='text-white'>réel</strong> ; un compte simulé ou de démonstration n'en possède pas. Connectez-vous, ouvrez la section Reports (ou documents de compte/fiscaux), choisissez l'année fiscale souhaitée et téléchargez le PDF. Le libellé exact du menu change de temps à autre ; cherchez donc la zone des rapports ou des relevés plutôt qu'un bouton portant le nom mot pour mot décrit par un ancien guide. Pour le pas-à-pas complet, consultez <a href='https://pickmytrade.trade/how-to/tradovate-1099-tax-form/'>Trouver &amp; télécharger votre formulaire fiscal 1099 Tradovate</a>." },
    { type: "heading",text: "Gardez votre trading en pilote automatique toute l'année avec PickMyTrade" },
    { type: "paragraph",html: "La paperasse fiscale est un casse-tête annuel. Votre exécution ne devrait pas en être un au quotidien. PickMyTrade prend les stratégies que vous exécutez déjà sur TradingView et les envoie directement vers Tradovate, pour que vous ne soyez pas rivé à un écran à attendre pour cliquer :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Automatisation TradingView vers Tradovate</strong>, vos alertes deviennent des ordres réels sans saisie manuelle.",
        "<strong class='text-white'>Exécution en mode « configurer et oublier »</strong>, les trades se déclenchent même lorsque vous avez quitté votre bureau.",
        "<strong class='text-white'>Contrôles de quantité &amp; de risque</strong>, gardez les ordres automatisés dans les limites de position et de risque de votre compte.",
        "<strong class='text-white'>Synchronisation multi-comptes</strong>, reproduisez une même configuration sur tous les comptes que vous tradez.",
      ],
    },
  ], it: [
    { type: "paragraph",html: "Ha finalmente trovato il suo 1099 di Tradovate, ha cliccato per aprirlo e, invece dei suoi dati fiscali, le è comparsa una finestra per la password. Nessuna password è stata inviata via e-mail, la pagina di download non ne parla e la stagione fiscale non lascia spazio a tentativi. Ecco la risposta rapida: per un conto individuale, la password è il suo <strong class='text-white'>Social Security Number digitato come nove cifre senza trattini né spazi</strong>. Se il suo SSN è 123-45-6789, digiti <strong class='text-white'>123456789</strong>. Tutto qui: il file si apre e può proseguire con la sua dichiarazione." },
    { type: "paragraph",html: "Di seguito spiego esattamente perché il PDF è bloccato, qual è la password corretta per ogni tipo di conto (LLC, Trust e IRA sono diversi) e cosa fare quando il numero di cui è sicuro viene comunque rifiutato." },
    {
      type: "checklist",
      heading: "Soluzione rapida per la richiesta di password",
      items: [
        "<strong class='text-white'>Conto individuale:</strong> inserisca il suo <strong class='text-white'>SSN completo di 9 cifre, senza trattini né spazi</strong> (123456789, non 123-45-6789).",
        "<strong class='text-white'>Lo digiti, non lo incolli</strong>, un valore copiato può portare con sé uno spazio nascosto che impedisce la corrispondenza.",
        "<strong class='text-white'>Lo apra su un computer</strong> con un vero lettore PDF (Adobe Acrobat Reader, Anteprima), non su uno smartphone o in un riquadro di anteprima del browser.",
        "<strong class='text-white'>Se nove cifre falliscono,</strong> provi con le <strong class='text-white'>ultime quattro cifre</strong> dell'SSN, alcuni documenti fiscali usano questo formato più breve.",
        "<strong class='text-white'>Conto aziendale o pensionistico?</strong> La password è un EIN, non il suo SSN personale. Veda la tabella qui sotto.",
        "<strong class='text-white'>Ancora bloccato?</strong> Faccia confermare il formato esatto dal supporto Tradovate prima di presumere che il file sia danneggiato.",
      ],
    },
    { type: "heading",text: "Perché il suo 1099 di Tradovate è protetto da password" },
    { type: "paragraph",html: "Non si tratta di un difetto, e il suo download non è arrivato danneggiato. Un 1099 è uno dei documenti più sensibili che gestirà durante l'anno: contiene il suo nome, il suo codice fiscale e un resoconto completo dei proventi del suo trading. Per proteggerlo, il PDF viene fornito <strong class='text-white'>crittografato</strong>, e la chiave di crittografia è legata all'identificativo fiscale del conto." },
    { type: "paragraph",html: "La logica è semplice. I moduli fiscali vengono inviati via e-mail, salvati su unità condivise e inoltrati ai commercialisti. Se un 1099 non crittografato finisse nella casella di posta sbagliata, chiunque potrebbe leggerlo. Bloccando il file con il numero che dovrebbe conoscere solo il titolare del conto, il documento resta inutilizzabile per chiunque altro. È lo stesso approccio che la maggior parte dei broker e delle stanze di compensazione usa per gli estratti fiscali di fine anno, quindi se opera con più di un intermediario, probabilmente ha già incontrato questa richiesta." },
    { type: "paragraph",html: "Il problema è che la password non compare quasi mai accanto al link di download e nessuna e-mail la indica. È questo silenzio a far cercare la maggior parte delle persone, non la crittografia in sé, ma la mancanza dell'indicazione che la chiave è il suo stesso codice fiscale." },
    { type: "heading",text: "La password giusta per ogni tipo di conto" },
    { type: "paragraph",html: "L'identificativo dipende da come è registrato il conto. Se lo sceglie correttamente, il file si apre al primo tentativo. In ogni caso, elimini trattini e spazi: serve una semplice sequenza di cifre." },
    { type: "table", headers: ["Tipo di conto","Password da inserire","Formato"], rows: [
      ["<strong class='text-white'>Individuale</strong>","Il suo Social Security Number","9 cifre, senza trattini (123456789)"],
      ["<strong class='text-white'>LLC / azienda</strong>","L'EIN della società","9 cifre, senza trattini"],
      ["<strong class='text-white'>Trust</strong>","SSN della persona che ha aperto il conto","9 cifre, senza trattini"],
      ["<strong class='text-white'>IRA</strong>","L'EIN del suo custode (non il suo SSN personale)","9 cifre, senza trattini"],
    ] },
    { type: "paragraph",html: "Una nota sulle IRA: la password è l'EIN del <strong class='text-white'>custode</strong>, quindi un numero che detiene il custode del suo conto pensionistico, non il suo SSN. Se non lo ha annotato, il suo custode può fornirglielo; è lo stesso EIN utilizzato nei documenti del suo conto. Custodi diversi hanno EIN diversi, quindi lo ricavi dai documenti del suo conto anziché da un numero visto citato online." },
    { type: "heading",text: "Come aprire il 1099 bloccato, passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Scarichi prima il file sul suo computer", html: "Non provi ad aprire il 1099 dalla finestra pop-up di download o da un'anteprima del browser. Lo salvi prima sul desktop o nella cartella Download. I riquadri di anteprima del browser e le finestre di visualizzazione rapida a volte gestiscono male il livello della password e otterrà un errore generico invece di una richiesta chiara. Scaricando prima, lavora con un normale PDF che si comporta correttamente." },
        { title: "Lo apra con un lettore PDF adatto", html: "Usi un lettore desktop completo: Adobe Acrobat Reader su Windows o Anteprima su Mac vanno entrambi bene. Si assicuri che il lettore sia <strong class='text-white'>aggiornato</strong>; una versione obsoleta può inciampare nella crittografia e mostrare un fuorviante messaggio di &ldquo;file danneggiato&rdquo; quando il file è perfettamente integro. Eviti di aprire il 1099 su uno smartphone o tablet per questo passaggio. I lettori PDF mobili sono la ragione più comune per cui una password corretta sembra &ldquo;non funzionare&rdquo;." },
        { title: "Digiti il suo codice fiscale come password", html: "Quando compare la finestra, inserisca l'identificativo per il suo tipo di conto indicato nella tabella qui sopra; per la maggior parte delle persone è l'<strong class='text-white'>SSN di 9 cifre senza trattini</strong>. Lo digiti a mano anziché incollarlo. Un valore incollato può contenere uno spazio finale invisibile e il lettore lo rifiuterà senza dirle il motivo. Controlli di non aver aggiunto trattini per abitudine (123-45-6789 fallirà; 123456789 funzionerà)." },
        { title: "Salvi una copia sbloccata per il suo commercialista", html: "Una volta aperto il file, potrebbe volere una copia da condividere senza comunicare ogni volta il suo SSN. Nella maggior parte dei lettori può stampare il documento aperto in un nuovo PDF, oppure usare l'opzione &ldquo;rimuovi protezione&rdquo; del lettore, per salvare una versione che non richiede più la password. Conservi questa copia sbloccata in un luogo privato: è comoda per il suo commercialista, ma resta il suo estratto fiscale completo, quindi la tratti di conseguenza." },
      ],
    },
    { type: "image",src: `${IMG}/1099-pdf-password-protected-3.png`,alt: "Modulo fiscale Tradovate 1099-B sbloccato, visualizzato dopo aver inserito la password corretta" },
    { type: "heading",text: "Quando la password continua a non funzionare" },
    { type: "paragraph",html: "Se è certo di avere il numero giusto e il file non si apre comunque, scorra questo elenco prima di concludere che qualcosa non va." },
    { type: "table", headers: ["Sintomo","Causa probabile","Soluzione"], rows: [
      ["Password rifiutata anche se l'SSN è corretto","Sono stati inclusi trattini o spazi","Inserisca solo 9 cifre, senza trattini né spazi (123456789)"],
      ["Errore &ldquo;danneggiato&rdquo; o &ldquo;impossibile aprire&rdquo;","Lettore PDF obsoleto o incompatibile","Aggiorni Acrobat Reader / Anteprima, oppure provi un altro lettore desktop"],
      ["La richiesta si ripete o non accetta nulla su uno smartphone","Il lettore PDF mobile gestisce male la crittografia","Apra il file su un portatile o un computer desktop"],
      ["L'SSN fallisce su un conto aziendale","Identificativo errato per il tipo di conto","Usi l'EIN della società (LLC) o l'EIN del custode (IRA), senza trattini"],
      ["Le 9 cifre complete vengono rifiutate","Il documento usa il formato breve","Provi con le ultime 4 cifre dell'SSN"],
      ["Nulla funziona dopo tutto questo","Registrazione insolita o modulo riemesso","Contatti il supporto Tradovate per confermare la password esatta per il suo conto"],
    ] },
    { type: "paragraph",html: "Un'ultima cosa da sapere: il fatto che il 1099 di un determinato anno fiscale arrivi crittografato può cambiare nel tempo. I PDF degli anni fiscali precedenti sono stati inviati come file protetti da password. Se un download più recente si apre senza alcuna richiesta, non è un errore, e se la richiede, la regola del codice fiscale per il suo tipo di conto continua a valere. In caso di dubbio, verifichi la procedura attuale nella documentazione di Tradovate sui moduli fiscali." },
    { type: "image",src: `${IMG}/1099-pdf-password-protected-4.png`,alt: "Sezione Reports di Tradovate che mostra il download del modulo fiscale 1099 per un anno fiscale selezionato" },
    { type: "heading",text: "Non riesce a trovare il 1099 per cominciare?" },
    { type: "paragraph",html: "Se la password non è il suo problema perché non riesce nemmeno a individuare il modulo, il 1099 si trova nell'area dei report del suo conto Tradovate <strong class='text-white'>live</strong>; un conto simulato o demo non ne ha. Acceda, apra la sezione Reports (o documenti del conto/fiscali), scelga l'anno fiscale che le serve e scarichi il PDF. La dicitura esatta del menu cambia di tanto in tanto, quindi cerchi l'area dei report o degli estratti conto anziché un pulsante con il nome identico a quello descritto da una vecchia guida. Per la procedura completa, veda <a href='https://pickmytrade.trade/how-to/tradovate-1099-tax-form/'>Trovare &amp; scaricare il suo modulo fiscale 1099 di Tradovate</a>." },
    { type: "heading",text: "Mantenga il suo trading in pilota automatico tutto l'anno con PickMyTrade" },
    { type: "paragraph",html: "La documentazione fiscale è un fastidio annuale. La sua esecuzione non dovrebbe esserlo ogni giorno. PickMyTrade prende le strategie che già esegue su TradingView e le invia direttamente a Tradovate, così non deve restare incollato a uno schermo ad aspettare di cliccare:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Automazione da TradingView a Tradovate</strong>, i suoi alert diventano ordini live senza inserimento manuale.",
        "<strong class='text-white'>Esecuzione imposta e dimentica</strong>, le operazioni partono anche quando si è allontanato dalla scrivania.",
        "<strong class='text-white'>Controlli di quantità &amp; rischio</strong>, mantenga gli ordini automatizzati entro i limiti di posizione e di rischio del suo conto.",
        "<strong class='text-white'>Sincronizzazione multi-conto</strong>, replichi una sola configurazione su tutti i conti che opera.",
      ],
    },
  ] },
  ctaHeading: { en: "Automate Your Tradovate Execution Year-Round", de: "Automatisieren Sie Ihre Tradovate-Ausführung das ganze Jahr über", es: "Automatice su ejecución en Tradovate durante todo el año", fr: "Automatisez votre exécution Tradovate toute l'année", it: "Automatizzi l'esecuzione su Tradovate tutto l'anno" },
  ctaText: { en: "Tax paperwork is a once-a-year headache. Let PickMyTrade turn your TradingView strategies into consistent, hands-off Tradovate execution for the other 364 days.", de: "Steuerunterlagen sind ein Ärgernis, das nur einmal im Jahr auftritt. Lassen Sie PickMyTrade Ihre TradingView-Strategien an den anderen 364 Tagen in eine konsistente, vollautomatische Tradovate-Ausführung verwandeln.", es: "El papeleo fiscal es un dolor de cabeza que llega una vez al año. Deje que PickMyTrade convierta sus estrategias de TradingView en una ejecución constante y automática en Tradovate durante los otros 364 días.", fr: "La paperasse fiscale est un casse-tête qui revient une fois par an. Laissez PickMyTrade transformer vos stratégies TradingView en exécution Tradovate régulière et automatique les 364 autres jours.", it: "La documentazione fiscale è un fastidio che torna una volta all'anno. Lasci che PickMyTrade trasformi le sue strategie di TradingView in un'esecuzione costante e automatica su Tradovate per gli altri 364 giorni." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "What is the password for my Tradovate 1099 PDF?", a: "For an individual account, the password is your Social Security Number typed as nine digits with no dashes and no spaces. So 123-45-6789 becomes 123456789." },
    { q: "Do I use my full SSN or just the last four digits?", a: "Start with the full nine-digit SSN, no dashes or spaces. If that is rejected, try the last four digits, since some tax documents use that shorter format. The full number is the one to try first for a Tradovate 1099." },
    { q: "What password do I use for an LLC, Trust, or IRA account?", a: "For an LLC, use the company's EIN with no dashes. For a Trust, use the Social Security Number (no dashes) of the individual who opened the account. For an IRA, use your custodian's EIN, which the custodian can provide if you don't have it handy." },
    { q: "Why is my 1099 PDF password-protected at all?", a: "A 1099 contains sensitive tax and identity data, so the file is encrypted. Locking it to your tax ID means that if the PDF is intercepted or forwarded by mistake, it can't be opened without the number tied to the account." },
    { q: "The password isn't working. What should I check?", a: "Remove every dash and space, confirm you're using the identifier for the correct account type, update your PDF reader to the current version, and open the file on a desktop rather than a phone or tablet. If it still won't open, contact Tradovate support to confirm the exact password format for your account." },
    { q: "Where do I download the 1099 in the first place?", a: "Log into your live Tradovate account, open the Reports (account/tax documents) area, choose the tax year, and download the 1099 PDF. The exact menu labels can change, so look for the reports or statements section of your live account." },
    { q: "Are the newer 1099 PDFs still password-protected?", a: "Older tax-year 1099 PDFs have been distributed as password-protected files. Whether a given year's PDF is encrypted can change, so if a newer download opens without a prompt, that's normal, and if it does prompt, use the tax-ID rule for your account type." },
  ], de: [
    { q: "Wie lautet das Passwort für meine Tradovate-1099-PDF?", a: "Bei einem Einzelkonto ist das Passwort Ihre Social Security Number, eingegeben als neun Ziffern ohne Bindestriche und ohne Leerzeichen. Aus 123-45-6789 wird also 123456789." },
    { q: "Verwende ich die vollständige SSN oder nur die letzten vier Ziffern?", a: "Beginnen Sie mit der vollständigen neunstelligen SSN, ohne Bindestriche oder Leerzeichen. Wird sie abgelehnt, versuchen Sie die letzten vier Ziffern, da einige Steuerdokumente dieses kürzere Format verwenden. Bei einer Tradovate-1099 sollten Sie zuerst die vollständige Nummer probieren." },
    { q: "Welches Passwort verwende ich für ein LLC-, Trust- oder IRA-Konto?", a: "Bei einer LLC verwenden Sie die EIN des Unternehmens ohne Bindestriche. Bei einem Trust verwenden Sie die Social Security Number (ohne Bindestriche) der Person, die das Konto eröffnet hat. Bei einer IRA verwenden Sie die EIN Ihres Verwahrers (Custodian); diese erhalten Sie von ihm, falls Sie sie nicht zur Hand haben." },
    { q: "Warum ist meine 1099-PDF überhaupt passwortgeschützt?", a: "Eine 1099 enthält sensible Steuer- und Identitätsdaten, daher ist die Datei verschlüsselt. Durch die Bindung an Ihre Steuer-ID kann die PDF nicht geöffnet werden, falls sie abgefangen oder versehentlich weitergeleitet wird, ohne dass die mit dem Konto verknüpfte Nummer bekannt ist." },
    { q: "Das Passwort funktioniert nicht. Was sollte ich prüfen?", a: "Entfernen Sie alle Bindestriche und Leerzeichen, vergewissern Sie sich, dass Sie die Kennung für den richtigen Kontotyp verwenden, aktualisieren Sie Ihr PDF-Programm auf die aktuelle Version und öffnen Sie die Datei an einem Desktop-Rechner statt auf Smartphone oder Tablet. Wenn sie sich weiterhin nicht öffnen lässt, wenden Sie sich an den Tradovate-Support, um das genaue Passwortformat für Ihr Konto bestätigen zu lassen." },
    { q: "Wo lade ich die 1099 überhaupt herunter?", a: "Melden Sie sich bei Ihrem Live-Tradovate-Konto an, öffnen Sie den Bereich Reports (Konto-/Steuerdokumente), wählen Sie das Steuerjahr und laden Sie die 1099-PDF herunter. Die genauen Menübezeichnungen können sich ändern, suchen Sie daher in Ihrem Live-Konto nach dem Bereich für Berichte oder Kontoauszüge." },
    { q: "Sind die neueren 1099-PDFs weiterhin passwortgeschützt?", a: "Die 1099-PDFs älterer Steuerjahre wurden als passwortgeschützte Dateien bereitgestellt. Ob die PDF eines bestimmten Jahres verschlüsselt ist, kann sich ändern. Wenn sich ein neuerer Download ohne Abfrage öffnet, ist das normal; erscheint eine Abfrage, verwenden Sie die Steuer-ID-Regel für Ihren Kontotyp." },
  ], es: [
    { q: "¿Cuál es la contraseña de mi PDF 1099 de Tradovate?", a: "Para una cuenta individual, la contraseña es su Social Security Number escrito como nueve dígitos sin guiones ni espacios. Así, 123-45-6789 se convierte en 123456789." },
    { q: "¿Uso el SSN completo o solo los últimos cuatro dígitos?", a: "Comience con el SSN completo de nueve dígitos, sin guiones ni espacios. Si es rechazado, pruebe con los últimos cuatro dígitos, ya que algunos documentos fiscales usan ese formato más corto. Para un 1099 de Tradovate, el número completo es el que debe probar primero." },
    { q: "¿Qué contraseña uso para una cuenta LLC, Trust o IRA?", a: "Para una LLC, use el EIN de la empresa sin guiones. Para un Trust, use el Social Security Number (sin guiones) de la persona que abrió la cuenta. Para una IRA, use el EIN de su custodio, que este puede proporcionarle si no lo tiene a mano." },
    { q: "¿Por qué mi PDF 1099 está protegido con contraseña?", a: "Un 1099 contiene datos fiscales y de identidad sensibles, por lo que el archivo está cifrado. Al vincularlo a su identificación fiscal, si el PDF es interceptado o reenviado por error, no puede abrirse sin el número asociado a la cuenta." },
    { q: "La contraseña no funciona. ¿Qué debo revisar?", a: "Elimine todos los guiones y espacios, confirme que usa el identificador correspondiente al tipo de cuenta correcto, actualice su lector de PDF a la versión actual y abra el archivo en un ordenador en lugar de un teléfono o tableta. Si aún no se abre, comuníquese con el soporte de Tradovate para confirmar el formato exacto de contraseña de su cuenta." },
    { q: "¿Dónde descargo el 1099 en primer lugar?", a: "Inicie sesión en su cuenta real de Tradovate, abra el área Reports (documentos de cuenta/fiscales), elija el año fiscal y descargue el PDF del 1099. Los nombres exactos de los menús pueden cambiar, así que busque la sección de informes o estados de cuenta de su cuenta real." },
    { q: "¿Los PDF 1099 más recientes siguen protegidos con contraseña?", a: "Los PDF 1099 de años fiscales anteriores se han distribuido como archivos protegidos con contraseña. Que el PDF de un año determinado esté cifrado puede cambiar, así que si una descarga más reciente se abre sin solicitar nada, es normal, y si la solicita, use la regla de la identificación fiscal para su tipo de cuenta." },
  ], fr: [
    { q: "Quel est le mot de passe de mon PDF 1099 Tradovate ?", a: "Pour un compte individuel, le mot de passe est votre Social Security Number saisi en neuf chiffres, sans tirets ni espaces. Ainsi, 123-45-6789 devient 123456789." },
    { q: "Dois-je utiliser le SSN complet ou seulement les quatre derniers chiffres ?", a: "Commencez par le SSN complet à neuf chiffres, sans tirets ni espaces. S'il est refusé, essayez les quatre derniers chiffres, car certains documents fiscaux utilisent ce format plus court. Pour un 1099 Tradovate, c'est le numéro complet qu'il faut essayer en premier." },
    { q: "Quel mot de passe utiliser pour un compte LLC, Trust ou IRA ?", a: "Pour une LLC, utilisez l'EIN de la société sans tirets. Pour un Trust, utilisez le Social Security Number (sans tirets) de la personne qui a ouvert le compte. Pour une IRA, utilisez l'EIN de votre dépositaire (custodian), que celui-ci peut vous fournir si vous ne l'avez pas sous la main." },
    { q: "Pourquoi mon PDF 1099 est-il protégé par mot de passe ?", a: "Un 1099 contient des données fiscales et d'identité sensibles ; le fichier est donc chiffré. En le verrouillant avec votre identifiant fiscal, le PDF ne peut pas être ouvert sans le numéro associé au compte s'il est intercepté ou transféré par erreur." },
    { q: "Le mot de passe ne fonctionne pas. Que vérifier ?", a: "Supprimez tous les tirets et espaces, vérifiez que vous utilisez l'identifiant correspondant au bon type de compte, mettez à jour votre lecteur PDF vers la version actuelle et ouvrez le fichier sur un ordinateur plutôt que sur un téléphone ou une tablette. S'il ne s'ouvre toujours pas, contactez le support Tradovate pour confirmer le format exact du mot de passe de votre compte." },
    { q: "Où télécharger le 1099 en premier lieu ?", a: "Connectez-vous à votre compte Tradovate réel, ouvrez la section Reports (documents de compte/fiscaux), choisissez l'année fiscale et téléchargez le PDF du 1099. Les libellés exacts des menus peuvent changer ; cherchez donc la section des rapports ou des relevés de votre compte réel." },
    { q: "Les PDF 1099 plus récents sont-ils toujours protégés par mot de passe ?", a: "Les PDF 1099 des années fiscales précédentes ont été distribués sous forme de fichiers protégés par mot de passe. Le chiffrement du PDF d'une année donnée peut changer : si un téléchargement plus récent s'ouvre sans invite, c'est normal, et s'il en demande une, appliquez la règle de l'identifiant fiscal correspondant à votre type de compte." },
  ], it: [
    { q: "Qual è la password del mio PDF 1099 di Tradovate?", a: "Per un conto individuale, la password è il suo Social Security Number digitato come nove cifre senza trattini né spazi. Quindi 123-45-6789 diventa 123456789." },
    { q: "Devo usare l'SSN completo o solo le ultime quattro cifre?", a: "Inizi con l'SSN completo di nove cifre, senza trattini né spazi. Se viene rifiutato, provi con le ultime quattro cifre, poiché alcuni documenti fiscali usano questo formato più breve. Per un 1099 di Tradovate, il numero completo è quello da provare per primo." },
    { q: "Quale password uso per un conto LLC, Trust o IRA?", a: "Per una LLC, usi l'EIN della società senza trattini. Per un Trust, usi il Social Security Number (senza trattini) della persona che ha aperto il conto. Per una IRA, usi l'EIN del suo custode (custodian), che questi può fornirle se non lo ha a portata di mano." },
    { q: "Perché il mio PDF 1099 è protetto da password?", a: "Un 1099 contiene dati fiscali e di identità sensibili, quindi il file è crittografato. Legandolo al suo codice fiscale, se il PDF viene intercettato o inoltrato per errore, non può essere aperto senza il numero associato al conto." },
    { q: "La password non funziona. Cosa devo controllare?", a: "Rimuova tutti i trattini e gli spazi, verifichi di usare l'identificativo corretto per il tipo di conto, aggiorni il suo lettore PDF alla versione attuale e apra il file su un computer anziché su uno smartphone o tablet. Se ancora non si apre, contatti il supporto Tradovate per confermare il formato esatto della password per il suo conto." },
    { q: "Dove scarico il 1099 in primo luogo?", a: "Acceda al suo conto Tradovate live, apra l'area Reports (documenti del conto/fiscali), scelga l'anno fiscale e scarichi il PDF del 1099. Le etichette esatte dei menu possono cambiare, quindi cerchi la sezione dei report o degli estratti conto del suo conto live." },
    { q: "I PDF 1099 più recenti sono ancora protetti da password?", a: "I PDF 1099 degli anni fiscali precedenti sono stati distribuiti come file protetti da password. Il fatto che il PDF di un determinato anno sia crittografato può cambiare: se un download più recente si apre senza richiesta, è normale, e se la richiede, usi la regola del codice fiscale per il suo tipo di conto." },
  ] },
