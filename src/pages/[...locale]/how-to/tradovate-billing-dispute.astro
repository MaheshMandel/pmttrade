---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-billing-dispute";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Dispute a Billing Error or Refund in Tradovate";
const META_DESCRIPTION =
  "Charged in error on your futures account? Learn how to dispute an incorrect Tradovate charge or get a refund through support quickly and safely.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Abrechnungsfehler oder Rückerstattung in Tradovate reklamieren", es: "Cómo disputar un error de facturación o un reembolso en Tradovate", fr: "Contester une erreur de facturation ou demander un remboursement sur Tradovate", it: "Contestare un errore di fatturazione o richiedere un rimborso su Tradovate" },
  dek: { en: "Spotting a charge you don't recognize on your Tradovate account is annoying, but most genuine billing errors get sorted out fast if you go through Tradovate directly, act quickly, and skip your bank. Here's exactly how.", de: "Eine Abbuchung auf Ihrem Tradovate-Konto, die Sie nicht kennen, ist ärgerlich, aber die meisten echten Abrechnungsfehler lassen sich schnell klären, wenn Sie sich direkt an Tradovate wenden, zügig handeln und Ihre Bank außen vor lassen. So gehen Sie genau vor.", es: "Ver un cargo que no reconoce en su cuenta de Tradovate es molesto, pero la mayoría de los errores de facturación reales se resuelven rápido si acude directamente a Tradovate, actúa pronto y deja a su banco fuera. Aquí le explicamos exactamente cómo.", fr: "Repérer un prélèvement que vous ne reconnaissez pas sur votre compte Tradovate est agaçant, mais la plupart des véritables erreurs de facturation se règlent vite si vous passez directement par Tradovate, agissez rapidement et laissez votre banque de côté. Voici comment faire exactement.", it: "Notare un addebito che non riconosce sul suo conto Tradovate è fastidioso, ma la maggior parte dei veri errori di fatturazione si risolve in fretta se si rivolge direttamente a Tradovate, agisce rapidamente e lascia fuori la sua banca. Ecco esattamente come fare." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-10",
  blocks: { en: [
    { type: "paragraph", html: "Spotting a charge you don't recognize on your Tradovate account is annoying, but most genuine billing errors get sorted out fast if you handle them the right way. The trick is to go through Tradovate directly, act quickly, and resist the urge to call your bank first. Here's how to dispute an erroneous charge or ask for a refund without putting your account at risk." },
    { type: "quote", html: "Move fast. Billing disputes are far easier to reverse when you raise them early, so don't sit on a charge that looks wrong." },
    { type: "heading", text: "How to Dispute a Tradovate Charge: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Confirm the Charge in Your Account Reports", html: "Before you fire off a support ticket, pull up exactly what hit your account. Open your account reports or statements, find the line item, and write down the date, the amount, and the description. A good chunk of \"mystery\" charges turn out to be a fee you simply forgot about, so knowing the specifics makes your case airtight." },
        { title: "Rule Out Fees That Are Actually Valid", html: "Not every charge is a mistake. A handful of common ones catch people off guard, an inactivity or maintenance fee, an auto-liquidation fee, an exchange or market-data fee, or commissions. If the charge lines up with one of these, it's most likely legitimate, and disputing it will just slow you down. If it's a duplicate, the wrong amount, or something you never signed up for, keep going." },
        { title: "Gather Your Proof of Payment", html: "Support moves faster when you hand over everything up front. Grab your account name or ID, the exact charge date and amount, the transaction or reference ID, and a screenshot or the card or bank statement line showing the debit. If you have a receipt or a confirmation email, attach that too. The more concrete you are, the less back-and-forth you'll deal with." },
        { title: "Contact Tradovate Support Directly", html: "This is the part that matters most: reach out to Tradovate, not your bank. Filing a chargeback or payment dispute with your card issuer before you've talked to support can get your account suspended or closed while the dispute plays out. You have a few ways in: <strong class='text-white'>in-app live chat</strong> inside the web or desktop platform, usually the quickest route; <strong class='text-white'>email</strong> support@tradovate.com with your charge details and proof attached; a <strong class='text-white'>contact form</strong> at support.tradovate.com, where you can pick a billing or payments topic; or <strong class='text-white'>phone</strong> at 1-844-283-3100 or 312-283-3100 for account and billing questions. Whatever channel you pick, say plainly that it's a billing error, give the charge details, and ask for a refund of the incorrect amount." },
        { title: "Submit Within the Window and Follow Up", html: "Don't let it drift. Erroneous charges are easiest to reverse when you flag them promptly, generally within about two weeks of the charge, though you should confirm the current window with support since Tradovate doesn't publish a fixed public deadline. Once you submit, save your ticket number, keep an eye out for a reply, and follow up if it goes quiet. If the first rep closes you out without actually fixing it, reply on the same thread and ask to escalate." },
      ],
    },
    {
      type: "table",
      headers: ["Charge", "What It Usually Is"],
      rows: [
        ["Inactivity or maintenance fee", "A Free-plan account that logs in but doesn't place a trade inside a set window."],
        ["Auto-liquidation fee", "Charged per event when the platform force-closes a margin breach."],
        ["Exchange or market-data fee", "A recurring data subscription you signed up for, billed monthly."],
        ["Commissions", "Per-side trading fees tied to your account plan."],
      ],
    },
    { type: "heading", text: "Prop Firm or Evaluation Account? Read This First" },
    { type: "paragraph", html: "If you're on a prop-firm or evaluation account (Apex, Topstep, and the like), the money you paid for the evaluation or a reset was billed by the firm, not by Tradovate. Refunds and billing questions for those go to your prop firm's support, and refund eligibility varies by firm and account size, so check your firm's current rules before you ask." },
    { type: "heading", text: "Keep Your Automation Running While You Sort Billing" },
    { type: "paragraph", html: "Chasing down a charge shouldn't cost you setups. PickMyTrade wires your TradingView alerts straight into Tradovate, so your entries, stops, and targets keep firing on their own while you deal with support." },
  ], de: [
    { type: "paragraph",html: "Eine Abbuchung auf Ihrem Tradovate-Konto, die Sie nicht kennen, ist ärgerlich, aber die meisten echten Abrechnungsfehler lassen sich schnell klären, wenn Sie richtig vorgehen. Der Trick besteht darin, sich direkt an Tradovate zu wenden, zügig zu handeln und der Versuchung zu widerstehen, zuerst Ihre Bank anzurufen. So beanstanden Sie eine fehlerhafte Abbuchung oder beantragen eine Rückerstattung, ohne Ihr Konto zu gefährden." },
    { type: "quote",html: "Handeln Sie schnell. Abrechnungsstreitigkeiten lassen sich viel leichter rückgängig machen, wenn Sie sie früh vorbringen. Lassen Sie also eine Abbuchung, die falsch aussieht, nicht liegen." },
    { type: "heading",text: "So beanstanden Sie eine Tradovate-Abbuchung: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Die Abbuchung in Ihren Kontoberichten bestätigen", html: "Bevor Sie ein Support-Ticket absenden, sehen Sie nach, was genau auf Ihrem Konto verbucht wurde. Öffnen Sie Ihre Kontoberichte oder Kontoauszüge, suchen Sie die Position und notieren Sie Datum, Betrag und Beschreibung. Ein guter Teil der „mysteriösen“ Abbuchungen entpuppt sich als eine Gebühr, die Sie schlicht vergessen hatten. Wenn Sie die Einzelheiten kennen, ist Ihr Anliegen wasserdicht." },
        { title: "Gebühren ausschließen, die tatsächlich gültig sind", html: "Nicht jede Abbuchung ist ein Fehler. Einige gängige Posten überraschen viele: eine Inaktivitäts- oder Wartungsgebühr, eine Auto-Liquidationsgebühr, eine Börsen- oder Marktdatengebühr oder Kommissionen. Entspricht die Abbuchung einem davon, ist sie höchstwahrscheinlich legitim, und eine Beanstandung bremst Sie nur aus. Handelt es sich um ein Duplikat, einen falschen Betrag oder etwas, wofür Sie sich nie angemeldet haben, machen Sie weiter." },
        { title: "Ihren Zahlungsnachweis zusammenstellen", html: "Der Support arbeitet schneller, wenn Sie ihm von Anfang an alles liefern. Halten Sie Ihren Kontonamen oder Ihre Konto-ID, das genaue Datum und den Betrag der Abbuchung, die Transaktions- oder Referenz-ID sowie einen Screenshot oder die Zeile Ihres Karten- oder Kontoauszugs bereit, die die Belastung zeigt. Haben Sie eine Quittung oder eine Bestätigungs-E-Mail, hängen Sie diese ebenfalls an. Je konkreter Sie sind, desto weniger Hin und Her gibt es." },
        { title: "Tradovate-Support direkt kontaktieren", html: "Das ist der wichtigste Teil: Wenden Sie sich an Tradovate, nicht an Ihre Bank. Eine Rückbuchung oder Zahlungsbeanstandung bei Ihrem Kartenaussteller, bevor Sie mit dem Support gesprochen haben, kann dazu führen, dass Ihr Konto gesperrt oder geschlossen wird, während die Beanstandung läuft. Sie haben mehrere Wege: <strong class='text-white'>Live-Chat in der App</strong> in der Web- oder Desktop-Plattform, meist der schnellste Weg; <strong class='text-white'>E-Mail</strong> an support@tradovate.com mit Ihren Abbuchungsdetails und Nachweisen im Anhang; ein <strong class='text-white'>Kontaktformular</strong> unter support.tradovate.com, in dem Sie ein Abrechnungs- oder Zahlungsthema auswählen können; oder <strong class='text-white'>Telefon</strong> unter 1-844-283-3100 bzw. 312-283-3100 für Konto- und Abrechnungsfragen. Welchen Kanal Sie auch wählen: Sagen Sie klar, dass es sich um einen Abrechnungsfehler handelt, nennen Sie die Abbuchungsdetails und bitten Sie um Rückerstattung des falschen Betrags." },
        { title: "Innerhalb der Frist einreichen und nachfassen", html: "Lassen Sie es nicht schleifen. Fehlerhafte Abbuchungen lassen sich am leichtesten rückgängig machen, wenn Sie sie zeitnah melden, in der Regel innerhalb von etwa zwei Wochen nach der Abbuchung. Bestätigen Sie das aktuelle Zeitfenster jedoch beim Support, da Tradovate keine feste öffentliche Frist veröffentlicht. Notieren Sie nach dem Absenden Ihre Ticketnummer, achten Sie auf eine Antwort und haken Sie nach, wenn es still wird. Schließt der erste Mitarbeiter Ihr Anliegen, ohne es zu lösen, antworten Sie im selben Thread und bitten Sie um Eskalation." },
      ],
    },
    { type: "table", headers: ["Abbuchung","Was es üblicherweise ist"], rows: [
      ["Inaktivitäts- oder Wartungsgebühr","Ein Free-Plan-Konto, das sich anmeldet, aber innerhalb eines bestimmten Zeitraums keinen Trade platziert."],
      ["Auto-Liquidationsgebühr","Wird pro Ereignis berechnet, wenn die Plattform eine Margin-Verletzung zwangsweise schließt."],
      ["Börsen- oder Marktdatengebühr","Ein wiederkehrendes Datenabonnement, für das Sie sich angemeldet haben und das monatlich abgerechnet wird."],
      ["Kommissionen","Handelsgebühren pro Seite, die an Ihren Kontoplan gebunden sind."],
    ] },
    { type: "heading",text: "Prop-Firm- oder Evaluierungskonto? Lesen Sie das zuerst" },
    { type: "paragraph",html: "Wenn Sie ein Prop-Firm- oder Evaluierungskonto haben (Apex, Topstep und ähnliche), wurde das Geld, das Sie für die Evaluierung oder einen Reset gezahlt haben, von der Firma abgerechnet, nicht von Tradovate. Rückerstattungen und Abrechnungsfragen dazu richten Sie an den Support Ihrer Prop-Firm, und die Erstattungsberechtigung variiert je nach Firma und Kontogröße. Prüfen Sie daher die aktuellen Regeln Ihrer Firma, bevor Sie anfragen." },
    { type: "heading",text: "Halten Sie Ihre Automatisierung am Laufen, während Sie die Abrechnung klären" },
    { type: "paragraph",html: "Der Kampf um eine Abbuchung sollte Sie keine Setups kosten. PickMyTrade verbindet Ihre TradingView-Alerts direkt mit Tradovate, sodass Ihre Einstiege, Stopps und Ziele von selbst weiterlaufen, während Sie sich um den Support kümmern." },
  ], es: [
    { type: "paragraph",html: "Ver un cargo que no reconoce en su cuenta de Tradovate es molesto, pero la mayoría de los errores de facturación reales se resuelven rápido si los gestiona de la manera correcta. El truco es acudir directamente a Tradovate, actuar pronto y resistir la tentación de llamar primero a su banco. Así se disputa un cargo erróneo o se solicita un reembolso sin poner en riesgo su cuenta." },
    { type: "quote",html: "Actúe rápido. Las disputas de facturación son mucho más fáciles de revertir cuando las plantea pronto, así que no deje pasar un cargo que parezca incorrecto." },
    { type: "heading",text: "Cómo disputar un cargo de Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Confirme el cargo en los informes de su cuenta", html: "Antes de enviar un ticket de soporte, revise exactamente qué se cargó en su cuenta. Abra los informes o extractos de su cuenta, localice la línea y anote la fecha, el importe y la descripción. Una buena parte de los cargos «misteriosos» resultan ser una tarifa que simplemente había olvidado, así que conocer los detalles hace su caso irrefutable." },
        { title: "Descarte las tarifas que sí son válidas", html: "No todos los cargos son un error. Algunos habituales sorprenden a la gente: una tarifa de inactividad o mantenimiento, una tarifa de autoliquidación, una tarifa de bolsa o de datos de mercado, o las comisiones. Si el cargo coincide con alguno de ellos, lo más probable es que sea legítimo y disputarlo solo le hará perder tiempo. Si es un duplicado, un importe incorrecto o algo a lo que nunca se suscribió, continúe." },
        { title: "Reúna su comprobante de pago", html: "El soporte trabaja más rápido si usted aporta todo desde el principio. Reúna el nombre o ID de su cuenta, la fecha y el importe exactos del cargo, el ID de transacción o de referencia y una captura de pantalla o la línea del extracto de su tarjeta o banco que muestre el adeudo. Si tiene un recibo o un correo de confirmación, adjúntelo también. Cuanto más concreto sea, menos idas y venidas tendrá." },
        { title: "Contacte directamente con el soporte de Tradovate", html: "Esta es la parte más importante: acuda a Tradovate, no a su banco. Presentar una devolución de cargo o una disputa de pago ante el emisor de su tarjeta antes de haber hablado con el soporte puede provocar que su cuenta sea suspendida o cerrada mientras se resuelve la disputa. Tiene varias vías: <strong class='text-white'>chat en vivo en la aplicación</strong> dentro de la plataforma web o de escritorio, normalmente la más rápida; <strong class='text-white'>correo electrónico</strong> a support@tradovate.com con los detalles del cargo y las pruebas adjuntas; un <strong class='text-white'>formulario de contacto</strong> en support.tradovate.com, donde puede elegir un tema de facturación o pagos; o <strong class='text-white'>teléfono</strong> al 1-844-283-3100 o 312-283-3100 para consultas de cuenta y facturación. Sea cual sea el canal, indique claramente que se trata de un error de facturación, proporcione los detalles del cargo y solicite el reembolso del importe incorrecto." },
        { title: "Envíe la solicitud dentro del plazo y haga seguimiento", html: "No lo deje pasar. Los cargos erróneos son más fáciles de revertir cuando los señala pronto, en general en un plazo de unas dos semanas desde el cargo, aunque debe confirmar la ventana vigente con el soporte, ya que Tradovate no publica un plazo público fijo. Una vez enviada la solicitud, guarde el número de ticket, esté atento a la respuesta y haga seguimiento si hay silencio. Si el primer agente cierra su caso sin resolverlo, responda en el mismo hilo y pida que lo escalen." },
      ],
    },
    { type: "table", headers: ["Cargo","Qué suele ser"], rows: [
      ["Tarifa de inactividad o mantenimiento","Una cuenta del plan Free que inicia sesión pero no realiza ninguna operación dentro de un plazo establecido."],
      ["Tarifa de autoliquidación","Se cobra por evento cuando la plataforma cierra a la fuerza un incumplimiento de margen."],
      ["Tarifa de bolsa o de datos de mercado","Una suscripción de datos recurrente a la que se suscribió, facturada mensualmente."],
      ["Comisiones","Tarifas de negociación por lado vinculadas al plan de su cuenta."],
    ] },
    { type: "heading",text: "¿Cuenta de firma prop o de evaluación? Lea esto primero" },
    { type: "paragraph",html: "Si tiene una cuenta de firma prop o de evaluación (Apex, Topstep y similares), el dinero que pagó por la evaluación o por un reinicio fue facturado por la firma, no por Tradovate. Los reembolsos y consultas de facturación al respecto deben dirigirse al soporte de su firma prop, y la elegibilidad para reembolsos varía según la firma y el tamaño de la cuenta, así que consulte las reglas vigentes de su firma antes de preguntar." },
    { type: "heading",text: "Mantenga su automatización en marcha mientras resuelve la facturación" },
    { type: "paragraph",html: "Perseguir un cargo no debería costarle setups. PickMyTrade conecta sus alertas de TradingView directamente con Tradovate, de modo que sus entradas, stops y objetivos siguen ejecutándose solos mientras usted trata con el soporte." },
  ], fr: [
    { type: "paragraph",html: "Repérer un prélèvement que vous ne reconnaissez pas sur votre compte Tradovate est agaçant, mais la plupart des véritables erreurs de facturation se règlent vite si vous les traitez de la bonne manière. L'astuce consiste à passer directement par Tradovate, à agir rapidement et à résister à l'envie d'appeler d'abord votre banque. Voici comment contester un prélèvement erroné ou demander un remboursement sans mettre votre compte en danger." },
    { type: "quote",html: "Agissez vite. Les litiges de facturation sont bien plus faciles à annuler lorsque vous les soulevez tôt ; ne laissez donc pas traîner un prélèvement qui semble erroné." },
    { type: "heading",text: "Comment contester un prélèvement Tradovate : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Confirmez le prélèvement dans les rapports de votre compte", html: "Avant d'envoyer un ticket au support, consultez précisément ce qui a été débité sur votre compte. Ouvrez vos rapports ou relevés de compte, trouvez la ligne et notez la date, le montant et la description. Une bonne partie des prélèvements « mystérieux » s'avèrent être des frais que vous aviez simplement oubliés ; connaître les détails rend donc votre dossier solide." },
        { title: "Écartez les frais qui sont réellement valides", html: "Tous les prélèvements ne sont pas des erreurs. Quelques-uns, courants, prennent les gens au dépourvu : des frais d'inactivité ou de maintenance, des frais d'auto-liquidation, des frais de bourse ou de données de marché, ou des commissions. Si le prélèvement correspond à l'un d'eux, il est très probablement légitime et le contester ne fera que vous ralentir. S'il s'agit d'un doublon, d'un mauvais montant ou de quelque chose auquel vous n'avez jamais souscrit, poursuivez." },
        { title: "Rassemblez vos preuves de paiement", html: "Le support va plus vite lorsque vous lui fournissez tout d'emblée. Munissez-vous du nom ou de l'ID de votre compte, de la date et du montant exacts du prélèvement, de l'ID de transaction ou de référence, et d'une capture d'écran ou de la ligne du relevé de carte ou bancaire montrant le débit. Si vous avez un reçu ou un e-mail de confirmation, joignez-le également. Plus vous êtes concret, moins vous aurez d'allers-retours." },
        { title: "Contactez directement le support Tradovate", html: "C'est la partie la plus importante : adressez-vous à Tradovate, pas à votre banque. Déposer une rétrofacturation ou un litige de paiement auprès de l'émetteur de votre carte avant d'avoir parlé au support peut entraîner la suspension ou la fermeture de votre compte pendant le déroulement du litige. Vous avez plusieurs moyens de le joindre : le <strong class='text-white'>chat en direct dans l'application</strong> dans la plateforme web ou de bureau, généralement le plus rapide ; l'<strong class='text-white'>e-mail</strong> à support@tradovate.com avec les détails du prélèvement et les justificatifs en pièce jointe ; un <strong class='text-white'>formulaire de contact</strong> sur support.tradovate.com, où vous pouvez choisir un sujet de facturation ou de paiement ; ou le <strong class='text-white'>téléphone</strong> au 1-844-283-3100 ou 312-283-3100 pour les questions de compte et de facturation. Quel que soit le canal, dites clairement qu'il s'agit d'une erreur de facturation, donnez les détails du prélèvement et demandez le remboursement du montant erroné." },
        { title: "Soumettez dans le délai et relancez", html: "Ne laissez pas traîner. Les prélèvements erronés sont plus faciles à annuler lorsque vous les signalez rapidement, généralement dans un délai d'environ deux semaines après le prélèvement, mais vous devez confirmer la fenêtre en vigueur auprès du support, car Tradovate ne publie pas de délai public fixe. Une fois la demande envoyée, conservez votre numéro de ticket, guettez une réponse et relancez si le silence s'installe. Si le premier conseiller clôt votre dossier sans le régler, répondez dans le même fil et demandez une escalade." },
      ],
    },
    { type: "table", headers: ["Prélèvement","Ce dont il s'agit généralement"], rows: [
      ["Frais d'inactivité ou de maintenance","Un compte du plan Free qui se connecte mais ne passe aucun trade dans une période donnée."],
      ["Frais d'auto-liquidation","Facturés par événement lorsque la plateforme clôture de force un dépassement de marge."],
      ["Frais de bourse ou de données de marché","Un abonnement de données récurrent auquel vous avez souscrit, facturé mensuellement."],
      ["Commissions","Frais de négociation par côté liés à votre plan de compte."],
    ] },
    { type: "heading",text: "Compte de prop firm ou d'évaluation ? Lisez ceci d'abord" },
    { type: "paragraph",html: "Si vous êtes sur un compte de prop firm ou d'évaluation (Apex, Topstep et autres), l'argent que vous avez payé pour l'évaluation ou une réinitialisation a été facturé par la firme, pas par Tradovate. Les remboursements et questions de facturation correspondants doivent être adressés au support de votre prop firm, et l'éligibilité au remboursement varie selon la firme et la taille du compte ; vérifiez donc les règles actuelles de votre firme avant de demander." },
    { type: "heading",text: "Gardez votre automatisation active pendant que vous réglez la facturation" },
    { type: "paragraph",html: "Courir après un prélèvement ne devrait pas vous coûter des setups. PickMyTrade relie vos alertes TradingView directement à Tradovate, de sorte que vos entrées, stops et objectifs continuent de se déclencher seuls pendant que vous traitez avec le support." },
  ], it: [
    { type: "paragraph",html: "Notare un addebito che non riconosce sul suo conto Tradovate è fastidioso, ma la maggior parte dei veri errori di fatturazione si risolve in fretta se li gestisce nel modo giusto. Il trucco è rivolgersi direttamente a Tradovate, agire rapidamente e resistere alla tentazione di chiamare prima la banca. Ecco come contestare un addebito errato o chiedere un rimborso senza mettere a rischio il suo conto." },
    { type: "quote",html: "Agisca in fretta. Le contestazioni di fatturazione sono molto più facili da annullare quando le solleva presto, quindi non lasci passare un addebito che sembra sbagliato." },
    { type: "heading",text: "Come contestare un addebito Tradovate: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Confermi l'addebito nei report del suo conto", html: "Prima di inviare un ticket di supporto, verifichi esattamente cosa è stato addebitato sul suo conto. Apra i report o gli estratti conto, trovi la voce e annoti data, importo e descrizione. Una buona parte degli addebiti «misteriosi» risulta essere una commissione che aveva semplicemente dimenticato, quindi conoscere i dettagli rende la sua richiesta inattaccabile." },
        { title: "Escluda le commissioni effettivamente valide", html: "Non ogni addebito è un errore. Alcuni comuni colgono di sorpresa: una commissione di inattività o di manutenzione, una commissione di auto-liquidazione, una commissione di borsa o di dati di mercato, oppure le commissioni di trading. Se l'addebito corrisponde a una di queste, è molto probabilmente legittimo e contestarlo la rallenterà soltanto. Se si tratta di un duplicato, di un importo errato o di qualcosa a cui non si è mai iscritto, prosegua." },
        { title: "Raccolga la prova di pagamento", html: "Il supporto è più veloce quando Lei fornisce tutto fin dall'inizio. Prepari il nome o l'ID del conto, la data e l'importo esatti dell'addebito, l'ID della transazione o di riferimento e uno screenshot o la riga dell'estratto conto della carta o della banca che mostra l'addebito. Se ha una ricevuta o un'e-mail di conferma, la alleghi. Più è concreto, meno scambi di messaggi dovrà affrontare." },
        { title: "Contatti direttamente il supporto Tradovate", html: "Questa è la parte più importante: si rivolga a Tradovate, non alla sua banca. Presentare uno storno o una contestazione di pagamento all'emittente della carta prima di aver parlato con il supporto può portare alla sospensione o alla chiusura del suo conto mentre la contestazione è in corso. Ha diversi canali: <strong class='text-white'>chat live nell'app</strong> all'interno della piattaforma web o desktop, di solito la via più rapida; <strong class='text-white'>e-mail</strong> a support@tradovate.com con i dettagli dell'addebito e le prove allegate; un <strong class='text-white'>modulo di contatto</strong> su support.tradovate.com, dove può scegliere un argomento di fatturazione o pagamenti; oppure <strong class='text-white'>telefono</strong> al 1-844-283-3100 o 312-283-3100 per questioni di conto e fatturazione. Qualunque canale scelga, dica chiaramente che si tratta di un errore di fatturazione, fornisca i dettagli dell'addebito e chieda il rimborso dell'importo errato." },
        { title: "Invii entro i termini e faccia un follow-up", html: "Non lasci che la cosa si trascini. Gli addebiti errati sono più facili da annullare quando li segnala tempestivamente, in genere entro circa due settimane dall'addebito, anche se dovrebbe confermare la finestra attuale con il supporto, poiché Tradovate non pubblica una scadenza pubblica fissa. Dopo l'invio, conservi il numero del ticket, attenda una risposta e faccia un sollecito se tutto tace. Se il primo operatore chiude la richiesta senza risolverla, risponda nello stesso thread e chieda l'escalation." },
      ],
    },
    { type: "table", headers: ["Addebito","Di cosa si tratta di solito"], rows: [
      ["Commissione di inattività o di manutenzione","Un conto con piano Free che effettua l'accesso ma non esegue alcuna operazione entro un periodo stabilito."],
      ["Commissione di auto-liquidazione","Addebitata per evento quando la piattaforma chiude forzatamente una violazione del margine."],
      ["Commissione di borsa o di dati di mercato","Un abbonamento dati ricorrente a cui si è iscritto, fatturato mensilmente."],
      ["Commissioni","Costi di negoziazione per lato legati al piano del suo conto."],
    ] },
    { type: "heading",text: "Conto di prop firm o di valutazione? Legga prima questo" },
    { type: "paragraph",html: "Se ha un conto di prop firm o di valutazione (Apex, Topstep e simili), il denaro pagato per la valutazione o per un reset è stato fatturato dalla società, non da Tradovate. I rimborsi e le questioni di fatturazione al riguardo vanno indirizzati al supporto della sua prop firm, e l'idoneità al rimborso varia in base alla società e alla dimensione del conto, quindi verifichi le regole attuali della sua società prima di chiedere." },
    { type: "heading",text: "Mantenga attiva la sua automazione mentre risolve la fatturazione" },
    { type: "paragraph",html: "Inseguire un addebito non dovrebbe costarLe dei setup. PickMyTrade collega i suoi alert TradingView direttamente a Tradovate, così ingressi, stop e target continuano a partire da soli mentre Lei si occupa del supporto." },
  ] },
  ctaHeading: { en: "Stop Babysitting Your Charts", de: "Hören Sie auf, Ihre Charts zu bewachen", es: "Deje de vigilar sus gráficos", fr: "Cessez de surveiller vos graphiques", it: "Smetta di sorvegliare i suoi grafici" },
  ctaText: { en: "Chasing down a billing charge shouldn't cost you setups. PickMyTrade wires your TradingView alerts straight into Tradovate, so your entries, stops, and targets keep firing on their own while you deal with support.", de: "Der Kampf um eine Abbuchung sollte Sie keine Setups kosten. PickMyTrade verbindet Ihre TradingView-Alerts direkt mit Tradovate, sodass Ihre Einstiege, Stopps und Ziele von selbst weiterlaufen, während Sie sich um den Support kümmern.", es: "Perseguir un cargo de facturación no debería costarle setups. PickMyTrade conecta sus alertas de TradingView directamente con Tradovate, de modo que sus entradas, stops y objetivos siguen ejecutándose solos mientras usted trata con el soporte.", fr: "Courir après un prélèvement ne devrait pas vous coûter des setups. PickMyTrade relie vos alertes TradingView directement à Tradovate, de sorte que vos entrées, stops et objectifs continuent de se déclencher seuls pendant que vous traitez avec le support.", it: "Inseguire un addebito non dovrebbe costarLe dei setup. PickMyTrade collega i suoi alert TradingView direttamente a Tradovate, così ingressi, stop e target continuano a partire da soli mentre Lei si occupa del supporto." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "How long do I have to dispute a Tradovate charge?", a: "Sooner is always better. Billing disputes are typically resolved most easily when you raise them within about two weeks of the charge. Tradovate doesn't post a fixed public deadline, so if you're near that mark, contact support right away and confirm the current window with them." },
    { q: "Should I dispute the charge with my bank instead?", a: "No, not as a first move. Filing a chargeback with your card issuer before contacting Tradovate can get your account suspended or terminated. Always open a ticket with Tradovate support first and give them a chance to reverse the charge." },
    { q: "What if support doesn't refund a fee I think is unfair?", a: "Some charges, like inactivity, data, and liquidation fees, are valid under Tradovate's terms even if they sting. If it's a genuine fee rather than an error, a refund isn't guaranteed. You can still ask politely and request an exception, but plan around the fee going forward." },
  ], de: [
    { q: "Wie lange habe ich Zeit, eine Tradovate-Abbuchung zu beanstanden?", a: "Je früher, desto besser. Abrechnungsstreitigkeiten lassen sich meist am leichtesten lösen, wenn Sie sie innerhalb von etwa zwei Wochen nach der Abbuchung vorbringen. Tradovate veröffentlicht keine feste öffentliche Frist. Wenn Sie sich dieser Marke nähern, kontaktieren Sie den Support daher sofort und lassen Sie sich das aktuelle Zeitfenster bestätigen." },
    { q: "Sollte ich die Abbuchung stattdessen bei meiner Bank beanstanden?", a: "Nein, nicht als ersten Schritt. Eine Rückbuchung bei Ihrem Kartenaussteller, bevor Sie Tradovate kontaktiert haben, kann dazu führen, dass Ihr Konto gesperrt oder gekündigt wird. Eröffnen Sie immer zuerst ein Ticket beim Tradovate-Support und geben Sie dem Unternehmen die Chance, die Abbuchung rückgängig zu machen." },
    { q: "Was, wenn der Support eine Gebühr, die ich für unfair halte, nicht erstattet?", a: "Manche Abbuchungen, etwa Inaktivitäts-, Daten- und Liquidationsgebühren, sind nach den Bedingungen von Tradovate gültig, auch wenn sie schmerzen. Handelt es sich um eine echte Gebühr und nicht um einen Fehler, ist eine Erstattung nicht garantiert. Sie können dennoch höflich anfragen und um eine Ausnahme bitten, sollten aber künftig mit der Gebühr planen." },
  ], es: [
    { q: "¿Cuánto tiempo tengo para disputar un cargo de Tradovate?", a: "Cuanto antes, mejor. Las disputas de facturación suelen resolverse con más facilidad cuando las plantea en un plazo de unas dos semanas desde el cargo. Tradovate no publica un plazo público fijo, así que si se acerca a ese límite, contacte con el soporte de inmediato y confirme con ellos la ventana vigente." },
    { q: "¿Debería disputar el cargo con mi banco en su lugar?", a: "No, no como primer paso. Presentar una devolución de cargo ante el emisor de su tarjeta antes de contactar con Tradovate puede provocar que su cuenta sea suspendida o cancelada. Abra siempre primero un ticket con el soporte de Tradovate y dé a la empresa la oportunidad de revertir el cargo." },
    { q: "¿Qué pasa si el soporte no reembolsa una tarifa que considero injusta?", a: "Algunos cargos, como las tarifas de inactividad, de datos y de liquidación, son válidos según los términos de Tradovate aunque resulten molestos. Si se trata de una tarifa legítima y no de un error, el reembolso no está garantizado. Aun así puede preguntar con cortesía y solicitar una excepción, pero planifique contando con la tarifa en el futuro." },
  ], fr: [
    { q: "De combien de temps dispose-je pour contester un prélèvement Tradovate ?", a: "Le plus tôt est toujours le mieux. Les litiges de facturation se règlent généralement le plus facilement lorsque vous les soulevez dans un délai d'environ deux semaines après le prélèvement. Tradovate ne publie pas de délai public fixe ; si vous approchez de cette limite, contactez donc le support sans attendre et confirmez avec lui la fenêtre en vigueur." },
    { q: "Dois-je plutôt contester le prélèvement auprès de ma banque ?", a: "Non, pas en premier lieu. Déposer une demande de rétrofacturation auprès de l'émetteur de votre carte avant de contacter Tradovate peut entraîner la suspension ou la résiliation de votre compte. Ouvrez toujours d'abord un ticket auprès du support Tradovate et laissez-lui la possibilité d'annuler le prélèvement." },
    { q: "Que faire si le support ne rembourse pas des frais que je juge injustes ?", a: "Certains prélèvements, comme les frais d'inactivité, de données et de liquidation, sont valides selon les conditions de Tradovate même s'ils piquent. S'il s'agit de frais légitimes et non d'une erreur, le remboursement n'est pas garanti. Vous pouvez tout de même demander poliment une exception, mais prévoyez de composer avec ces frais à l'avenir." },
  ], it: [
    { q: "Di quanto tempo dispongo per contestare un addebito Tradovate?", a: "Prima è sempre meglio. Le contestazioni di fatturazione si risolvono in genere più facilmente quando le solleva entro circa due settimane dall'addebito. Tradovate non pubblica una scadenza pubblica fissa, quindi se si avvicina a quel limite contatti subito il supporto e confermi con loro la finestra attuale." },
    { q: "Devo invece contestare l'addebito con la mia banca?", a: "No, non come prima mossa. Presentare uno storno (chargeback) all'emittente della carta prima di contattare Tradovate può portare alla sospensione o alla chiusura del suo conto. Apra sempre prima un ticket con il supporto Tradovate e dia loro la possibilità di annullare l'addebito." },
    { q: "E se il supporto non rimborsa una commissione che ritengo ingiusta?", a: "Alcuni addebiti, come le commissioni di inattività, di dati e di liquidazione, sono validi secondo i termini di Tradovate anche se pesano. Se si tratta di una commissione legittima e non di un errore, il rimborso non è garantito. Può comunque chiedere con cortesia un'eccezione, ma pianifichi tenendo conto della commissione in futuro." },
  ] },
  relatedHeading: { en: "Related Guides", de: "Verwandte Anleitungen", es: "Guías relacionadas", fr: "Guides associés", it: "Guide correlate" },
  disclosureText: { en: `This guide is for educational and informational purposes only and is not financial, investment, or trading advice. Trading futures and other leveraged products carries a substantial risk of loss and is not suitable for every investor. PickMyTrade is an independent third-party automation platform and is not affiliated with, endorsed by, or sponsored by Tradovate, Inc. "Tradovate" and all related names, logos, and trademarks are the property of their respective owners. Platform features and steps change over time, so always confirm the current process in the official Tradovate platform and documentation before acting.`, de: "Dieser Leitfaden dient ausschließlich Bildungs- und Informationszwecken und stellt keine Finanz-, Anlage- oder Handelsberatung dar. Der Handel mit Futures und anderen gehebelten Produkten birgt ein erhebliches Verlustrisiko und ist nicht für jeden Anleger geeignet. PickMyTrade ist eine unabhängige Automatisierungsplattform eines Drittanbieters und steht in keiner Verbindung zu Tradovate, Inc., wird nicht von Tradovate, Inc. unterstützt oder gesponsert. „Tradovate“ sowie alle zugehörigen Namen, Logos und Marken sind Eigentum ihrer jeweiligen Inhaber. Plattformfunktionen und Schritte ändern sich im Laufe der Zeit. Prüfen Sie daher stets den aktuellen Ablauf in der offiziellen Tradovate-Plattform und -Dokumentation, bevor Sie handeln.", es: "Esta guía tiene fines exclusivamente educativos e informativos y no constituye asesoramiento financiero, de inversión ni de trading. Operar con futuros y otros productos apalancados conlleva un riesgo sustancial de pérdida y no es adecuado para todos los inversores. PickMyTrade es una plataforma de automatización independiente de terceros y no está afiliada, respaldada ni patrocinada por Tradovate, Inc. «Tradovate» y todos los nombres, logotipos y marcas relacionados son propiedad de sus respectivos titulares. Las funciones de la plataforma y los pasos cambian con el tiempo, por lo que siempre debe confirmar el proceso actual en la plataforma y la documentación oficiales de Tradovate antes de actuar.", fr: "Ce guide est fourni à des fins éducatives et informatives uniquement et ne constitue pas un conseil financier, d'investissement ou de trading. La négociation de contrats à terme et d'autres produits à effet de levier comporte un risque de perte important et ne convient pas à tous les investisseurs. PickMyTrade est une plateforme d'automatisation tierce indépendante, non affiliée à Tradovate, Inc., ni approuvée ou parrainée par celle-ci. « Tradovate » ainsi que tous les noms, logos et marques associés sont la propriété de leurs détenteurs respectifs. Les fonctionnalités et les étapes de la plateforme évoluent avec le temps ; vérifiez donc toujours la procédure en vigueur dans la plateforme et la documentation officielles de Tradovate avant d'agir.", it: "Questa guida ha esclusivamente scopo educativo e informativo e non costituisce consulenza finanziaria, di investimento o di trading. Il trading di futures e di altri prodotti a leva comporta un rischio sostanziale di perdita e non è adatto a ogni investitore. PickMyTrade è una piattaforma di automazione indipendente di terze parti e non è affiliata, approvata o sponsorizzata da Tradovate, Inc. «Tradovate» e tutti i nomi, loghi e marchi correlati sono di proprietà dei rispettivi titolari. Le funzionalità della piattaforma e le procedure cambiano nel tempo, quindi verifichi sempre la procedura attuale nella piattaforma e nella documentazione ufficiali di Tradovate prima di agire." },
};
const data: GuideArticleData = resolveGuideContent(content, locale, related);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: data.faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}${withSlash(localizedPath(locale))}` },
    { "@type": "ListItem", position: 2, name: "How-To", item: `${SITE_URL}${withSlash(localizedPath(locale, "how-to"))}` },
    { "@type": "ListItem", position: 3, name: content.h1[locale], item: `${SITE_URL}${withSlash(localizedPath(locale, `how-to/${SLUG}`))}` },
  ],
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: content.h1[locale],
  description: content.dek[locale],
  image: `${SITE_URL}/assets/og-default.webp`,
  publisher: { "@type": "Organization", name: "PickMyTrade", logo: { "@type": "ImageObject", url: `${SITE_URL}/assets/logo.png` } },
  datePublished: "2026-07-10",
  dateModified: "2026-07-10",
  mainEntityOfPage: { "@type": "WebPage", "@id": `${SITE_URL}${withSlash(localizedPath(locale, `how-to/${SLUG}`))}` },
};
---

<BaseLayout
  locale={locale}
  title={`${content.h1[locale]} | PickMyTrade`}
  description={content.dek[locale]}
  ogType="article"
  ogImage="/assets/og-default.webp"
  ldJson={[breadcrumbSchema, faqSchema, articleSchema]}
>
  <GuideArticle locale={locale} data={data} sectionPath="how-to" />
</BaseLayout>
