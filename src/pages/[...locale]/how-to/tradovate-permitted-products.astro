---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-permitted-products";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Restrict Tradable Products in Tradovate";
const META_DESCRIPTION =
  "Restrict a futures account to specific products using the Products Permitted setting, so orders for any other contract are rejected automatically.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Handelbare Produkte in Tradovate einschränken", es: "Cómo restringir los productos negociables en Tradovate", fr: "Restreindre les produits négociables dans Tradovate", it: "Limitare i prodotti negoziabili in Tradovate" },
  dek: { en: "If you keep fat-fingering the wrong contract, or you only ever want one or two instruments touching a given account, you can make Tradovate enforce that for you with a Products Permitted whitelist.", de: "Wenn Sie ständig den falschen Kontrakt erwischen oder auf einem Konto nur ein oder zwei Instrumente handeln möchten, kann Tradovate das mit einer Whitelist unter Products Permitted für Sie durchsetzen.", es: "Si siempre se equivoca de contrato, o solo quiere que uno o dos instrumentos toquen una cuenta determinada, puede hacer que Tradovate lo imponga por usted con una lista blanca de Products Permitted.", fr: "Si vous vous trompez sans cesse de contrat, ou si vous ne voulez qu’un ou deux instruments sur un compte donné, vous pouvez demander à Tradovate de l’imposer pour vous grâce à une liste blanche Products Permitted.", it: "Se continua a sbagliare contratto, o vuole che su un determinato conto operino solo uno o due strumenti, può far sì che sia Tradovate a imporlo per lei con una whitelist Products Permitted." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "If you keep fat-fingering the wrong contract, or you only ever want one or two instruments touching a given account, you can make Tradovate enforce that for you. The Products Permitted setting turns the account into a whitelist. You list the contracts you're allowed to trade, and every order for anything else gets rejected before it can fill." },
    { type: "paragraph", html: "It's a simple guardrail, but a useful one. A scalper who only trades NQ can lock the account to NQ and never open an ES position by mistake again." },
    { type: "heading", text: "What Products Permitted Does" },
    { type: "paragraph", html: "By default a Tradovate account can trade any product you have market access and data for. Products Permitted flips that around: once it's on, the account only accepts orders for the specific symbols you've added. Everything else is blocked at the account level, so it applies whether the order comes from the platform, a mobile app, or an automated feed." },
    { type: "paragraph", html: "Think of it as an allow-list, not a block-list. You're not naming the products you want to avoid. You're naming the short list of products you want to keep, and Tradovate handles the rest." },
    { type: "heading", text: "Before You Start" },
    {
      type: "list",
      items: [
        "This is an account-level control that lives with your Tradovate risk settings, so you'll want to be logged in to the account you want to restrict.",
        "It's meant for live and self-funded demo accounts. On a prop firm evaluation account, product permissions are usually controlled by the firm rather than by you, so the option may be greyed out or missing. Rules vary by firm and account type, so check your firm's current setup.",
        "Have your symbol list ready. Know exactly which contracts you want to allow before you switch it on, because anything you forget to add will start rejecting.",
      ],
    },
    { type: "heading", text: "Restrict Tradable Products in Tradovate: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open Application Settings", html: "Log in to Tradovate on the web or desktop app. Click the <strong class='text-white'>Application Settings</strong> button in the top-right corner of the platform. This is the same menu you use to set daily loss limits and a max position size, so if you've touched those before, you already know where to look." },
        { title: "Find the Products Permitted Control", html: 'Inside Application Settings, open the <strong class=\'text-white\'>Risk Settings</strong> area. Scroll to the section labelled <strong class=\'text-white\'>Products Permitted</strong> (some screens show it as "Permitted Products"). If you can\'t find it at all, double-check you\'re on a live or demo account and not a firm-managed evaluation account, where the control is often hidden.' },
        { title: "Turn On Products Permitted", html: "Click the control to switch <strong class='text-white'>Products Permitted</strong> on. Until you do this, the account stays unrestricted and trades every product you have access to. Flipping the toggle is what activates the whitelist, so nothing changes for your trading until it's on and you've added at least one symbol." },
        { title: "Add the Products You Want to Allow", html: "With the setting on, add each contract you plan to trade. Search for or type the product's symbol, for example <strong class='text-white'>NQ</strong>, <strong class='text-white'>ES</strong>, or <strong class='text-white'>MNQ</strong>, and add it to the permitted list. Add every symbol you genuinely trade, including the micro versions if you trade both minis and micros. Whatever you leave off gets blocked, so it's worth taking a moment to list them all." },
        { title: "Save and Test the Restriction", html: "Save your settings. Then prove it works: place a small test order on a product that's <em>not</em> on your list. It should come straight back rejected. Follow that with an order on a permitted product, which should go through as normal. That thirty-second check is the difference between assuming the guardrail is on and knowing it is." },
      ],
    },
    { type: "heading", text: "What a Blocked Order Looks Like" },
    { type: "paragraph", html: "Say you permit only NQ. If you then try to buy ES, the order won't sit as working or partially fill. It's rejected outright, and you'll see a rejection reason on the order. Nothing reaches the exchange. This is what makes the setting a clean hard stop against trading the wrong instrument." },
    {
      type: "table",
      headers: ["Situation", "Result"],
      rows: [
        ["You permit only NQ, then place an NQ order", "Accepted"],
        ["You permit only NQ, then place an ES order", "Rejected"],
        ["Products Permitted is off", "Any product you have access to is accepted"],
      ],
    },
    { type: "heading", text: "A Few Things to Keep in Mind" },
    { type: "paragraph", html: "If a symbol you allowed suddenly starts rejecting after a contract rollover, reopen the permitted list and confirm the entry still reads the way you expect before you go hunting for other causes." },
    { type: "paragraph", html: "The restriction also applies to automated orders. If you route entries from TradingView or another signal source, an order for a contract you didn't add gets rejected exactly like a manual click would. That's usually a feature, not a bug, but it's the first thing to check if an automated strategy stops filling on a new instrument. To widen or narrow what's allowed, just come back to Risk Settings and edit the list." },
    { type: "paragraph", html: "Products Permitted pairs well with the rest of Tradovate's account controls. Combine it with a max position limit to cap size and a daily loss limit to cap risk, and you've fenced in the account on three fronts: what you can trade, how big, and how much you can lose in a day." },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Running automated entries into Tradovate? <strong class='text-white'>PickMyTrade routes your TradingView alerts to Tradovate</strong> with no coding, so your signals fire fast while your account's own Products Permitted whitelist keeps them pointed at the right contracts." },
  ], de: [
    { type: "paragraph",html: "Wenn Sie ständig den falschen Kontrakt erwischen oder auf einem Konto nur ein oder zwei Instrumente handeln möchten, kann Tradovate das für Sie durchsetzen. Die Einstellung Products Permitted verwandelt das Konto in eine Whitelist. Sie führen die Kontrakte auf, die Sie handeln dürfen, und jede Order für alles andere wird abgelehnt, bevor sie ausgeführt werden kann." },
    { type: "paragraph",html: "Es ist eine einfache Schutzvorrichtung, aber eine nützliche. Ein Scalper, der nur NQ handelt, kann das Konto auf NQ beschränken und nie wieder versehentlich eine ES-Position eröffnen." },
    { type: "heading",text: "Was Products Permitted bewirkt" },
    { type: "paragraph",html: "Standardmäßig kann ein Tradovate-Konto jedes Produkt handeln, für das Sie Marktzugang und Daten haben. Products Permitted kehrt das um: Sobald die Einstellung aktiv ist, akzeptiert das Konto nur noch Orders für die Symbole, die Sie hinzugefügt haben. Alles andere wird auf Kontoebene blockiert, unabhängig davon, ob die Order von der Plattform, einer Mobile-App oder einem automatisierten Feed kommt." },
    { type: "paragraph",html: "Sehen Sie es als Positivliste, nicht als Sperrliste. Sie nennen nicht die Produkte, die Sie meiden wollen. Sie nennen die kurze Liste der Produkte, die Sie behalten möchten, und Tradovate erledigt den Rest." },
    { type: "heading",text: "Bevor Sie beginnen" },
    {
      type: "list",
      items: [
        "Dies ist eine Steuerung auf Kontoebene, die zu Ihren Tradovate-Risikoeinstellungen gehört. Sie sollten also bei dem Konto angemeldet sein, das Sie einschränken möchten.",
        "Sie ist für Live-Konten und selbstfinanzierte Demo-Konten gedacht. Bei einem Evaluierungskonto einer Prop-Firma werden Produktfreigaben in der Regel von der Firma gesteuert und nicht von Ihnen, daher kann die Option ausgegraut sein oder fehlen. Die Regeln variieren je nach Firma und Kontotyp. Prüfen Sie daher die aktuelle Einrichtung Ihrer Firma.",
        "Halten Sie Ihre Symbolliste bereit. Wissen Sie genau, welche Kontrakte Sie zulassen möchten, bevor Sie die Funktion einschalten, denn alles, was Sie vergessen hinzuzufügen, wird ab dann abgelehnt.",
      ],
    },
    { type: "heading",text: "Handelbare Produkte in Tradovate einschränken: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Application Settings öffnen", html: "Melden Sie sich bei Tradovate im Web oder in der Desktop-App an. Klicken Sie oben rechts in der Plattform auf die Schaltfläche <strong class='text-white'>Application Settings</strong>. Es ist dasselbe Menü, in dem Sie tägliche Verlustlimits und eine maximale Positionsgröße festlegen. Wenn Sie diese schon einmal angefasst haben, wissen Sie also bereits, wo Sie suchen müssen." },
        { title: "Die Steuerung Products Permitted finden", html: "Öffnen Sie in den Application Settings den Bereich <strong class='text-white'>Risk Settings</strong>. Scrollen Sie zum Abschnitt <strong class='text-white'>Products Permitted</strong> (manche Ansichten zeigen ihn als „Permitted Products“ an). Wenn Sie ihn gar nicht finden, prüfen Sie noch einmal, ob Sie sich auf einem Live- oder Demo-Konto befinden und nicht auf einem von einer Firma verwalteten Evaluierungskonto, bei dem die Steuerung oft ausgeblendet ist." },
        { title: "Products Permitted einschalten", html: "Klicken Sie auf die Steuerung, um <strong class='text-white'>Products Permitted</strong> einzuschalten. Solange Sie das nicht tun, bleibt das Konto unbeschränkt und handelt jedes Produkt, auf das Sie Zugriff haben. Das Umlegen des Schalters aktiviert die Whitelist. Es ändert sich also nichts an Ihrem Handel, bis sie eingeschaltet ist und Sie mindestens ein Symbol hinzugefügt haben." },
        { title: "Die zugelassenen Produkte hinzufügen", html: "Fügen Sie bei eingeschalteter Einstellung jeden Kontrakt hinzu, den Sie handeln möchten. Suchen Sie das Symbol des Produkts oder geben Sie es ein, zum Beispiel <strong class='text-white'>NQ</strong>, <strong class='text-white'>ES</strong> oder <strong class='text-white'>MNQ</strong>, und fügen Sie es der Liste der zugelassenen Produkte hinzu. Fügen Sie jedes Symbol hinzu, das Sie tatsächlich handeln, einschließlich der Micro-Versionen, wenn Sie sowohl Minis als auch Micros handeln. Alles, was Sie weglassen, wird blockiert. Nehmen Sie sich also einen Moment Zeit, um alle aufzulisten." },
        { title: "Speichern und die Einschränkung testen", html: "Speichern Sie Ihre Einstellungen. Prüfen Sie dann, ob es funktioniert: Platzieren Sie eine kleine Testorder auf einem Produkt, das <em>nicht</em> auf Ihrer Liste steht. Sie sollte sofort abgelehnt zurückkommen. Platzieren Sie danach eine Order auf einem zugelassenen Produkt, die normal durchgehen sollte. Diese Prüfung von dreißig Sekunden entscheidet darüber, ob Sie nur annehmen, dass die Schutzvorrichtung aktiv ist, oder es sicher wissen." },
      ],
    },
    { type: "heading",text: "Wie eine blockierte Order aussieht" },
    { type: "paragraph",html: "Angenommen, Sie lassen nur NQ zu. Wenn Sie dann versuchen, ES zu kaufen, bleibt die Order weder aktiv noch wird sie teilweise ausgeführt. Sie wird sofort abgelehnt, und Sie sehen an der Order einen Ablehnungsgrund. Nichts erreicht die Börse. Das macht die Einstellung zu einem sauberen harten Stopp gegen den Handel mit dem falschen Instrument." },
    { type: "table", headers: ["Situation","Ergebnis"], rows: [
      ["Sie lassen nur NQ zu und platzieren dann eine NQ-Order","Akzeptiert"],
      ["Sie lassen nur NQ zu und platzieren dann eine ES-Order","Abgelehnt"],
      ["Products Permitted ist ausgeschaltet","Jedes Produkt, auf das Sie Zugriff haben, wird akzeptiert"],
    ] },
    { type: "heading",text: "Einige Dinge, die Sie beachten sollten" },
    { type: "paragraph",html: "Wenn ein von Ihnen zugelassenes Symbol nach einem Kontraktwechsel plötzlich abgelehnt wird, öffnen Sie die Liste der zugelassenen Produkte erneut und prüfen Sie, ob der Eintrag noch so lautet, wie Sie es erwarten, bevor Sie nach anderen Ursachen suchen." },
    { type: "paragraph",html: "Die Einschränkung gilt auch für automatisierte Orders. Wenn Sie Einstiege aus TradingView oder einer anderen Signalquelle weiterleiten, wird eine Order für einen nicht hinzugefügten Kontrakt genauso abgelehnt wie bei einem manuellen Klick. Das ist meist ein Feature, kein Fehler, aber es ist das Erste, was Sie prüfen sollten, wenn eine automatisierte Strategie bei einem neuen Instrument nicht mehr ausgeführt wird. Um das Zugelassene zu erweitern oder einzugrenzen, kehren Sie einfach zu den Risk Settings zurück und bearbeiten die Liste." },
    { type: "paragraph",html: "Products Permitted ergänzt sich gut mit den übrigen Kontosteuerungen von Tradovate. Kombinieren Sie es mit einem Limit für die maximale Positionsgröße zur Begrenzung der Größe und einem täglichen Verlustlimit zur Begrenzung des Risikos, und Sie haben das Konto an drei Fronten abgesichert: was Sie handeln dürfen, wie groß und wie viel Sie an einem Tag verlieren können." },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "Leiten Sie automatisierte Einstiege in Tradovate? <strong class='text-white'>PickMyTrade leitet Ihre TradingView-Alerts ohne Programmierung an Tradovate weiter</strong>, sodass Ihre Signale schnell ausgelöst werden, während die Whitelist Products Permitted Ihres Kontos sie auf die richtigen Kontrakte beschränkt." },
  ], es: [
    { type: "paragraph",html: "Si siempre se equivoca de contrato, o solo quiere que uno o dos instrumentos toquen una cuenta determinada, puede hacer que Tradovate lo imponga por usted. El ajuste Products Permitted convierte la cuenta en una lista blanca. Usted enumera los contratos que tiene permitido operar, y cualquier orden para cualquier otra cosa se rechaza antes de poder ejecutarse." },
    { type: "paragraph",html: "Es una protección sencilla, pero útil. Un scalper que solo opera NQ puede limitar la cuenta a NQ y no volver a abrir una posición en ES por error." },
    { type: "heading",text: "Qué hace Products Permitted" },
    { type: "paragraph",html: "De forma predeterminada, una cuenta de Tradovate puede operar cualquier producto para el que tenga acceso al mercado y datos. Products Permitted invierte eso: una vez activado, la cuenta solo acepta órdenes para los símbolos que haya añadido. Todo lo demás se bloquea a nivel de cuenta, así que se aplica tanto si la orden viene de la plataforma, de una app móvil o de un feed automatizado." },
    { type: "paragraph",html: "Piense en ello como una lista de permitidos, no una lista de bloqueo. No nombra los productos que quiere evitar. Nombra la lista corta de productos que quiere conservar, y Tradovate se encarga del resto." },
    { type: "heading",text: "Antes de empezar" },
    {
      type: "list",
      items: [
        "Es un control a nivel de cuenta que reside junto a su configuración de riesgo de Tradovate, por lo que deberá haber iniciado sesión en la cuenta que quiere restringir.",
        "Está pensado para cuentas reales y cuentas demo autofinanciadas. En una cuenta de evaluación de una prop firm, los permisos de producto suelen estar controlados por la firma y no por usted, por lo que la opción puede aparecer atenuada o no aparecer. Las reglas varían según la firma y el tipo de cuenta, así que compruebe la configuración vigente de su firma.",
        "Tenga lista su lista de símbolos. Sepa exactamente qué contratos quiere permitir antes de activarlo, porque todo lo que olvide añadir empezará a rechazarse.",
      ],
    },
    { type: "heading",text: "Cómo restringir los productos negociables en Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra Application Settings", html: "Inicie sesión en Tradovate en la web o en la aplicación de escritorio. Haga clic en el botón <strong class='text-white'>Application Settings</strong> de la esquina superior derecha de la plataforma. Es el mismo menú que usa para definir límites de pérdida diaria y un tamaño máximo de posición, así que si ya los ha tocado antes, sabe dónde buscar." },
        { title: "Encuentre el control Products Permitted", html: "Dentro de Application Settings, abra el área <strong class='text-white'>Risk Settings</strong>. Desplácese hasta la sección llamada <strong class='text-white'>Products Permitted</strong> (algunas pantallas la muestran como “Permitted Products”). Si no la encuentra en absoluto, compruebe que está en una cuenta real o demo y no en una cuenta de evaluación gestionada por una firma, donde el control suele estar oculto." },
        { title: "Active Products Permitted", html: "Haga clic en el control para activar <strong class='text-white'>Products Permitted</strong>. Hasta que lo haga, la cuenta sigue sin restricciones y opera todos los productos a los que tenga acceso. Al activar el interruptor se activa la lista blanca, así que nada cambia en su operativa hasta que esté activado y haya añadido al menos un símbolo." },
        { title: "Añada los productos que quiere permitir", html: "Con el ajuste activado, añada cada contrato que piense operar. Busque o escriba el símbolo del producto, por ejemplo <strong class='text-white'>NQ</strong>, <strong class='text-white'>ES</strong> o <strong class='text-white'>MNQ</strong>, y añádalo a la lista de permitidos. Añada todos los símbolos que realmente opere, incluidas las versiones micro si opera tanto minis como micros. Todo lo que deje fuera se bloquea, así que conviene dedicar un momento a enumerarlos todos." },
        { title: "Guarde y pruebe la restricción", html: "Guarde su configuración. Después compruebe que funciona: coloque una pequeña orden de prueba en un producto que <em>no</em> esté en su lista. Debería volver rechazada de inmediato. A continuación, coloque una orden en un producto permitido, que debería ejecutarse con normalidad. Esa comprobación de treinta segundos marca la diferencia entre suponer que la protección está activa y saber que lo está." },
      ],
    },
    { type: "heading",text: "Qué aspecto tiene una orden bloqueada" },
    { type: "paragraph",html: "Supongamos que solo permite NQ. Si después intenta comprar ES, la orden no quedará activa ni se ejecutará parcialmente. Se rechaza de plano y verá un motivo de rechazo en la orden. Nada llega a la bolsa. Esto es lo que convierte el ajuste en un freno duro y limpio contra operar el instrumento equivocado." },
    { type: "table", headers: ["Situación","Resultado"], rows: [
      ["Solo permite NQ y luego coloca una orden de NQ","Aceptada"],
      ["Solo permite NQ y luego coloca una orden de ES","Rechazada"],
      ["Products Permitted está desactivado","Se acepta cualquier producto al que tenga acceso"],
    ] },
    { type: "heading",text: "Algunas cosas que conviene tener en cuenta" },
    { type: "paragraph",html: "Si un símbolo que permitió empieza de repente a rechazarse tras un cambio de contrato (rollover), vuelva a abrir la lista de permitidos y confirme que la entrada sigue siendo la que espera antes de buscar otras causas." },
    { type: "paragraph",html: "La restricción también se aplica a las órdenes automatizadas. Si dirige entradas desde TradingView u otra fuente de señales, una orden para un contrato que no añadió se rechaza igual que lo haría un clic manual. Suele ser una característica, no un error, pero es lo primero que hay que comprobar si una estrategia automatizada deja de ejecutarse en un instrumento nuevo. Para ampliar o reducir lo permitido, solo tiene que volver a Risk Settings y editar la lista." },
    { type: "paragraph",html: "Products Permitted combina bien con el resto de controles de cuenta de Tradovate. Combínelo con un límite de posición máxima para acotar el tamaño y un límite de pérdida diaria para acotar el riesgo, y habrá blindado la cuenta en tres frentes: qué puede operar, de qué tamaño y cuánto puede perder en un día." },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "¿Dirige entradas automatizadas a Tradovate? <strong class='text-white'>PickMyTrade envía sus alertas de TradingView a Tradovate sin programar</strong>, para que sus señales se ejecuten rápido mientras la lista blanca de Products Permitted de su cuenta las mantiene apuntando a los contratos correctos." },
  ], fr: [
    { type: "paragraph",html: "Si vous vous trompez sans cesse de contrat, ou si vous ne voulez qu’un ou deux instruments sur un compte donné, vous pouvez demander à Tradovate de l’imposer pour vous. Le paramètre Products Permitted transforme le compte en liste blanche. Vous indiquez les contrats que vous avez le droit de trader, et tout ordre portant sur autre chose est rejeté avant de pouvoir être exécuté." },
    { type: "paragraph",html: "C’est un garde-fou simple, mais utile. Un scalpeur qui ne trade que le NQ peut verrouiller le compte sur le NQ et ne plus jamais ouvrir une position ES par erreur." },
    { type: "heading",text: "Ce que fait Products Permitted" },
    { type: "paragraph",html: "Par défaut, un compte Tradovate peut trader tout produit pour lequel vous disposez d’un accès au marché et de données. Products Permitted inverse cela : une fois activé, le compte n’accepte que les ordres portant sur les symboles que vous avez ajoutés. Tout le reste est bloqué au niveau du compte, que l’ordre vienne de la plateforme, d’une application mobile ou d’un flux automatisé." },
    { type: "paragraph",html: "Considérez-le comme une liste d’autorisation, pas une liste d’exclusion. Vous ne nommez pas les produits que vous voulez éviter. Vous nommez la courte liste de produits que vous souhaitez conserver, et Tradovate s’occupe du reste." },
    { type: "heading",text: "Avant de commencer" },
    {
      type: "list",
      items: [
        "Il s’agit d’un contrôle au niveau du compte, rattaché à vos paramètres de risque Tradovate ; vous devez donc être connecté au compte que vous souhaitez restreindre.",
        "Il est conçu pour les comptes réels et les comptes de démonstration autofinancés. Sur un compte d’évaluation de prop firm, les autorisations de produits sont généralement contrôlées par la firme et non par vous ; l’option peut donc être grisée ou absente. Les règles varient selon la firme et le type de compte : vérifiez la configuration en vigueur de votre firme.",
        "Ayez votre liste de symboles prête. Sachez exactement quels contrats vous voulez autoriser avant de l’activer, car tout ce que vous oubliez d’ajouter sera rejeté.",
      ],
    },
    { type: "heading",text: "Restreindre les produits négociables dans Tradovate : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir Application Settings", html: "Connectez-vous à Tradovate sur le web ou dans l’application de bureau. Cliquez sur le bouton <strong class='text-white'>Application Settings</strong> en haut à droite de la plateforme. C’est le même menu que celui où vous définissez les limites de perte quotidienne et une taille de position maximale ; si vous y êtes déjà allé, vous savez où chercher." },
        { title: "Trouver le contrôle Products Permitted", html: "Dans Application Settings, ouvrez la zone <strong class='text-white'>Risk Settings</strong>. Faites défiler jusqu’à la section intitulée <strong class='text-white'>Products Permitted</strong> (certains écrans l’affichent sous « Permitted Products »). Si vous ne la trouvez pas du tout, vérifiez que vous êtes sur un compte réel ou de démonstration et non sur un compte d’évaluation géré par une firme, où le contrôle est souvent masqué." },
        { title: "Activer Products Permitted", html: "Cliquez sur le contrôle pour activer <strong class='text-white'>Products Permitted</strong>. Tant que vous ne le faites pas, le compte reste sans restriction et trade tous les produits auxquels vous avez accès. C’est l’activation du commutateur qui met en service la liste blanche : rien ne change donc pour votre trading tant qu’il n’est pas activé et que vous n’avez pas ajouté au moins un symbole." },
        { title: "Ajouter les produits que vous voulez autoriser", html: "Une fois le paramètre activé, ajoutez chaque contrat que vous comptez trader. Recherchez ou saisissez le symbole du produit, par exemple <strong class='text-white'>NQ</strong>, <strong class='text-white'>ES</strong> ou <strong class='text-white'>MNQ</strong>, et ajoutez-le à la liste des produits autorisés. Ajoutez tous les symboles que vous tradez réellement, y compris les versions micro si vous tradez à la fois des minis et des micros. Tout ce que vous omettez est bloqué ; prenez donc un instant pour tous les lister." },
        { title: "Enregistrer et tester la restriction", html: "Enregistrez vos paramètres. Puis vérifiez que cela fonctionne : passez un petit ordre de test sur un produit qui <em>ne figure pas</em> sur votre liste. Il doit être rejeté immédiatement. Passez ensuite un ordre sur un produit autorisé, qui doit passer normalement. Ce contrôle de trente secondes fait la différence entre supposer que le garde-fou est actif et savoir qu’il l’est." },
      ],
    },
    { type: "heading",text: "À quoi ressemble un ordre bloqué" },
    { type: "paragraph",html: "Supposons que vous n’autorisiez que le NQ. Si vous essayez ensuite d’acheter de l’ES, l’ordre ne restera ni actif ni partiellement exécuté. Il est rejeté d’emblée, et vous verrez un motif de rejet sur l’ordre. Rien n’atteint la bourse. C’est ce qui fait de ce paramètre un arrêt net et définitif contre le trading du mauvais instrument." },
    { type: "table", headers: ["Situation","Résultat"], rows: [
      ["Vous n’autorisez que le NQ, puis passez un ordre NQ","Accepté"],
      ["Vous n’autorisez que le NQ, puis passez un ordre ES","Rejeté"],
      ["Products Permitted est désactivé","Tout produit auquel vous avez accès est accepté"],
    ] },
    { type: "heading",text: "Quelques points à garder en tête" },
    { type: "paragraph",html: "Si un symbole que vous aviez autorisé se met soudain à être rejeté après un roll de contrat, rouvrez la liste des produits autorisés et vérifiez que l’entrée correspond toujours à ce que vous attendez avant de chercher d’autres causes." },
    { type: "paragraph",html: "La restriction s’applique aussi aux ordres automatisés. Si vous acheminez des entrées depuis TradingView ou une autre source de signaux, un ordre portant sur un contrat que vous n’avez pas ajouté est rejeté exactement comme un clic manuel. C’est généralement une fonctionnalité, pas un bug, mais c’est la première chose à vérifier si une stratégie automatisée cesse d’être exécutée sur un nouvel instrument. Pour élargir ou réduire ce qui est autorisé, revenez simplement dans Risk Settings et modifiez la liste." },
    { type: "paragraph",html: "Products Permitted se marie bien avec les autres contrôles de compte de Tradovate. Associez-le à une limite de position maximale pour plafonner la taille et à une limite de perte quotidienne pour plafonner le risque, et vous aurez encadré le compte sur trois fronts : ce que vous pouvez trader, en quelle taille et combien vous pouvez perdre en une journée." },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Vous acheminez des entrées automatisées vers Tradovate ? <strong class='text-white'>PickMyTrade achemine vos alertes TradingView vers Tradovate sans coder</strong>, pour que vos signaux s’exécutent rapidement tandis que la liste blanche Products Permitted de votre compte les maintient sur les bons contrats." },
  ], it: [
    { type: "paragraph",html: "Se continua a sbagliare contratto, o vuole che su un determinato conto operino solo uno o due strumenti, può far sì che sia Tradovate a imporlo per lei. L’impostazione Products Permitted trasforma il conto in una whitelist. Lei elenca i contratti che può negoziare, e ogni ordine su qualsiasi altra cosa viene rifiutato prima di poter essere eseguito." },
    { type: "paragraph",html: "È una semplice protezione, ma utile. Uno scalper che opera solo NQ può bloccare il conto su NQ e non aprire mai più per errore una posizione su ES." },
    { type: "heading",text: "Cosa fa Products Permitted" },
    { type: "paragraph",html: "Per impostazione predefinita, un conto Tradovate può negoziare qualsiasi prodotto per il quale lei abbia accesso al mercato e ai dati. Products Permitted ribalta la situazione: una volta attivo, il conto accetta solo ordini per i simboli che ha aggiunto. Tutto il resto viene bloccato a livello di conto, quindi vale sia che l’ordine arrivi dalla piattaforma, da un’app mobile o da un feed automatizzato." },
    { type: "paragraph",html: "La consideri una lista di consentiti, non una lista di blocco. Non indica i prodotti che vuole evitare. Indica la breve lista di prodotti che vuole mantenere, e Tradovate pensa al resto." },
    { type: "heading",text: "Prima di iniziare" },
    {
      type: "list",
      items: [
        "Si tratta di un controllo a livello di conto che risiede insieme alle sue impostazioni di rischio di Tradovate, quindi deve aver effettuato l’accesso al conto che vuole limitare.",
        "È pensata per conti live e conti demo autofinanziati. Su un conto di valutazione di una prop firm, i permessi sui prodotti sono di solito controllati dalla firm e non da lei, quindi l’opzione può risultare disattivata o mancare. Le regole variano in base alla firm e al tipo di conto: verifichi la configurazione attuale della sua firm.",
        "Abbia pronta la lista dei simboli. Sappia esattamente quali contratti vuole consentire prima di attivarla, perché tutto ciò che dimentica di aggiungere inizierà a essere rifiutato.",
      ],
    },
    { type: "heading",text: "Limitare i prodotti negoziabili in Tradovate: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Aprire Application Settings", html: "Acceda a Tradovate dal web o dall’app desktop. Faccia clic sul pulsante <strong class='text-white'>Application Settings</strong> nell’angolo in alto a destra della piattaforma. È lo stesso menu che usa per impostare i limiti di perdita giornaliera e la dimensione massima della posizione, quindi se li ha già toccati sa dove guardare." },
        { title: "Trovare il controllo Products Permitted", html: "In Application Settings, apra l’area <strong class='text-white'>Risk Settings</strong>. Scorra fino alla sezione denominata <strong class='text-white'>Products Permitted</strong> (alcune schermate la mostrano come “Permitted Products”). Se non riesce a trovarla affatto, verifichi di essere su un conto live o demo e non su un conto di valutazione gestito da una firm, dove il controllo è spesso nascosto." },
        { title: "Attivare Products Permitted", html: "Faccia clic sul controllo per attivare <strong class='text-white'>Products Permitted</strong>. Finché non lo fa, il conto resta senza restrizioni e negozia tutti i prodotti a cui ha accesso. È l’attivazione dell’interruttore a rendere operativa la whitelist, quindi nulla cambia nel suo trading finché non è attiva e non ha aggiunto almeno un simbolo." },
        { title: "Aggiungere i prodotti che vuole consentire", html: "Con l’impostazione attiva, aggiunga ogni contratto che intende negoziare. Cerchi o digiti il simbolo del prodotto, ad esempio <strong class='text-white'>NQ</strong>, <strong class='text-white'>ES</strong> o <strong class='text-white'>MNQ</strong>, e lo aggiunga alla lista dei consentiti. Aggiunga ogni simbolo che negozia davvero, comprese le versioni micro se opera sia mini sia micro. Tutto ciò che lascia fuori viene bloccato, quindi vale la pena dedicare un momento per elencarli tutti." },
        { title: "Salvare e testare la restrizione", html: "Salvi le impostazioni. Poi verifichi che funzioni: inserisca un piccolo ordine di prova su un prodotto che <em>non</em> è nella sua lista. Dovrebbe tornare subito rifiutato. Poi inserisca un ordine su un prodotto consentito, che dovrebbe passare normalmente. Questo controllo di trenta secondi fa la differenza tra supporre che la protezione sia attiva e sapere che lo è." },
      ],
    },
    { type: "heading",text: "Come appare un ordine bloccato" },
    { type: "paragraph",html: "Supponiamo che consenta solo NQ. Se poi prova ad acquistare ES, l’ordine non resterà in lavorazione né verrà eseguito parzialmente. Viene rifiutato subito e vedrà un motivo di rifiuto sull’ordine. Nulla raggiunge la borsa. È ciò che rende l’impostazione un netto blocco rigido contro la negoziazione dello strumento sbagliato." },
    { type: "table", headers: ["Situazione","Risultato"], rows: [
      ["Consente solo NQ, poi inserisce un ordine su NQ","Accettato"],
      ["Consente solo NQ, poi inserisce un ordine su ES","Rifiutato"],
      ["Products Permitted è disattivato","Qualsiasi prodotto a cui ha accesso viene accettato"],
    ] },
    { type: "heading",text: "Alcune cose da tenere a mente" },
    { type: "paragraph",html: "Se un simbolo che aveva consentito inizia improvvisamente a essere rifiutato dopo un rollover del contratto, riapra la lista dei consentiti e confermi che la voce sia ancora quella che si aspetta prima di cercare altre cause." },
    { type: "paragraph",html: "La restrizione si applica anche agli ordini automatizzati. Se instrada ingressi da TradingView o da un’altra fonte di segnali, un ordine per un contratto che non ha aggiunto viene rifiutato esattamente come un clic manuale. Di solito è una funzione, non un bug, ma è la prima cosa da controllare se una strategia automatizzata smette di essere eseguita su un nuovo strumento. Per ampliare o restringere ciò che è consentito, torni semplicemente in Risk Settings e modifichi la lista." },
    { type: "paragraph",html: "Products Permitted si abbina bene al resto dei controlli del conto di Tradovate. Lo combini con un limite di posizione massima per limitare la dimensione e con un limite di perdita giornaliera per limitare il rischio, e avrà messo in sicurezza il conto su tre fronti: cosa può negoziare, quanto grande e quanto può perdere in un giorno." },
    { type: "heading",text: "Automatizzi tutto con PickMyTrade" },
    { type: "paragraph",html: "Instrada ingressi automatizzati verso Tradovate? <strong class='text-white'>PickMyTrade instrada i suoi alert di TradingView verso Tradovate senza programmare</strong>, così i suoi segnali partono velocemente mentre la whitelist Products Permitted del suo conto li mantiene puntati sui contratti giusti." },
  ] },
  ctaHeading: { en: "Route Signals Into a Locked-Down Account", de: "Signale in ein abgesichertes Konto leiten", es: "Dirija las señales a una cuenta blindada", fr: "Acheminez vos signaux vers un compte verrouillé", it: "Instradi i segnali verso un conto blindato" },
  ctaText: { en: "PickMyTrade routes your TradingView alerts to Tradovate with no coding, so your signals fire fast while your account's own Products Permitted whitelist keeps them pointed at the right contracts.", de: "PickMyTrade leitet Ihre TradingView-Alerts ohne Programmierung an Tradovate weiter, sodass Ihre Signale schnell ausgelöst werden, während die Whitelist Products Permitted Ihres Kontos sie auf die richtigen Kontrakte beschränkt.", es: "PickMyTrade envía sus alertas de TradingView a Tradovate sin programar, para que sus señales se ejecuten rápido mientras la lista blanca de Products Permitted de su cuenta las mantiene apuntando a los contratos correctos.", fr: "PickMyTrade achemine vos alertes TradingView vers Tradovate sans coder, pour que vos signaux s’exécutent rapidement tandis que la liste blanche Products Permitted de votre compte les maintient sur les bons contrats.", it: "PickMyTrade instrada i suoi alert di TradingView verso Tradovate senza programmare, così i suoi segnali partono velocemente mentre la whitelist Products Permitted del suo conto li mantiene puntati sui contratti giusti." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Foire aux questions", it: "Domande frequenti" },
  faqs: { en: [], de: [], es: [], fr: [], it: [] },
  relatedHeading: { en: "Related Guides", de: "Verwandte Anleitungen", es: "Guías relacionadas", fr: "Guides associés", it: "Guide correlate" },
  disclosureText: { en: `This guide is for educational and informational purposes only and is not financial, investment, or trading advice. Trading futures and other leveraged products carries a substantial risk of loss and is not suitable for every investor. PickMyTrade is an independent third-party automation platform and is not affiliated with, endorsed by, or sponsored by Tradovate, Inc. "Tradovate" and all related names, logos, and trademarks are the property of their respective owners. Platform features and steps change over time, so always confirm the current process in the official Tradovate platform and documentation before acting.`, de: "Diese Anleitung dient ausschließlich Bildungs- und Informationszwecken und stellt keine Finanz-, Anlage- oder Handelsberatung dar. Der Handel mit Futures und anderen gehebelten Produkten birgt ein erhebliches Verlustrisiko und ist nicht für jeden Anleger geeignet. PickMyTrade ist eine unabhängige Automatisierungsplattform eines Drittanbieters und steht in keiner Verbindung zu Tradovate, Inc., wird von dieser weder unterstützt noch gesponsert. „Tradovate“ sowie alle zugehörigen Namen, Logos und Marken sind Eigentum ihrer jeweiligen Inhaber. Funktionen und Schritte der Plattform ändern sich im Laufe der Zeit. Bestätigen Sie daher stets den aktuellen Ablauf in der offiziellen Tradovate-Plattform und -Dokumentation, bevor Sie handeln.", es: "Esta guía tiene únicamente fines educativos e informativos y no constituye asesoramiento financiero, de inversión ni de trading. Operar con futuros y otros productos apalancados conlleva un riesgo sustancial de pérdida y no es adecuado para todos los inversores. PickMyTrade es una plataforma de automatización independiente de terceros y no está afiliada, respaldada ni patrocinada por Tradovate, Inc. “Tradovate” y todos los nombres, logotipos y marcas relacionados son propiedad de sus respectivos titulares. Las funciones y los pasos de la plataforma cambian con el tiempo, por lo que debe confirmar siempre el proceso actual en la plataforma y la documentación oficiales de Tradovate antes de actuar.", fr: "Ce guide est fourni à des fins éducatives et informatives uniquement et ne constitue pas un conseil financier, d’investissement ou de trading. Le trading de contrats à terme et d’autres produits à effet de levier comporte un risque de perte important et ne convient pas à tous les investisseurs. PickMyTrade est une plateforme d’automatisation tierce indépendante, non affiliée à Tradovate, Inc., ni approuvée ou parrainée par celle-ci. « Tradovate » ainsi que tous les noms, logos et marques associés sont la propriété de leurs détenteurs respectifs. Les fonctionnalités et les étapes de la plateforme évoluent avec le temps : vérifiez toujours la procédure actuelle sur la plateforme et dans la documentation officielles de Tradovate avant d’agir.", it: "Questa guida ha esclusivamente scopo educativo e informativo e non costituisce consulenza finanziaria, di investimento o di trading. Il trading di futures e di altri prodotti a leva comporta un rischio sostanziale di perdita e non è adatto a tutti gli investitori. PickMyTrade è una piattaforma di automazione indipendente di terze parti e non è affiliata, approvata né sponsorizzata da Tradovate, Inc. “Tradovate” e tutti i nomi, loghi e marchi correlati sono di proprietà dei rispettivi titolari. Le funzioni e i passaggi della piattaforma cambiano nel tempo, quindi confermi sempre la procedura attuale nella piattaforma e nella documentazione ufficiali di Tradovate prima di agire." },
