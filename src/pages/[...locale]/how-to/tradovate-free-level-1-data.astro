---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-free-level-1-data";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Free Level I CME & EUREX Data With Tradovate";
const META_DESCRIPTION =
  "Get free real-time Level I CME and EUREX futures quotes with a funded Tradovate account, learn what Level II depth costs, and confirm your feed is live.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Kostenlose Level-I-Daten von CME & EUREX mit Tradovate", es: "Datos Level I gratuitos de CME y EUREX con Tradovate", fr: "Données Level I gratuites CME et EUREX avec Tradovate", it: "Dati Level I CME ed EUREX gratuiti con Tradovate" },
  dek: { en: "You don't need a separate market-data bill to watch the futures you actually trade on Tradovate. Here's what free Level I data covers and how to confirm it's live.", de: "Sie brauchen keine separate Marktdaten-Rechnung, um die Futures zu beobachten, die Sie auf Tradovate tatsächlich handeln. Hier erfahren Sie, was die kostenlosen Level-I-Daten abdecken und wie Sie prüfen, ob sie live laufen.", es: "No necesita una factura aparte de datos de mercado para ver los futuros que realmente opera en Tradovate. Aquí le explicamos qué cubren los datos Level I gratuitos y cómo confirmar que están activos.", fr: "Vous n’avez pas besoin d’une facture de données de marché distincte pour suivre les contrats à terme que vous tradez réellement sur Tradovate. Voici ce que couvrent les données Level I gratuites et comment vérifier qu’elles sont actives.", it: "Non Le serve un abbonamento separato ai dati di mercato per seguire i futures che opera davvero su Tradovate. Ecco cosa coprono i dati Level I gratuiti e come verificare che siano attivi." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You don't need a separate market-data bill to watch the futures you actually trade on Tradovate. Every account plan bundles free, real-time <strong class='text-white'>Level I data for the CME Group exchanges and EUREX</strong>, as long as your account is live and funded. Here's what that covers, what it doesn't, and how to make sure it's running." },
    { type: "heading", text: "What Level I Data Actually Gives You" },
    { type: "paragraph", html: "Level I is <strong class='text-white'>top of book</strong>: the best bid, the best ask, the last traded price, and the traded volume. That's enough to drive your charts, fire price alerts, and show a real-time quote on every CME and EUREX contract you pull up. For most chart traders and anyone running automation, Level I is all the data you need." },
    { type: "paragraph", html: "What it doesn't include is <strong class='text-white'>market depth</strong>. The full SuperDOM ladder, the resting order sizes stacked at each price below the best bid and above the best ask, is Level II, and that's a separate paid feed. So Level I shows you the front of the queue; Level II shows you the whole line." },
    {
      type: "table",
      headers: ["Feed", "What you see", "Cost"],
      rows: [
        ["Level I (top of book)", "Best bid, best ask, last trade, volume, real-time", "Free on a funded live account (every plan)"],
        ["Level II (market depth)", "Full DOM ladder with resting size at each price", "Optional paid monthly add-on"],
      ],
    },
    { type: "heading", text: "The One Requirement: a Funded Live Account" },
    { type: "paragraph", html: "Free Level I applies to a <strong class='text-white'>live Tradovate brokerage account that's funded</strong>. On a simulation login or an unfunded account, quotes arrive roughly 10 minutes late and Tradovate paints the symbol name orange as a warning. You also sign the <strong class='text-white'>Non-Professional market-data agreement</strong> once, that self-certification is what flips the real-time feed on. Skip it and even a funded account stays delayed." },
    { type: "paragraph", html: "One caveat: the free Level I package and the discounted non-professional rates aren't available to professional traders. If you trade for a firm or otherwise meet the exchange's professional criteria, expect to pay professional Level II rates instead." },
    { type: "heading", text: "How to Confirm Your Free Level I Data Is Live" },
    {
      type: "steps",
      items: [
        { title: "Fund and Log Into Your Live Account", html: "The free feed keys off a funded, live brokerage account, so add funds if the account is empty, then log in with your live credentials, not a demo or simulation login. If you're only ever on a sim account, you'll stay on the delayed feed no matter what." },
        { title: "Sign the Non-Professional Market-Data Agreement", html: "Open <strong class='text-white'>Application Settings</strong> and head to the <strong class='text-white'>Market Data</strong> section. Complete the <strong class='text-white'>Non-Professional market-data agreement</strong> Tradovate lists there. Funded or not, the real-time Level I feed won't turn on until this is signed, so don't skip past it." },
        { title: "Check Your Entitlement and the Symbol Color", html: "Still in the Market Data settings, confirm your <strong class='text-white'>CME Group and EUREX Level I</strong> entitlement shows as active. Then glance at any chart or DOM: an <strong class='text-white'>orange symbol name</strong> means the feed is still delayed. A normal-colored symbol name means you're getting live prices." },
        { title: "Log Out, Back In, and Confirm Real-Time Quotes", html: "Once the agreement is signed and the entitlement is active, log out and log back in to refresh the connection. Open the same instrument and check that the symbol name is back to its normal color and quotes are moving in real time. Now you're safe to trade." },
      ],
    },
    { type: "heading", text: "What Level II Depth Costs, if You Want the Ladder" },
    { type: "paragraph", html: "Run the SuperDOM and need to see resting size at every price? That's Level II, an optional monthly add-on you buy per exchange or as a CME Group bundle. As of 2026, non-professional rates run a few dollars per exchange for Level I and roughly four times that for Level II. Those figures change, so check the current rate on the subscription screen before you buy. One quirk worth knowing: Level II is billed by <strong class='text-white'>calendar month</strong>, so buy it halfway through the month and it still expires on the last day, you re-subscribe on the 1st to keep the depth running." },
    { type: "heading", text: "Prop Firm and Evaluation Accounts" },
    { type: "paragraph", html: "On a prop-firm evaluation or funded account, you don't control the data feed, the firm that owns the account does. Level I may already be switched on for you, or the firm may require you to enable or pay for data on their side. Included data and rules vary by firm and account size, so check your firm's current market-data policy rather than subscribing through Tradovate yourself." },
    { type: "heading", text: "Automate Your Tradovate Trades" },
    { type: "paragraph", html: "With your Level I feed live, PickMyTrade turns your TradingView alerts into real Tradovate orders, every entry, stop, and target fires on its own, so you're not glued to the DOM waiting to click." },
  ], de: [
    { type: "paragraph",html: "Sie brauchen keine separate Marktdaten-Rechnung, um die Futures zu beobachten, die Sie auf Tradovate tatsächlich handeln. Jeder Kontotarif enthält kostenlose Echtzeit-<strong class='text-white'>Level-I-Daten für die Börsen der CME Group und die EUREX</strong>, solange Ihr Konto live und finanziert ist. Hier erfahren Sie, was das abdeckt, was nicht, und wie Sie sicherstellen, dass es läuft." },
    { type: "heading",text: "Was Level-I-Daten Ihnen tatsächlich liefern" },
    { type: "paragraph",html: "Level I ist die <strong class='text-white'>oberste Ebene des Orderbuchs</strong>: das beste Bid, das beste Ask, der zuletzt gehandelte Preis und das gehandelte Volumen. Das reicht aus, um Ihre Charts zu speisen, Preis-Alerts auszulösen und für jeden CME- und EUREX-Kontrakt, den Sie aufrufen, einen Echtzeitkurs anzuzeigen. Für die meisten Chart-Trader und alle, die Automatisierung nutzen, sind Level-I-Daten alles, was sie an Daten benötigen." },
    { type: "paragraph",html: "Was nicht enthalten ist, ist die <strong class='text-white'>Markttiefe</strong>. Die vollständige SuperDOM-Leiter, also die ruhenden Ordergrößen, die sich auf jedem Preis unterhalb des besten Bids und oberhalb des besten Asks stapeln, ist Level II, und das ist ein separater kostenpflichtiger Feed. Level I zeigt Ihnen also die Spitze der Warteschlange; Level II zeigt Ihnen die ganze Schlange." },
    { type: "table", headers: ["Feed","Was Sie sehen","Kosten"], rows: [
      ["Level I (oberste Ebene des Orderbuchs)","Bestes Bid, bestes Ask, letzter Kurs, Volumen, in Echtzeit","Kostenlos auf einem finanzierten Live-Konto (jeder Tarif)"],
      ["Level II (Markttiefe)","Vollständige DOM-Leiter mit ruhender Größe auf jedem Preis","Optionales kostenpflichtiges Monatsabo"],
    ] },
    { type: "heading",text: "Die eine Voraussetzung: ein finanziertes Live-Konto" },
    { type: "paragraph",html: "Kostenloses Level I gilt für ein <strong class='text-white'>echtes, finanziertes Tradovate-Brokerage-Konto</strong>. Bei einem Simulations-Login oder einem nicht finanzierten Konto kommen die Kurse etwa 10 Minuten verspätet an, und Tradovate färbt den Symbolnamen als Warnung orange. Außerdem unterzeichnen Sie einmalig die <strong class='text-white'>Marktdaten-Vereinbarung für Nicht-Profis</strong>; diese Selbstauskunft schaltet den Echtzeit-Feed frei. Überspringen Sie sie, bleibt selbst ein finanziertes Konto verzögert." },
    { type: "paragraph",html: "Ein Vorbehalt: Das kostenlose Level-I-Paket und die ermäßigten Nicht-Profi-Tarife stehen professionellen Tradern nicht zur Verfügung. Wenn Sie für ein Unternehmen handeln oder anderweitig die Profi-Kriterien der Börse erfüllen, müssen Sie stattdessen mit professionellen Level-II-Tarifen rechnen." },
    { type: "heading",text: "So bestätigen Sie, dass Ihre kostenlosen Level-I-Daten live sind" },
    {
      type: "steps",
      items: [
        { title: "Ihr Live-Konto finanzieren und sich anmelden", html: "Der kostenlose Feed hängt an einem finanzierten Live-Brokerage-Konto. Zahlen Sie also Geld ein, falls das Konto leer ist, und melden Sie sich dann mit Ihren Live-Zugangsdaten an, nicht mit einem Demo- oder Simulations-Login. Wenn Sie nur auf einem Sim-Konto unterwegs sind, bleiben Sie unabhängig von allem anderen beim verzögerten Feed." },
        { title: "Die Marktdaten-Vereinbarung für Nicht-Profis unterzeichnen", html: "Öffnen Sie <strong class='text-white'>Application Settings</strong> und gehen Sie zum Bereich <strong class='text-white'>Market Data</strong>. Schließen Sie dort die von Tradovate aufgeführte <strong class='text-white'>Non-Professional market-data agreement</strong> ab. Ob finanziert oder nicht: Der Echtzeit-Level-I-Feed schaltet sich erst ein, wenn diese Vereinbarung unterzeichnet ist, überspringen Sie sie also nicht." },
        { title: "Berechtigung und Symbolfarbe prüfen", html: "Bestätigen Sie weiterhin in den Market-Data-Einstellungen, dass Ihre <strong class='text-white'>CME Group and EUREX Level I</strong>-Berechtigung als aktiv angezeigt wird. Werfen Sie dann einen Blick auf ein beliebiges Chart oder DOM: Ein <strong class='text-white'>oranger Symbolname</strong> bedeutet, dass der Feed weiterhin verzögert ist. Ein normal gefärbter Symbolname bedeutet, dass Sie Live-Kurse erhalten." },
        { title: "Ab- und wieder anmelden und Echtzeitkurse bestätigen", html: "Sobald die Vereinbarung unterzeichnet und die Berechtigung aktiv ist, melden Sie sich ab und wieder an, um die Verbindung zu aktualisieren. Öffnen Sie dasselbe Instrument und prüfen Sie, ob der Symbolname wieder seine normale Farbe hat und die Kurse in Echtzeit laufen. Jetzt können Sie sicher handeln." },
      ],
    },
    { type: "heading",text: "Was die Level-II-Tiefe kostet, wenn Sie die Leiter möchten" },
    { type: "paragraph",html: "Sie arbeiten mit dem SuperDOM und müssen die ruhende Größe auf jedem Preis sehen? Das ist Level II, ein optionales Monatsabo, das Sie pro Börse oder als CME-Group-Paket buchen. Stand 2026 liegen die Nicht-Profi-Tarife bei einigen wenigen Dollar pro Börse für Level I und bei etwa dem Vierfachen für Level II. Diese Zahlen ändern sich, prüfen Sie also den aktuellen Tarif auf dem Abo-Bildschirm, bevor Sie buchen. Eine Eigenheit, die Sie kennen sollten: Level II wird nach <strong class='text-white'>Kalendermonat</strong> abgerechnet. Buchen Sie es mitten im Monat, läuft es dennoch am letzten Tag ab, und Sie müssen am 1. erneut abonnieren, damit die Markttiefe weiterläuft." },
    { type: "heading",text: "Prop-Firm- und Evaluierungskonten" },
    { type: "paragraph",html: "Bei einem Evaluierungs- oder finanzierten Konto einer Prop Firm kontrollieren nicht Sie den Datenfeed, sondern die Firma, der das Konto gehört. Level I ist möglicherweise bereits für Sie aktiviert, oder die Firma verlangt, dass Sie die Daten auf ihrer Seite aktivieren oder bezahlen. Enthaltene Daten und Regeln variieren je nach Firma und Kontogröße. Prüfen Sie daher die aktuellen Marktdaten-Richtlinien Ihrer Firma, statt selbst über Tradovate zu abonnieren." },
    { type: "heading",text: "Automatisieren Sie Ihre Tradovate-Trades" },
    { type: "paragraph",html: "Wenn Ihr Level-I-Feed live läuft, verwandelt PickMyTrade Ihre TradingView-Alerts in echte Tradovate-Orders: Jeder Einstieg, Stop und jedes Ziel wird von selbst ausgelöst, sodass Sie nicht am DOM kleben und aufs Klicken warten müssen." },
  ], es: [
    { type: "paragraph",html: "No necesita una factura aparte de datos de mercado para ver los futuros que realmente opera en Tradovate. Todos los planes de cuenta incluyen <strong class='text-white'>datos Level I en tiempo real de los mercados de CME Group y EUREX</strong> sin costo, siempre que su cuenta sea real y esté fondeada. Aquí le explicamos qué cubre, qué no cubre y cómo asegurarse de que esté funcionando." },
    { type: "heading",text: "Qué le ofrecen realmente los datos Level I" },
    { type: "paragraph",html: "Level I es el <strong class='text-white'>tope del libro</strong>: el mejor bid, el mejor ask, el último precio negociado y el volumen negociado. Eso basta para alimentar sus gráficos, disparar alertas de precio y mostrar una cotización en tiempo real de cada contrato de CME y EUREX que abra. Para la mayoría de los traders que operan con gráficos y para quien utiliza automatización, Level I son todos los datos que necesita." },
    { type: "paragraph",html: "Lo que no incluye es la <strong class='text-white'>profundidad de mercado</strong>. La escalera completa del SuperDOM, es decir, los tamaños de órdenes pendientes apilados en cada precio por debajo del mejor bid y por encima del mejor ask, es Level II, y es un feed aparte de pago. Así, Level I le muestra el frente de la cola; Level II le muestra toda la fila." },
    { type: "table", headers: ["Feed","Qué ve","Costo"], rows: [
      ["Level I (tope del libro)","Mejor bid, mejor ask, último precio, volumen, en tiempo real","Gratis en una cuenta real fondeada (todos los planes)"],
      ["Level II (profundidad de mercado)","Escalera completa del DOM con tamaño pendiente en cada precio","Complemento mensual opcional de pago"],
    ] },
    { type: "heading",text: "El único requisito: una cuenta real fondeada" },
    { type: "paragraph",html: "El Level I gratuito se aplica a una <strong class='text-white'>cuenta de corretaje real de Tradovate que esté fondeada</strong>. En un inicio de sesión de simulación o en una cuenta sin fondos, las cotizaciones llegan con unos 10 minutos de retraso y Tradovate pinta el nombre del símbolo en naranja como advertencia. Además, debe firmar una sola vez el <strong class='text-white'>acuerdo de datos de mercado para no profesionales</strong>; esa autocertificación es lo que activa el feed en tiempo real. Si la omite, incluso una cuenta fondeada seguirá con retraso." },
    { type: "paragraph",html: "Una salvedad: el paquete Level I gratuito y las tarifas reducidas para no profesionales no están disponibles para traders profesionales. Si opera para una empresa o cumple de otro modo los criterios profesionales de la bolsa, espere pagar tarifas profesionales de Level II." },
    { type: "heading",text: "Cómo confirmar que sus datos Level I gratuitos están activos" },
    {
      type: "steps",
      items: [
        { title: "Fondee e inicie sesión en su cuenta real", html: "El feed gratuito depende de una cuenta de corretaje real y fondeada, así que añada fondos si la cuenta está vacía y luego inicie sesión con sus credenciales reales, no con un acceso demo o de simulación. Si solo utiliza una cuenta de simulación, seguirá con el feed con retraso hagan lo que hagan." },
        { title: "Firme el acuerdo de datos de mercado para no profesionales", html: "Abra <strong class='text-white'>Application Settings</strong> y vaya a la sección <strong class='text-white'>Market Data</strong>. Complete la <strong class='text-white'>Non-Professional market-data agreement</strong> que Tradovate muestra allí. Con fondos o sin ellos, el feed Level I en tiempo real no se activará hasta que firme, así que no lo pase por alto." },
        { title: "Compruebe su autorización y el color del símbolo", html: "Todavía en la configuración de Market Data, confirme que su autorización <strong class='text-white'>CME Group and EUREX Level I</strong> aparece como activa. Luego mire cualquier gráfico o DOM: un <strong class='text-white'>nombre de símbolo en naranja</strong> significa que el feed sigue con retraso. Un nombre de símbolo con el color normal significa que recibe precios en vivo." },
        { title: "Cierre sesión, vuelva a entrar y confirme las cotizaciones en tiempo real", html: "Una vez firmado el acuerdo y activa la autorización, cierre sesión y vuelva a iniciarla para refrescar la conexión. Abra el mismo instrumento y compruebe que el nombre del símbolo ha vuelto a su color normal y que las cotizaciones se mueven en tiempo real. Ya puede operar con seguridad." },
      ],
    },
    { type: "heading",text: "Cuánto cuesta la profundidad Level II si quiere la escalera" },
    { type: "paragraph",html: "¿Usa el SuperDOM y necesita ver el tamaño pendiente en cada precio? Eso es Level II, un complemento mensual opcional que se compra por bolsa o como paquete de CME Group. En 2026, las tarifas para no profesionales rondan unos pocos dólares por bolsa para Level I y aproximadamente cuatro veces eso para Level II. Estas cifras cambian, así que consulte la tarifa vigente en la pantalla de suscripción antes de comprar. Una peculiaridad que conviene conocer: Level II se factura por <strong class='text-white'>mes calendario</strong>, de modo que si lo compra a mitad de mes caduca igualmente el último día, y debe volver a suscribirse el día 1 para mantener la profundidad activa." },
    { type: "heading",text: "Cuentas de prop firm y de evaluación" },
    { type: "paragraph",html: "En una cuenta de evaluación o fondeada de una prop firm, usted no controla el feed de datos, lo controla la firma propietaria de la cuenta. Puede que Level I ya esté activado para usted, o que la firma le exija activar o pagar los datos por su lado. Los datos incluidos y las reglas varían según la firma y el tamaño de la cuenta, así que consulte la política vigente de datos de mercado de su firma en lugar de suscribirse usted mismo a través de Tradovate." },
    { type: "heading",text: "Automatice sus operaciones en Tradovate" },
    { type: "paragraph",html: "Con su feed Level I activo, PickMyTrade convierte sus alertas de TradingView en órdenes reales de Tradovate: cada entrada, stop y objetivo se ejecuta por sí solo, para que no tenga que estar pegado al DOM esperando para hacer clic." },
  ], fr: [
    { type: "paragraph",html: "Vous n’avez pas besoin d’une facture de données de marché distincte pour suivre les contrats à terme que vous tradez réellement sur Tradovate. Chaque formule de compte inclut gratuitement des <strong class='text-white'>données Level I en temps réel pour les bourses du CME Group et pour EUREX</strong>, tant que votre compte est réel et approvisionné. Voici ce que cela couvre, ce que cela ne couvre pas et comment vous assurer que tout fonctionne." },
    { type: "heading",text: "Ce que les données Level I vous apportent réellement" },
    { type: "paragraph",html: "Le Level I correspond au <strong class='text-white'>haut du carnet</strong> : le meilleur bid, le meilleur ask, le dernier prix échangé et le volume échangé. C’est suffisant pour alimenter vos graphiques, déclencher des alertes de prix et afficher une cotation en temps réel sur chaque contrat CME et EUREX que vous ouvrez. Pour la plupart des traders sur graphiques et pour quiconque utilise l’automatisation, le Level I représente toutes les données dont vous avez besoin." },
    { type: "paragraph",html: "Ce qu’il n’inclut pas, c’est la <strong class='text-white'>profondeur de marché</strong>. L’échelle complète du SuperDOM, c’est-à-dire les tailles d’ordres en attente empilées à chaque prix sous le meilleur bid et au-dessus du meilleur ask, relève du Level II, et il s’agit d’un flux payant distinct. Le Level I vous montre donc la tête de la file ; le Level II vous montre toute la file." },
    { type: "table", headers: ["Flux","Ce que vous voyez","Coût"], rows: [
      ["Level I (haut du carnet)","Meilleur bid, meilleur ask, dernier prix, volume, en temps réel","Gratuit sur un compte réel approvisionné (toutes les formules)"],
      ["Level II (profondeur de marché)","Échelle DOM complète avec la taille en attente à chaque prix","Option mensuelle payante facultative"],
    ] },
    { type: "heading",text: "La seule condition : un compte réel approvisionné" },
    { type: "paragraph",html: "Le Level I gratuit s’applique à un <strong class='text-white'>compte de courtage Tradovate réel et approvisionné</strong>. Sur une connexion de simulation ou un compte non approvisionné, les cotations arrivent avec environ 10 minutes de retard et Tradovate affiche le nom du symbole en orange en guise d’avertissement. Vous signez aussi une seule fois l’<strong class='text-white'>accord de données de marché pour non-professionnels</strong> ; cette auto-certification est ce qui active le flux en temps réel. Si vous l’ignorez, même un compte approvisionné reste en différé." },
    { type: "paragraph",html: "Une réserve : le forfait Level I gratuit et les tarifs réduits pour non-professionnels ne sont pas disponibles pour les traders professionnels. Si vous tradez pour une entreprise ou répondez par ailleurs aux critères professionnels de la bourse, attendez-vous à payer les tarifs professionnels du Level II." },
    { type: "heading",text: "Comment vérifier que vos données Level I gratuites sont actives" },
    {
      type: "steps",
      items: [
        { title: "Approvisionner et connecter votre compte réel", html: "Le flux gratuit dépend d’un compte de courtage réel et approvisionné : alimentez donc le compte s’il est vide, puis connectez-vous avec vos identifiants réels, et non avec une connexion de démo ou de simulation. Si vous n’êtes jamais que sur un compte de simulation, vous resterez sur le flux différé quoi que vous fassiez." },
        { title: "Signer l’accord de données de marché pour non-professionnels", html: "Ouvrez <strong class='text-white'>Application Settings</strong> et rendez-vous dans la section <strong class='text-white'>Market Data</strong>. Complétez la <strong class='text-white'>Non-Professional market-data agreement</strong> que Tradovate y répertorie. Approvisionné ou non, le flux Level I en temps réel ne s’active pas tant que cet accord n’est pas signé : ne passez donc pas à côté." },
        { title: "Vérifier votre autorisation et la couleur du symbole", html: "Toujours dans les paramètres Market Data, vérifiez que votre autorisation <strong class='text-white'>CME Group and EUREX Level I</strong> apparaît comme active. Jetez ensuite un œil à un graphique ou à un DOM : un <strong class='text-white'>nom de symbole orange</strong> signifie que le flux est toujours différé. Un nom de symbole de couleur normale signifie que vous recevez les prix en direct." },
        { title: "Se déconnecter, se reconnecter et confirmer les cotations en temps réel", html: "Une fois l’accord signé et l’autorisation active, déconnectez-vous puis reconnectez-vous pour actualiser la connexion. Ouvrez le même instrument et vérifiez que le nom du symbole a retrouvé sa couleur normale et que les cotations évoluent en temps réel. Vous pouvez maintenant trader en toute sécurité." },
      ],
    },
    { type: "heading",text: "Combien coûte la profondeur Level II si vous voulez l’échelle" },
    { type: "paragraph",html: "Vous utilisez le SuperDOM et devez voir la taille en attente à chaque prix ? C’est le Level II, une option mensuelle facultative que vous achetez par bourse ou sous forme de forfait CME Group. En 2026, les tarifs non professionnels s’élèvent à quelques dollars par bourse pour le Level I et à environ quatre fois plus pour le Level II. Ces chiffres évoluent, vérifiez donc le tarif en vigueur sur l’écran d’abonnement avant d’acheter. Une particularité à connaître : le Level II est facturé au <strong class='text-white'>mois civil</strong> ; si vous l’achetez en milieu de mois, il expire quand même le dernier jour et vous devez vous réabonner le 1er pour conserver la profondeur." },
    { type: "heading",text: "Comptes de prop firm et d’évaluation" },
    { type: "paragraph",html: "Sur un compte d’évaluation ou approvisionné d’une prop firm, vous ne contrôlez pas le flux de données ; c’est la société propriétaire du compte qui le fait. Le Level I peut déjà être activé pour vous, ou la société peut exiger que vous activiez ou payiez les données de son côté. Les données incluses et les règles varient selon la société et la taille du compte ; consultez donc la politique de données de marché en vigueur de votre société plutôt que de vous abonner vous-même via Tradovate." },
    { type: "heading",text: "Automatisez vos trades Tradovate" },
    { type: "paragraph",html: "Avec votre flux Level I actif, PickMyTrade transforme vos alertes TradingView en véritables ordres Tradovate : chaque entrée, chaque stop et chaque objectif se déclenche tout seul, pour que vous n’ayez plus à rester rivé au DOM en attendant de cliquer." },
  ], it: [
    { type: "paragraph",html: "Non Le serve un abbonamento separato ai dati di mercato per seguire i futures che opera davvero su Tradovate. Ogni piano di conto include gratuitamente <strong class='text-white'>dati Level I in tempo reale per le borse del CME Group e per EUREX</strong>, purché il Suo conto sia reale e finanziato. Ecco cosa copre, cosa non copre e come assicurarsi che sia attivo." },
    { type: "heading",text: "Cosa Le offrono davvero i dati Level I" },
    { type: "paragraph",html: "Il Level I è il <strong class='text-white'>top of book</strong>: il miglior bid, il miglior ask, l’ultimo prezzo scambiato e il volume scambiato. È sufficiente per alimentare i Suoi grafici, far scattare alert di prezzo e mostrare una quotazione in tempo reale su ogni contratto CME ed EUREX che apre. Per la maggior parte dei trader da grafico e per chi usa l’automazione, il Level I è tutto il dato di cui ha bisogno." },
    { type: "paragraph",html: "Ciò che non include è la <strong class='text-white'>profondità di mercato</strong>. La scala completa del SuperDOM, cioè le dimensioni degli ordini in attesa impilate a ogni prezzo sotto il miglior bid e sopra il miglior ask, è Level II, ed è un feed separato a pagamento. Il Level I Le mostra quindi la testa della coda; il Level II Le mostra tutta la fila." },
    { type: "table", headers: ["Feed","Cosa vede","Costo"], rows: [
      ["Level I (top of book)","Miglior bid, miglior ask, ultimo prezzo, volume, in tempo reale","Gratis su un conto reale finanziato (ogni piano)"],
      ["Level II (profondità di mercato)","Scala DOM completa con la dimensione in attesa a ogni prezzo","Componente aggiuntivo mensile opzionale a pagamento"],
    ] },
    { type: "heading",text: "L’unico requisito: un conto reale finanziato" },
    { type: "paragraph",html: "Il Level I gratuito si applica a un <strong class='text-white'>conto di brokerage Tradovate reale e finanziato</strong>. Con un login di simulazione o un conto non finanziato, le quotazioni arrivano con circa 10 minuti di ritardo e Tradovate colora di arancione il nome del simbolo come avviso. Deve inoltre firmare una sola volta l’<strong class='text-white'>accordo sui dati di mercato per non professionisti</strong>: è questa autocertificazione ad attivare il feed in tempo reale. Se la salta, anche un conto finanziato resta in ritardo." },
    { type: "paragraph",html: "Un’avvertenza: il pacchetto Level I gratuito e le tariffe scontate per non professionisti non sono disponibili per i trader professionisti. Se opera per conto di un’azienda o soddisfa altrimenti i criteri professionali della borsa, si aspetti di pagare le tariffe professionali del Level II." },
    { type: "heading",text: "Come verificare che i Suoi dati Level I gratuiti siano attivi" },
    {
      type: "steps",
      items: [
        { title: "Finanziare ed accedere al conto reale", html: "Il feed gratuito dipende da un conto di brokerage reale e finanziato: aggiunga quindi fondi se il conto è vuoto, poi acceda con le Sue credenziali reali, non con un login demo o di simulazione. Se usa solo un conto sim, resterà sul feed ritardato qualunque cosa faccia." },
        { title: "Firmare l’accordo sui dati di mercato per non professionisti", html: "Apra <strong class='text-white'>Application Settings</strong> e vada alla sezione <strong class='text-white'>Market Data</strong>. Completi la <strong class='text-white'>Non-Professional market-data agreement</strong> che Tradovate elenca lì. Finanziato o meno, il feed Level I in tempo reale non si attiva finché l’accordo non è firmato, quindi non lo salti." },
        { title: "Controllare l’abilitazione e il colore del simbolo", html: "Sempre nelle impostazioni Market Data, verifichi che la Sua abilitazione <strong class='text-white'>CME Group and EUREX Level I</strong> risulti attiva. Poi dia un’occhiata a un grafico o a un DOM qualsiasi: un <strong class='text-white'>nome di simbolo arancione</strong> significa che il feed è ancora ritardato. Un nome di simbolo di colore normale significa che riceve prezzi in tempo reale." },
        { title: "Uscire, rientrare e confermare le quotazioni in tempo reale", html: "Una volta firmato l’accordo e attivata l’abilitazione, esca e rientri per aggiornare la connessione. Apra lo stesso strumento e verifichi che il nome del simbolo sia tornato al colore normale e che le quotazioni si muovano in tempo reale. Ora può operare in sicurezza." },
      ],
    },
    { type: "heading",text: "Quanto costa la profondità Level II se desidera la scala" },
    { type: "paragraph",html: "Usa il SuperDOM e ha bisogno di vedere la dimensione in attesa a ogni prezzo? Quello è il Level II, un componente aggiuntivo mensile opzionale che si acquista per borsa o come pacchetto CME Group. Nel 2026 le tariffe per non professionisti ammontano a pochi dollari per borsa per il Level I e a circa il quadruplo per il Level II. Queste cifre cambiano, perciò controlli la tariffa attuale nella schermata di abbonamento prima di acquistare. Una particolarità da conoscere: il Level II viene fatturato per <strong class='text-white'>mese di calendario</strong>, quindi se lo acquista a metà mese scade comunque l’ultimo giorno, e deve riabbonarsi il 1° per mantenere attiva la profondità." },
    { type: "heading",text: "Conti prop firm e di valutazione" },
    { type: "paragraph",html: "Su un conto di valutazione o finanziato di una prop firm, non è Lei a controllare il feed di dati, ma la società proprietaria del conto. Il Level I potrebbe essere già attivo per Lei, oppure la società potrebbe richiederLe di attivare o pagare i dati dalla sua parte. I dati inclusi e le regole variano in base alla società e alla dimensione del conto, quindi verifichi la politica attuale sui dati di mercato della Sua società invece di abbonarsi da solo tramite Tradovate." },
    { type: "heading",text: "Automatizzi i Suoi trade su Tradovate" },
    { type: "paragraph",html: "Con il Suo feed Level I attivo, PickMyTrade trasforma i Suoi alert di TradingView in veri ordini Tradovate: ogni ingresso, stop e target scatta da solo, così non deve restare incollato al DOM ad aspettare di cliccare." },
  ] },
  ctaHeading: { en: "Stop Waiting to Click", de: "Schluss mit dem Warten aufs Klicken", es: "Deje de esperar para hacer clic", fr: "Cessez d’attendre pour cliquer", it: "Smetta di aspettare per cliccare" },
  ctaText: { en: "PickMyTrade turns your TradingView alerts into real Tradovate orders, every entry, stop, and target fires on its own.", de: "PickMyTrade verwandelt Ihre TradingView-Alerts in echte Tradovate-Orders: Jeder Einstieg, Stop und jedes Ziel wird von selbst ausgelöst.", es: "PickMyTrade convierte sus alertas de TradingView en órdenes reales de Tradovate: cada entrada, stop y objetivo se ejecuta por sí solo.", fr: "PickMyTrade transforme vos alertes TradingView en véritables ordres Tradovate : chaque entrée, chaque stop et chaque objectif se déclenche tout seul.", it: "PickMyTrade trasforma i Suoi alert di TradingView in veri ordini Tradovate: ogni ingresso, stop e target scatta da solo." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Is Level I data really free on Tradovate?", a: "Yes. Every account plan includes free real-time Level I CME Group and EUREX data, provided you're on a live, funded brokerage account and have signed the Non-Professional market-data agreement." },
    { q: "Do I need Level II to trade?", a: "No. Level I gives you the best bid, best ask, last trade, and volume, which is enough to trade from charts or place orders. Level II only adds full market depth on the DOM ladder, and it's a paid extra." },
    { q: "Why are my quotes delayed if Level I is free?", a: "Delayed quotes and an orange symbol name usually mean you're on a simulation login, the account isn't funded, or the market-data agreement hasn't been signed yet. Sign the agreement on a funded live account, then log out and back in." },
  ], de: [
    { q: "Sind Level-I-Daten bei Tradovate wirklich kostenlos?", a: "Ja. Jeder Kontotarif enthält kostenlose Echtzeit-Level-I-Daten der CME Group und der EUREX, sofern Sie ein echtes, finanziertes Brokerage-Konto nutzen und die Marktdaten-Vereinbarung für Nicht-Profis unterzeichnet haben." },
    { q: "Brauche ich Level II zum Handeln?", a: "Nein. Level I liefert Ihnen das beste Bid, das beste Ask, den letzten Kurs und das Volumen, was zum Handeln über Charts oder zum Platzieren von Orders ausreicht. Level II ergänzt lediglich die volle Markttiefe auf der DOM-Leiter und ist ein kostenpflichtiges Extra." },
    { q: "Warum sind meine Kurse verzögert, obwohl Level I kostenlos ist?", a: "Verzögerte Kurse und ein oranger Symbolname bedeuten meist, dass Sie mit einem Simulations-Login angemeldet sind, das Konto nicht finanziert ist oder die Marktdaten-Vereinbarung noch nicht unterzeichnet wurde. Unterzeichnen Sie die Vereinbarung auf einem finanzierten Live-Konto und melden Sie sich dann ab und wieder an." },
  ], es: [
    { q: "¿Los datos Level I son realmente gratuitos en Tradovate?", a: "Sí. Todos los planes de cuenta incluyen datos Level I en tiempo real de CME Group y EUREX sin costo, siempre que tenga una cuenta de corretaje real y fondeada y haya firmado el acuerdo de datos de mercado para no profesionales." },
    { q: "¿Necesito Level II para operar?", a: "No. Level I le ofrece el mejor bid, el mejor ask, el último precio y el volumen, lo cual basta para operar desde los gráficos o colocar órdenes. Level II solo añade la profundidad de mercado completa en la escalera del DOM y es un extra de pago." },
    { q: "¿Por qué mis cotizaciones tienen retraso si Level I es gratuito?", a: "Las cotizaciones con retraso y un nombre de símbolo en naranja suelen significar que está en un inicio de sesión de simulación, que la cuenta no está fondeada o que aún no ha firmado el acuerdo de datos de mercado. Firme el acuerdo en una cuenta real fondeada y luego cierre sesión y vuelva a iniciarla." },
  ], fr: [
    { q: "Les données Level I sont-elles vraiment gratuites sur Tradovate ?", a: "Oui. Chaque formule de compte inclut gratuitement les données Level I en temps réel du CME Group et d’EUREX, à condition de disposer d’un compte de courtage réel et approvisionné et d’avoir signé l’accord de données de marché pour non-professionnels." },
    { q: "Ai-je besoin du Level II pour trader ?", a: "Non. Le Level I vous donne le meilleur bid, le meilleur ask, le dernier prix et le volume, ce qui suffit pour trader depuis les graphiques ou passer des ordres. Le Level II ajoute seulement la profondeur de marché complète sur l’échelle du DOM, et c’est un supplément payant." },
    { q: "Pourquoi mes cotations sont-elles différées alors que le Level I est gratuit ?", a: "Des cotations différées et un nom de symbole orange signifient généralement que vous êtes sur une connexion de simulation, que le compte n’est pas approvisionné ou que l’accord de données de marché n’a pas encore été signé. Signez l’accord sur un compte réel approvisionné, puis déconnectez-vous et reconnectez-vous." },
  ], it: [
    { q: "I dati Level I sono davvero gratuiti su Tradovate?", a: "Sì. Ogni piano di conto include gratuitamente i dati Level I in tempo reale di CME Group ed EUREX, purché Lei abbia un conto di brokerage reale e finanziato e abbia firmato l’accordo sui dati di mercato per non professionisti." },
    { q: "Mi serve il Level II per operare?", a: "No. Il Level I Le fornisce il miglior bid, il miglior ask, l’ultimo prezzo e il volume, abbastanza per operare dai grafici o inserire ordini. Il Level II aggiunge solo la profondità di mercato completa sulla scala del DOM ed è un extra a pagamento." },
    { q: "Perché le mie quotazioni sono ritardate se il Level I è gratuito?", a: "Quotazioni ritardate e un nome di simbolo arancione di solito significano che sta usando un login di simulazione, che il conto non è finanziato o che l’accordo sui dati di mercato non è ancora stato firmato. Firmi l’accordo su un conto reale finanziato, poi esca e rientri." },
  ] },
  relatedHeading: { en: "Related Guides", de: "Ähnliche Anleitungen", es: "Guías relacionadas", fr: "Guides associés", it: "Guide correlate" },
  disclosureText: { en: `This guide is for educational and informational purposes only and is not financial, investment, or trading advice. Trading futures and other leveraged products carries a substantial risk of loss and is not suitable for every investor. PickMyTrade is an independent third-party automation platform and is not affiliated with, endorsed by, or sponsored by Tradovate, Inc. "Tradovate" and all related names, logos, and trademarks are the property of their respective owners. Platform features and steps change over time, so always confirm the current process in the official Tradovate platform and documentation before acting.`, de: "Dieser Leitfaden dient ausschließlich Bildungs- und Informationszwecken und stellt keine Finanz-, Anlage- oder Handelsberatung dar. Der Handel mit Futures und anderen gehebelten Produkten birgt ein erhebliches Verlustrisiko und ist nicht für jeden Anleger geeignet. PickMyTrade ist eine unabhängige Automatisierungsplattform eines Drittanbieters und steht in keiner Verbindung zu Tradovate, Inc., wird von dieser weder unterstützt noch gesponsert. „Tradovate“ sowie alle zugehörigen Namen, Logos und Marken sind Eigentum ihrer jeweiligen Inhaber. Funktionen und Schritte der Plattform ändern sich im Laufe der Zeit, daher sollten Sie den aktuellen Ablauf stets in der offiziellen Tradovate-Plattform und -Dokumentation überprüfen, bevor Sie handeln.", es: "Esta guía tiene fines exclusivamente educativos e informativos y no constituye asesoramiento financiero, de inversión ni de trading. Operar con futuros y otros productos apalancados conlleva un riesgo sustancial de pérdida y no es adecuado para todos los inversores. PickMyTrade es una plataforma de automatización independiente de terceros y no está afiliada, respaldada ni patrocinada por Tradovate, Inc. «Tradovate» y todos los nombres, logotipos y marcas relacionados son propiedad de sus respectivos titulares. Las funciones y los pasos de la plataforma cambian con el tiempo, por lo que debe confirmar siempre el proceso actual en la plataforma y la documentación oficiales de Tradovate antes de actuar.", fr: "Ce guide est fourni à des fins éducatives et informatives uniquement et ne constitue pas un conseil financier, d’investissement ou de trading. Le trading de contrats à terme et d’autres produits à effet de levier comporte un risque de perte important et ne convient pas à tous les investisseurs. PickMyTrade est une plateforme d’automatisation tierce indépendante et n’est ni affiliée à Tradovate, Inc., ni approuvée ou parrainée par cette dernière. « Tradovate » ainsi que tous les noms, logos et marques associés sont la propriété de leurs détenteurs respectifs. Les fonctionnalités et les étapes de la plateforme évoluent avec le temps ; vérifiez donc toujours la procédure en vigueur sur la plateforme et dans la documentation officielles de Tradovate avant d’agir.", it: "Questa guida ha esclusivamente scopo educativo e informativo e non costituisce consulenza finanziaria, di investimento o di trading. Il trading di futures e di altri prodotti a leva comporta un rischio sostanziale di perdita e non è adatto a tutti gli investitori. PickMyTrade è una piattaforma di automazione indipendente di terze parti e non è affiliata, approvata o sponsorizzata da Tradovate, Inc. «Tradovate» e tutti i nomi, loghi e marchi correlati sono di proprietà dei rispettivi titolari. Le funzionalità e i passaggi della piattaforma cambiano nel tempo, perciò confermi sempre la procedura attuale nella piattaforma e nella documentazione ufficiali di Tradovate prima di agire." },
