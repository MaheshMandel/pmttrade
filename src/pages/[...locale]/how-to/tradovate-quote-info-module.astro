---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-quote-info-module";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Build Watchlists With the Tradovate Quote Module";
const META_DESCRIPTION =
  "Build a synced Tradovate watchlist: add symbols to the quote module, customize columns, and trade or set alerts straight from the board.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Watchlists mit dem Tradovate-Quote-Modul erstellen", es: "Cree listas de seguimiento con el módulo de cotizaciones de Tradovate", fr: "Créer des listes de suivi avec le module de cotations Tradovate", it: "Creare watchlist con il modulo quotazioni di Tradovate" },
  dek: { en: "Flipping between charts to check where every market is trading gets old fast. Here's how to build a quote watchlist in Tradovate that follows you from web to desktop to mobile.", de: "Ständig zwischen Charts zu wechseln, um zu sehen, wo jeder Markt steht, nervt schnell. So erstellen Sie in Tradovate eine Quote-Watchlist, die Sie von Web über Desktop bis Mobile begleitet.", es: "Saltar entre gráficos para ver dónde cotiza cada mercado cansa rápido. Así se crea en Tradovate una lista de cotizaciones que le acompaña de la web al escritorio y al móvil.", fr: "Passer d'un graphique à l'autre pour voir où cote chaque marché devient vite lassant. Voici comment créer dans Tradovate une liste de cotations qui vous suit du web au bureau puis au mobile.", it: "Passare da un grafico all'altro per controllare dove quota ogni mercato stanca presto. Ecco come creare in Tradovate una watchlist di quotazioni che La segue dal web al desktop al mobile." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Flipping between charts to check where every market is trading gets old fast. A quote watchlist fixes that: one grid, all your contracts, live prices side by side, with order buttons and alerts built right in. Here's how to build one in Tradovate's quote module, tune it to show exactly what you care about, and have it follow you from web to desktop to mobile." },
    { type: "heading", text: "What Is the Tradovate Quote Module?" },
    { type: "paragraph", html: "The quote module is Tradovate's watchlist grid. Each row is a contract you're tracking, and each column is a piece of live market data, bid, ask, last, net change, volume, and more. It's also a launch pad: you can trade a market, set a price alert, or pull up detailed quote info like margins, trading hours, and contract specs without leaving the board. Depending on your platform version the module shows up as <strong class='text-white'>Quote Board</strong>, <strong class='text-white'>Quote Info</strong>, or <strong class='text-white'>Market Analyzer</strong>, the name has shifted over time, but the workflow below is the same." },
    { type: "heading", text: "Build a Quote Watchlist: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open the Quote Module", html: "Log in to the Tradovate Web Trader and open the Add Module menu, the <strong class='text-white'>New +</strong> button, usually top-left. Pick the quote board from the list and drag it onto your workspace. A new board opens empty, so don't be thrown by the blank grid; that's your starting point." },
        { title: "Add Your Symbols", html: "Click the search box at the top of the board and start typing a contract, ES, NQ, CL, GC, whatever you follow. Tradovate autocompletes as you type, matching on symbol, contract name, and exchange, so you can grab the exact front-month contract instead of guessing at it. Pick it from the list and it drops in as a new row. Repeat for every market you want on the board. To drop one, highlight its row and press <strong class='text-white'>Delete</strong>." },
        { title: "Customize Your Columns", html: "Out of the box you get the basics, bid, ask, last, net change, volume. To change what's shown, open the board's column settings (the gear / View Settings icon) and choose <strong class='text-white'>Select Columns</strong>. Drag the fields you want from Available into Visible; their top-to-bottom order in that list sets the left-to-right order on your grid. The <strong class='text-white'>Trend</strong> column is worth adding, it flags short-term price movement at a glance. To reorder your markets, drag the handle on the left edge of any row." },
        { title: "Trade and Set Alerts From the Board", html: "You don't need a separate order ticket to act on what you're watching. Add the <strong class='text-white'>Buy/Sell</strong> column and every row gets its own order buttons, set your quantity, click, and the order routes straight to your account. You can also set a price alert on any symbol right from the board, so you get pinged when a level prints instead of babysitting the screen." },
        { title: "Name, Save, and Sync Your Watchlist", html: "Give the list a name and you can keep more than one, say a board of index futures and another of energies, then switch between them in a click. Because Tradovate is cloud-based, your saved quote lists come with you: the same watchlist loads when you sign in on the desktop app or the mobile app, no rebuilding from scratch." },
      ],
    },
    { type: "heading", text: "Why You'd Need This" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>See your whole market at a glance</strong>, every contract you trade, live, on one screen.",
        "<strong class='text-white'>Act faster</strong>, one-click Buy/Sell from the row beats hunting for an order ticket.",
        "<strong class='text-white'>Never miss a level</strong>, alerts fire straight off the board while you focus elsewhere.",
        "<strong class='text-white'>Set it up once</strong>, your watchlist syncs across web, desktop, and mobile automatically.",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Your watchlist is where you spot the setup. PickMyTrade is where you stop clicking. <strong class='text-white'>Wire your TradingView alerts through PickMyTrade</strong> and they fire into your Tradovate account on their own, same markets you're already watching, executed without a manual click or a missed fill." },
  ], de: [
    { type: "paragraph",html: "Ständig zwischen Charts zu wechseln, um zu sehen, wo jeder Markt steht, nervt schnell. Eine Quote-Watchlist löst das: ein Raster, alle Ihre Kontrakte, Live-Kurse nebeneinander, mit integrierten Order-Schaltflächen und Alerts. So erstellen Sie eine im Quote-Modul von Tradovate, stimmen sie auf genau das ab, was Sie interessiert, und nehmen sie von Web über Desktop bis Mobile mit." },
    { type: "heading",text: "Was ist das Tradovate-Quote-Modul?" },
    { type: "paragraph",html: "Das Quote-Modul ist das Watchlist-Raster von Tradovate. Jede Zeile ist ein Kontrakt, den Sie verfolgen, und jede Spalte ist ein Stück Live-Marktdaten: Bid, Ask, Last, Net Change, Volumen und mehr. Es ist außerdem eine Startrampe: Sie können einen Markt handeln, einen Preisalarm setzen oder detaillierte Kursinformationen wie Margen, Handelszeiten und Kontraktspezifikationen aufrufen, ohne das Board zu verlassen. Je nach Plattformversion erscheint das Modul als <strong class='text-white'>Quote Board</strong>, <strong class='text-white'>Quote Info</strong> oder <strong class='text-white'>Market Analyzer</strong>. Der Name hat sich im Laufe der Zeit geändert, der Ablauf unten bleibt jedoch derselbe." },
    { type: "heading",text: "Eine Quote-Watchlist erstellen: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Das Quote-Modul öffnen", html: "Melden Sie sich beim Tradovate Web Trader an und öffnen Sie das Menü zum Hinzufügen von Modulen, die Schaltfläche <strong class='text-white'>New +</strong>, meist oben links. Wählen Sie das Quote Board aus der Liste und ziehen Sie es auf Ihren Arbeitsbereich. Ein neues Board öffnet sich leer, lassen Sie sich vom leeren Raster nicht irritieren; das ist Ihr Ausgangspunkt." },
        { title: "Ihre Symbole hinzufügen", html: "Klicken Sie oben im Board in das Suchfeld und beginnen Sie, einen Kontrakt einzutippen, ES, NQ, CL, GC, was immer Sie verfolgen. Tradovate vervollständigt beim Tippen automatisch und gleicht nach Symbol, Kontraktnamen und Börse ab, sodass Sie genau den Front-Month-Kontrakt wählen können, statt zu raten. Wählen Sie ihn aus der Liste, und er erscheint als neue Zeile. Wiederholen Sie dies für jeden Markt, den Sie auf dem Board haben möchten. Um einen zu entfernen, markieren Sie seine Zeile und drücken Sie <strong class='text-white'>Delete</strong>." },
        { title: "Spalten anpassen", html: "Standardmäßig erhalten Sie die Grundlagen: Bid, Ask, Last, Net Change, Volumen. Um die Anzeige zu ändern, öffnen Sie die Spalteneinstellungen des Boards (das Zahnrad- bzw. View-Settings-Symbol) und wählen Sie <strong class='text-white'>Select Columns</strong>. Ziehen Sie die gewünschten Felder von Available nach Visible; ihre Reihenfolge von oben nach unten in dieser Liste bestimmt die Reihenfolge von links nach rechts in Ihrem Raster. Die Spalte <strong class='text-white'>Trend</strong> lohnt sich, sie zeigt kurzfristige Kursbewegungen auf einen Blick. Um Ihre Märkte neu anzuordnen, ziehen Sie den Griff am linken Rand einer beliebigen Zeile." },
        { title: "Vom Board aus handeln und Alerts setzen", html: "Sie brauchen kein separates Order-Ticket, um auf das zu reagieren, was Sie beobachten. Fügen Sie die Spalte <strong class='text-white'>Buy/Sell</strong> hinzu, und jede Zeile erhält eigene Order-Schaltflächen: Menge festlegen, klicken, und die Order geht direkt an Ihr Konto. Sie können außerdem direkt vom Board aus einen Preisalarm für jedes Symbol setzen und werden benachrichtigt, wenn ein Niveau erreicht wird, statt den Bildschirm zu hüten." },
        { title: "Watchlist benennen, speichern und synchronisieren", html: "Geben Sie der Liste einen Namen, dann können Sie mehrere führen, etwa ein Board mit Index-Futures und eines mit Energie, und mit einem Klick zwischen ihnen wechseln. Da Tradovate cloudbasiert ist, begleiten Ihre gespeicherten Quote-Listen Sie: Dieselbe Watchlist lädt, wenn Sie sich in der Desktop-App oder der Mobile-App anmelden, ohne dass Sie von vorn beginnen müssen." },
      ],
    },
    { type: "heading",text: "Warum Sie das brauchen" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Den gesamten Markt auf einen Blick</strong>, jeder Kontrakt, den Sie handeln, live auf einem Bildschirm.",
        "<strong class='text-white'>Schneller handeln</strong>, Ein-Klick-Buy/Sell aus der Zeile schlägt die Suche nach einem Order-Ticket.",
        "<strong class='text-white'>Nie ein Niveau verpassen</strong>, Alerts werden direkt vom Board ausgelöst, während Sie sich auf anderes konzentrieren.",
        "<strong class='text-white'>Einmal einrichten</strong>, Ihre Watchlist wird automatisch zwischen Web, Desktop und Mobile synchronisiert.",
      ],
    },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "In Ihrer Watchlist erkennen Sie das Setup. Mit PickMyTrade hören Sie auf zu klicken. <strong class='text-white'>Leiten Sie Ihre TradingView-Alerts über PickMyTrade</strong>, und sie werden von selbst in Ihrem Tradovate-Konto ausgelöst, an denselben Märkten, die Sie ohnehin beobachten, ausgeführt ohne manuellen Klick und ohne verpassten Fill." },
  ], es: [
    { type: "paragraph",html: "Saltar entre gráficos para ver dónde cotiza cada mercado cansa rápido. Una lista de cotizaciones lo resuelve: una cuadrícula, todos sus contratos, precios en vivo lado a lado, con botones de orden y alertas integrados. Así se crea una en el módulo de cotizaciones de Tradovate, se ajusta para mostrar justo lo que le interesa y se hace que le acompañe de la web al escritorio y al móvil." },
    { type: "heading",text: "¿Qué es el módulo de cotizaciones de Tradovate?" },
    { type: "paragraph",html: "El módulo de cotizaciones es la cuadrícula de seguimiento de Tradovate. Cada fila es un contrato que sigue y cada columna es un dato de mercado en vivo: bid, ask, último, variación neta, volumen y más. También es una plataforma de lanzamiento: puede operar un mercado, fijar una alerta de precio o abrir información detallada de la cotización, como márgenes, horarios de negociación y especificaciones del contrato, sin salir del tablero. Según la versión de su plataforma, el módulo aparece como <strong class='text-white'>Quote Board</strong>, <strong class='text-white'>Quote Info</strong> o <strong class='text-white'>Market Analyzer</strong>; el nombre ha ido cambiando con el tiempo, pero el flujo de trabajo que sigue es el mismo." },
    { type: "heading",text: "Cree una lista de cotizaciones: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra el módulo de cotizaciones", html: "Inicie sesión en Tradovate Web Trader y abra el menú para añadir módulos, el botón <strong class='text-white'>New +</strong>, normalmente arriba a la izquierda. Elija el tablero de cotizaciones de la lista y arrástrelo a su espacio de trabajo. Un tablero nuevo se abre vacío, así que no se desconcierte ante la cuadrícula en blanco; es su punto de partida." },
        { title: "Añada sus símbolos", html: "Haga clic en el cuadro de búsqueda en la parte superior del tablero y empiece a escribir un contrato, ES, NQ, CL, GC, el que siga. Tradovate autocompleta mientras escribe, buscando por símbolo, nombre del contrato y bolsa, de modo que pueda elegir el contrato exacto del mes frontal en lugar de adivinarlo. Selecciónelo de la lista y se añade como una fila nueva. Repita para cada mercado que desee en el tablero. Para quitar uno, resalte su fila y pulse <strong class='text-white'>Delete</strong>." },
        { title: "Personalice sus columnas", html: "De fábrica obtiene lo básico: bid, ask, último, variación neta, volumen. Para cambiar lo que se muestra, abra los ajustes de columnas del tablero (el icono de engranaje / View Settings) y elija <strong class='text-white'>Select Columns</strong>. Arrastre los campos que desee de Available a Visible; su orden de arriba abajo en esa lista determina el orden de izquierda a derecha en su cuadrícula. Vale la pena añadir la columna <strong class='text-white'>Trend</strong>, que señala de un vistazo el movimiento de precio a corto plazo. Para reordenar sus mercados, arrastre el control del borde izquierdo de cualquier fila." },
        { title: "Opere y fije alertas desde el tablero", html: "No necesita un ticket de orden aparte para actuar sobre lo que observa. Añada la columna <strong class='text-white'>Buy/Sell</strong> y cada fila tendrá sus propios botones de orden: fije su cantidad, haga clic y la orden se enruta directamente a su cuenta. También puede fijar una alerta de precio en cualquier símbolo desde el propio tablero, de modo que reciba un aviso cuando se alcance un nivel en lugar de vigilar la pantalla." },
        { title: "Nombre, guarde y sincronice su lista", html: "Póngale un nombre a la lista y podrá tener más de una, por ejemplo un tablero de futuros de índices y otro de energía, y alternar entre ellos con un clic. Como Tradovate está basado en la nube, sus listas de cotizaciones guardadas le acompañan: la misma lista se carga cuando inicia sesión en la app de escritorio o en la app móvil, sin tener que reconstruirla desde cero." },
      ],
    },
    { type: "heading",text: "Por qué lo necesitaría" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Vea todo su mercado de un vistazo</strong>, cada contrato que opera, en vivo, en una sola pantalla.",
        "<strong class='text-white'>Actúe más rápido</strong>, el Buy/Sell con un clic desde la fila supera la búsqueda de un ticket de orden.",
        "<strong class='text-white'>No pierda nunca un nivel</strong>, las alertas se disparan directamente desde el tablero mientras usted se concentra en otra cosa.",
        "<strong class='text-white'>Configúrelo una vez</strong>, su lista se sincroniza automáticamente entre web, escritorio y móvil.",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Su lista de seguimiento es donde detecta la configuración. PickMyTrade es donde deja de hacer clic. <strong class='text-white'>Conecte sus alertas de TradingView a través de PickMyTrade</strong> y se ejecutarán solas en su cuenta de Tradovate, en los mismos mercados que ya está observando, ejecutadas sin un clic manual ni una ejecución perdida." },
  ], fr: [
    { type: "paragraph",html: "Passer d'un graphique à l'autre pour voir où cote chaque marché devient vite lassant. Une liste de cotations règle le problème : une grille, tous vos contrats, des prix en direct côte à côte, avec des boutons d'ordre et des alertes intégrés. Voici comment en créer une dans le module de cotations de Tradovate, l'ajuster pour n'afficher que ce qui vous intéresse et la faire vous suivre du web au bureau puis au mobile." },
    { type: "heading",text: "Qu'est-ce que le module de cotations Tradovate ?" },
    { type: "paragraph",html: "Le module de cotations est la grille de liste de suivi de Tradovate. Chaque ligne est un contrat que vous suivez, et chaque colonne est une donnée de marché en direct : bid, ask, dernier, variation nette, volume, et plus encore. C'est aussi une rampe de lancement : vous pouvez trader un marché, définir une alerte de prix ou afficher des informations détaillées de cotation comme les marges, les horaires de négociation et les caractéristiques du contrat, sans quitter le tableau. Selon la version de votre plateforme, le module apparaît sous le nom <strong class='text-white'>Quote Board</strong>, <strong class='text-white'>Quote Info</strong> ou <strong class='text-white'>Market Analyzer</strong> ; le nom a évolué avec le temps, mais le flux de travail ci-dessous reste le même." },
    { type: "heading",text: "Créer une liste de cotations : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir le module de cotations", html: "Connectez-vous à Tradovate Web Trader et ouvrez le menu d'ajout de modules, le bouton <strong class='text-white'>New +</strong>, généralement en haut à gauche. Choisissez le tableau de cotations dans la liste et faites-le glisser sur votre espace de travail. Un nouveau tableau s'ouvre vide ; ne soyez pas dérouté par la grille blanche, c'est votre point de départ." },
        { title: "Ajouter vos symboles", html: "Cliquez sur la zone de recherche en haut du tableau et commencez à saisir un contrat, ES, NQ, CL, GC, celui que vous suivez. Tradovate complète automatiquement pendant la saisie, en recherchant par symbole, nom du contrat et bourse, ce qui vous permet de choisir exactement le contrat du mois le plus proche au lieu de deviner. Sélectionnez-le dans la liste et il s'ajoute comme nouvelle ligne. Répétez l'opération pour chaque marché souhaité. Pour en retirer un, surlignez sa ligne et appuyez sur <strong class='text-white'>Delete</strong>." },
        { title: "Personnaliser vos colonnes", html: "Par défaut, vous obtenez l'essentiel : bid, ask, dernier, variation nette, volume. Pour modifier l'affichage, ouvrez les paramètres de colonnes du tableau (l'icône d'engrenage / View Settings) et choisissez <strong class='text-white'>Select Columns</strong>. Faites glisser les champs souhaités de Available vers Visible ; leur ordre de haut en bas dans cette liste définit l'ordre de gauche à droite dans votre grille. La colonne <strong class='text-white'>Trend</strong> mérite d'être ajoutée : elle signale d'un coup d'œil le mouvement de prix à court terme. Pour réorganiser vos marchés, faites glisser la poignée située sur le bord gauche d'une ligne." },
        { title: "Trader et définir des alertes depuis le tableau", html: "Vous n'avez pas besoin d'un ticket d'ordre séparé pour agir sur ce que vous observez. Ajoutez la colonne <strong class='text-white'>Buy/Sell</strong> et chaque ligne reçoit ses propres boutons d'ordre : définissez votre quantité, cliquez, et l'ordre est acheminé directement vers votre compte. Vous pouvez aussi définir une alerte de prix sur n'importe quel symbole directement depuis le tableau, pour être averti quand un niveau est atteint au lieu de surveiller l'écran." },
        { title: "Nommer, enregistrer et synchroniser votre liste", html: "Donnez un nom à la liste et vous pouvez en conserver plusieurs, par exemple un tableau de futures sur indices et un autre d'énergie, puis passer de l'un à l'autre en un clic. Comme Tradovate fonctionne dans le cloud, vos listes de cotations enregistrées vous suivent : la même liste se charge lorsque vous vous connectez sur l'application de bureau ou l'application mobile, sans tout reconstruire." },
      ],
    },
    { type: "heading",text: "Pourquoi vous en auriez besoin" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Voyez tout votre marché d'un coup d'œil</strong>, chaque contrat que vous tradez, en direct, sur un seul écran.",
        "<strong class='text-white'>Agissez plus vite</strong>, un Buy/Sell en un clic depuis la ligne vaut mieux que de chercher un ticket d'ordre.",
        "<strong class='text-white'>Ne manquez jamais un niveau</strong>, les alertes se déclenchent directement depuis le tableau pendant que vous vous concentrez ailleurs.",
        "<strong class='text-white'>Configurez-le une seule fois</strong>, votre liste se synchronise automatiquement entre le web, le bureau et le mobile.",
      ],
    },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Votre liste de suivi est l'endroit où vous repérez le setup. PickMyTrade est l'endroit où vous cessez de cliquer. <strong class='text-white'>Reliez vos alertes TradingView via PickMyTrade</strong> et elles se déclenchent d'elles-mêmes sur votre compte Tradovate, sur les mêmes marchés que ceux que vous surveillez déjà, exécutées sans clic manuel ni exécution manquée." },
  ], it: [
    { type: "paragraph",html: "Passare da un grafico all'altro per controllare dove quota ogni mercato stanca presto. Una watchlist di quotazioni risolve il problema: una griglia, tutti i suoi contratti, prezzi in tempo reale affiancati, con pulsanti d'ordine e alert integrati. Ecco come crearne una nel modulo quotazioni di Tradovate, regolarla per mostrare esattamente ciò che Le interessa e fare in modo che La segua dal web al desktop al mobile." },
    { type: "heading",text: "Che cos'è il modulo quotazioni di Tradovate?" },
    { type: "paragraph",html: "Il modulo quotazioni è la griglia watchlist di Tradovate. Ogni riga è un contratto che sta seguendo e ogni colonna è un dato di mercato in tempo reale: bid, ask, ultimo, variazione netta, volume e altro. È anche una rampa di lancio: può operare su un mercato, impostare un alert di prezzo o aprire informazioni dettagliate sulla quotazione, come margini, orari di negoziazione e specifiche del contratto, senza lasciare la board. A seconda della versione della piattaforma, il modulo compare come <strong class='text-white'>Quote Board</strong>, <strong class='text-white'>Quote Info</strong> o <strong class='text-white'>Market Analyzer</strong>; il nome è cambiato nel tempo, ma il flusso di lavoro qui sotto resta lo stesso." },
    { type: "heading",text: "Creare una watchlist di quotazioni: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Aprire il modulo quotazioni", html: "Acceda a Tradovate Web Trader e apra il menu per aggiungere moduli, il pulsante <strong class='text-white'>New +</strong>, di solito in alto a sinistra. Scelga il quote board dall'elenco e lo trascini nel suo spazio di lavoro. Una nuova board si apre vuota, quindi non si lasci sorprendere dalla griglia bianca; è il suo punto di partenza." },
        { title: "Aggiungere i simboli", html: "Clicchi sulla casella di ricerca in cima alla board e inizi a digitare un contratto, ES, NQ, CL, GC, quello che segue. Tradovate completa automaticamente mentre digita, cercando per simbolo, nome del contratto e borsa, così può scegliere l'esatto contratto del mese corrente invece di indovinare. Lo selezioni dall'elenco e verrà inserito come nuova riga. Ripeta per ogni mercato che desidera sulla board. Per eliminarne uno, evidenzi la sua riga e prema <strong class='text-white'>Delete</strong>." },
        { title: "Personalizzare le colonne", html: "Di default ottiene le basi: bid, ask, ultimo, variazione netta, volume. Per cambiare ciò che viene mostrato, apra le impostazioni delle colonne della board (l'icona a ingranaggio / View Settings) e scelga <strong class='text-white'>Select Columns</strong>. Trascini i campi desiderati da Available a Visible; il loro ordine dall'alto in basso in quell'elenco determina l'ordine da sinistra a destra nella sua griglia. Vale la pena aggiungere la colonna <strong class='text-white'>Trend</strong>, che segnala a colpo d'occhio il movimento di prezzo a breve termine. Per riordinare i mercati, trascini la maniglia sul bordo sinistro di una qualsiasi riga." },
        { title: "Operare e impostare alert dalla board", html: "Non Le serve un ticket d'ordine separato per agire su ciò che osserva. Aggiunga la colonna <strong class='text-white'>Buy/Sell</strong> e ogni riga avrà i propri pulsanti d'ordine: imposti la quantità, clicchi e l'ordine viene instradato direttamente al suo account. Può anche impostare un alert di prezzo su qualsiasi simbolo direttamente dalla board, così riceve un avviso quando un livello viene toccato invece di sorvegliare lo schermo." },
        { title: "Assegnare un nome, salvare e sincronizzare la watchlist", html: "Dia un nome all'elenco e ne potrà tenere più di uno, ad esempio una board di futures su indici e un'altra di energetici, passando dall'una all'altra con un clic. Poiché Tradovate è basato sul cloud, i suoi elenchi di quotazioni salvati La seguono: la stessa watchlist si carica quando accede dall'app desktop o dall'app mobile, senza doverla ricostruire da zero." },
      ],
