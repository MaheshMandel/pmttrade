---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-link-modules";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Link Tradovate Modules by Color to Sync Symbols";
const META_DESCRIPTION =
  "Give your chart, DOM, and Market Analyzer the same link color so picking a symbol in one instantly updates every panel in that group.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate-Module per Farbe verknüpfen und Symbole synchronisieren", es: "Vincule los módulos de Tradovate por color para sincronizar símbolos", fr: "Liez les modules Tradovate par couleur pour synchroniser les symboles", it: "Colleghi i moduli Tradovate per colore per sincronizzare i simboli" },
  dek: { en: "Running a chart, a DOM, and a Market Analyzer at once is normal. Retyping the same contract into all three every time you rotate instruments is a waste of clicks. Here's how color linking syncs them instantly.", de: "Ein Chart, ein DOM und ein Market Analyzer gleichzeitig zu nutzen ist ganz normal. Dasselbe Produkt bei jedem Instrumentenwechsel in alle drei erneut einzutippen, kostet nur unnötige Klicks. So synchronisiert die Farbverknüpfung sie sofort.", es: "Trabajar con un gráfico, un DOM y un Market Analyzer a la vez es lo normal. Reescribir el mismo contrato en los tres cada vez que cambia de instrumento es un desperdicio de clics. Así es como la vinculación por color los sincroniza al instante.", fr: "Utiliser un graphique, un DOM et un Market Analyzer en même temps est tout à fait normal. Ressaisir le même contrat dans les trois à chaque rotation d’instrument est une perte de clics. Voici comment la liaison par couleur les synchronise instantanément.", it: "Usare un grafico, un DOM e un Market Analyzer contemporaneamente è normale. Riscrivere lo stesso contratto in tutti e tre a ogni cambio di strumento è uno spreco di clic. Ecco come il collegamento per colore li sincronizza all’istante." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-10",
  blocks: { en: [
    { type: "paragraph", html: "Running a chart, a DOM, and a Market Analyzer at once is normal. Retyping the same contract into all three every time you rotate instruments is a waste of clicks. Tradovate solves it with color linking: give two or more modules the same link color, and picking a symbol in one pushes it to the rest of the group." },
    { type: "paragraph", html: "The part most people miss is what actually drives the link. Matching colors group the modules, but the Market Analyzer, the quote list you build symbols in, pushes the change out. Get that right and the sync just works." },
    { type: "heading", text: "What Color Linking Actually Does" },
    { type: "paragraph", html: "A link color is a group tag. Modules that share a color move together; one left on gray stays independent. You click a symbol in the Market Analyzer, and the chart, DOM, and Tick Stream on the same color follow along." },
    {
      type: "table",
      headers: ["Module", "Role in a color-linked group"],
      rows: [
        ["Market Analyzer", "The driver, select a symbol in this list and every same-colored module follows"],
        ["Chart", "Redraws to the group's symbol when it changes"],
        ["DOM (SuperDOM)", "Loads the ladder for the group's symbol"],
        ["Tick Stream", "Switches its feed to the group's symbol"],
      ],
    },
    { type: "paragraph", html: "You get up to six colors, so you can run more than one linked set on a busy layout, say a green group on your index setup and a blue group on energy. <strong class='text-white'>Gray</strong> is the off switch: a module on gray ignores every link and holds whatever symbol you put on it by hand." },
    { type: "heading", text: "Link Your Modules by Color: Step by Step" },
    {
      type: "steps",
      items: [
        { title: "Open the Modules You Want to Sync", html: "Put the panels you want tied together into one workspace. A common trio is a Market Analyzer, a Chart, and a DOM, but a Tick Stream works the same way. Add each module from the platform's new-module control and drop it into the window so they're all on screen.", image: { src: `${IMG}/tradovate-link-modules-1.png`, alt: "Tradovate workspace with a Market Analyzer, Chart, and DOM module open together" } },
        { title: "Find the Color Link Control", html: "Each module has a tab at the top showing the instrument name. Right beside that name is a small colored control, the link-color selector. That's where you set which group a module belongs to. It's easy to walk past because it's tiny, so look closely next to the symbol on the module's title bar.", image: { src: `${IMG}/tradovate-link-modules-2.png`, alt: "Colored link dropdown next to the instrument name at the top of a Tradovate module" } },
        { title: "Give Each Module the Same Color", html: "Open the link-color control on the Market Analyzer and pick a color, green, for example. Then open the same control on the Chart and set it to green, and do the DOM too. Matching colors put all three in one linked group. Leave any module you <em>don't</em> want syncing on gray.", image: { src: `${IMG}/tradovate-link-modules-3.png`, alt: "Selecting the same link color for a Tradovate Market Analyzer, Chart, and DOM to group them" } },
        { title: "Drive the Switch from the Market Analyzer", html: "Now click a different symbol in the green Market Analyzer. The green Chart, the green DOM, and any other green module jump to that symbol at once, no retyping. This is the payoff: build your watchlist once, and every linked panel rides along as you move down the list.", image: { src: `${IMG}/tradovate-link-modules-4.png`, alt: "Picking a symbol in the Tradovate Market Analyzer updating the linked chart and DOM" } },
        { title: "Save the Workspace", html: "Once the colors are set the way you want, save the workspace. The link colors are part of the layout, so saving means the whole synced setup loads exactly like this next session instead of re-tagging every module each morning.", image: { src: `${IMG}/tradovate-link-modules-5.png`, alt: "Saving a Tradovate workspace so the color links return next session" } },
      ],
    },
    { type: "heading", text: "Links Not Syncing? Start with the Market Analyzer" },
    { type: "paragraph", html: "The usual reason a link looks broken: people color a Chart and a DOM the same and expect them to drive each other. They won't on their own. The symbol change flows from the Market Analyzer outward, so a group needs a same-colored Market Analyzer to push the switch. Add one on the same color and the pair starts following." },
    { type: "paragraph", html: "If it still misbehaves, check that no module slipped back to gray and that every panel is on the identical color. Tradovate adjusts platform details now and then, so confirm the link control's placement in your own build if it looks different here." },
    { type: "heading", text: "Automate the Trades Once Your Layout Is Dialed In" },
    { type: "paragraph", html: "A color-linked layout gets you flipping through instruments fast while you watch. It still needs you at the desk to pull the trigger. <strong class='text-white'>PickMyTrade closes that gap</strong>: it turns your TradingView alerts into live Tradovate orders automatically, so the trade fires the moment your setup triggers, even when you're away from the screen." },
  ], de: [
    { type: "paragraph",html: "Ein Chart, ein DOM und ein Market Analyzer gleichzeitig zu nutzen ist ganz normal. Dasselbe Produkt bei jedem Instrumentenwechsel in alle drei erneut einzutippen, kostet nur unnötige Klicks. Tradovate löst das mit der Farbverknüpfung: Weisen Sie zwei oder mehr Modulen dieselbe Verknüpfungsfarbe zu, und die Auswahl eines Symbols in einem Modul wird an den Rest der Gruppe weitergegeben." },
    { type: "paragraph",html: "Was die meisten übersehen, ist, was die Verknüpfung tatsächlich antreibt. Gleiche Farben gruppieren die Module, aber der Market Analyzer, die Kursliste, in der Sie Symbole zusammenstellen, löst den Wechsel aus. Wenn Sie das richtig einrichten, funktioniert die Synchronisierung einfach." },
    { type: "heading",text: "Was die Farbverknüpfung tatsächlich bewirkt" },
    { type: "paragraph",html: "Eine Verknüpfungsfarbe ist ein Gruppen-Tag. Module mit derselben Farbe bewegen sich gemeinsam; ein Modul auf Grau bleibt unabhängig. Sie klicken im Market Analyzer auf ein Symbol, und das Chart, das DOM und der Tick Stream mit derselben Farbe folgen." },
    { type: "table", headers: ["Modul","Rolle in einer farbverknüpften Gruppe"], rows: [
      ["Market Analyzer","Der Auslöser: Wählen Sie in dieser Liste ein Symbol aus, und jedes Modul mit derselben Farbe folgt"],
      ["Chart","Wird auf das Symbol der Gruppe umgezeichnet, sobald es sich ändert"],
      ["DOM (SuperDOM)","Lädt die Leiter für das Symbol der Gruppe"],
      ["Tick Stream","Schaltet seinen Feed auf das Symbol der Gruppe um"],
    ] },
    { type: "paragraph",html: "Sie haben bis zu sechs Farben zur Verfügung und können daher mehr als eine verknüpfte Gruppe in einem vollen Layout betreiben, etwa eine grüne Gruppe für Ihr Index-Setup und eine blaue für Energie. <strong class='text-white'>Grau</strong> ist der Ausschalter: Ein Modul auf Grau ignoriert jede Verknüpfung und behält das Symbol, das Sie manuell eingestellt haben." },
    { type: "heading",text: "Module per Farbe verknüpfen: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Öffnen Sie die Module, die Sie synchronisieren möchten", html: "Legen Sie die Panels, die Sie verknüpfen möchten, in einem Workspace zusammen. Ein gängiges Trio ist ein Market Analyzer, ein Chart und ein DOM, aber ein Tick Stream funktioniert genauso. Fügen Sie jedes Modul über die Schaltfläche für neue Module der Plattform hinzu und platzieren Sie es im Fenster, sodass alle sichtbar sind.", image: {"src":`${IMG}/tradovate-link-modules-1.png`,"alt":"Tradovate-Workspace mit gleichzeitig geöffneten Modulen Market Analyzer, Chart und DOM"} },
        { title: "Finden Sie das Farbverknüpfungs-Steuerelement", html: "Jedes Modul hat oben einen Tab mit dem Instrumentennamen. Direkt neben diesem Namen befindet sich ein kleines farbiges Steuerelement, die Auswahl der Verknüpfungsfarbe. Hier legen Sie fest, zu welcher Gruppe ein Modul gehört. Es ist winzig und leicht zu übersehen, schauen Sie also genau neben das Symbol in der Titelleiste des Moduls.", image: {"src":`${IMG}/tradovate-link-modules-2.png`,"alt":"Farbiges Verknüpfungs-Dropdown neben dem Instrumentennamen oben in einem Tradovate-Modul"} },
        { title: "Weisen Sie jedem Modul dieselbe Farbe zu", html: "Öffnen Sie das Steuerelement für die Verknüpfungsfarbe im Market Analyzer und wählen Sie eine Farbe, zum Beispiel Grün. Öffnen Sie dann dasselbe Steuerelement im Chart und stellen Sie es auf Grün, und tun Sie dasselbe beim DOM. Gleiche Farben fassen alle drei in einer verknüpften Gruppe zusammen. Lassen Sie jedes Modul, das <em>nicht</em> synchronisiert werden soll, auf Grau.", image: {"src":`${IMG}/tradovate-link-modules-3.png`,"alt":"Auswahl derselben Verknüpfungsfarbe für Market Analyzer, Chart und DOM in Tradovate, um sie zu gruppieren"} },
        { title: "Steuern Sie den Wechsel vom Market Analyzer aus", html: "Klicken Sie nun im grünen Market Analyzer auf ein anderes Symbol. Das grüne Chart, das grüne DOM und jedes weitere grüne Modul springen sofort zu diesem Symbol, ohne erneutes Eintippen. Das ist der Gewinn: Sie erstellen Ihre Watchlist einmal, und jedes verknüpfte Panel folgt, während Sie die Liste durchgehen.", image: {"src":`${IMG}/tradovate-link-modules-4.png`,"alt":"Die Auswahl eines Symbols im Tradovate Market Analyzer aktualisiert das verknüpfte Chart und DOM"} },
        { title: "Speichern Sie den Workspace", html: "Sobald die Farben so eingestellt sind, wie Sie es möchten, speichern Sie den Workspace. Die Verknüpfungsfarben sind Teil des Layouts. Durch das Speichern wird Ihr gesamtes synchronisiertes Setup in der nächsten Sitzung genau so geladen, statt jedes Modul jeden Morgen neu zu markieren.", image: {"src":`${IMG}/tradovate-link-modules-5.png`,"alt":"Speichern eines Tradovate-Workspaces, damit die Farbverknüpfungen in der nächsten Sitzung wiederkehren"} },
      ],
    },
    { type: "heading",text: "Verknüpfungen synchronisieren nicht? Beginnen Sie beim Market Analyzer" },
    { type: "paragraph",html: "Der übliche Grund, warum eine Verknüpfung defekt wirkt: Man färbt ein Chart und ein DOM gleich und erwartet, dass sie sich gegenseitig steuern. Das tun sie von allein nicht. Der Symbolwechsel geht vom Market Analyzer nach außen, daher braucht eine Gruppe einen gleichfarbigen Market Analyzer, der den Wechsel auslöst. Fügen Sie einen mit derselben Farbe hinzu, und das Paar beginnt zu folgen." },
    { type: "paragraph",html: "Wenn es sich weiterhin falsch verhält, prüfen Sie, dass kein Modul wieder auf Grau gesprungen ist und dass jedes Panel exakt dieselbe Farbe hat. Tradovate passt Plattformdetails hin und wieder an. Prüfen Sie daher die Position des Verknüpfungs-Steuerelements in Ihrer eigenen Version, falls sie hier anders aussieht." },
    { type: "heading",text: "Automatisieren Sie die Trades, sobald Ihr Layout perfekt ist" },
    { type: "paragraph",html: "Ein farbverknüpftes Layout lässt Sie beim Beobachten schnell durch Instrumente schalten. Sie müssen aber weiterhin am Schreibtisch sitzen, um den Trade auszulösen. <strong class='text-white'>PickMyTrade schließt diese Lücke</strong>: Es wandelt Ihre TradingView-Alarme automatisch in echte Tradovate-Orders um, sodass der Trade genau dann ausgelöst wird, wenn Ihr Setup eintritt, selbst wenn Sie nicht am Bildschirm sind." },
  ], es: [
    { type: "paragraph",html: "Trabajar con un gráfico, un DOM y un Market Analyzer a la vez es lo normal. Reescribir el mismo contrato en los tres cada vez que cambia de instrumento es un desperdicio de clics. Tradovate lo resuelve con la vinculación por color: asigne el mismo color de vinculación a dos o más módulos, y al elegir un símbolo en uno, este se envía al resto del grupo." },
    { type: "paragraph",html: "Lo que la mayoría pasa por alto es qué impulsa realmente la vinculación. Los colores iguales agrupan los módulos, pero es el Market Analyzer, la lista de cotizaciones donde arma sus símbolos, el que empuja el cambio. Si lo configura bien, la sincronización simplemente funciona." },
    { type: "heading",text: "Qué hace realmente la vinculación por color" },
    { type: "paragraph",html: "Un color de vinculación es una etiqueta de grupo. Los módulos que comparten un color se mueven juntos; uno que se deja en gris permanece independiente. Usted hace clic en un símbolo en el Market Analyzer y el gráfico, el DOM y el Tick Stream del mismo color lo siguen." },
    { type: "table", headers: ["Módulo","Función en un grupo vinculado por color"], rows: [
      ["Market Analyzer","El conductor: seleccione un símbolo en esta lista y todos los módulos del mismo color lo siguen"],
      ["Gráfico","Se redibuja con el símbolo del grupo cuando este cambia"],
      ["DOM (SuperDOM)","Carga la escalera del símbolo del grupo"],
      ["Tick Stream","Cambia su feed al símbolo del grupo"],
    ] },
    { type: "paragraph",html: "Dispone de hasta seis colores, así que puede manejar más de un conjunto vinculado en un diseño cargado, por ejemplo un grupo verde para su configuración de índices y uno azul para energía. El <strong class='text-white'>gris</strong> es el interruptor de apagado: un módulo en gris ignora todas las vinculaciones y conserva el símbolo que usted le puso a mano." },
    { type: "heading",text: "Vincule sus módulos por color: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra los módulos que desea sincronizar", html: "Reúna en un mismo espacio de trabajo los paneles que desea enlazar. Un trío habitual es un Market Analyzer, un gráfico y un DOM, pero un Tick Stream funciona igual. Añada cada módulo desde el control de nuevo módulo de la plataforma y colóquelo en la ventana para que todos estén a la vista.", image: {"src":`${IMG}/tradovate-link-modules-1.png`,"alt":"Espacio de trabajo de Tradovate con un Market Analyzer, un gráfico y un módulo DOM abiertos a la vez"} },
        { title: "Encuentre el control de vinculación por color", html: "Cada módulo tiene una pestaña en la parte superior con el nombre del instrumento. Justo al lado de ese nombre hay un pequeño control de color, el selector del color de vinculación. Ahí es donde define a qué grupo pertenece un módulo. Es fácil pasarlo por alto porque es diminuto, así que mire con atención junto al símbolo en la barra de título del módulo.", image: {"src":`${IMG}/tradovate-link-modules-2.png`,"alt":"Menú desplegable de color de vinculación junto al nombre del instrumento en la parte superior de un módulo de Tradovate"} },
        { title: "Asigne el mismo color a cada módulo", html: "Abra el control de color de vinculación en el Market Analyzer y elija un color, por ejemplo verde. Luego abra el mismo control en el gráfico y póngalo en verde, y haga lo mismo con el DOM. Los colores iguales ponen a los tres en un mismo grupo vinculado. Deje en gris cualquier módulo que <em>no</em> quiera sincronizar.", image: {"src":`${IMG}/tradovate-link-modules-3.png`,"alt":"Selección del mismo color de vinculación para un Market Analyzer, un gráfico y un DOM de Tradovate para agruparlos"} },
        { title: "Dirija el cambio desde el Market Analyzer", html: "Ahora haga clic en un símbolo distinto en el Market Analyzer verde. El gráfico verde, el DOM verde y cualquier otro módulo verde saltan a ese símbolo de inmediato, sin volver a escribir. Esa es la ventaja: arma su lista de seguimiento una sola vez y cada panel vinculado la sigue mientras usted avanza por la lista.", image: {"src":`${IMG}/tradovate-link-modules-4.png`,"alt":"Al elegir un símbolo en el Market Analyzer de Tradovate se actualizan el gráfico y el DOM vinculados"} },
        { title: "Guarde el espacio de trabajo", html: "Cuando los colores estén como desea, guarde el espacio de trabajo. Los colores de vinculación forman parte del diseño, de modo que al guardar, toda la configuración sincronizada se cargará exactamente así en la próxima sesión, en lugar de tener que etiquetar de nuevo cada módulo cada mañana.", image: {"src":`${IMG}/tradovate-link-modules-5.png`,"alt":"Guardado de un espacio de trabajo de Tradovate para que las vinculaciones por color vuelvan en la próxima sesión"} },
      ],
    },
    { type: "heading",text: "¿Las vinculaciones no se sincronizan? Empiece por el Market Analyzer" },
    { type: "paragraph",html: "El motivo habitual por el que una vinculación parece rota: se colorean un gráfico y un DOM igual y se espera que se controlen entre sí. No lo harán por sí solos. El cambio de símbolo fluye desde el Market Analyzer hacia fuera, así que un grupo necesita un Market Analyzer del mismo color que impulse el cambio. Añada uno con el mismo color y el par empezará a seguirlo." },
    { type: "paragraph",html: "Si sigue sin funcionar bien, compruebe que ningún módulo haya vuelto a gris y que todos los paneles tengan exactamente el mismo color. Tradovate ajusta detalles de la plataforma de vez en cuando, así que confirme la ubicación del control de vinculación en su propia versión si se ve diferente aquí." },
    { type: "heading",text: "Automatice las operaciones cuando su diseño esté afinado" },
    { type: "paragraph",html: "Un diseño vinculado por color le permite pasar rápidamente de un instrumento a otro mientras observa. Aun así, necesita estar frente al escritorio para apretar el gatillo. <strong class='text-white'>PickMyTrade cierra esa brecha</strong>: convierte automáticamente sus alertas de TradingView en órdenes reales de Tradovate, de modo que la operación se ejecuta en el momento en que su configuración se activa, incluso cuando usted está lejos de la pantalla." },
  ], fr: [
    { type: "paragraph",html: "Utiliser un graphique, un DOM et un Market Analyzer en même temps est tout à fait normal. Ressaisir le même contrat dans les trois à chaque rotation d’instrument est une perte de clics. Tradovate résout cela avec la liaison par couleur : donnez la même couleur de liaison à deux modules ou plus, et le choix d’un symbole dans l’un le transmet au reste du groupe." },
    { type: "paragraph",html: "Ce que la plupart des gens manquent, c’est ce qui pilote réellement la liaison. Les couleurs identiques regroupent les modules, mais c’est le Market Analyzer, la liste de cotations dans laquelle vous construisez vos symboles, qui diffuse le changement. Une fois cela bien compris, la synchronisation fonctionne tout simplement." },
    { type: "heading",text: "Ce que fait réellement la liaison par couleur" },
    { type: "paragraph",html: "Une couleur de liaison est une étiquette de groupe. Les modules qui partagent une couleur évoluent ensemble ; un module laissé sur gris reste indépendant. Vous cliquez sur un symbole dans le Market Analyzer, et le graphique, le DOM et le Tick Stream de la même couleur suivent." },
    { type: "table", headers: ["Module","Rôle dans un groupe lié par couleur"], rows: [
      ["Market Analyzer","Le pilote : sélectionnez un symbole dans cette liste et chaque module de la même couleur suit"],
      ["Graphique","Se redessine avec le symbole du groupe lorsqu’il change"],
      ["DOM (SuperDOM)","Charge l’échelle du symbole du groupe"],
      ["Tick Stream","Bascule son flux sur le symbole du groupe"],
    ] },
    { type: "paragraph",html: "Vous disposez de six couleurs au maximum, ce qui permet de gérer plusieurs ensembles liés dans une disposition chargée, par exemple un groupe vert pour votre configuration sur les indices et un groupe bleu pour l’énergie. Le <strong class='text-white'>gris</strong> est l’interrupteur : un module sur gris ignore toute liaison et conserve le symbole que vous y avez placé à la main." },
    { type: "heading",text: "Liez vos modules par couleur : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez les modules que vous souhaitez synchroniser", html: "Placez les panneaux que vous voulez lier dans un même espace de travail. Un trio courant est un Market Analyzer, un graphique et un DOM, mais un Tick Stream fonctionne de la même manière. Ajoutez chaque module depuis la commande de nouveau module de la plateforme et déposez-le dans la fenêtre afin qu’ils soient tous visibles.", image: {"src":`${IMG}/tradovate-link-modules-1.png`,"alt":"Espace de travail Tradovate avec un Market Analyzer, un graphique et un module DOM ouverts ensemble"} },
        { title: "Trouvez la commande de liaison par couleur", html: "Chaque module comporte un onglet en haut affichant le nom de l’instrument. Juste à côté de ce nom se trouve une petite commande colorée, le sélecteur de couleur de liaison. C’est là que vous définissez le groupe auquel appartient un module. On passe facilement à côté car elle est minuscule ; regardez attentivement à côté du symbole dans la barre de titre du module.", image: {"src":`${IMG}/tradovate-link-modules-2.png`,"alt":"Menu déroulant de liaison colorée à côté du nom de l’instrument en haut d’un module Tradovate"} },
        { title: "Donnez la même couleur à chaque module", html: "Ouvrez la commande de couleur de liaison du Market Analyzer et choisissez une couleur, par exemple le vert. Ouvrez ensuite la même commande sur le graphique et réglez-la sur vert, puis faites de même pour le DOM. Des couleurs identiques placent les trois dans un même groupe lié. Laissez sur gris tout module que vous <em>ne voulez pas</em> synchroniser.", image: {"src":`${IMG}/tradovate-link-modules-3.png`,"alt":"Sélection de la même couleur de liaison pour un Market Analyzer, un graphique et un DOM Tradovate afin de les regrouper"} },
        { title: "Pilotez le changement depuis le Market Analyzer", html: "Cliquez maintenant sur un autre symbole dans le Market Analyzer vert. Le graphique vert, le DOM vert et tout autre module vert passent aussitôt à ce symbole, sans ressaisie. C’est tout l’intérêt : vous construisez votre liste de suivi une seule fois, et chaque panneau lié suit au fil de votre parcours de la liste.", image: {"src":`${IMG}/tradovate-link-modules-4.png`,"alt":"La sélection d’un symbole dans le Market Analyzer Tradovate met à jour le graphique et le DOM liés"} },
        { title: "Enregistrez l’espace de travail", html: "Une fois les couleurs réglées comme vous le souhaitez, enregistrez l’espace de travail. Les couleurs de liaison font partie de la disposition ; en enregistrant, toute votre configuration synchronisée se chargera exactement ainsi à la prochaine session, au lieu de devoir réétiqueter chaque module chaque matin.", image: {"src":`${IMG}/tradovate-link-modules-5.png`,"alt":"Enregistrement d’un espace de travail Tradovate pour retrouver les liaisons par couleur à la prochaine session"} },
      ],
    },
    { type: "heading",text: "Les liaisons ne se synchronisent pas ? Commencez par le Market Analyzer" },
    { type: "paragraph",html: "La raison habituelle pour laquelle une liaison semble défaillante : on colore un graphique et un DOM de la même façon et l’on s’attend à ce qu’ils se pilotent mutuellement. Ils ne le feront pas d’eux-mêmes. Le changement de symbole part du Market Analyzer vers l’extérieur ; un groupe a donc besoin d’un Market Analyzer de la même couleur pour diffuser le changement. Ajoutez-en un de la même couleur et le duo se met à suivre." },
    { type: "paragraph",html: "Si le problème persiste, vérifiez qu’aucun module n’est repassé sur gris et que chaque panneau a exactement la même couleur. Tradovate ajuste ponctuellement certains détails de la plateforme ; confirmez donc l’emplacement de la commande de liaison dans votre propre version si elle semble différente ici." },
    { type: "heading",text: "Automatisez les trades une fois votre disposition au point" },
    { type: "paragraph",html: "Une disposition liée par couleur vous permet de passer rapidement d’un instrument à l’autre pendant que vous observez. Il faut tout de même que vous soyez à votre poste pour appuyer sur la détente. <strong class='text-white'>PickMyTrade comble ce manque</strong> : il transforme automatiquement vos alertes TradingView en ordres Tradovate réels, de sorte que le trade part dès que votre configuration se déclenche, même lorsque vous êtes loin de l’écran." },
  ], it: [
    { type: "paragraph",html: "Usare un grafico, un DOM e un Market Analyzer contemporaneamente è normale. Riscrivere lo stesso contratto in tutti e tre a ogni cambio di strumento è uno spreco di clic. Tradovate risolve il problema con il collegamento per colore: assegni lo stesso colore di collegamento a due o più moduli, e scegliendo un simbolo in uno di essi lo si trasmette al resto del gruppo." },
    { type: "paragraph",html: "Ciò che la maggior parte delle persone trascura è che cosa guida realmente il collegamento. I colori uguali raggruppano i moduli, ma è il Market Analyzer, l’elenco di quotazioni in cui costruisce i simboli, a trasmettere il cambio. Se imposta correttamente questo aspetto, la sincronizzazione funziona senza problemi." },
    { type: "heading",text: "Che cosa fa realmente il collegamento per colore" },
    { type: "paragraph",html: "Un colore di collegamento è un tag di gruppo. I moduli che condividono un colore si muovono insieme; uno lasciato sul grigio resta indipendente. Lei fa clic su un simbolo nel Market Analyzer e il grafico, il DOM e il Tick Stream dello stesso colore lo seguono." },
    { type: "table", headers: ["Modulo","Ruolo in un gruppo collegato per colore"], rows: [
      ["Market Analyzer","Il pilota: selezioni un simbolo in questo elenco e ogni modulo dello stesso colore lo segue"],
      ["Grafico","Si ridisegna con il simbolo del gruppo quando questo cambia"],
      ["DOM (SuperDOM)","Carica la scala del simbolo del gruppo"],
      ["Tick Stream","Passa il proprio feed al simbolo del gruppo"],
    ] },
    { type: "paragraph",html: "Dispone fino a sei colori, quindi può gestire più di un gruppo collegato in un layout affollato, per esempio un gruppo verde per il Suo setup sugli indici e uno blu per l’energia. Il <strong class='text-white'>grigio</strong> è l’interruttore di spegnimento: un modulo sul grigio ignora ogni collegamento e mantiene il simbolo che Lei vi ha impostato a mano." },
    { type: "heading",text: "Colleghi i moduli per colore: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Apra i moduli che desidera sincronizzare", html: "Riunisca in un unico workspace i pannelli che desidera collegare. Un trio comune è un Market Analyzer, un grafico e un DOM, ma un Tick Stream funziona allo stesso modo. Aggiunga ogni modulo dal controllo per i nuovi moduli della piattaforma e lo posizioni nella finestra, in modo che siano tutti visibili.", image: {"src":`${IMG}/tradovate-link-modules-1.png`,"alt":"Workspace di Tradovate con un Market Analyzer, un grafico e un modulo DOM aperti insieme"} },
        { title: "Trovi il controllo del collegamento per colore", html: "Ogni modulo ha in alto una scheda con il nome dello strumento. Subito accanto a quel nome c’è un piccolo controllo colorato, il selettore del colore di collegamento. È lì che stabilisce a quale gruppo appartiene un modulo. È facile non notarlo perché è minuscolo, quindi guardi con attenzione accanto al simbolo nella barra del titolo del modulo.", image: {"src":`${IMG}/tradovate-link-modules-2.png`,"alt":"Menu a discesa del colore di collegamento accanto al nome dello strumento in alto in un modulo Tradovate"} },
        { title: "Assegni lo stesso colore a ogni modulo", html: "Apra il controllo del colore di collegamento nel Market Analyzer e scelga un colore, per esempio il verde. Poi apra lo stesso controllo nel grafico e lo imposti su verde, e faccia lo stesso con il DOM. I colori uguali mettono tutti e tre in un unico gruppo collegato. Lasci sul grigio ogni modulo che <em>non</em> vuole sincronizzare.", image: {"src":`${IMG}/tradovate-link-modules-3.png`,"alt":"Selezione dello stesso colore di collegamento per un Market Analyzer, un grafico e un DOM di Tradovate per raggrupparli"} },
        { title: "Guidi il cambio dal Market Analyzer", html: "Ora faccia clic su un simbolo diverso nel Market Analyzer verde. Il grafico verde, il DOM verde e ogni altro modulo verde passano subito a quel simbolo, senza dover riscrivere nulla. Questo è il vantaggio: costruisce la watchlist una sola volta e ogni pannello collegato la segue mentre scorre l’elenco.", image: {"src":`${IMG}/tradovate-link-modules-4.png`,"alt":"La scelta di un simbolo nel Market Analyzer di Tradovate aggiorna il grafico e il DOM collegati"} },
        { title: "Salvi il workspace", html: "Una volta impostati i colori come desidera, salvi il workspace. I colori di collegamento fanno parte del layout: salvando, l’intera configurazione sincronizzata verrà caricata esattamente così nella prossima sessione, invece di dover ricontrassegnare ogni modulo ogni mattina.", image: {"src":`${IMG}/tradovate-link-modules-5.png`,"alt":"Salvataggio di un workspace di Tradovate affinché i collegamenti per colore tornino nella prossima sessione"} },
      ],
    },
    { type: "heading",text: "I collegamenti non si sincronizzano? Parta dal Market Analyzer" },
    { type: "paragraph",html: "Il motivo abituale per cui un collegamento sembra rotto: si colorano un grafico e un DOM allo stesso modo aspettandosi che si guidino a vicenda. Da soli non lo fanno. Il cambio di simbolo parte dal Market Analyzer e si propaga verso l’esterno, quindi un gruppo ha bisogno di un Market Analyzer dello stesso colore che trasmetta il cambio. Ne aggiunga uno con lo stesso colore e la coppia inizierà a seguirlo." },
    { type: "paragraph",html: "Se continua a non funzionare, verifichi che nessun modulo sia tornato sul grigio e che ogni pannello abbia esattamente lo stesso colore. Tradovate modifica di tanto in tanto i dettagli della piattaforma, quindi confermi la posizione del controllo di collegamento nella Sua versione se qui appare diversa." },
    { type: "heading",text: "Automatizzi i trade quando il Suo layout è a punto" },
    { type: "paragraph",html: "Un layout collegato per colore Le permette di passare rapidamente da uno strumento all’altro mentre osserva. Ma serve comunque la Sua presenza alla scrivania per premere il grilletto. <strong class='text-white'>PickMyTrade colma questa lacuna</strong>: trasforma automaticamente i Suoi avvisi di TradingView in ordini reali su Tradovate, così il trade parte nel momento in cui scatta il Suo setup, anche quando è lontano dallo schermo." },
  ] },
  ctaHeading: { en: "Automate Your Tradovate Trades", de: "Automatisieren Sie Ihre Tradovate-Trades", es: "Automatice sus operaciones en Tradovate", fr: "Automatisez vos trades Tradovate", it: "Automatizzi i Suoi trade su Tradovate" },
  ctaText: { en: "A color-linked layout gets you flipping through instruments fast. Let PickMyTrade turn your TradingView alerts into live Tradovate orders automatically.", de: "Ein farbverknüpftes Layout lässt Sie schnell durch Instrumente schalten. Lassen Sie PickMyTrade Ihre TradingView-Alarme automatisch in echte Tradovate-Orders umwandeln.", es: "Un diseño vinculado por color le permite pasar rápidamente de un instrumento a otro. Deje que PickMyTrade convierta automáticamente sus alertas de TradingView en órdenes reales de Tradovate.", fr: "Une disposition liée par couleur vous permet de passer rapidement d’un instrument à l’autre. Laissez PickMyTrade transformer automatiquement vos alertes TradingView en ordres Tradovate réels.", it: "Un layout collegato per colore Le permette di passare rapidamente da uno strumento all’altro. Lasci che PickMyTrade trasformi automaticamente i Suoi avvisi di TradingView in ordini reali su Tradovate." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Kostenlose 7-Tage-Testversion starten", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "How many link colors does Tradovate have?", a: "Up to six, plus gray. The six colors let you run several independent linked groups on one layout; gray switches linking off for a module so it holds its own symbol." },
    { q: "Why don't my linked chart and DOM change together?", a: "A chart and a DOM on matching colors won't drive each other by themselves. The symbol change comes from the Market Analyzer, so add a Market Analyzer on the same color and select the symbol there. Confirm the current behavior in your own platform, since Tradovate tweaks this now and then." },
    { q: "Does color linking change my order routing?", a: "No. The link color only controls which symbol each module displays. It has no effect on where your orders route or on your account, it's purely a display-sync convenience." },
  ], de: [
    { q: "Wie viele Verknüpfungsfarben bietet Tradovate?", a: "Bis zu sechs, plus Grau. Mit den sechs Farben können Sie mehrere unabhängige verknüpfte Gruppen in einem Layout betreiben; Grau schaltet die Verknüpfung für ein Modul ab, sodass es sein eigenes Symbol behält." },
    { q: "Warum ändern sich mein verknüpftes Chart und mein DOM nicht gemeinsam?", a: "Ein Chart und ein DOM mit gleicher Farbe steuern sich nicht von selbst gegenseitig. Der Symbolwechsel geht vom Market Analyzer aus. Fügen Sie also einen Market Analyzer mit derselben Farbe hinzu und wählen Sie das Symbol dort aus. Prüfen Sie das aktuelle Verhalten in Ihrer eigenen Plattform, da Tradovate dies hin und wieder anpasst." },
    { q: "Ändert die Farbverknüpfung mein Order-Routing?", a: "Nein. Die Verknüpfungsfarbe steuert nur, welches Symbol jedes Modul anzeigt. Sie hat keinen Einfluss darauf, wohin Ihre Orders geroutet werden, und auch nicht auf Ihr Konto; es ist rein eine Komfortfunktion zur Anzeigesynchronisierung." },
  ], es: [
    { q: "¿Cuántos colores de vinculación tiene Tradovate?", a: "Hasta seis, más el gris. Los seis colores le permiten manejar varios grupos vinculados independientes en un mismo diseño; el gris desactiva la vinculación de un módulo para que conserve su propio símbolo." },
    { q: "¿Por qué mi gráfico y mi DOM vinculados no cambian juntos?", a: "Un gráfico y un DOM con el mismo color no se controlan entre sí por sí solos. El cambio de símbolo proviene del Market Analyzer, así que añada un Market Analyzer con el mismo color y seleccione el símbolo allí. Confirme el comportamiento actual en su propia plataforma, ya que Tradovate lo ajusta de vez en cuando." },
    { q: "¿La vinculación por color cambia el enrutamiento de mis órdenes?", a: "No. El color de vinculación solo controla qué símbolo muestra cada módulo. No afecta a dónde se enrutan sus órdenes ni a su cuenta; es simplemente una comodidad para sincronizar la visualización." },
  ], fr: [
    { q: "Combien de couleurs de liaison Tradovate propose-t-il ?", a: "Jusqu’à six, plus le gris. Les six couleurs vous permettent de gérer plusieurs groupes liés indépendants dans une même disposition ; le gris désactive la liaison d’un module pour qu’il conserve son propre symbole." },
    { q: "Pourquoi mon graphique et mon DOM liés ne changent-ils pas ensemble ?", a: "Un graphique et un DOM de même couleur ne se pilotent pas mutuellement d’eux-mêmes. Le changement de symbole provient du Market Analyzer : ajoutez donc un Market Analyzer de la même couleur et sélectionnez-y le symbole. Vérifiez le comportement actuel dans votre propre plateforme, car Tradovate l’ajuste de temps en temps." },
    { q: "La liaison par couleur modifie-t-elle le routage de mes ordres ?", a: "Non. La couleur de liaison contrôle uniquement le symbole affiché par chaque module. Elle n’a aucun effet sur le routage de vos ordres ni sur votre compte ; il s’agit uniquement d’une commodité de synchronisation de l’affichage." },
  ], it: [
    { q: "Quanti colori di collegamento ha Tradovate?", a: "Fino a sei, più il grigio. I sei colori Le permettono di gestire più gruppi collegati indipendenti in un unico layout; il grigio disattiva il collegamento per un modulo, che mantiene così il proprio simbolo." },
    { q: "Perché il mio grafico e il mio DOM collegati non cambiano insieme?", a: "Un grafico e un DOM con lo stesso colore non si controllano a vicenda da soli. Il cambio di simbolo parte dal Market Analyzer: aggiunga quindi un Market Analyzer dello stesso colore e selezioni lì il simbolo. Verifichi il comportamento attuale nella Sua piattaforma, poiché Tradovate lo modifica di tanto in tanto." },
    { q: "Il collegamento per colore modifica l’instradamento dei miei ordini?", a: "No. Il colore di collegamento controlla solo quale simbolo mostra ciascun modulo. Non ha alcun effetto su dove vengono instradati i Suoi ordini né sul Suo conto; è semplicemente una comodità per sincronizzare la visualizzazione." },
  ] },
  relatedHeading: { en: "Related Guides", de: "Verwandte Anleitungen", es: "Guías relacionadas", fr: "Guides associés", it: "Guide correlate" },
