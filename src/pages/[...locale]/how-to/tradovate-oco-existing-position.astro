---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-oco-existing-position";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Add OCO Brackets to an Open Position in the DOM";
const META_DESCRIPTION =
  "Attach a stop-loss and take-profit OCO bracket to an already-open futures position right from the DOM ladder, so one order cancels the other on a fill.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "OCO-Brackets zu einer offenen Position im DOM hinzufügen", es: "Añadir brackets OCO a una posición abierta en el DOM", fr: "Ajouter des brackets OCO à une position ouverte dans le DOM", it: "Aggiungere bracket OCO a una posizione aperta nel DOM" },
  dek: { en: "You clicked in fast and now you're sitting in a live position with no stop and no target. Here's exactly how to bolt a full OCO bracket onto that open position straight from the DOM, in two clicks.", de: "Sie haben schnell geklickt und sitzen jetzt in einer laufenden Position ohne Stop und ohne Ziel. So fügen Sie dieser offenen Position direkt im DOM mit zwei Klicks ein vollständiges OCO-Bracket hinzu.", es: "Hizo clic rápido y ahora tiene una posición abierta sin stop ni objetivo. Así se añade un bracket OCO completo a esa posición abierta directamente desde el DOM, en dos clics.", fr: "Vous avez cliqué vite et vous voilà dans une position active sans stop ni objectif. Voici comment greffer un bracket OCO complet sur cette position ouverte directement depuis le DOM, en deux clics.", it: "Ha cliccato in fretta e ora si ritrova in una posizione aperta senza stop né target. Ecco come applicare un bracket OCO completo a quella posizione aperta direttamente dal DOM, in due clic." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You clicked in fast, a market order off a setup, maybe a quick scalp, and now you're sitting in a live position with no stop and no target. Tradovate lets you bolt a full bracket onto that open position straight from the DOM, and it takes two clicks once you know where to look." },
    { type: "paragraph", html: "The tool for the job is a <strong class='text-white'>one-time OCO</strong>. OCO stands for <strong class='text-white'>One-Cancels-the-Other</strong>: you stage a take-profit and a stop-loss as a linked pair, and the moment one fills, Tradovate pulls the other off the book. No leftover order dangling after you've exited." },
    { type: "heading", text: "ATM Bracket vs. One-Time OCO" },
    { type: "paragraph", html: "Don't confuse the two. An ATM Strategy drops a stop and target in <em>automatically</em> the instant your entry fills, great when you plan the bracket before you enter. A <strong class='text-white'>one-time OCO</strong> is the manual version you place <em>after</em> the fact, on a position that's already open and unprotected. Same OCO linking under the hood; different moment in the trade. This guide covers that second case." },
    { type: "heading", text: "Attach an OCO Bracket to an Open Position: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open the DOM for Your Position's Contract", html: "Pull up the <strong class='text-white'>DOM (SuperDOM)</strong> for the exact contract you're holding, same symbol, same expiry. Your open position and its average price show right on the ladder, so you can see how far price has moved from your entry and where your stop and target should sit.", image: { src: `${IMG}/tradovate-oco-existing-position-1.png`, alt: "Tradovate SuperDOM showing an open futures position and its average price on the ladder" } },
        { title: 'Switch the ATM Dropdown to "OCO-one time"', html: "Look at the bottom of the DOM module for the <strong class='text-white'>ATM dropdown</strong>. Open it and select <strong class='text-white'>OCO-one time</strong>. That arms the ladder: the next two orders you click in will be joined into a single OCO pair instead of firing off as two independent orders. Nothing is submitted yet, you've just told Tradovate to link what comes next.", image: { src: `${IMG}/tradovate-oco-existing-position-2.png`, alt: "Tradovate DOM ATM dropdown menu open with the OCO-one time option selected" } },
        { title: "Drop Your Take-Profit on the Ladder", html: "On the DOM, a <strong class='text-white'>left-click sets a limit order</strong> and a <strong class='text-white'>right-click sets a stop</strong>. Start with your target. <strong class='text-white'>Left-click</strong> a price on the profit side of the ladder to stage a limit take-profit. You'll see a <strong class='text-white'>plus (+) in front of the quantity</strong>, that just means the order is suspended until you finish the pair." },
        { title: "Add Your Stop-Loss to Complete the Pair", html: "Now the stop. <strong class='text-white'>Right-click</strong> a price on the risk side, below the market for a long, above it for a short. This second click <strong class='text-white'>completes the OCO pair</strong>, so the plus signs clear and both orders go live and working. One thing to respect: these clicks have to run in order, <strong class='text-white'>OCO-one time, then order 1, then order 2</strong>. If you click somewhere else on the platform mid-sequence, the pairing breaks and you'll have to start the OCO over.", image: { src: `${IMG}/tradovate-oco-existing-position-4.png`, alt: "Trader right-clicking a price below the market on the Tradovate DOM to complete the OCO stop-loss" } },
        { title: "Confirm Both Legs Are Working", html: "Glance at the ladder and the <strong class='text-white'>Orders</strong> panel and confirm two things: the stop is on your risk side, the target is on your profit side, and both show as working. That's your position wrapped, if price runs to your target, the limit fills and the stop cancels; if it runs against you, the stop fills and the target cancels. Either way you're flat with nothing left dangling.", image: { src: `${IMG}/tradovate-oco-existing-position-5.png`, alt: "Tradovate DOM and Orders panel showing a linked OCO stop and target both working on an open position" } },
      ],
    },
    {
      type: "table",
      headers: ["Your position", "Take-profit (left-click, limit)", "Stop-loss (right-click, stop)"],
      rows: [
        ["Long (you'll sell to exit)", "Above the market, in the Ask column", "Below the market"],
        ["Short (you'll buy to exit)", "Below the market, in the Bid column", "Above the market"],
      ],
    },
    { type: "image", src: `${IMG}/tradovate-oco-existing-position-3.png`, alt: "Trader left-clicking a price above the market on the Tradovate DOM to stage a limit take-profit" },
    { type: "heading", text: "A Couple of Things Worth Knowing" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>A fill cancels the other leg, a manual cancel may not.</strong> The OCO link fires on a fill. In the web trader, if you manually cancel one side, the other order can stay working. If you're bailing on the whole bracket, double-check both legs are gone.",
        "<strong class='text-white'>Match the quantity to your position.</strong> Your stop and target should cover the number of contracts you hold, or you'll be left partly unprotected after a partial exit.",
        "<strong class='text-white'>Prop-firm accounts have their own rules.</strong> Some firms require a stop on every position and cap your size or contract count. Those limits vary by firm and account size, check your firm's current rules before you lean on any workflow.",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Clicking in an OCO by hand works fine, until the signal fires while you're away from the desk. <strong class='text-white'>PickMyTrade routes your TradingView alerts straight into Tradovate</strong> and sends the stop-loss and take-profit with every entry, so no position sits naked." },
  ], de: [
    { type: "paragraph",html: "Sie haben schnell geklickt, eine Market-Order auf ein Setup, vielleicht ein kurzer Scalp, und jetzt sitzen Sie in einer laufenden Position ohne Stop und ohne Ziel. Mit Tradovate können Sie direkt im DOM ein vollständiges Bracket an diese offene Position anhängen, und das geht mit zwei Klicks, sobald Sie wissen, wo Sie suchen müssen." },
    { type: "paragraph",html: "Das richtige Werkzeug dafür ist ein <strong class='text-white'>einmaliges OCO</strong>. OCO steht für <strong class='text-white'>One-Cancels-the-Other</strong> (eine Order storniert die andere): Sie legen Take-Profit und Stop-Loss als verknüpftes Paar an, und sobald eine der beiden ausgeführt wird, nimmt Tradovate die andere aus dem Orderbuch. Keine übrig gebliebene Order, die nach Ihrem Ausstieg noch herumhängt." },
    { type: "heading",text: "ATM-Bracket vs. einmaliges OCO" },
    { type: "paragraph",html: "Verwechseln Sie die beiden nicht. Eine ATM Strategy setzt Stop und Ziel <em>automatisch</em> in dem Moment, in dem Ihr Einstieg ausgeführt wird, ideal, wenn Sie das Bracket vor dem Einstieg planen. Ein <strong class='text-white'>einmaliges OCO</strong> ist die manuelle Variante, die Sie <em>nachträglich</em> auf einer bereits offenen, ungeschützten Position platzieren. Dieselbe OCO-Verknüpfung im Hintergrund, aber ein anderer Zeitpunkt im Trade. Dieser Leitfaden behandelt den zweiten Fall." },
    { type: "heading",text: "OCO-Bracket an eine offene Position anhängen: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Das DOM für den Kontrakt Ihrer Position öffnen", html: "Rufen Sie das <strong class='text-white'>DOM (SuperDOM)</strong> für genau den Kontrakt auf, den Sie halten, gleiches Symbol, gleicher Verfall. Ihre offene Position und ihr Durchschnittspreis erscheinen direkt auf der Preisleiter, sodass Sie sehen, wie weit sich der Kurs von Ihrem Einstieg entfernt hat und wo Stop und Ziel liegen sollten.", image: {"src":`${IMG}/tradovate-oco-existing-position-1.png`,"alt":"Tradovate SuperDOM mit einer offenen Futures-Position und ihrem Durchschnittspreis auf der Preisleiter"} },
        { title: "Das ATM-Dropdown auf „OCO-one time“ umstellen", html: "Suchen Sie am unteren Rand des DOM-Moduls das <strong class='text-white'>ATM-Dropdown</strong>. Öffnen Sie es und wählen Sie <strong class='text-white'>OCO-one time</strong>. Damit wird die Preisleiter scharf geschaltet: Die nächsten zwei Orders, die Sie anklicken, werden zu einem einzigen OCO-Paar verbunden, statt als zwei unabhängige Orders abgeschickt zu werden. Noch wird nichts übermittelt, Sie haben Tradovate lediglich angewiesen, das Nächste zu verknüpfen.", image: {"src":`${IMG}/tradovate-oco-existing-position-2.png`,"alt":"Geöffnetes ATM-Dropdown-Menü im Tradovate DOM mit ausgewählter Option OCO-one time"} },
        { title: "Ihr Take-Profit auf der Preisleiter platzieren", html: "Im DOM setzt ein <strong class='text-white'>Linksklick eine Limit-Order</strong> und ein <strong class='text-white'>Rechtsklick einen Stop</strong>. Beginnen Sie mit dem Ziel. <strong class='text-white'>Linksklicken</strong> Sie auf einen Preis auf der Gewinnseite der Preisleiter, um ein Limit-Take-Profit vorzubereiten. Vor der Menge sehen Sie ein <strong class='text-white'>Plus (+)</strong>, das bedeutet lediglich, dass die Order ausgesetzt ist, bis Sie das Paar vervollständigen." },
        { title: "Den Stop-Loss hinzufügen, um das Paar zu vervollständigen", html: "Jetzt der Stop. <strong class='text-white'>Rechtsklicken</strong> Sie auf einen Preis auf der Risikoseite, bei einer Long-Position unterhalb des Marktes, bei einer Short-Position darüber. Dieser zweite Klick <strong class='text-white'>vervollständigt das OCO-Paar</strong>, die Pluszeichen verschwinden und beide Orders werden aktiv und arbeiten. Eines ist zu beachten: Die Klicks müssen in der richtigen Reihenfolge erfolgen, <strong class='text-white'>OCO-one time, dann Order 1, dann Order 2</strong>. Wenn Sie mitten in der Abfolge irgendwo anders auf der Plattform klicken, bricht die Verknüpfung ab und Sie müssen das OCO von vorn beginnen.", image: {"src":`${IMG}/tradovate-oco-existing-position-4.png`,"alt":"Trader klickt mit der rechten Maustaste auf einen Preis unterhalb des Marktes im Tradovate DOM, um das OCO-Stop-Loss zu vervollständigen"} },
        { title: "Bestätigen, dass beide Seiten aktiv sind", html: "Prüfen Sie auf der Preisleiter und im <strong class='text-white'>Orders</strong>-Panel zwei Dinge: Der Stop liegt auf Ihrer Risikoseite, das Ziel auf Ihrer Gewinnseite, und beide werden als aktiv angezeigt. Damit ist Ihre Position abgesichert: Läuft der Kurs zu Ihrem Ziel, wird das Limit ausgeführt und der Stop storniert; läuft er gegen Sie, wird der Stop ausgeführt und das Ziel storniert. In beiden Fällen sind Sie flat und es bleibt nichts offen.", image: {"src":`${IMG}/tradovate-oco-existing-position-5.png`,"alt":"Tradovate DOM und Orders-Panel mit einem verknüpften OCO-Stop und -Ziel, beide aktiv, auf einer offenen Position"} },
      ],
    },
    { type: "table", headers: ["Ihre Position","Take-Profit (Linksklick, Limit)","Stop-Loss (Rechtsklick, Stop)"], rows: [
      ["Long (Sie verkaufen zum Ausstieg)","Oberhalb des Marktes, in der Ask-Spalte","Unterhalb des Marktes"],
      ["Short (Sie kaufen zum Ausstieg)","Unterhalb des Marktes, in der Bid-Spalte","Oberhalb des Marktes"],
    ] },
    { type: "image",src: `${IMG}/tradovate-oco-existing-position-3.png`,alt: "Trader klickt mit der linken Maustaste auf einen Preis oberhalb des Marktes im Tradovate DOM, um ein Limit-Take-Profit vorzubereiten" },
    { type: "heading",text: "Ein paar Dinge, die man wissen sollte" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Eine Ausführung storniert die andere Seite, eine manuelle Stornierung nicht unbedingt.</strong> Die OCO-Verknüpfung greift bei einer Ausführung. Wenn Sie im Web-Trader eine Seite manuell stornieren, kann die andere Order weiter aktiv bleiben. Wenn Sie das gesamte Bracket aufgeben, prüfen Sie, ob beide Seiten verschwunden sind.",
        "<strong class='text-white'>Passen Sie die Menge an Ihre Position an.</strong> Stop und Ziel sollten die Anzahl der gehaltenen Kontrakte abdecken, sonst bleiben Sie nach einem Teilausstieg teilweise ungeschützt.",
        "<strong class='text-white'>Prop-Firm-Konten haben eigene Regeln.</strong> Manche Firmen verlangen einen Stop für jede Position und begrenzen Ihre Größe oder Kontraktanzahl. Diese Limits unterscheiden sich je nach Firma und Kontogröße. Prüfen Sie die aktuellen Regeln Ihrer Firma, bevor Sie sich auf einen Ablauf verlassen.",
      ],
    },
    { type: "heading",text: "Automatisieren Sie das mit PickMyTrade" },
    { type: "paragraph",html: "Ein OCO von Hand anzuklicken funktioniert gut, bis das Signal auslöst, während Sie nicht am Platz sind. <strong class='text-white'>PickMyTrade leitet Ihre TradingView-Alerts direkt an Tradovate weiter</strong> und sendet mit jedem Einstieg Stop-Loss und Take-Profit mit, sodass keine Position ungeschützt bleibt." },
  ], es: [
    { type: "paragraph",html: "Hizo clic rápido, una orden de mercado sobre una configuración, quizá un scalp veloz, y ahora tiene una posición abierta sin stop ni objetivo. Tradovate le permite añadir un bracket completo a esa posición abierta directamente desde el DOM, y son solo dos clics cuando sabe dónde buscar." },
    { type: "paragraph",html: "La herramienta para esto es una <strong class='text-white'>OCO de un solo uso</strong>. OCO significa <strong class='text-white'>One-Cancels-the-Other</strong> (una cancela a la otra): usted prepara un take-profit y un stop-loss como un par vinculado, y en cuanto uno se ejecuta, Tradovate retira el otro del libro de órdenes. Sin órdenes sueltas colgando después de salir." },
    { type: "heading",text: "Bracket ATM frente a OCO de un solo uso" },
    { type: "paragraph",html: "No confunda ambos. Una ATM Strategy coloca un stop y un objetivo <em>automáticamente</em> en el instante en que se ejecuta su entrada, ideal cuando planifica el bracket antes de entrar. Una <strong class='text-white'>OCO de un solo uso</strong> es la versión manual que coloca <em>después</em>, sobre una posición que ya está abierta y sin protección. La misma vinculación OCO por debajo, pero en otro momento de la operación. Esta guía trata este segundo caso." },
    { type: "heading",text: "Adjuntar un bracket OCO a una posición abierta: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra el DOM del contrato de su posición", html: "Abra el <strong class='text-white'>DOM (SuperDOM)</strong> del contrato exacto que mantiene, mismo símbolo, mismo vencimiento. Su posición abierta y su precio promedio aparecen directamente en la escalera, de modo que puede ver cuánto se ha alejado el precio de su entrada y dónde deberían ir su stop y su objetivo.", image: {"src":`${IMG}/tradovate-oco-existing-position-1.png`,"alt":"SuperDOM de Tradovate mostrando una posición abierta de futuros y su precio promedio en la escalera"} },
        { title: "Cambie el desplegable ATM a «OCO-one time»", html: "Busque en la parte inferior del módulo DOM el <strong class='text-white'>desplegable ATM</strong>. Ábralo y seleccione <strong class='text-white'>OCO-one time</strong>. Con eso se arma la escalera: las dos órdenes siguientes que introduzca se unirán en un único par OCO, en lugar de enviarse como dos órdenes independientes. Todavía no se envía nada, solo le ha indicado a Tradovate que vincule lo que viene a continuación.", image: {"src":`${IMG}/tradovate-oco-existing-position-2.png`,"alt":"Menú desplegable ATM del DOM de Tradovate abierto con la opción OCO-one time seleccionada"} },
        { title: "Coloque su take-profit en la escalera", html: "En el DOM, un <strong class='text-white'>clic izquierdo coloca una orden límite</strong> y un <strong class='text-white'>clic derecho coloca un stop</strong>. Empiece por el objetivo. Haga <strong class='text-white'>clic izquierdo</strong> en un precio del lado de beneficio de la escalera para preparar un take-profit límite. Verá un <strong class='text-white'>signo más (+) delante de la cantidad</strong>, lo que solo significa que la orden está suspendida hasta que complete el par." },
        { title: "Añada su stop-loss para completar el par", html: "Ahora el stop. Haga <strong class='text-white'>clic derecho</strong> en un precio del lado del riesgo, por debajo del mercado en una posición larga y por encima en una corta. Este segundo clic <strong class='text-white'>completa el par OCO</strong>, los signos más desaparecen y ambas órdenes quedan activas y trabajando. Una cosa que debe respetar: los clics deben seguir un orden, <strong class='text-white'>OCO-one time, luego orden 1, luego orden 2</strong>. Si hace clic en otro lugar de la plataforma a mitad de la secuencia, la vinculación se rompe y tendrá que empezar la OCO de nuevo.", image: {"src":`${IMG}/tradovate-oco-existing-position-4.png`,"alt":"Operador haciendo clic derecho en un precio por debajo del mercado en el DOM de Tradovate para completar el stop-loss de la OCO"} },
        { title: "Confirme que ambos lados están activos", html: "Revise la escalera y el panel <strong class='text-white'>Orders</strong> y confirme dos cosas: el stop está en su lado de riesgo, el objetivo en su lado de beneficio, y ambos figuran como activos. Con eso su posición queda cubierta: si el precio llega a su objetivo, se ejecuta el límite y se cancela el stop; si va en su contra, se ejecuta el stop y se cancela el objetivo. En ambos casos queda plano y sin nada pendiente.", image: {"src":`${IMG}/tradovate-oco-existing-position-5.png`,"alt":"DOM y panel Orders de Tradovate mostrando un stop y un objetivo OCO vinculados, ambos activos, sobre una posición abierta"} },
      ],
    },
    { type: "table", headers: ["Su posición","Take-profit (clic izquierdo, límite)","Stop-loss (clic derecho, stop)"], rows: [
      ["Larga (venderá para salir)","Por encima del mercado, en la columna Ask","Por debajo del mercado"],
      ["Corta (comprará para salir)","Por debajo del mercado, en la columna Bid","Por encima del mercado"],
    ] },
    { type: "image",src: `${IMG}/tradovate-oco-existing-position-3.png`,alt: "Operador haciendo clic izquierdo en un precio por encima del mercado en el DOM de Tradovate para preparar un take-profit límite" },
    { type: "heading",text: "Un par de cosas que conviene saber" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Una ejecución cancela el otro lado, una cancelación manual quizá no.</strong> El vínculo OCO se activa con una ejecución. En el web trader, si cancela manualmente un lado, la otra orden puede seguir activa. Si abandona todo el bracket, compruebe que ambos lados han desaparecido.",
        "<strong class='text-white'>Ajuste la cantidad a su posición.</strong> Su stop y su objetivo deben cubrir el número de contratos que mantiene, o quedará parcialmente desprotegido tras una salida parcial.",
        "<strong class='text-white'>Las cuentas de prop firm tienen sus propias reglas.</strong> Algunas firmas exigen un stop en cada posición y limitan su tamaño o número de contratos. Esos límites varían según la firma y el tamaño de la cuenta; consulte las reglas vigentes de su firma antes de apoyarse en cualquier flujo de trabajo.",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Colocar una OCO a mano funciona bien, hasta que la señal salta mientras está lejos de la pantalla. <strong class='text-white'>PickMyTrade envía sus alertas de TradingView directamente a Tradovate</strong> y manda el stop-loss y el take-profit con cada entrada, para que ninguna posición quede desprotegida." },
  ], fr: [
    { type: "paragraph",html: "Vous avez cliqué vite, un ordre au marché sur un setup, peut-être un scalp rapide, et vous voilà dans une position active sans stop ni objectif. Tradovate vous permet de greffer un bracket complet sur cette position ouverte directement depuis le DOM, et cela prend deux clics une fois que vous savez où regarder." },
    { type: "paragraph",html: "L'outil adapté est un <strong class='text-white'>OCO à usage unique</strong>. OCO signifie <strong class='text-white'>One-Cancels-the-Other</strong> (l'un annule l'autre) : vous placez un take-profit et un stop-loss sous forme de paire liée, et dès que l'un est exécuté, Tradovate retire l'autre du carnet. Aucun ordre résiduel ne traîne une fois que vous êtes sorti." },
    { type: "heading",text: "Bracket ATM ou OCO à usage unique" },
    { type: "paragraph",html: "Ne confondez pas les deux. Une ATM Strategy place un stop et un objectif <em>automatiquement</em> à l'instant où votre entrée est exécutée, idéal quand vous planifiez le bracket avant d'entrer. Un <strong class='text-white'>OCO à usage unique</strong> est la version manuelle que vous placez <em>après coup</em>, sur une position déjà ouverte et non protégée. Même association OCO en coulisses ; autre moment dans le trade. Ce guide traite ce second cas." },
    { type: "heading",text: "Attacher un bracket OCO à une position ouverte : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir le DOM du contrat de votre position", html: "Ouvrez le <strong class='text-white'>DOM (SuperDOM)</strong> du contrat exact que vous détenez, même symbole, même échéance. Votre position ouverte et son prix moyen s'affichent directement sur l'échelle, ce qui vous permet de voir de combien le prix s'est éloigné de votre entrée et où placer votre stop et votre objectif.", image: {"src":`${IMG}/tradovate-oco-existing-position-1.png`,"alt":"SuperDOM Tradovate affichant une position ouverte sur contrats à terme et son prix moyen sur l'échelle"} },
        { title: "Basculer la liste déroulante ATM sur « OCO-one time »", html: "Repérez en bas du module DOM la <strong class='text-white'>liste déroulante ATM</strong>. Ouvrez-la et sélectionnez <strong class='text-white'>OCO-one time</strong>. Cela arme l'échelle : les deux ordres suivants que vous saisirez seront réunis en une seule paire OCO au lieu de partir comme deux ordres indépendants. Rien n'est encore envoyé, vous avez simplement indiqué à Tradovate de lier ce qui suit.", image: {"src":`${IMG}/tradovate-oco-existing-position-2.png`,"alt":"Menu déroulant ATM du DOM Tradovate ouvert avec l'option OCO-one time sélectionnée"} },
        { title: "Placer votre take-profit sur l'échelle", html: "Dans le DOM, un <strong class='text-white'>clic gauche place un ordre à cours limité</strong> et un <strong class='text-white'>clic droit place un stop</strong>. Commencez par l'objectif. Faites un <strong class='text-white'>clic gauche</strong> sur un prix du côté profit de l'échelle pour préparer un take-profit à cours limité. Vous verrez un <strong class='text-white'>plus (+) devant la quantité</strong>, ce qui signifie simplement que l'ordre est suspendu jusqu'à ce que vous complétiez la paire." },
        { title: "Ajouter votre stop-loss pour compléter la paire", html: "Place au stop. Faites un <strong class='text-white'>clic droit</strong> sur un prix du côté risque, sous le marché pour une position longue, au-dessus pour une position courte. Ce second clic <strong class='text-white'>complète la paire OCO</strong>, les signes plus disparaissent et les deux ordres deviennent actifs. Un point à respecter : ces clics doivent suivre un ordre précis, <strong class='text-white'>OCO-one time, puis ordre 1, puis ordre 2</strong>. Si vous cliquez ailleurs sur la plateforme en cours de séquence, l'association se rompt et vous devrez recommencer l'OCO.", image: {"src":`${IMG}/tradovate-oco-existing-position-4.png`,"alt":"Trader faisant un clic droit sur un prix sous le marché dans le DOM Tradovate pour compléter le stop-loss de l'OCO"} },
        { title: "Vérifier que les deux jambes sont actives", html: "Jetez un œil à l'échelle et au panneau <strong class='text-white'>Orders</strong> et vérifiez deux choses : le stop est du côté risque, l'objectif du côté profit, et les deux apparaissent comme actifs. Votre position est alors protégée : si le prix atteint votre objectif, l'ordre à cours limité est exécuté et le stop est annulé ; s'il va contre vous, le stop est exécuté et l'objectif est annulé. Dans les deux cas, vous êtes à plat sans rien qui traîne.", image: {"src":`${IMG}/tradovate-oco-existing-position-5.png`,"alt":"DOM et panneau Orders de Tradovate montrant un stop et un objectif OCO liés, tous deux actifs, sur une position ouverte"} },
      ],
    },
    { type: "table", headers: ["Votre position","Take-profit (clic gauche, ordre à cours limité)","Stop-loss (clic droit, stop)"], rows: [
      ["Longue (vous vendrez pour sortir)","Au-dessus du marché, dans la colonne Ask","Sous le marché"],
      ["Courte (vous achèterez pour sortir)","Sous le marché, dans la colonne Bid","Au-dessus du marché"],
