---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-per-side-round-trip";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Tradovate Commissions: Per Side vs Round Turn";
const META_DESCRIPTION =
  "Tradovate commissions are quoted per side, so a full round-turn trade costs double. Learn to calculate your real cost, plus exchange and NFA fees.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate-Kommissionen: Pro Seite vs. Round Turn", es: "Comisiones de Tradovate: por lado vs. ida y vuelta", fr: "Commissions Tradovate : par côté vs aller-retour", it: "Commissioni Tradovate: per lato vs round turn" },
  dek: { en: "The number Tradovate shows you is per side, not per trade. A completed trade touches the market twice, so your real commission is double the quoted rate. Here's how to calculate your true cost.", de: "Die Zahl, die Tradovate Ihnen anzeigt, gilt pro Seite, nicht pro Trade. Ein abgeschlossener Trade berührt den Markt zweimal, Ihre tatsächliche Kommission ist also doppelt so hoch wie der genannte Satz. So berechnen Sie Ihre wahren Kosten.", es: "La cifra que Tradovate le muestra es por lado, no por operación. Una operación completada toca el mercado dos veces, así que su comisión real es el doble de la tarifa indicada. Así se calcula su coste real.", fr: "Le chiffre que Tradovate vous affiche est par côté, pas par trade. Un trade terminé touche le marché deux fois : votre commission réelle est donc le double du tarif indiqué. Voici comment calculer votre coût réel.", it: "Il numero che Tradovate le mostra è per lato, non per operazione. Un’operazione completata tocca il mercato due volte, quindi la sua commissione reale è il doppio della tariffa indicata. Ecco come calcolare il suo costo reale." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "The number Tradovate shows you is <strong class='text-white'>per side</strong>, not per trade. That one word trips up almost everyone coming to futures from stocks. When you see $1.29 or $0.39 next to a contract, that's what you pay each time an order fills, once when you get in, once when you get out. A completed trade touches the market twice, so your commission is double the quoted rate." },
    { type: "quote", html: "<strong class='text-white'>The short version:</strong> Per side = one fill (an entry <em>or</em> an exit). Round turn = both fills. So your commission on a finished trade is the quoted rate &times; 2." },
    { type: "heading", text: 'What "Per Side" Actually Means' },
    { type: "paragraph", html: "Every fill is a side. Buy to open is one side. Sell to close is another. Tradovate bills commission per side because you won't always open and close in a single click, you might scale into a position over three fills and scale out over two. Charging per side keeps the math honest: you pay for exactly the fills you take." },
    { type: "paragraph", html: '"Round turn" (some people say round trip) is trader shorthand for a full trade: in and back out. Because that\'s two sides, the commission is simply the per-side rate times two. There\'s no hidden bulk discount and no penalty, it\'s just the same number, counted twice.' },
    { type: "heading", text: "Per Side vs Round Turn, Side by Side" },
    { type: "paragraph", html: "Here's how the current per-side rates translate into round-turn commission across Tradovate's plans. These figures are commission only, exchange, clearing, and NFA fees are separate (more on that below)." },
    {
      type: "table",
      headers: ["Plan", "Micro, per side", "Micro, round turn", "Standard, per side", "Standard, round turn"],
      rows: [
        ["Free", "$0.39", "$0.78", "$1.29", "$2.58"],
        ["Monthly", "$0.29", "$0.58", "$0.99", "$1.98"],
        ["Lifetime", "$0.09", "$0.18", "$0.59", "$1.18"],
      ],
    },
    { type: "paragraph", html: "Rates change over time and depend on which plan you're on, so treat these as a worked example rather than a live quote." },
    { type: "heading", text: "How to Work Out Your True Round-Turn Cost" },
    {
      type: "steps",
      items: [
        { title: "Find Your Per-Side Commission Rate", html: "Start with the per-side number for your plan and the contract you trade. A micro on the Free plan is $0.39 per side; a standard e-mini is $1.29. Your plan sets the rate, and the pricing table always labels it as commission per side, that's your building block." },
        { title: "Double It for a Full Round Turn", html: "Multiply that per-side rate by two. One fill opens the position, a second fill closes it, and each fill is billed. So $1.29 per side becomes $2.58 to open and close a standard contract; $0.39 per side becomes $0.78 on a micro. If you check your fills after a completed trade, you'll see the commission line hit twice, once on entry, once on exit." },
        { title: "Add Exchange, Clearing, and NFA Fees", html: "Commission isn't the whole bill. Every futures trade also carries exchange fees, clearing fees, and a small NFA fee. Those aren't Tradovate's cut, they're set by the exchange and regulators, and like commission, they're charged on each side. Add them to your doubled commission and you've got your true all-in round-turn cost." },
      ],
    },
    { type: "heading", text: "Don't Let the Extra Fees Surprise You" },
    { type: "paragraph", html: "Because the exchange and regulatory fees also apply per side, they roughly double on a round turn too. On micros they're small; on ES or NQ they add up to a bit more than a dollar per completed trade on top of commission. None of that is optional or waived by any plan tier. It's worth checking your account statement once so you know your real cost per trade rather than the sticker number." },
    { type: "paragraph", html: "One more thing if you trade a funded or evaluation account: prop firms set their own commission schedules on top of (or in place of) Tradovate's retail rates. Those vary by firm and account size, so check your firm's current rules rather than assuming the numbers above apply." },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Trading a strategy where every tick of cost matters? <strong class='text-white'>Automate your TradingView signals into Tradovate with PickMyTrade</strong> so entries and exits fire exactly as planned, no fat-finger extra fills padding your commission." },
  ], de: [
    { type: "paragraph",html: "Die Zahl, die Tradovate Ihnen anzeigt, gilt <strong class='text-white'>pro Seite</strong>, nicht pro Trade. Dieses eine Wort bringt fast jeden durcheinander, der von Aktien zu Futures kommt. Wenn Sie $1.29 oder $0.39 neben einem Kontrakt sehen, ist das der Betrag, den Sie bei jeder Ausführung einer Order zahlen: einmal beim Einstieg, einmal beim Ausstieg. Ein abgeschlossener Trade berührt den Markt zweimal, Ihre Kommission ist also doppelt so hoch wie der genannte Satz." },
    { type: "quote",html: "<strong class='text-white'>Die Kurzfassung:</strong> Pro Seite = eine Ausführung (ein Einstieg <em>oder</em> ein Ausstieg). Round Turn = beide Ausführungen. Ihre Kommission für einen abgeschlossenen Trade ist also der genannte Satz &times; 2." },
    { type: "heading",text: "Was „pro Seite“ tatsächlich bedeutet" },
    { type: "paragraph",html: "Jede Ausführung ist eine Seite. Kaufen zum Eröffnen ist eine Seite. Verkaufen zum Schließen ist eine andere. Tradovate berechnet die Kommission pro Seite, weil Sie nicht immer mit einem einzigen Klick öffnen und schließen: Sie könnten in drei Ausführungen aufstocken und in zwei wieder abbauen. Die Berechnung pro Seite hält die Rechnung ehrlich: Sie zahlen genau für die Ausführungen, die Sie nehmen." },
    { type: "paragraph",html: "„Round Turn“ (manche sagen auch Round Trip) ist die Händlerkurzform für einen vollständigen Trade: hinein und wieder heraus. Da das zwei Seiten sind, ist die Kommission einfach der Satz pro Seite mal zwei. Es gibt keinen versteckten Mengenrabatt und keine Strafe, es ist schlicht dieselbe Zahl, doppelt gezählt." },
    { type: "heading",text: "Pro Seite vs. Round Turn im direkten Vergleich" },
    { type: "paragraph",html: "So lassen sich die aktuellen Sätze pro Seite in die Round-Turn-Kommission über die Tarife von Tradovate übertragen. Diese Beträge sind reine Kommission; Börsen-, Clearing- und NFA-Gebühren kommen separat hinzu (mehr dazu weiter unten)." },
    { type: "table", headers: ["Tarif","Micro, pro Seite","Micro, Round Turn","Standard, pro Seite","Standard, Round Turn"], rows: [
      ["Free","$0.39","$0.78","$1.29","$2.58"],
      ["Monthly","$0.29","$0.58","$0.99","$1.98"],
      ["Lifetime","$0.09","$0.18","$0.59","$1.18"],
    ] },
    { type: "paragraph",html: "Die Sätze ändern sich im Laufe der Zeit und hängen von Ihrem Tarif ab. Betrachten Sie sie daher als durchgerechnetes Beispiel und nicht als aktuelles Angebot." },
    { type: "heading",text: "So ermitteln Sie Ihre tatsächlichen Round-Turn-Kosten" },
    {
      type: "steps",
      items: [
        { title: "Ihren Kommissionssatz pro Seite ermitteln", html: "Beginnen Sie mit dem Wert pro Seite für Ihren Tarif und den Kontrakt, den Sie handeln. Ein Micro im Free-Tarif kostet $0.39 pro Seite, ein Standard-E-Mini $1.29. Ihr Tarif legt den Satz fest, und die Preistabelle weist ihn stets als Kommission pro Seite aus. Das ist Ihr Baustein." },
        { title: "Für einen vollständigen Round Turn verdoppeln", html: "Multiplizieren Sie diesen Satz pro Seite mit zwei. Eine Ausführung eröffnet die Position, eine zweite schließt sie, und jede Ausführung wird berechnet. Aus $1.29 pro Seite werden also $2.58 für das Eröffnen und Schließen eines Standardkontrakts, aus $0.39 pro Seite werden $0.78 bei einem Micro. Wenn Sie nach einem abgeschlossenen Trade Ihre Ausführungen prüfen, sehen Sie die Kommissionszeile zweimal auftauchen, einmal beim Einstieg, einmal beim Ausstieg." },
        { title: "Börsen-, Clearing- und NFA-Gebühren hinzufügen", html: "Die Kommission ist nicht die ganze Rechnung. Jeder Futures-Trade enthält zudem Börsengebühren, Clearing-Gebühren und eine kleine NFA-Gebühr. Diese gehen nicht an Tradovate, sondern werden von der Börse und den Aufsichtsbehörden festgelegt und wie die Kommission auf jeder Seite berechnet. Addieren Sie sie zu Ihrer verdoppelten Kommission, und Sie haben Ihre tatsächlichen Gesamtkosten pro Round Turn." },
      ],
    },
    { type: "heading",text: "Lassen Sie sich von den zusätzlichen Gebühren nicht überraschen" },
    { type: "paragraph",html: "Da die Börsen- und Aufsichtsgebühren ebenfalls pro Seite anfallen, verdoppeln auch sie sich ungefähr bei einem Round Turn. Bei Micros sind sie klein; bei ES oder NQ summieren sie sich zu etwas mehr als einem Dollar pro abgeschlossenem Trade zusätzlich zur Kommission. Nichts davon ist optional oder wird durch irgendeinen Tarif erlassen. Es lohnt sich, einmal Ihren Kontoauszug zu prüfen, damit Sie Ihre echten Kosten pro Trade kennen statt der Zahl auf dem Preisschild." },
    { type: "paragraph",html: "Noch ein Hinweis, falls Sie ein Funded- oder Evaluierungskonto handeln: Prop-Firmen legen eigene Kommissionstabellen fest, zusätzlich zu den Retail-Sätzen von Tradovate oder an deren Stelle. Diese variieren je nach Firma und Kontogröße. Prüfen Sie daher die aktuellen Regeln Ihrer Firma, statt anzunehmen, dass die obigen Zahlen gelten." },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "Handeln Sie eine Strategie, bei der jeder Tick an Kosten zählt? <strong class='text-white'>Automatisieren Sie Ihre TradingView-Signale mit PickMyTrade in Tradovate</strong>, damit Einstiege und Ausstiege genau wie geplant ausgelöst werden, ohne Vertipper-Ausführungen, die Ihre Kommission aufblähen." },
  ], es: [
    { type: "paragraph",html: "La cifra que Tradovate le muestra es <strong class='text-white'>por lado</strong>, no por operación. Esa palabra confunde a casi todos los que llegan a los futuros desde las acciones. Cuando ve $1.29 o $0.39 junto a un contrato, es lo que paga cada vez que se ejecuta una orden: una vez al entrar y otra al salir. Una operación completada toca el mercado dos veces, así que su comisión es el doble de la tarifa indicada." },
    { type: "quote",html: "<strong class='text-white'>La versión corta:</strong> por lado = una ejecución (una entrada <em>o</em> una salida). Ida y vuelta (round turn) = ambas ejecuciones. Así, su comisión en una operación completada es la tarifa indicada &times; 2." },
    { type: "heading",text: "Qué significa realmente “por lado”" },
    { type: "paragraph",html: "Cada ejecución es un lado. Comprar para abrir es un lado. Vender para cerrar es otro. Tradovate cobra la comisión por lado porque no siempre abre y cierra con un solo clic: puede escalar una posición en tres ejecuciones y reducirla en dos. Cobrar por lado mantiene las cuentas claras: usted paga exactamente por las ejecuciones que realiza." },
    { type: "paragraph",html: "“Ida y vuelta” (round turn, o round trip) es la forma abreviada que usan los traders para una operación completa: entrar y volver a salir. Como son dos lados, la comisión es simplemente la tarifa por lado multiplicada por dos. No hay descuento oculto por volumen ni penalización; es el mismo número, contado dos veces." },
    { type: "heading",text: "Por lado frente a ida y vuelta, cara a cara" },
    { type: "paragraph",html: "Así se traducen las tarifas actuales por lado en comisión de ida y vuelta en los distintos planes de Tradovate. Estas cifras son solo comisión; las tarifas de bolsa, compensación y NFA son aparte (más información abajo)." },
    { type: "table", headers: ["Plan","Micro, por lado","Micro, ida y vuelta","Estándar, por lado","Estándar, ida y vuelta"], rows: [
      ["Free","$0.39","$0.78","$1.29","$2.58"],
      ["Monthly","$0.29","$0.58","$0.99","$1.98"],
      ["Lifetime","$0.09","$0.18","$0.59","$1.18"],
    ] },
    { type: "paragraph",html: "Las tarifas cambian con el tiempo y dependen del plan en el que esté, así que tómelas como un ejemplo práctico y no como una cotización en vivo." },
    { type: "heading",text: "Cómo calcular su coste real de ida y vuelta" },
    {
      type: "steps",
      items: [
        { title: "Encuentre su comisión por lado", html: "Empiece con la cifra por lado de su plan y del contrato que opera. Un micro en el plan Free cuesta $0.39 por lado; un e-mini estándar, $1.29. Su plan fija la tarifa, y la tabla de precios siempre la indica como comisión por lado: ese es su punto de partida." },
        { title: "Duplíquela para una ida y vuelta completa", html: "Multiplique esa tarifa por lado por dos. Una ejecución abre la posición, una segunda la cierra, y cada ejecución se cobra. Así, $1.29 por lado se convierten en $2.58 por abrir y cerrar un contrato estándar; $0.39 por lado pasan a ser $0.78 en un micro. Si revisa sus ejecuciones tras una operación completada, verá la línea de comisión aparecer dos veces: una en la entrada y otra en la salida." },
        { title: "Añada las tarifas de bolsa, compensación y NFA", html: "La comisión no es toda la factura. Cada operación de futuros también lleva tarifas de bolsa, de compensación y una pequeña tarifa de la NFA. No son la parte de Tradovate: las fijan la bolsa y los reguladores y, como la comisión, se cobran en cada lado. Súmelas a su comisión duplicada y tendrá su coste total real de ida y vuelta." },
      ],
    },
    { type: "heading",text: "No deje que las tarifas adicionales le sorprendan" },
    { type: "paragraph",html: "Como las tarifas de bolsa y regulatorias también se aplican por lado, aproximadamente se duplican en una ida y vuelta. En micros son pequeñas; en ES o NQ suman algo más de un dólar por operación completada, además de la comisión. Ninguna de ellas es opcional ni se elimina en ningún nivel de plan. Merece la pena revisar su extracto de cuenta una vez para conocer su coste real por operación y no la cifra del cartel." },
    { type: "paragraph",html: "Una cosa más si opera una cuenta fondeada o de evaluación: las prop firms fijan sus propios calendarios de comisiones además de las tarifas minoristas de Tradovate, o en lugar de ellas. Varían según la firma y el tamaño de la cuenta, así que compruebe las reglas vigentes de su firma en lugar de suponer que se aplican las cifras anteriores." },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "¿Opera una estrategia en la que cada tick de coste importa? <strong class='text-white'>Automatice sus señales de TradingView hacia Tradovate con PickMyTrade</strong> para que las entradas y salidas se disparen exactamente como se planeó, sin ejecuciones extra por error de dedo que engorden su comisión." },
  ], fr: [
    { type: "paragraph",html: "Le chiffre que Tradovate vous affiche est <strong class='text-white'>par côté</strong>, pas par trade. Ce seul mot déroute presque tout le monde en venant des actions vers les contrats à terme. Quand vous voyez $1.29 ou $0.39 à côté d’un contrat, c’est ce que vous payez à chaque exécution d’un ordre : une fois à l’entrée, une fois à la sortie. Un trade terminé touche le marché deux fois, votre commission est donc le double du tarif indiqué." },
    { type: "quote",html: "<strong class='text-white'>En bref :</strong> par côté = une exécution (une entrée <em>ou</em> une sortie). Aller-retour (round turn) = les deux exécutions. La commission sur un trade terminé est donc le tarif indiqué &times; 2." },
    { type: "heading",text: "Ce que « par côté » signifie réellement" },
    { type: "paragraph",html: "Chaque exécution est un côté. Acheter pour ouvrir est un côté. Vendre pour clôturer en est un autre. Tradovate facture la commission par côté parce que vous n’ouvrez et ne clôturez pas toujours en un seul clic : vous pouvez renforcer une position en trois exécutions et la réduire en deux. Facturer par côté garde le calcul honnête : vous payez exactement les exécutions que vous prenez." },
    { type: "paragraph",html: "« Aller-retour » (round turn, ou round trip) est le raccourci des traders pour un trade complet : entrer puis ressortir. Comme cela fait deux côtés, la commission est simplement le tarif par côté multiplié par deux. Il n’y a ni remise cachée sur le volume ni pénalité : c’est le même chiffre, compté deux fois." },
    { type: "heading",text: "Par côté et aller-retour, côte à côte" },
    { type: "paragraph",html: "Voici comment les tarifs actuels par côté se traduisent en commission aller-retour selon les forfaits de Tradovate. Ces chiffres ne comprennent que la commission ; les frais de bourse, de compensation et de la NFA sont séparés (plus de détails ci-dessous)." },
    { type: "table", headers: ["Forfait","Micro, par côté","Micro, aller-retour","Standard, par côté","Standard, aller-retour"], rows: [
      ["Free","$0.39","$0.78","$1.29","$2.58"],
      ["Monthly","$0.29","$0.58","$0.99","$1.98"],
      ["Lifetime","$0.09","$0.18","$0.59","$1.18"],
    ] },
    { type: "paragraph",html: "Les tarifs évoluent avec le temps et dépendent du forfait dont vous disposez ; considérez-les donc comme un exemple chiffré et non comme une cotation en direct." },
    { type: "heading",text: "Comment calculer votre coût réel aller-retour" },
    {
      type: "steps",
      items: [
        { title: "Trouver votre commission par côté", html: "Partez du chiffre par côté de votre forfait et du contrat que vous tradez. Un micro sur le forfait Free coûte $0.39 par côté ; un e-mini standard, $1.29. Votre forfait fixe le tarif, et la grille tarifaire l’indique toujours comme commission par côté : c’est votre point de départ." },
        { title: "La doubler pour un aller-retour complet", html: "Multipliez ce tarif par côté par deux. Une exécution ouvre la position, une seconde la clôture, et chaque exécution est facturée. Ainsi, $1.29 par côté devient $2.58 pour ouvrir et clôturer un contrat standard ; $0.39 par côté devient $0.78 sur un micro. Si vous vérifiez vos exécutions après un trade terminé, vous verrez la ligne de commission apparaître deux fois, une à l’entrée, une à la sortie." },
        { title: "Ajouter les frais de bourse, de compensation et de la NFA", html: "La commission ne fait pas toute la facture. Chaque trade sur contrats à terme comporte aussi des frais de bourse, des frais de compensation et de petits frais de la NFA. Ce n’est pas la part de Tradovate : ils sont fixés par la bourse et les régulateurs et, comme la commission, facturés de chaque côté. Ajoutez-les à votre commission doublée et vous obtenez votre coût complet réel aller-retour." },
      ],
    },
    { type: "heading",text: "Ne vous laissez pas surprendre par les frais supplémentaires" },
    { type: "paragraph",html: "Comme les frais de bourse et de régulation s’appliquent aussi par côté, ils doublent à peu près sur un aller-retour. Sur les micros, ils sont faibles ; sur ES ou NQ, ils représentent un peu plus d’un dollar par trade terminé en plus de la commission. Rien de cela n’est facultatif ni supprimé par un niveau de forfait. Il vaut la peine de consulter une fois votre relevé de compte pour connaître votre coût réel par trade plutôt que le chiffre affiché." },
    { type: "paragraph",html: "Une dernière chose si vous tradez un compte financé ou d’évaluation : les prop firms fixent leurs propres grilles de commissions en plus des tarifs de détail de Tradovate, ou à leur place. Elles varient selon la firme et la taille du compte ; vérifiez donc les règles en vigueur de votre firme plutôt que de supposer que les chiffres ci-dessus s’appliquent." },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Vous tradez une stratégie où chaque tick de coût compte ? <strong class='text-white'>Automatisez vos signaux TradingView vers Tradovate avec PickMyTrade</strong> pour que vos entrées et sorties se déclenchent exactement comme prévu, sans exécutions supplémentaires dues à une erreur de saisie qui gonflent votre commission." },
  ], it: [
    { type: "paragraph",html: "Il numero che Tradovate le mostra è <strong class='text-white'>per lato</strong>, non per operazione. Questa sola parola confonde quasi tutti quelli che arrivano ai futures dalle azioni. Quando vede $1.29 o $0.39 accanto a un contratto, è ciò che paga ogni volta che un ordine viene eseguito: una volta quando entra, una volta quando esce. Un’operazione completata tocca il mercato due volte, quindi la sua commissione è il doppio della tariffa indicata." },
    { type: "quote",html: "<strong class='text-white'>In breve:</strong> per lato = un’esecuzione (un ingresso <em>o</em> un’uscita). Round turn = entrambe le esecuzioni. Quindi la commissione su un’operazione conclusa è la tariffa indicata &times; 2." },
    { type: "heading",text: "Cosa significa davvero “per lato”" },
    { type: "paragraph",html: "Ogni esecuzione è un lato. Acquistare per aprire è un lato. Vendere per chiudere è un altro. Tradovate addebita la commissione per lato perché non sempre apre e chiude con un solo clic: può incrementare una posizione in tre esecuzioni e ridurla in due. Addebitare per lato rende il conto onesto: paga esattamente le esecuzioni che effettua." },
    { type: "paragraph",html: "“Round turn” (qualcuno dice round trip) è la scorciatoia dei trader per un’operazione completa: dentro e di nuovo fuori. Poiché sono due lati, la commissione è semplicemente la tariffa per lato moltiplicata per due. Non c’è alcuno sconto nascosto sui volumi né penale: è lo stesso numero, contato due volte." },
    { type: "heading",text: "Per lato e round turn a confronto" },
    { type: "paragraph",html: "Ecco come le attuali tariffe per lato si traducono in commissione round turn nei piani di Tradovate. Queste cifre sono solo commissioni; le tariffe di borsa, di clearing e della NFA sono separate (maggiori dettagli più sotto)." },
    { type: "table", headers: ["Piano","Micro, per lato","Micro, round turn","Standard, per lato","Standard, round turn"], rows: [
      ["Free","$0.39","$0.78","$1.29","$2.58"],
      ["Monthly","$0.29","$0.58","$0.99","$1.98"],
      ["Lifetime","$0.09","$0.18","$0.59","$1.18"],
    ] },
    { type: "paragraph",html: "Le tariffe cambiano nel tempo e dipendono dal piano in cui si trova, quindi le consideri un esempio pratico e non una quotazione in tempo reale." },
    { type: "heading",text: "Come calcolare il suo costo reale round turn" },
