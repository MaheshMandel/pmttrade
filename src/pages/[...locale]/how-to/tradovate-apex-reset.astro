---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-apex-reset";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Reset a Failed Apex Evaluation on Tradovate";
const META_DESCRIPTION =
  "Reset a failed Apex evaluation: close open positions, hit Reset in your member dashboard, pay the fee, and trade a fresh Tradovate balance in minutes.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate API", de: "Tradovate API", es: "Tradovate API", fr: "Tradovate API", it: "Tradovate API" },
  h1: { en: META_TITLE, de: "Eine gescheiterte Apex-Evaluierung auf Tradovate zurücksetzen", es: "Restablezca una evaluación de Apex fallida en Tradovate", fr: "Réinitialiser une évaluation Apex échouée sur Tradovate", it: "Reimpostare una valutazione Apex fallita su Tradovate" },
  dek: { en: "Blew your Apex evaluation and want to start over without buying a whole new plan? Here's how to reset a legacy Apex evaluation back to its starting balance and get trading again in Tradovate.", de: "Ihre Apex-Evaluierung ist gescheitert, und Sie möchten neu starten, ohne einen ganzen neuen Plan zu kaufen? So setzen Sie eine ältere Apex-Evaluierung auf ihr Startguthaben zurück und handeln wieder in Tradovate.", es: "¿Perdió su evaluación de Apex y quiere empezar de nuevo sin comprar un plan completo? Así se restablece una evaluación de Apex heredada a su saldo inicial para volver a operar en Tradovate.", fr: "Vous avez échoué à votre évaluation Apex et souhaitez recommencer sans acheter un plan entier ? Voici comment réinitialiser une ancienne évaluation Apex à son solde de départ et reprendre le trading dans Tradovate.", it: "Ha fallito la sua valutazione Apex e vuole ricominciare senza acquistare un intero nuovo piano? Ecco come reimpostare una valutazione Apex legacy al saldo iniziale e tornare a operare su Tradovate." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-10",
  blocks: { en: [
    { type: "paragraph", html: "Blew your Apex evaluation and want to start over without buying a whole new plan? On legacy Apex accounts you can reset a failed evaluation back to its starting balance for a fee. Here's the part that trips people up: you don't reset anything inside Tradovate. Tradovate is just the platform you trade on. The reset happens in your Apex member dashboard, and once it's done you sign back in to Tradovate with a clean account." },
    { type: "quote", html: "<strong class='text-white'>Read this first.</strong> Apex changed its model on March 1, 2026. New Apex 4.0 evaluations are one-time purchases and <strong class='text-white'>do not offer resets</strong> at all. If a 4.0 eval fails inside its 30-day window, you buy a new one. Resets only apply to legacy accounts opened before that switch. Not sure which you have? Check your dashboard for a Reset option, or ask Apex support before you count on it." },
    { type: "heading", text: "Who Can Reset, and What a Reset Actually Does" },
    { type: "paragraph", html: "Resets are for <strong class='text-white'>evaluation accounts only</strong>. A funded Performance Account can't be reset. Blow the risk rules on a funded account and it's closed for good, so don't expect this path to save one." },
    { type: "paragraph", html: "When a legacy evaluation resets, it wipes the slate. Your balance goes back to the starting figure, the trailing drawdown resets to full, and your days-traded counter goes to zero. What it does <em>not</em> do is push back your renewal or expiration date. That date stays fixed, so a reset buys you a fresh balance but not extra calendar time." },
    {
      type: "table",
      headers: ["What a reset changes", "What it doesn't"],
      rows: [
        ["Balance returns to the starting amount", "Renewal / expiration date stays the same"],
        ["Trailing drawdown resets to full", "Funded (PA) accounts still can't be reset"],
        ["Days-traded counter goes back to zero", "Past trades and P&L history stay on record"],
      ],
    },
    { type: "heading", text: "How to Reset a Failed Apex Evaluation: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Flatten Every Position and Cancel Open Orders in Tradovate", html: "Log in to Tradovate and make sure the failed account is completely flat. Close any open positions and cancel every working order, including stops and targets on a bracket. A reset can stall or error out if the account still carries open exposure, so clear it first." },
        { title: "Open Your Apex Dashboard and Find the Failed Account", html: "Head to your Apex Trader Funding dashboard, not Tradovate. Find the section that lists your evaluation accounts. It's usually labeled something like <strong class='text-white'>Active Evals</strong> or <strong class='text-white'>Account History</strong>. Locate the specific account you just failed, since most traders run more than one at a time and you don't want to touch the wrong one." },
        { title: "Click Reset and Pay the Reset Fee", html: "Click the <strong class='text-white'>Reset</strong> control next to the failed account and confirm. Read the confirmation carefully, because a reset is irreversible and there's no undo if you pick the wrong account. A reset fee applies, and it varies by firm, plan, and account size, so check the current price shown at checkout before you commit rather than trusting an old number you saw somewhere." },
        { title: "Wait for Processing and Confirm the Fresh Balance", html: "The reset doesn't always land instantly. It usually processes within about ten minutes, though it can take longer during busy periods. Refresh your dashboard and check the account. When it's done you'll see the starting balance restored, a full trailing drawdown, and zero days traded. That's your signal it worked." },
        { title: "Sign Back In to Tradovate and Check Your Credentials", html: "Here's the Tradovate-specific catch. A reset often spins the account number forward, so APEX-#####-12 becomes APEX-#####-13. When the number changes, your Tradovate login can change too. Pull the current username and password from your Apex dashboard, sign in to the Tradovate web platform, and confirm you're on the reset balance before you trade. If old credentials suddenly fail after a reset, this is almost always why." },
      ],
    },
    { type: "heading", text: "A Quick Note on the Free Reset" },
    { type: "paragraph", html: "On legacy subscriptions, if an evaluation fails and you forget to cancel before the billing cycle turns over, Apex may fold a free reset into the renewal, provided the usual conditions are met. Don't rely on it, but if you were renewing anyway, you might get the fresh start bundled in." },
    { type: "heading", text: "Automate the Fresh Eval with PickMyTrade" },
    { type: "paragraph", html: "Back in with a clean balance, the last thing you want is to hand-fumble entries and blow the reset the same way you blew the first attempt. <strong class='text-white'>PickMyTrade routes your TradingView alerts straight to your Apex Tradovate account</strong>, so entries, stops, and targets fire on their own with the same discipline every time." },
  ], de: [
    { type: "paragraph",html: "Ihre Apex-Evaluierung ist gescheitert, und Sie möchten neu starten, ohne einen ganzen neuen Plan zu kaufen? Bei älteren Apex-Konten können Sie eine gescheiterte Evaluierung gegen eine Gebühr auf ihr Startguthaben zurücksetzen. Und hier stolpern viele: Sie setzen nichts innerhalb von Tradovate zurück. Tradovate ist nur die Plattform, auf der Sie handeln. Der Reset erfolgt in Ihrem Apex-Mitglieder-Dashboard, und danach melden Sie sich mit einem sauberen Konto wieder bei Tradovate an." },
    { type: "quote",html: "<strong class='text-white'>Bitte zuerst lesen.</strong> Apex hat sein Modell am 1. März 2026 geändert. Neue Apex-4.0-Evaluierungen sind Einmalkäufe und bieten <strong class='text-white'>überhaupt keine Resets</strong>. Scheitert eine 4.0-Evaluierung innerhalb ihres 30-Tage-Zeitraums, kaufen Sie eine neue. Resets gelten nur für ältere Konten, die vor dieser Umstellung eröffnet wurden. Sie wissen nicht, welches Sie haben? Suchen Sie in Ihrem Dashboard nach einer Reset-Option oder fragen Sie den Apex-Support, bevor Sie sich darauf verlassen." },
    { type: "heading",text: "Wer zurücksetzen kann und was ein Reset tatsächlich bewirkt" },
    { type: "paragraph",html: "Resets gelten <strong class='text-white'>ausschließlich für Evaluierungskonten</strong>. Ein Funded Performance Account kann nicht zurückgesetzt werden. Verstoßen Sie auf einem Funded-Konto gegen die Risikoregeln, wird es endgültig geschlossen. Erwarten Sie also nicht, dass dieser Weg eines retten kann." },
    { type: "paragraph",html: "Wird eine ältere Evaluierung zurückgesetzt, beginnt sie bei null. Ihr Guthaben kehrt zum Startwert zurück, das Trailing Drawdown wird wieder voll, und Ihr Zähler für gehandelte Tage geht auf null. Was es <em>nicht</em> tut, ist, Ihr Verlängerungs- oder Ablaufdatum zu verschieben. Dieses Datum bleibt fest, ein Reset verschafft Ihnen also ein frisches Guthaben, aber keine zusätzliche Kalenderzeit." },
    { type: "table", headers: ["Was ein Reset ändert","Was er nicht ändert"], rows: [
      ["Das Guthaben kehrt zum Startbetrag zurück","Verlängerungs-/Ablaufdatum bleibt gleich"],
      ["Trailing Drawdown wird wieder voll","Funded-Konten (PA) können weiterhin nicht zurückgesetzt werden"],
      ["Zähler für gehandelte Tage geht auf null zurück","Frühere Trades und die P&L-Historie bleiben erhalten"],
    ] },
    { type: "heading",text: "So setzen Sie eine gescheiterte Apex-Evaluierung zurück: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Alle Positionen schließen und offene Orders in Tradovate stornieren", html: "Melden Sie sich bei Tradovate an und stellen Sie sicher, dass das gescheiterte Konto vollständig flat ist. Schließen Sie alle offenen Positionen und stornieren Sie jede aktive Order, einschließlich Stopps und Ziele eines Brackets. Ein Reset kann ins Stocken geraten oder fehlschlagen, wenn das Konto noch offene Exposure hält. Räumen Sie es daher zuerst auf." },
        { title: "Apex-Dashboard öffnen und das gescheiterte Konto finden", html: "Gehen Sie zu Ihrem Apex-Trader-Funding-Dashboard, nicht zu Tradovate. Suchen Sie den Bereich, der Ihre Evaluierungskonten auflistet. Er heißt meist etwa <strong class='text-white'>Active Evals</strong> oder <strong class='text-white'>Account History</strong>. Finden Sie das konkrete Konto, das Sie gerade verloren haben, denn die meisten Trader betreiben mehrere gleichzeitig, und Sie wollen nicht das falsche anfassen." },
        { title: "Auf Reset klicken und die Reset-Gebühr zahlen", html: "Klicken Sie neben dem gescheiterten Konto auf die Schaltfläche <strong class='text-white'>Reset</strong> und bestätigen Sie. Lesen Sie die Bestätigung sorgfältig, denn ein Reset ist unumkehrbar, und es gibt kein Rückgängigmachen, falls Sie das falsche Konto wählen. Es fällt eine Reset-Gebühr an, die je nach Firma, Plan und Kontogröße variiert. Prüfen Sie den beim Checkout angezeigten aktuellen Preis, bevor Sie sich festlegen, statt sich auf eine alte Zahl zu verlassen, die Sie irgendwo gesehen haben." },
        { title: "Auf die Verarbeitung warten und das frische Guthaben bestätigen", html: "Der Reset wird nicht immer sofort wirksam. Er wird meist innerhalb von etwa zehn Minuten verarbeitet, kann in stark frequentierten Zeiten aber länger dauern. Aktualisieren Sie Ihr Dashboard und prüfen Sie das Konto. Ist er abgeschlossen, sehen Sie das wiederhergestellte Startguthaben, ein volles Trailing Drawdown und null gehandelte Tage. Das ist Ihr Signal, dass es funktioniert hat." },
        { title: "Wieder bei Tradovate anmelden und Zugangsdaten prüfen", html: "Hier ist die Tradovate-spezifische Besonderheit. Ein Reset schaltet die Kontonummer oft weiter, sodass aus APEX-#####-12 dann APEX-#####-13 wird. Ändert sich die Nummer, kann sich auch Ihr Tradovate-Login ändern. Holen Sie sich den aktuellen Benutzernamen und das Passwort aus Ihrem Apex-Dashboard, melden Sie sich an der Tradovate-Webplattform an und bestätigen Sie, dass Sie auf dem zurückgesetzten Guthaben sind, bevor Sie handeln. Wenn alte Zugangsdaten nach einem Reset plötzlich nicht mehr funktionieren, ist das fast immer der Grund." },
      ],
    },
    { type: "heading",text: "Ein kurzer Hinweis zum kostenlosen Reset" },
    { type: "paragraph",html: "Wenn bei älteren Abonnements eine Evaluierung scheitert und Sie vergessen, vor dem Wechsel des Abrechnungszyklus zu kündigen, kann Apex einen kostenlosen Reset in die Verlängerung einbeziehen, sofern die üblichen Bedingungen erfüllt sind. Verlassen Sie sich nicht darauf, aber wenn Sie ohnehin verlängert hätten, bekommen Sie den Neustart eventuell gleich mit dazu." },
    { type: "heading",text: "Automatisieren Sie die neue Evaluierung mit PickMyTrade" },
    { type: "paragraph",html: "Zurück mit einem sauberen Guthaben ist das Letzte, was Sie wollen, Einstiege von Hand zu verpatzen und den Reset genauso zu verspielen wie den ersten Versuch. <strong class='text-white'>PickMyTrade leitet Ihre TradingView-Alerts direkt an Ihr Apex-Tradovate-Konto weiter</strong>, sodass Einstiege, Stopps und Ziele jedes Mal mit derselben Disziplin von selbst ausgeführt werden." },
  ], es: [
    { type: "paragraph",html: "¿Perdió su evaluación de Apex y quiere empezar de nuevo sin comprar un plan completo? En las cuentas heredadas de Apex puede restablecer una evaluación fallida a su saldo inicial mediante una tarifa. Y aquí está lo que confunde a muchos: no restablece nada dentro de Tradovate. Tradovate es solo la plataforma en la que opera. El reinicio se hace en su panel de miembros de Apex y, una vez hecho, vuelve a iniciar sesión en Tradovate con una cuenta limpia." },
    { type: "quote",html: "<strong class='text-white'>Lea esto primero.</strong> Apex cambió su modelo el 1 de marzo de 2026. Las nuevas evaluaciones de Apex 4.0 son compras únicas y <strong class='text-white'>no ofrecen reinicios</strong> en absoluto. Si una evaluación 4.0 fracasa dentro de su ventana de 30 días, debe comprar una nueva. Los reinicios solo se aplican a las cuentas heredadas abiertas antes de ese cambio. ¿No está seguro de cuál tiene? Busque una opción de restablecimiento en su panel o pregunte al soporte de Apex antes de contar con ello." },
    { type: "heading",text: "Quién puede restablecer y qué hace realmente un restablecimiento" },
    { type: "paragraph",html: "Los reinicios son <strong class='text-white'>solo para cuentas de evaluación</strong>. Una Performance Account financiada no se puede restablecer. Si incumple las reglas de riesgo en una cuenta financiada, se cierra definitivamente, así que no espere que este camino salve una." },
    { type: "paragraph",html: "Cuando se restablece una evaluación heredada, se borra el historial. Su saldo vuelve a la cifra inicial, el trailing drawdown se restablece por completo y su contador de días operados vuelve a cero. Lo que <em>no</em> hace es posponer su fecha de renovación o de vencimiento. Esa fecha permanece fija, así que un reinicio le da un saldo nuevo pero no tiempo de calendario adicional." },
    { type: "table", headers: ["Qué cambia un restablecimiento","Qué no cambia"], rows: [
      ["El saldo vuelve al importe inicial","La fecha de renovación/vencimiento sigue igual"],
      ["El trailing drawdown se restablece por completo","Las cuentas financiadas (PA) siguen sin poder restablecerse"],
      ["El contador de días operados vuelve a cero","Las operaciones pasadas y el historial de P&L permanecen registrados"],
    ] },
    { type: "heading",text: "Cómo restablecer una evaluación de Apex fallida: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Cierre todas las posiciones y cancele las órdenes abiertas en Tradovate", html: "Inicie sesión en Tradovate y asegúrese de que la cuenta fallida está completamente cerrada (flat). Cierre cualquier posición abierta y cancele todas las órdenes activas, incluidos los stops y objetivos de un bracket. Un restablecimiento puede atascarse o dar error si la cuenta aún mantiene exposición abierta, así que despéjela primero." },
        { title: "Abra su panel de Apex y localice la cuenta fallida", html: "Vaya a su panel de Apex Trader Funding, no a Tradovate. Busque la sección que lista sus cuentas de evaluación. Suele llamarse algo como <strong class='text-white'>Active Evals</strong> o <strong class='text-white'>Account History</strong>. Localice la cuenta concreta que acaba de perder, ya que la mayoría de los traders gestionan más de una a la vez y no querrá tocar la equivocada." },
        { title: "Haga clic en Reset y pague la tarifa de reinicio", html: "Haga clic en el control <strong class='text-white'>Reset</strong> junto a la cuenta fallida y confirme. Lea la confirmación con atención, porque un restablecimiento es irreversible y no hay forma de deshacerlo si elige la cuenta equivocada. Se aplica una tarifa de reinicio, que varía según la firma, el plan y el tamaño de la cuenta, así que compruebe el precio actual que aparece en el pago antes de confirmar en lugar de fiarse de una cifra antigua que vio en algún sitio." },
        { title: "Espere el procesamiento y confirme el saldo nuevo", html: "El reinicio no siempre se aplica al instante. Normalmente se procesa en unos diez minutos, aunque puede tardar más en periodos de mucha actividad. Actualice su panel y revise la cuenta. Cuando termine, verá el saldo inicial restaurado, un trailing drawdown completo y cero días operados. Esa es la señal de que funcionó." },
        { title: "Vuelva a iniciar sesión en Tradovate y compruebe sus credenciales", html: "Aquí está el detalle específico de Tradovate. Un restablecimiento suele avanzar el número de cuenta, de modo que APEX-#####-12 pasa a ser APEX-#####-13. Cuando el número cambia, su acceso a Tradovate también puede cambiar. Obtenga el usuario y la contraseña actuales desde su panel de Apex, inicie sesión en la plataforma web de Tradovate y confirme que está en el saldo restablecido antes de operar. Si las credenciales antiguas fallan de repente tras un restablecimiento, casi siempre es por esto." },
      ],
    },
    { type: "heading",text: "Una nota rápida sobre el restablecimiento gratuito" },
    { type: "paragraph",html: "En suscripciones heredadas, si una evaluación fracasa y olvida cancelar antes de que cambie el ciclo de facturación, Apex puede incluir un reinicio gratuito en la renovación, siempre que se cumplan las condiciones habituales. No cuente con ello, pero si de todos modos iba a renovar, podría recibir el nuevo comienzo incluido." },
    { type: "heading",text: "Automatice la nueva evaluación con PickMyTrade" },
    { type: "paragraph",html: "De vuelta con un saldo limpio, lo último que quiere es estropear las entradas a mano y perder el reinicio igual que perdió el primer intento. <strong class='text-white'>PickMyTrade enruta sus alertas de TradingView directamente a su cuenta de Apex Tradovate</strong>, de modo que las entradas, stops y objetivos se ejecutan solos con la misma disciplina cada vez." },
  ], fr: [
    { type: "paragraph",html: "Vous avez échoué à votre évaluation Apex et souhaitez recommencer sans acheter un plan entier ? Sur les anciens comptes Apex, vous pouvez réinitialiser une évaluation échouée à son solde de départ moyennant des frais. Voici ce qui piège beaucoup de gens : vous ne réinitialisez rien dans Tradovate. Tradovate n’est que la plateforme sur laquelle vous tradez. La réinitialisation se fait dans votre tableau de bord membre Apex, et une fois terminée, vous vous reconnectez à Tradovate avec un compte propre." },
    { type: "quote",html: "<strong class='text-white'>À lire en premier.</strong> Apex a changé de modèle le 1er mars 2026. Les nouvelles évaluations Apex 4.0 sont des achats uniques et <strong class='text-white'>n’offrent aucune réinitialisation</strong>. Si une évaluation 4.0 échoue dans sa fenêtre de 30 jours, vous en achetez une nouvelle. Les réinitialisations ne s’appliquent qu’aux anciens comptes ouverts avant ce changement. Vous ne savez pas lequel vous avez ? Cherchez une option de réinitialisation dans votre tableau de bord, ou interrogez le support Apex avant d’y compter." },
    { type: "heading",text: "Qui peut réinitialiser, et ce que fait réellement une réinitialisation" },
    { type: "paragraph",html: "Les réinitialisations concernent <strong class='text-white'>uniquement les comptes d’évaluation</strong>. Un Performance Account financé ne peut pas être réinitialisé. Si vous enfreignez les règles de risque sur un compte financé, il est fermé définitivement ; n’attendez donc pas de cette voie qu’elle en sauve un." },
    { type: "paragraph",html: "Lorsqu’une évaluation ancienne est réinitialisée, elle repart de zéro. Votre solde revient au montant de départ, le trailing drawdown est remis à plein et votre compteur de jours tradés repasse à zéro. Ce qu’elle ne fait <em>pas</em>, c’est repousser votre date de renouvellement ou d’expiration. Cette date reste fixe : une réinitialisation vous donne donc un solde neuf, mais pas de temps calendaire supplémentaire." },
    { type: "table", headers: ["Ce que change une réinitialisation","Ce qu’elle ne change pas"], rows: [
      ["Le solde revient au montant de départ","La date de renouvellement / d’expiration reste la même"],
      ["Le trailing drawdown est remis à plein","Les comptes financés (PA) ne peuvent toujours pas être réinitialisés"],
      ["Le compteur de jours tradés repasse à zéro","Les trades passés et l’historique de P&L restent enregistrés"],
    ] },
    { type: "heading",text: "Comment réinitialiser une évaluation Apex échouée : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Clôturez toutes les positions et annulez les ordres ouverts dans Tradovate", html: "Connectez-vous à Tradovate et assurez-vous que le compte échoué est totalement à plat (flat). Fermez toute position ouverte et annulez chaque ordre actif, y compris les stops et objectifs d’un bracket. Une réinitialisation peut se bloquer ou échouer si le compte porte encore une exposition ouverte ; commencez donc par la solder." },
        { title: "Ouvrez votre tableau de bord Apex et trouvez le compte échoué", html: "Rendez-vous sur votre tableau de bord Apex Trader Funding, et non sur Tradovate. Trouvez la section qui liste vos comptes d’évaluation. Elle s’intitule généralement quelque chose comme <strong class='text-white'>Active Evals</strong> ou <strong class='text-white'>Account History</strong>. Repérez le compte précis que vous venez d’échouer, car la plupart des traders en gèrent plusieurs à la fois et vous ne voulez pas toucher au mauvais." },
        { title: "Cliquez sur Reset et réglez les frais de réinitialisation", html: "Cliquez sur la commande <strong class='text-white'>Reset</strong> à côté du compte échoué et confirmez. Lisez attentivement la confirmation, car une réinitialisation est irréversible et il n’y a aucune annulation si vous choisissez le mauvais compte. Des frais de réinitialisation s’appliquent ; ils varient selon la firme, le forfait et la taille du compte. Vérifiez donc le prix actuel affiché au paiement avant de vous engager, plutôt que de vous fier à un ancien chiffre vu quelque part." },
        { title: "Attendez le traitement et confirmez le solde remis à neuf", html: "La réinitialisation n’est pas toujours instantanée. Elle est généralement traitée en une dizaine de minutes environ, mais peut prendre plus de temps en période d’affluence. Actualisez votre tableau de bord et vérifiez le compte. Une fois terminée, vous verrez le solde de départ rétabli, un trailing drawdown complet et zéro jour tradé. C’est le signal que cela a fonctionné." },
        { title: "Reconnectez-vous à Tradovate et vérifiez vos identifiants", html: "Voici la particularité propre à Tradovate. Une réinitialisation fait souvent avancer le numéro de compte, de sorte que APEX-#####-12 devient APEX-#####-13. Quand le numéro change, votre identifiant Tradovate peut changer lui aussi. Récupérez le nom d’utilisateur et le mot de passe actuels depuis votre tableau de bord Apex, connectez-vous à la plateforme web Tradovate et vérifiez que vous êtes bien sur le solde réinitialisé avant de trader. Si d’anciens identifiants échouent soudain après une réinitialisation, c’est presque toujours la raison." },
      ],
    },
    { type: "heading",text: "Un mot rapide sur la réinitialisation gratuite" },
    { type: "paragraph",html: "Sur les anciens abonnements, si une évaluation échoue et que vous oubliez de résilier avant le changement de cycle de facturation, Apex peut intégrer une réinitialisation gratuite au renouvellement, sous réserve que les conditions habituelles soient remplies. Ne comptez pas dessus, mais si vous alliez de toute façon renouveler, vous pourriez obtenir ce nouveau départ en prime." },
    { type: "heading",text: "Automatisez la nouvelle évaluation avec PickMyTrade" },
    { type: "paragraph",html: "De retour avec un solde propre, la dernière chose que vous voulez, c’est de rater vos entrées à la main et de gâcher la réinitialisation comme vous avez gâché le premier essai. <strong class='text-white'>PickMyTrade achemine vos alertes TradingView directement vers votre compte Apex Tradovate</strong>, afin que les entrées, stops et objectifs s’exécutent d’eux-mêmes avec la même discipline à chaque fois." },
  ], it: [
    { type: "paragraph",html: "Ha fallito la sua valutazione Apex e vuole ricominciare senza acquistare un intero nuovo piano? Sui conti Apex legacy può reimpostare una valutazione fallita al suo saldo iniziale dietro pagamento di una commissione. Ecco il punto su cui molti inciampano: non reimposta nulla dentro Tradovate. Tradovate è solo la piattaforma su cui opera. Il reset avviene nella sua dashboard membri di Apex e, una volta fatto, accede di nuovo a Tradovate con un conto pulito." },
    { type: "quote",html: "<strong class='text-white'>Legga prima questo.</strong> Apex ha cambiato modello il 1° marzo 2026. Le nuove valutazioni Apex 4.0 sono acquisti una tantum e <strong class='text-white'>non offrono alcun reset</strong>. Se una valutazione 4.0 fallisce entro la sua finestra di 30 giorni, occorre acquistarne una nuova. I reset valgono solo per i conti legacy aperti prima di quel passaggio. Non sa quale ha? Cerchi un’opzione di reset nella sua dashboard o chieda al supporto Apex prima di farci affidamento." },
    { type: "heading",text: "Chi può reimpostare e che cosa fa davvero un reset" },
    { type: "paragraph",html: "I reset sono <strong class='text-white'>solo per i conti di valutazione</strong>. Un Performance Account finanziato non può essere reimpostato. Se viola le regole di rischio su un conto finanziato, viene chiuso definitivamente, quindi non si aspetti che questa strada ne salvi uno." },
    { type: "paragraph",html: "Quando una valutazione legacy viene reimpostata, si azzera tutto. Il saldo torna alla cifra iniziale, il trailing drawdown viene ripristinato al massimo e il contatore dei giorni operati torna a zero. Ciò che <em>non</em> fa è spostare la data di rinnovo o di scadenza. Quella data resta fissa, quindi un reset le dà un saldo nuovo ma non più tempo di calendario." },
    { type: "table", headers: ["Che cosa cambia un reset","Che cosa non cambia"], rows: [
