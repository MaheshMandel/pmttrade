---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-light-dark-mode";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Switch Light or Dark Theme in Tradovate";
const META_DESCRIPTION =
  "Switch Tradovate between light and dark theme via Preferences and Appearance, set it to match your OS, and stop the theme reverting on its own.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Hell- oder Dunkelmodus in Tradovate umschalten", es: "Cambie el tema claro u oscuro en Tradovate", fr: "Basculer entre thème clair et sombre dans Tradovate", it: "Passare dal tema chiaro a quello scuro in Tradovate" },
  dek: { en: "Staring at a bright white platform through an overnight session gets old fast, and a dark screen can wash out in a sunny office. Here's exactly where the Light, Dark, and Automatic theme setting lives, and how to lock your choice so it stops flipping on its own.", de: "Stundenlang auf eine grellweiße Plattform zu starren, wird in einer Nachtsitzung schnell anstrengend, und ein dunkler Bildschirm kann in einem sonnigen Büro verblassen. Hier erfahren Sie genau, wo die Einstellung für Light, Dark und Automatic zu finden ist und wie Sie Ihre Wahl fixieren, damit sie nicht mehr von selbst wechselt.", es: "Mirar una plataforma de un blanco brillante durante una sesión nocturna cansa enseguida, y una pantalla oscura puede quedar deslavada en una oficina soleada. Aquí le explicamos exactamente dónde está el ajuste de tema Light, Dark y Automatic, y cómo fijar su elección para que deje de cambiar por sí sola.", fr: "Fixer une plateforme d'un blanc éclatant pendant une session de nuit devient vite pénible, et un écran sombre peut paraître délavé dans un bureau ensoleillé. Voici exactement où se trouve le réglage de thème Light, Dark et Automatic, et comment verrouiller votre choix pour qu'il cesse de changer tout seul.", it: "Fissare una piattaforma di un bianco abbagliante durante una sessione notturna stanca in fretta, e uno schermo scuro può sembrare slavato in un ufficio soleggiato. Ecco esattamente dove si trova l'impostazione del tema Light, Dark e Automatic e come bloccare la sua scelta in modo che smetta di cambiare da sola." },
  readTime: { en: "4 min read", de: "4 Min. Lesezeit", es: "Lectura de 4 min", fr: "Lecture : 4 min", it: "Lettura di 4 min" },
  lastUpdated: "2026-07-10",
  blocks: { en: [
    { type: "paragraph", html: "Staring at a bright white platform through an overnight session gets old fast, and a dark screen can wash out in a sunny office. Tradovate lets you flip between the two whenever you like. The setting lives in one spot, <strong class='text-white'>Application Settings &rarr; Preferences &rarr; Appearance</strong>, and switching takes about four clicks. Here's exactly where to find it, plus how to lock your choice so the theme stops flipping on its own." },
    { type: "quote", html: "<strong>Quick answer:</strong> Click the <strong>Application Settings</strong> (gear) icon in the top-right corner, open the <strong>Preferences</strong> tab, and in the <strong>Appearance</strong> section choose <strong>Light</strong>, <strong>Dark</strong>, or <strong>Automatic</strong>. Light gives you a white background, Dark a near-black one, and Automatic follows your computer's system theme. The change is instant." },
    { type: "heading", text: "Where the Theme Setting Lives" },
    { type: "paragraph", html: "The platform theme is an account-level preference, not a per-chart or per-window setting. Change it once and it repaints the whole interface, the order panels, the DOM, the menus, and the default chart background all follow. Because it's tied to your login, the choice carries over between the web and desktop apps when you sign in with the same account." },
    { type: "heading", text: "How to Switch Light or Dark Theme in Tradovate: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open Application Settings", html: "Look to the <strong class='text-white'>top-right corner</strong> of the platform and click the <strong class='text-white'>Application Settings</strong> icon, the gear. That opens the settings panel where every platform-wide preference lives, theme included.", image: { src: `${IMG}/tradovate-light-dark-mode-1.png`, alt: "Tradovate Application Settings gear icon highlighted in the top-right corner of the platform" } },
        { title: "Open the Preferences Tab", html: "Inside the settings panel, select the <strong class='text-white'>Preferences</strong> tab along the top. Preferences is the home for the look-and-feel options, the theme controls sit here rather than under any chart or workspace menu, which trips people up when they go hunting inside a single chart's settings.", image: { src: `${IMG}/tradovate-light-dark-mode-2.png`, alt: "Tradovate settings panel with the Preferences tab selected" } },
        { title: "Find the Appearance Section", html: "The <strong class='text-white'>Appearance</strong> section sits right at the top of the Preferences page. This is the block that controls your platform background, and it's where the light and dark options are grouped together. You don't need to scroll far, it's the first thing you'll see.", image: { src: `${IMG}/tradovate-light-dark-mode-3.png`, alt: "Appearance section at the top of the Tradovate Preferences page showing theme options" } },
        { title: "Choose Light, Dark, or Automatic", html: "Now pick your theme. <strong class='text-white'>Light</strong> sets a white background, <strong class='text-white'>Dark</strong> sets a near-black one, and the <strong class='text-white'>Automatic</strong> option hands control to your operating system so the platform matches whatever your computer is running. Click your choice and the interface repaints on the spot, there's no Save button to hunt for and no restart. If you don't love it, click a different option and it flips back just as fast.", image: { src: `${IMG}/tradovate-light-dark-mode-4.png`, alt: "Tradovate Appearance options with Light, Dark, and Automatic theme choices" } },
      ],
    },
    { type: "heading", text: "Light vs Dark vs Automatic" },
    {
      type: "table",
      headers: ["Option", "Background", "Best for"],
      rows: [
        ["Light", "White", "Bright rooms, daylight, printed-out screenshots, anyone who finds dark UIs muddy."],
        ["Dark", "Near-black", "Overnight and pre-market sessions, dim rooms, and long screen time when glare tires your eyes."],
        ["Automatic", "Follows your OS", "People who already run their computer on a schedule that flips light by day and dark at night."],
      ],
    },
    { type: "heading", text: "Theme Keeps Switching on Its Own?" },
    { type: "paragraph", html: "If your platform looks dark in the morning and light by afternoon, or the other way round, you've almost certainly got the <strong class='text-white'>Automatic</strong> option turned on. On that setting, Tradovate mirrors your operating system, and many systems are set to shift from a light appearance during the day to a dark one after sunset. Nothing is broken; the platform is just doing what the OS tells it." },
    { type: "paragraph", html: "To pin it down, go back to <strong class='text-white'>Preferences &rarr; Appearance</strong> and switch off <strong class='text-white'>Automatic</strong>, then pick a fixed <strong class='text-white'>Light</strong> or <strong class='text-white'>Dark</strong>. From that point the theme holds steady no matter what your computer does." },
    { type: "heading", text: "A Note on Chart Colors" },
    { type: "paragraph", html: "The theme controls the platform's overall look and the default chart background, but your <strong class='text-white'>charts carry their own color settings</strong> on top of that. If you want custom candle colors, a specific grid shade, or a background that doesn't just track the app theme, that's set inside the chart's own options rather than here in Preferences." },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "A tidy dark theme is nice, but the real time-sink is watching the screen for entries. <strong class='text-white'>PickMyTrade wires your TradingView alerts straight into your Tradovate account</strong> and places the trades for you, every signal fires with no manual clicks, whether your platform's set to light or dark." },
  ], de: [
    { type: "paragraph",html: "Stundenlang auf eine grellweiße Plattform zu starren, wird in einer Nachtsitzung schnell anstrengend, und ein dunkler Bildschirm kann in einem sonnigen Büro verblassen. Tradovate lässt Sie jederzeit zwischen beiden wechseln. Die Einstellung befindet sich an einer einzigen Stelle, <strong class='text-white'>Application Settings &rarr; Preferences &rarr; Appearance</strong>, und der Wechsel dauert etwa vier Klicks. Hier erfahren Sie genau, wo Sie sie finden, und wie Sie Ihre Wahl fixieren, damit das Design nicht mehr von selbst wechselt." },
    { type: "quote",html: "<strong>Kurzantwort:</strong> Klicken Sie oben rechts auf das Symbol <strong>Application Settings</strong> (Zahnrad), öffnen Sie den Tab <strong>Preferences</strong> und wählen Sie im Bereich <strong>Appearance</strong> zwischen <strong>Light</strong>, <strong>Dark</strong> oder <strong>Automatic</strong>. Light liefert einen weißen Hintergrund, Dark einen fast schwarzen, und Automatic folgt dem Systemdesign Ihres Computers. Die Änderung gilt sofort." },
    { type: "heading",text: "Wo die Design-Einstellung zu finden ist" },
    { type: "paragraph",html: "Das Plattformdesign ist eine Einstellung auf Kontoebene, keine pro Chart oder pro Fenster. Ändern Sie es einmal, und die gesamte Oberfläche wird neu gezeichnet: Orderfenster, DOM, Menüs und der Standard-Chart-Hintergrund folgen alle. Da die Einstellung an Ihren Login gebunden ist, wird Ihre Auswahl zwischen Web- und Desktop-App übernommen, wenn Sie sich mit demselben Konto anmelden." },
    { type: "heading",text: "Hell- oder Dunkelmodus in Tradovate umschalten: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Application Settings öffnen", html: "Schauen Sie in die <strong class='text-white'>obere rechte Ecke</strong> der Plattform und klicken Sie auf das Symbol <strong class='text-white'>Application Settings</strong>, das Zahnrad. Damit öffnet sich das Einstellungsfenster, in dem alle plattformweiten Einstellungen liegen, auch das Design.", image: {"src":`${IMG}/tradovate-light-dark-mode-1.png`,"alt":"Tradovate-Zahnradsymbol Application Settings, hervorgehoben in der oberen rechten Ecke der Plattform"} },
        { title: "Tab „Preferences“ öffnen", html: "Wählen Sie im Einstellungsfenster oben den Tab <strong class='text-white'>Preferences</strong>. Preferences ist die Heimat der Optionen für Aussehen und Bedienung. Die Design-Einstellungen finden Sie hier und nicht in einem Chart- oder Workspace-Menü, was viele verwirrt, wenn sie in den Einstellungen eines einzelnen Charts suchen.", image: {"src":`${IMG}/tradovate-light-dark-mode-2.png`,"alt":"Tradovate-Einstellungsfenster mit ausgewähltem Tab Preferences"} },
        { title: "Den Bereich „Appearance“ finden", html: "Der Bereich <strong class='text-white'>Appearance</strong> steht ganz oben auf der Seite Preferences. Dieser Block steuert Ihren Plattformhintergrund, und hier sind die Hell- und Dunkel-Optionen zusammengefasst. Sie müssen nicht weit scrollen, es ist das Erste, was Sie sehen.", image: {"src":`${IMG}/tradovate-light-dark-mode-3.png`,"alt":"Bereich Appearance oben auf der Tradovate-Seite Preferences mit den Design-Optionen"} },
        { title: "Light, Dark oder Automatic wählen", html: "Wählen Sie nun Ihr Design. <strong class='text-white'>Light</strong> setzt einen weißen Hintergrund, <strong class='text-white'>Dark</strong> einen fast schwarzen, und die Option <strong class='text-white'>Automatic</strong> übergibt die Steuerung an Ihr Betriebssystem, sodass die Plattform dem entspricht, was Ihr Computer gerade nutzt. Klicken Sie Ihre Wahl an, und die Oberfläche wird sofort neu gezeichnet. Es gibt keine Schaltfläche zum Speichern und keinen Neustart. Gefällt es Ihnen nicht, klicken Sie eine andere Option an, und es wechselt genauso schnell zurück.", image: {"src":`${IMG}/tradovate-light-dark-mode-4.png`,"alt":"Tradovate-Appearance-Optionen mit den Designs Light, Dark und Automatic"} },
      ],
    },
    { type: "heading",text: "Light vs. Dark vs. Automatic" },
    { type: "table", headers: ["Option","Hintergrund","Am besten geeignet für"], rows: [
      ["Light","Weiß","Helle Räume, Tageslicht, ausgedruckte Screenshots und alle, die dunkle Oberflächen als trüb empfinden."],
      ["Dark","Fast schwarz","Nacht- und Vorbörsensitzungen, abgedunkelte Räume und lange Bildschirmzeiten, wenn Blendung die Augen ermüdet."],
      ["Automatic","Folgt Ihrem Betriebssystem","Alle, die ihren Computer ohnehin so betreiben, dass er tagsüber hell und nachts dunkel wechselt."],
    ] },
    { type: "heading",text: "Design wechselt ständig von selbst?" },
    { type: "paragraph",html: "Wenn Ihre Plattform morgens dunkel und nachmittags hell aussieht, oder umgekehrt, ist mit ziemlicher Sicherheit die Option <strong class='text-white'>Automatic</strong> aktiviert. In dieser Einstellung spiegelt Tradovate Ihr Betriebssystem, und viele Systeme sind so konfiguriert, dass sie tagsüber ein helles und nach Sonnenuntergang ein dunkles Erscheinungsbild verwenden. Nichts ist defekt; die Plattform tut nur, was das Betriebssystem ihr vorgibt." },
    { type: "paragraph",html: "Um das festzulegen, gehen Sie zurück zu <strong class='text-white'>Preferences &rarr; Appearance</strong> und schalten Sie <strong class='text-white'>Automatic</strong> aus, wählen Sie dann ein festes <strong class='text-white'>Light</strong> oder <strong class='text-white'>Dark</strong>. Ab dann bleibt das Design stabil, egal was Ihr Computer tut." },
    { type: "heading",text: "Ein Hinweis zu Chart-Farben" },
    { type: "paragraph",html: "Das Design steuert das Gesamtbild der Plattform und den Standard-Chart-Hintergrund, aber Ihre <strong class='text-white'>Charts haben zusätzlich eigene Farbeinstellungen</strong>. Wenn Sie eigene Kerzenfarben, einen bestimmten Gitterton oder einen Hintergrund wünschen, der nicht einfach dem App-Design folgt, stellen Sie das in den eigenen Optionen des Charts ein und nicht hier in den Preferences." },
    { type: "heading",text: "Automatisieren Sie das mit PickMyTrade" },
    { type: "paragraph",html: "Ein aufgeräumtes dunkles Design ist schön, aber der eigentliche Zeitfresser ist das Beobachten des Bildschirms auf der Suche nach Einstiegen. <strong class='text-white'>PickMyTrade verbindet Ihre TradingView-Alerts direkt mit Ihrem Tradovate-Konto</strong> und platziert die Trades für Sie. Jedes Signal wird ohne manuelle Klicks ausgelöst, egal ob Ihre Plattform auf Hell oder Dunkel eingestellt ist." },
  ], es: [
    { type: "paragraph",html: "Mirar una plataforma de un blanco brillante durante una sesión nocturna cansa enseguida, y una pantalla oscura puede quedar deslavada en una oficina soleada. Tradovate le permite alternar entre ambas cuando quiera. El ajuste está en un solo lugar, <strong class='text-white'>Application Settings &rarr; Preferences &rarr; Appearance</strong>, y el cambio requiere unos cuatro clics. Aquí le explicamos exactamente dónde encontrarlo, además de cómo fijar su elección para que el tema deje de cambiar por sí solo." },
    { type: "quote",html: "<strong>Respuesta rápida:</strong> haga clic en el icono <strong>Application Settings</strong> (engranaje) de la esquina superior derecha, abra la pestaña <strong>Preferences</strong> y, en la sección <strong>Appearance</strong>, elija <strong>Light</strong>, <strong>Dark</strong> o <strong>Automatic</strong>. Light le ofrece un fondo blanco, Dark uno casi negro y Automatic sigue el tema del sistema de su ordenador. El cambio es instantáneo." },
    { type: "heading",text: "Dónde se encuentra el ajuste del tema" },
    { type: "paragraph",html: "El tema de la plataforma es una preferencia a nivel de cuenta, no un ajuste por gráfico ni por ventana. Cámbielo una vez y se repinta toda la interfaz: los paneles de órdenes, el DOM, los menús y el fondo predeterminado del gráfico lo siguen. Como está vinculado a su inicio de sesión, la elección se mantiene entre las aplicaciones web y de escritorio cuando accede con la misma cuenta." },
    { type: "heading",text: "Cómo cambiar el tema claro u oscuro en Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra Application Settings", html: "Mire en la <strong class='text-white'>esquina superior derecha</strong> de la plataforma y haga clic en el icono <strong class='text-white'>Application Settings</strong>, el engranaje. Se abre el panel de ajustes donde residen todas las preferencias de toda la plataforma, incluido el tema.", image: {"src":`${IMG}/tradovate-light-dark-mode-1.png`,"alt":"Icono de engranaje Application Settings de Tradovate resaltado en la esquina superior derecha de la plataforma"} },
        { title: "Abra la pestaña Preferences", html: "Dentro del panel de ajustes, seleccione la pestaña <strong class='text-white'>Preferences</strong> de la parte superior. Preferences es el lugar de las opciones de aspecto y funcionamiento; los controles del tema están aquí y no en ningún menú de gráfico o de espacio de trabajo, lo que confunde a quien busca dentro de los ajustes de un gráfico concreto.", image: {"src":`${IMG}/tradovate-light-dark-mode-2.png`,"alt":"Panel de ajustes de Tradovate con la pestaña Preferences seleccionada"} },
        { title: "Localice la sección Appearance", html: "La sección <strong class='text-white'>Appearance</strong> se encuentra justo en la parte superior de la página Preferences. Este es el bloque que controla el fondo de su plataforma y donde se agrupan las opciones claro y oscuro. No necesita desplazarse mucho: es lo primero que verá.", image: {"src":`${IMG}/tradovate-light-dark-mode-3.png`,"alt":"Sección Appearance en la parte superior de la página Preferences de Tradovate con las opciones de tema"} },
        { title: "Elija Light, Dark o Automatic", html: "Ahora elija su tema. <strong class='text-white'>Light</strong> establece un fondo blanco, <strong class='text-white'>Dark</strong> uno casi negro y la opción <strong class='text-white'>Automatic</strong> cede el control a su sistema operativo para que la plataforma coincida con lo que esté usando su ordenador. Haga clic en su elección y la interfaz se repinta al instante: no hay botón de guardar que buscar ni reinicio. Si no le convence, haga clic en otra opción y vuelve igual de rápido.", image: {"src":`${IMG}/tradovate-light-dark-mode-4.png`,"alt":"Opciones de Appearance de Tradovate con los temas Light, Dark y Automatic"} },
      ],
    },
    { type: "heading",text: "Light vs. Dark vs. Automatic" },
    { type: "table", headers: ["Opción","Fondo","Ideal para"], rows: [
      ["Light","Blanco","Habitaciones luminosas, luz diurna, capturas de pantalla impresas y quienes encuentran turbias las interfaces oscuras."],
      ["Dark","Casi negro","Sesiones nocturnas y premercado, habitaciones con poca luz y muchas horas de pantalla cuando el deslumbramiento cansa la vista."],
      ["Automatic","Sigue su sistema operativo","Quienes ya configuran su ordenador para alternar entre claro de día y oscuro de noche."],
    ] },
    { type: "heading",text: "¿El tema cambia solo constantemente?" },
    { type: "paragraph",html: "Si su plataforma se ve oscura por la mañana y clara por la tarde, o al revés, es casi seguro que tiene activada la opción <strong class='text-white'>Automatic</strong>. Con ese ajuste, Tradovate refleja su sistema operativo, y muchos sistemas están configurados para pasar de una apariencia clara durante el día a una oscura después del atardecer. No hay ningún fallo; la plataforma simplemente hace lo que le indica el sistema operativo." },
    { type: "paragraph",html: "Para fijarlo, vuelva a <strong class='text-white'>Preferences &rarr; Appearance</strong> y desactive <strong class='text-white'>Automatic</strong>; después elija un <strong class='text-white'>Light</strong> o un <strong class='text-white'>Dark</strong> fijo. A partir de ese momento, el tema se mantiene estable haga lo que haga su ordenador." },
    { type: "heading",text: "Una nota sobre los colores del gráfico" },
    { type: "paragraph",html: "El tema controla el aspecto general de la plataforma y el fondo predeterminado del gráfico, pero sus <strong class='text-white'>gráficos tienen sus propios ajustes de color</strong> por encima de eso. Si desea colores de vela personalizados, un tono de cuadrícula concreto o un fondo que no siga simplemente el tema de la aplicación, eso se configura en las opciones del propio gráfico y no aquí, en Preferences." },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Un tema oscuro bien ordenado es agradable, pero lo que realmente consume tiempo es vigilar la pantalla en busca de entradas. <strong class='text-white'>PickMyTrade conecta sus alertas de TradingView directamente con su cuenta de Tradovate</strong> y coloca las operaciones por usted; cada señal se ejecuta sin clics manuales, tenga su plataforma en modo claro u oscuro." },
  ], fr: [
    { type: "paragraph",html: "Fixer une plateforme d'un blanc éclatant pendant une session de nuit devient vite pénible, et un écran sombre peut paraître délavé dans un bureau ensoleillé. Tradovate vous permet de basculer de l'un à l'autre quand vous le souhaitez. Le réglage se trouve à un seul endroit, <strong class='text-white'>Application Settings &rarr; Preferences &rarr; Appearance</strong>, et le changement demande environ quatre clics. Voici exactement où le trouver, ainsi que la façon de verrouiller votre choix pour que le thème cesse de basculer tout seul." },
    { type: "quote",html: "<strong>Réponse rapide :</strong> cliquez sur l'icône <strong>Application Settings</strong> (engrenage) dans le coin supérieur droit, ouvrez l'onglet <strong>Preferences</strong> et, dans la section <strong>Appearance</strong>, choisissez <strong>Light</strong>, <strong>Dark</strong> ou <strong>Automatic</strong>. Light donne un fond blanc, Dark un fond presque noir, et Automatic suit le thème système de votre ordinateur. Le changement est instantané." },
    { type: "heading",text: "Où se trouve le réglage du thème" },
    { type: "paragraph",html: "Le thème de la plateforme est une préférence au niveau du compte, et non un réglage par graphique ou par fenêtre. Modifiez-le une fois et toute l'interface est repeinte : les panneaux d'ordres, le DOM, les menus et l'arrière-plan par défaut des graphiques suivent. Comme il est lié à votre identifiant, le choix se retrouve entre l'application web et l'application de bureau lorsque vous vous connectez avec le même compte." },
    { type: "heading",text: "Comment basculer entre thème clair et sombre dans Tradovate : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez Application Settings", html: "Regardez dans le <strong class='text-white'>coin supérieur droit</strong> de la plateforme et cliquez sur l'icône <strong class='text-white'>Application Settings</strong>, l'engrenage. Cela ouvre le panneau de réglages où résident toutes les préférences de la plateforme, thème compris.", image: {"src":`${IMG}/tradovate-light-dark-mode-1.png`,"alt":"Icône d'engrenage Application Settings de Tradovate mise en évidence dans le coin supérieur droit de la plateforme"} },
        { title: "Ouvrez l'onglet Preferences", html: "Dans le panneau de réglages, sélectionnez l'onglet <strong class='text-white'>Preferences</strong> en haut. Preferences regroupe les options d'apparence ; les commandes du thème se trouvent ici plutôt que dans un menu de graphique ou d'espace de travail, ce qui déroute ceux qui fouillent dans les réglages d'un seul graphique.", image: {"src":`${IMG}/tradovate-light-dark-mode-2.png`,"alt":"Panneau de réglages Tradovate avec l'onglet Preferences sélectionné"} },
        { title: "Repérez la section Appearance", html: "La section <strong class='text-white'>Appearance</strong> se trouve tout en haut de la page Preferences. C'est le bloc qui contrôle l'arrière-plan de votre plateforme, et c'est là que sont regroupées les options clair et sombre. Inutile de défiler longtemps : c'est la première chose que vous verrez.", image: {"src":`${IMG}/tradovate-light-dark-mode-3.png`,"alt":"Section Appearance en haut de la page Preferences de Tradovate affichant les options de thème"} },
        { title: "Choisissez Light, Dark ou Automatic", html: "Choisissez maintenant votre thème. <strong class='text-white'>Light</strong> applique un fond blanc, <strong class='text-white'>Dark</strong> un fond presque noir, et l'option <strong class='text-white'>Automatic</strong> confie le contrôle à votre système d'exploitation pour que la plateforme s'aligne sur ce que votre ordinateur utilise. Cliquez sur votre choix et l'interface est repeinte instantanément : pas de bouton d'enregistrement à chercher, pas de redémarrage. Si le résultat ne vous plaît pas, cliquez sur une autre option et tout revient aussi vite.", image: {"src":`${IMG}/tradovate-light-dark-mode-4.png`,"alt":"Options Appearance de Tradovate avec les thèmes Light, Dark et Automatic"} },
      ],
    },
    { type: "heading",text: "Light, Dark ou Automatic" },
    { type: "table", headers: ["Option","Arrière-plan","Idéal pour"], rows: [
      ["Light","Blanc","Pièces lumineuses, lumière du jour, captures d'écran imprimées et ceux qui trouvent les interfaces sombres brouillonnes."],
      ["Dark","Presque noir","Sessions de nuit et de pré-marché, pièces faiblement éclairées et longues heures d'écran lorsque l'éblouissement fatigue les yeux."],
      ["Automatic","Suit votre système d'exploitation","Ceux qui configurent déjà leur ordinateur pour passer en clair le jour et en sombre la nuit."],
    ] },
    { type: "heading",text: "Le thème change tout seul en permanence ?" },
    { type: "paragraph",html: "Si votre plateforme est sombre le matin et claire l'après-midi, ou l'inverse, c'est presque certainement que l'option <strong class='text-white'>Automatic</strong> est activée. Avec ce réglage, Tradovate reflète votre système d'exploitation, et de nombreux systèmes passent d'une apparence claire en journée à une apparence sombre après le coucher du soleil. Rien n'est cassé ; la plateforme fait simplement ce que lui dicte le système." },
    { type: "paragraph",html: "Pour le figer, retournez dans <strong class='text-white'>Preferences &rarr; Appearance</strong> et désactivez <strong class='text-white'>Automatic</strong>, puis choisissez un <strong class='text-white'>Light</strong> ou un <strong class='text-white'>Dark</strong> fixe. À partir de là, le thème reste stable quoi que fasse votre ordinateur." },
    { type: "heading",text: "Une remarque sur les couleurs des graphiques" },
    { type: "paragraph",html: "Le thème contrôle l'aspect général de la plateforme et l'arrière-plan par défaut des graphiques, mais <strong class='text-white'>vos graphiques disposent de leurs propres réglages de couleur</strong> en plus. Si vous souhaitez des bougies de couleur personnalisée, une teinte de grille précise ou un arrière-plan qui ne suit pas simplement le thème de l'application, cela se règle dans les options du graphique lui-même et non ici, dans Preferences." },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Un joli thème sombre est agréable, mais le vrai gouffre de temps, c'est de surveiller l'écran à la recherche d'entrées. <strong class='text-white'>PickMyTrade relie vos alertes TradingView directement à votre compte Tradovate</strong> et passe les trades pour vous ; chaque signal se déclenche sans clic manuel, que votre plateforme soit en mode clair ou sombre." },
  ], it: [
    { type: "paragraph",html: "Fissare una piattaforma di un bianco abbagliante durante una sessione notturna stanca in fretta, e uno schermo scuro può sembrare slavato in un ufficio soleggiato. Tradovate le permette di passare dall'uno all'altro quando vuole. L'impostazione si trova in un unico punto, <strong class='text-white'>Application Settings &rarr; Preferences &rarr; Appearance</strong>, e il cambio richiede circa quattro clic. Ecco esattamente dove trovarla, più come bloccare la sua scelta affinché il tema smetta di cambiare da solo." },
    { type: "quote",html: "<strong>Risposta rapida:</strong> clicchi sull'icona <strong>Application Settings</strong> (ingranaggio) nell'angolo in alto a destra, apra la scheda <strong>Preferences</strong> e, nella sezione <strong>Appearance</strong>, scelga <strong>Light</strong>, <strong>Dark</strong> o <strong>Automatic</strong>. Light offre uno sfondo bianco, Dark uno quasi nero e Automatic segue il tema di sistema del suo computer. La modifica è immediata." },
    { type: "heading",text: "Dove si trova l'impostazione del tema" },
    { type: "paragraph",html: "Il tema della piattaforma è una preferenza a livello di account, non un'impostazione per grafico o per finestra. La modifichi una volta e l'intera interfaccia viene ridisegnata: i pannelli degli ordini, il DOM, i menu e lo sfondo predefinito del grafico la seguono. Poiché è legata al suo login, la scelta viene mantenuta tra l'app web e quella desktop quando accede con lo stesso account." },
    { type: "heading",text: "Come passare dal tema chiaro a quello scuro in Tradovate: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Apra Application Settings", html: "Guardi nell'<strong class='text-white'>angolo in alto a destra</strong> della piattaforma e clicchi sull'icona <strong class='text-white'>Application Settings</strong>, l'ingranaggio. Si apre il pannello delle impostazioni in cui risiedono tutte le preferenze valide per l'intera piattaforma, tema incluso.", image: {"src":`${IMG}/tradovate-light-dark-mode-1.png`,"alt":"Icona a ingranaggio Application Settings di Tradovate evidenziata nell'angolo in alto a destra della piattaforma"} },
        { title: "Apra la scheda Preferences", html: "All'interno del pannello delle impostazioni, selezioni la scheda <strong class='text-white'>Preferences</strong> in alto. Preferences è la sede delle opzioni di aspetto e comportamento; i controlli del tema si trovano qui e non in un menu del grafico o dell'area di lavoro, cosa che trae in inganno chi cerca nelle impostazioni di un singolo grafico.", image: {"src":`${IMG}/tradovate-light-dark-mode-2.png`,"alt":"Pannello delle impostazioni di Tradovate con la scheda Preferences selezionata"} },
        { title: "Trovi la sezione Appearance", html: "La sezione <strong class='text-white'>Appearance</strong> si trova proprio in cima alla pagina Preferences. È il blocco che controlla lo sfondo della piattaforma ed è qui che sono raggruppate le opzioni chiaro e scuro. Non deve scorrere molto: è la prima cosa che vedrà.", image: {"src":`${IMG}/tradovate-light-dark-mode-3.png`,"alt":"Sezione Appearance in cima alla pagina Preferences di Tradovate con le opzioni del tema"} },
        { title: "Scelga Light, Dark o Automatic", html: "Ora scelga il suo tema. <strong class='text-white'>Light</strong> imposta uno sfondo bianco, <strong class='text-white'>Dark</strong> uno quasi nero, e l'opzione <strong class='text-white'>Automatic</strong> cede il controllo al suo sistema operativo, così la piattaforma si adegua a ciò che usa il suo computer. Clicchi sulla sua scelta e l'interfaccia viene ridisegnata all'istante: nessun pulsante di salvataggio da cercare e nessun riavvio. Se non le piace, clicchi un'altra opzione e tornerà indietro altrettanto in fretta.", image: {"src":`${IMG}/tradovate-light-dark-mode-4.png`,"alt":"Opzioni Appearance di Tradovate con i temi Light, Dark e Automatic"} },
      ],
    },
    { type: "heading",text: "Light vs. Dark vs. Automatic" },
    { type: "table", headers: ["Opzione","Sfondo","Ideale per"], rows: [
      ["Light","Bianco","Stanze luminose, luce diurna, screenshot stampati e chi trova opache le interfacce scure."],
      ["Dark","Quasi nero","Sessioni notturne e pre-market, stanze poco illuminate e lunghe ore davanti allo schermo quando l'abbagliamento stanca gli occhi."],
      ["Automatic","Segue il suo sistema operativo","Chi già configura il computer per passare al chiaro di giorno e allo scuro di notte."],
    ] },
    { type: "heading",text: "Il tema continua a cambiare da solo?" },
    { type: "paragraph",html: "Se la sua piattaforma appare scura al mattino e chiara nel pomeriggio, o viceversa, quasi certamente ha attivato l'opzione <strong class='text-white'>Automatic</strong>. Con questa impostazione Tradovate rispecchia il suo sistema operativo, e molti sistemi sono impostati per passare da un aspetto chiaro durante il giorno a uno scuro dopo il tramonto. Non c'è nessun guasto; la piattaforma fa semplicemente ciò che le dice il sistema operativo." },
    { type: "paragraph",html: "Per bloccarlo, torni su <strong class='text-white'>Preferences &rarr; Appearance</strong> e disattivi <strong class='text-white'>Automatic</strong>, poi scelga un <strong class='text-white'>Light</strong> o un <strong class='text-white'>Dark</strong> fisso. Da quel momento il tema resta stabile qualunque cosa faccia il suo computer." },
    { type: "heading",text: "Una nota sui colori dei grafici" },
    { type: "paragraph",html: "Il tema controlla l'aspetto generale della piattaforma e lo sfondo predefinito del grafico, ma i <strong class='text-white'>suoi grafici hanno impostazioni di colore proprie</strong> in aggiunta. Se desidera colori delle candele personalizzati, una tonalità specifica della griglia o uno sfondo che non segua semplicemente il tema dell'app, lo imposti nelle opzioni del grafico stesso e non qui in Preferences." },
    { type: "heading",text: "Automatizzi tutto con PickMyTrade" },
    { type: "paragraph",html: "Un bel tema scuro è piacevole, ma il vero spreco di tempo è guardare lo schermo in cerca di ingressi. <strong class='text-white'>PickMyTrade collega i suoi alert di TradingView direttamente al suo conto Tradovate</strong> e piazza le operazioni al posto suo; ogni segnale parte senza clic manuali, sia che la piattaforma sia impostata sul tema chiaro sia su quello scuro." },
  ] },
  ctaHeading: { en: "Spend Less Time Fiddling, More Time Trading", de: "Weniger Herumprobieren, mehr Trading", es: "Menos tiempo ajustando, más tiempo operando", fr: "Moins de réglages, plus de trading", it: "Meno tempo a ritoccare, più tempo a fare trading" },
  ctaText: { en: "PickMyTrade wires your TradingView alerts straight into your Tradovate account and places trades automatically, whether your platform's set to light or dark.", de: "PickMyTrade verbindet Ihre TradingView-Alerts direkt mit Ihrem Tradovate-Konto und platziert Trades automatisch, egal ob Ihre Plattform auf Hell oder Dunkel eingestellt ist.", es: "PickMyTrade conecta sus alertas de TradingView directamente con su cuenta de Tradovate y coloca las operaciones automáticamente, tenga su plataforma en modo claro u oscuro.", fr: "PickMyTrade relie vos alertes TradingView directement à votre compte Tradovate et passe les trades automatiquement, que votre plateforme soit en mode clair ou sombre.", it: "PickMyTrade collega i suoi alert di TradingView direttamente al suo conto Tradovate e piazza le operazioni in automatico, sia che la piattaforma sia impostata sul tema chiaro sia su quello scuro." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Kostenlose 7-Tage-Testphase starten", es: "Comience su prueba gratuita de 7 días", fr: "Démarrer votre essai gratuit de 7 jours", it: "Inizi la sua prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Does the theme sync between the web and desktop apps?", a: "The theme is tied to your account preference, so signing in with the same account on both the web and desktop apps carries your choice across. If one looks different, open Preferences on that device and confirm the setting." },
    { q: "Does Tradovate have more than just light and dark?", a: "At the platform level, the two themes are Light and Dark, with Automatic as a switch between them. There's no separate charcoal or high-contrast mode at the app level, but you can recolor individual charts through their own settings." },
    { q: "Why does my theme change by itself during the day?", a: "That's the Automatic option following your operating system's day/night appearance. Turn Automatic off in Preferences → Appearance and choose a fixed Light or Dark to lock it." },
  ], de: [
    { q: "Wird das Design zwischen Web- und Desktop-App synchronisiert?", a: "Das Design ist an Ihre Kontoeinstellung gebunden. Wenn Sie sich mit demselben Konto in der Web- und der Desktop-App anmelden, wird Ihre Auswahl übernommen. Sieht eine App anders aus, öffnen Sie auf diesem Gerät die Preferences und prüfen Sie die Einstellung." },
    { q: "Bietet Tradovate mehr als nur Hell und Dunkel?", a: "Auf Plattformebene gibt es die beiden Designs Light und Dark, mit Automatic als Umschalter zwischen beiden. Einen separaten Anthrazit- oder Hochkontrastmodus gibt es auf App-Ebene nicht, Sie können einzelne Charts jedoch über deren eigene Einstellungen umfärben." },
    { q: "Warum wechselt mein Design tagsüber von selbst?", a: "Das ist die Option Automatic, die dem Tag-/Nacht-Erscheinungsbild Ihres Betriebssystems folgt. Schalten Sie Automatic unter Preferences → Appearance aus und wählen Sie ein festes Light oder Dark, um es zu fixieren." },
  ], es: [
    { q: "¿Se sincroniza el tema entre la aplicación web y la de escritorio?", a: "El tema está vinculado a la preferencia de su cuenta, por lo que al iniciar sesión con la misma cuenta en la aplicación web y en la de escritorio su elección se mantiene. Si una se ve distinta, abra Preferences en ese dispositivo y confirme el ajuste." },
    { q: "¿Tradovate ofrece algo más que claro y oscuro?", a: "A nivel de plataforma, los dos temas son Light y Dark, con Automatic como conmutador entre ambos. No hay un modo carbón o de alto contraste independiente a nivel de aplicación, pero puede cambiar los colores de gráficos individuales mediante sus propios ajustes." },
    { q: "¿Por qué mi tema cambia solo a lo largo del día?", a: "Se debe a la opción Automatic, que sigue la apariencia día/noche de su sistema operativo. Desactive Automatic en Preferences → Appearance y elija Light o Dark fijo para bloquearlo." },
  ], fr: [
    { q: "Le thème est-il synchronisé entre l'application web et l'application de bureau ?", a: "Le thème est lié à la préférence de votre compte : en vous connectant avec le même compte sur l'application web et l'application de bureau, votre choix suit. Si l'une des deux a un aspect différent, ouvrez Preferences sur cet appareil et vérifiez le réglage." },
    { q: "Tradovate propose-t-il autre chose que clair et sombre ?", a: "Au niveau de la plateforme, les deux thèmes sont Light et Dark, Automatic servant de bascule entre les deux. Il n'existe pas de mode anthracite ou à contraste élevé distinct au niveau de l'application, mais vous pouvez recolorer chaque graphique via ses propres réglages." },
    { q: "Pourquoi mon thème change-t-il tout seul dans la journée ?", a: "C'est l'option Automatic qui suit l'apparence jour/nuit de votre système d'exploitation. Désactivez Automatic dans Preferences → Appearance et choisissez un Light ou un Dark fixe pour le verrouiller." },
  ], it: [
    { q: "Il tema si sincronizza tra l'app web e quella desktop?", a: "Il tema è legato alla preferenza del suo account, quindi accedendo con lo stesso account sia all'app web sia a quella desktop la sua scelta viene mantenuta. Se una delle due appare diversa, apra Preferences su quel dispositivo e verifichi l'impostazione." },
    { q: "Tradovate offre qualcosa in più oltre al chiaro e allo scuro?", a: "A livello di piattaforma i due temi sono Light e Dark, con Automatic come commutatore tra i due. Non esiste una modalità antracite o ad alto contrasto separata a livello di app, ma può ricolorare i singoli grafici dalle loro impostazioni." },
    { q: "Perché il mio tema cambia da solo durante la giornata?", a: "È l'opzione Automatic, che segue l'aspetto giorno/notte del suo sistema operativo. Disattivi Automatic in Preferences → Appearance e scelga un Light o un Dark fisso per bloccarlo." },
  ] },
  relatedHeading: { en: "Related Guides", de: "Weitere Anleitungen", es: "Guías relacionadas", fr: "Guides associés", it: "Guide correlate" },
  disclosureText: { en: `This guide is for educational and informational purposes only and is not financial, investment, or trading advice. Trading futures and other leveraged products carries a substantial risk of loss and is not suitable for every investor. PickMyTrade is an independent third-party automation platform and is not affiliated with, endorsed by, or sponsored by Tradovate, Inc. "Tradovate" and all related names, logos, and trademarks are the property of their respective owners. Platform features and steps change over time, so always confirm the current process in the official Tradovate platform and documentation before acting.`, de: "Dieser Leitfaden dient ausschließlich Bildungs- und Informationszwecken und stellt weder Finanz-, Anlage- noch Handelsberatung dar. Der Handel mit Futures und anderen gehebelten Produkten birgt ein erhebliches Verlustrisiko und ist nicht für jeden Anleger geeignet. PickMyTrade ist eine unabhängige Automatisierungsplattform eines Drittanbieters und steht in keiner Verbindung zu Tradovate, Inc., wird weder von Tradovate, Inc. unterstützt noch gesponsert. „Tradovate“ sowie alle zugehörigen Namen, Logos und Marken sind Eigentum ihrer jeweiligen Inhaber. Funktionen und Schritte der Plattform ändern sich im Laufe der Zeit. Prüfen Sie daher stets den aktuellen Ablauf in der offiziellen Tradovate-Plattform und -Dokumentation, bevor Sie handeln.", es: "Esta guía tiene fines exclusivamente educativos e informativos y no constituye asesoramiento financiero, de inversión ni de trading. Operar con futuros y otros productos apalancados conlleva un riesgo sustancial de pérdida y no es adecuado para todos los inversores. PickMyTrade es una plataforma de automatización independiente de terceros y no está afiliada, respaldada ni patrocinada por Tradovate, Inc. «Tradovate» y todos los nombres, logotipos y marcas relacionados son propiedad de sus respectivos titulares. Las funciones y los pasos de la plataforma cambian con el tiempo, por lo que debe confirmar siempre el proceso actual en la plataforma y la documentación oficiales de Tradovate antes de actuar.", fr: "Ce guide est fourni à des fins exclusivement éducatives et informatives et ne constitue ni un conseil financier, ni un conseil en investissement, ni un conseil de trading. Le trading de contrats à terme et d'autres produits à effet de levier comporte un risque de perte important et ne convient pas à tous les investisseurs. PickMyTrade est une plateforme d'automatisation tierce indépendante et n'est ni affiliée à Tradovate, Inc., ni approuvée ou parrainée par cette dernière. « Tradovate » ainsi que tous les noms, logos et marques associés sont la propriété de leurs détenteurs respectifs. Les fonctionnalités et les étapes de la plateforme évoluent avec le temps ; vérifiez donc toujours la procédure en vigueur dans la plateforme et la documentation officielles de Tradovate avant d'agir.", it: "Questa guida ha esclusivamente finalità educative e informative e non costituisce consulenza finanziaria, di investimento o di trading. Operare in futures e in altri prodotti a leva comporta un rischio di perdita sostanziale e non è adatto a tutti gli investitori. PickMyTrade è una piattaforma di automazione indipendente di terze parti e non è affiliata, approvata né sponsorizzata da Tradovate, Inc. «Tradovate» e tutti i nomi, loghi e marchi correlati sono di proprietà dei rispettivi titolari. Le funzionalità e i passaggi della piattaforma cambiano nel tempo: confermi sempre la procedura aggiornata nella piattaforma e nella documentazione ufficiali di Tradovate prima di agire." },
};
