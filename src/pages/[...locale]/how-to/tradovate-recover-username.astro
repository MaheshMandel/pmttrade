---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-recover-username";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Recover a Forgotten Tradovate Username";
const META_DESCRIPTION =
  "Forgot which username you use for Tradovate? Retrieve it from the login screen in a few clicks using your account email. Simple step-by-step guide.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Vergessenen Tradovate-Benutzernamen wiederherstellen", es: "Cómo recuperar un nombre de usuario de Tradovate olvidado", fr: "Récupérer un nom d'utilisateur Tradovate oublié", it: "Come recuperare un nome utente Tradovate dimenticato" },
  dek: { en: "Can't remember which username you set up on Tradovate? Here's the built-in way to get it back, and it takes about a minute.", de: "Sie wissen nicht mehr, welchen Benutzernamen Sie bei Tradovate festgelegt haben? Hier ist der integrierte Weg, ihn zurückzuholen. Es dauert etwa eine Minute.", es: "¿No recuerda qué nombre de usuario configuró en Tradovate? Esta es la forma integrada de recuperarlo y lleva aproximadamente un minuto.", fr: "Vous ne vous souvenez plus du nom d'utilisateur choisi sur Tradovate ? Voici la méthode intégrée pour le retrouver, en environ une minute.", it: "Non ricorda quale nome utente ha impostato su Tradovate? Ecco il metodo integrato per recuperarlo, che richiede circa un minuto." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Passwords get all the attention, but plenty of people get stuck one step earlier: they can't remember which username they set up on Tradovate. You signed up months ago, autofill did the remembering for you ever since, and now the login screen wants something you never actually memorized. Tradovate has a built-in way to get it back, and it takes about a minute." },
    { type: "paragraph", html: "Quick heads-up before you start. This works for accounts Tradovate owns directly. If you're trading a prop firm evaluation or funded account, your login belongs to the firm, so skip down to the prop-account note instead." },
    { type: "heading", text: "What You'll Need" },
    { type: "paragraph", html: "Just one thing: access to the email inbox tied to your Tradovate account. That's where your username gets sent, and there's no other channel for it. If you've lost access to that email too, sort that out first, because the recovery flow can't reach you any other way." },
    { type: "heading", text: "How to Recover Your Tradovate Username" },
    {
      type: "steps",
      items: [
        { title: "Open the Login Screen and Click \"Need Help?\"", html: "Open the Tradovate web app, or launch the desktop or mobile app. Under the username and password boxes there's a \"Need Help?\" link. Click it. Both username recovery and password reset sit behind that same link, so you're in the right spot.", image: { src: `${IMG}/tradovate-recover-username-1.png`, alt: "Tradovate login screen with the Need Help link highlighted below the username and password fields" } },
        { title: "Select \"Retrieve Username\"", html: "The panel gives you two choices: \"Retrieve Username\" and \"Reset Password.\" Pick Retrieve Username. This is the one that digs up your login name. You're not touching your password here, so if the password still works, leave it alone.", image: { src: `${IMG}/tradovate-recover-username-2.png`, alt: "Tradovate Need Help panel showing the Retrieve Username and Reset Password options" } },
        { title: "Enter Your Account Email and Submit", html: "Type in the email address attached to your account, then submit. Small detail that trips people up: Tradovate matches what you enter against the address on file and sends your username there. It won't fire it off to some other inbox you type in, so it has to be the exact email you registered with.", image: { src: `${IMG}/tradovate-recover-username-3.png`, alt: "Tradovate Retrieve Username form with a field for the account email address" } },
        { title: "Open the Email to Find Your Username", html: "Head to your inbox. The message with your username usually lands within a minute or two. Open it and your login name is right there. Copy it exactly. Usernames can be case-sensitive, and one stray capital letter is enough to bounce you at the login screen.", image: { src: `${IMG}/tradovate-recover-username-4.png`, alt: "Email from Tradovate showing the recovered account username" } },
        { title: "Return to the Login Screen and Sign In", html: "Go back to the login page, drop in the username you just recovered, and enter your password. If the password's also a blur, that's a separate fix. Run Reset Password from the same \"Need Help?\" menu and you'll be back in. Otherwise you're done.", image: { src: `${IMG}/tradovate-recover-username-5.png`, alt: "Tradovate login screen with the recovered username entered and ready to sign in" } },
      ],
    },
    { type: "heading", text: "Didn't Get the Email?" },
    { type: "paragraph", html: "If nothing shows up, run through these before you try again:" },
    {
      type: "list",
      items: [
        "Check spam and junk. Recovery mail lands there more often than you'd expect.",
        "Make sure you used the registered email. If you signed up with one of several addresses, try the other one.",
        "Give it a few minutes before requesting again. Hammering the button won't make it arrive faster.",
        "If you opened the account through a broker or partner, the original welcome email may have come from them, which is a good hint about which address is on file.",
      ],
    },
    { type: "quote", html: "Tradovate will never ask you for your password. Any email or person pushing you to hand it over is a scam, however official it looks. Recovery only ever sends your username to the inbox already on your account." },
    { type: "heading", text: "Prop Firm or Evaluation Accounts" },
    { type: "paragraph", html: "Trading a prop firm evaluation or a funded account? Your username was handed to you by the firm, not created through Tradovate, and it usually follows the firm's own format rather than something you picked. The \"Need Help?\" recovery on Tradovate's screen can't pull it up, because Tradovate doesn't manage that login. Recovery steps vary by firm and account, so check your firm's current process. It's normally in your purchase confirmation email or on your dashboard on the firm's own site, and if you can't find it there, contact the firm directly." },
    { type: "heading", text: "More Than One Account? You May Have More Than One Username" },
    { type: "paragraph", html: "If you run a personal account alongside a prop evaluation, or a live account next to a demo, there may be a couple of usernames floating around. Retrieve Username returns the name tied to whatever email you enter, so if you set up different accounts under different addresses, run the recovery once for each inbox. Whichever username Tradovate sends back is the login for that specific account." },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Back in and ready to trade? Stop babysitting the login. <strong class='text-white'>PickMyTrade routes your TradingView alerts straight to Tradovate automatically</strong>, so your strategy keeps firing whether you're watching the screen or not." },
  ], de: [
    { type: "paragraph",html: "Passwörter bekommen die ganze Aufmerksamkeit, doch viele Nutzer scheitern schon einen Schritt früher: Sie wissen nicht mehr, welchen Benutzernamen sie bei Tradovate festgelegt haben. Sie haben sich vor Monaten registriert, die Autofill-Funktion hat sich seitdem für Sie erinnert, und nun verlangt der Anmeldebildschirm etwas, das Sie nie auswendig gelernt haben. Tradovate bietet einen integrierten Weg, ihn zurückzuholen, und er dauert etwa eine Minute." },
    { type: "paragraph",html: "Kurzer Hinweis vorab: Das funktioniert für Konten, die direkt bei Tradovate geführt werden. Wenn Sie eine Prop-Firm-Evaluierung oder ein finanziertes Konto handeln, gehört Ihr Login der Firma. Springen Sie in diesem Fall direkt zum Hinweis zu Prop-Konten." },
    { type: "heading",text: "Was Sie benötigen" },
    { type: "paragraph",html: "Nur eine Sache: Zugriff auf das E-Mail-Postfach, das mit Ihrem Tradovate-Konto verknüpft ist. Dorthin wird Ihr Benutzername gesendet, einen anderen Kanal gibt es nicht. Wenn Sie auch den Zugriff auf diese E-Mail verloren haben, klären Sie das zuerst, denn der Wiederherstellungsprozess kann Sie sonst nicht erreichen." },
    { type: "heading",text: "So stellen Sie Ihren Tradovate-Benutzernamen wieder her" },
    {
      type: "steps",
      items: [
        { title: "Öffnen Sie den Anmeldebildschirm und klicken Sie auf „Need Help?“", html: "Öffnen Sie die Tradovate-Web-App oder starten Sie die Desktop- bzw. Mobile-App. Unter den Feldern für Benutzername und Passwort finden Sie den Link „Need Help?“. Klicken Sie darauf. Sowohl die Wiederherstellung des Benutzernamens als auch das Zurücksetzen des Passworts befinden sich hinter diesem Link, Sie sind also an der richtigen Stelle.", image: {"src":`${IMG}/tradovate-recover-username-1.png`,"alt":"Tradovate-Anmeldebildschirm mit hervorgehobenem Link Need Help unter den Feldern für Benutzername und Passwort"} },
        { title: "Wählen Sie „Retrieve Username“", html: "Das Panel bietet zwei Optionen: „Retrieve Username“ und „Reset Password.“ Wählen Sie Retrieve Username. Damit finden Sie Ihren Anmeldenamen. Ihr Passwort wird hier nicht angetastet. Wenn es noch funktioniert, lassen Sie es also unberührt.", image: {"src":`${IMG}/tradovate-recover-username-2.png`,"alt":"Tradovate-Need-Help-Panel mit den Optionen Retrieve Username und Reset Password"} },
        { title: "Geben Sie die E-Mail-Adresse Ihres Kontos ein und senden Sie ab", html: "Tragen Sie die mit Ihrem Konto verknüpfte E-Mail-Adresse ein und senden Sie das Formular ab. Ein Detail, über das viele stolpern: Tradovate gleicht Ihre Eingabe mit der hinterlegten Adresse ab und sendet den Benutzernamen dorthin. Er wird nicht an ein anderes Postfach geschickt, das Sie eintippen. Es muss also genau die E-Mail-Adresse sein, mit der Sie sich registriert haben.", image: {"src":`${IMG}/tradovate-recover-username-3.png`,"alt":"Tradovate-Formular Retrieve Username mit einem Feld für die E-Mail-Adresse des Kontos"} },
        { title: "Öffnen Sie die E-Mail, um Ihren Benutzernamen zu finden", html: "Schauen Sie in Ihr Postfach. Die Nachricht mit Ihrem Benutzernamen trifft meist innerhalb von ein bis zwei Minuten ein. Öffnen Sie sie, und Ihr Anmeldename steht direkt dort. Kopieren Sie ihn exakt. Benutzernamen können zwischen Groß- und Kleinschreibung unterscheiden, und ein einziger falscher Großbuchstabe reicht, damit die Anmeldung scheitert.", image: {"src":`${IMG}/tradovate-recover-username-4.png`,"alt":"E-Mail von Tradovate mit dem wiederhergestellten Benutzernamen des Kontos"} },
        { title: "Kehren Sie zum Anmeldebildschirm zurück und melden Sie sich an", html: "Gehen Sie zurück zur Anmeldeseite, geben Sie den wiederhergestellten Benutzernamen ein und tippen Sie Ihr Passwort ein. Wenn Sie auch das Passwort vergessen haben, ist das ein separates Problem. Führen Sie im selben Menü „Need Help?“ die Option Reset Password aus, und Sie sind wieder drin. Andernfalls sind Sie fertig.", image: {"src":`${IMG}/tradovate-recover-username-5.png`,"alt":"Tradovate-Anmeldebildschirm mit eingegebenem wiederhergestelltem Benutzernamen, bereit zur Anmeldung"} },
      ],
    },
    { type: "heading",text: "Keine E-Mail erhalten?" },
    { type: "paragraph",html: "Wenn nichts ankommt, gehen Sie diese Punkte durch, bevor Sie es erneut versuchen:" },
    {
      type: "list",
      items: [
        "Prüfen Sie Spam und Junk. Wiederherstellungs-E-Mails landen dort öfter, als man denkt.",
        "Stellen Sie sicher, dass Sie die registrierte E-Mail-Adresse verwendet haben. Wenn Sie sich mit einer von mehreren Adressen angemeldet haben, versuchen Sie die andere.",
        "Warten Sie einige Minuten, bevor Sie erneut anfordern. Wiederholtes Klicken beschleunigt die Zustellung nicht.",
        "Wenn Sie das Konto über einen Broker oder Partner eröffnet haben, kam die ursprüngliche Willkommens-E-Mail möglicherweise von diesem. Das ist ein guter Hinweis darauf, welche Adresse hinterlegt ist.",
      ],
    },
    { type: "quote",html: "Tradovate wird Sie niemals nach Ihrem Passwort fragen. Jede E-Mail oder Person, die Sie dazu drängt, es herauszugeben, ist ein Betrug, egal wie offiziell sie wirkt. Die Wiederherstellung sendet Ihren Benutzernamen immer nur an das Postfach, das bereits Ihrem Konto zugeordnet ist." },
    { type: "heading",text: "Prop-Firm- oder Evaluierungskonten" },
    { type: "paragraph",html: "Handeln Sie eine Prop-Firm-Evaluierung oder ein finanziertes Konto? Ihren Benutzernamen hat Ihnen die Firma zugewiesen, er wurde nicht über Tradovate erstellt und folgt meist dem Format der Firma statt einem selbst gewählten. Die Wiederherstellung über „Need Help?“ auf dem Tradovate-Bildschirm kann ihn nicht abrufen, weil Tradovate diesen Login nicht verwaltet. Die Schritte zur Wiederherstellung unterscheiden sich je nach Firma und Konto, prüfen Sie daher den aktuellen Prozess Ihrer Firma. Meist finden Sie ihn in der Kaufbestätigung per E-Mail oder in Ihrem Dashboard auf der Website der Firma. Wenn Sie ihn dort nicht finden, wenden Sie sich direkt an die Firma." },
    { type: "heading",text: "Mehr als ein Konto? Dann haben Sie möglicherweise mehr als einen Benutzernamen" },
    { type: "paragraph",html: "Wenn Sie neben einer Prop-Evaluierung ein privates Konto führen oder ein Live-Konto neben einem Demo-Konto, kann es mehrere Benutzernamen geben. Retrieve Username liefert den Namen, der zur eingegebenen E-Mail-Adresse gehört. Wenn Sie verschiedene Konten mit unterschiedlichen Adressen eingerichtet haben, führen Sie die Wiederherstellung also einmal pro Postfach durch. Der von Tradovate zurückgesendete Benutzername ist jeweils der Login für das betreffende Konto." },
    { type: "heading",text: "Automatisieren Sie das mit PickMyTrade" },
    { type: "paragraph",html: "Wieder drin und bereit zum Handeln? Hören Sie auf, den Login zu babysitten. <strong class='text-white'>PickMyTrade leitet Ihre TradingView-Alerts automatisch direkt an Tradovate weiter</strong>, damit Ihre Strategie weiterläuft, egal ob Sie auf den Bildschirm schauen oder nicht." },
  ], es: [
    { type: "paragraph",html: "Las contraseñas se llevan toda la atención, pero muchas personas se quedan atascadas un paso antes: no recuerdan qué nombre de usuario configuraron en Tradovate. Se registró hace meses, el autocompletado ha recordado por usted desde entonces, y ahora la pantalla de inicio de sesión le pide algo que nunca memorizó. Tradovate tiene una forma integrada de recuperarlo y lleva aproximadamente un minuto." },
    { type: "paragraph",html: "Una advertencia rápida antes de empezar. Esto funciona para cuentas que Tradovate gestiona directamente. Si opera una evaluación o una cuenta fondeada de una prop firm, su inicio de sesión pertenece a la firma, así que salte a la nota sobre cuentas prop." },
    { type: "heading",text: "Qué necesitará" },
    { type: "paragraph",html: "Solo una cosa: acceso a la bandeja de entrada del correo asociado a su cuenta de Tradovate. Allí se envía su nombre de usuario y no existe otro canal. Si también ha perdido el acceso a ese correo, resuélvalo primero, porque el proceso de recuperación no puede contactarle de ninguna otra forma." },
    { type: "heading",text: "Cómo recuperar su nombre de usuario de Tradovate" },
    {
      type: "steps",
      items: [
        { title: "Abra la pantalla de inicio de sesión y haga clic en «Need Help?»", html: "Abra la aplicación web de Tradovate o inicie la aplicación de escritorio o móvil. Debajo de los campos de usuario y contraseña hay un enlace «Need Help?». Haga clic en él. Tanto la recuperación del nombre de usuario como el restablecimiento de la contraseña están tras ese mismo enlace, así que está en el lugar correcto.", image: {"src":`${IMG}/tradovate-recover-username-1.png`,"alt":"Pantalla de inicio de sesión de Tradovate con el enlace Need Help resaltado debajo de los campos de usuario y contraseña"} },
        { title: "Seleccione «Retrieve Username»", html: "El panel le ofrece dos opciones: «Retrieve Username» y «Reset Password.» Elija Retrieve Username. Es la que localiza su nombre de inicio de sesión. Aquí no toca su contraseña, así que si todavía funciona, déjela como está.", image: {"src":`${IMG}/tradovate-recover-username-2.png`,"alt":"Panel Need Help de Tradovate con las opciones Retrieve Username y Reset Password"} },
        { title: "Introduzca el correo de su cuenta y envíelo", html: "Escriba la dirección de correo asociada a su cuenta y envíela. Un detalle que confunde a muchos: Tradovate compara lo que introduce con la dirección registrada y envía su nombre de usuario allí. No lo enviará a otra bandeja de entrada que escriba, por lo que debe ser exactamente el correo con el que se registró.", image: {"src":`${IMG}/tradovate-recover-username-3.png`,"alt":"Formulario Retrieve Username de Tradovate con un campo para el correo electrónico de la cuenta"} },
        { title: "Abra el correo para encontrar su nombre de usuario", html: "Vaya a su bandeja de entrada. El mensaje con su nombre de usuario suele llegar en uno o dos minutos. Ábralo y su nombre de inicio de sesión estará ahí. Cópielo exactamente. Los nombres de usuario pueden distinguir entre mayúsculas y minúsculas, y una sola mayúscula errónea basta para que se rechace el inicio de sesión.", image: {"src":`${IMG}/tradovate-recover-username-4.png`,"alt":"Correo de Tradovate que muestra el nombre de usuario de la cuenta recuperado"} },
        { title: "Vuelva a la pantalla de inicio de sesión e inicie sesión", html: "Regrese a la página de inicio de sesión, introduzca el nombre de usuario que acaba de recuperar y escriba su contraseña. Si tampoco recuerda la contraseña, es otro problema. Ejecute Reset Password desde el mismo menú «Need Help?» y volverá a entrar. De lo contrario, ya está.", image: {"src":`${IMG}/tradovate-recover-username-5.png`,"alt":"Pantalla de inicio de sesión de Tradovate con el nombre de usuario recuperado introducido y lista para iniciar sesión"} },
      ],
    },
    { type: "heading",text: "¿No recibió el correo?" },
    { type: "paragraph",html: "Si no aparece nada, repase estos puntos antes de intentarlo de nuevo:" },
    {
      type: "list",
      items: [
        "Revise spam y correo no deseado. Los correos de recuperación acaban allí más a menudo de lo que cabría esperar.",
        "Asegúrese de haber usado el correo registrado. Si se registró con una de varias direcciones, pruebe con la otra.",
        "Espere unos minutos antes de volver a solicitarlo. Pulsar el botón repetidamente no hará que llegue más rápido.",
        "Si abrió la cuenta a través de un bróker o socio, es posible que el correo de bienvenida original proviniera de ellos, lo cual es una buena pista sobre qué dirección está registrada.",
      ],
    },
    { type: "quote",html: "Tradovate nunca le pedirá su contraseña. Cualquier correo o persona que le presione para que la entregue es una estafa, por oficial que parezca. La recuperación solo envía su nombre de usuario a la bandeja de entrada que ya figura en su cuenta." },
    { type: "heading",text: "Cuentas de prop firm o de evaluación" },
    { type: "paragraph",html: "¿Opera una evaluación o una cuenta fondeada de una prop firm? Su nombre de usuario se lo asignó la firma, no se creó a través de Tradovate, y normalmente sigue el formato de la propia firma en lugar de uno elegido por usted. La recuperación «Need Help?» de la pantalla de Tradovate no puede encontrarlo, porque Tradovate no gestiona ese inicio de sesión. Los pasos de recuperación varían según la firma y la cuenta, así que consulte el proceso actual de su firma. Normalmente figura en el correo de confirmación de compra o en su panel en el sitio web de la firma, y si no lo encuentra allí, póngase en contacto directamente con la firma." },
    { type: "heading",text: "¿Más de una cuenta? Puede tener más de un nombre de usuario" },
    { type: "paragraph",html: "Si tiene una cuenta personal junto con una evaluación prop, o una cuenta real junto a una demo, puede haber varios nombres de usuario. Retrieve Username devuelve el nombre asociado al correo que introduzca, así que si configuró distintas cuentas con diferentes direcciones, ejecute la recuperación una vez por cada bandeja de entrada. El nombre de usuario que Tradovate le devuelva es el inicio de sesión de esa cuenta concreta." },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "¿Ya ha vuelto a entrar y está listo para operar? Deje de vigilar el inicio de sesión. <strong class='text-white'>PickMyTrade envía sus alertas de TradingView directamente a Tradovate de forma automática</strong>, para que su estrategia siga ejecutándose tanto si está mirando la pantalla como si no." },
  ], fr: [
    { type: "paragraph",html: "Les mots de passe captent toute l'attention, mais beaucoup de gens butent une étape plus tôt : ils ne se souviennent plus du nom d'utilisateur choisi sur Tradovate. Vous vous êtes inscrit il y a des mois, le remplissage automatique s'est souvenu pour vous depuis, et l'écran de connexion réclame maintenant quelque chose que vous n'avez jamais mémorisé. Tradovate propose une méthode intégrée pour le retrouver, et cela prend environ une minute." },
    { type: "paragraph",html: "Petit avertissement avant de commencer. Cela fonctionne pour les comptes gérés directement par Tradovate. Si vous tradez une évaluation ou un compte financé d'une prop firm, votre identifiant appartient à la société ; passez alors directement à la note sur les comptes prop." },
    { type: "heading",text: "Ce dont vous avez besoin" },
    { type: "paragraph",html: "Une seule chose : l'accès à la boîte de réception associée à votre compte Tradovate. C'est là que votre nom d'utilisateur est envoyé, et il n'existe aucun autre canal. Si vous avez aussi perdu l'accès à cette adresse e-mail, réglez d'abord ce problème, car la procédure de récupération ne peut pas vous joindre autrement." },
    { type: "heading",text: "Comment récupérer votre nom d'utilisateur Tradovate" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez l'écran de connexion et cliquez sur « Need Help? »", html: "Ouvrez l'application web Tradovate, ou lancez l'application de bureau ou mobile. Sous les champs du nom d'utilisateur et du mot de passe se trouve un lien « Need Help? ». Cliquez dessus. La récupération du nom d'utilisateur et la réinitialisation du mot de passe se trouvent toutes deux derrière ce même lien, vous êtes donc au bon endroit.", image: {"src":`${IMG}/tradovate-recover-username-1.png`,"alt":"Écran de connexion Tradovate avec le lien Need Help mis en évidence sous les champs du nom d'utilisateur et du mot de passe"} },
        { title: "Sélectionnez « Retrieve Username »", html: "Le panneau propose deux choix : « Retrieve Username » et « Reset Password. » Choisissez Retrieve Username. C'est l'option qui retrouve votre identifiant. Vous ne touchez pas à votre mot de passe ici ; s'il fonctionne encore, laissez-le tel quel.", image: {"src":`${IMG}/tradovate-recover-username-2.png`,"alt":"Panneau Need Help de Tradovate affichant les options Retrieve Username et Reset Password"} },
        { title: "Saisissez l'e-mail de votre compte et validez", html: "Saisissez l'adresse e-mail associée à votre compte, puis validez. Un détail qui piège beaucoup de monde : Tradovate compare ce que vous saisissez à l'adresse enregistrée et y envoie votre nom d'utilisateur. Il ne l'enverra pas vers une autre boîte que vous taperiez ; il doit donc s'agir exactement de l'e-mail avec lequel vous vous êtes inscrit.", image: {"src":`${IMG}/tradovate-recover-username-3.png`,"alt":"Formulaire Retrieve Username de Tradovate avec un champ pour l'adresse e-mail du compte"} },
        { title: "Ouvrez l'e-mail pour trouver votre nom d'utilisateur", html: "Rendez-vous dans votre boîte de réception. Le message contenant votre nom d'utilisateur arrive généralement en une ou deux minutes. Ouvrez-le et votre identifiant s'y trouve. Copiez-le exactement. Les noms d'utilisateur peuvent être sensibles à la casse, et une seule majuscule en trop suffit pour être refusé sur l'écran de connexion.", image: {"src":`${IMG}/tradovate-recover-username-4.png`,"alt":"E-mail de Tradovate affichant le nom d'utilisateur du compte récupéré"} },
