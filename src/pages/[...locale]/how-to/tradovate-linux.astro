---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-linux";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Running Tradovate on Linux (Browser Only)";
const META_DESCRIPTION =
  "There's no native Linux app for this futures platform. Run it in any modern browser on Ubuntu, Fedora or Mint, plus the quirks to watch for.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate unter Linux nutzen (nur im Browser)", es: "Cómo usar Tradovate en Linux (solo navegador)", fr: "Utiliser Tradovate sous Linux (navigateur uniquement)", it: "Usare Tradovate su Linux (solo browser)" },
  dek: { en: "There's no native Tradovate app for Linux, and there isn't one on the way. Here's how to run the full Web Trader in any modern browser on Ubuntu, Fedora, Mint, or Pop!_OS, plus the quirks worth knowing.", de: "Es gibt keine native Tradovate-App für Linux, und eine ist auch nicht in Planung. So führen Sie den vollständigen Web Trader in jedem modernen Browser unter Ubuntu, Fedora, Mint oder Pop!_OS aus, plus die Besonderheiten, die Sie kennen sollten.", es: "No existe una app nativa de Tradovate para Linux, ni está prevista. Aquí le explicamos cómo ejecutar el Web Trader completo en cualquier navegador moderno en Ubuntu, Fedora, Mint o Pop!_OS, además de las particularidades que conviene conocer.", fr: "Il n’existe pas d’application Tradovate native pour Linux, et aucune n’est prévue. Voici comment exécuter le Web Trader complet dans n’importe quel navigateur moderne sous Ubuntu, Fedora, Mint ou Pop!_OS, ainsi que les particularités à connaître.", it: "Non esiste un’app Tradovate nativa per Linux, e non è prevista. Ecco come eseguire il Web Trader completo in qualsiasi browser moderno su Ubuntu, Fedora, Mint o Pop!_OS, oltre alle particolarità che vale la pena conoscere." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Short answer: there's no native Tradovate app for Linux, and there isn't one on the way. Tradovate's desktop downloads cover Windows and Mac only. So if you're on Ubuntu, Fedora, Mint, Pop!_OS, or any other distro, you run Tradovate the same way you'd open any website, through the browser. The Web Trader is the full platform, not a stripped-down version, so you're not giving much up by skipping a desktop install." },
    { type: "paragraph", html: "Here's how to get set up on Linux, plus the handful of quirks worth knowing before you trade real size." },
    { type: "heading", text: "Is There a Tradovate Desktop App for Linux?" },
    { type: "paragraph", html: "No. Tradovate ships desktop installers for Windows and Mac, native mobile apps for Android and iOS, and a browser-based Web Trader that runs anywhere. Linux isn't on the desktop list and hasn't been added despite years of requests. The upside: the Web Trader is built in HTML5, so it doesn't care whether it runs on Windows, macOS, or your Linux box, the same charts, DOM, and order tools load in the browser." },
    { type: "heading", text: "How to Run Tradovate on Linux: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Pick a Modern Browser", html: "Any current browser on your distro will do. Chrome is the one Tradovate points people to, and it's the smoothest on Linux. Firefox, Chromium, Brave, and the Linux build of Edge all load the Web Trader fine. Whatever you pick, keep it updated, an old build is the most common reason a chart or order panel won't render." },
        { title: "Open the Tradovate Web Trader", html: "Type <strong class='text-white'>trader.tradovate.com/welcome</strong> into the address bar and hit enter, then bookmark it so it's one click away next time. This is the exact platform Windows and Mac traders use; it just loads in your browser instead of a downloaded program. Nothing to install, no dependencies to chase down." },
        { title: "Log In and Select Your Account", html: "Sign in with your Tradovate username and password. On a prop-firm or evaluation account, use the login the firm gave you, not a personal Tradovate one. Then pick the right account from the selector before placing anything, it's easy to fire an order into the wrong one when demo and live sit side by side." },
        { title: "Install It as a Standalone Window (Optional)", html: "If you want something that feels more like a desktop app than a browser tab, Chrome and Chromium can turn the Web Trader into its own window. Open the browser menu and look for <strong class='text-white'>Install</strong> or <strong class='text-white'>Create shortcut</strong> (the exact wording depends on your browser version). That launches Tradovate in a clean window with no tabs and no address bar, and drops a launcher in your applications menu. It's still the web version under the hood, it just gets out of your way." },
        { title: "Confirm Data and Save Your Workspace", html: "Before you trade, confirm your market data is live rather than delayed, a delayed symbol won't behave the way you expect. Then arrange your DOM, charts, and order tickets and save the layout. Tradovate stores it against your login, so it returns the same next session." },
      ],
    },
    { type: "heading", text: "Known Quirks on Linux" },
    { type: "paragraph", html: "The Web Trader works well on Linux, but a few things behave differently than they do on Windows or Mac. None of them are dealbreakers if you know to expect them:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Theme colors can render differently.</strong> On some Linux setups the dark and light themes don't match what you'd see on Windows, colors that should be white show up dark, or vice versa. If the platform looks off, switch the theme inside Tradovate or try a different browser.",
        "<strong class='text-white'>The built-in charts have limits.</strong> They're fine for order flow and standard timeframes but not as deep as a dedicated charting tool, sub-minute charts and advanced drawing tools may need a TradingView connection.",
        "<strong class='text-white'>Watch your session count.</strong> Tradovate caps how many active sessions you can run at once. Logging in on the browser, the mobile app, and TradingView all at the same time can trip disconnects or frozen charts, check the current session rules and stay under them.",
        "<strong class='text-white'>Keep your clock synced.</strong> An out-of-sync system clock causes login failures and streaming glitches. Most distros sync time automatically over NTP, so leave that enabled.",
        "<strong class='text-white'>Keep a backup.</strong> Install the Android or iOS app on your phone so you can flatten or manage positions if your browser hiccups mid-trade.",
      ],
    },
    { type: "paragraph", html: "If charts ever come up blank or blacked out on the web version, that's usually a cache or refresh issue rather than something Linux-specific." },
    { type: "heading", text: "Automate Tradovate From Linux With PickMyTrade" },
    { type: "paragraph", html: "Because PickMyTrade runs in the cloud, your operating system doesn't matter. Your TradingView alerts fire orders straight through to Tradovate whether your machine runs Ubuntu, Windows, or nothing at all. Set it up once and your strategy executes on its own, no desktop app, no OS lock-in." },
  ], de: [
    { type: "paragraph",html: "Die kurze Antwort: Es gibt keine native Tradovate-App für Linux, und eine ist auch nicht in Planung. Die Desktop-Downloads von Tradovate decken nur Windows und Mac ab. Wenn Sie also Ubuntu, Fedora, Mint, Pop!_OS oder eine andere Distribution nutzen, starten Sie Tradovate so, wie Sie jede Website öffnen würden: über den Browser. Der Web Trader ist die vollständige Plattform, keine abgespeckte Version, Sie verzichten also kaum auf etwas, wenn Sie die Desktop-Installation auslassen." },
    { type: "paragraph",html: "So richten Sie alles unter Linux ein, plus die paar Besonderheiten, die Sie kennen sollten, bevor Sie mit echtem Volumen handeln." },
    { type: "heading",text: "Gibt es eine Tradovate-Desktop-App für Linux?" },
    { type: "paragraph",html: "Nein. Tradovate liefert Desktop-Installer für Windows und Mac, native Mobile-Apps für Android und iOS sowie einen browserbasierten Web Trader, der überall läuft. Linux steht nicht auf der Desktop-Liste und wurde trotz jahrelanger Wünsche nicht hinzugefügt. Der Vorteil: Der Web Trader ist in HTML5 gebaut und kümmert sich nicht darum, ob er unter Windows, macOS oder auf Ihrem Linux-Rechner läuft; dieselben Charts, dasselbe DOM und dieselben Order-Tools laden im Browser." },
    { type: "heading",text: "Tradovate unter Linux ausführen: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Einen modernen Browser wählen", html: "Jeder aktuelle Browser Ihrer Distribution genügt. Chrome ist der Browser, auf den Tradovate verweist, und unter Linux der flüssigste. Firefox, Chromium, Brave und die Linux-Version von Edge laden den Web Trader ebenfalls problemlos. Welchen Sie auch wählen, halten Sie ihn aktuell: Ein veralteter Build ist der häufigste Grund, warum ein Chart oder ein Order-Panel nicht dargestellt wird." },
        { title: "Den Tradovate Web Trader öffnen", html: "Geben Sie <strong class='text-white'>trader.tradovate.com/welcome</strong> in die Adressleiste ein und drücken Sie die Eingabetaste. Setzen Sie anschließend ein Lesezeichen, damit es beim nächsten Mal nur einen Klick entfernt ist. Das ist genau die Plattform, die Windows- und Mac-Händler nutzen; sie lädt nur in Ihrem Browser statt als heruntergeladenes Programm. Nichts zu installieren, keine Abhängigkeiten, die Sie suchen müssten." },
        { title: "Anmelden und Ihr Konto auswählen", html: "Melden Sie sich mit Ihrem Tradovate-Benutzernamen und Passwort an. Bei einem Prop-Firm- oder Evaluierungskonto verwenden Sie den Login, den Ihnen die Firma gegeben hat, nicht einen persönlichen Tradovate-Login. Wählen Sie dann das richtige Konto im Kontoauswahlfeld aus, bevor Sie etwas platzieren. Es passiert leicht, dass eine Order im falschen Konto landet, wenn Demo- und Live-Konto nebeneinander liegen." },
        { title: "Als eigenständiges Fenster installieren (optional)", html: "Wenn Sie etwas möchten, das sich eher wie eine Desktop-App als wie ein Browser-Tab anfühlt, können Chrome und Chromium den Web Trader in ein eigenes Fenster verwandeln. Öffnen Sie das Browsermenü und suchen Sie nach <strong class='text-white'>Install</strong> oder <strong class='text-white'>Create shortcut</strong> (die genaue Bezeichnung hängt von Ihrer Browserversion ab). Dadurch startet Tradovate in einem sauberen Fenster ohne Tabs und ohne Adressleiste und legt einen Starter in Ihrem Anwendungsmenü ab. Im Hintergrund ist es weiterhin die Webversion, sie bleibt nur aus dem Weg." },
        { title: "Daten bestätigen und Arbeitsbereich speichern", html: "Bevor Sie handeln, vergewissern Sie sich, dass Ihre Marktdaten live und nicht verzögert sind, denn ein verzögertes Symbol verhält sich nicht so, wie Sie es erwarten. Ordnen Sie dann Ihr DOM, Ihre Charts und Order-Tickets an und speichern Sie das Layout. Tradovate speichert es zu Ihrem Login, sodass es in der nächsten Sitzung unverändert wiederkehrt." },
      ],
    },
    { type: "heading",text: "Bekannte Besonderheiten unter Linux" },
    { type: "paragraph",html: "Der Web Trader läuft unter Linux gut, aber einige Dinge verhalten sich anders als unter Windows oder Mac. Keine davon ist ein Hindernis, wenn Sie sie erwarten:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Designfarben können anders dargestellt werden.</strong> Auf manchen Linux-Setups entsprechen das dunkle und das helle Design nicht dem, was Sie unter Windows sehen: Farben, die weiß sein sollten, erscheinen dunkel, oder umgekehrt. Wenn die Plattform seltsam aussieht, wechseln Sie das Design in Tradovate oder probieren Sie einen anderen Browser.",
        "<strong class='text-white'>Die integrierten Charts haben Grenzen.</strong> Sie reichen für Orderflow und Standard-Zeitrahmen, sind aber nicht so umfangreich wie ein spezialisiertes Chart-Tool; Charts unter einer Minute und erweiterte Zeichenwerkzeuge erfordern möglicherweise eine TradingView-Verbindung.",
        "<strong class='text-white'>Behalten Sie Ihre Sitzungsanzahl im Blick.</strong> Tradovate begrenzt, wie viele aktive Sitzungen gleichzeitig laufen dürfen. Wenn Sie sich gleichzeitig im Browser, in der Mobile-App und in TradingView anmelden, kann das Verbindungsabbrüche oder eingefrorene Charts auslösen. Prüfen Sie die aktuellen Sitzungsregeln und bleiben Sie darunter.",
        "<strong class='text-white'>Halten Sie Ihre Uhr synchron.</strong> Eine nicht synchronisierte Systemuhr führt zu Login-Fehlern und Streaming-Problemen. Die meisten Distributionen synchronisieren die Zeit automatisch per NTP, lassen Sie das also aktiviert.",
        "<strong class='text-white'>Halten Sie ein Backup bereit.</strong> Installieren Sie die Android- oder iOS-App auf Ihrem Smartphone, damit Sie Positionen glattstellen oder verwalten können, falls Ihr Browser mitten im Trade hängt.",
      ],
    },
    { type: "paragraph",html: "Wenn Charts in der Webversion leer oder schwarz erscheinen, liegt das meist an einem Cache- oder Aktualisierungsproblem und nicht an etwas Linux-Spezifischem." },
    { type: "heading",text: "Tradovate unter Linux mit PickMyTrade automatisieren" },
    { type: "paragraph",html: "Da PickMyTrade in der Cloud läuft, spielt Ihr Betriebssystem keine Rolle. Ihre TradingView-Alarme senden Orders direkt an Tradovate, egal ob Ihr Rechner Ubuntu, Windows oder gar nichts ausführt. Einmal einrichten, und Ihre Strategie läuft selbstständig, ohne Desktop-App und ohne Betriebssystem-Bindung." },
  ], es: [
    { type: "paragraph",html: "Respuesta corta: no existe una app nativa de Tradovate para Linux, ni está prevista. Las descargas de escritorio de Tradovate cubren solo Windows y Mac. Así que, si usa Ubuntu, Fedora, Mint, Pop!_OS o cualquier otra distribución, ejecuta Tradovate igual que abriría cualquier sitio web: a través del navegador. El Web Trader es la plataforma completa, no una versión recortada, así que no renuncia a mucho al saltarse la instalación de escritorio." },
    { type: "paragraph",html: "Así se configura en Linux, además de las pocas particularidades que conviene conocer antes de operar con tamaño real." },
    { type: "heading",text: "¿Existe una app de escritorio de Tradovate para Linux?" },
    { type: "paragraph",html: "No. Tradovate ofrece instaladores de escritorio para Windows y Mac, apps móviles nativas para Android e iOS, y un Web Trader basado en navegador que funciona en cualquier lugar. Linux no figura en la lista de escritorio y no se ha añadido pese a años de peticiones. La ventaja: el Web Trader está construido en HTML5, así que le da igual si se ejecuta en Windows, macOS o en su equipo Linux; los mismos gráficos, DOM y herramientas de órdenes se cargan en el navegador." },
    { type: "heading",text: "Cómo ejecutar Tradovate en Linux: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Elija un navegador moderno", html: "Sirve cualquier navegador actual de su distribución. Chrome es el que Tradovate recomienda y el más fluido en Linux. Firefox, Chromium, Brave y la versión de Edge para Linux cargan bien el Web Trader. Elija el que elija, manténgalo actualizado: una versión antigua es la causa más habitual de que un gráfico o un panel de órdenes no se muestre." },
        { title: "Abra el Web Trader de Tradovate", html: "Escriba <strong class='text-white'>trader.tradovate.com/welcome</strong> en la barra de direcciones y pulse Intro; luego guárdelo en marcadores para tenerlo a un clic la próxima vez. Esta es exactamente la plataforma que usan los traders de Windows y Mac; simplemente se carga en su navegador en lugar de como un programa descargado. Nada que instalar, sin dependencias que buscar." },
        { title: "Inicie sesión y seleccione su cuenta", html: "Inicie sesión con su nombre de usuario y contraseña de Tradovate. En una cuenta de prop firm o de evaluación, use el acceso que le dio la firma, no uno personal de Tradovate. Luego elija la cuenta correcta en el selector antes de colocar nada: es fácil lanzar una orden a la cuenta equivocada cuando la demo y la real están una junto a otra." },
        { title: "Instálelo como ventana independiente (opcional)", html: "Si quiere algo que se sienta más como una app de escritorio que como una pestaña del navegador, Chrome y Chromium pueden convertir el Web Trader en su propia ventana. Abra el menú del navegador y busque <strong class='text-white'>Install</strong> o <strong class='text-white'>Create shortcut</strong> (la redacción exacta depende de la versión de su navegador). Eso inicia Tradovate en una ventana limpia, sin pestañas ni barra de direcciones, y coloca un acceso en el menú de aplicaciones. Sigue siendo la versión web por debajo; simplemente no estorba." },
        { title: "Confirme los datos y guarde su espacio de trabajo", html: "Antes de operar, confirme que sus datos de mercado estén en vivo y no con retraso: un símbolo con retraso no se comportará como espera. Luego organice su DOM, gráficos y tickets de órdenes y guarde el diseño. Tradovate lo almacena asociado a su inicio de sesión, por lo que vuelve igual en la siguiente sesión." },
      ],
    },
    { type: "heading",text: "Particularidades conocidas en Linux" },
    { type: "paragraph",html: "El Web Trader funciona bien en Linux, pero algunas cosas se comportan de forma distinta a Windows o Mac. Ninguna es un impedimento si sabe qué esperar:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Los colores del tema pueden mostrarse distintos.</strong> En algunas configuraciones de Linux, los temas oscuro y claro no coinciden con lo que vería en Windows: colores que deberían ser blancos aparecen oscuros, o al revés. Si la plataforma se ve rara, cambie el tema dentro de Tradovate o pruebe otro navegador.",
        "<strong class='text-white'>Los gráficos integrados tienen límites.</strong> Sirven para order flow y marcos temporales estándar, pero no tienen la profundidad de una herramienta de gráficos dedicada; los gráficos por debajo de un minuto y las herramientas de dibujo avanzadas pueden requerir una conexión con TradingView.",
        "<strong class='text-white'>Vigile el número de sesiones.</strong> Tradovate limita cuántas sesiones activas puede tener a la vez. Iniciar sesión en el navegador, en la app móvil y en TradingView al mismo tiempo puede provocar desconexiones o gráficos congelados; consulte las reglas de sesión vigentes y manténgase por debajo.",
        "<strong class='text-white'>Mantenga el reloj sincronizado.</strong> Un reloj del sistema desincronizado provoca fallos de inicio de sesión y problemas de streaming. La mayoría de las distribuciones sincronizan la hora automáticamente por NTP, así que deje eso activado.",
        "<strong class='text-white'>Tenga un respaldo.</strong> Instale la app de Android o iOS en su teléfono para poder cerrar o gestionar posiciones si su navegador falla en mitad de una operación.",
      ],
    },
    { type: "paragraph",html: "Si los gráficos aparecen en blanco o en negro en la versión web, normalmente es un problema de caché o de actualización, no algo específico de Linux." },
    { type: "heading",text: "Automatice Tradovate desde Linux con PickMyTrade" },
    { type: "paragraph",html: "Como PickMyTrade funciona en la nube, su sistema operativo no importa. Sus alertas de TradingView envían las órdenes directamente a Tradovate, ya sea que su equipo ejecute Ubuntu, Windows o nada en absoluto. Configúrelo una vez y su estrategia se ejecuta sola, sin app de escritorio y sin depender de un sistema operativo." },
  ], fr: [
    { type: "paragraph",html: "Réponse courte : il n’existe pas d’application Tradovate native pour Linux, et aucune n’est prévue. Les téléchargements de bureau de Tradovate ne couvrent que Windows et Mac. Donc, si vous êtes sous Ubuntu, Fedora, Mint, Pop!_OS ou toute autre distribution, vous exécutez Tradovate comme vous ouvririez n’importe quel site web : par le navigateur. Le Web Trader est la plateforme complète, pas une version au rabais, vous ne perdez donc pas grand-chose en vous passant de l’installation de bureau." },
    { type: "paragraph",html: "Voici comment vous installer sous Linux, ainsi que les quelques particularités à connaître avant de trader en taille réelle." },
    { type: "heading",text: "Existe-t-il une application de bureau Tradovate pour Linux ?" },
    { type: "paragraph",html: "Non. Tradovate fournit des installateurs de bureau pour Windows et Mac, des applications mobiles natives pour Android et iOS, et un Web Trader dans le navigateur qui fonctionne partout. Linux ne figure pas dans la liste des postes de bureau et n’a pas été ajouté malgré des années de demandes. L’avantage : le Web Trader est conçu en HTML5, il ne se soucie donc pas de tourner sous Windows, macOS ou sur votre machine Linux ; les mêmes graphiques, le même DOM et les mêmes outils d’ordres se chargent dans le navigateur." },
    { type: "heading",text: "Utiliser Tradovate sous Linux : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Choisir un navigateur moderne", html: "N’importe quel navigateur récent de votre distribution convient. Chrome est celui vers lequel Tradovate oriente ses utilisateurs, et c’est le plus fluide sous Linux. Firefox, Chromium, Brave et la version Linux d’Edge chargent tous correctement le Web Trader. Quel que soit votre choix, gardez-le à jour : une version ancienne est la cause la plus fréquente d’un graphique ou d’un panneau d’ordres qui ne s’affiche pas." },
        { title: "Ouvrir le Web Trader de Tradovate", html: "Saisissez <strong class='text-white'>trader.tradovate.com/welcome</strong> dans la barre d’adresse et validez, puis ajoutez-le à vos favoris pour y accéder en un clic la prochaine fois. C’est exactement la plateforme qu’utilisent les traders sous Windows et Mac ; elle se charge simplement dans votre navigateur au lieu d’un programme téléchargé. Rien à installer, aucune dépendance à chercher." },
        { title: "Se connecter et sélectionner votre compte", html: "Connectez-vous avec votre nom d’utilisateur et votre mot de passe Tradovate. Sur un compte de prop firm ou d’évaluation, utilisez l’identifiant que la société vous a fourni, pas un identifiant Tradovate personnel. Choisissez ensuite le bon compte dans le sélecteur avant de passer quoi que ce soit : il est facile d’envoyer un ordre sur le mauvais compte quand les comptes démo et réel sont côte à côte." },
        { title: "L’installer comme fenêtre autonome (facultatif)", html: "Si vous voulez quelque chose qui ressemble davantage à une application de bureau qu’à un onglet de navigateur, Chrome et Chromium peuvent transformer le Web Trader en fenêtre à part entière. Ouvrez le menu du navigateur et cherchez <strong class='text-white'>Install</strong> ou <strong class='text-white'>Create shortcut</strong> (le libellé exact dépend de la version de votre navigateur). Tradovate se lance alors dans une fenêtre épurée, sans onglets ni barre d’adresse, et un lanceur est ajouté à votre menu d’applications. C’est toujours la version web en dessous, simplement plus discrète." },
        { title: "Vérifier les données et enregistrer votre espace de travail", html: "Avant de trader, vérifiez que vos données de marché sont en temps réel et non différées : un symbole différé ne se comportera pas comme vous l’attendez. Disposez ensuite votre DOM, vos graphiques et vos tickets d’ordres, puis enregistrez la mise en page. Tradovate la stocke avec votre identifiant, elle revient donc à l’identique à la session suivante." },
      ],
    },
    { type: "heading",text: "Particularités connues sous Linux" },
    { type: "paragraph",html: "Le Web Trader fonctionne bien sous Linux, mais certaines choses se comportent différemment de Windows ou Mac. Aucune n’est rédhibitoire si vous savez à quoi vous attendre :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Les couleurs du thème peuvent s’afficher différemment.</strong> Sur certaines configurations Linux, les thèmes sombre et clair ne correspondent pas à ce que vous verriez sous Windows : des couleurs censées être blanches apparaissent sombres, ou l’inverse. Si la plateforme semble étrange, changez de thème dans Tradovate ou essayez un autre navigateur.",
        "<strong class='text-white'>Les graphiques intégrés ont des limites.</strong> Ils conviennent pour l’order flow et les unités de temps standard, mais n’ont pas la profondeur d’un outil de graphique dédié ; les graphiques inférieurs à la minute et les outils de dessin avancés peuvent nécessiter une connexion à TradingView.",
        "<strong class='text-white'>Surveillez votre nombre de sessions.</strong> Tradovate plafonne le nombre de sessions actives simultanées. Vous connecter en même temps sur le navigateur, l’application mobile et TradingView peut provoquer des déconnexions ou des graphiques figés ; consultez les règles de session en vigueur et restez en dessous.",
        "<strong class='text-white'>Gardez votre horloge synchronisée.</strong> Une horloge système désynchronisée provoque des échecs de connexion et des problèmes de streaming. La plupart des distributions synchronisent l’heure automatiquement via NTP, laissez donc cette option activée.",
        "<strong class='text-white'>Gardez une solution de secours.</strong> Installez l’application Android ou iOS sur votre téléphone afin de pouvoir clôturer ou gérer vos positions si votre navigateur plante en plein trade.",
      ],
    },
    { type: "paragraph",html: "Si des graphiques s’affichent vides ou noirs sur la version web, il s’agit généralement d’un problème de cache ou d’actualisation, et non d’une particularité de Linux." },
    { type: "heading",text: "Automatiser Tradovate depuis Linux avec PickMyTrade" },
    { type: "paragraph",html: "Comme PickMyTrade fonctionne dans le cloud, votre système d’exploitation importe peu. Vos alertes TradingView envoient les ordres directement vers Tradovate, que votre machine tourne sous Ubuntu, Windows ou rien du tout. Configurez-le une fois et votre stratégie s’exécute toute seule, sans application de bureau et sans dépendance à un système d’exploitation." },
  ], it: [
    { type: "paragraph",html: "Risposta breve: non esiste un’app Tradovate nativa per Linux, e non è prevista. I download desktop di Tradovate coprono solo Windows e Mac. Quindi, se usa Ubuntu, Fedora, Mint, Pop!_OS o qualsiasi altra distribuzione, esegue Tradovate come aprirebbe qualsiasi sito web: tramite il browser. Il Web Trader è la piattaforma completa, non una versione ridotta, quindi non rinuncia a molto saltando l’installazione desktop." },
    { type: "paragraph",html: "Ecco come configurare tutto su Linux, oltre alle poche particolarità da conoscere prima di operare con dimensioni reali." },
    { type: "heading",text: "Esiste un’app desktop di Tradovate per Linux?" },
    { type: "paragraph",html: "No. Tradovate distribuisce installer desktop per Windows e Mac, app mobili native per Android e iOS e un Web Trader nel browser che funziona ovunque. Linux non è nell’elenco desktop e non è stato aggiunto nonostante anni di richieste. Il lato positivo: il Web Trader è costruito in HTML5, quindi non importa se gira su Windows, macOS o sul Suo computer Linux; gli stessi grafici, lo stesso DOM e gli stessi strumenti per gli ordini si caricano nel browser." },
    { type: "heading",text: "Come eseguire Tradovate su Linux: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Scegliere un browser moderno", html: "Va bene qualsiasi browser aggiornato della Sua distribuzione. Chrome è quello a cui Tradovate rimanda ed è il più fluido su Linux. Firefox, Chromium, Brave e la versione Linux di Edge caricano tutti bene il Web Trader. Qualunque scelga, lo mantenga aggiornato: una versione datata è la causa più comune di un grafico o di un pannello ordini che non viene visualizzato." },
        { title: "Aprire il Web Trader di Tradovate", html: "Digiti <strong class='text-white'>trader.tradovate.com/welcome</strong> nella barra degli indirizzi e prema Invio, poi lo aggiunga ai segnalibri così la prossima volta sarà a un clic di distanza. È esattamente la piattaforma usata dai trader Windows e Mac; si carica semplicemente nel Suo browser invece che come programma scaricato. Niente da installare, nessuna dipendenza da cercare." },
        { title: "Accedere e selezionare il Suo conto", html: "Acceda con il Suo nome utente e la Sua password di Tradovate. Su un conto prop firm o di valutazione, usi le credenziali fornite dalla società, non quelle di un account Tradovate personale. Poi scelga il conto corretto dal selettore prima di inserire qualsiasi cosa: è facile inviare un ordine sul conto sbagliato quando demo e live sono affiancati." },
        { title: "Installarlo come finestra autonoma (facoltativo)", html: "Se desidera qualcosa che somigli più a un’app desktop che a una scheda del browser, Chrome e Chromium possono trasformare il Web Trader in una finestra a sé. Apra il menu del browser e cerchi <strong class='text-white'>Install</strong> oppure <strong class='text-white'>Create shortcut</strong> (la dicitura esatta dipende dalla versione del browser). Tradovate si avvia così in una finestra pulita, senza schede né barra degli indirizzi, e aggiunge un collegamento nel menu delle applicazioni. Sotto il cofano è sempre la versione web, semplicemente non si mette in mezzo." },
        { title: "Verificare i dati e salvare l’area di lavoro", html: "Prima di operare, verifichi che i Suoi dati di mercato siano in tempo reale e non ritardati: un simbolo ritardato non si comporterà come si aspetta. Poi disponga DOM, grafici e ticket degli ordini e salvi il layout. Tradovate lo memorizza insieme al Suo accesso, quindi ritorna uguale alla sessione successiva." },
      ],
    },
    { type: "heading",text: "Particolarità note su Linux" },
    { type: "paragraph",html: "Il Web Trader funziona bene su Linux, ma alcune cose si comportano diversamente rispetto a Windows o Mac. Nessuna è un ostacolo se sa cosa aspettarsi:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>I colori del tema possono apparire diversi.</strong> In alcune configurazioni Linux i temi scuro e chiaro non corrispondono a quanto vedrebbe su Windows: colori che dovrebbero essere bianchi appaiono scuri, o viceversa. Se la piattaforma sembra strana, cambi il tema all’interno di Tradovate o provi un altro browser.",
        "<strong class='text-white'>I grafici integrati hanno dei limiti.</strong> Vanno bene per l’order flow e i timeframe standard, ma non hanno la profondità di uno strumento grafico dedicato; i grafici sotto il minuto e gli strumenti di disegno avanzati possono richiedere un collegamento a TradingView.",
        "<strong class='text-white'>Tenga d’occhio il numero di sessioni.</strong> Tradovate limita quante sessioni attive può avere contemporaneamente. Accedere nello stesso momento dal browser, dall’app mobile e da TradingView può causare disconnessioni o grafici bloccati; verifichi le regole di sessione attuali e resti al di sotto.",
        "<strong class='text-white'>Mantenga l’orologio sincronizzato.</strong> Un orologio di sistema non sincronizzato causa errori di accesso e problemi di streaming. La maggior parte delle distribuzioni sincronizza l’ora automaticamente tramite NTP, quindi lasci attiva questa funzione.",
        "<strong class='text-white'>Tenga un’alternativa di riserva.</strong> Installi l’app Android o iOS sul telefono per poter chiudere o gestire le posizioni se il browser ha un problema nel mezzo di un trade.",
      ],
    },
    { type: "paragraph",html: "Se i grafici compaiono vuoti o neri sulla versione web, di solito è un problema di cache o di aggiornamento, non qualcosa di specifico di Linux." },
