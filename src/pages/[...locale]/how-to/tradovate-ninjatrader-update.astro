---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-ninjatrader-update";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Update NinjaTrader to 8.1.x for Tradovate";
const META_DESCRIPTION =
  "NinjaTrader 8.0 won't connect to Tradovate. Update to the 8.1.x build so the connection type appears, then add your account and log in.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "NinjaTrader für Tradovate auf 8.1.x aktualisieren", es: "Actualizar NinjaTrader a 8.1.x para Tradovate", fr: "Mettre à jour NinjaTrader en 8.1.x pour Tradovate", it: "Aggiornare NinjaTrader a 8.1.x per Tradovate" },
  dek: { en: "NinjaTrader 8.0 won't connect to Tradovate. Update to the 8.1.x build so the connection type appears, then add your account and log in.", de: "NinjaTrader 8.0 verbindet sich nicht mit Tradovate. Aktualisieren Sie auf den 8.1.x-Build, damit der Verbindungstyp erscheint, fügen Sie dann Ihr Konto hinzu und melden Sie sich an.", es: "NinjaTrader 8.0 no se conecta a Tradovate. Actualice a la versión 8.1.x para que aparezca el tipo de conexión, luego añada su cuenta e inicie sesión.", fr: "NinjaTrader 8.0 ne se connecte pas à Tradovate. Passez à la version 8.1.x pour que le type de connexion apparaisse, puis ajoutez votre compte et connectez-vous.", it: "NinjaTrader 8.0 non si collega a Tradovate. Aggiorni alla build 8.1.x per far comparire il tipo di connessione, poi aggiunga il Suo conto ed effettui l'accesso." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "If NinjaTrader 8 shows no Tradovate connection option, or you keep hitting an \"Invalid user or password (Logon failed)\" error with credentials you know are right, the cause is almost always your build. NinjaTrader 8.0 can't talk to Tradovate at all. Support for Tradovate accounts landed in build 8.1.2.1, so you need to update to a current 8.1.x release before the connection type shows up. Here's the full fix, from checking your version to a green \"Connected\" status." },
    { type: "heading", text: "Why the Connection Type Is Missing" },
    { type: "paragraph", html: "NinjaTrader now owns Tradovate, and the Tradovate integration ships only in the 8.1 line. Run 8.0 and there's simply no provider to pick, so any login attempt fails before it starts. Depending on your exact build, the provider you add may read \"Tradovate\" or \"NinjaTrader\" in the list, but both point at the same direct Tradovate API. The fix is identical either way: get onto a current 8.1.x build." },
    { type: "heading", text: "Before You Start" },
    {
      type: "list",
      items: [
        "A NinjaTrader account login at account.ninjatrader.com to download the installer.",
        "Your Tradovate username and password. Prop-firm accounts use the credentials your firm issues, and those vary by firm, so pull them from your firm's dashboard rather than guessing.",
        "A few minutes to close the platform and reinstall. Your workspaces and settings survive the update.",
      ],
    },
    { type: "heading", text: "Step by Step: Update NinjaTrader and Add Tradovate" },
    {
      type: "steps",
      items: [
        { title: "Check Your Current Version", html: "Open NinjaTrader, then go to <strong class='text-white'>Help &rsaquo; About</strong>. If the version starts with 8.0, that's your problem. Anything below 8.1.2.1 won't connect to Tradovate." },
        { title: "Download the Latest 8.1.x Installer", html: "Log in at account.ninjatrader.com and grab the current desktop installer. NinjaTrader 8 doesn't push major builds to you automatically, so moving from 8.0 to 8.1.x means downloading and running a fresh installer. The 8.1 line has moved well past 8.1.2.1, so just take the newest build offered." },
        { title: "Close NinjaTrader and Install", html: "Fully close the platform first, including the icon hiding in the Windows system tray. Then run the installer over your existing copy. It keeps your workspaces, chart templates, and settings. Reopen NinjaTrader and check <strong class='text-white'>Help &rsaquo; About</strong> again to confirm you're now on 8.1.2.1 or newer." },
        { title: "Turn On Multi-Provider Mode", html: "Go to <strong class='text-white'>Tools &rsaquo; Options &rsaquo; General</strong> and tick <strong class='text-white'>Multi-provider</strong> mode. Click Apply, then OK, then restart NinjaTrader. Skip this and the Configure option and multiple simultaneous connections won't be available, which trips up plenty of people who otherwise did everything right." },
        { title: "Add Your Tradovate Connection", html: "In the Control Center, open <strong class='text-white'>Connections &rsaquo; Configure</strong>. In the Available list, pick the Tradovate provider (labeled \"Tradovate\" or \"NinjaTrader\" depending on your build), click Add, and enter your Tradovate username and password. Click Apply and OK. Back under <strong class='text-white'>Connections</strong>, select your new connection and choose Live or Simulation to match the account. A green \"Connected\" indicator means you're in, and your balances and positions should populate on the Accounts tab." },
      ],
    },
    { type: "heading", text: "Still Not Seeing the Connection Type?" },
    {
      type: "list",
      items: [
        "Recheck <strong class='text-white'>Help &rsaquo; About</strong>. An interrupted install can quietly leave you on the old 8.0 build, so confirm the number actually changed.",
        "Make sure Multi-provider is ticked and that you restarted the platform after enabling it.",
        "Use your Tradovate login, not your NinjaTrader account login. They're two different accounts, and mixing them up produces the same \"Logon failed\" message.",
        "If everything connects but your data shows as delayed, that's a separate market-data subscription issue, not a version one.",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Rather skip the desktop app and its build juggling entirely? <strong class='text-white'>PickMyTrade routes your TradingView alerts straight to Tradovate</strong> with no NinjaTrader install and no API license to manage. Set it once and let your strategy fire." },
  ], de: [
    { type: "paragraph",html: "Wenn NinjaTrader 8 keine Tradovate-Verbindungsoption anzeigt oder Sie mit sicher korrekten Zugangsdaten immer wieder auf den Fehler „Invalid user or password (Logon failed)“ stoßen, liegt die Ursache fast immer an Ihrem Build. NinjaTrader 8.0 kann überhaupt nicht mit Tradovate kommunizieren. Die Unterstützung für Tradovate-Konten kam mit Build 8.1.2.1, Sie müssen also auf ein aktuelles 8.1.x-Release aktualisieren, bevor der Verbindungstyp erscheint. Hier ist die vollständige Lösung, von der Versionsprüfung bis zum grünen Status „Connected“." },
    { type: "heading",text: "Warum der Verbindungstyp fehlt" },
    { type: "paragraph",html: "NinjaTrader besitzt Tradovate inzwischen, und die Tradovate-Integration wird ausschließlich in der 8.1-Linie ausgeliefert. Unter 8.0 gibt es schlicht keinen Anbieter zur Auswahl, sodass jeder Anmeldeversuch scheitert, bevor er beginnt. Je nach Ihrem genauen Build kann der Anbieter, den Sie hinzufügen, in der Liste „Tradovate“ oder „NinjaTrader“ heißen, beide verweisen jedoch auf dieselbe direkte Tradovate-API. Die Lösung ist in beiden Fällen identisch: auf einen aktuellen 8.1.x-Build wechseln." },
    { type: "heading",text: "Bevor Sie beginnen" },
    {
      type: "list",
      items: [
        "Ein NinjaTrader-Konto-Login unter account.ninjatrader.com, um das Installationsprogramm herunterzuladen.",
        "Ihr Tradovate-Benutzername und -Passwort. Prop-Firm-Konten verwenden die von Ihrer Firma ausgestellten Zugangsdaten, die je nach Firma variieren; holen Sie sie daher aus dem Dashboard Ihrer Firma, statt zu raten.",
        "Ein paar Minuten, um die Plattform zu schließen und neu zu installieren. Ihre Workspaces und Einstellungen bleiben beim Update erhalten.",
      ],
    },
    { type: "heading",text: "Schritt für Schritt: NinjaTrader aktualisieren und Tradovate hinzufügen" },
    {
      type: "steps",
      items: [
        { title: "Aktuelle Version prüfen", html: "Öffnen Sie NinjaTrader und gehen Sie dann zu <strong class='text-white'>Help &rsaquo; About</strong>. Beginnt die Version mit 8.0, ist das Ihr Problem. Alles unter 8.1.2.1 verbindet sich nicht mit Tradovate." },
        { title: "Das neueste 8.1.x-Installationsprogramm herunterladen", html: "Melden Sie sich unter account.ninjatrader.com an und laden Sie das aktuelle Desktop-Installationsprogramm herunter. NinjaTrader 8 spielt größere Builds nicht automatisch ein; der Wechsel von 8.0 auf 8.1.x bedeutet also, ein neues Installationsprogramm herunterzuladen und auszuführen. Die 8.1-Linie ist längst über 8.1.2.1 hinausgegangen, nehmen Sie also einfach den neuesten angebotenen Build." },
        { title: "NinjaTrader schließen und installieren", html: "Schließen Sie die Plattform zunächst vollständig, auch das Symbol im Windows-Infobereich. Führen Sie dann das Installationsprogramm über Ihre bestehende Installation aus. Ihre Workspaces, Chart-Vorlagen und Einstellungen bleiben erhalten. Öffnen Sie NinjaTrader erneut und prüfen Sie <strong class='text-white'>Help &rsaquo; About</strong> noch einmal, um zu bestätigen, dass Sie jetzt auf 8.1.2.1 oder neuer sind." },
        { title: "Multi-Provider-Modus aktivieren", html: "Gehen Sie zu <strong class='text-white'>Tools &rsaquo; Options &rsaquo; General</strong> und aktivieren Sie den Modus <strong class='text-white'>Multi-provider</strong>. Klicken Sie auf Apply, dann auf OK und starten Sie NinjaTrader neu. Wenn Sie das überspringen, stehen die Option Configure und mehrere gleichzeitige Verbindungen nicht zur Verfügung, woran viele scheitern, die sonst alles richtig gemacht haben." },
        { title: "Ihre Tradovate-Verbindung hinzufügen", html: "Öffnen Sie im Control Center <strong class='text-white'>Connections &rsaquo; Configure</strong>. Wählen Sie in der Liste Available den Tradovate-Anbieter (je nach Build mit „Tradovate“ oder „NinjaTrader“ bezeichnet), klicken Sie auf Add und geben Sie Ihren Tradovate-Benutzernamen und Ihr Passwort ein. Klicken Sie auf Apply und OK. Wählen Sie zurück unter <strong class='text-white'>Connections</strong> Ihre neue Verbindung und entscheiden Sie sich für Live oder Simulation, passend zum Konto. Eine grüne Anzeige „Connected“ bedeutet, dass Sie drin sind, und Ihre Kontostände und Positionen sollten im Reiter Accounts erscheinen." },
      ],
    },
    { type: "heading",text: "Sehen Sie den Verbindungstyp immer noch nicht?" },
    {
      type: "list",
      items: [
        "Prüfen Sie <strong class='text-white'>Help &rsaquo; About</strong> erneut. Eine unterbrochene Installation kann Sie unbemerkt auf dem alten 8.0-Build belassen; vergewissern Sie sich also, dass sich die Nummer tatsächlich geändert hat.",
        "Stellen Sie sicher, dass Multi-provider aktiviert ist und dass Sie die Plattform nach dem Aktivieren neu gestartet haben.",
        "Verwenden Sie Ihren Tradovate-Login, nicht Ihren NinjaTrader-Konto-Login. Es sind zwei verschiedene Konten, und eine Verwechslung erzeugt dieselbe Meldung „Logon failed“.",
        "Wenn alles verbunden ist, Ihre Daten aber verzögert angezeigt werden, ist das ein separates Problem mit dem Marktdaten-Abonnement, kein Versionsproblem.",
      ],
    },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "Möchten Sie die Desktop-App und das Build-Jonglieren ganz überspringen? <strong class='text-white'>PickMyTrade leitet Ihre TradingView-Alerts direkt an Tradovate weiter</strong>, ohne NinjaTrader-Installation und ohne API-Lizenz, die Sie verwalten müssen. Einmal einrichten und Ihre Strategie laufen lassen." },
  ], es: [
    { type: "paragraph",html: "Si NinjaTrader 8 no muestra ninguna opción de conexión de Tradovate, o sigue recibiendo el error «Invalid user or password (Logon failed)» con credenciales que sabe que son correctas, la causa es casi siempre su versión. NinjaTrader 8.0 no puede comunicarse con Tradovate en absoluto. La compatibilidad con cuentas de Tradovate llegó en la versión 8.1.2.1, así que debe actualizar a una versión 8.1.x actual antes de que aparezca el tipo de conexión. Aquí tiene la solución completa, desde comprobar su versión hasta un estado «Connected» en verde." },
    { type: "heading",text: "Por qué falta el tipo de conexión" },
    { type: "paragraph",html: "NinjaTrader ya es propietaria de Tradovate, y la integración con Tradovate solo se incluye en la línea 8.1. Con la 8.0 simplemente no hay proveedor que elegir, por lo que cualquier intento de inicio de sesión falla antes de empezar. Según su versión exacta, el proveedor que añada puede aparecer en la lista como «Tradovate» o «NinjaTrader», pero ambos apuntan a la misma API directa de Tradovate. La solución es idéntica en ambos casos: pasar a una versión 8.1.x actual." },
    { type: "heading",text: "Antes de empezar" },
    {
      type: "list",
      items: [
        "Un inicio de sesión de cuenta de NinjaTrader en account.ninjatrader.com para descargar el instalador.",
        "Su usuario y contraseña de Tradovate. Las cuentas de prop firms usan las credenciales que emite su firma, y estas varían según la firma, así que obténgalas del panel de su firma en lugar de adivinarlas.",
        "Unos minutos para cerrar la plataforma y reinstalar. Sus espacios de trabajo y ajustes se conservan tras la actualización.",
      ],
    },
    { type: "heading",text: "Paso a paso: actualice NinjaTrader y añada Tradovate" },
    {
      type: "steps",
      items: [
        { title: "Compruebe su versión actual", html: "Abra NinjaTrader y vaya a <strong class='text-white'>Help &rsaquo; About</strong>. Si la versión empieza por 8.0, ese es su problema. Cualquier versión anterior a 8.1.2.1 no se conectará a Tradovate." },
        { title: "Descargue el instalador 8.1.x más reciente", html: "Inicie sesión en account.ninjatrader.com y descargue el instalador de escritorio actual. NinjaTrader 8 no le envía automáticamente las versiones principales, así que pasar de 8.0 a 8.1.x implica descargar y ejecutar un instalador nuevo. La línea 8.1 ha avanzado mucho más allá de 8.1.2.1, así que simplemente tome la versión más reciente que se ofrezca." },
        { title: "Cierre NinjaTrader e instale", html: "Cierre primero por completo la plataforma, incluido el icono oculto en la bandeja del sistema de Windows. Después ejecute el instalador sobre su copia existente. Conserva sus espacios de trabajo, plantillas de gráficos y ajustes. Vuelva a abrir NinjaTrader y revise de nuevo <strong class='text-white'>Help &rsaquo; About</strong> para confirmar que ahora está en la 8.1.2.1 o posterior." },
        { title: "Active el modo Multi-Provider", html: "Vaya a <strong class='text-white'>Tools &rsaquo; Options &rsaquo; General</strong> y marque el modo <strong class='text-white'>Multi-provider</strong>. Haga clic en Apply, luego en OK y reinicie NinjaTrader. Si se lo salta, la opción Configure y las conexiones simultáneas múltiples no estarán disponibles, lo que desconcierta a muchos que por lo demás hicieron todo bien." },
        { title: "Añada su conexión de Tradovate", html: "En el Control Center, abra <strong class='text-white'>Connections &rsaquo; Configure</strong>. En la lista Available, elija el proveedor de Tradovate (etiquetado «Tradovate» o «NinjaTrader» según su versión), haga clic en Add e introduzca su usuario y contraseña de Tradovate. Haga clic en Apply y OK. De vuelta en <strong class='text-white'>Connections</strong>, seleccione su nueva conexión y elija Live o Simulation según la cuenta. Un indicador «Connected» en verde significa que ya está dentro, y sus saldos y posiciones deberían cargarse en la pestaña Accounts." },
      ],
    },
    { type: "heading",text: "¿Sigue sin ver el tipo de conexión?" },
    {
      type: "list",
      items: [
        "Vuelva a revisar <strong class='text-white'>Help &rsaquo; About</strong>. Una instalación interrumpida puede dejarle sin darse cuenta en la versión 8.0 anterior, así que confirme que el número realmente cambió.",
        "Asegúrese de que Multi-provider esté marcado y de que reinició la plataforma tras activarlo.",
        "Use su inicio de sesión de Tradovate, no el de su cuenta de NinjaTrader. Son dos cuentas distintas, y confundirlas produce el mismo mensaje «Logon failed».",
        "Si todo se conecta pero sus datos aparecen retrasados, es un problema aparte de suscripción de datos de mercado, no de versión.",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "¿Prefiere prescindir por completo de la aplicación de escritorio y sus malabarismos con versiones? <strong class='text-white'>PickMyTrade envía sus alertas de TradingView directamente a Tradovate</strong>, sin instalar NinjaTrader y sin licencia de API que gestionar. Configúrelo una vez y deje que su estrategia dispare." },
  ], fr: [
    { type: "paragraph",html: "Si NinjaTrader 8 n'affiche aucune option de connexion Tradovate, ou si vous obtenez sans cesse l'erreur « Invalid user or password (Logon failed) » avec des identifiants que vous savez corrects, la cause est presque toujours votre version. NinjaTrader 8.0 ne peut pas du tout communiquer avec Tradovate. La prise en charge des comptes Tradovate est arrivée avec la version 8.1.2.1 ; vous devez donc passer à une version 8.1.x récente avant que le type de connexion n'apparaisse. Voici la solution complète, de la vérification de votre version jusqu'au statut « Connected » en vert." },
    { type: "heading",text: "Pourquoi le type de connexion est absent" },
    { type: "paragraph",html: "NinjaTrader possède désormais Tradovate, et l'intégration Tradovate n'est livrée que dans la branche 8.1. Avec la 8.0, il n'y a tout simplement aucun fournisseur à choisir, si bien que toute tentative de connexion échoue avant de commencer. Selon votre version exacte, le fournisseur que vous ajoutez peut s'appeler « Tradovate » ou « NinjaTrader » dans la liste, mais les deux pointent vers la même API Tradovate directe. La solution est la même dans les deux cas : passer à une version 8.1.x récente." },
    { type: "heading",text: "Avant de commencer" },
    {
      type: "list",
      items: [
        "Un identifiant de compte NinjaTrader sur account.ninjatrader.com pour télécharger le programme d'installation.",
        "Votre nom d'utilisateur et votre mot de passe Tradovate. Les comptes de prop firms utilisent les identifiants fournis par votre société, qui varient d'une société à l'autre ; récupérez-les donc dans le tableau de bord de votre société plutôt que de deviner.",
        "Quelques minutes pour fermer la plateforme et la réinstaller. Vos espaces de travail et vos paramètres sont conservés lors de la mise à jour.",
      ],
    },
    { type: "heading",text: "Pas à pas : mettre à jour NinjaTrader et ajouter Tradovate" },
    {
      type: "steps",
      items: [
        { title: "Vérifiez votre version actuelle", html: "Ouvrez NinjaTrader, puis allez dans <strong class='text-white'>Help &rsaquo; About</strong>. Si la version commence par 8.0, c'est là votre problème. Toute version inférieure à 8.1.2.1 ne se connectera pas à Tradovate." },
        { title: "Téléchargez le dernier programme d'installation 8.1.x", html: "Connectez-vous sur account.ninjatrader.com et récupérez le programme d'installation de bureau actuel. NinjaTrader 8 ne vous envoie pas automatiquement les versions majeures ; passer de la 8.0 à la 8.1.x implique donc de télécharger et d'exécuter un nouveau programme d'installation. La branche 8.1 a largement dépassé la 8.1.2.1 ; prenez donc simplement la version la plus récente proposée." },
        { title: "Fermez NinjaTrader et installez", html: "Fermez d'abord complètement la plateforme, y compris l'icône cachée dans la zone de notification de Windows. Exécutez ensuite le programme d'installation par-dessus votre copie existante. Il conserve vos espaces de travail, modèles de graphiques et paramètres. Rouvrez NinjaTrader et vérifiez à nouveau <strong class='text-white'>Help &rsaquo; About</strong> pour confirmer que vous êtes bien en 8.1.2.1 ou plus récent." },
        { title: "Activez le mode Multi-Provider", html: "Allez dans <strong class='text-white'>Tools &rsaquo; Options &rsaquo; General</strong> et cochez le mode <strong class='text-white'>Multi-provider</strong>. Cliquez sur Apply, puis sur OK, puis redémarrez NinjaTrader. Si vous l'ignorez, l'option Configure et les connexions simultanées multiples ne seront pas disponibles, ce qui piège bien des utilisateurs qui avaient pourtant tout fait correctement." },
        { title: "Ajoutez votre connexion Tradovate", html: "Dans le Control Center, ouvrez <strong class='text-white'>Connections &rsaquo; Configure</strong>. Dans la liste Available, choisissez le fournisseur Tradovate (libellé « Tradovate » ou « NinjaTrader » selon votre version), cliquez sur Add et saisissez votre nom d'utilisateur et votre mot de passe Tradovate. Cliquez sur Apply et OK. De retour sous <strong class='text-white'>Connections</strong>, sélectionnez votre nouvelle connexion et choisissez Live ou Simulation selon le compte. Un indicateur « Connected » vert signifie que vous êtes connecté, et vos soldes et positions devraient apparaître dans l'onglet Accounts." },
      ],
    },
    { type: "heading",text: "Vous ne voyez toujours pas le type de connexion ?" },
    {
      type: "list",
      items: [
        "Revérifiez <strong class='text-white'>Help &rsaquo; About</strong>. Une installation interrompue peut vous laisser discrètement sur l'ancienne version 8.0 ; confirmez donc que le numéro a bien changé.",
        "Assurez-vous que Multi-provider est coché et que vous avez redémarré la plateforme après l'avoir activé.",
        "Utilisez votre identifiant Tradovate, pas celui de votre compte NinjaTrader. Ce sont deux comptes différents, et les confondre produit le même message « Logon failed ».",
        "Si tout se connecte mais que vos données apparaissent différées, il s'agit d'un problème distinct d'abonnement aux données de marché, pas d'un problème de version.",
      ],
    },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Vous préférez vous passer complètement de l'application de bureau et de ses casse-têtes de versions ? <strong class='text-white'>PickMyTrade transmet vos alertes TradingView directement à Tradovate</strong>, sans installation de NinjaTrader et sans licence d'API à gérer. Configurez-le une fois et laissez votre stratégie se déclencher." },
  ], it: [
    { type: "paragraph",html: "Se NinjaTrader 8 non mostra alcuna opzione di connessione Tradovate, oppure continua a ricevere l'errore «Invalid user or password (Logon failed)» con credenziali che sa essere corrette, la causa è quasi sempre la Sua build. NinjaTrader 8.0 non può comunicare affatto con Tradovate. Il supporto per i conti Tradovate è arrivato con la build 8.1.2.1, quindi deve aggiornare a una versione 8.1.x attuale prima che compaia il tipo di connessione. Ecco la soluzione completa, dal controllo della versione allo stato «Connected» in verde." },
    { type: "heading",text: "Perché manca il tipo di connessione" },
    { type: "paragraph",html: "NinjaTrader ora possiede Tradovate, e l'integrazione con Tradovate è inclusa solo nella linea 8.1. Con la 8.0 non c'è semplicemente alcun provider da scegliere, quindi qualsiasi tentativo di accesso fallisce prima di iniziare. A seconda della build esatta, il provider che aggiunge può comparire nell'elenco come «Tradovate» o «NinjaTrader», ma entrambi puntano alla stessa API Tradovate diretta. La soluzione è identica in entrambi i casi: passare a una build 8.1.x attuale." },
    { type: "heading",text: "Prima di iniziare" },
    {
      type: "list",
      items: [
        "Un accesso all'account NinjaTrader su account.ninjatrader.com per scaricare l'installer.",
