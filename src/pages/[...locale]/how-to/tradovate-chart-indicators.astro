---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-chart-indicators";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Add Indicators to Tradovate Charts (40+ Built-in)";
const META_DESCRIPTION =
  "Tradovate chart indicators made easy: add, search, hide, and remove any of 40+ built-in studies right from the chart Indicators icon in seconds.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Indikatoren zu Tradovate-Charts hinzufügen (40+ integriert)", es: "Añada indicadores a los gráficos de Tradovate (más de 40 integrados)", fr: "Ajoutez des indicateurs aux graphiques Tradovate (plus de 40 intégrés)", it: "Aggiunga indicatori ai grafici Tradovate (oltre 40 integrati)" },
  dek: { en: "Want moving averages, VWAP, or RSI on your Tradovate chart? It takes seconds once you know where the Indicators icon lives. Here's exactly how to add, search, hide, and remove chart indicators.", de: "Möchten Sie gleitende Durchschnitte, VWAP oder RSI auf Ihrem Tradovate-Chart? Das dauert nur Sekunden, sobald Sie wissen, wo das Indikatoren-Symbol sitzt. So fügen Sie Chart-Indikatoren hinzu, suchen, verbergen und entfernen sie.", es: "¿Quiere medias móviles, VWAP o RSI en su gráfico de Tradovate? Lleva solo unos segundos cuando sabe dónde está el icono de Indicators. Así puede añadir, buscar, ocultar y eliminar indicadores del gráfico.", fr: "Vous voulez des moyennes mobiles, le VWAP ou le RSI sur votre graphique Tradovate ? Cela prend quelques secondes dès que vous savez où se trouve l’icône Indicators. Voici exactement comment ajouter, rechercher, masquer et supprimer des indicateurs de graphique.", it: "Vuole medie mobili, VWAP o RSI sul Suo grafico Tradovate? Bastano pochi secondi una volta che sa dove si trova l’icona Indicators. Ecco esattamente come aggiungere, cercare, nascondere e rimuovere gli indicatori del grafico." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Want moving averages, VWAP, or RSI on your Tradovate chart? It takes seconds once you know where the Indicators icon lives. Whether you're refining a setup, testing a strategy, or wiring up automation with PickMyTrade, here's exactly how to add, search, hide, and remove chart indicators in Tradovate." },
    { type: "heading", text: "What Are Tradovate Chart Indicators?" },
    { type: "paragraph", html: "Indicators are technical studies, moving averages, oscillators, volume tools, and the rest, that plot on top of your price chart so you can read momentum, trend, and volatility at a glance. The Tradovate Web app ships with 40+ built-in indicators. When the built-in set doesn't cover what you're after, there's also a library of custom community indicators you can pull in." },
    { type: "heading", text: "Add Indicators to Tradovate Charts: Step by Step" },
    {
      type: "steps",
      items: [
        { title: "Open the Indicators Menu on Your Chart", html: "Open a chart, then hover your mouse over it so the chart toolbar appears. Click the <strong class='text-white'>Indicators</strong> icon on that toolbar and the Indicators menu opens." },
        { title: "Search the 40+ Built-in Indicators", html: "The Indicators menu lists every built-in study. Rather than scroll, use the <strong class='text-white'>search box (the magnifying-glass icon) at the top of the list</strong> to filter by keyword. Type \"RSI,\" \"VWAP,\" or \"moving average\" and you'll jump straight to the one you want." },
        { title: "Add an Indicator and Set Its Properties", html: "Click an indicator name to drop it onto the chart. Its <strong class='text-white'>Properties</strong> menu opens right away, so you can tune parameters like length, source, and color. Set what you need, then click <strong class='text-white'>Save</strong> to apply it. Can't find the study you're after? Open <strong class='text-white'>Explore Community Indicators</strong> to browse custom studies shared by other Tradovate traders." },
        { title: "Hide or Show an Indicator", html: "Need to clear the noise without losing your settings? Hover over the indicator's label on the chart and click the <strong class='text-white'>eye icon</strong> to hide it. Click the eye again to bring it back. It's the fast way to declutter a busy chart mid-session and restore everything exactly as it was." },
        { title: "Edit or Remove an Indicator", html: "To change a study's settings, double-click the indicator on the chart, or use the gear/Configure icon on the chart toolbar, to reopen its <strong class='text-white'>Properties</strong> menu. Done with it entirely? Hover over the indicator's label and click the <strong class='text-white'>trash-can (delete) icon</strong> to remove it." },
      ],
    },
    { type: "heading", text: "Why You'd Need This" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Refine entries and exits</strong>, overlay trend and momentum studies to confirm a setup before you click buy or sell.",
        "<strong class='text-white'>Declutter fast</strong>, hide indicators with the eye icon during a scalp, then restore them without re-adding.",
        "<strong class='text-white'>Test ideas</strong>, swap indicator parameters in the Properties menu to see how a study behaves across timeframes.",
        "<strong class='text-white'>Match your automation</strong>, mirror the exact indicators your alerts fire on so your chart and your bot agree.",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Once your Tradovate chart indicators are dialed in, <strong class='text-white'>PickMyTrade connects your TradingView alerts straight to your Tradovate account</strong>. The moment your indicator condition triggers, the trade fires automatically, no manual clicks, no missed fills." },
  ], de: [
    { type: "paragraph",html: "Möchten Sie gleitende Durchschnitte, VWAP oder RSI auf Ihrem Tradovate-Chart? Das dauert nur Sekunden, sobald Sie wissen, wo das Indikatoren-Symbol sitzt. Ob Sie ein Setup verfeinern, eine Strategie testen oder eine Automatisierung mit PickMyTrade einrichten: So fügen Sie Chart-Indikatoren in Tradovate hinzu, suchen, verbergen und entfernen sie." },
    { type: "heading",text: "Was sind Tradovate-Chart-Indikatoren?" },
    { type: "paragraph",html: "Indikatoren sind technische Studien, also gleitende Durchschnitte, Oszillatoren, Volumen-Tools und mehr, die über Ihrem Kurschart dargestellt werden, damit Sie Momentum, Trend und Volatilität auf einen Blick ablesen können. Die Tradovate Web App bringt mehr als 40 integrierte Indikatoren mit. Wenn der integrierte Satz nicht abdeckt, was Sie suchen, gibt es außerdem eine Bibliothek benutzerdefinierter Community-Indikatoren, die Sie einbinden können." },
    { type: "heading",text: "Indikatoren zu Tradovate-Charts hinzufügen: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Das Indikatoren-Menü auf Ihrem Chart öffnen", html: "Öffnen Sie einen Chart und bewegen Sie die Maus darüber, damit die Chart-Symbolleiste erscheint. Klicken Sie in dieser Leiste auf das Symbol <strong class='text-white'>Indicators</strong>, und das Menü Indicators öffnet sich." },
        { title: "Die 40+ integrierten Indikatoren durchsuchen", html: "Das Menü Indicators listet jede integrierte Studie auf. Statt zu scrollen, nutzen Sie das <strong class='text-white'>Suchfeld (Lupen-Symbol) oben in der Liste</strong>, um nach Stichwort zu filtern. Geben Sie „RSI“, „VWAP“ oder „moving average“ ein, und Sie springen direkt zu dem gewünschten Indikator." },
        { title: "Einen Indikator hinzufügen und Eigenschaften festlegen", html: "Klicken Sie auf einen Indikatornamen, um ihn auf den Chart zu legen. Sein Menü <strong class='text-white'>Properties</strong> öffnet sich sofort, sodass Sie Parameter wie Länge, Quelle und Farbe anpassen können. Stellen Sie ein, was Sie brauchen, und klicken Sie dann auf <strong class='text-white'>Save</strong>, um ihn anzuwenden. Finden Sie die gesuchte Studie nicht? Öffnen Sie <strong class='text-white'>Explore Community Indicators</strong>, um benutzerdefinierte Studien anderer Tradovate-Trader zu durchsuchen." },
        { title: "Einen Indikator ausblenden oder einblenden", html: "Sie möchten Unruhe aus dem Chart nehmen, ohne Ihre Einstellungen zu verlieren? Fahren Sie mit dem Mauszeiger über die Beschriftung des Indikators im Chart und klicken Sie auf das <strong class='text-white'>Augen-Symbol</strong>, um ihn auszublenden. Klicken Sie erneut auf das Auge, um ihn zurückzuholen. So räumen Sie einen überladenen Chart mitten in der Sitzung schnell auf und stellen alles genau wie zuvor wieder her." },
        { title: "Einen Indikator bearbeiten oder entfernen", html: "Um die Einstellungen einer Studie zu ändern, doppelklicken Sie auf den Indikator im Chart oder verwenden Sie das Zahnrad-/Configure-Symbol in der Chart-Symbolleiste, um sein Menü <strong class='text-white'>Properties</strong> erneut zu öffnen. Sind Sie ganz fertig damit? Fahren Sie mit dem Mauszeiger über die Beschriftung des Indikators und klicken Sie auf das <strong class='text-white'>Papierkorb-Symbol (Löschen)</strong>, um ihn zu entfernen." },
      ],
    },
    { type: "heading",text: "Wozu Sie das brauchen" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Ein- und Ausstiege verfeinern</strong>: Legen Sie Trend- und Momentum-Studien darüber, um ein Setup zu bestätigen, bevor Sie auf Kaufen oder Verkaufen klicken.",
        "<strong class='text-white'>Schnell aufräumen</strong>: Blenden Sie Indikatoren während eines Scalps mit dem Augen-Symbol aus und stellen Sie sie wieder her, ohne sie neu hinzufügen zu müssen.",
        "<strong class='text-white'>Ideen testen</strong>: Tauschen Sie Indikatorparameter im Menü Properties aus, um zu sehen, wie sich eine Studie über verschiedene Zeitrahmen verhält.",
        "<strong class='text-white'>Zur Automatisierung passen</strong>: Bilden Sie genau die Indikatoren nach, auf denen Ihre Alerts auslösen, damit Chart und Bot übereinstimmen.",
      ],
    },
    { type: "heading",text: "Mit PickMyTrade automatisieren" },
    { type: "paragraph",html: "Sobald Ihre Tradovate-Chart-Indikatoren eingerichtet sind, <strong class='text-white'>verbindet PickMyTrade Ihre TradingView-Alerts direkt mit Ihrem Tradovate-Konto</strong>. In dem Moment, in dem Ihre Indikatorbedingung auslöst, wird der Trade automatisch ausgeführt, ohne manuelle Klicks und ohne verpasste Fills." },
  ], es: [
    { type: "paragraph",html: "¿Quiere medias móviles, VWAP o RSI en su gráfico de Tradovate? Lleva solo unos segundos cuando sabe dónde está el icono de Indicators. Ya sea que esté refinando una configuración, probando una estrategia o preparando una automatización con PickMyTrade, aquí le explicamos exactamente cómo añadir, buscar, ocultar y eliminar indicadores del gráfico en Tradovate." },
    { type: "heading",text: "¿Qué son los indicadores de gráfico de Tradovate?" },
    { type: "paragraph",html: "Los indicadores son estudios técnicos (medias móviles, osciladores, herramientas de volumen y más) que se trazan sobre su gráfico de precios para que pueda leer el momentum, la tendencia y la volatilidad de un vistazo. La Tradovate Web App incluye más de 40 indicadores integrados. Cuando el conjunto integrado no cubre lo que busca, también hay una biblioteca de indicadores personalizados de la comunidad que puede incorporar." },
    { type: "heading",text: "Añada indicadores a los gráficos de Tradovate paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra el menú Indicators en su gráfico", html: "Abra un gráfico y pase el ratón sobre él para que aparezca la barra de herramientas. Haga clic en el icono <strong class='text-white'>Indicators</strong> de esa barra y se abrirá el menú Indicators." },
        { title: "Busque entre los más de 40 indicadores integrados", html: "El menú Indicators enumera todos los estudios integrados. En lugar de desplazarse, use el <strong class='text-white'>cuadro de búsqueda (el icono de lupa) en la parte superior de la lista</strong> para filtrar por palabra clave. Escriba «RSI», «VWAP» o «moving average» y irá directamente al que quiere." },
        { title: "Añada un indicador y defina sus propiedades", html: "Haga clic en el nombre de un indicador para colocarlo en el gráfico. Su menú <strong class='text-white'>Properties</strong> se abre de inmediato, para que pueda ajustar parámetros como la longitud, la fuente y el color. Configure lo que necesite y haga clic en <strong class='text-white'>Save</strong> para aplicarlo. ¿No encuentra el estudio que busca? Abra <strong class='text-white'>Explore Community Indicators</strong> para explorar estudios personalizados compartidos por otros traders de Tradovate." },
        { title: "Oculte o muestre un indicador", html: "¿Necesita despejar el gráfico sin perder su configuración? Pase el cursor sobre la etiqueta del indicador en el gráfico y haga clic en el <strong class='text-white'>icono del ojo</strong> para ocultarlo. Haga clic en el ojo de nuevo para recuperarlo. Es la forma rápida de despejar un gráfico saturado en plena sesión y restaurar todo exactamente como estaba." },
        { title: "Edite o elimine un indicador", html: "Para cambiar la configuración de un estudio, haga doble clic en el indicador del gráfico, o use el icono de engranaje/Configure de la barra de herramientas del gráfico, para volver a abrir su menú <strong class='text-white'>Properties</strong>. ¿Ya no lo necesita? Pase el cursor sobre la etiqueta del indicador y haga clic en el <strong class='text-white'>icono de papelera (eliminar)</strong> para quitarlo." },
      ],
    },
    { type: "heading",text: "Por qué le conviene saberlo" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Refinar entradas y salidas</strong>: superponga estudios de tendencia y momentum para confirmar una configuración antes de hacer clic en comprar o vender.",
        "<strong class='text-white'>Despejar rápido</strong>: oculte indicadores con el icono del ojo durante un scalp y restáurelos sin tener que añadirlos de nuevo.",
        "<strong class='text-white'>Probar ideas</strong>: cambie los parámetros del indicador en el menú Properties para ver cómo se comporta un estudio en distintos marcos temporales.",
        "<strong class='text-white'>Alinear con su automatización</strong>: replique exactamente los indicadores en los que se disparan sus alertas para que su gráfico y su bot estén de acuerdo.",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Una vez que los indicadores de su gráfico de Tradovate estén listos, <strong class='text-white'>PickMyTrade conecta sus alertas de TradingView directamente con su cuenta de Tradovate</strong>. En el momento en que se cumple la condición de su indicador, la operación se ejecuta automáticamente, sin clics manuales ni ejecuciones perdidas." },
  ], fr: [
    { type: "paragraph",html: "Vous voulez des moyennes mobiles, le VWAP ou le RSI sur votre graphique Tradovate ? Cela prend quelques secondes dès que vous savez où se trouve l’icône Indicators. Que vous affiniez une configuration, testiez une stratégie ou mettiez en place une automatisation avec PickMyTrade, voici exactement comment ajouter, rechercher, masquer et supprimer des indicateurs de graphique dans Tradovate." },
    { type: "heading",text: "Que sont les indicateurs de graphique Tradovate ?" },
    { type: "paragraph",html: "Les indicateurs sont des études techniques (moyennes mobiles, oscillateurs, outils de volume, etc.) qui s’affichent sur votre graphique de prix afin que vous puissiez lire d’un coup d’œil la dynamique, la tendance et la volatilité. La Tradovate Web App est livrée avec plus de 40 indicateurs intégrés. Lorsque l’ensemble intégré ne couvre pas ce que vous cherchez, une bibliothèque d’indicateurs personnalisés de la communauté est également disponible." },
    { type: "heading",text: "Ajoutez des indicateurs aux graphiques Tradovate : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez le menu Indicators sur votre graphique", html: "Ouvrez un graphique, puis survolez-le avec la souris pour faire apparaître la barre d’outils du graphique. Cliquez sur l’icône <strong class='text-white'>Indicators</strong> de cette barre et le menu Indicators s’ouvre." },
        { title: "Recherchez parmi les plus de 40 indicateurs intégrés", html: "Le menu Indicators liste toutes les études intégrées. Plutôt que de faire défiler, utilisez la <strong class='text-white'>zone de recherche (l’icône en forme de loupe) en haut de la liste</strong> pour filtrer par mot-clé. Saisissez « RSI », « VWAP » ou « moving average » et vous accédez directement à celui que vous voulez." },
        { title: "Ajoutez un indicateur et définissez ses propriétés", html: "Cliquez sur le nom d’un indicateur pour le placer sur le graphique. Son menu <strong class='text-white'>Properties</strong> s’ouvre immédiatement, afin que vous puissiez régler des paramètres comme la longueur, la source et la couleur. Réglez ce dont vous avez besoin, puis cliquez sur <strong class='text-white'>Save</strong> pour l’appliquer. Vous ne trouvez pas l’étude recherchée ? Ouvrez <strong class='text-white'>Explore Community Indicators</strong> pour parcourir les études personnalisées partagées par d’autres traders Tradovate." },
        { title: "Masquez ou affichez un indicateur", html: "Besoin de dégager le graphique sans perdre vos réglages ? Survolez l’étiquette de l’indicateur dans le graphique et cliquez sur l’<strong class='text-white'>icône en forme d’œil</strong> pour le masquer. Cliquez de nouveau sur l’œil pour le faire réapparaître. C’est le moyen rapide de désencombrer un graphique chargé en pleine séance et de tout restaurer exactement comme avant." },
        { title: "Modifiez ou supprimez un indicateur", html: "Pour modifier les réglages d’une étude, double-cliquez sur l’indicateur dans le graphique, ou utilisez l’icône d’engrenage/Configure de la barre d’outils du graphique, afin de rouvrir son menu <strong class='text-white'>Properties</strong>. Vous n’en avez plus besoin du tout ? Survolez l’étiquette de l’indicateur et cliquez sur l’<strong class='text-white'>icône de corbeille (supprimer)</strong> pour le retirer." },
      ],
    },
    { type: "heading",text: "Pourquoi en avez-vous besoin" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Affiner entrées et sorties</strong> : superposez des études de tendance et de dynamique pour confirmer une configuration avant de cliquer sur acheter ou vendre.",
        "<strong class='text-white'>Désencombrer rapidement</strong> : masquez les indicateurs avec l’icône en forme d’œil pendant un scalp, puis restaurez-les sans avoir à les rajouter.",
        "<strong class='text-white'>Tester des idées</strong> : modifiez les paramètres d’un indicateur dans le menu Properties pour voir comment une étude se comporte sur différentes unités de temps.",
        "<strong class='text-white'>Aligner sur votre automatisation</strong> : reproduisez exactement les indicateurs sur lesquels se déclenchent vos alertes, afin que votre graphique et votre bot concordent.",
      ],
    },
    { type: "heading",text: "Automatisez avec PickMyTrade" },
    { type: "paragraph",html: "Une fois les indicateurs de votre graphique Tradovate réglés, <strong class='text-white'>PickMyTrade connecte vos alertes TradingView directement à votre compte Tradovate</strong>. Dès que la condition de votre indicateur se déclenche, le trade est exécuté automatiquement, sans clic manuel et sans exécution manquée." },
  ], it: [
    { type: "paragraph",html: "Vuole medie mobili, VWAP o RSI sul Suo grafico Tradovate? Bastano pochi secondi una volta che sa dove si trova l’icona Indicators. Che stia affinando un setup, testando una strategia o predisponendo un’automazione con PickMyTrade, ecco esattamente come aggiungere, cercare, nascondere e rimuovere gli indicatori del grafico in Tradovate." },
    { type: "heading",text: "Cosa sono gli indicatori dei grafici Tradovate?" },
    { type: "paragraph",html: "Gli indicatori sono studi tecnici (medie mobili, oscillatori, strumenti di volume e altro) che vengono tracciati sopra il grafico dei prezzi, così da leggere a colpo d’occhio momentum, trend e volatilità. La Tradovate Web App include oltre 40 indicatori integrati. Quando l’insieme integrato non copre ciò che cerca, è disponibile anche una libreria di indicatori personalizzati della community che può importare." },
    { type: "heading",text: "Aggiunga indicatori ai grafici Tradovate: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Apra il menu Indicators sul Suo grafico", html: "Apra un grafico, quindi passi il mouse su di esso in modo che compaia la barra degli strumenti del grafico. Clicchi sull’icona <strong class='text-white'>Indicators</strong> in quella barra e si apre il menu Indicators." },
        { title: "Cerchi tra gli oltre 40 indicatori integrati", html: "Il menu Indicators elenca ogni studio integrato. Anziché scorrere, usi la <strong class='text-white'>casella di ricerca (l’icona della lente) in cima all’elenco</strong> per filtrare per parola chiave. Digiti «RSI», «VWAP» o «moving average» e passerà direttamente a quello che desidera." },
        { title: "Aggiunga un indicatore e imposti le sue proprietà", html: "Clicchi sul nome di un indicatore per inserirlo nel grafico. Il suo menu <strong class='text-white'>Properties</strong> si apre subito, così può regolare parametri come lunghezza, sorgente e colore. Imposti ciò che Le serve, quindi clicchi su <strong class='text-white'>Save</strong> per applicarlo. Non trova lo studio che cerca? Apra <strong class='text-white'>Explore Community Indicators</strong> per sfogliare gli studi personalizzati condivisi da altri trader Tradovate." },
        { title: "Nasconda o mostri un indicatore", html: "Ha bisogno di sgombrare il grafico senza perdere le impostazioni? Passi il cursore sull’etichetta dell’indicatore nel grafico e clicchi sull’<strong class='text-white'>icona dell’occhio</strong> per nasconderlo. Clicchi di nuovo sull’occhio per riportarlo. È il modo rapido per alleggerire un grafico affollato a sessione in corso e ripristinare tutto esattamente com’era." },
        { title: "Modifichi o rimuova un indicatore", html: "Per cambiare le impostazioni di uno studio, faccia doppio clic sull’indicatore nel grafico, oppure usi l’icona dell’ingranaggio/Configure nella barra degli strumenti del grafico, per riaprire il suo menu <strong class='text-white'>Properties</strong>. Non Le serve più? Passi il cursore sull’etichetta dell’indicatore e clicchi sull’<strong class='text-white'>icona del cestino (elimina)</strong> per rimuoverlo." },
      ],
    },
    { type: "heading",text: "Perché Le serve" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Affinare ingressi e uscite</strong>: sovrapponga studi di trend e momentum per confermare un setup prima di cliccare su acquista o vendi.",
        "<strong class='text-white'>Alleggerire in fretta</strong>: nasconda gli indicatori con l’icona dell’occhio durante uno scalp, poi li ripristini senza doverli aggiungere di nuovo.",
        "<strong class='text-white'>Testare idee</strong>: cambi i parametri dell’indicatore nel menu Properties per vedere come si comporta uno studio su diversi timeframe.",
        "<strong class='text-white'>Allinearsi alla Sua automazione</strong>: replichi esattamente gli indicatori su cui scattano i Suoi alert, così grafico e bot concordano.",
      ],
    },
    { type: "heading",text: "Automatizzi tutto con PickMyTrade" },
    { type: "paragraph",html: "Una volta messi a punto gli indicatori del Suo grafico Tradovate, <strong class='text-white'>PickMyTrade collega i Suoi alert di TradingView direttamente al Suo conto Tradovate</strong>. Nel momento in cui la condizione del Suo indicatore si attiva, il trade viene eseguito automaticamente, senza clic manuali e senza esecuzioni perse." },
  ] },
  ctaHeading: { en: "Trade Your Indicators Hands-Free", de: "Handeln Sie Ihre Indikatoren freihändig", es: "Opere sus indicadores sin intervenir", fr: "Tradez vos indicateurs sans les mains", it: "Operi con i Suoi indicatori a mani libere" },
