---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-chart-trading";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Trade Directly From Tradovate Charts";
const META_DESCRIPTION =
  "Tradovate chart trading: turn on Trade Mode to place, drag, and cancel stop and limit orders right on the chart, no DOM required.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Direkt aus Tradovate-Charts handeln", es: "Opere directamente desde los gráficos de Tradovate", fr: "Trader directement depuis les graphiques Tradovate", it: "Fare trading direttamente dai grafici di Tradovate" },
  dek: { en: "Want to place and manage trades without ever leaving your chart in Tradovate? This guide walks you through turning on chart trading and placing, dragging, and canceling orders right on the price chart, step by step.", de: "Sie möchten Trades platzieren und verwalten, ohne Ihren Chart in Tradovate je zu verlassen? Dieser Leitfaden zeigt Ihnen Schritt für Schritt, wie Sie das Chart-Trading aktivieren und Orders direkt im Preischart platzieren, verschieben und stornieren.", es: "¿Quiere colocar y gestionar operaciones sin salir nunca de su gráfico en Tradovate? Esta guía le explica paso a paso cómo activar el trading en gráfico y cómo colocar, arrastrar y cancelar órdenes directamente sobre el gráfico de precios.", fr: "Vous voulez passer et gérer vos trades sans jamais quitter votre graphique dans Tradovate ? Ce guide vous explique pas à pas comment activer le trading sur graphique et placer, déplacer et annuler des ordres directement sur le graphique des prix.", it: "Desidera piazzare e gestire i trade senza mai lasciare il Suo grafico in Tradovate? Questa guida Le spiega passo dopo passo come attivare il trading dal grafico e come piazzare, trascinare e annullare ordini direttamente sul grafico dei prezzi." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Want to place and manage trades without ever leaving your chart in Tradovate? Whether you're scalping fast futures like ES and NQ, reacting to a level you can actually see, or wiring up automation with PickMyTrade, this guide walks you through turning on chart trading and placing, dragging, and canceling orders right on the price chart, step by step." },
    { type: "heading", text: "What Is Chart Trading in Tradovate?" },
    { type: "paragraph", html: "Chart trading lets you place, modify, and cancel orders by clicking and dragging directly on the price chart instead of typing prices into the SuperDOM ladder. Tradovate calls the feature <strong class='text-white'>Trade Mode</strong>. Once it's on, the chart shows an order overlay, so you can drop a limit or stop exactly at the level you're watching and then drag it around as the trade develops. If you read setups visually and want your entries, stops, and targets sitting right on the price in front of you, this is the workflow you'll reach for." },
    { type: "heading", text: "Chart Trading in Tradovate: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Turn On Trade Mode", html: "Open an instrument in the <strong class='text-white'>Chart</strong> module, then turn on <strong class='text-white'>Trade Mode</strong> in the chart's settings, it lives with the chart controls in the top-right of the chart window. That adds the trading overlay to the price axis so you can place and manage orders directly on the chart. The exact wording of the toggle can vary a little by app version, so look for the option that enables trading, or \"Trade Mode,\" on the chart." },
        { title: "Place an Order on the Chart", html: "Left-click at the price level where you want your order, then choose the order type. Tradovate reads that price against the current market and suggests the right type: click <strong class='text-white'>below</strong> the market and it lines up a <strong class='text-white'>Buy Limit</strong> or <strong class='text-white'>Sell Stop</strong>; click <strong class='text-white'>above</strong> the market and it lines up a <strong class='text-white'>Sell Limit</strong> or <strong class='text-white'>Buy Stop</strong>. Confirm, and the working order shows up as a line on the chart at your chosen price." },
        { title: "Drag an Order to a New Price", html: "To modify a working order, grab its line and drag it up or down the price (Y) axis to the new level, then confirm the change so the order re-registers at the new price. The same motion works for the <strong class='text-white'>stop-loss</strong> and <strong class='text-white'>take-profit</strong> lines on an open position, trail a stop to breakeven, or push a target further out, without retyping a single number." },
        { title: "Cancel an Order From the Chart", html: "Hover over the order's line and click the <strong class='text-white'>X</strong> to cancel it. If that order is part of a bracket, canceling the entry pulls the whole linked set, its stop and target come off with it, so you're never left with orphaned orders working in the market." },
        { title: "Flatten Everything From the Chart", html: "When a trade turns against you and you want out fast, right-click the chart and choose <strong class='text-white'>Flatten</strong>. That closes the open position and cancels every working order on that instrument in one action, a clean panic-exit, no hunting through separate order tickets." },
      ],
    },
    { type: "heading", text: "Why You'd Need This" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Drop orders on levels you can see</strong>, support, resistance, VWAP, or a prior high or low.",
        "<strong class='text-white'>Adjust risk by dragging</strong> instead of retyping stop and target prices mid-trade.",
        "<strong class='text-white'>Manage a whole position</strong>, entry, stop, and target, without switching to the SuperDOM.",
        "<strong class='text-white'>Flatten in one click</strong> when conditions get volatile and fast.",
        "<strong class='text-white'>Keep everything in one view</strong> so working orders and brackets stay visible on the chart.",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Clicking and dragging on the chart is great when you're sitting at the desk, but setups fire while you're away, too. <strong class='text-white'>PickMyTrade links your TradingView alerts straight to your Tradovate account</strong>, so entries, stops, and targets get placed automatically the moment your chart setup triggers. No manual clicking, no dragging." },
  ], de: [
    { type: "paragraph",html: "Sie möchten Trades platzieren und verwalten, ohne Ihren Chart in Tradovate je zu verlassen? Ob Sie schnelle Futures wie ES und NQ scalpen, auf ein Niveau reagieren, das Sie tatsächlich sehen können, oder Automatisierung mit PickMyTrade einrichten: Dieser Leitfaden zeigt Ihnen Schritt für Schritt, wie Sie das Chart-Trading aktivieren und Orders direkt im Preischart platzieren, verschieben und stornieren." },
    { type: "heading",text: "Was ist Chart-Trading in Tradovate?" },
    { type: "paragraph",html: "Mit dem Chart-Trading platzieren, ändern und stornieren Sie Orders per Klicken und Ziehen direkt im Preischart, statt Preise in die SuperDOM-Leiter einzugeben. Tradovate nennt die Funktion <strong class='text-white'>Trade Mode</strong>. Sobald sie aktiviert ist, zeigt der Chart ein Order-Overlay, sodass Sie ein Limit oder einen Stopp genau auf dem Niveau setzen können, das Sie beobachten, und es anschließend im Verlauf des Trades verschieben. Wenn Sie Setups visuell lesen und Ihre Einstiege, Stopps und Ziele direkt auf dem Preis vor Ihnen sehen möchten, ist dies der Workflow, zu dem Sie greifen werden." },
    { type: "heading",text: "Chart-Trading in Tradovate: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Trade Mode einschalten", html: "Öffnen Sie ein Instrument im Modul <strong class='text-white'>Chart</strong> und schalten Sie dann in den Chart-Einstellungen <strong class='text-white'>Trade Mode</strong> ein; er befindet sich bei den Chart-Steuerelementen oben rechts im Chart-Fenster. Dadurch wird das Trading-Overlay zur Preisachse hinzugefügt, sodass Sie Orders direkt im Chart platzieren und verwalten können. Die genaue Bezeichnung des Schalters kann je nach App-Version leicht abweichen; suchen Sie nach der Option, die das Trading aktiviert, oder nach \"Trade Mode\" im Chart." },
        { title: "Eine Order im Chart platzieren", html: "Klicken Sie mit der linken Maustaste auf das Preisniveau, auf dem Ihre Order liegen soll, und wählen Sie dann den Ordertyp. Tradovate vergleicht diesen Preis mit dem aktuellen Markt und schlägt den passenden Typ vor: Klicken Sie <strong class='text-white'>unterhalb</strong> des Marktes, wird ein <strong class='text-white'>Buy Limit</strong> oder <strong class='text-white'>Sell Stop</strong> vorbereitet; klicken Sie <strong class='text-white'>oberhalb</strong> des Marktes, wird ein <strong class='text-white'>Sell Limit</strong> oder <strong class='text-white'>Buy Stop</strong> vorbereitet. Bestätigen Sie, und die aktive Order erscheint als Linie im Chart auf dem gewählten Preis." },
        { title: "Eine Order auf einen neuen Preis ziehen", html: "Um eine aktive Order zu ändern, greifen Sie ihre Linie und ziehen Sie sie auf der Preisachse (Y-Achse) nach oben oder unten auf das neue Niveau. Bestätigen Sie dann die Änderung, damit die Order mit dem neuen Preis neu registriert wird. Dieselbe Bewegung funktioniert für die Linien von <strong class='text-white'>Stop-Loss</strong> und <strong class='text-white'>Take-Profit</strong> einer offenen Position: Ziehen Sie einen Stopp auf Breakeven nach oder schieben Sie ein Ziel weiter hinaus, ohne eine einzige Zahl neu einzugeben." },
        { title: "Eine Order im Chart stornieren", html: "Fahren Sie mit der Maus über die Linie der Order und klicken Sie auf das <strong class='text-white'>X</strong>, um sie zu stornieren. Gehört die Order zu einem Bracket, nimmt das Stornieren des Einstiegs die gesamte verknüpfte Gruppe heraus: Stopp und Ziel verschwinden mit ihm, sodass nie verwaiste Orders im Markt zurückbleiben." },
        { title: "Alles aus dem Chart heraus glattstellen", html: "Wenn ein Trade gegen Sie läuft und Sie schnell raus möchten, klicken Sie mit der rechten Maustaste in den Chart und wählen Sie <strong class='text-white'>Flatten</strong>. Damit wird die offene Position geschlossen und jede aktive Order für dieses Instrument in einer einzigen Aktion storniert: ein sauberer Panik-Ausstieg, ohne in separaten Orderfenstern suchen zu müssen." },
      ],
    },
    { type: "heading",text: "Warum Sie das brauchen" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Setzen Sie Orders auf Niveaus, die Sie sehen können</strong>: Unterstützung, Widerstand, VWAP oder ein vorheriges Hoch bzw. Tief.",
        "<strong class='text-white'>Passen Sie das Risiko per Ziehen an</strong>, statt mitten im Trade Stopp- und Zielpreise neu einzutippen.",
        "<strong class='text-white'>Verwalten Sie eine ganze Position</strong>, Einstieg, Stopp und Ziel, ohne zum SuperDOM zu wechseln.",
        "<strong class='text-white'>Stellen Sie mit einem Klick glatt</strong>, wenn die Lage volatil und schnell wird.",
        "<strong class='text-white'>Behalten Sie alles in einer Ansicht</strong>, damit aktive Orders und Brackets im Chart sichtbar bleiben.",
      ],
    },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "Klicken und Ziehen im Chart ist hervorragend, wenn Sie am Schreibtisch sitzen, doch Setups lösen auch aus, wenn Sie nicht da sind. <strong class='text-white'>PickMyTrade verknüpft Ihre TradingView-Alerts direkt mit Ihrem Tradovate-Konto</strong>, sodass Einstiege, Stopps und Ziele automatisch platziert werden, sobald Ihr Chart-Setup auslöst. Kein manuelles Klicken, kein Ziehen." },
  ], es: [
    { type: "paragraph",html: "¿Quiere colocar y gestionar operaciones sin salir nunca de su gráfico en Tradovate? Ya sea que haga scalping en futuros rápidos como ES y NQ, reaccione a un nivel que realmente puede ver o configure la automatización con PickMyTrade, esta guía le explica paso a paso cómo activar el trading en gráfico y cómo colocar, arrastrar y cancelar órdenes directamente sobre el gráfico de precios." },
    { type: "heading",text: "¿Qué es el trading en gráfico en Tradovate?" },
    { type: "paragraph",html: "El trading en gráfico le permite colocar, modificar y cancelar órdenes haciendo clic y arrastrando directamente sobre el gráfico de precios en lugar de escribir precios en la escalera SuperDOM. Tradovate llama a esta función <strong class='text-white'>Trade Mode</strong>. Una vez activada, el gráfico muestra una superposición de órdenes, de modo que puede colocar un límite o un stop exactamente en el nivel que está observando y luego arrastrarlo a medida que evoluciona la operación. Si lee las configuraciones de forma visual y quiere sus entradas, stops y objetivos justo sobre el precio que tiene delante, este es el flujo de trabajo al que recurrirá." },
    { type: "heading",text: "Trading en gráfico en Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Active Trade Mode", html: "Abra un instrumento en el módulo <strong class='text-white'>Chart</strong> y luego active <strong class='text-white'>Trade Mode</strong> en la configuración del gráfico; se encuentra junto a los controles del gráfico, arriba a la derecha de la ventana. Esto añade la superposición de trading al eje de precios para que pueda colocar y gestionar órdenes directamente en el gráfico. La redacción exacta del interruptor puede variar un poco según la versión de la aplicación, así que busque la opción que habilita el trading, o \"Trade Mode\", en el gráfico." },
        { title: "Coloque una orden en el gráfico", html: "Haga clic izquierdo en el nivel de precio donde desea su orden y luego elija el tipo de orden. Tradovate compara ese precio con el mercado actual y sugiere el tipo adecuado: si hace clic <strong class='text-white'>por debajo</strong> del mercado, prepara una <strong class='text-white'>Buy Limit</strong> o una <strong class='text-white'>Sell Stop</strong>; si hace clic <strong class='text-white'>por encima</strong> del mercado, prepara una <strong class='text-white'>Sell Limit</strong> o una <strong class='text-white'>Buy Stop</strong>. Confirme y la orden activa aparece como una línea en el gráfico en el precio elegido." },
        { title: "Arrastre una orden a un nuevo precio", html: "Para modificar una orden activa, tome su línea y arrástrela hacia arriba o hacia abajo por el eje de precios (eje Y) hasta el nuevo nivel; luego confirme el cambio para que la orden se registre de nuevo al nuevo precio. El mismo gesto funciona con las líneas de <strong class='text-white'>stop-loss</strong> y <strong class='text-white'>take-profit</strong> de una posición abierta: lleve un stop a breakeven o aleje un objetivo sin volver a escribir un solo número." },
        { title: "Cancele una orden desde el gráfico", html: "Pase el cursor sobre la línea de la orden y haga clic en la <strong class='text-white'>X</strong> para cancelarla. Si esa orden forma parte de un bracket, cancelar la entrada retira todo el conjunto vinculado: su stop y su objetivo desaparecen con ella, de modo que nunca le quedan órdenes huérfanas activas en el mercado." },
        { title: "Cierre todo desde el gráfico", html: "Cuando una operación va en su contra y quiere salir rápido, haga clic derecho en el gráfico y elija <strong class='text-white'>Flatten</strong>. Esto cierra la posición abierta y cancela todas las órdenes activas de ese instrumento en una sola acción: una salida de pánico limpia, sin tener que buscar entre tickets de órdenes separados." },
      ],
    },
    { type: "heading",text: "Por qué lo necesitará" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Coloque órdenes en niveles que puede ver</strong>: soporte, resistencia, VWAP o un máximo o mínimo previo.",
        "<strong class='text-white'>Ajuste el riesgo arrastrando</strong> en lugar de reescribir los precios de stop y objetivo a mitad de operación.",
        "<strong class='text-white'>Gestione una posición completa</strong>, entrada, stop y objetivo, sin cambiar al SuperDOM.",
        "<strong class='text-white'>Cierre con un solo clic</strong> cuando las condiciones se vuelven volátiles y rápidas.",
        "<strong class='text-white'>Mantenga todo en una sola vista</strong> para que las órdenes activas y los brackets sigan visibles en el gráfico.",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Hacer clic y arrastrar en el gráfico es genial cuando está sentado frente al escritorio, pero las configuraciones también se activan cuando usted no está. <strong class='text-white'>PickMyTrade vincula sus alertas de TradingView directamente con su cuenta de Tradovate</strong>, de modo que las entradas, los stops y los objetivos se colocan automáticamente en el momento en que se activa su configuración de gráfico. Sin clics manuales, sin arrastrar." },
  ], fr: [
    { type: "paragraph",html: "Vous voulez passer et gérer vos trades sans jamais quitter votre graphique dans Tradovate ? Que vous fassiez du scalping sur des futures rapides comme ES et NQ, que vous réagissiez à un niveau que vous voyez réellement, ou que vous mettiez en place l'automatisation avec PickMyTrade, ce guide vous explique pas à pas comment activer le trading sur graphique et placer, déplacer et annuler des ordres directement sur le graphique des prix." },
    { type: "heading",text: "Qu'est-ce que le trading sur graphique dans Tradovate ?" },
    { type: "paragraph",html: "Le trading sur graphique vous permet de placer, modifier et annuler des ordres en cliquant et en faisant glisser directement sur le graphique des prix, au lieu de saisir des prix dans l'échelle SuperDOM. Tradovate appelle cette fonctionnalité <strong class='text-white'>Trade Mode</strong>. Une fois activée, le graphique affiche une superposition d'ordres : vous pouvez ainsi placer un ordre limite ou un stop exactement au niveau que vous observez, puis le déplacer au fil de l'évolution du trade. Si vous lisez vos configurations visuellement et voulez vos entrées, stops et objectifs directement sur le prix sous vos yeux, c'est le flux de travail qu'il vous faut." },
    { type: "heading",text: "Le trading sur graphique dans Tradovate : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Activer Trade Mode", html: "Ouvrez un instrument dans le module <strong class='text-white'>Chart</strong>, puis activez <strong class='text-white'>Trade Mode</strong> dans les paramètres du graphique ; il se trouve avec les contrôles du graphique, en haut à droite de la fenêtre. Cela ajoute la superposition de trading à l'axe des prix afin que vous puissiez placer et gérer vos ordres directement sur le graphique. L'intitulé exact de l'option peut varier légèrement selon la version de l'application ; cherchez l'option qui active le trading, ou \"Trade Mode\", sur le graphique." },
        { title: "Placer un ordre sur le graphique", html: "Faites un clic gauche au niveau de prix où vous voulez votre ordre, puis choisissez le type d'ordre. Tradovate compare ce prix au marché actuel et propose le type adapté : cliquez <strong class='text-white'>en dessous</strong> du marché et il prépare un <strong class='text-white'>Buy Limit</strong> ou un <strong class='text-white'>Sell Stop</strong> ; cliquez <strong class='text-white'>au-dessus</strong> du marché et il prépare un <strong class='text-white'>Sell Limit</strong> ou un <strong class='text-white'>Buy Stop</strong>. Confirmez, et l'ordre actif apparaît sous forme de ligne sur le graphique au prix choisi." },
        { title: "Faire glisser un ordre vers un nouveau prix", html: "Pour modifier un ordre actif, saisissez sa ligne et faites-la glisser vers le haut ou le bas sur l'axe des prix (axe Y) jusqu'au nouveau niveau, puis confirmez la modification afin que l'ordre soit réenregistré au nouveau prix. Le même geste fonctionne pour les lignes de <strong class='text-white'>stop-loss</strong> et de <strong class='text-white'>take-profit</strong> d'une position ouverte : remontez un stop au point mort ou éloignez un objectif sans ressaisir un seul chiffre." },
        { title: "Annuler un ordre depuis le graphique", html: "Survolez la ligne de l'ordre et cliquez sur le <strong class='text-white'>X</strong> pour l'annuler. Si cet ordre fait partie d'un bracket, l'annulation de l'entrée retire l'ensemble lié : son stop et son objectif disparaissent avec elle, de sorte que vous ne laissez jamais d'ordres orphelins actifs sur le marché." },
        { title: "Tout clôturer depuis le graphique", html: "Lorsqu'un trade tourne contre vous et que vous voulez sortir vite, faites un clic droit sur le graphique et choisissez <strong class='text-white'>Flatten</strong>. Cela clôture la position ouverte et annule tous les ordres actifs sur cet instrument en une seule action : une sortie d'urgence propre, sans devoir chercher dans des tickets d'ordre séparés." },
      ],
    },
    { type: "heading",text: "Pourquoi vous en avez besoin" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Placez des ordres sur des niveaux visibles</strong> : support, résistance, VWAP ou un plus haut ou plus bas précédent.",
        "<strong class='text-white'>Ajustez le risque en faisant glisser</strong> plutôt qu'en ressaisissant les prix de stop et d'objectif en plein trade.",
        "<strong class='text-white'>Gérez une position entière</strong>, entrée, stop et objectif, sans passer au SuperDOM.",
        "<strong class='text-white'>Clôturez en un clic</strong> lorsque les conditions deviennent volatiles et rapides.",
        "<strong class='text-white'>Gardez tout dans une seule vue</strong> pour que les ordres actifs et les brackets restent visibles sur le graphique.",
      ],
    },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Cliquer et faire glisser sur le graphique est idéal lorsque vous êtes devant votre bureau, mais les configurations se déclenchent aussi en votre absence. <strong class='text-white'>PickMyTrade relie vos alertes TradingView directement à votre compte Tradovate</strong>, de sorte que les entrées, les stops et les objectifs sont placés automatiquement dès que votre configuration de graphique se déclenche. Aucun clic manuel, aucun glissement." },
  ], it: [
    { type: "paragraph",html: "Desidera piazzare e gestire i trade senza mai lasciare il Suo grafico in Tradovate? Che faccia scalping su futures veloci come ES e NQ, reagisca a un livello che può realmente vedere o configuri l'automazione con PickMyTrade, questa guida Le spiega passo dopo passo come attivare il trading dal grafico e come piazzare, trascinare e annullare ordini direttamente sul grafico dei prezzi." },
    { type: "heading",text: "Che cos'è il trading dal grafico in Tradovate?" },
    { type: "paragraph",html: "Il trading dal grafico Le consente di piazzare, modificare e annullare ordini cliccando e trascinando direttamente sul grafico dei prezzi, invece di digitare i prezzi nella scala SuperDOM. Tradovate chiama questa funzione <strong class='text-white'>Trade Mode</strong>. Una volta attivata, il grafico mostra una sovrapposizione degli ordini, così può inserire un limit o uno stop esattamente al livello che sta osservando e poi trascinarlo man mano che il trade si sviluppa. Se legge i setup in modo visivo e vuole ingressi, stop e target direttamente sul prezzo che ha davanti, questo è il flusso di lavoro che userà." },
    { type: "heading",text: "Trading dal grafico in Tradovate: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Attivare Trade Mode", html: "Apra uno strumento nel modulo <strong class='text-white'>Chart</strong>, poi attivi <strong class='text-white'>Trade Mode</strong> nelle impostazioni del grafico; si trova insieme ai controlli del grafico, in alto a destra nella finestra. Questo aggiunge la sovrapposizione di trading all'asse dei prezzi, così può piazzare e gestire gli ordini direttamente sul grafico. La dicitura esatta dell'interruttore può variare leggermente a seconda della versione dell'app, quindi cerchi l'opzione che abilita il trading, o \"Trade Mode\", sul grafico." },
        { title: "Piazzare un ordine sul grafico", html: "Clicchi con il tasto sinistro sul livello di prezzo in cui vuole il Suo ordine, poi scelga il tipo di ordine. Tradovate confronta quel prezzo con il mercato attuale e suggerisce il tipo corretto: clicchi <strong class='text-white'>sotto</strong> il mercato e prepara un <strong class='text-white'>Buy Limit</strong> o un <strong class='text-white'>Sell Stop</strong>; clicchi <strong class='text-white'>sopra</strong> il mercato e prepara un <strong class='text-white'>Sell Limit</strong> o un <strong class='text-white'>Buy Stop</strong>. Confermi, e l'ordine attivo compare come linea sul grafico al prezzo scelto." },
        { title: "Trascinare un ordine a un nuovo prezzo", html: "Per modificare un ordine attivo, afferri la sua linea e la trascini su o giù lungo l'asse dei prezzi (asse Y) fino al nuovo livello, poi confermi la modifica in modo che l'ordine venga registrato di nuovo al nuovo prezzo. Lo stesso gesto funziona per le linee di <strong class='text-white'>stop-loss</strong> e <strong class='text-white'>take-profit</strong> di una posizione aperta: porti uno stop a breakeven o allontani un target senza digitare di nuovo alcun numero." },
        { title: "Annullare un ordine dal grafico", html: "Passi il mouse sulla linea dell'ordine e clicchi sulla <strong class='text-white'>X</strong> per annullarlo. Se quell'ordine fa parte di un bracket, annullare l'ingresso rimuove l'intero gruppo collegato: stop e target vengono tolti insieme a esso, così non Le restano mai ordini orfani attivi sul mercato." },
        { title: "Chiudere tutto dal grafico", html: "Quando un trade va contro di Lei e vuole uscire in fretta, clicchi con il tasto destro sul grafico e scelga <strong class='text-white'>Flatten</strong>. Questo chiude la posizione aperta e annulla ogni ordine attivo su quello strumento in una sola azione: un'uscita di emergenza pulita, senza dover cercare tra ticket d'ordine separati." },
      ],
    },
    { type: "heading",text: "Perché Le serve" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Piazzi ordini su livelli che può vedere</strong>: supporto, resistenza, VWAP o un massimo o minimo precedente.",
        "<strong class='text-white'>Regoli il rischio trascinando</strong> invece di digitare di nuovo i prezzi di stop e target a metà trade.",
        "<strong class='text-white'>Gestisca un'intera posizione</strong>, ingresso, stop e target, senza passare al SuperDOM.",
        "<strong class='text-white'>Chiuda tutto con un clic</strong> quando le condizioni diventano volatili e veloci.",
        "<strong class='text-white'>Tenga tutto in un'unica vista</strong> così ordini attivi e bracket restano visibili sul grafico.",
      ],
    },
    { type: "heading",text: "Automatizzi tutto questo con PickMyTrade" },
    { type: "paragraph",html: "Cliccare e trascinare sul grafico è ottimo quando è seduto alla scrivania, ma i setup si attivano anche quando Lei non c'è. <strong class='text-white'>PickMyTrade collega i Suoi alert di TradingView direttamente al Suo conto Tradovate</strong>, così ingressi, stop e target vengono piazzati automaticamente nel momento in cui scatta il Suo setup di grafico. Nessun clic manuale, nessun trascinamento." },
  ] },
  ctaHeading: { en: "Put Your Chart Setups on Autopilot", de: "Bringen Sie Ihre Chart-Setups auf Autopilot", es: "Ponga sus configuraciones de gráfico en piloto automático", fr: "Mettez vos configurations de graphique en pilote automatique", it: "Metta i Suoi setup di grafico in pilota automatico" },
  ctaText: { en: "Setups fire while you're away, too. Let PickMyTrade link your TradingView alerts straight to your Tradovate account so entries, stops, and targets place automatically.", de: "Setups lösen auch aus, wenn Sie nicht da sind. Lassen Sie PickMyTrade Ihre TradingView-Alerts direkt mit Ihrem Tradovate-Konto verknüpfen, damit Einstiege, Stopps und Ziele automatisch platziert werden.", es: "Las configuraciones también se activan cuando usted no está. Deje que PickMyTrade vincule sus alertas de TradingView directamente con su cuenta de Tradovate para que las entradas, los stops y los objetivos se coloquen automáticamente.", fr: "Les configurations se déclenchent aussi en votre absence. Laissez PickMyTrade relier vos alertes TradingView directement à votre compte Tradovate pour que les entrées, les stops et les objectifs soient placés automatiquement.", it: "I setup si attivano anche quando Lei non c'è. Lasci che PickMyTrade colleghi i Suoi alert di TradingView direttamente al Suo conto Tradovate, così ingressi, stop e target vengono piazzati automaticamente." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "How do I enable chart trading in Tradovate?", a: "Open an instrument in the Chart module and turn on Trade Mode in the chart settings (top-right of the chart window). That adds the order overlay to the price axis. The exact label can differ by app version, so look for the toggle that enables trading on the chart." },
    { q: "How do I place a limit or stop order on the chart?", a: "Left-click at the price you want and pick the order type. Tradovate infers a limit or stop from whether that price sits above or below the current market, click below for a Buy Limit or Sell Stop, above for a Sell Limit or Buy Stop, then confirm." },
    { q: "How do I move or cancel an order on the chart?", a: "Drag the order's line to a new price and confirm to modify it, or hover over the line and click the X to cancel. Canceling a bracket's entry also cancels its linked stop and take profit." },
  ], de: [
    { q: "Wie aktiviere ich das Chart-Trading in Tradovate?", a: "Öffnen Sie ein Instrument im Chart-Modul und aktivieren Sie Trade Mode in den Chart-Einstellungen (oben rechts im Chart-Fenster). Dadurch wird das Order-Overlay zur Preisachse hinzugefügt. Die genaue Bezeichnung kann je nach App-Version abweichen; suchen Sie nach dem Schalter, der das Trading im Chart aktiviert." },
    { q: "Wie platziere ich eine Limit- oder Stop-Order im Chart?", a: "Klicken Sie mit der linken Maustaste auf den gewünschten Preis und wählen Sie den Ordertyp. Tradovate leitet Limit oder Stop daraus ab, ob dieser Preis über oder unter dem aktuellen Markt liegt: Ein Klick darunter ergibt Buy Limit oder Sell Stop, ein Klick darüber Sell Limit oder Buy Stop; bestätigen Sie dann." },
    { q: "Wie verschiebe oder storniere ich eine Order im Chart?", a: "Ziehen Sie die Linie der Order auf einen neuen Preis und bestätigen Sie, um sie zu ändern, oder fahren Sie über die Linie und klicken Sie auf das X, um sie zu stornieren. Wird der Einstieg eines Brackets storniert, werden auch der verknüpfte Stopp und das Take-Profit storniert." },
  ], es: [
    { q: "¿Cómo activo el trading en gráfico en Tradovate?", a: "Abra un instrumento en el módulo Chart y active Trade Mode en la configuración del gráfico (arriba a la derecha de la ventana del gráfico). Esto añade la superposición de órdenes al eje de precios. La etiqueta exacta puede variar según la versión de la aplicación, así que busque el interruptor que habilita el trading en el gráfico." },
    { q: "¿Cómo coloco una orden límite o stop en el gráfico?", a: "Haga clic izquierdo en el precio que desee y elija el tipo de orden. Tradovate deduce si es límite o stop según si ese precio está por encima o por debajo del mercado actual: haga clic por debajo para una Buy Limit o Sell Stop, por encima para una Sell Limit o Buy Stop, y luego confirme." },
    { q: "¿Cómo muevo o cancelo una orden en el gráfico?", a: "Arrastre la línea de la orden a un nuevo precio y confirme para modificarla, o pase el cursor sobre la línea y haga clic en la X para cancelarla. Cancelar la entrada de un bracket también cancela su stop y su take profit vinculados." },
  ], fr: [
    { q: "Comment activer le trading sur graphique dans Tradovate ?", a: "Ouvrez un instrument dans le module Chart et activez Trade Mode dans les paramètres du graphique (en haut à droite de la fenêtre du graphique). Cela ajoute la superposition d'ordres à l'axe des prix. L'intitulé exact peut varier selon la version de l'application ; cherchez l'option qui active le trading sur le graphique." },
    { q: "Comment placer un ordre à cours limité ou un stop sur le graphique ?", a: "Faites un clic gauche au prix souhaité et choisissez le type d'ordre. Tradovate déduit un ordre limite ou un stop selon que ce prix se situe au-dessus ou en dessous du marché actuel : cliquez en dessous pour un Buy Limit ou un Sell Stop, au-dessus pour un Sell Limit ou un Buy Stop, puis confirmez." },
    { q: "Comment déplacer ou annuler un ordre sur le graphique ?", a: "Faites glisser la ligne de l'ordre vers un nouveau prix et confirmez pour le modifier, ou survolez la ligne et cliquez sur le X pour l'annuler. L'annulation de l'entrée d'un bracket annule aussi son stop et son take profit liés." },
  ], it: [
    { q: "Come attivo il trading dal grafico in Tradovate?", a: "Apra uno strumento nel modulo Chart e attivi Trade Mode nelle impostazioni del grafico (in alto a destra nella finestra del grafico). Questo aggiunge la sovrapposizione degli ordini all'asse dei prezzi. L'etichetta esatta può variare a seconda della versione dell'app, quindi cerchi l'interruttore che abilita il trading sul grafico." },
    { q: "Come piazzo un ordine limit o stop sul grafico?", a: "Clicchi con il tasto sinistro sul prezzo desiderato e scelga il tipo di ordine. Tradovate deduce se si tratta di un limit o di uno stop a seconda che quel prezzo si trovi sopra o sotto il mercato attuale: clicchi sotto per un Buy Limit o Sell Stop, sopra per un Sell Limit o Buy Stop, quindi confermi." },
    { q: "Come sposto o annullo un ordine sul grafico?", a: "Trascini la linea dell'ordine su un nuovo prezzo e confermi per modificarlo, oppure passi sopra la linea e clicchi sulla X per annullarlo. Annullare l'ingresso di un bracket annulla anche lo stop e il take profit collegati." },
  ] },
  relatedHeading: { en: "Related Guides", de: "Verwandte Leitfäden", es: "Guías relacionadas", fr: "Guides associés", it: "Guide correlate" },
  disclosureText: { en: `This guide is for educational and informational purposes only and is not financial, investment, or trading advice. Trading futures and other leveraged products carries a substantial risk of loss and is not suitable for every investor. PickMyTrade is an independent third-party automation platform and is not affiliated with, endorsed by, or sponsored by Tradovate, Inc. "Tradovate" and all related names, logos, and trademarks are the property of their respective owners. Platform features and steps change over time, so always confirm the current process in the official Tradovate platform and documentation before acting.`, de: "Dieser Leitfaden dient ausschließlich Bildungs- und Informationszwecken und stellt keine Finanz-, Anlage- oder Handelsberatung dar. Der Handel mit Futures und anderen gehebelten Produkten birgt ein erhebliches Verlustrisiko und ist nicht für jeden Anleger geeignet. PickMyTrade ist eine unabhängige Automatisierungsplattform eines Drittanbieters und steht in keiner Verbindung zu Tradovate, Inc., wird weder von dieser unterstützt noch gesponsert. \"Tradovate\" und alle zugehörigen Namen, Logos und Marken sind Eigentum ihrer jeweiligen Inhaber. Plattformfunktionen und Schritte ändern sich im Laufe der Zeit; prüfen Sie daher stets den aktuellen Ablauf in der offiziellen Tradovate-Plattform und -Dokumentation, bevor Sie handeln.", es: "Esta guía tiene fines exclusivamente educativos e informativos y no constituye asesoramiento financiero, de inversión ni de trading. Operar con futuros y otros productos apalancados conlleva un riesgo sustancial de pérdida y no es adecuado para todos los inversores. PickMyTrade es una plataforma de automatización independiente de terceros y no está afiliada, respaldada ni patrocinada por Tradovate, Inc. \"Tradovate\" y todos los nombres, logotipos y marcas relacionados son propiedad de sus respectivos titulares. Las funciones de la plataforma y los pasos cambian con el tiempo, por lo que debe confirmar siempre el proceso actual en la plataforma y la documentación oficiales de Tradovate antes de actuar.", fr: "Ce guide est fourni à des fins éducatives et informatives uniquement et ne constitue pas un conseil financier, d'investissement ou de trading. Le trading de contrats à terme et d'autres produits à effet de levier comporte un risque de perte important et ne convient pas à tous les investisseurs. PickMyTrade est une plateforme d'automatisation tierce indépendante et n'est ni affiliée à Tradovate, Inc., ni approuvée ou parrainée par cette dernière. \"Tradovate\" et tous les noms, logos et marques associés sont la propriété de leurs détenteurs respectifs. Les fonctionnalités et les étapes de la plateforme évoluent avec le temps ; vérifiez donc toujours la procédure en vigueur dans la plateforme et la documentation officielles de Tradovate avant d'agir.", it: "Questa guida ha esclusivamente scopo educativo e informativo e non costituisce consulenza finanziaria, di investimento o di trading. Il trading di futures e di altri prodotti a leva comporta un rischio sostanziale di perdita e non è adatto a tutti gli investitori. PickMyTrade è una piattaforma di automazione indipendente di terze parti e non è affiliata, approvata né sponsorizzata da Tradovate, Inc. \"Tradovate\" e tutti i nomi, loghi e marchi correlati sono di proprietà dei rispettivi titolari. Le funzionalità della piattaforma e i passaggi cambiano nel tempo, quindi verifichi sempre la procedura attuale nella piattaforma e nella documentazione ufficiali di Tradovate prima di agire." },
};
const data: GuideArticleData = resolveGuideContent(content, locale, related);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: data.faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}${withSlash(localizedPath(locale))}` },
    { "@type": "ListItem", position: 2, name: "How-To", item: `${SITE_URL}${withSlash(localizedPath(locale, "how-to"))}` },
    { "@type": "ListItem", position: 3, name: content.h1[locale], item: `${SITE_URL}${withSlash(localizedPath(locale, `how-to/${SLUG}`))}` },
  ],
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: content.h1[locale],
  description: content.dek[locale],
  image: `${SITE_URL}/assets/og-default.webp`,
  publisher: { "@type": "Organization", name: "PickMyTrade", logo: { "@type": "ImageObject", url: `${SITE_URL}/assets/logo.png` } },
  datePublished: "2026-07-08",
  dateModified: "2026-07-08",
  mainEntityOfPage: { "@type": "WebPage", "@id": `${SITE_URL}${withSlash(localizedPath(locale, `how-to/${SLUG}`))}` },
};
---

<BaseLayout
