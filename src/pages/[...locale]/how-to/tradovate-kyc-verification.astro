---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-kyc-verification";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Complete Tradovate KYC & ID Verification";
const META_DESCRIPTION =
  "Complete Tradovate's KYC check fast: the ID and proof-of-address documents you need, the Veriff photo-and-selfie step, and how to upload them.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate-KYC und ID-Verifizierung abschließen", es: "Complete el KYC y la verificación de identidad de Tradovate", fr: "Effectuer le KYC et la vérification d'identité Tradovate", it: "Completare il KYC e la verifica dell'identità di Tradovate" },
  dek: { en: "Before Tradovate lets you trade a live futures account, you have to prove you're really you. Here's exactly what documents you need, how the Veriff photo-and-selfie check works, and how to upload files if more is needed.", de: "Bevor Tradovate Ihnen den Handel mit einem Live-Futures-Konto erlaubt, müssen Sie nachweisen, dass Sie wirklich Sie sind. Hier erfahren Sie genau, welche Dokumente Sie brauchen, wie die Veriff-Prüfung mit Foto und Selfie funktioniert und wie Sie Dateien hochladen, falls mehr benötigt wird.", es: "Antes de que Tradovate le permita operar en una cuenta de futuros real, debe demostrar que realmente es usted. Aquí tiene exactamente qué documentos necesita, cómo funciona la verificación de foto y selfie de Veriff y cómo subir archivos si se necesita más.", fr: "Avant que Tradovate ne vous autorise à négocier sur un compte de contrats à terme réel, vous devez prouver que vous êtes bien vous. Voici exactement quels documents vous devez fournir, comment fonctionne la vérification par photo et selfie de Veriff, et comment téléverser des fichiers si davantage est demandé.", it: "Prima che Tradovate le consenta di operare con un conto futures reale, deve dimostrare di essere davvero lei. Ecco esattamente quali documenti servono, come funziona il controllo con foto e selfie di Veriff e come caricare i file se ne servono altri." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Before Tradovate lets you trade a live futures account, you have to prove you're really you. That's the KYC check, Know Your Customer, the same identity screening every regulated US brokerage runs. Most of it is automated: a photo of your ID, a quick selfie, and sometimes a document that confirms where you live. Get the files right the first time and it clears in a day or two. Send a blurry scan or a name that doesn't match, and you're waiting on a second round." },
    { type: "heading", text: "What KYC Verification Means" },
    { type: "paragraph", html: "KYC is the legal check that confirms your identity before you can fund and trade a live account. Tradovate runs it two ways. An automated identity service called <strong class='text-white'>Veriff</strong> handles the fast path, you photograph your government ID and take a selfie, and it matches the two. If anything can't be confirmed automatically, or the New Accounts team needs more, you'll be asked to upload documents manually through the platform." },
    { type: "paragraph", html: "One note up front: if you're trading a prop-firm evaluation, your firm usually runs its own onboarding and identity checks. Requirements there vary by firm and account size, so check your firm's current rules. This guide covers the standard Tradovate live-account process." },
    { type: "heading", text: "Complete Tradovate KYC: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Gather Your ID and Proof-of-Address Documents", html: "Have a <strong class='text-white'>government-issued photo ID</strong> ready, driver's license, passport, or state ID, that clearly shows your full legal name, your photograph, and your date of birth, and isn't expired. Also have a recent <strong class='text-white'>proof of address</strong> on hand in case one is requested; Tradovate accepts documents dated within the last 90 days. Whatever you submit, the image has to be sharp and fully readable, with all four corners of the document visible, and the name on every document should match the name on your Tradovate account exactly." },
        { title: "Complete the Veriff Identity Check", html: "Veriff is the automated ID checker Tradovate uses. You'll get prompted to run it, usually right in the application flow, or through a secure link Tradovate emails you. It works on a phone or a computer, iOS, Android, or a browser, so use whatever has the better camera. Snap a photo of the front (and sometimes back) of your ID, then take a selfie so it can match your face to the document, there's no typing your details in by hand. Good lighting, a plain background, and holding the card flat with no glare help it pass on the first try." },
        { title: "Upload Any Requested Documents", html: "If the automated check needs backup, or Tradovate emails you asking for a specific document, you upload it right in the platform. Log in to the Tradovate web app, click <strong class='text-white'>Application Settings</strong> in the top-right, and open the <strong class='text-white'>Your Profile</strong> tab. From there, choose <strong class='text-white'>Upload Documents</strong>. A pop-up asks for a verification code that Tradovate emails you, enter it and the upload screen unlocks. Follow the prompts to attach your files, then click <strong class='text-white'>Done</strong> to submit." },
        { title: "Wait for the New Accounts Review", html: "Once you submit, Tradovate's New Accounts team reviews everything within one to two business days. If a document can't be accepted, a blurry scan, an expired ID, a name that doesn't match, you'll get a follow-up email spelling out exactly what to fix and resubmit. You generally have about two weeks from the original request to get everything in, so don't sit on it. Once you're cleared, you can fund the account and start trading." },
      ],
    },
    { type: "heading", text: "What Counts as Proof of Address" },
    {
      type: "table",
      headers: ["Document type", "Notes"],
      rows: [
        ["Utility bill", "Gas, water, electricity, or landline phone"],
        ["Bank statement", "Monthly statement, all pages, account titled in your name"],
        ["Lease agreement", "Current lease showing your residential address"],
        ["Insurance statement", "Homeowner's or renter's insurance"],
        ["Mortgage statement", "Current statement with your address"],
      ],
    },
    { type: "heading", text: "Common Reasons Verification Gets Held Up" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Blurry or cropped images</strong>, a cut-off corner or soft focus gets a document bounced.",
        "<strong class='text-white'>Expired ID</strong>, an out-of-date license or passport won't pass.",
        "<strong class='text-white'>Name mismatch</strong>, your ID, proof of address, and Tradovate account all need to line up.",
        "<strong class='text-white'>Stale proof of address</strong>, anything older than 90 days is rejected.",
      ],
    },
    { type: "heading", text: "Automate Tradovate Once You're Cleared" },
    { type: "paragraph", html: "KYC is a one-time hurdle. Once your live account is verified and funded, <strong class='text-white'>PickMyTrade wires your TradingView alerts straight into Tradovate</strong> so entries, stops, and targets fire automatically, no manual clicks while you're away from the desk." },
  ], de: [
    { type: "paragraph",html: "Bevor Tradovate Ihnen den Handel mit einem Live-Futures-Konto erlaubt, müssen Sie nachweisen, dass Sie wirklich Sie sind. Das ist die KYC-Prüfung, Know Your Customer, dieselbe Identitätsprüfung, die jeder regulierte US-Broker durchführt. Das meiste läuft automatisiert: ein Foto Ihres Ausweises, ein kurzes Selfie und manchmal ein Dokument, das Ihren Wohnort bestätigt. Wenn die Dateien auf Anhieb stimmen, ist es in ein bis zwei Tagen erledigt. Senden Sie einen unscharfen Scan oder einen nicht übereinstimmenden Namen, warten Sie auf eine zweite Runde." },
    { type: "heading",text: "Was die KYC-Verifizierung bedeutet" },
    { type: "paragraph",html: "KYC ist die gesetzliche Prüfung, die Ihre Identität bestätigt, bevor Sie ein Live-Konto finanzieren und handeln können. Tradovate führt sie auf zwei Wegen durch. Ein automatisierter Identitätsdienst namens <strong class='text-white'>Veriff</strong> übernimmt den schnellen Weg: Sie fotografieren Ihren amtlichen Ausweis und machen ein Selfie, und der Dienst gleicht beides ab. Wenn etwas nicht automatisch bestätigt werden kann oder das New-Accounts-Team mehr benötigt, werden Sie gebeten, Dokumente manuell über die Plattform hochzuladen." },
    { type: "paragraph",html: "Vorab ein Hinweis: Wenn Sie eine Prop-Firm-Evaluierung handeln, führt Ihre Firma in der Regel ein eigenes Onboarding und eigene Identitätsprüfungen durch. Die Anforderungen variieren dort je nach Firma und Kontogröße, prüfen Sie daher die aktuellen Regeln Ihrer Firma. Diese Anleitung behandelt den standardmäßigen Tradovate-Live-Konto-Prozess." },
    { type: "heading",text: "Tradovate-KYC abschließen: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Ausweis und Adressnachweis bereitlegen", html: "Halten Sie einen <strong class='text-white'>amtlichen Lichtbildausweis</strong> bereit, Führerschein, Reisepass oder staatlichen Ausweis, der Ihren vollständigen rechtlichen Namen, Ihr Foto und Ihr Geburtsdatum deutlich zeigt und nicht abgelaufen ist. Halten Sie außerdem einen aktuellen <strong class='text-white'>Adressnachweis</strong> bereit, falls einer angefordert wird; Tradovate akzeptiert Dokumente, die innerhalb der letzten 90 Tage datiert sind. Was auch immer Sie einreichen, das Bild muss scharf und vollständig lesbar sein, alle vier Ecken des Dokuments müssen sichtbar sein, und der Name auf jedem Dokument sollte exakt mit dem Namen auf Ihrem Tradovate-Konto übereinstimmen." },
        { title: "Die Veriff-Identitätsprüfung durchführen", html: "Veriff ist der automatisierte Ausweisprüfer, den Tradovate verwendet. Sie werden aufgefordert, ihn auszuführen, meist direkt im Antragsablauf oder über einen sicheren Link, den Tradovate Ihnen per E-Mail sendet. Er funktioniert auf einem Smartphone oder Computer, iOS, Android oder im Browser, nutzen Sie also das Gerät mit der besseren Kamera. Fotografieren Sie die Vorderseite (und manchmal die Rückseite) Ihres Ausweises und machen Sie dann ein Selfie, damit Ihr Gesicht mit dem Dokument abgeglichen werden kann, Ihre Daten müssen Sie nicht von Hand eintippen. Gutes Licht, ein neutraler Hintergrund und eine flach gehaltene Karte ohne Spiegelungen helfen, beim ersten Versuch zu bestehen." },
        { title: "Angeforderte Dokumente hochladen", html: "Wenn die automatische Prüfung Unterlagen benötigt oder Tradovate Sie per E-Mail um ein bestimmtes Dokument bittet, laden Sie es direkt in der Plattform hoch. Melden Sie sich in der Tradovate-Web-App an, klicken Sie oben rechts auf <strong class='text-white'>Application Settings</strong> und öffnen Sie den Tab <strong class='text-white'>Your Profile</strong>. Wählen Sie dort <strong class='text-white'>Upload Documents</strong>. Ein Pop-up fragt nach einem Verifizierungscode, den Tradovate Ihnen per E-Mail sendet. Geben Sie ihn ein, und der Upload-Bildschirm wird freigeschaltet. Folgen Sie den Anweisungen, um Ihre Dateien anzuhängen, und klicken Sie dann auf <strong class='text-white'>Done</strong>, um sie einzureichen." },
        { title: "Auf die Prüfung durch das New-Accounts-Team warten", html: "Nach der Einreichung prüft das New-Accounts-Team von Tradovate alles innerhalb von ein bis zwei Werktagen. Kann ein Dokument nicht akzeptiert werden, etwa wegen eines unscharfen Scans, eines abgelaufenen Ausweises oder eines nicht übereinstimmenden Namens, erhalten Sie eine Folge-E-Mail, die genau erklärt, was Sie korrigieren und erneut einreichen müssen. In der Regel haben Sie ab der ursprünglichen Anfrage etwa zwei Wochen Zeit, alles einzureichen, lassen Sie es also nicht liegen. Sobald Sie freigegeben sind, können Sie das Konto finanzieren und mit dem Handel beginnen." },
      ],
    },
    { type: "heading",text: "Was als Adressnachweis zählt" },
    { type: "table", headers: ["Dokumenttyp","Hinweise"], rows: [
      ["Nebenkostenabrechnung","Gas, Wasser, Strom oder Festnetztelefon"],
      ["Kontoauszug","Monatlicher Auszug, alle Seiten, Konto läuft auf Ihren Namen"],
      ["Mietvertrag","Aktueller Mietvertrag mit Ihrer Wohnadresse"],
      ["Versicherungsnachweis","Hausrat- oder Mieterversicherung"],
      ["Hypothekenabrechnung","Aktuelle Abrechnung mit Ihrer Adresse"],
    ] },
    { type: "heading",text: "Häufige Gründe für Verzögerungen bei der Verifizierung" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Unscharfe oder abgeschnittene Bilder</strong>, eine abgeschnittene Ecke oder fehlende Schärfe führt zur Ablehnung eines Dokuments.",
        "<strong class='text-white'>Abgelaufener Ausweis</strong>, ein veralteter Führerschein oder Reisepass wird nicht akzeptiert.",
        "<strong class='text-white'>Namensabweichung</strong>, Ihr Ausweis, Ihr Adressnachweis und Ihr Tradovate-Konto müssen übereinstimmen.",
        "<strong class='text-white'>Veralteter Adressnachweis</strong>, alles, was älter als 90 Tage ist, wird abgelehnt.",
      ],
    },
    { type: "heading",text: "Tradovate automatisieren, sobald Sie freigegeben sind" },
    { type: "paragraph",html: "KYC ist eine einmalige Hürde. Sobald Ihr Live-Konto verifiziert und finanziert ist, <strong class='text-white'>verbindet PickMyTrade Ihre TradingView-Alarme direkt mit Tradovate</strong>, sodass Einstiege, Stopps und Ziele automatisch ausgelöst werden, ohne manuelle Klicks, während Sie nicht am Arbeitsplatz sind." },
  ], es: [
    { type: "paragraph",html: "Antes de que Tradovate le permita operar en una cuenta de futuros real, debe demostrar que realmente es usted. Esa es la verificación KYC, Know Your Customer, el mismo control de identidad que realiza cualquier bróker regulado de EE. UU. La mayor parte es automática: una foto de su documento de identidad, un selfie rápido y, a veces, un documento que confirme dónde vive. Si los archivos son correctos a la primera, se resuelve en uno o dos días. Si envía un escaneo borroso o un nombre que no coincide, tendrá que esperar una segunda ronda." },
    { type: "heading",text: "Qué significa la verificación KYC" },
    { type: "paragraph",html: "El KYC es el control legal que confirma su identidad antes de que pueda fondear y operar una cuenta real. Tradovate lo realiza de dos maneras. Un servicio automatizado de identidad llamado <strong class='text-white'>Veriff</strong> se encarga de la vía rápida: usted fotografía su documento de identidad oficial y se hace un selfie, y el servicio compara ambos. Si algo no puede confirmarse automáticamente, o el equipo de New Accounts necesita más, se le pedirá que suba documentos manualmente a través de la plataforma." },
    { type: "paragraph",html: "Una nota previa: si opera una evaluación de prop firm, su firma suele realizar su propio proceso de incorporación y verificaciones de identidad. Los requisitos allí varían según la firma y el tamaño de la cuenta, así que consulte las reglas vigentes de su firma. Esta guía cubre el proceso estándar de cuenta real de Tradovate." },
    { type: "heading",text: "Complete el KYC de Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Reúna su documento de identidad y los comprobantes de domicilio", html: "Tenga preparado un <strong class='text-white'>documento de identidad con foto emitido por el gobierno</strong>, carnet de conducir, pasaporte o documento de identidad estatal, que muestre claramente su nombre legal completo, su fotografía y su fecha de nacimiento, y que no esté caducado. Tenga también a mano un <strong class='text-white'>comprobante de domicilio</strong> reciente por si se lo solicitan; Tradovate acepta documentos con fecha dentro de los últimos 90 días. Sea lo que sea que envíe, la imagen debe ser nítida y totalmente legible, con las cuatro esquinas del documento visibles, y el nombre en cada documento debe coincidir exactamente con el nombre de su cuenta de Tradovate." },
        { title: "Complete la verificación de identidad de Veriff", html: "Veriff es el verificador automatizado de identidad que utiliza Tradovate. Se le pedirá que lo ejecute, normalmente dentro del propio flujo de solicitud o mediante un enlace seguro que Tradovate le envía por correo. Funciona en un teléfono o en un ordenador, iOS, Android o un navegador, así que use el dispositivo con mejor cámara. Haga una foto del anverso (y a veces del reverso) de su documento y luego un selfie para que pueda comparar su rostro con el documento; no hay que teclear sus datos a mano. Buena iluminación, un fondo liso y sostener la tarjeta plana y sin reflejos ayudan a superarlo a la primera." },
        { title: "Suba los documentos solicitados", html: "Si la verificación automática necesita respaldo, o Tradovate le envía un correo pidiéndole un documento concreto, lo sube directamente en la plataforma. Inicie sesión en la aplicación web de Tradovate, haga clic en <strong class='text-white'>Application Settings</strong> en la esquina superior derecha y abra la pestaña <strong class='text-white'>Your Profile</strong>. Desde allí, elija <strong class='text-white'>Upload Documents</strong>. Una ventana emergente le pide un código de verificación que Tradovate le envía por correo; introdúzcalo y se desbloquea la pantalla de carga. Siga las indicaciones para adjuntar sus archivos y luego haga clic en <strong class='text-white'>Done</strong> para enviarlos." },
        { title: "Espere la revisión del equipo de New Accounts", html: "Una vez que lo envíe, el equipo de New Accounts de Tradovate lo revisa todo en uno o dos días hábiles. Si no se puede aceptar un documento, por un escaneo borroso, un documento caducado o un nombre que no coincide, recibirá un correo de seguimiento que detalla exactamente qué corregir y volver a enviar. Por lo general dispone de unas dos semanas desde la solicitud original para entregar todo, así que no lo deje para después. Una vez aprobado, puede fondear la cuenta y empezar a operar." },
      ],
    },
    { type: "heading",text: "Qué cuenta como comprobante de domicilio" },
    { type: "table", headers: ["Tipo de documento","Notas"], rows: [
      ["Factura de suministros","Gas, agua, electricidad o teléfono fijo"],
      ["Extracto bancario","Extracto mensual, todas las páginas, cuenta a su nombre"],
      ["Contrato de alquiler","Contrato vigente que muestre su domicilio de residencia"],
      ["Comprobante de seguro","Seguro de vivienda o de inquilino"],
      ["Extracto hipotecario","Extracto vigente con su dirección"],
    ] },
    { type: "heading",text: "Motivos habituales por los que se retrasa la verificación" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Imágenes borrosas o recortadas</strong>, una esquina cortada o un enfoque deficiente hacen que se rechace un documento.",
        "<strong class='text-white'>Documento de identidad caducado</strong>, un carnet o pasaporte vencido no será aceptado.",
        "<strong class='text-white'>Nombre que no coincide</strong>, su documento de identidad, su comprobante de domicilio y su cuenta de Tradovate deben concordar.",
        "<strong class='text-white'>Comprobante de domicilio antiguo</strong>, cualquier documento con más de 90 días se rechaza.",
      ],
    },
    { type: "heading",text: "Automatice Tradovate una vez aprobado" },
    { type: "paragraph",html: "El KYC es un obstáculo que se supera una sola vez. Una vez que su cuenta real esté verificada y fondeada, <strong class='text-white'>PickMyTrade conecta sus alertas de TradingView directamente con Tradovate</strong> para que las entradas, los stops y los objetivos se ejecuten automáticamente, sin clics manuales mientras está lejos del escritorio." },
  ], fr: [
    { type: "paragraph",html: "Avant que Tradovate ne vous autorise à négocier sur un compte de contrats à terme réel, vous devez prouver que vous êtes bien vous. C'est le contrôle KYC, Know Your Customer, le même filtrage d'identité que réalise tout courtier américain réglementé. L'essentiel est automatisé : une photo de votre pièce d'identité, un selfie rapide et parfois un document confirmant votre lieu de résidence. Si les fichiers sont corrects du premier coup, la validation intervient en un jour ou deux. Envoyez un scan flou ou un nom qui ne correspond pas, et vous attendrez un second tour." },
    { type: "heading",text: "Ce que signifie la vérification KYC" },
    { type: "paragraph",html: "Le KYC est le contrôle légal qui confirme votre identité avant que vous puissiez approvisionner et négocier sur un compte réel. Tradovate l'effectue de deux manières. Un service d'identité automatisé appelé <strong class='text-white'>Veriff</strong> gère la voie rapide : vous photographiez votre pièce d'identité officielle et prenez un selfie, et il fait correspondre les deux. Si quelque chose ne peut pas être confirmé automatiquement, ou si l'équipe New Accounts a besoin de plus, il vous sera demandé de téléverser des documents manuellement via la plateforme." },
    { type: "paragraph",html: "Une remarque d'emblée : si vous négociez une évaluation de prop firm, votre firme effectue généralement son propre processus d'intégration et ses propres vérifications d'identité. Les exigences y varient selon la firme et la taille du compte ; vérifiez donc les règles en vigueur de votre firme. Ce guide couvre la procédure standard de compte réel Tradovate." },
    { type: "heading",text: "Effectuer le KYC Tradovate : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Rassembler votre pièce d'identité et vos justificatifs de domicile", html: "Ayez à portée de main une <strong class='text-white'>pièce d'identité avec photo délivrée par un gouvernement</strong>, permis de conduire, passeport ou pièce d'identité d'État, qui indique clairement votre nom légal complet, votre photographie et votre date de naissance, et qui n'est pas expirée. Ayez aussi un <strong class='text-white'>justificatif de domicile</strong> récent au cas où il serait demandé ; Tradovate accepte les documents datés des 90 derniers jours. Quel que soit le document soumis, l'image doit être nette et entièrement lisible, avec les quatre coins du document visibles, et le nom figurant sur chaque document doit correspondre exactement au nom de votre compte Tradovate." },
        { title: "Effectuer la vérification d'identité Veriff", html: "Veriff est le vérificateur d'identité automatisé utilisé par Tradovate. Il vous sera demandé de l'exécuter, généralement directement dans le parcours de demande ou via un lien sécurisé que Tradovate vous envoie par e-mail. Il fonctionne sur un téléphone ou un ordinateur, iOS, Android ou un navigateur ; utilisez donc l'appareil dont la caméra est la meilleure. Prenez en photo le recto (et parfois le verso) de votre pièce d'identité, puis faites un selfie afin qu'il puisse faire correspondre votre visage au document ; il n'y a aucune saisie manuelle de vos informations. Un bon éclairage, un arrière-plan uni et une carte tenue à plat sans reflet aident à réussir du premier coup." },
        { title: "Téléverser les documents demandés", html: "Si la vérification automatisée nécessite un complément, ou si Tradovate vous écrit pour demander un document précis, vous le téléversez directement dans la plateforme. Connectez-vous à l'application web Tradovate, cliquez sur <strong class='text-white'>Application Settings</strong> en haut à droite, puis ouvrez l'onglet <strong class='text-white'>Your Profile</strong>. De là, choisissez <strong class='text-white'>Upload Documents</strong>. Une fenêtre contextuelle demande un code de vérification que Tradovate vous envoie par e-mail ; saisissez-le et l'écran de téléversement se débloque. Suivez les instructions pour joindre vos fichiers, puis cliquez sur <strong class='text-white'>Done</strong> pour les soumettre." },
        { title: "Attendre l'examen de l'équipe New Accounts", html: "Une fois votre soumission envoyée, l'équipe New Accounts de Tradovate examine l'ensemble sous un à deux jours ouvrables. Si un document ne peut pas être accepté, scan flou, pièce d'identité expirée, nom ne correspondant pas, vous recevrez un e-mail de suivi précisant exactement ce qu'il faut corriger et soumettre à nouveau. Vous disposez généralement d'environ deux semaines à compter de la demande initiale pour tout fournir ; ne tardez donc pas. Une fois validé, vous pouvez approvisionner le compte et commencer à négocier." },
      ],
    },
    { type: "heading",text: "Ce qui compte comme justificatif de domicile" },
    { type: "table", headers: ["Type de document","Remarques"], rows: [
      ["Facture de services publics","Gaz, eau, électricité ou téléphone fixe"],
      ["Relevé bancaire","Relevé mensuel, toutes les pages, compte à votre nom"],
      ["Contrat de location","Bail en cours indiquant votre adresse de résidence"],
