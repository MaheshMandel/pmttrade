---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-mobile-internal-notifications";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Clear Internal Notifications in Tradovate Mobile";
const META_DESCRIPTION =
  "Clear and pause in-app internal notifications in the Tradovate mobile app with a quick swipe, and see how push alerts are managed separately.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Interne Benachrichtigungen in Tradovate Mobile löschen", es: "Borrar las notificaciones internas en Tradovate móvil", fr: "Effacer les notifications internes dans Tradovate mobile", it: "Cancellare le notifiche interne in Tradovate mobile" },
  dek: { en: "Those little update messages that stack up inside the Tradovate mobile app can crowd your screen fast. Here's exactly how to clear internal notifications, plus why there's no single \"off\" switch for them.", de: "Die kleinen Update-Meldungen, die sich in der Tradovate-Mobile-App stapeln, können Ihren Bildschirm schnell überladen. So löschen Sie interne Benachrichtigungen, und warum es dafür keinen einzelnen „Aus“-Schalter gibt.", es: "Esos pequeños mensajes de actualización que se acumulan dentro de la app móvil de Tradovate pueden saturar su pantalla enseguida. Aquí se explica exactamente cómo borrar las notificaciones internas y por qué no hay un único interruptor de «apagado».", fr: "Les petits messages de mise à jour qui s’accumulent dans l’application mobile Tradovate peuvent vite encombrer votre écran. Voici comment effacer les notifications internes, et pourquoi il n’existe pas d’interrupteur « désactivé » unique.", it: "I piccoli messaggi di aggiornamento che si accumulano nell’app mobile di Tradovate possono affollare rapidamente lo schermo. Ecco come cancellare le notifiche interne e perché non esiste un unico interruttore di «disattivazione»." },
  readTime: { en: "4 min read", de: "4 Min. Lesezeit", es: "Lectura de 4 min", fr: "Lecture : 4 min", it: "Lettura di 4 min" },
  lastUpdated: "2026-07-10",
  blocks: { en: [
    { type: "paragraph", html: "Those little update messages that stack up inside the Tradovate mobile app can crowd your screen fast, especially on a busy session. If they're in the way and you just want them gone, here's exactly how to clear internal notifications on mobile, plus why there's no single \"off\" switch for them and what to do instead." },
    { type: "heading", text: "What Are Internal Notifications in Tradovate Mobile?" },
    { type: "paragraph", html: "Internal notifications are the update messages that appear <em>inside</em> the Tradovate mobile app, banner-style cards for things like order and account updates or platform messages. They're separate from push notifications, which land on your phone <em>outside</em> the app, on your lock screen or in the notification tray, even when Tradovate is closed." },
    { type: "paragraph", html: "Here's the catch: Tradovate doesn't give you a master toggle to switch internal notifications off completely. What you can do is clear and suspend them one at a time with a quick swipe. Handling the two types is a little different, so it helps to keep them straight:" },
    { type: "table", headers: ["", "Internal notifications", "Push notifications"], rows: [
      ["<strong class='text-white'>Where they show</strong>", "Inside the Tradovate mobile app", "On your phone outside the app (lock screen / tray)"],
      ["<strong class='text-white'>How you control them</strong>", "Swipe each one away; no global off switch", "Toggle in your device settings and the trader's notification preferences"],
    ] },
    { type: "heading", text: "How to Clear Internal Notifications in Tradovate Mobile: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open the App and Find the Notification", html: "Log in to the Tradovate mobile app. When an internal notification fires, it shows up as a banner or message card right inside the app. Find the one you want gone." },
        { title: "Swipe Left to Remove It", html: "Rest your finger on the notification and <strong class='text-white'>swipe left</strong> across it. Keep going until the card slides off the edge and disappears. That one gesture suspends the notification and takes it off your screen, no menu digging required." },
        { title: "Clear the Rest One at a Time", html: "There's no \"clear all\" button, and no setting that turns internal notifications off for good. So if a few have stacked up, just repeat the same left swipe on each card until the screen is clean. It only takes a second per notification once you've got the motion down.", image: { src: `${IMG}/tradovate-mobile-internal-notifications-3.jpg`, alt: "Several stacked Tradovate mobile internal notifications being cleared one by one" } },
        { title: "Want Fewer Pings on Your Phone? Handle Push Separately", html: "If what's actually bugging you is your phone lighting up while the app is closed, that's push notifications, and they're managed on their own track. Two places to look: your phone's <strong class='text-white'>notification settings</strong> for the Tradovate app, and the <strong class='text-white'>notification preferences</strong> inside the trader (on web or desktop, these sit under Application Settings). That's where you decide which events, order fills, alerts, and the like, are allowed to reach your phone in the first place.", image: { src: `${IMG}/tradovate-mobile-internal-notifications-4.png`, alt: "Phone notification settings for the Tradovate app controlling push alerts" } },
      ],
    },
    { type: "heading", text: "Why You'd Want to Clear Them" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Decluttering mid-session</strong>, get message cards off the screen so you can read the DOM and chart cleanly.",
        "<strong class='text-white'>Clearing stale alerts</strong>, dismiss a notice you've already acted on so it stops staring back at you.",
        "<strong class='text-white'>Staying focused</strong>, cut the visual noise while you're managing an open position.",
        "<strong class='text-white'>Knowing your options</strong>, understand that swiping is the fix today, since there's no on/off toggle for internal notifications.",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "If you're glued to the app clearing pings because you're waiting to react to every signal, automation takes that off your plate. <strong class='text-white'>PickMyTrade routes your TradingView alerts straight to your Tradovate account</strong>, so entries, exits, and brackets fire on their own. You still get to check in whenever you want, you're just not babysitting the screen for the next notification." },
  ], de: [
    { type: "paragraph",html: "Die kleinen Update-Meldungen, die sich in der Tradovate-Mobile-App stapeln, können Ihren Bildschirm schnell überladen, besonders in einer hektischen Session. Wenn sie im Weg sind und Sie sie einfach loswerden möchten, erfahren Sie hier, wie Sie interne Benachrichtigungen auf dem Smartphone löschen, warum es keinen einzelnen „Aus“-Schalter dafür gibt und was Sie stattdessen tun können." },
    { type: "heading",text: "Was sind interne Benachrichtigungen in Tradovate Mobile?" },
    { type: "paragraph",html: "Interne Benachrichtigungen sind die Update-Meldungen, die <em>innerhalb</em> der Tradovate-Mobile-App erscheinen, bannerartige Karten für Dinge wie Order- und Kontoaktualisierungen oder Plattformmitteilungen. Sie sind getrennt von Push-Benachrichtigungen, die <em>außerhalb</em> der App auf Ihrem Smartphone eintreffen, auf dem Sperrbildschirm oder im Benachrichtigungsbereich, auch wenn Tradovate geschlossen ist." },
    { type: "paragraph",html: "Der Haken dabei: Tradovate bietet keinen Hauptschalter, um interne Benachrichtigungen vollständig auszuschalten. Sie können sie aber einzeln mit einer kurzen Wischgeste löschen und aussetzen. Die beiden Arten werden etwas unterschiedlich behandelt, daher lohnt es sich, sie auseinanderzuhalten:" },
    { type: "table", headers: ["","Interne Benachrichtigungen","Push-Benachrichtigungen"], rows: [
      ["<strong class='text-white'>Wo sie erscheinen</strong>","In der Tradovate-Mobile-App","Auf Ihrem Smartphone außerhalb der App (Sperrbildschirm / Benachrichtigungsbereich)"],
      ["<strong class='text-white'>Wie Sie sie steuern</strong>","Jede einzeln wegwischen; kein globaler Aus-Schalter","Schalter in den Geräteeinstellungen und in den Benachrichtigungseinstellungen des Traders"],
    ] },
    { type: "heading",text: "Interne Benachrichtigungen in Tradovate Mobile löschen: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "App öffnen und die Benachrichtigung finden", html: "Melden Sie sich in der Tradovate-Mobile-App an. Wenn eine interne Benachrichtigung ausgelöst wird, erscheint sie als Banner oder Meldungskarte direkt in der App. Suchen Sie die, die Sie loswerden möchten." },
        { title: "Zum Entfernen nach links wischen", html: "Legen Sie den Finger auf die Benachrichtigung und <strong class='text-white'>wischen Sie nach links</strong> darüber. Wischen Sie weiter, bis die Karte über den Rand gleitet und verschwindet. Diese eine Geste setzt die Benachrichtigung aus und entfernt sie von Ihrem Bildschirm, ganz ohne Menüsuche." },
        { title: "Den Rest einzeln löschen", html: "Es gibt keine Schaltfläche „Alle löschen“ und keine Einstellung, die interne Benachrichtigungen dauerhaft ausschaltet. Haben sich also mehrere angesammelt, wiederholen Sie einfach dieselbe Linkswischgeste bei jeder Karte, bis der Bildschirm sauber ist. Sobald Sie die Bewegung heraushaben, dauert es pro Benachrichtigung nur eine Sekunde.", image: {"src":`${IMG}/tradovate-mobile-internal-notifications-3.jpg`,"alt":"Mehrere gestapelte interne Tradovate-Mobile-Benachrichtigungen werden einzeln gelöscht"} },
        { title: "Weniger Pings auf dem Smartphone? Push getrennt behandeln", html: "Wenn Sie eigentlich stört, dass Ihr Smartphone aufleuchtet, während die App geschlossen ist, dann sind das Push-Benachrichtigungen, und die werden separat verwaltet. Zwei Stellen sind relevant: die <strong class='text-white'>Benachrichtigungseinstellungen</strong> Ihres Smartphones für die Tradovate-App und die <strong class='text-white'>Benachrichtigungseinstellungen</strong> im Trader (im Web oder auf dem Desktop unter Application Settings). Dort legen Sie fest, welche Ereignisse, etwa Order-Ausführungen und Alerts, Ihr Smartphone überhaupt erreichen dürfen.", image: {"src":`${IMG}/tradovate-mobile-internal-notifications-4.png`,"alt":"Smartphone-Benachrichtigungseinstellungen der Tradovate-App zur Steuerung von Push-Alerts"} },
      ],
    },
    { type: "heading",text: "Warum Sie sie löschen möchten" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Aufräumen mitten in der Session</strong>, Meldungskarten vom Bildschirm entfernen, damit Sie DOM und Chart klar lesen können.",
        "<strong class='text-white'>Veraltete Alerts löschen</strong>, eine Meldung wegwischen, auf die Sie bereits reagiert haben, damit sie Sie nicht weiter anstarrt.",
        "<strong class='text-white'>Konzentriert bleiben</strong>, das visuelle Rauschen reduzieren, während Sie eine offene Position managen.",
        "<strong class='text-white'>Ihre Optionen kennen</strong>, verstehen, dass Wischen heute die Lösung ist, da es keinen Ein/Aus-Schalter für interne Benachrichtigungen gibt.",
      ],
    },
    { type: "heading",text: "Automatisieren Sie das mit PickMyTrade" },
    { type: "paragraph",html: "Wenn Sie ständig an der App hängen und Pings löschen, weil Sie auf jedes Signal reagieren wollen, nimmt Ihnen Automatisierung das ab. <strong class='text-white'>PickMyTrade leitet Ihre TradingView-Alerts direkt an Ihr Tradovate-Konto weiter</strong>, sodass Einstiege, Ausstiege und Brackets von selbst ausgelöst werden. Sie können weiterhin jederzeit nachsehen, Sie hüten nur nicht mehr den Bildschirm auf die nächste Benachrichtigung." },
  ], es: [
    { type: "paragraph",html: "Esos pequeños mensajes de actualización que se acumulan dentro de la app móvil de Tradovate pueden saturar su pantalla enseguida, sobre todo en una sesión movida. Si le estorban y simplemente quiere quitarlos, aquí tiene exactamente cómo borrar las notificaciones internas en el móvil, además de por qué no hay un único interruptor de «apagado» para ellas y qué hacer en su lugar." },
    { type: "heading",text: "¿Qué son las notificaciones internas en Tradovate móvil?" },
    { type: "paragraph",html: "Las notificaciones internas son los mensajes de actualización que aparecen <em>dentro</em> de la app móvil de Tradovate, tarjetas tipo banner para cosas como actualizaciones de órdenes y de cuenta o mensajes de la plataforma. Son distintas de las notificaciones push, que llegan a su teléfono <em>fuera</em> de la app, en la pantalla de bloqueo o en la bandeja de notificaciones, incluso con Tradovate cerrado." },
    { type: "paragraph",html: "Aquí está el inconveniente: Tradovate no le da un conmutador maestro para desactivar por completo las notificaciones internas. Lo que sí puede hacer es borrarlas y suspenderlas una a una con un rápido deslizamiento. Cada tipo se gestiona de forma algo distinta, así que conviene tenerlos claros:" },
    { type: "table", headers: ["","Notificaciones internas","Notificaciones push"], rows: [
      ["<strong class='text-white'>Dónde se muestran</strong>","Dentro de la app móvil de Tradovate","En su teléfono, fuera de la app (pantalla de bloqueo / bandeja)"],
      ["<strong class='text-white'>Cómo se controlan</strong>","Deslice cada una para descartarla; no hay interruptor global de apagado","Conmutador en los ajustes del dispositivo y en las preferencias de notificación del trader"],
    ] },
    { type: "heading",text: "Cómo borrar las notificaciones internas en Tradovate móvil: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra la app y localice la notificación", html: "Inicie sesión en la app móvil de Tradovate. Cuando se dispara una notificación interna, aparece como un banner o tarjeta de mensaje dentro de la app. Localice la que quiere quitar." },
        { title: "Deslice hacia la izquierda para eliminarla", html: "Apoye el dedo sobre la notificación y <strong class='text-white'>deslícelo hacia la izquierda</strong> sobre ella. Siga hasta que la tarjeta salga por el borde y desaparezca. Ese único gesto suspende la notificación y la quita de su pantalla, sin tener que buscar en ningún menú." },
        { title: "Borre el resto una a una", html: "No hay botón de «borrar todo» ni ningún ajuste que desactive de forma permanente las notificaciones internas. Así que, si se han acumulado varias, repita el mismo deslizamiento a la izquierda en cada tarjeta hasta dejar la pantalla limpia. Solo lleva un segundo por notificación una vez que domina el gesto.", image: {"src":`${IMG}/tradovate-mobile-internal-notifications-3.jpg`,"alt":"Varias notificaciones internas apiladas de Tradovate móvil borrándose una por una"} },
        { title: "¿Quiere menos avisos en el teléfono? Gestione las push por separado", html: "Si lo que realmente le molesta es que el teléfono se ilumine con la app cerrada, eso son notificaciones push, y se gestionan por una vía independiente. Hay dos lugares donde mirar: los <strong class='text-white'>ajustes de notificaciones</strong> de su teléfono para la app de Tradovate y las <strong class='text-white'>preferencias de notificación</strong> dentro del trader (en la web o el escritorio, están en Application Settings). Ahí decide qué eventos, como ejecuciones de órdenes y alertas, pueden llegar a su teléfono.", image: {"src":`${IMG}/tradovate-mobile-internal-notifications-4.png`,"alt":"Ajustes de notificaciones del teléfono para la app de Tradovate que controlan las alertas push"} },
      ],
    },
    { type: "heading",text: "Por qué querría borrarlas" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Despejar durante la sesión</strong>, quite las tarjetas de mensaje de la pantalla para leer el DOM y el gráfico con claridad.",
        "<strong class='text-white'>Borrar alertas obsoletas</strong>, descarte un aviso sobre el que ya actuó para que deje de mirarle fijamente.",
        "<strong class='text-white'>Mantener la concentración</strong>, reduzca el ruido visual mientras gestiona una posición abierta.",
        "<strong class='text-white'>Conocer sus opciones</strong>, entienda que deslizar es hoy la solución, ya que no hay conmutador de encendido/apagado para las notificaciones internas.",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Si está pegado a la app borrando avisos porque espera para reaccionar a cada señal, la automatización se lo quita de encima. <strong class='text-white'>PickMyTrade envía sus alertas de TradingView directamente a su cuenta de Tradovate</strong>, de modo que las entradas, las salidas y los brackets se ejecutan solos. Puede seguir revisando cuando quiera; simplemente deja de vigilar la pantalla a la espera de la siguiente notificación." },
  ], fr: [
    { type: "paragraph",html: "Les petits messages de mise à jour qui s’accumulent dans l’application mobile Tradovate peuvent vite encombrer votre écran, surtout lors d’une séance chargée. S’ils vous gênent et que vous voulez simplement les faire disparaître, voici exactement comment effacer les notifications internes sur mobile, ainsi que la raison pour laquelle il n’existe pas d’interrupteur « désactivé » unique et ce qu’il faut faire à la place." },
    { type: "heading",text: "Que sont les notifications internes dans Tradovate mobile ?" },
    { type: "paragraph",html: "Les notifications internes sont les messages de mise à jour qui apparaissent <em>à l’intérieur</em> de l’application mobile Tradovate, des cartes de type bannière pour des éléments comme les mises à jour d’ordres et de compte ou les messages de la plateforme. Elles sont distinctes des notifications push, qui arrivent sur votre téléphone <em>en dehors</em> de l’application, sur l’écran de verrouillage ou dans la zone de notifications, même lorsque Tradovate est fermé." },
    { type: "paragraph",html: "Voici le hic : Tradovate ne vous donne pas de bouton principal pour désactiver complètement les notifications internes. Ce que vous pouvez faire, c’est les effacer et les suspendre une par une d’un simple glissement. Les deux types se gèrent un peu différemment, il est donc utile de bien les distinguer :" },
    { type: "table", headers: ["","Notifications internes","Notifications push"], rows: [
      ["<strong class='text-white'>Où elles s’affichent</strong>","Dans l’application mobile Tradovate","Sur votre téléphone, en dehors de l’application (écran de verrouillage / zone de notifications)"],
      ["<strong class='text-white'>Comment les contrôler</strong>","Faire glisser chacune pour l’écarter ; pas d’interrupteur global","Bouton dans les réglages de l’appareil et dans les préférences de notification du trader"],
    ] },
    { type: "heading",text: "Comment effacer les notifications internes dans Tradovate mobile : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez l’application et repérez la notification", html: "Connectez-vous à l’application mobile Tradovate. Lorsqu’une notification interne se déclenche, elle apparaît sous forme de bannière ou de carte de message directement dans l’application. Repérez celle dont vous voulez vous débarrasser." },
        { title: "Faites glisser vers la gauche pour la supprimer", html: "Posez le doigt sur la notification et <strong class='text-white'>faites-la glisser vers la gauche</strong>. Continuez jusqu’à ce que la carte sorte par le bord et disparaisse. Ce simple geste suspend la notification et la retire de votre écran, sans fouiller dans les menus." },
        { title: "Effacez les autres une par une", html: "Il n’y a pas de bouton « tout effacer », ni de réglage qui désactive définitivement les notifications internes. Si plusieurs se sont accumulées, répétez donc le même glissement vers la gauche sur chaque carte jusqu’à ce que l’écran soit propre. Cela ne prend qu’une seconde par notification une fois le geste maîtrisé.", image: {"src":`${IMG}/tradovate-mobile-internal-notifications-3.jpg`,"alt":"Plusieurs notifications internes empilées de Tradovate mobile effacées une par une"} },
        { title: "Moins de notifications sur votre téléphone ? Gérez les push séparément", html: "Si ce qui vous dérange vraiment, c’est que votre téléphone s’allume alors que l’application est fermée, il s’agit de notifications push, qui se gèrent sur une voie distincte. Deux endroits à consulter : les <strong class='text-white'>réglages de notifications</strong> de votre téléphone pour l’application Tradovate, et les <strong class='text-white'>préférences de notification</strong> dans le trader (sur le web ou le bureau, elles se trouvent sous Application Settings). C’est là que vous décidez quels événements, exécutions d’ordres, alertes et autres, ont le droit d’atteindre votre téléphone.", image: {"src":`${IMG}/tradovate-mobile-internal-notifications-4.png`,"alt":"Réglages de notifications du téléphone pour l’application Tradovate contrôlant les alertes push"} },
      ],
    },
    { type: "heading",text: "Pourquoi vous voudriez les effacer" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Désencombrer en pleine séance</strong>, retirez les cartes de message de l’écran pour lire clairement le DOM et le graphique.",
        "<strong class='text-white'>Effacer les alertes périmées</strong>, écartez un avis sur lequel vous avez déjà agi pour qu’il cesse de vous fixer.",
        "<strong class='text-white'>Rester concentré</strong>, réduisez le bruit visuel pendant que vous gérez une position ouverte.",
        "<strong class='text-white'>Connaître vos options</strong>, comprenez que le glissement est la solution aujourd’hui, puisqu’il n’existe aucun interrupteur marche/arrêt pour les notifications internes.",
      ],
    },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Si vous êtes rivé à l’application à effacer des notifications parce que vous attendez de réagir à chaque signal, l’automatisation vous en décharge. <strong class='text-white'>PickMyTrade achemine vos alertes TradingView directement vers votre compte Tradovate</strong>, de sorte que les entrées, les sorties et les brackets se déclenchent d’eux-mêmes. Vous pouvez toujours vérifier quand vous le souhaitez ; vous ne surveillez simplement plus l’écran en attendant la prochaine notification." },
  ], it: [
    { type: "paragraph",html: "I piccoli messaggi di aggiornamento che si accumulano nell’app mobile di Tradovate possono affollare rapidamente lo schermo, soprattutto in una sessione intensa. Se le danno fastidio e vuole semplicemente eliminarli, ecco esattamente come cancellare le notifiche interne su mobile, oltre al motivo per cui non esiste un unico interruttore di «disattivazione» e a cosa fare invece." },
    { type: "heading",text: "Che cosa sono le notifiche interne in Tradovate mobile?" },
    { type: "paragraph",html: "Le notifiche interne sono i messaggi di aggiornamento che compaiono <em>all’interno</em> dell’app mobile di Tradovate, schede in stile banner per cose come aggiornamenti di ordini e conto o messaggi della piattaforma. Sono separate dalle notifiche push, che arrivano sul suo telefono <em>fuori</em> dall’app, nella schermata di blocco o nell’area notifiche, anche quando Tradovate è chiuso." },
    { type: "paragraph",html: "Ecco il problema: Tradovate non offre un interruttore principale per disattivare completamente le notifiche interne. Ciò che può fare è cancellarle e sospenderle una alla volta con un rapido scorrimento. I due tipi si gestiscono in modo leggermente diverso, quindi conviene tenerli distinti:" },
    { type: "table", headers: ["","Notifiche interne","Notifiche push"], rows: [
      ["<strong class='text-white'>Dove compaiono</strong>","All’interno dell’app mobile di Tradovate","Sul suo telefono, fuori dall’app (schermata di blocco / area notifiche)"],
      ["<strong class='text-white'>Come si controllano</strong>","Scorrere via ciascuna; nessun interruttore globale di disattivazione","Comando nelle impostazioni del dispositivo e nelle preferenze di notifica del trader"],
    ] },
    { type: "heading",text: "Come cancellare le notifiche interne in Tradovate mobile: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Apra l’app e individui la notifica", html: "Acceda all’app mobile di Tradovate. Quando scatta una notifica interna, compare come banner o scheda di messaggio direttamente nell’app. Individui quella che vuole eliminare." },
        { title: "Scorra verso sinistra per rimuoverla", html: "Appoggi il dito sulla notifica e <strong class='text-white'>scorra verso sinistra</strong> sopra di essa. Continui finché la scheda esce dal bordo e scompare. Quel solo gesto sospende la notifica e la toglie dallo schermo, senza dover cercare nei menu." },
