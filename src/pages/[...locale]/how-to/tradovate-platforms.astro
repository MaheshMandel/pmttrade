---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-platforms";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Download Tradovate: Web, Desktop & Mobile Apps";
const META_DESCRIPTION =
  "Download Tradovate on web, desktop, and mobile in minutes. Get the Windows, Mac, iOS, and Android apps and trade futures from any device.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate herunterladen: Web-, Desktop- und Mobile-Apps", es: "Descargar Tradovate: aplicaciones web, de escritorio y móviles", fr: "Télécharger Tradovate : applications web, bureau et mobile", it: "Scaricare Tradovate: app web, desktop e mobile" },
  dek: { en: "Need to get Tradovate running and start trading futures? Here's how to get Tradovate installed on web, desktop, and mobile, one step at a time.", de: "Sie möchten Tradovate zum Laufen bringen und Futures handeln? So installieren Sie Tradovate Schritt für Schritt auf Web, Desktop und Mobilgerät.", es: "¿Necesita poner Tradovate en marcha y empezar a operar con futuros? Así se instala Tradovate en web, escritorio y móvil, paso a paso.", fr: "Vous voulez faire fonctionner Tradovate et commencer à trader des contrats à terme ? Voici comment installer Tradovate sur le web, le bureau et le mobile, étape par étape.", it: "Ha bisogno di far funzionare Tradovate e iniziare a fare trading sui futures? Ecco come installare Tradovate su web, desktop e dispositivi mobili, passo dopo passo." },
  readTime: { en: "4 min read", de: "4 Min. Lesezeit", es: "Lectura de 4 min", fr: "Lecture : 4 min", it: "Lettura di 4 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Need to get Tradovate running and start trading futures? Maybe you're spinning up a new evaluation, switching to a snappier native desktop build, or wiring up automation with PickMyTrade. Whatever the reason, here's how to get Tradovate installed on web, desktop, and mobile, one step at a time." },
    { type: "heading", text: "What Are the Tradovate Platforms?" },
    { type: "paragraph", html: "Tradovate is a cloud-based futures platform, and you can run it four ways: a browser-based Web Trader, a standalone desktop app for Windows and Mac, and mobile apps for iOS and Android. Since your account and settings live in the cloud, your layouts, charts, and quote lists sync across every device, with no per-device license fee. Sign in anywhere and you pick up exactly where you left off." },
    { type: "heading", text: "Download Tradovate: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open the Web Trader in your browser", html: "The quickest way in is the browser version, because there's nothing to install. Head to <code>trader.tradovate.com</code> in any modern browser, Chrome, Edge, Safari, or Firefox, and sign in with your Tradovate or prop-firm credentials. On a phone or tablet, you can also add the page to your home screen for an app-like shortcut." },
        { title: "Download the desktop app for Windows or Mac", html: "Want a dedicated native build with the same features as the Web Trader? Open the Tradovate Devices page at <code>tradovate.com/devices</code> and pick the download for your system. The button reads <strong class='text-white'>Download Windows</strong> or <strong class='text-white'>Download Mac</strong>. Run the installer, launch the app, and sign in with your account." },
        { title: "Install the mobile app for iOS or Android", html: "Search <strong class='text-white'>Tradovate</strong> in the Apple App Store (iPhone and iPad) or the Google Play Store (Android). You can also tap the <strong class='text-white'>Download iPhone</strong> or <strong class='text-white'>Download Android</strong> button on the Devices page to jump straight to the listing. Install it like any other app, then open it once it finishes." },
        { title: "Log in and confirm your devices sync", html: "Sign in with the same email and password on each platform. Check that the right account shows up in the account selector at the top of the screen, and your watchlists and chart layouts should carry over on their own from one device to the next." },
      ],
    },
    { type: "heading", text: "Why You'd Need This" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Trade at your desk, watch on the go</strong>, run the desktop app on your monitor and keep the phone app handy to manage positions when you step away.",
        "<strong class='text-white'>Keep a lightweight backup</strong>, leave a browser tab signed in so you can still act during a desktop update or reinstall.",
        "<strong class='text-white'>Set up a new machine fast</strong>, grab the app when you start a fresh prop-firm evaluation or move to a new computer.",
        "<strong class='text-white'>Give automation a stable home</strong>, have the platform ready wherever your alerts and bridges route orders.",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Once Tradovate is set up across your devices, <strong class='text-white'>PickMyTrade links your TradingView alerts straight to your Tradovate account</strong>, so entries, exits, and bracket orders fire automatically. No manual clicks on any screen, whether you're at your desk or halfway across town." },
  ], de: [
    { type: "paragraph",html: "Sie möchten Tradovate zum Laufen bringen und Futures handeln? Vielleicht richten Sie eine neue Evaluierung ein, wechseln zu einer schnelleren nativen Desktop-Version oder binden Automatisierung mit PickMyTrade an. Was auch immer der Grund ist: So installieren Sie Tradovate Schritt für Schritt auf Web, Desktop und Mobilgerät." },
    { type: "heading",text: "Was sind die Tradovate-Plattformen?" },
    { type: "paragraph",html: "Tradovate ist eine cloudbasierte Futures-Plattform, die Sie auf vier Arten nutzen können: als browserbasierten Web Trader, als eigenständige Desktop-App für Windows und Mac sowie als Mobile-Apps für iOS und Android. Da Ihr Konto und Ihre Einstellungen in der Cloud liegen, werden Layouts, Charts und Quote-Listen auf allen Geräten synchronisiert, ohne Lizenzgebühr pro Gerät. Melden Sie sich überall an und machen Sie genau dort weiter, wo Sie aufgehört haben." },
    { type: "heading",text: "Tradovate herunterladen: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Den Web Trader im Browser öffnen", html: "Der schnellste Weg ist die Browser-Version, denn es muss nichts installiert werden. Rufen Sie <code>trader.tradovate.com</code> in einem beliebigen modernen Browser auf, etwa Chrome, Edge, Safari oder Firefox, und melden Sie sich mit Ihren Tradovate- oder Prop-Firm-Zugangsdaten an. Auf einem Smartphone oder Tablet können Sie die Seite außerdem zum Startbildschirm hinzufügen, um eine app-ähnliche Verknüpfung zu erhalten." },
        { title: "Die Desktop-App für Windows oder Mac herunterladen", html: "Sie möchten eine eigenständige native Version mit denselben Funktionen wie der Web Trader? Öffnen Sie die Tradovate-Seite „Devices“ unter <code>tradovate.com/devices</code> und wählen Sie den Download für Ihr System. Die Schaltfläche lautet <strong class='text-white'>Download Windows</strong> oder <strong class='text-white'>Download Mac</strong>. Führen Sie das Installationsprogramm aus, starten Sie die App und melden Sie sich mit Ihrem Konto an." },
        { title: "Die Mobile-App für iOS oder Android installieren", html: "Suchen Sie im Apple App Store (iPhone und iPad) oder im Google Play Store (Android) nach <strong class='text-white'>Tradovate</strong>. Alternativ tippen Sie auf der Devices-Seite auf die Schaltfläche <strong class='text-white'>Download iPhone</strong> oder <strong class='text-white'>Download Android</strong>, um direkt zum Eintrag zu gelangen. Installieren Sie die App wie jede andere und öffnen Sie sie nach Abschluss der Installation." },
        { title: "Anmelden und prüfen, ob Ihre Geräte synchronisiert sind", html: "Melden Sie sich auf jeder Plattform mit derselben E-Mail-Adresse und demselben Passwort an. Prüfen Sie, ob oben auf dem Bildschirm im Kontoauswahlmenü das richtige Konto angezeigt wird. Ihre Watchlists und Chart-Layouts sollten sich dann von selbst von einem Gerät auf das nächste übertragen." },
      ],
    },
    { type: "heading",text: "Warum Sie das brauchen" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Am Schreibtisch handeln, unterwegs beobachten</strong>: Nutzen Sie die Desktop-App auf Ihrem Monitor und halten Sie die Handy-App bereit, um Positionen zu verwalten, wenn Sie den Platz verlassen.",
        "<strong class='text-white'>Eine leichte Reserve vorhalten</strong>: Lassen Sie einen Browser-Tab angemeldet, damit Sie bei einem Desktop-Update oder einer Neuinstallation weiterhin handeln können.",
        "<strong class='text-white'>Einen neuen Rechner schnell einrichten</strong>: Holen Sie sich die App, wenn Sie eine neue Prop-Firm-Evaluierung starten oder auf einen neuen Computer umziehen.",
        "<strong class='text-white'>Der Automatisierung ein stabiles Zuhause geben</strong>: Halten Sie die Plattform überall dort bereit, wohin Ihre Alerts und Bridges Orders leiten.",
      ],
    },
    { type: "heading",text: "Mit PickMyTrade automatisieren" },
    { type: "paragraph",html: "Sobald Tradovate auf Ihren Geräten eingerichtet ist, <strong class='text-white'>verbindet PickMyTrade Ihre TradingView-Alerts direkt mit Ihrem Tradovate-Konto</strong>, sodass Einstiege, Ausstiege und Bracket-Orders automatisch ausgelöst werden. Keine manuellen Klicks auf irgendeinem Bildschirm, egal ob Sie am Schreibtisch sitzen oder unterwegs sind." },
  ], es: [
    { type: "paragraph",html: "¿Necesita poner Tradovate en marcha y empezar a operar con futuros? Quizá esté preparando una nueva evaluación, cambiando a una versión de escritorio nativa más ágil o conectando la automatización con PickMyTrade. Sea cual sea el motivo, así se instala Tradovate en web, escritorio y móvil, paso a paso." },
    { type: "heading",text: "¿Qué son las plataformas de Tradovate?" },
    { type: "paragraph",html: "Tradovate es una plataforma de futuros basada en la nube y puede usarla de cuatro maneras: un Web Trader en el navegador, una aplicación de escritorio independiente para Windows y Mac, y aplicaciones móviles para iOS y Android. Como su cuenta y sus ajustes residen en la nube, sus diseños, gráficos y listas de cotizaciones se sincronizan en todos los dispositivos, sin licencia por dispositivo. Inicie sesión desde cualquier lugar y retome justo donde lo dejó." },
    { type: "heading",text: "Descargar Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra Web Trader en su navegador", html: "La forma más rápida de entrar es la versión de navegador, porque no hay nada que instalar. Vaya a <code>trader.tradovate.com</code> en cualquier navegador moderno, Chrome, Edge, Safari o Firefox, e inicie sesión con sus credenciales de Tradovate o de su empresa de fondeo (prop firm). En un teléfono o una tableta también puede añadir la página a la pantalla de inicio para tener un acceso directo similar a una aplicación." },
        { title: "Descargue la aplicación de escritorio para Windows o Mac", html: "¿Quiere una versión nativa dedicada con las mismas funciones que Web Trader? Abra la página de dispositivos de Tradovate en <code>tradovate.com/devices</code> y elija la descarga para su sistema. El botón dice <strong class='text-white'>Download Windows</strong> o <strong class='text-white'>Download Mac</strong>. Ejecute el instalador, inicie la aplicación e inicie sesión con su cuenta." },
        { title: "Instale la aplicación móvil para iOS o Android", html: "Busque <strong class='text-white'>Tradovate</strong> en la App Store de Apple (iPhone y iPad) o en Google Play Store (Android). También puede pulsar el botón <strong class='text-white'>Download iPhone</strong> o <strong class='text-white'>Download Android</strong> de la página de dispositivos para ir directamente a la ficha. Instálela como cualquier otra aplicación y ábrala cuando termine." },
        { title: "Inicie sesión y confirme que sus dispositivos se sincronizan", html: "Inicie sesión con el mismo correo electrónico y la misma contraseña en cada plataforma. Compruebe que la cuenta correcta aparece en el selector de cuentas de la parte superior de la pantalla; sus listas de seguimiento y diseños de gráficos deberían pasar solos de un dispositivo a otro." },
      ],
    },
    { type: "heading",text: "Por qué lo necesitaría" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Opere en su escritorio y vigile sobre la marcha</strong>: use la aplicación de escritorio en su monitor y tenga a mano la aplicación del teléfono para gestionar posiciones cuando se ausente.",
        "<strong class='text-white'>Mantenga un respaldo ligero</strong>: deje una pestaña del navegador con la sesión iniciada para poder actuar durante una actualización o reinstalación del escritorio.",
        "<strong class='text-white'>Configure un equipo nuevo rápidamente</strong>: descargue la aplicación cuando empiece una nueva evaluación con una empresa de fondeo o cambie de ordenador.",
        "<strong class='text-white'>Dé a la automatización un hogar estable</strong>: tenga la plataforma lista allí donde sus alertas y puentes enruten las órdenes.",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Una vez que Tradovate esté configurado en todos sus dispositivos, <strong class='text-white'>PickMyTrade conecta sus alertas de TradingView directamente con su cuenta de Tradovate</strong>, de modo que las entradas, las salidas y las órdenes bracket se ejecutan automáticamente. Sin clics manuales en ninguna pantalla, esté en su escritorio o a kilómetros de distancia." },
  ], fr: [
    { type: "paragraph",html: "Vous voulez faire fonctionner Tradovate et commencer à trader des contrats à terme ? Peut-être lancez-vous une nouvelle évaluation, passez-vous à une version de bureau native plus réactive ou branchez-vous l'automatisation avec PickMyTrade. Quelle que soit la raison, voici comment installer Tradovate sur le web, le bureau et le mobile, étape par étape." },
    { type: "heading",text: "Que sont les plateformes Tradovate ?" },
    { type: "paragraph",html: "Tradovate est une plateforme de contrats à terme basée sur le cloud, que vous pouvez utiliser de quatre façons : un Web Trader dans le navigateur, une application de bureau autonome pour Windows et Mac, et des applications mobiles pour iOS et Android. Votre compte et vos paramètres étant stockés dans le cloud, vos dispositions, graphiques et listes de cotations se synchronisent sur tous vos appareils, sans licence par appareil. Connectez-vous de n'importe où et reprenez exactement là où vous vous étiez arrêté." },
    { type: "heading",text: "Télécharger Tradovate : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez le Web Trader dans votre navigateur", html: "Le moyen le plus rapide est la version navigateur, car il n'y a rien à installer. Rendez-vous sur <code>trader.tradovate.com</code> dans n'importe quel navigateur moderne, Chrome, Edge, Safari ou Firefox, et connectez-vous avec vos identifiants Tradovate ou ceux de votre prop firm. Sur un téléphone ou une tablette, vous pouvez aussi ajouter la page à votre écran d'accueil pour obtenir un raccourci semblable à une application." },
        { title: "Téléchargez l'application de bureau pour Windows ou Mac", html: "Vous voulez une version native dédiée avec les mêmes fonctionnalités que le Web Trader ? Ouvrez la page Devices de Tradovate à l'adresse <code>tradovate.com/devices</code> et choisissez le téléchargement correspondant à votre système. Le bouton indique <strong class='text-white'>Download Windows</strong> ou <strong class='text-white'>Download Mac</strong>. Lancez le programme d'installation, démarrez l'application et connectez-vous avec votre compte." },
        { title: "Installez l'application mobile pour iOS ou Android", html: "Recherchez <strong class='text-white'>Tradovate</strong> dans l'App Store d'Apple (iPhone et iPad) ou dans le Google Play Store (Android). Vous pouvez aussi appuyer sur le bouton <strong class='text-white'>Download iPhone</strong> ou <strong class='text-white'>Download Android</strong> de la page Devices pour accéder directement à la fiche. Installez-la comme n'importe quelle autre application, puis ouvrez-la une fois l'installation terminée." },
        { title: "Connectez-vous et vérifiez que vos appareils se synchronisent", html: "Connectez-vous avec la même adresse e-mail et le même mot de passe sur chaque plateforme. Vérifiez que le bon compte apparaît dans le sélecteur de compte en haut de l'écran ; vos listes de surveillance et vos dispositions de graphiques devraient passer d'un appareil à l'autre automatiquement." },
      ],
    },
    { type: "heading",text: "Pourquoi en avez-vous besoin" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Tradez à votre bureau, surveillez en déplacement</strong> : utilisez l'application de bureau sur votre écran et gardez l'application mobile sous la main pour gérer vos positions quand vous vous absentez.",
        "<strong class='text-white'>Gardez une solution de secours légère</strong> : laissez un onglet de navigateur connecté pour pouvoir agir pendant une mise à jour ou une réinstallation du bureau.",
        "<strong class='text-white'>Configurez rapidement une nouvelle machine</strong> : récupérez l'application quand vous démarrez une nouvelle évaluation de prop firm ou changez d'ordinateur.",
        "<strong class='text-white'>Offrez à l'automatisation un point d'ancrage stable</strong> : ayez la plateforme prête partout où vos alertes et vos passerelles acheminent les ordres.",
      ],
    },
    { type: "heading",text: "Automatisez avec PickMyTrade" },
    { type: "paragraph",html: "Une fois Tradovate configuré sur vos appareils, <strong class='text-white'>PickMyTrade relie directement vos alertes TradingView à votre compte Tradovate</strong>, de sorte que les entrées, les sorties et les ordres bracket se déclenchent automatiquement. Aucun clic manuel sur aucun écran, que vous soyez à votre bureau ou à l'autre bout de la ville." },
  ], it: [
    { type: "paragraph",html: "Ha bisogno di far funzionare Tradovate e iniziare a fare trading sui futures? Forse sta avviando una nuova valutazione, passando a una versione desktop nativa più reattiva o collegando l'automazione con PickMyTrade. Qualunque sia il motivo, ecco come installare Tradovate su web, desktop e dispositivi mobili, passo dopo passo." },
    { type: "heading",text: "Cosa sono le piattaforme Tradovate?" },
    { type: "paragraph",html: "Tradovate è una piattaforma per futures basata sul cloud e può usarla in quattro modi: un Web Trader nel browser, un'app desktop autonoma per Windows e Mac e app mobili per iOS e Android. Poiché il suo account e le sue impostazioni risiedono nel cloud, layout, grafici ed elenchi di quotazioni si sincronizzano su ogni dispositivo, senza licenza per dispositivo. Acceda da qualsiasi luogo e riprenda esattamente da dove aveva lasciato." },
    { type: "heading",text: "Scaricare Tradovate: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Apra il Web Trader nel browser", html: "Il modo più rapido per iniziare è la versione per browser, perché non c'è nulla da installare. Vada su <code>trader.tradovate.com</code> in qualsiasi browser moderno, Chrome, Edge, Safari o Firefox, e acceda con le sue credenziali Tradovate o della prop firm. Su smartphone o tablet può anche aggiungere la pagina alla schermata Home per avere una scorciatoia simile a un'app." },
        { title: "Scarichi l'app desktop per Windows o Mac", html: "Desidera una versione nativa dedicata con le stesse funzioni del Web Trader? Apra la pagina Devices di Tradovate su <code>tradovate.com/devices</code> e scelga il download per il suo sistema. Il pulsante riporta <strong class='text-white'>Download Windows</strong> oppure <strong class='text-white'>Download Mac</strong>. Esegua il programma di installazione, avvii l'app e acceda con il suo account." },
        { title: "Installi l'app mobile per iOS o Android", html: "Cerchi <strong class='text-white'>Tradovate</strong> nell'Apple App Store (iPhone e iPad) o nel Google Play Store (Android). Può anche toccare il pulsante <strong class='text-white'>Download iPhone</strong> o <strong class='text-white'>Download Android</strong> nella pagina Devices per passare direttamente alla scheda. La installi come qualsiasi altra app e la apra al termine dell'installazione." },
        { title: "Acceda e verifichi che i dispositivi si sincronizzino", html: "Acceda con la stessa e-mail e la stessa password su ogni piattaforma. Verifichi che l'account corretto compaia nel selettore account nella parte superiore della schermata; le sue watchlist e i layout dei grafici dovrebbero passare da soli da un dispositivo all'altro." },
      ],
    },
    { type: "heading",text: "Perché le serve" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Faccia trading alla scrivania, osservi in movimento</strong>: usi l'app desktop sul monitor e tenga a portata di mano l'app sul telefono per gestire le posizioni quando si allontana.",
        "<strong class='text-white'>Mantenga un backup leggero</strong>: lasci una scheda del browser connessa per poter agire durante un aggiornamento o una reinstallazione del desktop.",
        "<strong class='text-white'>Configuri rapidamente un nuovo computer</strong>: scarichi l'app quando avvia una nuova valutazione con una prop firm o passa a un nuovo computer.",
        "<strong class='text-white'>Dia all'automazione una base stabile</strong>: tenga la piattaforma pronta ovunque i suoi alert e i suoi bridge instradino gli ordini.",
      ],
    },
    { type: "heading",text: "Automatizzi tutto con PickMyTrade" },
    { type: "paragraph",html: "Una volta configurato Tradovate su tutti i suoi dispositivi, <strong class='text-white'>PickMyTrade collega i suoi alert di TradingView direttamente al suo account Tradovate</strong>, così ingressi, uscite e ordini bracket scattano automaticamente. Nessun clic manuale su alcuno schermo, sia che si trovi alla scrivania o dall'altra parte della città." },
  ] },
  ctaHeading: { en: "Automate Your Tradovate Trades", de: "Automatisieren Sie Ihre Tradovate-Trades", es: "Automatice sus operaciones en Tradovate", fr: "Automatisez vos trades Tradovate", it: "Automatizzi i suoi trade su Tradovate" },
  ctaText: { en: "Once Tradovate is set up across your devices, let PickMyTrade turn your TradingView alerts into automatic entries, exits, and bracket orders.", de: "Sobald Tradovate auf Ihren Geräten eingerichtet ist, wandelt PickMyTrade Ihre TradingView-Alerts automatisch in Einstiege, Ausstiege und Bracket-Orders um.", es: "Cuando Tradovate esté configurado en todos sus dispositivos, deje que PickMyTrade convierta sus alertas de TradingView en entradas, salidas y órdenes bracket automáticas.", fr: "Une fois Tradovate configuré sur tous vos appareils, laissez PickMyTrade transformer vos alertes TradingView en entrées, sorties et ordres bracket automatiques.", it: "Una volta configurato Tradovate su tutti i suoi dispositivi, lasci che PickMyTrade trasformi i suoi alert di TradingView in ingressi, uscite e ordini bracket automatici." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Do I have to download anything to use Tradovate?", a: "No. The Web Trader runs in any modern browser at trader.tradovate.com. The desktop and mobile apps are optional downloads if you want a dedicated, native experience." },
    { q: "Does the desktop app have fewer features than the browser version?", a: "No. Tradovate's standalone desktop platform packs the same functionality as the Web Trader. It's simply a native build for Windows and Mac." },
    { q: "Will my charts and layouts sync across devices?", a: "Yes. Your settings live in the cloud, so layouts, charts, and quote lists follow you across web, desktop, and mobile with no per-device fee." },
    { q: "Are the mobile apps free to download?", a: "Yes. Get them from the Apple App Store or Google Play at no cost, then sign in with the same account you use on web and desktop." },
  ], de: [
