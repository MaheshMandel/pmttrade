---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-exit-at-market-cancel";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Tradovate Exit at Market & Cancel Button";
const META_DESCRIPTION =
  "Flatten your position at market and cancel every working order for one instrument in a single click. Here's how the Exit at Mkt & Cxl button works.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate: Schaltfläche „Exit at Market & Cancel“", es: "Botón Exit at Market y Cancel de Tradovate", fr: "Bouton Exit at Market et Cancel de Tradovate", it: "Pulsante Exit at Market e Cancel di Tradovate" },
  dek: { en: "Need to flatten a position and kill every working order for one instrument in a single click? Here's exactly what Tradovate's Exit at Mkt & Cxl button does, where to find it, and how to flatten your whole account at once.", de: "Sie möchten eine Position glattstellen und alle aktiven Orders eines Instruments mit einem Klick löschen? Hier erfahren Sie genau, was die Schaltfläche Exit at Mkt & Cxl von Tradovate tut, wo Sie sie finden und wie Sie Ihr gesamtes Konto auf einmal glattstellen.", es: "¿Necesita cerrar una posición y cancelar todas las órdenes activas de un instrumento con un solo clic? Aquí le explicamos exactamente qué hace el botón Exit at Mkt & Cxl de Tradovate, dónde encontrarlo y cómo cerrar toda su cuenta de una vez.", fr: "Vous devez clôturer une position et annuler tous les ordres actifs d'un instrument en un seul clic ? Voici exactement ce que fait le bouton Exit at Mkt & Cxl de Tradovate, où le trouver et comment aplatir tout votre compte d'un coup.", it: "Ha bisogno di chiudere una posizione e annullare tutti gli ordini attivi di uno strumento con un solo clic? Ecco esattamente cosa fa il pulsante Exit at Mkt & Cxl di Tradovate, dove trovarlo e come azzerare l'intero conto in un colpo solo." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-10",
  blocks: { en: [
    { type: "paragraph", html: "When a trade turns against you or a headline hits, you don't want to be hunting through the DOM to close one leg at a time. Tradovate's <strong class='text-white'>Exit at Mkt &amp; Cxl</strong> button does the whole job in one click: it dumps your open position at market and wipes out every working order tied to that instrument in the same motion. Here's exactly what it does, where to find it, and how to flatten a single contract or your entire account when speed is the only thing that matters." },
    { type: "heading", text: "What the Exit at Mkt & Cxl Button Does" },
    { type: "paragraph", html: "<strong class='text-white'>Exit at Mkt &amp; Cxl</strong> is short for \"Exit at Market and Cancel.\" Click it once and Tradovate closes your open position in that instrument with a <strong class='text-white'>market order</strong> and cancels any <strong class='text-white'>working orders</strong> attached to it, your stop, your target, any resting limits, all gone together." },
    { type: "paragraph", html: "The part to burn into your head: this button is <strong class='text-white'>instrument-specific</strong>. It only touches the position and orders for the contract loaded in that module. If you're long CL and short ES and you hit the button on your ES SuperDOM, only the ES side flattens. Your CL position and its orders stay exactly where they were. That's the point of it, you can bail out of one trade without disturbing the rest of your book." },
    { type: "heading", text: "How to Use Exit at Mkt & Cxl: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Find the Button in Your SuperDOM or Chart", html: "Open a <strong class='text-white'>SuperDOM</strong> or a <strong class='text-white'>Chart</strong> module for the instrument you're trading. The <strong class='text-white'>Exit at Mkt &amp; Cxl</strong> button lives in the order-entry controls, sitting alongside your Buy, Sell, and cancel buttons. It shows up in both modules, so use whichever one you're already watching the trade from." },
        { title: "Click to Flatten That Instrument", html: "With an open position on the screen, click <strong class='text-white'>Exit at Mkt &amp; Cxl</strong> once. Tradovate fires a market order in the opposite direction to close the position and, at the same time, cancels the working orders for that contract. It acts right away, so treat it like an eject handle, reach for it only when you actually mean to be out." },
        { title: "Confirm You're Flat", html: "Glance at your <strong class='text-white'>Positions</strong> and <strong class='text-white'>Orders</strong> panels. The position for that instrument should read flat (zero contracts), and the Orders tab should show nothing working for it anymore. Two seconds of confirmation beats assuming and finding a stray order later." },
        { title: "Flatten Every Instrument at Once", html: "Need to clear the whole account, not just one contract? Click your <strong class='text-white'>account balance</strong> at the top of the platform. That control closes every open position at market and cancels all working orders <strong class='text-white'>across all instruments</strong> in one shot, the account-wide version of the same idea. Handy when you're spread across several symbols and want everything flat before the close or a news print." },
      ],
    },
    { type: "heading", text: "When to Reach for It" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Kill a losing trade instantly</strong> when price blows through your plan and you want out now.",
        "<strong class='text-white'>Flatten before a news release or the cash close</strong> without clicking through each order by hand.",
        "<strong class='text-white'>Clear a single instrument</strong> while leaving your other positions and orders untouched.",
        "<strong class='text-white'>Stay inside prop-firm rules</strong> by exiting fast when you're creeping toward a loss limit (limits vary by firm and account size, check your firm's current rules).",
        "<strong class='text-white'>Reset a messy order book</strong>, one click removes the position and every stray working order for that contract.",
      ],
    },
    { type: "heading", text: "Let PickMyTrade Handle the Exits for You" },
    { type: "paragraph", html: "A panic button is great when you're at the desk, but if an alert fires while you're away, you want the exit to happen on its own. <strong class='text-white'>PickMyTrade routes your TradingView signals straight into Tradovate and manages your stops and targets automatically</strong>, so a losing trade closes without you scrambling for the button." },
  ], de: [
    { type: "paragraph",html: "Wenn ein Trade gegen Sie läuft oder eine Schlagzeile einschlägt, möchten Sie nicht im DOM suchen, um einen Teil nach dem anderen zu schließen. Die Schaltfläche <strong class='text-white'>Exit at Mkt &amp; Cxl</strong> von Tradovate erledigt alles mit einem Klick: Sie wirft Ihre offene Position zum Marktpreis ab und löscht in derselben Bewegung jede aktive Order dieses Instruments. Hier erfahren Sie genau, was sie tut, wo Sie sie finden und wie Sie einen einzelnen Kontrakt oder Ihr gesamtes Konto glattstellen, wenn nur Geschwindigkeit zählt." },
    { type: "heading",text: "Was die Schaltfläche Exit at Mkt & Cxl bewirkt" },
    { type: "paragraph",html: "<strong class='text-white'>Exit at Mkt &amp; Cxl</strong> steht für „Exit at Market and Cancel“, also zum Marktpreis aussteigen und stornieren. Ein Klick genügt, und Tradovate schließt Ihre offene Position in diesem Instrument mit einer <strong class='text-white'>Market-Order</strong> und storniert alle damit verbundenen <strong class='text-white'>aktiven Orders</strong>, Ihren Stopp, Ihr Ziel und alle wartenden Limit-Orders, alles zusammen." },
    { type: "paragraph",html: "Das sollten Sie sich unbedingt merken: Diese Schaltfläche ist <strong class='text-white'>instrumentspezifisch</strong>. Sie betrifft nur die Position und die Orders des Kontrakts, der in diesem Modul geladen ist. Wenn Sie in CL long und in ES short sind und die Schaltfläche in Ihrem ES-SuperDOM drücken, wird nur die ES-Seite glattgestellt. Ihre CL-Position und deren Orders bleiben genau dort, wo sie waren. Genau das ist der Sinn: Sie können aus einem Trade aussteigen, ohne den Rest Ihres Buchs zu stören." },
    { type: "heading",text: "So verwenden Sie Exit at Mkt & Cxl: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Finden Sie die Schaltfläche in Ihrem SuperDOM oder Chart", html: "Öffnen Sie ein <strong class='text-white'>SuperDOM</strong>- oder ein <strong class='text-white'>Chart</strong>-Modul für das Instrument, das Sie handeln. Die Schaltfläche <strong class='text-white'>Exit at Mkt &amp; Cxl</strong> befindet sich in den Order-Eingabesteuerelementen, neben Ihren Schaltflächen Buy, Sell und Abbrechen. Sie erscheint in beiden Modulen; verwenden Sie also das, in dem Sie den Trade ohnehin beobachten." },
        { title: "Klicken Sie, um dieses Instrument glattzustellen", html: "Klicken Sie bei einer offenen Position auf dem Bildschirm einmal auf <strong class='text-white'>Exit at Mkt &amp; Cxl</strong>. Tradovate sendet eine Market-Order in Gegenrichtung, um die Position zu schließen, und storniert gleichzeitig die aktiven Orders für diesen Kontrakt. Die Aktion erfolgt sofort; behandeln Sie sie also wie einen Schleudersitz und greifen Sie nur dann danach, wenn Sie wirklich raus wollen." },
        { title: "Bestätigen Sie, dass Sie glattgestellt sind", html: "Werfen Sie einen Blick auf Ihre Bereiche <strong class='text-white'>Positions</strong> und <strong class='text-white'>Orders</strong>. Die Position für dieses Instrument sollte flat anzeigen (null Kontrakte), und der Tab Orders sollte nichts Aktives mehr dafür zeigen. Zwei Sekunden Kontrolle sind besser, als etwas anzunehmen und später eine vergessene Order zu finden." },
        { title: "Alle Instrumente auf einmal glattstellen", html: "Müssen Sie das gesamte Konto leeren, nicht nur einen Kontrakt? Klicken Sie oben in der Plattform auf Ihren <strong class='text-white'>Kontostand</strong>. Dieses Steuerelement schließt jede offene Position zum Marktpreis und storniert alle aktiven Orders <strong class='text-white'>über alle Instrumente hinweg</strong> in einem Schritt, die kontoweite Version derselben Idee. Praktisch, wenn Sie auf mehrere Symbole verteilt sind und vor Handelsschluss oder einer Nachrichtenveröffentlichung alles flat haben möchten." },
      ],
    },
    { type: "heading",text: "Wann Sie danach greifen sollten" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Einen Verlusttrade sofort beenden</strong>, wenn der Kurs Ihren Plan durchbricht und Sie sofort raus wollen.",
        "<strong class='text-white'>Vor einer Nachrichtenveröffentlichung oder dem Kassaschluss glattstellen</strong>, ohne jede Order einzeln anzuklicken.",
        "<strong class='text-white'>Ein einzelnes Instrument bereinigen</strong> und Ihre übrigen Positionen und Orders unberührt lassen.",
        "<strong class='text-white'>Innerhalb der Prop-Firm-Regeln bleiben</strong>, indem Sie schnell aussteigen, wenn Sie sich einem Verlustlimit nähern (die Limits variieren je nach Firma und Kontogröße; prüfen Sie die aktuellen Regeln Ihrer Firma).",
        "<strong class='text-white'>Ein unübersichtliches Orderbuch zurücksetzen</strong>, ein Klick entfernt die Position und jede übrig gebliebene aktive Order für diesen Kontrakt.",
      ],
    },
    { type: "heading",text: "Lassen Sie PickMyTrade die Ausstiege für Sie übernehmen" },
    { type: "paragraph",html: "Ein Notfallknopf ist großartig, wenn Sie am Schreibtisch sitzen, aber wenn ein Alert auslöst, während Sie weg sind, soll der Ausstieg von selbst geschehen. <strong class='text-white'>PickMyTrade leitet Ihre TradingView-Signale direkt an Tradovate weiter und verwaltet Ihre Stopps und Ziele automatisch</strong>, sodass ein Verlusttrade schließt, ohne dass Sie nach der Schaltfläche suchen müssen." },
  ], es: [
    { type: "paragraph",html: "Cuando una operación se vuelve en su contra o llega una noticia, no quiere estar buscando en el DOM para cerrar una pata a la vez. El botón <strong class='text-white'>Exit at Mkt &amp; Cxl</strong> de Tradovate hace todo el trabajo con un solo clic: liquida su posición abierta a mercado y elimina todas las órdenes activas de ese instrumento en el mismo movimiento. Aquí le explicamos exactamente qué hace, dónde encontrarlo y cómo cerrar un solo contrato o toda su cuenta cuando lo único que importa es la velocidad." },
    { type: "heading",text: "Qué hace el botón Exit at Mkt & Cxl" },
    { type: "paragraph",html: "<strong class='text-white'>Exit at Mkt &amp; Cxl</strong> es la abreviatura de «Exit at Market and Cancel» (salir a mercado y cancelar). Con un solo clic, Tradovate cierra su posición abierta en ese instrumento con una <strong class='text-white'>orden de mercado</strong> y cancela las <strong class='text-white'>órdenes activas</strong> asociadas, su stop, su objetivo y cualquier límite pendiente, todo junto." },
    { type: "paragraph",html: "Lo que debe grabarse en la mente: este botón es <strong class='text-white'>específico del instrumento</strong>. Solo afecta a la posición y a las órdenes del contrato cargado en ese módulo. Si está largo en CL y corto en ES y pulsa el botón en su SuperDOM de ES, solo se cierra el lado de ES. Su posición en CL y sus órdenes quedan exactamente donde estaban. Ese es el objetivo: puede salirse de una operación sin alterar el resto de su cartera." },
    { type: "heading",text: "Cómo usar Exit at Mkt & Cxl: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Encuentre el botón en su SuperDOM o gráfico", html: "Abra un módulo <strong class='text-white'>SuperDOM</strong> o <strong class='text-white'>Chart</strong> para el instrumento que está operando. El botón <strong class='text-white'>Exit at Mkt &amp; Cxl</strong> está en los controles de entrada de órdenes, junto a sus botones Buy, Sell y de cancelación. Aparece en ambos módulos, así que use el que ya esté mirando para seguir la operación." },
        { title: "Haga clic para cerrar ese instrumento", html: "Con una posición abierta en pantalla, haga clic una vez en <strong class='text-white'>Exit at Mkt &amp; Cxl</strong>. Tradovate envía una orden de mercado en sentido contrario para cerrar la posición y, al mismo tiempo, cancela las órdenes activas de ese contrato. Actúa de inmediato, así que trátelo como una palanca de expulsión y úselo solo cuando realmente quiera salir." },
        { title: "Confirme que está fuera del mercado", html: "Eche un vistazo a sus paneles <strong class='text-white'>Positions</strong> y <strong class='text-white'>Orders</strong>. La posición de ese instrumento debe aparecer en cero (cero contratos), y la pestaña Orders no debe mostrar nada activo para él. Dos segundos de confirmación valen más que suponerlo y encontrar después una orden olvidada." },
        { title: "Cierre todos los instrumentos a la vez", html: "¿Necesita limpiar toda la cuenta, no solo un contrato? Haga clic en el <strong class='text-white'>saldo de su cuenta</strong> en la parte superior de la plataforma. Ese control cierra todas las posiciones abiertas a mercado y cancela todas las órdenes activas <strong class='text-white'>en todos los instrumentos</strong> de una sola vez, la versión a nivel de cuenta de la misma idea. Es útil cuando tiene posiciones en varios símbolos y quiere todo cerrado antes del cierre o de una noticia." },
      ],
    },
    { type: "heading",text: "Cuándo recurrir a él" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Cortar una operación perdedora al instante</strong> cuando el precio atraviesa su plan y quiere salir ya.",
        "<strong class='text-white'>Cerrar antes de una noticia o del cierre de la sesión</strong> sin hacer clic en cada orden a mano.",
        "<strong class='text-white'>Limpiar un solo instrumento</strong> dejando intactas sus demás posiciones y órdenes.",
        "<strong class='text-white'>Mantenerse dentro de las reglas de la firma prop</strong> saliendo rápido cuando se acerca a un límite de pérdida (los límites varían según la firma y el tamaño de la cuenta; consulte las reglas vigentes de su firma).",
        "<strong class='text-white'>Reiniciar un libro de órdenes desordenado</strong>, un clic elimina la posición y todas las órdenes activas sueltas de ese contrato.",
      ],
    },
    { type: "heading",text: "Deje que PickMyTrade se encargue de las salidas" },
    { type: "paragraph",html: "Un botón de pánico es estupendo cuando está frente al escritorio, pero si salta una alerta mientras está ausente, querrá que la salida ocurra sola. <strong class='text-white'>PickMyTrade enruta sus señales de TradingView directamente a Tradovate y gestiona sus stops y objetivos automáticamente</strong>, de modo que una operación perdedora se cierra sin que tenga que buscar el botón con prisa." },
  ], fr: [
    { type: "paragraph",html: "Quand un trade se retourne contre vous ou qu'une actualité tombe, vous ne voulez pas fouiller dans le DOM pour fermer une jambe à la fois. Le bouton <strong class='text-white'>Exit at Mkt &amp; Cxl</strong> de Tradovate fait tout le travail en un clic : il liquide votre position ouverte au marché et supprime d'un même geste tous les ordres actifs liés à cet instrument. Voici exactement ce qu'il fait, où le trouver et comment aplatir un seul contrat ou tout votre compte quand seule la vitesse compte." },
    { type: "heading",text: "Ce que fait le bouton Exit at Mkt & Cxl" },
    { type: "paragraph",html: "<strong class='text-white'>Exit at Mkt &amp; Cxl</strong> est l'abréviation de « Exit at Market and Cancel » (sortir au marché et annuler). Un seul clic, et Tradovate ferme votre position ouverte sur cet instrument avec un <strong class='text-white'>ordre au marché</strong> et annule tous les <strong class='text-white'>ordres actifs</strong> qui y sont rattachés, votre stop, votre objectif, tout ordre limite en attente, le tout en même temps." },
    { type: "paragraph",html: "Ce qu'il faut absolument retenir : ce bouton est <strong class='text-white'>spécifique à l'instrument</strong>. Il n'affecte que la position et les ordres du contrat chargé dans ce module. Si vous êtes long CL et short ES et que vous cliquez sur le bouton dans votre SuperDOM ES, seul le côté ES est aplati. Votre position CL et ses ordres restent exactement là où ils étaient. C'est précisément le but : vous pouvez sortir d'un trade sans perturber le reste de votre portefeuille." },
    { type: "heading",text: "Comment utiliser Exit at Mkt & Cxl : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Trouvez le bouton dans votre SuperDOM ou graphique", html: "Ouvrez un module <strong class='text-white'>SuperDOM</strong> ou <strong class='text-white'>Chart</strong> pour l'instrument que vous négociez. Le bouton <strong class='text-white'>Exit at Mkt &amp; Cxl</strong> se trouve dans les commandes de saisie d'ordres, à côté de vos boutons Buy, Sell et d'annulation. Il apparaît dans les deux modules ; utilisez donc celui depuis lequel vous suivez déjà le trade." },
        { title: "Cliquez pour aplatir cet instrument", html: "Avec une position ouverte à l'écran, cliquez une fois sur <strong class='text-white'>Exit at Mkt &amp; Cxl</strong>. Tradovate envoie un ordre au marché dans le sens opposé pour fermer la position et, en même temps, annule les ordres actifs de ce contrat. L'action est immédiate ; considérez-la donc comme une poignée d'éjection et n'y recourez que lorsque vous voulez vraiment sortir." },
        { title: "Vérifiez que vous êtes à plat", html: "Jetez un œil à vos panneaux <strong class='text-white'>Positions</strong> et <strong class='text-white'>Orders</strong>. La position de cet instrument doit indiquer à plat (zéro contrat), et l'onglet Orders ne doit plus montrer aucun ordre actif pour celui-ci. Deux secondes de vérification valent mieux que de supposer et de retrouver plus tard un ordre oublié." },
        { title: "Aplatissez tous les instruments à la fois", html: "Besoin de nettoyer tout le compte, pas seulement un contrat ? Cliquez sur le <strong class='text-white'>solde de votre compte</strong> en haut de la plateforme. Ce contrôle ferme toutes les positions ouvertes au marché et annule tous les ordres actifs <strong class='text-white'>sur l'ensemble des instruments</strong> d'un seul coup, la version à l'échelle du compte de la même idée. Pratique quand vous êtes réparti sur plusieurs symboles et que vous voulez tout aplatir avant la clôture ou une publication." },
      ],
    },
    { type: "heading",text: "Quand y recourir" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Couper un trade perdant instantanément</strong> quand le prix défonce votre plan et que vous voulez sortir tout de suite.",
        "<strong class='text-white'>Aplatir avant une publication ou la clôture du marché</strong> sans cliquer sur chaque ordre à la main.",
        "<strong class='text-white'>Nettoyer un seul instrument</strong> en laissant vos autres positions et ordres intacts.",
        "<strong class='text-white'>Rester dans les règles de la société prop</strong> en sortant vite quand vous approchez d'une limite de perte (les limites varient selon la société et la taille du compte, vérifiez les règles en vigueur de votre société).",
        "<strong class='text-white'>Remettre à zéro un carnet d'ordres désordonné</strong>, un clic supprime la position et chaque ordre actif résiduel de ce contrat.",
      ],
    },
    { type: "heading",text: "Laissez PickMyTrade gérer les sorties à votre place" },
    { type: "paragraph",html: "Un bouton d'urgence est formidable quand vous êtes à votre bureau, mais si une alerte se déclenche pendant votre absence, vous voulez que la sortie se fasse toute seule. <strong class='text-white'>PickMyTrade achemine vos signaux TradingView directement vers Tradovate et gère automatiquement vos stops et vos objectifs</strong>, de sorte qu'un trade perdant se clôture sans que vous ayez à chercher le bouton en urgence." },
  ], it: [
    { type: "paragraph",html: "Quando un trade si mette contro di lei o arriva una notizia, non vuole rovistare nel DOM per chiudere una gamba alla volta. Il pulsante <strong class='text-white'>Exit at Mkt &amp; Cxl</strong> di Tradovate fa tutto con un clic: liquida la sua posizione aperta a mercato e cancella nello stesso gesto ogni ordine attivo legato a quello strumento. Ecco esattamente cosa fa, dove trovarlo e come azzerare un singolo contratto o l'intero conto quando conta solo la velocità." },
    { type: "heading",text: "Cosa fa il pulsante Exit at Mkt & Cxl" },
    { type: "paragraph",html: "<strong class='text-white'>Exit at Mkt &amp; Cxl</strong> è l'abbreviazione di «Exit at Market and Cancel» (esci a mercato e annulla). Con un solo clic Tradovate chiude la sua posizione aperta in quello strumento con un <strong class='text-white'>ordine a mercato</strong> e annulla gli <strong class='text-white'>ordini attivi</strong> collegati, il suo stop, il suo target, qualsiasi limite in attesa, tutto insieme." },
    { type: "paragraph",html: "Ciò che deve fissarsi bene in mente: questo pulsante è <strong class='text-white'>specifico per lo strumento</strong>. Agisce soltanto sulla posizione e sugli ordini del contratto caricato in quel modulo. Se è long su CL e short su ES e preme il pulsante nel suo SuperDOM di ES, viene azzerato solo il lato ES. La sua posizione su CL e i relativi ordini restano esattamente dove erano. È proprio questo lo scopo: può uscire da un trade senza disturbare il resto del suo portafoglio." },
    { type: "heading",text: "Come usare Exit at Mkt & Cxl: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Trovi il pulsante nel suo SuperDOM o nel grafico", html: "Apra un modulo <strong class='text-white'>SuperDOM</strong> o <strong class='text-white'>Chart</strong> per lo strumento che sta negoziando. Il pulsante <strong class='text-white'>Exit at Mkt &amp; Cxl</strong> si trova nei controlli di inserimento ordini, accanto ai pulsanti Buy, Sell e di annullamento. Compare in entrambi i moduli, quindi usi quello da cui sta già seguendo il trade." },
        { title: "Clicchi per azzerare quello strumento", html: "Con una posizione aperta sullo schermo, clicchi una volta su <strong class='text-white'>Exit at Mkt &amp; Cxl</strong>. Tradovate invia un ordine a mercato in direzione opposta per chiudere la posizione e, contemporaneamente, annulla gli ordini attivi di quel contratto. Agisce subito, quindi lo consideri una maniglia di espulsione e lo usi solo quando vuole davvero uscire." },
        { title: "Confermi di essere flat", html: "Dia un'occhiata ai pannelli <strong class='text-white'>Positions</strong> e <strong class='text-white'>Orders</strong>. La posizione per quello strumento deve risultare flat (zero contratti) e la scheda Orders non deve più mostrare nulla di attivo per esso. Due secondi di verifica valgono più che dare per scontato e trovare in seguito un ordine dimenticato." },
        { title: "Azzeri tutti gli strumenti in una volta", html: "Deve ripulire l'intero conto, non solo un contratto? Clicchi sul <strong class='text-white'>saldo del conto</strong> in alto nella piattaforma. Quel controllo chiude ogni posizione aperta a mercato e annulla tutti gli ordini attivi <strong class='text-white'>su tutti gli strumenti</strong> in un colpo solo, la versione a livello di conto della stessa idea. Utile quando è distribuito su più simboli e vuole tutto flat prima della chiusura o di una notizia." },
