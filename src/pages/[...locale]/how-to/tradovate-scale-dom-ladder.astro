---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-scale-dom-ladder";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Zoom & Scale the Tradovate DOM Price Ladder";
const META_DESCRIPTION =
  "Scale the Tradovate DOM price ladder with Shift+scroll to show more price levels in fast markets, then re-center on the last traded price.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Die Tradovate-DOM-Preisleiter zoomen und skalieren", es: "Cómo hacer zoom y escalar la escalera de precios del DOM de Tradovate", fr: "Zoomer et mettre à l’échelle l’échelle de prix du DOM Tradovate", it: "Zoom e scala della ladder dei prezzi del DOM di Tradovate" },
  dek: { en: "When price rips through your stop zone, a narrow DOM window stops being useful fast. Here's how to scale the Tradovate price ladder with Shift+scroll in a couple of seconds.", de: "Wenn der Kurs durch Ihre Stop-Zone rauscht, ist ein schmales DOM-Fenster schnell nutzlos. So skalieren Sie die Tradovate-Preisleiter in wenigen Sekunden mit Shift+Scrollen.", es: "Cuando el precio atraviesa su zona de stop, una ventana de DOM estrecha deja de ser útil rápidamente. Así puede escalar la escalera de precios de Tradovate con Shift+scroll en un par de segundos.", fr: "Quand le prix traverse votre zone de stop, une fenêtre DOM étroite devient vite inutile. Voici comment mettre à l’échelle l’échelle de prix Tradovate avec Shift+molette en quelques secondes.", it: "Quando il prezzo attraversa la Sua zona di stop, una finestra DOM stretta diventa presto inutile. Ecco come scalare la ladder dei prezzi di Tradovate con Shift+scroll in un paio di secondi." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-10",
  blocks: { en: [
    { type: "paragraph", html: "The SuperDOM ladder shows a tight band of prices around the market, usually just enough rows to trade the current action. That's fine on a quiet day, but when a number drops and price rips through your stop zone, that narrow window stops being useful fast. Scaling the ladder squeezes more price levels into the same panel so you can see where your orders sit relative to a moving market. Here's how to do it in a couple of seconds." },
    { type: "heading", text: "What Scaling the Ladder Actually Does" },
    { type: "paragraph", html: "Scaling changes only how the ladder is drawn. It doesn't touch your working orders, your risk settings, or the contract you're on. When you scale down, Tradovate compresses the rows so each row covers a wider slice of prices, and you trade a little per-row precision for a much wider view of the book. Scale back up and you're returned to the roomy, one-row-per-tick layout that's easier to click on exactly. Think of it like zooming the price axis on a chart: same data, different spacing." },
    { type: "paragraph", html: "If you haven't set up your ladder for order entry yet, start with placing orders on the SuperDOM ladder first, then come back to fine-tune the view." },
    { type: "heading", text: "Scale the DOM Ladder with Shift + Scroll" },
    { type: "paragraph", html: "The whole thing runs off one shortcut: <strong class='text-white'>Shift</strong> plus your scroll wheel. It works on the web and desktop platforms, and a two-finger trackpad scroll works the same way." },
    {
      type: "steps",
      items: [
        { title: "Open a SuperDOM for Your Contract", html: "Open the <strong class='text-white'>SuperDOM</strong> (DOM) module and load the contract you want to trade. You want the live price ladder on screen, with the working column showing bids, asks, and the last traded price.", image: { src: `${IMG}/tradovate-scale-dom-ladder-1.png`, alt: "Tradovate SuperDOM price ladder loaded with a futures contract" } },
        { title: "Move Your Cursor Over the Price Ladder", html: "Hover your mouse pointer over the price column of the ladder. The DOM only reacts to the scroll shortcut while your cursor is over it, so if nothing happens later, this is usually why.", image: { src: `${IMG}/tradovate-scale-dom-ladder-2.png`, alt: "Mouse cursor hovering over the price column of the Tradovate SuperDOM ladder" } },
        { title: "Hold Shift and Scroll to Compress the Ladder", html: "Hold <strong class='text-white'>Shift</strong> and roll the scroll wheel. The rows scale down and more price levels pack into the same panel. Keep scrolling with Shift held to fit an even wider range on screen, which is exactly what you want when price is running and you need to see your stops and targets at a glance.", image: { src: `${IMG}/tradovate-scale-dom-ladder-3.png`, alt: "Tradovate DOM ladder scaled down with Shift+scroll to show more price levels" } },
        { title: "Shift and Scroll the Other Way to Expand It Back", html: "Keep <strong class='text-white'>Shift</strong> held and scroll in the opposite direction to expand the rows back toward their normal one-row-per-tick spacing. Go back to the wider spacing whenever you want bigger click targets for precise order placement. There's a floor on how far the ladder scales, so on some fast-moving products you'll hit the maximum zoom-out before you see the whole range you had in mind.", image: { src: `${IMG}/tradovate-scale-dom-ladder-4.png`, alt: "Tradovate DOM ladder expanded back to default row spacing for precise clicking" } },
        { title: "Re-center on the Last Traded Price", html: "Scrolling around the ladder eventually leaves the last price off-screen. Click the <strong class='text-white'>GO TO LAST</strong> link below the price column to scroll straight back to the last traded price. If you leave the ladder alone for a moment with your cursor off it, Tradovate also scrolls back to center on its own. Hovering over the ladder pauses that auto-recenter, so it won't yank the view while you're lining up an order.", image: { src: `${IMG}/tradovate-scale-dom-ladder-5.png`, alt: "Tradovate SuperDOM GO TO LAST link to re-center the ladder on the last traded price" } },
      ],
    },
    { type: "heading", text: "Normal Scroll vs Shift + Scroll" },
    { type: "paragraph", html: "Scroll <em>without</em> Shift and the ladder just slides up or down through prices, the same as dragging it. Add <strong class='text-white'>Shift</strong> and that same wheel motion changes the scale instead. If the scale won't budge, check that your cursor is over the ladder and that Shift is down before you start rolling the wheel." },
    { type: "heading", text: "When You'd Reach for This" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>News and volatility</strong>, compress the ladder before a scheduled release so a fast move doesn't run off the top or bottom of the panel.",
        "<strong class='text-white'>Wide brackets</strong>, see your stop and target on the same screen as the entry when they're 30+ ticks apart.",
        "<strong class='text-white'>Scalping</strong>, expand back to tight spacing when you need pixel-accurate clicks on adjacent price levels.",
        "<strong class='text-white'>Prop-firm accounts</strong>, max position and loss rules vary by firm and account size, so keep the levels that matter to your firm's current rules in view.",
      ],
    },
    { type: "heading", text: "Automate the Entries with PickMyTrade" },
    { type: "paragraph", html: "Scaling the ladder is great for watching a trade, but clicking every entry and exit by hand still leaves you glued to the screen. <strong class='text-white'>PickMyTrade routes your TradingView alerts straight into your Tradovate account</strong>, so orders fire on your signal while you use the DOM to manage the position instead of chasing it." },
  ], de: [
    { type: "paragraph",html: "Die SuperDOM-Leiter zeigt ein enges Preisband rund um den Markt, meist gerade genug Zeilen, um das aktuelle Geschehen zu handeln. Das ist an einem ruhigen Tag in Ordnung, aber wenn eine Zahl veröffentlicht wird und der Kurs durch Ihre Stop-Zone rauscht, ist dieses schmale Fenster schnell nutzlos. Durch das Skalieren der Leiter passen mehr Preisniveaus in dasselbe Fenster, sodass Sie sehen, wo Ihre Orders im Verhältnis zu einem bewegten Markt liegen. So geht es in wenigen Sekunden." },
    { type: "heading",text: "Was das Skalieren der Leiter tatsächlich bewirkt" },
    { type: "paragraph",html: "Das Skalieren ändert nur die Darstellung der Leiter. Es berührt weder Ihre aktiven Orders noch Ihre Risikoeinstellungen noch den Kontrakt, auf dem Sie sich befinden. Wenn Sie verkleinern, staucht Tradovate die Zeilen, sodass jede Zeile einen breiteren Preisausschnitt abdeckt. Sie tauschen etwas Präzision pro Zeile gegen einen deutlich breiteren Blick auf das Orderbuch. Skalieren Sie wieder hoch, kehren Sie zum großzügigen Layout mit einer Zeile pro Tick zurück, das sich exakter anklicken lässt. Stellen Sie es sich wie das Zoomen der Preisachse in einem Chart vor: dieselben Daten, anderer Abstand." },
    { type: "paragraph",html: "Wenn Sie Ihre Leiter noch nicht für die Ordereingabe eingerichtet haben, beginnen Sie zuerst mit dem Platzieren von Orders auf der SuperDOM-Leiter und kommen Sie dann zurück, um die Ansicht zu verfeinern." },
    { type: "heading",text: "Die DOM-Leiter mit Shift + Scrollen skalieren" },
    { type: "paragraph",html: "Das Ganze läuft über eine einzige Tastenkombination: <strong class='text-white'>Shift</strong> plus Ihr Mausrad. Es funktioniert auf der Web- und der Desktop-Plattform, und ein Zwei-Finger-Scrollen auf dem Trackpad funktioniert genauso." },
    {
      type: "steps",
      items: [
        { title: "Ein SuperDOM für Ihren Kontrakt öffnen", html: "Öffnen Sie das Modul <strong class='text-white'>SuperDOM</strong> (DOM) und laden Sie den Kontrakt, den Sie handeln möchten. Die Live-Preisleiter soll auf dem Bildschirm sein, mit der Arbeitsspalte, die Bids, Asks und den zuletzt gehandelten Preis zeigt.", image: {"src":`${IMG}/tradovate-scale-dom-ladder-1.png`,"alt":"Tradovate-SuperDOM-Preisleiter mit geladenem Futures-Kontrakt"} },
        { title: "Den Cursor über die Preisleiter bewegen", html: "Fahren Sie mit dem Mauszeiger über die Preisspalte der Leiter. Das DOM reagiert auf die Scroll-Tastenkombination nur, solange sich Ihr Cursor darüber befindet. Wenn später nichts passiert, ist das meist der Grund.", image: {"src":`${IMG}/tradovate-scale-dom-ladder-2.png`,"alt":"Mauszeiger über der Preisspalte der Tradovate-SuperDOM-Leiter"} },
        { title: "Shift halten und scrollen, um die Leiter zu stauchen", html: "Halten Sie <strong class='text-white'>Shift</strong> gedrückt und drehen Sie das Mausrad. Die Zeilen werden verkleinert und mehr Preisniveaus passen in dasselbe Fenster. Scrollen Sie mit gedrückter Shift-Taste weiter, um einen noch größeren Bereich auf den Bildschirm zu bekommen. Genau das brauchen Sie, wenn der Kurs läuft und Sie Ihre Stops und Ziele auf einen Blick sehen müssen.", image: {"src":`${IMG}/tradovate-scale-dom-ladder-3.png`,"alt":"Tradovate-DOM-Leiter mit Shift+Scrollen verkleinert, um mehr Preisniveaus anzuzeigen"} },
        { title: "Shift halten und in die andere Richtung scrollen, um sie wieder zu erweitern", html: "Halten Sie <strong class='text-white'>Shift</strong> weiter gedrückt und scrollen Sie in die entgegengesetzte Richtung, um die Zeilen wieder auf ihren normalen Abstand von einer Zeile pro Tick zu erweitern. Kehren Sie zum größeren Abstand zurück, wenn Sie größere Klickziele für eine präzise Orderplatzierung wünschen. Die Skalierung hat eine Untergrenze, daher erreichen Sie bei manchen schnellen Produkten das maximale Herauszoomen, bevor Sie den gesamten gewünschten Bereich sehen.", image: {"src":`${IMG}/tradovate-scale-dom-ladder-4.png`,"alt":"Tradovate-DOM-Leiter auf den Standard-Zeilenabstand zurückgesetzt für präzises Klicken"} },
        { title: "Auf den letzten gehandelten Preis zentrieren", html: "Beim Scrollen durch die Leiter verschwindet der letzte Preis irgendwann aus dem Bild. Klicken Sie auf den Link <strong class='text-white'>GO TO LAST</strong> unterhalb der Preisspalte, um direkt zum letzten gehandelten Preis zurückzuspringen. Wenn Sie die Leiter einen Moment in Ruhe lassen und der Cursor nicht darüber steht, zentriert Tradovate sie auch von selbst wieder. Solange der Cursor über der Leiter steht, ist dieses automatische Zentrieren pausiert, sodass die Ansicht nicht wegspringt, während Sie eine Order vorbereiten.", image: {"src":`${IMG}/tradovate-scale-dom-ladder-5.png`,"alt":"Tradovate-SuperDOM-Link GO TO LAST zum Zentrieren der Leiter auf den letzten gehandelten Preis"} },
      ],
    },
    { type: "heading",text: "Normales Scrollen vs. Shift + Scrollen" },
    { type: "paragraph",html: "Scrollen Sie <em>ohne</em> Shift, gleitet die Leiter einfach durch die Preise nach oben oder unten, genau wie beim Ziehen. Mit <strong class='text-white'>Shift</strong> ändert dieselbe Raddrehung stattdessen die Skala. Wenn sich die Skala nicht verändert, prüfen Sie, ob sich Ihr Cursor über der Leiter befindet und Shift gedrückt ist, bevor Sie das Rad drehen." },
    { type: "heading",text: "Wann Sie dies einsetzen" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Nachrichten und Volatilität</strong>, stauchen Sie die Leiter vor einer angekündigten Veröffentlichung, damit eine schnelle Bewegung nicht oben oder unten aus dem Fenster läuft.",
        "<strong class='text-white'>Weite Brackets</strong>, sehen Sie Stop und Ziel auf demselben Bildschirm wie den Einstieg, wenn sie 30+ Ticks auseinanderliegen.",
        "<strong class='text-white'>Scalping</strong>, wechseln Sie zurück zu engem Abstand, wenn Sie pixelgenaue Klicks auf benachbarte Preisniveaus brauchen.",
        "<strong class='text-white'>Prop-Firm-Konten</strong>, maximale Positionsgrößen und Verlustregeln variieren je nach Firma und Kontogröße. Behalten Sie daher die für die aktuellen Regeln Ihrer Firma relevanten Niveaus im Blick.",
      ],
    },
    { type: "heading",text: "Die Einstiege mit PickMyTrade automatisieren" },
    { type: "paragraph",html: "Die Leiter zu skalieren ist hervorragend, um einen Trade zu beobachten, aber jeden Ein- und Ausstieg von Hand zu klicken fesselt Sie weiterhin an den Bildschirm. <strong class='text-white'>PickMyTrade leitet Ihre TradingView-Alerts direkt in Ihr Tradovate-Konto weiter</strong>, sodass Orders auf Ihr Signal hin ausgelöst werden, während Sie das DOM nutzen, um die Position zu verwalten, statt ihr hinterherzulaufen." },
  ], es: [
    { type: "paragraph",html: "La escalera del SuperDOM muestra una banda de precios estrecha alrededor del mercado, normalmente las filas justas para operar la acción actual. Eso está bien en un día tranquilo, pero cuando sale un dato y el precio atraviesa su zona de stop, esa ventana estrecha deja de ser útil rápidamente. Escalar la escalera comprime más niveles de precio en el mismo panel para que vea dónde están sus órdenes respecto a un mercado en movimiento. Así se hace en un par de segundos." },
    { type: "heading",text: "Qué hace realmente escalar la escalera" },
    { type: "paragraph",html: "Escalar solo cambia cómo se dibuja la escalera. No afecta a sus órdenes activas, a sus ajustes de riesgo ni al contrato en el que está. Cuando reduce la escala, Tradovate comprime las filas de modo que cada fila cubre un tramo de precios más amplio, y usted cambia algo de precisión por fila por una vista mucho más amplia del libro. Si vuelve a ampliar, regresa al diseño amplio de una fila por tick, más fácil de pulsar con exactitud. Piense en ello como hacer zoom en el eje de precios de un gráfico: los mismos datos, con otro espaciado." },
    { type: "paragraph",html: "Si aún no ha configurado su escalera para introducir órdenes, empiece por colocar órdenes en la escalera del SuperDOM y luego vuelva para afinar la vista." },
    { type: "heading",text: "Escale la escalera del DOM con Shift + scroll" },
    { type: "paragraph",html: "Todo funciona con un único atajo: <strong class='text-white'>Shift</strong> más la rueda del ratón. Funciona en las plataformas web y de escritorio, y un scroll con dos dedos en el trackpad funciona igual." },
    {
      type: "steps",
      items: [
        { title: "Abra un SuperDOM para su contrato", html: "Abra el módulo <strong class='text-white'>SuperDOM</strong> (DOM) y cargue el contrato que desea operar. Debe tener a la vista la escalera de precios en vivo, con la columna de trabajo mostrando bids, asks y el último precio negociado.", image: {"src":`${IMG}/tradovate-scale-dom-ladder-1.png`,"alt":"Escalera de precios SuperDOM de Tradovate con un contrato de futuros cargado"} },
        { title: "Mueva el cursor sobre la escalera de precios", html: "Sitúe el puntero del ratón sobre la columna de precios de la escalera. El DOM solo reacciona al atajo de scroll mientras el cursor está encima, así que si más adelante no ocurre nada, normalmente es por esto.", image: {"src":`${IMG}/tradovate-scale-dom-ladder-2.png`,"alt":"Cursor del ratón sobre la columna de precios de la escalera SuperDOM de Tradovate"} },
        { title: "Mantenga Shift y haga scroll para comprimir la escalera", html: "Mantenga pulsada <strong class='text-white'>Shift</strong> y gire la rueda del ratón. Las filas se reducen y caben más niveles de precio en el mismo panel. Siga haciendo scroll con Shift pulsada para encajar un rango aún más amplio en pantalla, que es justo lo que necesita cuando el precio corre y quiere ver sus stops y objetivos de un vistazo.", image: {"src":`${IMG}/tradovate-scale-dom-ladder-3.png`,"alt":"Escalera del DOM de Tradovate reducida con Shift+scroll para mostrar más niveles de precio"} },
        { title: "Haga Shift y scroll en el otro sentido para expandirla de nuevo", html: "Mantenga pulsada <strong class='text-white'>Shift</strong> y haga scroll en sentido contrario para expandir las filas hasta su espaciado normal de una fila por tick. Vuelva al espaciado más amplio siempre que quiera objetivos de clic más grandes para colocar órdenes con precisión. La escala tiene un límite, así que en algunos productos rápidos alcanzará el alejamiento máximo antes de ver todo el rango que tenía en mente.", image: {"src":`${IMG}/tradovate-scale-dom-ladder-4.png`,"alt":"Escalera del DOM de Tradovate expandida de nuevo al espaciado de filas predeterminado para hacer clic con precisión"} },
        { title: "Vuelva a centrar en el último precio negociado", html: "Al desplazarse por la escalera, el último precio acaba quedando fuera de la pantalla. Haga clic en el enlace <strong class='text-white'>GO TO LAST</strong> situado bajo la columna de precios para volver directamente al último precio negociado. Si deja la escalera quieta un momento con el cursor fuera, Tradovate también se vuelve a centrar por sí solo. Al pasar el cursor sobre la escalera se pausa ese recentrado automático, de modo que la vista no salta mientras prepara una orden.", image: {"src":`${IMG}/tradovate-scale-dom-ladder-5.png`,"alt":"Enlace GO TO LAST del SuperDOM de Tradovate para recentrar la escalera en el último precio negociado"} },
      ],
    },
    { type: "heading",text: "Scroll normal frente a Shift + scroll" },
    { type: "paragraph",html: "Si hace scroll <em>sin</em> Shift, la escalera simplemente se desliza hacia arriba o abajo por los precios, igual que al arrastrarla. Con <strong class='text-white'>Shift</strong>, ese mismo movimiento de la rueda cambia la escala. Si la escala no cambia, compruebe que el cursor esté sobre la escalera y que Shift esté pulsada antes de girar la rueda." },
    { type: "heading",text: "Cuándo recurrir a esto" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Noticias y volatilidad</strong>, comprima la escalera antes de una publicación programada para que un movimiento rápido no se salga por arriba o por abajo del panel.",
        "<strong class='text-white'>Brackets amplios</strong>, vea su stop y su objetivo en la misma pantalla que la entrada cuando están separados por 30+ ticks.",
        "<strong class='text-white'>Scalping</strong>, vuelva al espaciado estrecho cuando necesite clics precisos al píxel en niveles de precio adyacentes.",
        "<strong class='text-white'>Cuentas de firmas prop</strong>, las reglas de posición máxima y de pérdida varían según la firma y el tamaño de la cuenta, así que mantenga a la vista los niveles que importan según las reglas vigentes de su firma.",
      ],
    },
    { type: "heading",text: "Automatice las entradas con PickMyTrade" },
    { type: "paragraph",html: "Escalar la escalera es excelente para vigilar una operación, pero hacer clic en cada entrada y salida a mano le sigue dejando pegado a la pantalla. <strong class='text-white'>PickMyTrade enruta sus alertas de TradingView directamente a su cuenta de Tradovate</strong>, de modo que las órdenes se disparan con su señal mientras usted usa el DOM para gestionar la posición en lugar de perseguirla." },
  ], fr: [
    { type: "paragraph",html: "L’échelle SuperDOM affiche une bande de prix étroite autour du marché, généralement juste assez de lignes pour trader l’action en cours. C’est suffisant par jour calme, mais quand un chiffre tombe et que le prix traverse votre zone de stop, cette fenêtre étroite devient vite inutile. Mettre l’échelle à l’échelle fait tenir davantage de niveaux de prix dans le même panneau pour voir où se trouvent vos ordres par rapport à un marché en mouvement. Voici comment faire en quelques secondes." },
    { type: "heading",text: "Ce que fait réellement la mise à l’échelle" },
    { type: "paragraph",html: "La mise à l’échelle ne change que l’affichage de l’échelle. Elle ne touche ni vos ordres actifs, ni vos paramètres de risque, ni le contrat sur lequel vous êtes. Quand vous réduisez, Tradovate compresse les lignes de sorte que chacune couvre une tranche de prix plus large : vous échangez un peu de précision par ligne contre une vue bien plus large du carnet. En ré-agrandissant, vous retrouvez la disposition aérée à une ligne par tick, plus facile à cliquer précisément. Pensez-y comme au zoom sur l’axe des prix d’un graphique : mêmes données, espacement différent." },
    { type: "paragraph",html: "Si vous n’avez pas encore configuré votre échelle pour la saisie d’ordres, commencez par placer des ordres sur l’échelle SuperDOM, puis revenez affiner l’affichage." },
    { type: "heading",text: "Mettre à l’échelle le DOM avec Shift + molette" },
    { type: "paragraph",html: "Tout repose sur un seul raccourci : <strong class='text-white'>Shift</strong> plus la molette de votre souris. Il fonctionne sur les plateformes web et desktop, et un défilement à deux doigts sur le pavé tactile fonctionne de la même façon." },
    {
      type: "steps",
      items: [
        { title: "Ouvrez un SuperDOM pour votre contrat", html: "Ouvrez le module <strong class='text-white'>SuperDOM</strong> (DOM) et chargez le contrat que vous souhaitez trader. Vous voulez l’échelle de prix en direct à l’écran, avec la colonne de travail affichant les bids, les asks et le dernier prix échangé.", image: {"src":`${IMG}/tradovate-scale-dom-ladder-1.png`,"alt":"Échelle de prix SuperDOM de Tradovate avec un contrat à terme chargé"} },
        { title: "Placez votre curseur sur l’échelle de prix", html: "Placez le pointeur de la souris sur la colonne des prix de l’échelle. Le DOM ne réagit au raccourci de défilement que lorsque votre curseur est dessus ; si rien ne se passe par la suite, c’est généralement pour cette raison.", image: {"src":`${IMG}/tradovate-scale-dom-ladder-2.png`,"alt":"Curseur de souris au-dessus de la colonne des prix de l’échelle SuperDOM de Tradovate"} },
        { title: "Maintenez Shift et faites défiler pour compresser l’échelle", html: "Maintenez <strong class='text-white'>Shift</strong> et faites tourner la molette. Les lignes se réduisent et davantage de niveaux de prix tiennent dans le même panneau. Continuez à défiler avec Shift enfoncé pour faire tenir une plage encore plus large à l’écran, ce qui est exactement ce qu’il vous faut quand le prix file et que vous voulez voir vos stops et objectifs d’un coup d’œil.", image: {"src":`${IMG}/tradovate-scale-dom-ladder-3.png`,"alt":"Échelle DOM Tradovate réduite avec Shift+molette pour afficher davantage de niveaux de prix"} },
        { title: "Faites Shift et molette dans l’autre sens pour la réagrandir", html: "Gardez <strong class='text-white'>Shift</strong> enfoncé et faites défiler dans le sens opposé pour réagrandir les lignes vers leur espacement normal d’une ligne par tick. Revenez à l’espacement plus large dès que vous voulez des cibles de clic plus grandes pour un placement d’ordre précis. L’échelle a un plancher : sur certains produits rapides, vous atteindrez le dézoom maximal avant de voir toute la plage que vous aviez en tête.", image: {"src":`${IMG}/tradovate-scale-dom-ladder-4.png`,"alt":"Échelle DOM Tradovate réagrandie à l’espacement de lignes par défaut pour cliquer avec précision"} },
        { title: "Recentrer sur le dernier prix échangé", html: "À force de faire défiler l’échelle, le dernier prix finit par sortir de l’écran. Cliquez sur le lien <strong class='text-white'>GO TO LAST</strong> sous la colonne des prix pour revenir directement au dernier prix échangé. Si vous laissez l’échelle tranquille un instant, curseur en dehors, Tradovate se recentre aussi tout seul. Survoler l’échelle suspend ce recentrage automatique, de sorte que la vue ne bouge pas pendant que vous préparez un ordre.", image: {"src":`${IMG}/tradovate-scale-dom-ladder-5.png`,"alt":"Lien GO TO LAST du SuperDOM Tradovate pour recentrer l’échelle sur le dernier prix échangé"} },
      ],
    },
    { type: "heading",text: "Défilement normal vs Shift + molette" },
    { type: "paragraph",html: "Faites défiler <em>sans</em> Shift et l’échelle glisse simplement vers le haut ou le bas à travers les prix, comme si vous la faisiez glisser. Avec <strong class='text-white'>Shift</strong>, ce même mouvement de molette modifie l’échelle à la place. Si l’échelle ne bouge pas, vérifiez que votre curseur est sur l’échelle et que Shift est enfoncé avant de tourner la molette." },
    { type: "heading",text: "Quand y recourir" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Actualités et volatilité</strong>, compressez l’échelle avant une publication programmée pour qu’un mouvement rapide ne sorte pas par le haut ou le bas du panneau.",
        "<strong class='text-white'>Brackets larges</strong>, voyez votre stop et votre objectif sur le même écran que l’entrée quand ils sont séparés de 30+ ticks.",
        "<strong class='text-white'>Scalping</strong>, revenez à l’espacement serré quand vous avez besoin de clics précis au pixel sur des niveaux de prix adjacents.",
        "<strong class='text-white'>Comptes de prop firms</strong>, les règles de position maximale et de perte varient selon la firme et la taille du compte ; gardez donc à l’écran les niveaux importants selon les règles actuelles de votre firme.",
      ],
    },
    { type: "heading",text: "Automatisez les entrées avec PickMyTrade" },
    { type: "paragraph",html: "Mettre l’échelle à la bonne taille est idéal pour suivre un trade, mais cliquer chaque entrée et sortie à la main vous garde collé à l’écran. <strong class='text-white'>PickMyTrade achemine vos alertes TradingView directement vers votre compte Tradovate</strong> : les ordres partent sur votre signal pendant que vous utilisez le DOM pour gérer la position plutôt que de la poursuivre." },
  ], it: [
    { type: "paragraph",html: "La ladder del SuperDOM mostra una banda di prezzi stretta attorno al mercato, di solito giusto le righe sufficienti per operare sull’azione corrente. Va bene in una giornata tranquilla, ma quando esce un dato e il prezzo attraversa la Sua zona di stop, quella finestra stretta diventa presto inutile. Scalare la ladder comprime più livelli di prezzo nello stesso pannello, così può vedere dove si trovano i Suoi ordini rispetto a un mercato in movimento. Ecco come farlo in un paio di secondi." },
    { type: "heading",text: "Cosa fa davvero la scala della ladder" },
    { type: "paragraph",html: "La scala cambia solo il modo in cui la ladder viene disegnata. Non tocca i Suoi ordini attivi, le Sue impostazioni di rischio né il contratto su cui si trova. Quando riduce la scala, Tradovate comprime le righe in modo che ciascuna copra una fetta di prezzi più ampia: cede un po’ di precisione per riga in cambio di una vista molto più ampia del book. Se torna a ingrandire, ritorna al layout spazioso a una riga per tick, più facile da cliccare con esattezza. Pensi allo zoom sull’asse dei prezzi di un grafico: stessi dati, spaziatura diversa." },
    { type: "paragraph",html: "Se non ha ancora configurato la ladder per l’inserimento degli ordini, parta dal posizionamento degli ordini sulla ladder del SuperDOM e poi torni qui per rifinire la visualizzazione." },
    { type: "heading",text: "Scali la ladder del DOM con Shift + scroll" },
    { type: "paragraph",html: "Tutto si basa su una sola scorciatoia: <strong class='text-white'>Shift</strong> più la rotellina del mouse. Funziona sulle piattaforme web e desktop, e uno scroll a due dita sul trackpad funziona allo stesso modo." },
    {
      type: "steps",
      items: [
        { title: "Apra un SuperDOM per il Suo contratto", html: "Apra il modulo <strong class='text-white'>SuperDOM</strong> (DOM) e carichi il contratto che desidera negoziare. Deve avere a schermo la ladder dei prezzi live, con la colonna di lavoro che mostra bid, ask e l’ultimo prezzo negoziato.", image: {"src":`${IMG}/tradovate-scale-dom-ladder-1.png`,"alt":"Ladder dei prezzi SuperDOM di Tradovate con un contratto future caricato"} },
        { title: "Sposti il cursore sopra la ladder dei prezzi", html: "Passi il puntatore del mouse sulla colonna dei prezzi della ladder. Il DOM reagisce alla scorciatoia di scroll solo mentre il cursore è sopra di esso, quindi se in seguito non succede nulla, di solito è questo il motivo.", image: {"src":`${IMG}/tradovate-scale-dom-ladder-2.png`,"alt":"Cursore del mouse sulla colonna dei prezzi della ladder SuperDOM di Tradovate"} },
        { title: "Tenga premuto Shift e faccia scroll per comprimere la ladder", html: "Tenga premuto <strong class='text-white'>Shift</strong> e giri la rotellina. Le righe si riducono e più livelli di prezzo entrano nello stesso pannello. Continui a fare scroll con Shift premuto per far entrare a schermo un intervallo ancora più ampio, che è esattamente ciò che serve quando il prezzo corre e vuole vedere stop e target a colpo d’occhio.", image: {"src":`${IMG}/tradovate-scale-dom-ladder-3.png`,"alt":"Ladder del DOM di Tradovate ridotta con Shift+scroll per mostrare più livelli di prezzo"} },
        { title: "Faccia Shift e scroll nell’altra direzione per espanderla di nuovo", html: "Tenga premuto <strong class='text-white'>Shift</strong> e faccia scroll nella direzione opposta per espandere le righe verso la loro normale spaziatura di una riga per tick. Torni alla spaziatura più ampia ogni volta che desidera bersagli di clic più grandi per un posizionamento preciso degli ordini. La scala ha un limite minimo, quindi su alcuni prodotti veloci raggiungerà lo zoom-out massimo prima di vedere tutto l’intervallo che aveva in mente.", image: {"src":`${IMG}/tradovate-scale-dom-ladder-4.png`,"alt":"Ladder del DOM di Tradovate espansa alla spaziatura predefinita delle righe per cliccare con precisione"} },
        { title: "Ricentri sull’ultimo prezzo negoziato", html: "Scorrendo la ladder, l’ultimo prezzo finisce prima o poi fuori schermo. Faccia clic sul link <strong class='text-white'>GO TO LAST</strong> sotto la colonna dei prezzi per tornare direttamente all’ultimo prezzo negoziato. Se lascia la ladder ferma per un attimo con il cursore fuori, Tradovate si ricentra anche da solo. Passare il cursore sulla ladder mette in pausa questo ricentraggio automatico, così la vista non si sposta mentre prepara un ordine.", image: {"src":`${IMG}/tradovate-scale-dom-ladder-5.png`,"alt":"Link GO TO LAST del SuperDOM di Tradovate per ricentrare la ladder sull’ultimo prezzo negoziato"} },
      ],
    },
    { type: "heading",text: "Scroll normale vs Shift + scroll" },
    { type: "paragraph",html: "Se fa scroll <em>senza</em> Shift, la ladder scorre semplicemente verso l’alto o il basso attraverso i prezzi, come se la trascinasse. Con <strong class='text-white'>Shift</strong>, lo stesso movimento della rotellina cambia invece la scala. Se la scala non cambia, verifichi che il cursore sia sopra la ladder e che Shift sia premuto prima di girare la rotellina." },
    { type: "heading",text: "Quando usarlo" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Notizie e volatilità</strong>, comprima la ladder prima di un rilascio programmato, in modo che un movimento rapido non esca dalla parte alta o bassa del pannello.",
        "<strong class='text-white'>Bracket ampi</strong>, veda stop e target sullo stesso schermo dell’entrata quando distano 30+ tick.",
        "<strong class='text-white'>Scalping</strong>, torni alla spaziatura stretta quando servono clic precisi al pixel su livelli di prezzo adiacenti.",
        "<strong class='text-white'>Conti di prop firm</strong>, le regole su posizione massima e perdita variano in base alla società e alla dimensione del conto, quindi tenga in vista i livelli rilevanti secondo le regole attuali della Sua società.",
      ],
    },
    { type: "heading",text: "Automatizzi le entrate con PickMyTrade" },
    { type: "paragraph",html: "Scalare la ladder è ottimo per osservare un trade, ma cliccare a mano ogni entrata e uscita La tiene comunque incollato allo schermo. <strong class='text-white'>PickMyTrade instrada i Suoi alert di TradingView direttamente al Suo conto Tradovate</strong>, così gli ordini partono sul Suo segnale mentre usa il DOM per gestire la posizione invece di rincorrerla." },
  ] },
  ctaHeading: { en: "Automate the Entries", de: "Automatisieren Sie die Einstiege", es: "Automatice las entradas", fr: "Automatisez les entrées", it: "Automatizzi le entrate" },
  ctaText: { en: "Scaling the ladder is great for watching a trade, but clicking every entry and exit by hand still leaves you glued to the screen. PickMyTrade routes your TradingView alerts straight into your Tradovate account.", de: "Die Leiter zu skalieren ist hervorragend, um einen Trade zu beobachten, aber jeden Ein- und Ausstieg von Hand zu klicken fesselt Sie weiterhin an den Bildschirm. PickMyTrade leitet Ihre TradingView-Alerts direkt in Ihr Tradovate-Konto weiter.", es: "Escalar la escalera es excelente para vigilar una operación, pero hacer clic en cada entrada y salida a mano le sigue dejando pegado a la pantalla. PickMyTrade enruta sus alertas de TradingView directamente a su cuenta de Tradovate.", fr: "Mettre l’échelle à la bonne taille est idéal pour suivre un trade, mais cliquer chaque entrée et sortie à la main vous garde collé à l’écran. PickMyTrade achemine vos alertes TradingView directement vers votre compte Tradovate.", it: "Scalare la ladder è ottimo per osservare un trade, ma cliccare a mano ogni entrata e uscita La tiene comunque incollato allo schermo. PickMyTrade instrada i Suoi alert di TradingView direttamente al Suo conto Tradovate." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "How do I zoom out on the Tradovate DOM?", a: "Hover over the price ladder, hold Shift, and roll the scroll wheel. The rows compress so more price levels fit on screen. Shift and scroll the other way to zoom back in." },
    { q: "Does scaling the ladder change my orders?", a: "No. Scaling only changes how the ladder is drawn. Your working orders, position, and risk settings stay exactly as they were." },
    { q: "Why isn't Shift + scroll doing anything?", a: "Make sure your cursor is directly over the ladder before you scroll. The DOM only responds to the shortcut while it has focus, and the scale has a maximum zoom-out you may already be at." },
  ], de: [
    { q: "Wie zoome ich im Tradovate-DOM heraus?", a: "Fahren Sie mit der Maus über die Preisleiter, halten Sie Shift gedrückt und drehen Sie das Mausrad. Die Zeilen werden gestaucht, sodass mehr Preisniveaus auf den Bildschirm passen. Mit Shift in die andere Richtung scrollen, um wieder hineinzuzoomen." },
    { q: "Ändert das Skalieren der Leiter meine Orders?", a: "Nein. Das Skalieren ändert nur die Darstellung der Leiter. Ihre aktiven Orders, Ihre Position und Ihre Risikoeinstellungen bleiben exakt so, wie sie waren." },
    { q: "Warum passiert bei Shift + Scrollen nichts?", a: "Stellen Sie sicher, dass sich Ihr Cursor direkt über der Leiter befindet, bevor Sie scrollen. Das DOM reagiert nur auf die Tastenkombination, solange es den Fokus hat, und die Skala hat ein maximales Herauszoomen, das Sie möglicherweise bereits erreicht haben." },
  ], es: [
    { q: "¿Cómo hago zoom hacia fuera en el DOM de Tradovate?", a: "Pase el cursor sobre la escalera de precios, mantenga pulsada Shift y gire la rueda del ratón. Las filas se comprimen para que quepan más niveles de precio en pantalla. Haga Shift y scroll en el otro sentido para volver a acercar." },
    { q: "¿Escalar la escalera modifica mis órdenes?", a: "No. Escalar solo cambia cómo se dibuja la escalera. Sus órdenes activas, su posición y sus ajustes de riesgo permanecen exactamente igual." },
    { q: "¿Por qué Shift + scroll no hace nada?", a: "Asegúrese de que el cursor esté directamente sobre la escalera antes de hacer scroll. El DOM solo responde al atajo mientras tiene el foco, y la escala tiene un alejamiento máximo que quizá ya haya alcanzado." },
  ], fr: [
    { q: "Comment dézoomer sur le DOM Tradovate ?", a: "Placez le curseur sur l’échelle de prix, maintenez Shift et faites tourner la molette. Les lignes se compressent pour que davantage de niveaux de prix tiennent à l’écran. Faites Shift et molette dans l’autre sens pour zoomer à nouveau." },
    { q: "La mise à l’échelle modifie-t-elle mes ordres ?", a: "Non. La mise à l’échelle ne change que l’affichage de l’échelle. Vos ordres actifs, votre position et vos paramètres de risque restent exactement les mêmes." },
    { q: "Pourquoi Shift + molette ne fait-il rien ?", a: "Assurez-vous que votre curseur est directement au-dessus de l’échelle avant de faire défiler. Le DOM ne réagit au raccourci que lorsqu’il a le focus, et l’échelle a un dézoom maximal que vous avez peut-être déjà atteint." },
  ], it: [
    { q: "Come faccio a ridurre lo zoom sul DOM di Tradovate?", a: "Passi il mouse sulla ladder dei prezzi, tenga premuto Shift e giri la rotellina. Le righe si comprimono e più livelli di prezzo entrano nello schermo. Faccia Shift e scroll nell’altra direzione per tornare a ingrandire." },
    { q: "Scalare la ladder modifica i miei ordini?", a: "No. La scala cambia solo il modo in cui la ladder viene disegnata. I Suoi ordini attivi, la Sua posizione e le impostazioni di rischio restano esattamente come erano." },
    { q: "Perché Shift + scroll non fa nulla?", a: "Si assicuri che il cursore sia direttamente sopra la ladder prima di fare scroll. Il DOM risponde alla scorciatoia solo quando ha il focus, e la scala ha uno zoom-out massimo che potrebbe aver già raggiunto." },
  ] },
  relatedHeading: { en: "Related Guides", de: "Verwandte Anleitungen", es: "Guías relacionadas", fr: "Guides associés", it: "Guide correlate" },
  disclosureText: { en: `This guide is for educational and informational purposes only and is not financial, investment, or trading advice. Trading futures and other leveraged products carries a substantial risk of loss and is not suitable for every investor. PickMyTrade is an independent third-party automation platform and is not affiliated with, endorsed by, or sponsored by Tradovate, Inc. "Tradovate" and all related names, logos, and trademarks are the property of their respective owners. Platform features and steps change over time, so always confirm the current process in the official Tradovate platform and documentation before acting.`, de: "Diese Anleitung dient ausschließlich Bildungs- und Informationszwecken und stellt keine Finanz-, Anlage- oder Handelsberatung dar. Der Handel mit Futures und anderen gehebelten Produkten birgt ein erhebliches Verlustrisiko und ist nicht für jeden Anleger geeignet. PickMyTrade ist eine unabhängige Automatisierungsplattform eines Drittanbieters und steht in keiner Verbindung zu Tradovate, Inc., wird weder von diesem unterstützt noch gesponsert. „Tradovate“ sowie alle zugehörigen Namen, Logos und Marken sind Eigentum der jeweiligen Inhaber. Funktionen und Schritte der Plattform ändern sich im Laufe der Zeit. Bestätigen Sie daher stets den aktuellen Ablauf in der offiziellen Tradovate-Plattform und -Dokumentation, bevor Sie handeln.", es: "Esta guía tiene únicamente fines educativos e informativos y no constituye asesoramiento financiero, de inversión ni de trading. Operar con futuros y otros productos apalancados conlleva un riesgo sustancial de pérdida y no es adecuado para todos los inversores. PickMyTrade es una plataforma de automatización independiente de terceros y no está afiliada, respaldada ni patrocinada por Tradovate, Inc. «Tradovate» y todos los nombres, logotipos y marcas relacionados son propiedad de sus respectivos titulares. Las funciones y los pasos de la plataforma cambian con el tiempo, por lo que debe confirmar siempre el proceso vigente en la plataforma y la documentación oficiales de Tradovate antes de actuar.", fr: "Ce guide est fourni à des fins éducatives et informatives uniquement et ne constitue pas un conseil financier, d’investissement ou de trading. Le trading de contrats à terme et d’autres produits à effet de levier comporte un risque de perte important et ne convient pas à tous les investisseurs. PickMyTrade est une plateforme d’automatisation tierce indépendante et n’est ni affiliée à Tradovate, Inc., ni approuvée ou parrainée par celle-ci. « Tradovate » ainsi que tous les noms, logos et marques associés sont la propriété de leurs détenteurs respectifs. Les fonctionnalités et les étapes de la plateforme évoluent avec le temps ; vérifiez donc toujours la procédure actuelle dans la plateforme et la documentation officielles de Tradovate avant d’agir.", it: "Questa guida ha esclusivamente scopo educativo e informativo e non costituisce consulenza finanziaria, di investimento o di trading. Il trading di futures e di altri prodotti a leva comporta un rischio sostanziale di perdita e non è adatto a tutti gli investitori. PickMyTrade è una piattaforma di automazione indipendente di terze parti e non è affiliata, approvata né sponsorizzata da Tradovate, Inc. «Tradovate» e tutti i nomi, loghi e marchi correlati sono di proprietà dei rispettivi titolari. Le funzionalità e i passaggi della piattaforma cambiano nel tempo, quindi confermi sempre la procedura attuale nella piattaforma e nella documentazione ufficiali di Tradovate prima di agire." },
};
const data: GuideArticleData = resolveGuideContent(content, locale, related);

