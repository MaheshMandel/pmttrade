---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-cancel-plan";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Cancel a Monthly Tradovate Account Plan";
const META_DESCRIPTION =
  "Cancel your monthly Tradovate plan before renewal and skip the next charge. Step-by-step guide to switch back to the Free plan the right way.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Einen monatlichen Tradovate-Kontotarif kündigen", es: "Cancelar un plan mensual de cuenta de Tradovate", fr: "Annuler un forfait mensuel de compte Tradovate", it: "Annullare un piano mensile del conto Tradovate" },
  dek: { en: "There's no big red \"Cancel\" button in Tradovate. You cancel the monthly membership by switching your Account Plan back to Free before your renewal date. Here's exactly how, and what to watch out for.", de: "In Tradovate gibt es keine große rote Schaltfläche „Cancel“. Sie kündigen die monatliche Mitgliedschaft, indem Sie Ihren Account Plan vor dem Verlängerungsdatum wieder auf Free umstellen. Hier steht genau, wie das geht und worauf Sie achten müssen.", es: "En Tradovate no hay un gran botón rojo de «Cancel». Cancela la membresía mensual cambiando su Account Plan de nuevo a Free antes de la fecha de renovación. Aquí se explica exactamente cómo hacerlo y a qué prestar atención.", fr: "Il n’y a pas de gros bouton rouge « Cancel » dans Tradovate. Vous annulez l’abonnement mensuel en repassant votre Account Plan sur Free avant la date de renouvellement. Voici exactement comment faire et ce dont il faut se méfier.", it: "In Tradovate non c’è un grande pulsante rosso «Cancel». Lei annulla l’abbonamento mensile riportando il Suo Account Plan su Free prima della data di rinnovo. Ecco esattamente come fare e a cosa prestare attenzione." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "There's no big red \"Cancel\" button hiding in Tradovate. You cancel the monthly membership by switching your Account Plan back to <strong class='text-white'>Free</strong> before your renewal date. Do that and next month's fee never touches your card. Miss the date and you're billed for another full cycle." },
    { type: "paragraph", html: "One thing to get straight before you start: canceling the plan and closing the account are two different jobs. Dropping to Free keeps your login, your history, and any balance exactly where they are, you just stop paying the monthly fee. If you want the account gone for good, that's a separate process (pull your funds down to a zero balance first, then close it)." },
    { type: "quote", html: "<strong class='text-white'>Before you start:</strong><br>You can only change the plan yourself on a <strong class='text-white'>live Tradovate Brokerage account</strong>, from inside the Web Trader. No live brokerage account, no self-service plan change.<br>Trading a <strong class='text-white'>prop-firm or evaluation account</strong>? You don't control the plan, the firm owns the billing. What you pay and how you cancel varies by firm and account size, so check your firm's current rules.<br>Market-data subscriptions and add-ons bill on their own. Dropping your plan doesn't stop those, so cancel them separately if you're finished." },
    { type: "heading", text: "How to Cancel Your Monthly Tradovate Plan" },
    {
      type: "steps",
      items: [
        { title: "Open Application Settings", html: "Log in to the Tradovate Web Trader and click the <strong class='text-white'>Application Settings</strong> button in the top-right corner, near your account name. That's where every plan and billing option lives, you won't find it on the marketing website." },
        { title: "Open the Subscriptions Tab", html: "Inside Settings, open the <strong class='text-white'>Subscriptions</strong> tab along the top. Depending on your build it may be labeled <strong class='text-white'>Plans</strong>, either way, this is the screen that shows your current membership and renewal." },
        { title: "Choose the Free Plan", html: "In the <strong class='text-white'>Membership</strong> section, open the plan chooser. Heads up: the button usually reads <strong class='text-white'>Upgrade</strong> even when you're moving down a tier, that's just the label for the plan-change screen. Pick <strong class='text-white'>Free</strong> from the three options (Free, Monthly, Lifetime). Selecting Free is what actually cancels the monthly renewal." },
        { title: "Confirm the Switch", html: "Confirm the change. Because the Free plan costs nothing, there's no payment step to clear, no card, no balance deduction. Once it's confirmed, your monthly renewal is switched off." },
        { title: "Log Out, Log Back In, and Verify", html: "Log out of the Web Trader completely, then log back in. Open Settings one more time and check that your plan now reads <strong class='text-white'>Free</strong> on the <strong class='text-white'>Settings › Plans</strong> page. If it still shows Monthly, wait a minute and re-check, the change reflects after a fresh login." },
      ],
    },
    { type: "heading", text: "Do It Before Your Renewal Date" },
    { type: "paragraph", html: "Tradovate charges the monthly fee up front for the month ahead, so the switch has to land <strong class='text-white'>before</strong> your renewal date if you want to skip the next charge. Downgrade after you've already been billed and you simply keep the paid rate until that cycle runs out, the change applies going forward, not retroactively, and there's no partial refund. Not sure of your date? It's listed on the same Subscriptions (Plans) page." },
    { type: "heading", text: "Heads Up: The Free Plan Isn't Fee-Free Forever" },
    { type: "paragraph", html: "Dropping to Free ends the monthly membership fee, but Free has its own catch. Log in without placing a live trade for a set stretch and an <strong class='text-white'>inactivity fee</strong> can apply (recently around $35 after 30 days, with a further charge after roughly 90). Tradovate adjusts these amounts over time, so confirm the current figures rather than trusting a number you read once. If you're truly done trading, withdrawing your funds and closing the account outright sidesteps that fee entirely." },
  ], de: [
    { type: "paragraph",html: "In Tradovate versteckt sich keine große rote Schaltfläche „Cancel“. Sie kündigen die monatliche Mitgliedschaft, indem Sie Ihren Account Plan vor dem Verlängerungsdatum auf <strong class='text-white'>Free</strong> zurückstellen. Tun Sie das, und die Gebühr des nächsten Monats wird Ihrer Karte nicht belastet. Verpassen Sie das Datum, wird Ihnen ein weiterer voller Zyklus berechnet." },
    { type: "paragraph",html: "Eines sollten Sie vorab klarstellen: Den Tarif zu kündigen und das Konto zu schließen sind zwei verschiedene Aufgaben. Der Wechsel zu Free behält Ihren Login, Ihren Verlauf und jedes Guthaben genau so, wie sie sind, Sie zahlen lediglich die monatliche Gebühr nicht mehr. Wenn Sie das Konto endgültig loswerden möchten, ist das ein separater Vorgang (zuerst das Guthaben auf null abziehen, dann schließen)." },
    { type: "quote",html: "<strong class='text-white'>Bevor Sie beginnen:</strong><br>Den Tarif können Sie nur bei einem <strong class='text-white'>Tradovate-Brokerage-Live-Konto</strong> selbst ändern, und zwar im Web Trader. Ohne Live-Brokerage-Konto gibt es keine Selbstbedienungs-Tarifänderung.<br>Handeln Sie ein <strong class='text-white'>Prop-Firm- oder Evaluierungskonto</strong>? Dann steuern Sie den Tarif nicht, die Firma besitzt die Abrechnung. Was Sie zahlen und wie Sie kündigen, variiert je nach Firma und Kontogröße, prüfen Sie daher die aktuellen Regeln Ihrer Firma.<br>Marktdatenabonnements und Add-ons werden separat abgerechnet. Der Wechsel Ihres Tarifs beendet diese nicht, kündigen Sie sie daher gesondert, wenn Sie fertig sind." },
    { type: "heading",text: "So kündigen Sie Ihren monatlichen Tradovate-Tarif" },
    {
      type: "steps",
      items: [
        { title: "Application Settings öffnen", html: "Melden Sie sich im Tradovate Web Trader an und klicken Sie oben rechts neben Ihrem Kontonamen auf die Schaltfläche <strong class='text-white'>Application Settings</strong>. Dort befinden sich alle Tarif- und Abrechnungsoptionen, auf der Marketing-Website finden Sie sie nicht." },
        { title: "Den Tab Subscriptions öffnen", html: "Öffnen Sie in den Settings oben den Tab <strong class='text-white'>Subscriptions</strong>. Je nach Version heißt er möglicherweise <strong class='text-white'>Plans</strong>, in jedem Fall zeigt dieser Bildschirm Ihre aktuelle Mitgliedschaft und die Verlängerung an." },
        { title: "Den Free-Tarif wählen", html: "Öffnen Sie im Bereich <strong class='text-white'>Membership</strong> die Tarifauswahl. Achtung: Die Schaltfläche heißt meist <strong class='text-white'>Upgrade</strong>, auch wenn Sie eine Stufe nach unten wechseln, das ist nur die Bezeichnung für den Bildschirm zum Tarifwechsel. Wählen Sie <strong class='text-white'>Free</strong> aus den drei Optionen (Free, Monthly, Lifetime). Die Auswahl von Free kündigt tatsächlich die monatliche Verlängerung." },
        { title: "Den Wechsel bestätigen", html: "Bestätigen Sie die Änderung. Da der Free-Tarif nichts kostet, gibt es keinen Zahlungsschritt, keine Karte und keinen Abzug vom Guthaben. Sobald die Änderung bestätigt ist, ist Ihre monatliche Verlängerung abgeschaltet." },
        { title: "Abmelden, wieder anmelden und prüfen", html: "Melden Sie sich vollständig vom Web Trader ab und dann wieder an. Öffnen Sie die Settings noch einmal und prüfen Sie, ob Ihr Tarif auf der Seite <strong class='text-white'>Settings › Plans</strong> jetzt <strong class='text-white'>Free</strong> anzeigt. Wenn dort noch Monthly steht, warten Sie eine Minute und prüfen Sie erneut, die Änderung wird nach einem frischen Login sichtbar." },
      ],
    },
    { type: "heading",text: "Tun Sie es vor Ihrem Verlängerungsdatum" },
    { type: "paragraph",html: "Tradovate berechnet die Monatsgebühr im Voraus für den kommenden Monat, daher muss der Wechsel <strong class='text-white'>vor</strong> Ihrem Verlängerungsdatum erfolgen, wenn Sie die nächste Abbuchung vermeiden möchten. Wenn Sie erst nach der Abrechnung herunterstufen, behalten Sie den bezahlten Tarif einfach, bis der Zyklus abläuft, die Änderung gilt für die Zukunft, nicht rückwirkend, und es gibt keine teilweise Erstattung. Sie kennen Ihr Datum nicht? Es steht auf derselben Seite Subscriptions (Plans)." },
    { type: "heading",text: "Achtung: Der Free-Tarif ist nicht für immer gebührenfrei" },
    { type: "paragraph",html: "Der Wechsel zu Free beendet die monatliche Mitgliedsgebühr, aber Free hat seinen eigenen Haken. Wenn Sie sich über einen bestimmten Zeitraum einloggen, ohne einen Live-Trade zu platzieren, kann eine <strong class='text-white'>Inaktivitätsgebühr</strong> anfallen (zuletzt rund $35 nach 30 Tagen, mit einer weiteren Gebühr nach etwa 90). Tradovate passt diese Beträge im Laufe der Zeit an, prüfen Sie daher die aktuellen Zahlen, statt sich auf eine einmal gelesene Zahl zu verlassen. Wenn Sie wirklich mit dem Trading fertig sind, vermeidet das Abheben Ihres Guthabens und das vollständige Schließen des Kontos diese Gebühr komplett." },
  ], es: [
    { type: "paragraph",html: "En Tradovate no hay un gran botón rojo de «Cancel» escondido. Cancela la membresía mensual cambiando su Account Plan de nuevo a <strong class='text-white'>Free</strong> antes de la fecha de renovación. Si lo hace, la cuota del próximo mes nunca se cargará a su tarjeta. Si se pasa de la fecha, se le facturará otro ciclo completo." },
    { type: "paragraph",html: "Una cosa que debe tener clara antes de empezar: cancelar el plan y cerrar la cuenta son dos tareas distintas. Pasar a Free conserva su inicio de sesión, su historial y cualquier saldo exactamente como están; simplemente deja de pagar la cuota mensual. Si quiere eliminar la cuenta definitivamente, es un proceso aparte (primero retire sus fondos hasta dejar el saldo en cero y luego ciérrela)." },
    { type: "quote",html: "<strong class='text-white'>Antes de empezar:</strong><br>Solo puede cambiar el plan usted mismo en una <strong class='text-white'>cuenta real de Tradovate Brokerage</strong>, desde el Web Trader. Sin cuenta real de brokerage, no hay cambio de plan por autoservicio.<br>¿Opera una <strong class='text-white'>cuenta de prop firm o de evaluación</strong>? Entonces no controla el plan, la facturación es de la firma. Lo que paga y cómo cancela varía según la firma y el tamaño de la cuenta, así que consulte las reglas vigentes de su firma.<br>Las suscripciones de datos de mercado y los complementos se facturan por separado. Cambiar de plan no los detiene, así que cancélelos aparte si ha terminado." },
    { type: "heading",text: "Cómo cancelar su plan mensual de Tradovate" },
    {
      type: "steps",
      items: [
        { title: "Abra Application Settings", html: "Inicie sesión en el Web Trader de Tradovate y haga clic en el botón <strong class='text-white'>Application Settings</strong> de la esquina superior derecha, junto al nombre de su cuenta. Ahí están todas las opciones de plan y facturación; no las encontrará en el sitio web de marketing." },
        { title: "Abra la pestaña Subscriptions", html: "Dentro de Settings, abra la pestaña <strong class='text-white'>Subscriptions</strong> en la parte superior. Según su versión, puede llamarse <strong class='text-white'>Plans</strong>; en cualquier caso, es la pantalla que muestra su membresía actual y la renovación." },
        { title: "Elija el plan Free", html: "En la sección <strong class='text-white'>Membership</strong>, abra el selector de planes. Aviso: el botón suele decir <strong class='text-white'>Upgrade</strong> incluso cuando baja de nivel; es solo el nombre de la pantalla de cambio de plan. Elija <strong class='text-white'>Free</strong> entre las tres opciones (Free, Monthly, Lifetime). Seleccionar Free es lo que realmente cancela la renovación mensual." },
        { title: "Confirme el cambio", html: "Confirme el cambio. Como el plan Free no cuesta nada, no hay paso de pago: ni tarjeta ni descuento del saldo. Una vez confirmado, su renovación mensual queda desactivada." },
        { title: "Cierre sesión, vuelva a iniciarla y verifique", html: "Cierre sesión por completo en el Web Trader y vuelva a iniciarla. Abra Settings una vez más y compruebe que su plan aparece ahora como <strong class='text-white'>Free</strong> en la página <strong class='text-white'>Settings › Plans</strong>. Si todavía muestra Monthly, espere un minuto y vuelva a comprobarlo; el cambio se refleja tras un nuevo inicio de sesión." },
      ],
    },
    { type: "heading",text: "Hágalo antes de su fecha de renovación" },
    { type: "paragraph",html: "Tradovate cobra la cuota mensual por adelantado para el mes siguiente, así que el cambio debe hacerse <strong class='text-white'>antes</strong> de su fecha de renovación si quiere evitar el siguiente cargo. Si baja de plan una vez facturado, simplemente conserva la tarifa pagada hasta que termine ese ciclo; el cambio se aplica a futuro, no con carácter retroactivo, y no hay reembolso parcial. ¿No está seguro de su fecha? Aparece en la misma página Subscriptions (Plans)." },
    { type: "heading",text: "Atención: el plan Free no está libre de cuotas para siempre" },
    { type: "paragraph",html: "Pasar a Free elimina la cuota mensual de membresía, pero Free tiene su propia trampa. Si inicia sesión sin realizar una operación real durante un periodo determinado, puede aplicarse una <strong class='text-white'>cuota por inactividad</strong> (recientemente de unos $35 tras 30 días, con otro cargo adicional tras aproximadamente 90). Tradovate ajusta estos importes con el tiempo, así que confirme las cifras vigentes en lugar de fiarse de un número que leyó una vez. Si de verdad ha terminado de operar, retirar sus fondos y cerrar la cuenta por completo evita esa cuota por completo." },
  ], fr: [
    { type: "paragraph",html: "Il n’y a pas de gros bouton rouge « Cancel » caché dans Tradovate. Vous annulez l’abonnement mensuel en repassant votre Account Plan sur <strong class='text-white'>Free</strong> avant la date de renouvellement. Faites-le et les frais du mois suivant ne seront jamais prélevés sur votre carte. Ratez la date et un nouveau cycle complet vous sera facturé." },
    { type: "paragraph",html: "Un point à clarifier avant de commencer : annuler le forfait et fermer le compte sont deux démarches différentes. Passer à Free conserve votre identifiant, votre historique et votre solde exactement tels quels, vous cessez simplement de payer les frais mensuels. Si vous voulez supprimer définitivement le compte, c’est un processus distinct (retirez d’abord vos fonds pour ramener le solde à zéro, puis fermez-le)." },
    { type: "quote",html: "<strong class='text-white'>Avant de commencer :</strong><br>Vous ne pouvez modifier le forfait vous-même que sur un <strong class='text-white'>compte réel Tradovate Brokerage</strong>, depuis le Web Trader. Sans compte de courtage réel, pas de changement de forfait en libre-service.<br>Vous tradez sur un <strong class='text-white'>compte de prop firm ou d’évaluation</strong> ? Vous ne contrôlez pas le forfait, la société gère la facturation. Ce que vous payez et la façon d’annuler varient selon la société et la taille du compte ; vérifiez donc les règles actuelles de votre société.<br>Les abonnements de données de marché et les modules complémentaires sont facturés séparément. Abandonner votre forfait ne les arrête pas ; annulez-les donc séparément si vous en avez fini." },
    { type: "heading",text: "Comment annuler votre forfait mensuel Tradovate" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir Application Settings", html: "Connectez-vous au Web Trader Tradovate et cliquez sur le bouton <strong class='text-white'>Application Settings</strong> en haut à droite, près du nom de votre compte. C’est là que se trouvent toutes les options de forfait et de facturation ; vous ne les trouverez pas sur le site marketing." },
        { title: "Ouvrir l’onglet Subscriptions", html: "Dans Settings, ouvrez l’onglet <strong class='text-white'>Subscriptions</strong> en haut. Selon votre version, il peut s’appeler <strong class='text-white'>Plans</strong> ; dans tous les cas, c’est l’écran qui affiche votre abonnement actuel et son renouvellement." },
        { title: "Choisir le forfait Free", html: "Dans la section <strong class='text-white'>Membership</strong>, ouvrez le sélecteur de forfait. Attention : le bouton indique généralement <strong class='text-white'>Upgrade</strong> même lorsque vous descendez d’un niveau, c’est simplement le libellé de l’écran de changement de forfait. Choisissez <strong class='text-white'>Free</strong> parmi les trois options (Free, Monthly, Lifetime). C’est la sélection de Free qui annule réellement le renouvellement mensuel." },
        { title: "Confirmer le changement", html: "Confirmez la modification. Comme le forfait Free ne coûte rien, il n’y a pas d’étape de paiement, ni carte ni déduction du solde. Une fois confirmé, votre renouvellement mensuel est désactivé." },
        { title: "Se déconnecter, se reconnecter et vérifier", html: "Déconnectez-vous complètement du Web Trader, puis reconnectez-vous. Ouvrez à nouveau Settings et vérifiez que votre forfait affiche bien <strong class='text-white'>Free</strong> sur la page <strong class='text-white'>Settings › Plans</strong>. S’il indique encore Monthly, patientez une minute et revérifiez ; la modification apparaît après une nouvelle connexion." },
      ],
    },
    { type: "heading",text: "Faites-le avant votre date de renouvellement" },
    { type: "paragraph",html: "Tradovate prélève les frais mensuels à l’avance pour le mois à venir ; le changement doit donc intervenir <strong class='text-white'>avant</strong> votre date de renouvellement si vous voulez éviter le prochain prélèvement. Si vous rétrogradez après avoir déjà été facturé, vous conservez simplement le tarif payé jusqu’à la fin du cycle : la modification s’applique pour l’avenir, pas rétroactivement, et il n’y a pas de remboursement partiel. Vous ne connaissez pas votre date ? Elle figure sur la même page Subscriptions (Plans)." },
    { type: "heading",text: "Attention : le forfait Free n’est pas sans frais pour toujours" },
    { type: "paragraph",html: "Passer à Free met fin aux frais d’abonnement mensuels, mais Free a son propre piège. Si vous vous connectez sans passer de trade réel pendant une certaine période, des <strong class='text-white'>frais d’inactivité</strong> peuvent s’appliquer (récemment environ $35 après 30 jours, avec des frais supplémentaires après environ 90). Tradovate ajuste ces montants au fil du temps ; vérifiez donc les chiffres actuels plutôt que de vous fier à un montant lu une fois. Si vous avez vraiment fini de trader, retirer vos fonds et fermer complètement le compte permet d’éviter totalement ces frais." },
  ], it: [
    { type: "paragraph",html: "In Tradovate non c’è un grande pulsante rosso «Cancel» nascosto da qualche parte. Lei annulla l’abbonamento mensile riportando il Suo Account Plan su <strong class='text-white'>Free</strong> prima della data di rinnovo. Se lo fa, la quota del mese successivo non verrà mai addebitata sulla Sua carta. Se perde la data, Le verrà fatturato un altro ciclo completo." },
    { type: "paragraph",html: "Una cosa da chiarire prima di iniziare: annullare il piano e chiudere il conto sono due operazioni diverse. Passare a Free mantiene invariati il Suo login, la Sua cronologia e l’eventuale saldo, semplicemente smette di pagare la quota mensile. Se vuole eliminare definitivamente il conto, è un procedimento separato (prima prelevi i fondi fino ad azzerare il saldo, poi lo chiuda)." },
    { type: "quote",html: "<strong class='text-white'>Prima di iniziare:</strong><br>Può modificare il piano da solo soltanto su un <strong class='text-white'>conto reale Tradovate Brokerage</strong>, dall’interno del Web Trader. Senza un conto brokerage reale non è possibile cambiare piano in autonomia.<br>Opera su un <strong class='text-white'>conto prop firm o di valutazione</strong>? Allora non controlla il piano, la fatturazione è della società. Quanto paga e come annulla varia in base alla società e alla dimensione del conto, quindi verifichi le regole attuali della Sua società.<br>Gli abbonamenti ai dati di mercato e i componenti aggiuntivi vengono fatturati separatamente. Abbandonare il piano non li interrompe, quindi li annulli a parte se ha finito." },
    { type: "heading",text: "Come annullare il Suo piano mensile Tradovate" },
    {
      type: "steps",
      items: [
        { title: "Apra Application Settings", html: "Acceda al Web Trader di Tradovate e clicchi sul pulsante <strong class='text-white'>Application Settings</strong> in alto a destra, vicino al nome del Suo conto. Lì si trovano tutte le opzioni di piano e fatturazione; non le troverà sul sito di marketing." },
        { title: "Apra la scheda Subscriptions", html: "All’interno di Settings, apra la scheda <strong class='text-white'>Subscriptions</strong> in alto. A seconda della versione potrebbe chiamarsi <strong class='text-white'>Plans</strong>; in ogni caso, è la schermata che mostra il Suo abbonamento attuale e il rinnovo." },
        { title: "Scelga il piano Free", html: "Nella sezione <strong class='text-white'>Membership</strong>, apra il selettore dei piani. Attenzione: il pulsante di solito riporta <strong class='text-white'>Upgrade</strong> anche quando scende di livello, è solo l’etichetta della schermata di cambio piano. Scelga <strong class='text-white'>Free</strong> tra le tre opzioni (Free, Monthly, Lifetime). È la selezione di Free che annulla effettivamente il rinnovo mensile." },
        { title: "Confermi il cambio", html: "Confermi la modifica. Poiché il piano Free non costa nulla, non c’è nessun passaggio di pagamento, né carta né detrazione dal saldo. Una volta confermato, il Suo rinnovo mensile è disattivato." },
        { title: "Esca, rientri e verifichi", html: "Esca completamente dal Web Trader, quindi rientri. Apra di nuovo Settings e verifichi che il Suo piano indichi ora <strong class='text-white'>Free</strong> nella pagina <strong class='text-white'>Settings › Plans</strong>. Se mostra ancora Monthly, attenda un minuto e ricontrolli: la modifica si riflette dopo un nuovo login." },
      ],
    },
    { type: "heading",text: "Lo faccia prima della data di rinnovo" },
    { type: "paragraph",html: "Tradovate addebita la quota mensile in anticipo per il mese successivo, quindi il cambio deve avvenire <strong class='text-white'>prima</strong> della data di rinnovo se vuole evitare il prossimo addebito. Se passa a un piano inferiore dopo essere già stato fatturato, mantiene semplicemente la tariffa pagata fino al termine del ciclo: la modifica vale per il futuro, non è retroattiva, e non c’è alcun rimborso parziale. Non è sicuro della data? È indicata nella stessa pagina Subscriptions (Plans)." },
    { type: "heading",text: "Attenzione: il piano Free non è privo di costi per sempre" },
