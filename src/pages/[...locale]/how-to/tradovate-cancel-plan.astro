  ctaHeading: { en: "Automate Your Tradovate Strategy", de: "Automatisieren Sie Ihre Tradovate-Strategie", es: "Automatice su estrategia en Tradovate", fr: "Automatisez votre stratégie Tradovate", it: "Automatizzi la Sua strategia Tradovate" },
