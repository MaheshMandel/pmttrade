---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-orders-module";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Manage Working Orders in the Tradovate Orders Module";
const META_DESCRIPTION =
  "Set up the working-orders panel to view, filter, modify and cancel your futures orders in one place, a simple step-by-step order-management guide.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Working Orders im Tradovate-Orders-Modul verwalten", es: "Gestione las órdenes activas en el módulo Orders de Tradovate", fr: "Gérez vos ordres actifs dans le module Orders de Tradovate", it: "Gestisca gli ordini attivi nel modulo Orders di Tradovate" },
  dek: { en: "Keeping track of a stack of working stops, limits, and brackets while price runs is where things get messy. The Orders module is one panel that lists every order on the account and lets you filter, modify, or cancel any of them.", de: "Den Überblick über einen ganzen Stapel aus Working-Stops, Limits und Brackets zu behalten, während der Kurs läuft, wird schnell unübersichtlich. Das Orders-Modul ist ein einziges Panel, das jede Order des Kontos auflistet und in dem Sie jede davon filtern, ändern oder stornieren können.", es: "Llevar el control de un montón de stops, límites y brackets activos mientras el precio corre es donde todo se complica. El módulo Orders es un único panel que lista todas las órdenes de la cuenta y le permite filtrar, modificar o cancelar cualquiera de ellas.", fr: "Suivre une pile de stops, de limites et de brackets actifs pendant que le prix s'emballe, c'est là que tout se complique. Le module Orders est un panneau unique qui liste chaque ordre du compte et vous permet de filtrer, modifier ou annuler n'importe lequel d'entre eux.", it: "Tenere traccia di una pila di stop, limit e bracket attivi mentre il prezzo corre è il punto in cui tutto si complica. Il modulo Orders è un unico pannello che elenca ogni ordine del conto e Le consente di filtrare, modificare o annullare qualsiasi ordine." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Placing an order is the easy part. Keeping track of a stack of working stops, limits, and brackets while price runs is where things get messy. That's what the Orders module is for, one panel that lists every order on the account and lets you filter, modify, or cancel any of them without hunting across charts and DOM ladders." },
    { type: "paragraph", html: "This guide walks through setting that panel up and using it to manage your live working orders. Labels and buttons shift a little between platform updates, so if something sits slightly off from what you see below, look for the same wording nearby." },
    { type: "heading", text: "What the Orders Module Shows" },
    { type: "paragraph", html: "The module lists orders across every state, working, filled, canceled, rejected, and suspended, for the account and date range you have selected. Each row carries the essentials:" },
    {
      type: "table",
      headers: ["Column", "What it tells you"],
      rows: [
        ["Time", "Server timestamp of the order action"],
        ["Instrument", "The contract, e.g. ESZ5 or MNQH6"],
        ["Side", "Buy or sell"],
        ["Qty", "Number of contracts"],
        ["Type", "Market, limit, stop, or stop-limit"],
        ["Price", "The limit, stop, or target level"],
        ["Status", "Working, filled, canceled, rejected, or suspended"],
        ["Account", "Which account the order belongs to"],
      ],
    },
    { type: "paragraph", html: '"Working" means the order is live at the exchange and can still fill. Those are the ones you\'ll spend most of your time on in here.' },
    { type: "heading", text: "Set Up and Manage Your Working Orders" },
    {
      type: "steps",
      items: [
        { title: "Add the Orders Module to Your Workspace", html: "Open the New menu, the plus icon in the upper-left corner, and pick Orders. The panel drops into your workspace as its own card. If one module is already open, you can add a second and filter it differently, which is handy when you want working orders kept separate from your fill history.", image: { src: `${IMG}/tradovate-orders-module-1.png`, alt: "Tradovate New menu open in the upper-left corner with the Orders option highlighted" } },
        { title: "Switch Between Table and Card Views", html: "By default the module opens in a standard table view, one column per field, best for scanning and filtering a long list. Switch to card view when you'd rather see each order as a stacked card with its controls exposed. Card view is easier on a small screen or when you're working a handful of orders by hand.", image: { src: `${IMG}/tradovate-orders-module-2.png`, alt: "Tradovate Orders module shown in standard table view with rows of orders" } },
        { title: "Choose Which Columns You See", html: "Open View Settings, the cogwheel in the upper-right, and go to Select Columns. Drag the fields you care about from Available into Visible, and drop the ones you don't back out. The top-to-bottom order in the Visible list sets the left-to-right order in your grid. While you're there, add the Working Order button column; it puts an inline Cancel button next to every live order.", image: { src: `${IMG}/tradovate-orders-module-3.png`, alt: "Tradovate Select Columns panel with Available and Visible column lists" } },
        { title: "Filter Down to Working Orders", html: "A busy account fills the list with canceled and rejected rows you don't need. Turn on Show Filters from View Settings, then set the status filter to Working. Now you're looking only at orders that can still fill. Layer on instrument or order-type filters too if you're juggling several symbols at once.", image: { src: `${IMG}/tradovate-orders-module-4.png`, alt: "Tradovate Orders module status filter set to Working orders only" } },
        { title: "Modify a Working Order", html: "To change a resting order, expand its card or right-click the row and choose Modify. A small popup opens where you can move the price or change the quantity, then confirm. It's the clean way to nudge a stop or reprice a limit without dragging lines around on a chart.", image: { src: `${IMG}/tradovate-orders-module-5.png`, alt: "Tradovate Modify order popup showing price and quantity fields for a working order" } },
        { title: "Cancel One Order or Clear Them All", html: "Need an order gone? Right-click it and choose Cancel, or hit the inline Cancel button if you added that column. To clear everything at once, flattening the position cancels its working orders in the same move. Watch bracket orders here, pulling only the stop or only the target leaves the other leg live with no OCO protection behind it.", image: { src: `${IMG}/tradovate-orders-module-6.png`, alt: "Tradovate right-click order menu with the Cancel option highlighted" } },
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Tired of babysitting stops and targets by hand? <strong class='text-white'>PickMyTrade routes your TradingView alerts straight to your Tradovate account</strong>, so entries, brackets, and exits fire on their own while you watch the chart." },
  ], de: [
    { type: "paragraph",html: "Eine Order zu platzieren ist der einfache Teil. Den Überblick über einen Stapel aus Working-Stops, Limits und Brackets zu behalten, während der Kurs läuft, ist der Punkt, an dem es unübersichtlich wird. Dafür gibt es das Orders-Modul: ein Panel, das jede Order des Kontos auflistet und in dem Sie jede davon filtern, ändern oder stornieren können, ohne zwischen Charts und DOM-Leitern suchen zu müssen." },
    { type: "paragraph",html: "Dieser Leitfaden zeigt, wie Sie dieses Panel einrichten und damit Ihre aktiven Working Orders verwalten. Bezeichnungen und Schaltflächen verschieben sich zwischen Plattform-Updates leicht. Weicht etwas geringfügig von dem ab, was Sie unten sehen, suchen Sie in der Nähe nach demselben Wortlaut." },
    { type: "heading",text: "Was das Orders-Modul anzeigt" },
    { type: "paragraph",html: "Das Modul listet Orders in jedem Zustand auf – working, filled, canceled, rejected und suspended – für das ausgewählte Konto und den gewählten Zeitraum. Jede Zeile enthält das Wesentliche:" },
    { type: "table", headers: ["Spalte","Was sie Ihnen sagt"], rows: [
      ["Time","Server-Zeitstempel der Order-Aktion"],
      ["Instrument","Der Kontrakt, z. B. ESZ5 oder MNQH6"],
      ["Side","Kauf oder Verkauf"],
      ["Qty","Anzahl der Kontrakte"],
      ["Type","Market, Limit, Stop oder Stop-Limit"],
      ["Price","Das Limit-, Stop- oder Zielniveau"],
      ["Status","Working, filled, canceled, rejected oder suspended"],
      ["Account","Zu welchem Konto die Order gehört"],
    ] },
    { type: "paragraph",html: "„Working“ bedeutet, dass die Order an der Börse aktiv ist und noch ausgeführt werden kann. Mit diesen Orders verbringen Sie hier die meiste Zeit." },
    { type: "heading",text: "Working Orders einrichten und verwalten" },
    {
      type: "steps",
      items: [
        { title: "Fügen Sie das Orders-Modul Ihrem Workspace hinzu", html: "Öffnen Sie das New-Menü (das Plus-Symbol in der oberen linken Ecke) und wählen Sie Orders. Das Panel erscheint als eigene Karte in Ihrem Workspace. Ist bereits ein Modul geöffnet, können Sie ein zweites hinzufügen und anders filtern, was praktisch ist, wenn Sie Working Orders getrennt von Ihrem Ausführungsverlauf halten möchten.", image: {"src":`${IMG}/tradovate-orders-module-1.png`,"alt":"Tradovate-New-Menü in der oberen linken Ecke mit hervorgehobener Option Orders"} },
        { title: "Zwischen Tabellen- und Kartenansicht wechseln", html: "Standardmäßig öffnet sich das Modul in einer normalen Tabellenansicht mit einer Spalte pro Feld – ideal zum Überfliegen und Filtern einer langen Liste. Wechseln Sie zur Kartenansicht, wenn Sie jede Order lieber als gestapelte Karte mit sichtbaren Bedienelementen sehen möchten. Die Kartenansicht ist auf kleinen Bildschirmen praktischer oder wenn Sie einige wenige Orders von Hand bearbeiten.", image: {"src":`${IMG}/tradovate-orders-module-2.png`,"alt":"Tradovate-Orders-Modul in der normalen Tabellenansicht mit Zeilen von Orders"} },
        { title: "Wählen Sie die sichtbaren Spalten", html: "Öffnen Sie View Settings (das Zahnrad oben rechts) und gehen Sie zu Select Columns. Ziehen Sie die gewünschten Felder von Available nach Visible und legen Sie die nicht benötigten zurück. Die Reihenfolge von oben nach unten in der Visible-Liste bestimmt die Reihenfolge von links nach rechts in Ihrem Raster. Fügen Sie dabei die Spalte Working Order button hinzu; sie platziert eine Inline-Schaltfläche Cancel neben jeder aktiven Order.", image: {"src":`${IMG}/tradovate-orders-module-3.png`,"alt":"Tradovate-Panel Select Columns mit den Listen Available und Visible"} },
        { title: "Auf Working Orders filtern", html: "Ein aktives Konto füllt die Liste mit stornierten und abgelehnten Zeilen, die Sie nicht brauchen. Aktivieren Sie Show Filters in View Settings und setzen Sie dann den Statusfilter auf Working. Jetzt sehen Sie nur noch Orders, die noch ausgeführt werden können. Ergänzen Sie bei Bedarf Filter nach Instrument oder Order-Typ, wenn Sie mehrere Symbole gleichzeitig handeln.", image: {"src":`${IMG}/tradovate-orders-module-4.png`,"alt":"Tradovate-Orders-Modul mit auf Working Orders gesetztem Statusfilter"} },
        { title: "Eine Working Order ändern", html: "Um eine ruhende Order zu ändern, erweitern Sie ihre Karte oder klicken Sie mit der rechten Maustaste auf die Zeile und wählen Sie Modify. Es öffnet sich ein kleines Popup, in dem Sie den Preis verschieben oder die Menge ändern und dann bestätigen können. So verschieben Sie einen Stop oder passen ein Limit sauber an, ohne Linien im Chart zu ziehen.", image: {"src":`${IMG}/tradovate-orders-module-5.png`,"alt":"Tradovate-Popup Modify order mit Preis- und Mengenfeldern für eine Working Order"} },
        { title: "Eine Order stornieren oder alle auf einmal löschen", html: "Soll eine Order weg? Klicken Sie mit der rechten Maustaste darauf und wählen Sie Cancel, oder nutzen Sie die Inline-Schaltfläche Cancel, falls Sie diese Spalte hinzugefügt haben. Um alles auf einmal zu löschen, storniert das Glattstellen der Position deren Working Orders in einem Zug. Achten Sie hier auf Bracket-Orders: Wenn Sie nur den Stop oder nur das Ziel entfernen, bleibt das andere Bein ohne OCO-Schutz aktiv.", image: {"src":`${IMG}/tradovate-orders-module-6.png`,"alt":"Tradovate-Rechtsklickmenü einer Order mit hervorgehobener Option Cancel"} },
      ],
    },
    { type: "heading",text: "Mit PickMyTrade automatisieren" },
    { type: "paragraph",html: "Haben Sie genug davon, Stops und Ziele von Hand zu überwachen? <strong class='text-white'>PickMyTrade leitet Ihre TradingView-Alerts direkt an Ihr Tradovate-Konto weiter</strong>, sodass Einstiege, Brackets und Ausstiege von selbst ausgelöst werden, während Sie den Chart beobachten." },
  ], es: [
    { type: "paragraph",html: "Colocar una orden es la parte fácil. Llevar el control de un montón de stops, límites y brackets activos mientras el precio corre es donde todo se complica. Para eso sirve el módulo Orders: un panel que lista todas las órdenes de la cuenta y le permite filtrar, modificar o cancelar cualquiera de ellas sin tener que buscar entre gráficos y escaleras DOM." },
    { type: "paragraph",html: "Esta guía le explica cómo configurar ese panel y usarlo para gestionar sus órdenes activas en vivo. Las etiquetas y los botones cambian un poco entre actualizaciones de la plataforma, así que, si algo difiere ligeramente de lo que ve a continuación, busque el mismo texto cerca." },
    { type: "heading",text: "Qué muestra el módulo Orders" },
    { type: "paragraph",html: "El módulo lista las órdenes en todos los estados (activas, ejecutadas, canceladas, rechazadas y suspendidas) para la cuenta y el rango de fechas que tenga seleccionados. Cada fila incluye lo esencial:" },
    { type: "table", headers: ["Columna","Qué le indica"], rows: [
      ["Time","Marca de tiempo del servidor de la acción sobre la orden"],
      ["Instrument","El contrato, p. ej., ESZ5 o MNQH6"],
      ["Side","Compra o venta"],
      ["Qty","Número de contratos"],
      ["Type","Market, limit, stop o stop-limit"],
      ["Price","El nivel de límite, stop u objetivo"],
      ["Status","Working, filled, canceled, rejected o suspended"],
      ["Account","A qué cuenta pertenece la orden"],
    ] },
    { type: "paragraph",html: "«Working» significa que la orden está activa en el mercado y todavía puede ejecutarse. Son las que ocuparán la mayor parte de su tiempo aquí." },
    { type: "heading",text: "Configure y gestione sus órdenes activas" },
    {
      type: "steps",
      items: [
        { title: "Añada el módulo Orders a su espacio de trabajo", html: "Abra el menú New, el icono de más en la esquina superior izquierda, y elija Orders. El panel aparece en su espacio de trabajo como una tarjeta propia. Si ya hay un módulo abierto, puede añadir un segundo y filtrarlo de otra forma, lo cual resulta útil cuando quiere mantener las órdenes activas separadas de su historial de ejecuciones.", image: {"src":`${IMG}/tradovate-orders-module-1.png`,"alt":"Menú New de Tradovate abierto en la esquina superior izquierda con la opción Orders resaltada"} },
        { title: "Cambie entre la vista de tabla y la de tarjetas", html: "De forma predeterminada el módulo se abre en una vista de tabla estándar, con una columna por campo, ideal para recorrer y filtrar una lista larga. Cambie a la vista de tarjetas cuando prefiera ver cada orden como una tarjeta apilada con sus controles a la vista. La vista de tarjetas es más cómoda en una pantalla pequeña o cuando gestiona a mano unas pocas órdenes.", image: {"src":`${IMG}/tradovate-orders-module-2.png`,"alt":"Módulo Orders de Tradovate en la vista de tabla estándar con filas de órdenes"} },
        { title: "Elija qué columnas ver", html: "Abra View Settings, el engranaje de la esquina superior derecha, y vaya a Select Columns. Arrastre los campos que le interesen de Available a Visible y devuelva los que no necesite. El orden de arriba abajo en la lista Visible determina el orden de izquierda a derecha en su cuadrícula. Mientras está ahí, añada la columna Working Order button; coloca un botón Cancel en línea junto a cada orden activa.", image: {"src":`${IMG}/tradovate-orders-module-3.png`,"alt":"Panel Select Columns de Tradovate con las listas Available y Visible"} },
        { title: "Filtre solo las órdenes activas", html: "Una cuenta con mucha actividad llena la lista de filas canceladas y rechazadas que no necesita. Active Show Filters en View Settings y luego ajuste el filtro de estado a Working. Ahora solo ve las órdenes que aún pueden ejecutarse. Añada también filtros por instrumento o tipo de orden si trabaja con varios símbolos a la vez.", image: {"src":`${IMG}/tradovate-orders-module-4.png`,"alt":"Filtro de estado del módulo Orders de Tradovate ajustado solo a órdenes Working"} },
        { title: "Modifique una orden activa", html: "Para cambiar una orden pendiente, expanda su tarjeta o haga clic con el botón derecho en la fila y elija Modify. Se abre una pequeña ventana donde puede mover el precio o cambiar la cantidad y luego confirmar. Es la forma limpia de ajustar un stop o recolocar un límite sin arrastrar líneas por el gráfico.", image: {"src":`${IMG}/tradovate-orders-module-5.png`,"alt":"Ventana Modify order de Tradovate con los campos de precio y cantidad de una orden activa"} },
        { title: "Cancele una orden o límpielas todas", html: "¿Necesita eliminar una orden? Haga clic con el botón derecho y elija Cancel, o use el botón Cancel en línea si añadió esa columna. Para limpiarlo todo de una vez, cerrar la posición cancela sus órdenes activas en el mismo movimiento. Tenga cuidado con las órdenes bracket: si retira solo el stop o solo el objetivo, el otro tramo queda activo sin la protección OCO.", image: {"src":`${IMG}/tradovate-orders-module-6.png`,"alt":"Menú contextual de una orden en Tradovate con la opción Cancel resaltada"} },
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "¿Cansado de vigilar stops y objetivos a mano? <strong class='text-white'>PickMyTrade envía sus alertas de TradingView directamente a su cuenta de Tradovate</strong>, de modo que las entradas, los brackets y las salidas se ejecutan solos mientras usted observa el gráfico." },
  ], fr: [
    { type: "paragraph",html: "Passer un ordre est la partie facile. Suivre une pile de stops, de limites et de brackets actifs pendant que le prix s'emballe, c'est là que tout se complique. C'est à cela que sert le module Orders : un panneau qui liste chaque ordre du compte et vous permet de filtrer, modifier ou annuler n'importe lequel d'entre eux sans fouiller entre les graphiques et les échelles DOM." },
    { type: "paragraph",html: "Ce guide vous explique comment configurer ce panneau et l'utiliser pour gérer vos ordres actifs en direct. Les libellés et les boutons changent un peu d'une mise à jour de la plateforme à l'autre ; si un élément diffère légèrement de ce que vous voyez ci-dessous, cherchez le même texte à proximité." },
    { type: "heading",text: "Ce que le module Orders affiche" },
    { type: "paragraph",html: "Le module liste les ordres dans tous leurs états (actifs, exécutés, annulés, rejetés et suspendus) pour le compte et la période sélectionnés. Chaque ligne contient l'essentiel :" },
    { type: "table", headers: ["Colonne","Ce qu'elle vous indique"], rows: [
      ["Time","Horodatage serveur de l'action sur l'ordre"],
      ["Instrument","Le contrat, p. ex. ESZ5 ou MNQH6"],
      ["Side","Achat ou vente"],
      ["Qty","Nombre de contrats"],
      ["Type","Market, limit, stop ou stop-limit"],
      ["Price","Le niveau de limite, de stop ou d'objectif"],
      ["Status","Working, filled, canceled, rejected ou suspended"],
      ["Account","Le compte auquel appartient l'ordre"],
    ] },
    { type: "paragraph",html: "« Working » signifie que l'ordre est actif sur le marché et peut encore être exécuté. Ce sont ceux sur lesquels vous passerez le plus de temps ici." },
    { type: "heading",text: "Configurez et gérez vos ordres actifs" },
    {
      type: "steps",
      items: [
        { title: "Ajoutez le module Orders à votre espace de travail", html: "Ouvrez le menu New, l'icône plus dans le coin supérieur gauche, et choisissez Orders. Le panneau s'insère dans votre espace de travail sous forme de carte. Si un module est déjà ouvert, vous pouvez en ajouter un second et le filtrer différemment, ce qui est pratique pour séparer les ordres actifs de votre historique d'exécutions.", image: {"src":`${IMG}/tradovate-orders-module-1.png`,"alt":"Menu New de Tradovate ouvert dans le coin supérieur gauche avec l'option Orders en surbrillance"} },
        { title: "Basculez entre la vue tableau et la vue cartes", html: "Par défaut, le module s'ouvre en vue tableau standard, une colonne par champ, idéale pour parcourir et filtrer une longue liste. Passez en vue cartes si vous préférez voir chaque ordre sous forme de carte empilée avec ses commandes visibles. La vue cartes est plus confortable sur un petit écran ou lorsque vous gérez quelques ordres à la main.", image: {"src":`${IMG}/tradovate-orders-module-2.png`,"alt":"Module Orders de Tradovate en vue tableau standard avec des lignes d'ordres"} },
        { title: "Choisissez les colonnes affichées", html: "Ouvrez View Settings, la roue dentée en haut à droite, puis allez dans Select Columns. Faites glisser les champs qui vous intéressent de Available vers Visible, et remettez les autres. L'ordre de haut en bas dans la liste Visible détermine l'ordre de gauche à droite dans votre grille. Pendant que vous y êtes, ajoutez la colonne Working Order button ; elle place un bouton Cancel en ligne à côté de chaque ordre actif.", image: {"src":`${IMG}/tradovate-orders-module-3.png`,"alt":"Panneau Select Columns de Tradovate avec les listes Available et Visible"} },
        { title: "Filtrez pour ne garder que les ordres actifs", html: "Un compte très actif remplit la liste de lignes annulées et rejetées dont vous n'avez pas besoin. Activez Show Filters depuis View Settings, puis réglez le filtre de statut sur Working. Vous ne voyez plus que les ordres qui peuvent encore être exécutés. Ajoutez aussi des filtres par instrument ou par type d'ordre si vous jonglez avec plusieurs symboles à la fois.", image: {"src":`${IMG}/tradovate-orders-module-4.png`,"alt":"Filtre de statut du module Orders de Tradovate réglé sur les ordres Working uniquement"} },
        { title: "Modifiez un ordre actif", html: "Pour changer un ordre en attente, développez sa carte ou faites un clic droit sur la ligne et choisissez Modify. Une petite fenêtre s'ouvre, dans laquelle vous pouvez déplacer le prix ou changer la quantité, puis confirmer. C'est la manière propre d'ajuster un stop ou de repositionner une limite sans faire glisser des lignes sur un graphique.", image: {"src":`${IMG}/tradovate-orders-module-5.png`,"alt":"Fenêtre Modify order de Tradovate avec les champs prix et quantité d'un ordre actif"} },
        { title: "Annulez un ordre ou effacez-les tous", html: "Besoin de supprimer un ordre ? Faites un clic droit dessus et choisissez Cancel, ou utilisez le bouton Cancel en ligne si vous avez ajouté cette colonne. Pour tout effacer d'un coup, clôturer la position annule ses ordres actifs dans le même geste. Attention aux ordres bracket : retirer uniquement le stop ou uniquement l'objectif laisse l'autre jambe active sans protection OCO.", image: {"src":`${IMG}/tradovate-orders-module-6.png`,"alt":"Menu contextuel d'un ordre Tradovate avec l'option Cancel en surbrillance"} },
      ],
    },
    { type: "heading",text: "Automatisez tout cela avec PickMyTrade" },
    { type: "paragraph",html: "Fatigué de surveiller vos stops et vos objectifs à la main ? <strong class='text-white'>PickMyTrade achemine vos alertes TradingView directement vers votre compte Tradovate</strong>, de sorte que les entrées, les brackets et les sorties se déclenchent seuls pendant que vous regardez le graphique." },
  ], it: [
    { type: "paragraph",html: "Piazzare un ordine è la parte facile. Tenere traccia di una pila di stop, limit e bracket attivi mentre il prezzo corre è il punto in cui tutto si complica. Ecco a cosa serve il modulo Orders: un pannello che elenca ogni ordine del conto e Le consente di filtrare, modificare o annullare qualsiasi ordine senza cercare tra grafici e DOM ladder." },
    { type: "paragraph",html: "Questa guida illustra come configurare quel pannello e usarlo per gestire i Suoi ordini attivi dal vivo. Etichette e pulsanti cambiano un po' tra un aggiornamento della piattaforma e l'altro: se qualcosa risulta leggermente diverso da quanto vede qui sotto, cerchi la stessa dicitura nelle vicinanze." },
    { type: "heading",text: "Cosa mostra il modulo Orders" },
    { type: "paragraph",html: "Il modulo elenca gli ordini in ogni stato (attivi, eseguiti, annullati, rifiutati e sospesi) per il conto e l'intervallo di date selezionati. Ogni riga riporta l'essenziale:" },
    { type: "table", headers: ["Colonna","Cosa Le indica"], rows: [
      ["Time","Timestamp del server dell'azione sull'ordine"],
      ["Instrument","Il contratto, ad es. ESZ5 o MNQH6"],
      ["Side","Acquisto o vendita"],
      ["Qty","Numero di contratti"],
      ["Type","Market, limit, stop o stop-limit"],
      ["Price","Il livello di limite, stop o target"],
      ["Status","Working, filled, canceled, rejected o suspended"],
      ["Account","A quale conto appartiene l'ordine"],
    ] },
    { type: "paragraph",html: "«Working» significa che l'ordine è attivo sul mercato e può ancora essere eseguito. Sono quelli su cui trascorrerà la maggior parte del tempo qui." },
    { type: "heading",text: "Configuri e gestisca i Suoi ordini attivi" },
    {
      type: "steps",
      items: [
        { title: "Aggiunga il modulo Orders al Suo workspace", html: "Apra il menu New, l'icona più nell'angolo in alto a sinistra, e scelga Orders. Il pannello compare nel Suo workspace come scheda a sé stante. Se è già aperto un modulo, può aggiungerne un secondo e filtrarlo in modo diverso, utile quando vuole tenere gli ordini attivi separati dalla cronologia delle esecuzioni.", image: {"src":`${IMG}/tradovate-orders-module-1.png`,"alt":"Menu New di Tradovate aperto nell'angolo in alto a sinistra con l'opzione Orders evidenziata"} },
        { title: "Passi dalla vista tabella alla vista a schede", html: "Per impostazione predefinita il modulo si apre in una vista tabella standard, una colonna per campo, ideale per scorrere e filtrare un elenco lungo. Passi alla vista a schede quando preferisce vedere ogni ordine come una scheda impilata con i controlli in evidenza. La vista a schede è più comoda su uno schermo piccolo o quando gestisce a mano pochi ordini.", image: {"src":`${IMG}/tradovate-orders-module-2.png`,"alt":"Modulo Orders di Tradovate in vista tabella standard con righe di ordini"} },
        { title: "Scelga quali colonne visualizzare", html: "Apra View Settings, l'ingranaggio in alto a destra, e vada su Select Columns. Trascini i campi che Le interessano da Available a Visible e rimetta a posto quelli che non Le servono. L'ordine dall'alto in basso nell'elenco Visible stabilisce l'ordine da sinistra a destra nella Sua griglia. Già che c'è, aggiunga la colonna Working Order button: inserisce un pulsante Cancel in linea accanto a ogni ordine attivo.", image: {"src":`${IMG}/tradovate-orders-module-3.png`,"alt":"Pannello Select Columns di Tradovate con gli elenchi Available e Visible"} },
        { title: "Filtri solo gli ordini attivi", html: "Un conto molto attivo riempie l'elenco di righe annullate e rifiutate che non Le servono. Attivi Show Filters da View Settings, poi imposti il filtro di stato su Working. Ora vede solo gli ordini che possono ancora essere eseguiti. Aggiunga anche filtri per strumento o tipo di ordine se opera su più simboli contemporaneamente.", image: {"src":`${IMG}/tradovate-orders-module-4.png`,"alt":"Filtro di stato del modulo Orders di Tradovate impostato solo sugli ordini Working"} },
        { title: "Modifichi un ordine attivo", html: "Per cambiare un ordine in attesa, espanda la sua scheda oppure faccia clic con il tasto destro sulla riga e scelga Modify. Si apre un piccolo popup in cui può spostare il prezzo o cambiare la quantità, quindi confermare. È il modo pulito per ritoccare uno stop o riposizionare un limit senza trascinare linee sul grafico.", image: {"src":`${IMG}/tradovate-orders-module-5.png`,"alt":"Popup Modify order di Tradovate con i campi prezzo e quantità di un ordine attivo"} },
        { title: "Annulli un ordine o li cancelli tutti", html: "Vuole eliminare un ordine? Faccia clic con il tasto destro e scelga Cancel, oppure usi il pulsante Cancel in linea se ha aggiunto quella colonna. Per cancellare tutto in una volta, chiudere la posizione annulla i suoi ordini attivi nella stessa mossa. Faccia attenzione agli ordini bracket: rimuovendo solo lo stop o solo il target, l'altra gamba resta attiva senza la protezione OCO.", image: {"src":`${IMG}/tradovate-orders-module-6.png`,"alt":"Menu contestuale di un ordine Tradovate con l'opzione Cancel evidenziata"} },
      ],
    },
    { type: "heading",text: "Automatizzi tutto questo con PickMyTrade" },
    { type: "paragraph",html: "Stanco di sorvegliare stop e target a mano? <strong class='text-white'>PickMyTrade instrada i Suoi alert di TradingView direttamente al Suo conto Tradovate</strong>, così ingressi, bracket e uscite scattano da soli mentre Lei osserva il grafico." },
  ] },
  ctaHeading: { en: "Stop Babysitting Your Orders", de: "Schluss mit dem Orders-Babysitting", es: "Deje de vigilar sus órdenes", fr: "Arrêtez de surveiller vos ordres", it: "Smetta di sorvegliare i Suoi ordini" },
  ctaText: { en: "PickMyTrade routes your TradingView alerts straight to your Tradovate account, so entries, brackets, and exits fire on their own while you watch the chart.", de: "PickMyTrade leitet Ihre TradingView-Alerts direkt an Ihr Tradovate-Konto weiter, sodass Einstiege, Brackets und Ausstiege von selbst ausgelöst werden, während Sie den Chart beobachten.", es: "PickMyTrade envía sus alertas de TradingView directamente a su cuenta de Tradovate, de modo que las entradas, los brackets y las salidas se ejecutan solos mientras usted observa el gráfico.", fr: "PickMyTrade achemine vos alertes TradingView directement vers votre compte Tradovate, de sorte que les entrées, les brackets et les sorties se déclenchent seuls pendant que vous regardez le graphique.", it: "PickMyTrade instrada i Suoi alert di TradingView direttamente al Suo conto Tradovate, così ingressi, bracket e uscite scattano da soli mentre Lei osserva il grafico." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
