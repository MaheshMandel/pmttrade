---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-charting-basics";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Tradovate Charting Basics: Open & Use Advanced Charts";
const META_DESCRIPTION =
  "Tradovate charting basics made easy: open the Chart module, switch timeframes and chart styles, and add indicators to read futures price action fast.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate-Charting-Grundlagen: Advanced Charts öffnen und nutzen", es: "Conceptos básicos de gráficos en Tradovate: abrir y usar gráficos avanzados", fr: "Les bases du charting Tradovate : ouvrir et utiliser les graphiques avancés", it: "Le basi del charting in Tradovate: aprire e usare i grafici avanzati" },
  dek: { en: "Before you click buy or sell, you need to actually read the price action. This guide walks you through the essentials in Tradovate, opening the Chart module and dialing in your timeframes, styles, and indicators one step at a time.", de: "Bevor Sie auf Kaufen oder Verkaufen klicken, müssen Sie die Kursbewegung tatsächlich lesen können. Dieser Leitfaden führt Sie durch die Grundlagen in Tradovate: das Chart-Modul öffnen und Zeitrahmen, Stile und Indikatoren Schritt für Schritt einrichten.", es: "Antes de hacer clic en comprar o vender, necesita leer realmente la acción del precio. Esta guía le explica lo esencial en Tradovate: abrir el módulo Chart y configurar paso a paso sus marcos temporales, estilos e indicadores.", fr: "Avant de cliquer sur acheter ou vendre, vous devez réellement savoir lire l'action des prix. Ce guide vous présente l'essentiel dans Tradovate : ouvrir le module Chart et régler vos unités de temps, styles et indicateurs étape par étape.", it: "Prima di cliccare su compra o vendi, deve saper leggere davvero la price action. Questa guida Le illustra l'essenziale in Tradovate: aprire il modulo Chart e impostare passo dopo passo timeframe, stili e indicatori." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Before you click buy or sell, you need to actually read the price action. Whether you're scalping ES, pressure-testing a new setup, or wiring up automation with PickMyTrade, it starts on the chart. This guide walks you through the essentials in Tradovate, opening the Chart module and dialing in your timeframes, styles, and indicators one step at a time." },
    { type: "heading", text: "What Is Advanced Charting in Tradovate?" },
    { type: "paragraph", html: "Advanced Charting comes baked into the Tradovate web, desktop, and mobile apps at no extra cost, you're not bolting on a separate charting service. You get the full spread of chart styles (candlestick, bar, Heiken-Ashi, Renko, Point & Figure, and more), volume tools, and 40+ built-in indicators, which is plenty for reading futures. A chart opens as a module inside your workspace, and you can stack as many as your screen will hold." },
    { type: "heading", text: "Opening Tradovate Charts: Step by Step" },
    {
      type: "steps",
      items: [
        { title: "Add a Chart Module to Your Workspace", html: "In the Tradovate web app, click the <strong class='text-white'>+ (New)</strong> button in the top-left corner of the screen. Then grab the <strong class='text-white'>Chart</strong> module and drag it into your workspace, dropping it wherever you want it to live." },
        { title: "Load a Contract Symbol", html: "Click into the chart's <strong class='text-white'>search bar</strong> and start typing a symbol or product name, say <code>ES</code> or \"E-mini S&P.\" Tradovate's smart search surfaces matching contracts as you type, so you just pick the front-month contract you want on screen." },
        { title: "Change the Timeframe (Interval)", html: "Hover over the chart and click the <strong class='text-white'>interval</strong> button in the top toolbar to open the Interval dropdown. Pick one of the minute presets, 1, 5, 15, 30, or 60, or hit <strong class='text-white'>Custom</strong> if you want to build your own interval." },
        { title: "Switch the Chart Style", html: "Hover over the chart and click the <strong class='text-white'>Chart Style</strong> button at the top of the module. You've got eight styles to choose from: Candlesticks (the default), OHLC, Line on Close, Bid-Ask Volume, Heiken-Ashi, Renko, Point & Figure, and TPO (Footprint). Some styles need a little tuning, for Point & Figure, open <strong class='text-white'>Configure Chart Elements</strong> to set your box size and reversal." },
        { title: "Add and Configure Indicators", html: "Hover over the chart and click the <strong class='text-white'>Indicators</strong> icon on the toolbar. Search the list, 40+ built-ins, plus community customs, and click one to drop it on the chart. Use the settings gear to tweak its properties and <strong class='text-white'>Save</strong>. Want it out of the way? Hide any indicator with the eye icon, or wipe it entirely with the trash icon." },
      ],
    },
    { type: "heading", text: "Why You'd Need This" },
    {
      type: "list",
      items: [
        "Read live futures price action before you enter from the chart or the DOM.",
        "Compare timeframes, a 1-minute for entries, something higher for the trend.",
        "Try styles like Renko or Heiken-Ashi to strip out the noise.",
        "Layer on indicators, moving averages, VWAP, volume, that fit your setup.",
        "Build a clean chart you can trade from directly or feed into automation.",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Reading the chart is the easy part. Acting on it fast, before the move gets away from you, is where most traders lose ground. <strong class='text-white'>PickMyTrade wires your TradingView alerts straight into your Tradovate account</strong>, so the setups you spot on the chart fire as real orders automatically. No scramble, no manual clicks." },
  ], de: [
    { type: "paragraph",html: "Bevor Sie auf Kaufen oder Verkaufen klicken, müssen Sie die Kursbewegung tatsächlich lesen können. Ob Sie ES scalpen, ein neues Setup auf die Probe stellen oder Automatisierung mit PickMyTrade einrichten: Alles beginnt im Chart. Dieser Leitfaden führt Sie durch die Grundlagen in Tradovate: das Chart-Modul öffnen und Zeitrahmen, Stile und Indikatoren Schritt für Schritt einrichten." },
    { type: "heading",text: "Was ist Advanced Charting in Tradovate?" },
    { type: "paragraph",html: "Advanced Charting ist in die Tradovate-Web-, Desktop- und Mobil-Apps ohne Zusatzkosten integriert, Sie müssen also keinen separaten Charting-Dienst anbinden. Sie erhalten die gesamte Auswahl an Chart-Stilen (Candlestick, Balken, Heiken-Ashi, Renko, Point & Figure und mehr), Volumen-Tools und über 40 integrierte Indikatoren, was zum Lesen von Futures völlig ausreicht. Ein Chart öffnet sich als Modul in Ihrem Workspace, und Sie können so viele stapeln, wie Ihr Bildschirm fasst." },
    { type: "heading",text: "Tradovate-Charts öffnen: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Ein Chart-Modul zu Ihrem Workspace hinzufügen", html: "Klicken Sie in der Tradovate-Web-App oben links auf dem Bildschirm auf die Schaltfläche <strong class='text-white'>+ (New)</strong>. Greifen Sie dann das Modul <strong class='text-white'>Chart</strong> und ziehen Sie es in Ihren Workspace, wo immer es liegen soll." },
        { title: "Ein Kontraktsymbol laden", html: "Klicken Sie in die <strong class='text-white'>Suchleiste</strong> des Charts und beginnen Sie, ein Symbol oder einen Produktnamen einzugeben, etwa <code>ES</code> oder \"E-mini S&P\". Die intelligente Suche von Tradovate zeigt passende Kontrakte schon während der Eingabe an, sodass Sie nur noch den gewünschten Frontmonats-Kontrakt auswählen." },
        { title: "Den Zeitrahmen (Intervall) ändern", html: "Fahren Sie über den Chart und klicken Sie in der oberen Symbolleiste auf die Schaltfläche <strong class='text-white'>Interval</strong>, um das Intervall-Dropdown zu öffnen. Wählen Sie eine der Minuten-Voreinstellungen, 1, 5, 15, 30 oder 60, oder klicken Sie auf <strong class='text-white'>Custom</strong>, wenn Sie ein eigenes Intervall erstellen möchten." },
        { title: "Den Chart-Stil wechseln", html: "Fahren Sie über den Chart und klicken Sie oben im Modul auf die Schaltfläche <strong class='text-white'>Chart Style</strong>. Sie haben acht Stile zur Auswahl: Candlesticks (Standard), OHLC, Line on Close, Bid-Ask Volume, Heiken-Ashi, Renko, Point & Figure und TPO (Footprint). Einige Stile brauchen etwas Feinabstimmung: Öffnen Sie bei Point & Figure <strong class='text-white'>Configure Chart Elements</strong>, um Boxgröße und Umkehr festzulegen." },
        { title: "Indikatoren hinzufügen und konfigurieren", html: "Fahren Sie über den Chart und klicken Sie in der Symbolleiste auf das Symbol <strong class='text-white'>Indicators</strong>. Durchsuchen Sie die Liste, über 40 integrierte plus Community-Indikatoren, und klicken Sie auf einen, um ihn im Chart zu platzieren. Passen Sie seine Eigenschaften über das Zahnrad an und klicken Sie auf <strong class='text-white'>Save</strong>. Soll er aus dem Weg? Blenden Sie jeden Indikator mit dem Augensymbol aus oder entfernen Sie ihn ganz mit dem Papierkorbsymbol." },
      ],
    },
    { type: "heading",text: "Warum Sie das brauchen" },
    {
      type: "list",
      items: [
        "Lesen Sie die Live-Kursbewegung bei Futures, bevor Sie aus dem Chart oder dem DOM einsteigen.",
        "Vergleichen Sie Zeitrahmen: 1 Minute für Einstiege, etwas Höheres für den Trend.",
        "Probieren Sie Stile wie Renko oder Heiken-Ashi aus, um das Rauschen herauszufiltern.",
        "Legen Sie Indikatoren darüber, etwa gleitende Durchschnitte, VWAP und Volumen, die zu Ihrem Setup passen.",
        "Bauen Sie einen übersichtlichen Chart, aus dem Sie direkt handeln oder den Sie in die Automatisierung einspeisen können.",
      ],
    },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "Den Chart zu lesen ist der leichte Teil. Schnell darauf zu reagieren, bevor die Bewegung davonläuft, ist dort, wo die meisten Trader Boden verlieren. <strong class='text-white'>PickMyTrade verbindet Ihre TradingView-Alerts direkt mit Ihrem Tradovate-Konto</strong>, sodass die Setups, die Sie im Chart entdecken, automatisch als echte Orders ausgelöst werden. Keine Hektik, keine manuellen Klicks." },
  ], es: [
    { type: "paragraph",html: "Antes de hacer clic en comprar o vender, necesita leer realmente la acción del precio. Ya sea que haga scalping en ES, ponga a prueba una nueva configuración o configure la automatización con PickMyTrade, todo empieza en el gráfico. Esta guía le explica lo esencial en Tradovate: abrir el módulo Chart y configurar paso a paso sus marcos temporales, estilos e indicadores." },
    { type: "heading",text: "¿Qué son los gráficos avanzados en Tradovate?" },
    { type: "paragraph",html: "Los gráficos avanzados vienen integrados en las aplicaciones web, de escritorio y móvil de Tradovate sin coste adicional; no tiene que añadir un servicio de gráficos aparte. Dispone de toda la gama de estilos de gráfico (velas, barras, Heiken-Ashi, Renko, Point & Figure y más), herramientas de volumen y más de 40 indicadores integrados, lo que es más que suficiente para leer futuros. Un gráfico se abre como un módulo dentro de su espacio de trabajo y puede apilar tantos como quepan en su pantalla." },
    { type: "heading",text: "Abrir los gráficos de Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Añada un módulo Chart a su espacio de trabajo", html: "En la aplicación web de Tradovate, haga clic en el botón <strong class='text-white'>+ (New)</strong> de la esquina superior izquierda de la pantalla. Luego tome el módulo <strong class='text-white'>Chart</strong> y arrástrelo a su espacio de trabajo, soltándolo donde quiera que viva." },
        { title: "Cargue el símbolo de un contrato", html: "Haga clic en la <strong class='text-white'>barra de búsqueda</strong> del gráfico y empiece a escribir un símbolo o el nombre de un producto, por ejemplo <code>ES</code> o \"E-mini S&P\". La búsqueda inteligente de Tradovate muestra los contratos coincidentes mientras escribe, de modo que solo tiene que elegir el contrato del mes más cercano que desea ver en pantalla." },
        { title: "Cambie el marco temporal (intervalo)", html: "Pase el cursor sobre el gráfico y haga clic en el botón de <strong class='text-white'>Interval</strong> de la barra de herramientas superior para abrir el menú desplegable de intervalos. Elija uno de los preajustes de minutos, 1, 5, 15, 30 o 60, o pulse <strong class='text-white'>Custom</strong> si desea crear su propio intervalo." },
        { title: "Cambie el estilo del gráfico", html: "Pase el cursor sobre el gráfico y haga clic en el botón <strong class='text-white'>Chart Style</strong> en la parte superior del módulo. Tiene ocho estilos entre los que elegir: Candlesticks (predeterminado), OHLC, Line on Close, Bid-Ask Volume, Heiken-Ashi, Renko, Point & Figure y TPO (Footprint). Algunos estilos requieren un pequeño ajuste: para Point & Figure, abra <strong class='text-white'>Configure Chart Elements</strong> para definir el tamaño de casilla y la reversión." },
        { title: "Añada y configure indicadores", html: "Pase el cursor sobre el gráfico y haga clic en el icono <strong class='text-white'>Indicators</strong> de la barra de herramientas. Busque en la lista, más de 40 integrados más personalizados de la comunidad, y haga clic en uno para colocarlo en el gráfico. Use el engranaje de ajustes para modificar sus propiedades y pulse <strong class='text-white'>Save</strong>. ¿Quiere apartarlo? Oculte cualquier indicador con el icono del ojo o elimínelo por completo con el icono de la papelera." },
      ],
    },
    { type: "heading",text: "Por qué lo necesitará" },
    {
      type: "list",
      items: [
        "Lea la acción del precio de futuros en vivo antes de entrar desde el gráfico o desde el DOM.",
        "Compare marcos temporales: uno de 1 minuto para las entradas, uno superior para la tendencia.",
        "Pruebe estilos como Renko o Heiken-Ashi para eliminar el ruido.",
        "Añada indicadores, medias móviles, VWAP, volumen, que encajen con su configuración.",
        "Construya un gráfico limpio desde el que pueda operar directamente o que pueda alimentar la automatización.",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Leer el gráfico es la parte fácil. Actuar con rapidez, antes de que el movimiento se le escape, es donde la mayoría de los traders pierde terreno. <strong class='text-white'>PickMyTrade conecta sus alertas de TradingView directamente con su cuenta de Tradovate</strong>, de modo que las configuraciones que detecta en el gráfico se ejecutan como órdenes reales de forma automática. Sin prisas, sin clics manuales." },
  ], fr: [
    { type: "paragraph",html: "Avant de cliquer sur acheter ou vendre, vous devez réellement savoir lire l'action des prix. Que vous fassiez du scalping sur ES, que vous testiez une nouvelle configuration ou que vous mettiez en place l'automatisation avec PickMyTrade, tout commence sur le graphique. Ce guide vous présente l'essentiel dans Tradovate : ouvrir le module Chart et régler vos unités de temps, styles et indicateurs étape par étape." },
    { type: "heading",text: "Qu'est-ce que le charting avancé dans Tradovate ?" },
    { type: "paragraph",html: "Le charting avancé est intégré sans frais supplémentaires aux applications web, de bureau et mobile de Tradovate ; vous n'avez donc pas à greffer un service de graphiques distinct. Vous disposez de toute la gamme de styles de graphique (chandeliers, barres, Heiken-Ashi, Renko, Point & Figure, etc.), d'outils de volume et de plus de 40 indicateurs intégrés, ce qui est largement suffisant pour lire les futures. Un graphique s'ouvre comme un module dans votre espace de travail, et vous pouvez en empiler autant que votre écran peut en contenir." },
    { type: "heading",text: "Ouvrir les graphiques Tradovate : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ajouter un module Chart à votre espace de travail", html: "Dans l'application web Tradovate, cliquez sur le bouton <strong class='text-white'>+ (New)</strong> dans le coin supérieur gauche de l'écran. Saisissez ensuite le module <strong class='text-white'>Chart</strong> et faites-le glisser dans votre espace de travail, en le déposant là où vous voulez qu'il se trouve." },
        { title: "Charger le symbole d'un contrat", html: "Cliquez dans la <strong class='text-white'>barre de recherche</strong> du graphique et commencez à saisir un symbole ou un nom de produit, par exemple <code>ES</code> ou \"E-mini S&P\". La recherche intelligente de Tradovate affiche les contrats correspondants au fil de la saisie ; il vous suffit de choisir le contrat du mois le plus proche que vous voulez afficher." },
        { title: "Modifier l'unité de temps (intervalle)", html: "Survolez le graphique et cliquez sur le bouton <strong class='text-white'>Interval</strong> de la barre d'outils supérieure pour ouvrir la liste déroulante des intervalles. Choisissez l'un des préréglages en minutes, 1, 5, 15, 30 ou 60, ou cliquez sur <strong class='text-white'>Custom</strong> si vous souhaitez créer votre propre intervalle." },
        { title: "Changer le style du graphique", html: "Survolez le graphique et cliquez sur le bouton <strong class='text-white'>Chart Style</strong> en haut du module. Vous avez le choix entre huit styles : Candlesticks (par défaut), OHLC, Line on Close, Bid-Ask Volume, Heiken-Ashi, Renko, Point & Figure et TPO (Footprint). Certains styles demandent un petit réglage : pour Point & Figure, ouvrez <strong class='text-white'>Configure Chart Elements</strong> afin de définir la taille de case et le renversement." },
        { title: "Ajouter et configurer des indicateurs", html: "Survolez le graphique et cliquez sur l'icône <strong class='text-white'>Indicators</strong> de la barre d'outils. Parcourez la liste, plus de 40 indicateurs intégrés ainsi que des personnalisés de la communauté, et cliquez sur l'un d'eux pour le déposer sur le graphique. Utilisez la roue dentée pour modifier ses propriétés, puis cliquez sur <strong class='text-white'>Save</strong>. Vous voulez le mettre de côté ? Masquez n'importe quel indicateur avec l'icône en forme d'œil, ou supprimez-le complètement avec l'icône de la corbeille." },
      ],
    },
    { type: "heading",text: "Pourquoi vous en avez besoin" },
    {
      type: "list",
      items: [
        "Lisez l'action des prix des futures en direct avant d'entrer depuis le graphique ou le DOM.",
        "Comparez les unités de temps : 1 minute pour les entrées, une unité supérieure pour la tendance.",
        "Essayez des styles comme Renko ou Heiken-Ashi pour éliminer le bruit.",
        "Ajoutez des indicateurs, moyennes mobiles, VWAP, volume, adaptés à votre configuration.",
        "Construisez un graphique épuré depuis lequel vous pouvez trader directement ou alimenter l'automatisation.",
      ],
    },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Lire le graphique est la partie facile. Agir rapidement, avant que le mouvement ne vous échappe, est ce qui fait perdre du terrain à la plupart des traders. <strong class='text-white'>PickMyTrade relie vos alertes TradingView directement à votre compte Tradovate</strong>, de sorte que les configurations que vous repérez sur le graphique se déclenchent automatiquement en ordres réels. Pas de précipitation, pas de clics manuels." },
  ], it: [
    { type: "paragraph",html: "Prima di cliccare su compra o vendi, deve saper leggere davvero la price action. Che faccia scalping su ES, metta alla prova un nuovo setup o configuri l'automazione con PickMyTrade, tutto parte dal grafico. Questa guida Le illustra l'essenziale in Tradovate: aprire il modulo Chart e impostare passo dopo passo timeframe, stili e indicatori." },
    { type: "heading",text: "Che cos'è il charting avanzato in Tradovate?" },
    { type: "paragraph",html: "Il charting avanzato è integrato nelle app web, desktop e mobile di Tradovate senza costi aggiuntivi: non deve aggiungere un servizio di grafici separato. Ha a disposizione l'intera gamma di stili di grafico (candele, barre, Heiken-Ashi, Renko, Point & Figure e altri), strumenti di volume e oltre 40 indicatori integrati, più che sufficienti per leggere i futures. Un grafico si apre come modulo nel Suo workspace, e può impilarne tutti quelli che il Suo schermo riesce a contenere." },
    { type: "heading",text: "Aprire i grafici di Tradovate: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Aggiungere un modulo Chart al Suo workspace", html: "Nell'app web di Tradovate, clicchi sul pulsante <strong class='text-white'>+ (New)</strong> nell'angolo in alto a sinistra dello schermo. Poi prenda il modulo <strong class='text-white'>Chart</strong> e lo trascini nel Suo workspace, rilasciandolo dove preferisce." },
        { title: "Caricare il simbolo di un contratto", html: "Clicchi nella <strong class='text-white'>barra di ricerca</strong> del grafico e inizi a digitare un simbolo o il nome di un prodotto, ad esempio <code>ES</code> o \"E-mini S&P\". La ricerca intelligente di Tradovate mostra i contratti corrispondenti mentre digita, quindi deve solo scegliere il contratto del mese più vicino che vuole visualizzare." },
        { title: "Cambiare il timeframe (intervallo)", html: "Passi il mouse sul grafico e clicchi sul pulsante <strong class='text-white'>Interval</strong> nella barra degli strumenti superiore per aprire il menu a discesa dell'intervallo. Scelga uno dei preset in minuti, 1, 5, 15, 30 o 60, oppure clicchi su <strong class='text-white'>Custom</strong> se vuole creare un intervallo personalizzato." },
        { title: "Cambiare lo stile del grafico", html: "Passi il mouse sul grafico e clicchi sul pulsante <strong class='text-white'>Chart Style</strong> in alto nel modulo. Ha a disposizione otto stili: Candlesticks (predefinito), OHLC, Line on Close, Bid-Ask Volume, Heiken-Ashi, Renko, Point & Figure e TPO (Footprint). Alcuni stili richiedono una piccola messa a punto: per Point & Figure, apra <strong class='text-white'>Configure Chart Elements</strong> per impostare la dimensione del box e l'inversione." },
        { title: "Aggiungere e configurare gli indicatori", html: "Passi il mouse sul grafico e clicchi sull'icona <strong class='text-white'>Indicators</strong> nella barra degli strumenti. Cerchi nell'elenco, oltre 40 integrati più quelli personalizzati della community, e clicchi su uno per inserirlo nel grafico. Usi l'ingranaggio delle impostazioni per modificarne le proprietà e clicchi su <strong class='text-white'>Save</strong>. Vuole toglierlo di mezzo? Nasconda qualsiasi indicatore con l'icona dell'occhio, oppure lo elimini del tutto con l'icona del cestino." },
      ],
    },
    { type: "heading",text: "Perché Le serve" },
    {
      type: "list",
      items: [
        "Legga la price action dei futures in tempo reale prima di entrare dal grafico o dal DOM.",
        "Confronti i timeframe: un 1 minuto per gli ingressi, uno più alto per il trend.",
        "Provi stili come Renko o Heiken-Ashi per eliminare il rumore.",
        "Aggiunga indicatori, medie mobili, VWAP, volume, adatti al Suo setup.",
        "Costruisca un grafico pulito da cui fare trading direttamente o da collegare all'automazione.",
      ],
    },
    { type: "heading",text: "Automatizzi tutto questo con PickMyTrade" },
    { type: "paragraph",html: "Leggere il grafico è la parte facile. Agire in fretta, prima che il movimento Le sfugga, è dove la maggior parte dei trader perde terreno. <strong class='text-white'>PickMyTrade collega i Suoi alert di TradingView direttamente al Suo conto Tradovate</strong>, così i setup che individua sul grafico partono automaticamente come ordini reali. Nessuna corsa, nessun clic manuale." },
  ] },
  ctaHeading: { en: "Turn Your Chart Setups Into Automatic Orders", de: "Verwandeln Sie Ihre Chart-Setups in automatische Orders", es: "Convierta sus configuraciones de gráfico en órdenes automáticas", fr: "Transformez vos configurations de graphique en ordres automatiques", it: "Trasformi i Suoi setup di grafico in ordini automatici" },
