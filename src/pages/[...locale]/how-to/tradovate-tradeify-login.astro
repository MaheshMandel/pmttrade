---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-tradeify-login";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Tradeify Tradovate Login: TRAD Username Format";
const META_DESCRIPTION =
  "Logging into Tradovate for a funded account? Use your TRAD###### username, not your email. Fix the Invalid Credentials error in four steps.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradeify-Tradovate-Login: Format des TRAD-Benutzernamens", es: "Inicio de sesión de Tradeify en Tradovate: formato del usuario TRAD", fr: "Connexion Tradeify à Tradovate : format du nom d'utilisateur TRAD", it: "Login Tradeify su Tradovate: il formato del nome utente TRAD" },
  dek: { en: "If Tradovate keeps throwing \"Invalid Credentials\" and you're sure the password is right, here's the fix nine times out of ten: you're typing your email, not your TRAD###### username.", de: "Wenn Tradovate ständig „Invalid Credentials“ meldet und Sie sicher sind, dass das Passwort stimmt, liegt es in neun von zehn Fällen daran: Sie geben Ihre E-Mail-Adresse statt Ihres TRAD######-Benutzernamens ein.", es: "Si Tradovate sigue mostrando «Invalid Credentials» y está seguro de que la contraseña es correcta, esta es la solución en nueve de cada diez casos: está escribiendo su correo electrónico, no su nombre de usuario TRAD######.", fr: "Si Tradovate affiche sans cesse « Invalid Credentials » alors que vous êtes certain d'avoir le bon mot de passe, voici la solution neuf fois sur dix : vous saisissez votre e-mail, et non votre nom d'utilisateur TRAD######.", it: "Se Tradovate continua a mostrare «Invalid Credentials» e Lei è sicuro che la password sia corretta, la soluzione nove volte su dieci è questa: sta digitando la sua e-mail, non il nome utente TRAD######." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "If Tradovate keeps throwing \"Invalid Credentials\" and you're sure the password is right, here's the fix nine times out of ten: you're typing your email. A Tradeify account gives you two completely separate sets of credentials, and the trading platform only accepts one of them." },
    { type: "paragraph", html: "Your Tradovate username isn't an email at all. It's a system-generated ID that starts with <strong class='text-white'>TRAD</strong> followed by six digits, so it looks like <strong class='text-white'>TRAD123456</strong>. That, plus a password Tradeify creates for you, is what logs you into Tradovate. The email and password you use to sign in to your Tradeify dashboard won't work on the trading platform, and no amount of retyping them will." },
    { type: "heading", text: "Why Your Email Doesn't Work" },
    { type: "paragraph", html: "Think of it as two doors. One door is the Tradeify dashboard, where you manage your evaluation or funded account, view payouts, and check your progress. You open that with your email and the password you chose when you signed up. The other door is Tradovate, the actual order-entry platform. That one only opens with the TRAD###### username and the password Tradeify issues you. Both the username and that password are fixed. You can't rename them or reset them to something friendlier." },
    { type: "paragraph", html: "Mixing the two up is the single most common reason a Tradeify login fails. Once you use the right set in the right place, the error clears." },
    { type: "heading", text: "Tradeify Tradovate Login: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Copy Your Credentials From the Tradeify Dashboard", html: "Log in to your Tradeify dashboard the normal way, with your email and password. Your Tradovate <strong class='text-white'>Username</strong> and <strong class='text-white'>Password</strong> sit near the top of the account view. Use the copy button next to each field rather than retyping them. These strings are case-sensitive and often mix letters, numbers, and symbols, so a single mistyped character or a stray space is enough to trigger a rejection." },
        { title: "Open the Tradovate Login Page", html: "Head to <strong class='text-white'>trader.tradovate.com</strong> in your browser, or open the Tradovate desktop or mobile app. You'll land on the sign-in screen with fields for a username and password. This is Tradovate's own login, not a Tradeify page, which is exactly why your dashboard email gets refused here." },
        { title: "Paste the TRAD###### Username and Password", html: "Paste the TRAD###### username into the username field and the Tradeify-issued password into the password field. Pasting beats typing here for one sneaky reason: the password usually starts with a capital letter, and some browsers and apps quietly lowercase that first character when you type it or when autofill fills it in. If your login fails right after a paste, check that the first letter is still uppercase and that autocomplete didn't swap in old saved credentials." },
        { title: "Pick the Demo/Simulation Environment and Sign In", html: "This is the step most people miss. On the login screen, set the environment to <strong class='text-white'>Demo</strong> or <strong class='text-white'>Simulation</strong>, not <strong class='text-white'>Live</strong>. Evaluation and funded prop accounts run on the simulated environment even after you pass, so choosing \"Live\" hands you an \"Invalid Credentials\" error even when the username and password are perfect. On your very first login you'll also be asked to accept a non-professional market data agreement. Sign it, and your account and charts will load." },
      ],
    },
    { type: "heading", text: "Still Getting \"Invalid Credentials\"?" },
    { type: "paragraph", html: "If you've done all four steps and it still won't budge, work through these:" },
    {
      type: "table",
      headers: ["What to check", "Why it matters"],
      rows: [
        ["You picked Live by mistake", "Prop accounts only work on Demo/Simulation. Re-check the environment toggle."],
        ["First letter of the password got lowercased", "Paste again and confirm the leading capital letter is intact."],
        ["A trailing space slipped in on copy", "Delete anything after the last character in each field."],
        ["Account isn't active yet", "Credentials won't authenticate if the evaluation hasn't been provisioned or the subscription lapsed. Confirm the account status in your dashboard."],
        ["You're still using your email", "The username must start with TRAD. If it doesn't, you grabbed the wrong field."],
      ],
    },
    { type: "paragraph", html: "One note for anyone with a different prop firm: the TRAD###### format is specific to how Tradeify labels its Tradovate usernames. Other firms hand out their own account-number formats, but the principle is identical. The username you use inside Tradovate is never your dashboard email, and the exact login rules can change, so confirm the current process in your firm's dashboard before you troubleshoot further." },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Once you're in, you can send your TradingView strategies straight to your Tradovate account, no manual clicking required." },
  ], de: [
    { type: "paragraph",html: "Wenn Tradovate ständig „Invalid Credentials“ meldet und Sie sicher sind, dass das Passwort stimmt, liegt es in neun von zehn Fällen daran: Sie geben Ihre E-Mail-Adresse ein. Ein Tradeify-Konto liefert Ihnen zwei völlig getrennte Zugangsdaten-Sätze, und die Handelsplattform akzeptiert nur einen davon." },
    { type: "paragraph",html: "Ihr Tradovate-Benutzername ist überhaupt keine E-Mail-Adresse. Es ist eine vom System erzeugte ID, die mit <strong class='text-white'>TRAD</strong> beginnt und von sechs Ziffern gefolgt wird, also etwa <strong class='text-white'>TRAD123456</strong>. Diese ID und ein von Tradeify für Sie erstelltes Passwort melden Sie bei Tradovate an. Die E-Mail-Adresse und das Passwort, mit denen Sie sich in Ihrem Tradeify-Dashboard anmelden, funktionieren auf der Handelsplattform nicht, und noch so häufiges erneutes Eintippen ändert daran nichts." },
    { type: "heading",text: "Warum Ihre E-Mail-Adresse nicht funktioniert" },
    { type: "paragraph",html: "Stellen Sie sich zwei Türen vor. Die eine Tür ist das Tradeify-Dashboard, in dem Sie Ihre Evaluierung oder Ihr finanziertes Konto verwalten, Auszahlungen einsehen und Ihren Fortschritt prüfen. Sie öffnen sie mit Ihrer E-Mail-Adresse und dem Passwort, das Sie bei der Registrierung gewählt haben. Die andere Tür ist Tradovate, die eigentliche Plattform für die Orderaufgabe. Sie öffnet sich nur mit dem TRAD######-Benutzernamen und dem von Tradeify ausgestellten Passwort. Sowohl der Benutzername als auch dieses Passwort sind fest vorgegeben. Sie können sie weder umbenennen noch auf etwas Handlicheres zurücksetzen." },
    { type: "paragraph",html: "Die beiden Zugänge zu verwechseln ist der mit Abstand häufigste Grund, warum ein Tradeify-Login scheitert. Sobald Sie den richtigen Satz an der richtigen Stelle verwenden, verschwindet die Fehlermeldung." },
    { type: "heading",text: "Tradeify-Tradovate-Login: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Zugangsdaten aus dem Tradeify-Dashboard kopieren", html: "Melden Sie sich wie gewohnt mit Ihrer E-Mail-Adresse und Ihrem Passwort in Ihrem Tradeify-Dashboard an. Ihr Tradovate-<strong class='text-white'>Username</strong> und Ihr <strong class='text-white'>Password</strong> stehen oben in der Kontoansicht. Verwenden Sie die Kopieren-Schaltfläche neben jedem Feld, statt die Angaben abzutippen. Diese Zeichenfolgen unterscheiden zwischen Groß- und Kleinschreibung und mischen oft Buchstaben, Zahlen und Symbole, sodass ein einziges falsch getipptes Zeichen oder ein überzähliges Leerzeichen für eine Ablehnung genügt." },
        { title: "Die Tradovate-Anmeldeseite öffnen", html: "Rufen Sie in Ihrem Browser <strong class='text-white'>trader.tradovate.com</strong> auf oder öffnen Sie die Tradovate-Desktop- oder -Mobil-App. Sie gelangen zum Anmeldebildschirm mit Feldern für Benutzername und Passwort. Dies ist die eigene Anmeldung von Tradovate und keine Tradeify-Seite, und genau deshalb wird Ihre Dashboard-E-Mail-Adresse hier abgelehnt." },
        { title: "TRAD######-Benutzernamen und Passwort einfügen", html: "Fügen Sie den TRAD######-Benutzernamen in das Benutzernamenfeld und das von Tradeify ausgestellte Passwort in das Passwortfeld ein. Einfügen ist hier aus einem heimtückischen Grund besser als Tippen: Das Passwort beginnt meist mit einem Großbuchstaben, und manche Browser und Apps schreiben dieses erste Zeichen beim Tippen oder bei der Autofill-Funktion stillschweigend klein. Schlägt Ihr Login direkt nach dem Einfügen fehl, prüfen Sie, ob der erste Buchstabe noch ein Großbuchstabe ist und ob die Autovervollständigung keine alten gespeicherten Zugangsdaten eingesetzt hat." },
        { title: "Demo-/Simulationsumgebung wählen und anmelden", html: "Diesen Schritt übersehen die meisten. Stellen Sie auf dem Anmeldebildschirm die Umgebung auf <strong class='text-white'>Demo</strong> oder <strong class='text-white'>Simulation</strong> ein, nicht auf <strong class='text-white'>Live</strong>. Evaluierungs- und finanzierte Prop-Konten laufen auch nach bestandener Prüfung in der simulierten Umgebung. Wählen Sie „Live“, erhalten Sie daher selbst bei perfektem Benutzernamen und Passwort die Fehlermeldung „Invalid Credentials“. Bei Ihrer allerersten Anmeldung werden Sie außerdem aufgefordert, eine Marktdatenvereinbarung für Nicht-Profis zu akzeptieren. Unterzeichnen Sie sie, und Ihr Konto und Ihre Charts werden geladen." },
      ],
    },
    { type: "heading",text: "Immer noch „Invalid Credentials“?" },
    { type: "paragraph",html: "Wenn Sie alle vier Schritte befolgt haben und es sich trotzdem nicht ändert, gehen Sie diese Punkte durch:" },
    { type: "table", headers: ["Was Sie prüfen sollten","Warum es wichtig ist"], rows: [
      ["Sie haben versehentlich Live gewählt","Prop-Konten funktionieren nur in Demo/Simulation. Prüfen Sie den Umgebungsschalter noch einmal."],
      ["Der erste Buchstabe des Passworts wurde kleingeschrieben","Fügen Sie es erneut ein und stellen Sie sicher, dass der führende Großbuchstabe erhalten ist."],
      ["Beim Kopieren ist ein Leerzeichen am Ende mitgekommen","Löschen Sie alles, was nach dem letzten Zeichen in den beiden Feldern steht."],
      ["Das Konto ist noch nicht aktiv","Die Zugangsdaten werden nicht authentifiziert, wenn die Evaluierung noch nicht bereitgestellt wurde oder das Abonnement abgelaufen ist. Prüfen Sie den Kontostatus in Ihrem Dashboard."],
      ["Sie verwenden noch Ihre E-Mail-Adresse","Der Benutzername muss mit TRAD beginnen. Falls nicht, haben Sie das falsche Feld kopiert."],
    ] },
    { type: "paragraph",html: "Ein Hinweis für alle mit einer anderen Prop-Firma: Das Format TRAD###### gilt speziell dafür, wie Tradeify seine Tradovate-Benutzernamen kennzeichnet. Andere Firmen vergeben eigene Kontonummernformate, das Prinzip ist jedoch identisch. Der Benutzername, den Sie in Tradovate verwenden, ist niemals Ihre Dashboard-E-Mail-Adresse, und die genauen Anmelderegeln können sich ändern. Bestätigen Sie daher den aktuellen Ablauf im Dashboard Ihrer Firma, bevor Sie weiter nach Fehlern suchen." },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "Sobald Sie angemeldet sind, können Sie Ihre TradingView-Strategien direkt an Ihr Tradovate-Konto senden, ganz ohne manuelles Klicken." },
  ], es: [
    { type: "paragraph",html: "Si Tradovate sigue mostrando «Invalid Credentials» y está seguro de que la contraseña es correcta, esta es la solución en nueve de cada diez casos: está escribiendo su correo electrónico. Una cuenta de Tradeify le da dos conjuntos de credenciales completamente separados, y la plataforma de trading solo acepta uno de ellos." },
    { type: "paragraph",html: "Su nombre de usuario de Tradovate no es un correo electrónico en absoluto. Es un ID generado por el sistema que empieza por <strong class='text-white'>TRAD</strong> seguido de seis dígitos, por ejemplo <strong class='text-white'>TRAD123456</strong>. Ese ID, junto con una contraseña que Tradeify crea para usted, es lo que le da acceso a Tradovate. El correo y la contraseña con los que inicia sesión en su panel de Tradeify no funcionarán en la plataforma de trading, y por mucho que los vuelva a escribir no cambiará nada." },
    { type: "heading",text: "Por qué su correo electrónico no funciona" },
    { type: "paragraph",html: "Piense en dos puertas. Una puerta es el panel de Tradeify, donde gestiona su evaluación o su cuenta fondeada, consulta los pagos y revisa su progreso. La abre con su correo electrónico y la contraseña que eligió al registrarse. La otra puerta es Tradovate, la plataforma real de introducción de órdenes. Esa solo se abre con el nombre de usuario TRAD###### y la contraseña que le asigna Tradeify. Tanto el nombre de usuario como esa contraseña son fijos. No puede cambiarlos de nombre ni restablecerlos a algo más cómodo." },
    { type: "paragraph",html: "Confundir ambos accesos es, con diferencia, el motivo más habitual por el que falla un inicio de sesión de Tradeify. En cuanto use el conjunto correcto en el lugar correcto, el error desaparece." },
    { type: "heading",text: "Inicio de sesión de Tradeify en Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Copie sus credenciales desde el panel de Tradeify", html: "Inicie sesión en su panel de Tradeify de la forma habitual, con su correo electrónico y contraseña. Su <strong class='text-white'>Username</strong> y su <strong class='text-white'>Password</strong> de Tradovate aparecen en la parte superior de la vista de la cuenta. Use el botón de copiar junto a cada campo en lugar de volver a escribirlos. Estas cadenas distinguen entre mayúsculas y minúsculas y suelen combinar letras, números y símbolos, de modo que un solo carácter mal escrito o un espacio de más basta para que se rechacen." },
        { title: "Abra la página de inicio de sesión de Tradovate", html: "Vaya a <strong class='text-white'>trader.tradovate.com</strong> en su navegador, o abra la aplicación de escritorio o móvil de Tradovate. Llegará a la pantalla de inicio de sesión con campos para el nombre de usuario y la contraseña. Este es el inicio de sesión propio de Tradovate, no una página de Tradeify, y precisamente por eso se rechaza aquí el correo de su panel." },
        { title: "Pegue el usuario TRAD###### y la contraseña", html: "Pegue el nombre de usuario TRAD###### en el campo de usuario y la contraseña emitida por Tradeify en el campo de contraseña. Pegar es mejor que escribir por una razón poco evidente: la contraseña suele empezar por una letra mayúscula, y algunos navegadores y aplicaciones convierten discretamente ese primer carácter en minúscula al escribirlo o al autocompletarlo. Si el inicio de sesión falla justo después de pegar, compruebe que la primera letra sigue en mayúscula y que el autocompletado no haya sustituido las credenciales por otras guardadas antiguas." },
        { title: "Elija el entorno Demo/Simulation e inicie sesión", html: "Este es el paso que más gente pasa por alto. En la pantalla de inicio de sesión, configure el entorno en <strong class='text-white'>Demo</strong> o <strong class='text-white'>Simulation</strong>, no en <strong class='text-white'>Live</strong>. Las cuentas de evaluación y las fondeadas de las prop firms funcionan en el entorno simulado incluso después de superar la prueba, por lo que elegir «Live» le devuelve un error «Invalid Credentials» aunque el usuario y la contraseña sean perfectos. En su primer inicio de sesión también se le pedirá que acepte un acuerdo de datos de mercado para no profesionales. Fírmelo y se cargarán su cuenta y sus gráficos." },
      ],
    },
    { type: "heading",text: "¿Sigue apareciendo «Invalid Credentials»?" },
    { type: "paragraph",html: "Si ha completado los cuatro pasos y sigue sin funcionar, revise lo siguiente:" },
    { type: "table", headers: ["Qué comprobar","Por qué importa"], rows: [
      ["Eligió Live por error","Las cuentas de prop firms solo funcionan en Demo/Simulation. Vuelva a revisar el selector de entorno."],
      ["La primera letra de la contraseña quedó en minúscula","Vuelva a pegarla y confirme que la mayúscula inicial está intacta."],
      ["Se coló un espacio final al copiar","Elimine cualquier cosa que haya después del último carácter en cada campo."],
      ["La cuenta aún no está activa","Las credenciales no se autenticarán si la evaluación no se ha aprovisionado o la suscripción ha caducado. Confirme el estado de la cuenta en su panel."],
      ["Sigue usando su correo electrónico","El nombre de usuario debe empezar por TRAD. Si no es así, ha copiado el campo equivocado."],
    ] },
    { type: "paragraph",html: "Una nota para quienes tengan otra prop firm: el formato TRAD###### es específico de cómo Tradeify etiqueta sus nombres de usuario de Tradovate. Otras firmas entregan sus propios formatos de número de cuenta, pero el principio es idéntico. El nombre de usuario que utiliza dentro de Tradovate nunca es el correo de su panel, y las reglas exactas de inicio de sesión pueden cambiar, así que confirme el proceso actual en el panel de su firma antes de seguir solucionando el problema." },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Una vez dentro, puede enviar sus estrategias de TradingView directamente a su cuenta de Tradovate, sin necesidad de hacer clic manualmente." },
  ], fr: [
    { type: "paragraph",html: "Si Tradovate affiche sans cesse « Invalid Credentials » alors que vous êtes certain d'avoir le bon mot de passe, voici la solution neuf fois sur dix : vous saisissez votre e-mail. Un compte Tradeify vous donne deux jeux d'identifiants totalement distincts, et la plateforme de trading n'en accepte qu'un seul." },
    { type: "paragraph",html: "Votre nom d'utilisateur Tradovate n'est pas du tout un e-mail. C'est un identifiant généré par le système, qui commence par <strong class='text-white'>TRAD</strong> suivi de six chiffres, par exemple <strong class='text-white'>TRAD123456</strong>. Cet identifiant, associé à un mot de passe créé pour vous par Tradeify, est ce qui vous connecte à Tradovate. L'e-mail et le mot de passe que vous utilisez pour vous connecter à votre tableau de bord Tradeify ne fonctionneront pas sur la plateforme de trading, et les retaper encore et encore n'y changera rien." },
    { type: "heading",text: "Pourquoi votre e-mail ne fonctionne pas" },
    { type: "paragraph",html: "Pensez à deux portes. La première est le tableau de bord Tradeify, où vous gérez votre évaluation ou votre compte financé, consultez vos retraits et suivez votre progression. Vous l'ouvrez avec votre e-mail et le mot de passe choisi lors de votre inscription. La seconde est Tradovate, la véritable plateforme de saisie d'ordres. Celle-ci ne s'ouvre qu'avec le nom d'utilisateur TRAD###### et le mot de passe que Tradeify vous attribue. Le nom d'utilisateur comme ce mot de passe sont fixes. Vous ne pouvez ni les renommer ni les réinitialiser pour quelque chose de plus pratique." },
    { type: "paragraph",html: "Confondre les deux est de loin la cause la plus fréquente d'un échec de connexion Tradeify. Dès que vous utilisez le bon jeu d'identifiants au bon endroit, l'erreur disparaît." },
    { type: "heading",text: "Connexion Tradeify à Tradovate : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Copiez vos identifiants depuis le tableau de bord Tradeify", html: "Connectez-vous à votre tableau de bord Tradeify de la manière habituelle, avec votre e-mail et votre mot de passe. Votre <strong class='text-white'>Username</strong> et votre <strong class='text-white'>Password</strong> Tradovate figurent en haut de la vue du compte. Utilisez le bouton de copie à côté de chaque champ plutôt que de les retaper. Ces chaînes sont sensibles à la casse et mélangent souvent lettres, chiffres et symboles : un seul caractère mal saisi ou une espace parasite suffit à provoquer un rejet." },
        { title: "Ouvrez la page de connexion de Tradovate", html: "Rendez-vous sur <strong class='text-white'>trader.tradovate.com</strong> dans votre navigateur, ou ouvrez l'application Tradovate de bureau ou mobile. Vous arriverez sur l'écran de connexion avec des champs pour le nom d'utilisateur et le mot de passe. Il s'agit de la connexion propre à Tradovate, et non d'une page Tradeify, ce qui explique précisément pourquoi l'e-mail de votre tableau de bord est refusé ici." },
        { title: "Collez le nom d'utilisateur TRAD###### et le mot de passe", html: "Collez le nom d'utilisateur TRAD###### dans le champ du nom d'utilisateur et le mot de passe fourni par Tradeify dans le champ du mot de passe. Coller vaut mieux que taper pour une raison sournoise : le mot de passe commence généralement par une majuscule, et certains navigateurs et applications passent discrètement ce premier caractère en minuscule lorsque vous le tapez ou que le remplissage automatique le saisit. Si votre connexion échoue juste après le collage, vérifiez que la première lettre est toujours en majuscule et que la saisie automatique n'a pas inséré d'anciens identifiants enregistrés." },
        { title: "Choisissez l'environnement Demo/Simulation et connectez-vous", html: "C'est l'étape que la plupart des gens manquent. Sur l'écran de connexion, réglez l'environnement sur <strong class='text-white'>Demo</strong> ou <strong class='text-white'>Simulation</strong>, et non sur <strong class='text-white'>Live</strong>. Les comptes d'évaluation et financés des prop firms fonctionnent dans l'environnement simulé, même après la réussite de l'évaluation : choisir « Live » vous renvoie donc une erreur « Invalid Credentials » même si le nom d'utilisateur et le mot de passe sont parfaits. Lors de votre toute première connexion, il vous sera aussi demandé d'accepter un accord de données de marché non professionnel. Signez-le, et votre compte et vos graphiques se chargeront." },
      ],
    },
    { type: "heading",text: "Toujours « Invalid Credentials » ?" },
    { type: "paragraph",html: "Si vous avez suivi les quatre étapes et que rien ne bouge, passez en revue les points suivants :" },
    { type: "table", headers: ["Ce qu'il faut vérifier","Pourquoi c'est important"], rows: [
      ["Vous avez choisi Live par erreur","Les comptes de prop firm ne fonctionnent qu'en Demo/Simulation. Revérifiez le sélecteur d'environnement."],
      ["La première lettre du mot de passe est passée en minuscule","Collez-le à nouveau et vérifiez que la majuscule initiale est bien intacte."],
      ["Une espace de fin s'est glissée lors de la copie","Supprimez tout ce qui suit le dernier caractère dans chaque champ."],
      ["Le compte n'est pas encore actif","Les identifiants ne seront pas authentifiés si l'évaluation n'a pas été provisionnée ou si l'abonnement a expiré. Confirmez le statut du compte dans votre tableau de bord."],
      ["Vous utilisez toujours votre e-mail","Le nom d'utilisateur doit commencer par TRAD. Si ce n'est pas le cas, vous avez copié le mauvais champ."],
    ] },
