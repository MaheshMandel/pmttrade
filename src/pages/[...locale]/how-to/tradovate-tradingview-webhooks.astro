---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-tradingview-webhooks";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Automate Tradovate From TradingView Webhooks";
const META_DESCRIPTION =
  "Tradovate TradingView webhooks made simple: route alert signals through a bridge service to auto-execute your futures trades, no manual clicks.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate API", de: "Tradovate API", es: "Tradovate API", fr: "Tradovate API", it: "Tradovate API" },
  h1: { en: META_TITLE, de: "Tradovate per TradingView-Webhooks automatisieren", es: "Automatice Tradovate desde webhooks de TradingView", fr: "Automatiser Tradovate à partir des webhooks TradingView", it: "Automatizzare Tradovate dai webhook di TradingView" },
  dek: { en: "Want your TradingView strategy to hit Tradovate the second an alert fires, with no hand on the mouse? Route those alert signals to your account through a bridge service. Here's exactly how to wire it up.", de: "Sie möchten, dass Ihre TradingView-Strategie Tradovate in der Sekunde erreicht, in der ein Alert ausgelöst wird, ganz ohne Hand an der Maus? Leiten Sie diese Alert-Signale über einen Bridge-Dienst an Ihr Konto weiter. So richten Sie alles genau ein.", es: "¿Quiere que su estrategia de TradingView llegue a Tradovate en el instante en que se dispara una alerta, sin tocar el ratón? Dirija esas señales de alerta a su cuenta mediante un servicio puente. Así se configura todo, paso a paso.", fr: "Vous voulez que votre stratégie TradingView atteigne Tradovate à la seconde où une alerte se déclenche, sans toucher à la souris ? Acheminez ces signaux d’alerte vers votre compte via un service passerelle. Voici exactement comment tout configurer.", it: "Vuole che la sua strategia di TradingView raggiunga Tradovate nell’istante in cui scatta un alert, senza toccare il mouse? Instradi quei segnali di alert al suo conto tramite un servizio bridge. Ecco esattamente come configurare tutto." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Want your TradingView strategy to hit Tradovate the second an alert fires, with no hand on the mouse? Tradovate can't read a TradingView webhook on its own, so you route those alert signals to your account through a bridge service. Here's exactly how to wire it up." },
    { type: "heading", text: "What Are TradingView Webhooks?" },
    { type: "paragraph", html: "A TradingView webhook is a message TradingView pushes to a web address the instant an alert triggers. It fires an HTTP POST request and drops your alert's message text into the request body, so an outside app can read the signal and act on it. The problem is simple: Tradovate has no built-in endpoint that accepts these alerts, so it can't turn a raw webhook into an order by itself." },
    { type: "paragraph", html: "That's the job of a bridge service. The bridge sits between TradingView and Tradovate, catches each incoming webhook, reads your instructions, and places the trade on your Tradovate account through Tradovate's API. Keep one distinction straight: Tradovate's native TradingView connection lets you trade <em>manually</em> from TradingView charts, but it won't auto-fire your alerts. That gap is the whole reason a webhook bridge exists." },
    { type: "heading", text: "Route TradingView Webhooks to Tradovate: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Connect Your Tradovate Account to a Webhook Bridge", html: "Sign in to a webhook bridge service and link your Tradovate (or prop-firm) account. This authorizes the bridge to place orders on your behalf, so your alerts have somewhere to land.", image: { src: `${IMG}/tradovate-tradingview-webhooks-1.png`, alt: "Webhook bridge dashboard connecting a Tradovate account for TradingView automation" } },
        { title: "Generate the Alert Payload and Copy Your Webhook URL", html: "In the bridge, pick the Tradovate account you want to trade, generate the alert code (a small JSON message that holds your symbol, quantity, and action), and copy both that JSON and your unique webhook URL. Don't hand-edit the JSON later. If something needs to change, regenerate it from the settings so the format stays intact.", image: { src: `${IMG}/tradovate-tradingview-webhooks-2.png`, alt: "Bridge service showing the generated JSON alert payload and TradingView webhook URL" } },
        { title: "Create the TradingView Alert and Paste the Payload", html: "Back in TradingView, open your chart or strategy, click the alert (+) button, set your trigger condition, and paste the copied JSON into the alert's <strong class='text-white'>Message</strong> box exactly as it was generated.", image: { src: `${IMG}/tradovate-tradingview-webhooks-3.png`, alt: "TradingView Create Alert dialog with the webhook JSON pasted in the Message box" } },
        { title: "Enable the Webhook URL Under the Notifications Tab", html: "Still inside the alert dialog, open the <strong class='text-white'>Notifications</strong> tab, switch on <strong class='text-white'>Webhook URL</strong>, and paste your bridge webhook URL. Webhook alerts aren't available on TradingView's free plan and they also require two-factor authentication, so you'll need a paid tier with 2FA turned on. Save the alert once it's in.", image: { src: `${IMG}/tradovate-tradingview-webhooks-4.png`, alt: "TradingView alert Notifications tab with Webhook URL enabled for Tradovate routing" } },
        { title: "Fire a Test Alert and Confirm the Order in Tradovate", html: "Trigger the alert by hand (or wait for your condition to hit), check the bridge's alert log for a Filled status, then confirm the resulting position in Tradovate's Orders or Positions module. Do this before you trust it with live size.", image: { src: `${IMG}/tradovate-tradingview-webhooks-5.png`, alt: "Tradovate Orders module showing a filled order placed from a TradingView webhook" } },
      ],
    },
    { type: "heading", text: "Example Alert Payload" },
    { type: "quote", html: "<code>{</code><br><code>&nbsp;&nbsp;\"symbol\": \"NQ\",</code><br><code>&nbsp;&nbsp;\"quantity\": 1,</code><br><code>&nbsp;&nbsp;\"action\": \"buy\"</code><br><code>}</code>" },
    { type: "paragraph", html: "That's the shape of a typical generated payload, your bridge service fills in the account and order details automatically. Don't hand-edit this JSON; if something needs to change, regenerate it from the bridge's settings so the format stays intact." },
    { type: "heading", text: "Why You'd Need This" },
    {
      type: "list",
      items: [
        "Run a TradingView strategy or indicator around the clock without watching the screen.",
        "Fire entries and exits in a fraction of a second, faster than you could ever click.",
        "Mirror a single alert across multiple Tradovate or prop-firm accounts at once.",
        "Keep an auditable log of every signal and whether it filled, rejected, or paused.",
        "Trade your system while you sleep or work a day job.",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "PickMyTrade is a webhook bridge that links your TradingView alerts straight to your Tradovate account. You paste one webhook URL, drop in the generated JSON, and every signal routes and fills automatically with built-in risk controls. No manual clicks, no coding." },
  ], de: [
    { type: "paragraph",html: "Sie möchten, dass Ihre TradingView-Strategie Tradovate in der Sekunde erreicht, in der ein Alert ausgelöst wird, ganz ohne Hand an der Maus? Tradovate kann einen TradingView-Webhook nicht von sich aus lesen, deshalb leiten Sie diese Alert-Signale über einen Bridge-Dienst an Ihr Konto weiter. So richten Sie alles genau ein." },
    { type: "heading",text: "Was sind TradingView-Webhooks?" },
    { type: "paragraph",html: "Ein TradingView-Webhook ist eine Nachricht, die TradingView in dem Moment an eine Webadresse sendet, in dem ein Alert ausgelöst wird. Er sendet eine HTTP-POST-Anfrage und legt den Nachrichtentext Ihres Alerts in den Body der Anfrage, sodass eine externe App das Signal lesen und darauf reagieren kann. Das Problem ist einfach: Tradovate hat keinen integrierten Endpunkt, der diese Alerts annimmt, und kann einen rohen Webhook daher nicht selbst in eine Order umwandeln." },
    { type: "paragraph",html: "Genau das ist die Aufgabe eines Bridge-Dienstes. Die Bridge sitzt zwischen TradingView und Tradovate, fängt jeden eingehenden Webhook ab, liest Ihre Anweisungen und platziert den Trade über die Tradovate-API auf Ihrem Tradovate-Konto. Beachten Sie eine Unterscheidung: Die native TradingView-Anbindung von Tradovate erlaubt Ihnen, <em>manuell</em> aus TradingView-Charts zu handeln, löst Ihre Alerts aber nicht automatisch aus. Genau diese Lücke ist der Grund, warum es eine Webhook-Bridge gibt." },
    { type: "heading",text: "TradingView-Webhooks an Tradovate weiterleiten: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Verbinden Sie Ihr Tradovate-Konto mit einer Webhook-Bridge", html: "Melden Sie sich bei einem Webhook-Bridge-Dienst an und verknüpfen Sie Ihr Tradovate- (oder Prop-Firm-) Konto. Damit autorisieren Sie die Bridge, Orders in Ihrem Namen zu platzieren, sodass Ihre Alerts ein Ziel haben.", image: {"src":`${IMG}/tradovate-tradingview-webhooks-1.png`,"alt":"Webhook-Bridge-Dashboard, das ein Tradovate-Konto für die TradingView-Automatisierung verbindet"} },
        { title: "Alert-Payload erzeugen und Webhook-URL kopieren", html: "Wählen Sie in der Bridge das Tradovate-Konto aus, das Sie handeln möchten, erzeugen Sie den Alert-Code (eine kleine JSON-Nachricht mit Symbol, Menge und Aktion) und kopieren Sie sowohl dieses JSON als auch Ihre individuelle Webhook-URL. Bearbeiten Sie das JSON später nicht von Hand. Wenn sich etwas ändern muss, erzeugen Sie es in den Einstellungen neu, damit das Format intakt bleibt.", image: {"src":`${IMG}/tradovate-tradingview-webhooks-2.png`,"alt":"Bridge-Dienst mit der erzeugten JSON-Alert-Payload und der TradingView-Webhook-URL"} },
        { title: "TradingView-Alert erstellen und Payload einfügen", html: "Öffnen Sie in TradingView Ihren Chart oder Ihre Strategie, klicken Sie auf die Alert-Schaltfläche (+), legen Sie Ihre Auslösebedingung fest und fügen Sie das kopierte JSON genau so, wie es erzeugt wurde, in das Feld <strong class='text-white'>Message</strong> des Alerts ein.", image: {"src":`${IMG}/tradovate-tradingview-webhooks-3.png`,"alt":"Dialog „Create Alert“ in TradingView mit dem im Message-Feld eingefügten Webhook-JSON"} },
        { title: "Webhook-URL im Tab „Notifications“ aktivieren", html: "Öffnen Sie weiterhin im Alert-Dialog den Tab <strong class='text-white'>Notifications</strong>, aktivieren Sie <strong class='text-white'>Webhook URL</strong> und fügen Sie die Webhook-URL Ihrer Bridge ein. Webhook-Alerts sind im kostenlosen TradingView-Tarif nicht verfügbar und erfordern außerdem eine Zwei-Faktor-Authentifizierung, Sie benötigen also einen kostenpflichtigen Tarif mit aktivierter 2FA. Speichern Sie den Alert, sobald alles eingetragen ist.", image: {"src":`${IMG}/tradovate-tradingview-webhooks-4.png`,"alt":"Tab „Notifications“ eines TradingView-Alerts mit aktivierter Webhook-URL für das Tradovate-Routing"} },
        { title: "Test-Alert auslösen und die Order in Tradovate bestätigen", html: "Lösen Sie den Alert manuell aus (oder warten Sie, bis Ihre Bedingung erfüllt ist), prüfen Sie im Alert-Protokoll der Bridge den Status „Filled“ und bestätigen Sie dann die entstandene Position im Modul „Orders“ oder „Positions“ von Tradovate. Tun Sie dies, bevor Sie dem Setup eine echte Positionsgröße anvertrauen.", image: {"src":`${IMG}/tradovate-tradingview-webhooks-5.png`,"alt":"Tradovate-Modul „Orders“ mit einer ausgeführten Order, die über einen TradingView-Webhook platziert wurde"} },
      ],
    },
    { type: "heading",text: "Beispiel-Alert-Payload" },
    { type: "quote",html: "<code>{</code><br><code>&nbsp;&nbsp;\"symbol\": \"NQ\",</code><br><code>&nbsp;&nbsp;\"quantity\": 1,</code><br><code>&nbsp;&nbsp;\"action\": \"buy\"</code><br><code>}</code>" },
    { type: "paragraph",html: "So sieht eine typische erzeugte Payload aus, Ihr Bridge-Dienst trägt Konto und Order-Details automatisch ein. Bearbeiten Sie dieses JSON nicht von Hand; wenn sich etwas ändern muss, erzeugen Sie es in den Einstellungen der Bridge neu, damit das Format intakt bleibt." },
    { type: "heading",text: "Warum Sie das brauchen" },
    {
      type: "list",
      items: [
        "Führen Sie eine TradingView-Strategie oder einen Indikator rund um die Uhr aus, ohne den Bildschirm zu beobachten.",
        "Lösen Sie Ein- und Ausstiege in Sekundenbruchteilen aus, schneller, als Sie je klicken könnten.",
        "Spiegeln Sie einen einzelnen Alert gleichzeitig auf mehrere Tradovate- oder Prop-Firm-Konten.",
        "Führen Sie ein prüfbares Protokoll jedes Signals und darüber, ob es ausgeführt, abgelehnt oder pausiert wurde.",
        "Handeln Sie Ihr System, während Sie schlafen oder Ihrem Hauptberuf nachgehen.",
      ],
    },
    { type: "heading",text: "Automatisieren Sie das mit PickMyTrade" },
    { type: "paragraph",html: "PickMyTrade ist eine Webhook-Bridge, die Ihre TradingView-Alerts direkt mit Ihrem Tradovate-Konto verbindet. Sie fügen eine Webhook-URL ein, tragen das erzeugte JSON ein, und jedes Signal wird automatisch weitergeleitet und ausgeführt, mit integrierten Risikokontrollen. Keine manuellen Klicks, keine Programmierung." },
  ], es: [
    { type: "paragraph",html: "¿Quiere que su estrategia de TradingView llegue a Tradovate en el instante en que se dispara una alerta, sin tocar el ratón? Tradovate no puede leer por sí solo un webhook de TradingView, por lo que debe dirigir esas señales de alerta a su cuenta mediante un servicio puente. Así se configura todo, paso a paso." },
    { type: "heading",text: "¿Qué son los webhooks de TradingView?" },
    { type: "paragraph",html: "Un webhook de TradingView es un mensaje que TradingView envía a una dirección web en el instante en que se activa una alerta. Dispara una solicitud HTTP POST e introduce el texto del mensaje de su alerta en el cuerpo de la solicitud, de modo que una aplicación externa pueda leer la señal y actuar en consecuencia. El problema es sencillo: Tradovate no tiene un endpoint integrado que acepte estas alertas, por lo que no puede convertir por sí mismo un webhook en bruto en una orden." },
    { type: "paragraph",html: "Ese es el trabajo de un servicio puente. El puente se sitúa entre TradingView y Tradovate, recibe cada webhook entrante, lee sus instrucciones y coloca la operación en su cuenta de Tradovate a través de la API de Tradovate. Tenga clara una distinción: la conexión nativa de Tradovate con TradingView le permite operar <em>manualmente</em> desde los gráficos de TradingView, pero no dispara sus alertas de forma automática. Ese vacío es la razón de ser de un puente de webhooks." },
    { type: "heading",text: "Dirigir webhooks de TradingView a Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Conecte su cuenta de Tradovate a un puente de webhooks", html: "Inicie sesión en un servicio puente de webhooks y vincule su cuenta de Tradovate (o de prop firm). Esto autoriza al puente a colocar órdenes en su nombre, de modo que sus alertas tengan un destino.", image: {"src":`${IMG}/tradovate-tradingview-webhooks-1.png`,"alt":"Panel de un puente de webhooks conectando una cuenta de Tradovate para la automatización de TradingView"} },
        { title: "Genere el payload de la alerta y copie su URL de webhook", html: "En el puente, elija la cuenta de Tradovate con la que quiere operar, genere el código de la alerta (un pequeño mensaje JSON con su símbolo, cantidad y acción) y copie tanto ese JSON como su URL de webhook única. No edite el JSON a mano después. Si algo necesita cambiar, vuelva a generarlo desde la configuración para que el formato se mantenga intacto.", image: {"src":`${IMG}/tradovate-tradingview-webhooks-2.png`,"alt":"Servicio puente mostrando el payload JSON de la alerta generado y la URL de webhook de TradingView"} },
        { title: "Cree la alerta en TradingView y pegue el payload", html: "De vuelta en TradingView, abra su gráfico o estrategia, haga clic en el botón de alerta (+), establezca su condición de activación y pegue el JSON copiado en el cuadro <strong class='text-white'>Message</strong> de la alerta exactamente como se generó.", image: {"src":`${IMG}/tradovate-tradingview-webhooks-3.png`,"alt":"Cuadro de diálogo Create Alert de TradingView con el JSON del webhook pegado en el cuadro Message"} },
        { title: "Active la URL del webhook en la pestaña Notifications", html: "Sin salir del cuadro de diálogo de la alerta, abra la pestaña <strong class='text-white'>Notifications</strong>, active <strong class='text-white'>Webhook URL</strong> y pegue la URL de webhook de su puente. Las alertas con webhook no están disponibles en el plan gratuito de TradingView y además exigen autenticación de dos factores, por lo que necesitará un plan de pago con 2FA activada. Guarde la alerta una vez introducido todo.", image: {"src":`${IMG}/tradovate-tradingview-webhooks-4.png`,"alt":"Pestaña Notifications de una alerta de TradingView con la Webhook URL activada para el enrutamiento a Tradovate"} },
        { title: "Dispare una alerta de prueba y confirme la orden en Tradovate", html: "Active la alerta manualmente (o espere a que se cumpla su condición), compruebe en el registro de alertas del puente que aparezca el estado Filled y luego confirme la posición resultante en el módulo Orders o Positions de Tradovate. Haga esto antes de confiarle un tamaño real.", image: {"src":`${IMG}/tradovate-tradingview-webhooks-5.png`,"alt":"Módulo Orders de Tradovate mostrando una orden ejecutada colocada desde un webhook de TradingView"} },
      ],
    },
    { type: "heading",text: "Ejemplo de payload de alerta" },
    { type: "quote",html: "<code>{</code><br><code>&nbsp;&nbsp;\"symbol\": \"NQ\",</code><br><code>&nbsp;&nbsp;\"quantity\": 1,</code><br><code>&nbsp;&nbsp;\"action\": \"buy\"</code><br><code>}</code>" },
    { type: "paragraph",html: "Esta es la forma de un payload generado típico; su servicio puente completa automáticamente los datos de la cuenta y de la orden. No edite este JSON a mano; si algo necesita cambiar, vuelva a generarlo desde la configuración del puente para que el formato se mantenga intacto." },
    { type: "heading",text: "Por qué lo necesitaría" },
    {
      type: "list",
      items: [
        "Ejecute una estrategia o indicador de TradingView de forma continua sin vigilar la pantalla.",
        "Dispare entradas y salidas en una fracción de segundo, más rápido de lo que usted podría hacer clic jamás.",
        "Replique una única alerta en varias cuentas de Tradovate o de prop firms a la vez.",
        "Mantenga un registro auditable de cada señal y de si se ejecutó, se rechazó o se pausó.",
        "Opere su sistema mientras duerme o trabaja en su empleo.",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "PickMyTrade es un puente de webhooks que conecta sus alertas de TradingView directamente con su cuenta de Tradovate. Usted pega una URL de webhook, introduce el JSON generado y cada señal se enruta y se ejecuta automáticamente con controles de riesgo integrados. Sin clics manuales, sin programar." },
  ], fr: [
    { type: "paragraph",html: "Vous voulez que votre stratégie TradingView atteigne Tradovate à la seconde où une alerte se déclenche, sans toucher à la souris ? Tradovate ne peut pas lire seul un webhook TradingView ; vous acheminez donc ces signaux d’alerte vers votre compte via un service passerelle. Voici exactement comment tout configurer." },
    { type: "heading",text: "Que sont les webhooks TradingView ?" },
    { type: "paragraph",html: "Un webhook TradingView est un message que TradingView envoie à une adresse web à l’instant où une alerte se déclenche. Il émet une requête HTTP POST et place le texte du message de votre alerte dans le corps de la requête, afin qu’une application externe puisse lire le signal et agir en conséquence. Le problème est simple : Tradovate n’a aucun point de terminaison intégré qui accepte ces alertes et ne peut donc pas transformer seul un webhook brut en ordre." },
    { type: "paragraph",html: "C’est le rôle d’un service passerelle. La passerelle se place entre TradingView et Tradovate, capte chaque webhook entrant, lit vos instructions et passe l’ordre sur votre compte Tradovate via l’API de Tradovate. Retenez une distinction : la connexion native de Tradovate avec TradingView vous permet de trader <em>manuellement</em> depuis les graphiques TradingView, mais elle ne déclenche pas automatiquement vos alertes. C’est précisément cette lacune qui justifie l’existence d’une passerelle de webhooks." },
    { type: "heading",text: "Acheminer les webhooks TradingView vers Tradovate : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Connectez votre compte Tradovate à une passerelle de webhooks", html: "Connectez-vous à un service de passerelle de webhooks et liez votre compte Tradovate (ou de prop firm). Cela autorise la passerelle à passer des ordres en votre nom, afin que vos alertes aient une destination.", image: {"src":`${IMG}/tradovate-tradingview-webhooks-1.png`,"alt":"Tableau de bord d’une passerelle de webhooks connectant un compte Tradovate pour l’automatisation TradingView"} },
        { title: "Générez la charge utile de l’alerte et copiez votre URL de webhook", html: "Dans la passerelle, choisissez le compte Tradovate que vous souhaitez trader, générez le code d’alerte (un petit message JSON contenant votre symbole, la quantité et l’action) et copiez à la fois ce JSON et votre URL de webhook unique. Ne modifiez pas le JSON à la main par la suite. Si quelque chose doit changer, régénérez-le depuis les paramètres afin de préserver le format.", image: {"src":`${IMG}/tradovate-tradingview-webhooks-2.png`,"alt":"Service passerelle affichant la charge utile JSON de l’alerte générée et l’URL de webhook TradingView"} },
        { title: "Créez l’alerte TradingView et collez la charge utile", html: "De retour dans TradingView, ouvrez votre graphique ou votre stratégie, cliquez sur le bouton d’alerte (+), définissez votre condition de déclenchement et collez le JSON copié dans la zone <strong class='text-white'>Message</strong> de l’alerte, exactement tel qu’il a été généré.", image: {"src":`${IMG}/tradovate-tradingview-webhooks-3.png`,"alt":"Boîte de dialogue Create Alert de TradingView avec le JSON du webhook collé dans la zone Message"} },
        { title: "Activez l’URL du webhook dans l’onglet Notifications", html: "Toujours dans la boîte de dialogue de l’alerte, ouvrez l’onglet <strong class='text-white'>Notifications</strong>, activez <strong class='text-white'>Webhook URL</strong> et collez l’URL de webhook de votre passerelle. Les alertes par webhook ne sont pas disponibles avec l’offre gratuite de TradingView et nécessitent également l’authentification à deux facteurs ; il vous faut donc une offre payante avec la 2FA activée. Enregistrez l’alerte une fois les informations saisies.", image: {"src":`${IMG}/tradovate-tradingview-webhooks-4.png`,"alt":"Onglet Notifications d’une alerte TradingView avec Webhook URL activée pour l’acheminement vers Tradovate"} },
        { title: "Déclenchez une alerte de test et confirmez l’ordre dans Tradovate", html: "Déclenchez l’alerte manuellement (ou attendez que votre condition soit remplie), vérifiez dans le journal des alertes de la passerelle que le statut Filled apparaît, puis confirmez la position obtenue dans le module Orders ou Positions de Tradovate. Faites-le avant de lui confier une taille réelle.", image: {"src":`${IMG}/tradovate-tradingview-webhooks-5.png`,"alt":"Module Orders de Tradovate affichant un ordre exécuté passé depuis un webhook TradingView"} },
      ],
    },
    { type: "heading",text: "Exemple de charge utile d’alerte" },
    { type: "quote",html: "<code>{</code><br><code>&nbsp;&nbsp;\"symbol\": \"NQ\",</code><br><code>&nbsp;&nbsp;\"quantity\": 1,</code><br><code>&nbsp;&nbsp;\"action\": \"buy\"</code><br><code>}</code>" },
    { type: "paragraph",html: "Voici la forme d’une charge utile générée typique ; votre service passerelle renseigne automatiquement le compte et les détails de l’ordre. Ne modifiez pas ce JSON à la main ; si quelque chose doit changer, régénérez-le depuis les paramètres de la passerelle afin de préserver le format." },
    { type: "heading",text: "Pourquoi en avez-vous besoin" },
    {
      type: "list",
      items: [
        "Exécutez une stratégie ou un indicateur TradingView en continu sans surveiller l’écran.",
        "Déclenchez vos entrées et sorties en une fraction de seconde, plus vite que vous ne pourrez jamais cliquer.",
