---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-multiple-accounts";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Run Multiple Tradovate Accounts at Once";
const META_DESCRIPTION =
  "Learn to switch between and trade several futures accounts under one login at once with the built-in account groups feature. Step-by-step guide.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Mehrere Tradovate-Konten gleichzeitig betreiben", es: "Gestionar varias cuentas de Tradovate a la vez", fr: "Gérer plusieurs comptes Tradovate en même temps", it: "Gestire più conti Tradovate contemporaneamente" },
  dek: { en: "Juggling a couple of prop evaluations plus your own funded account? Every account you have access to sits under a single Tradovate login, and the platform ships with a free tool that can fire the same order into all of them at once.", de: "Sie jonglieren mit ein paar Prop-Evaluierungen und Ihrem eigenen finanzierten Konto? Alle Konten, auf die Sie Zugriff haben, liegen unter einem einzigen Tradovate-Login, und die Plattform bringt ein kostenloses Werkzeug mit, das dieselbe Order in alle gleichzeitig senden kann.", es: "¿Malabarea un par de evaluaciones de prop firm además de su propia cuenta financiada? Todas las cuentas a las que tiene acceso están bajo un único inicio de sesión de Tradovate, y la plataforma incluye una herramienta gratuita que puede lanzar la misma orden en todas a la vez.", fr: "Vous jonglez avec quelques évaluations prop firm en plus de votre propre compte financé ? Tous les comptes auxquels vous avez accès se trouvent sous une seule connexion Tradovate, et la plateforme propose un outil gratuit capable d’envoyer le même ordre sur tous à la fois.", it: "Sta destreggiandosi tra un paio di valutazioni con prop firm e il suo conto finanziato? Tutti i conti a cui ha accesso si trovano sotto un unico login Tradovate, e la piattaforma include uno strumento gratuito in grado di inviare lo stesso ordine a tutti insieme." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "If you're juggling a couple of prop evaluations plus your own funded account, logging out and back in all day gets old fast. You don't have to. Every account you have access to sits under a single Tradovate login, and the platform ships with a free tool that can fire the same order into all of them at once." },
    { type: "paragraph", html: "This guide covers two things: switching between accounts with a click, and grouping several accounts so one order trades them together." },
    { type: "heading", text: "How Accounts Stack Under One Login" },
    { type: "paragraph", html: "When you log in, Tradovate shows every account you can reach, a personal account, a simulated account, and any prop evaluation or funded accounts your firm has attached. There's no separate \"add account\" step for most of these; a prop firm links them to your login when you buy or pass an evaluation. One caveat matters later: accounts only play together if they live with the same brokerage provider." },
    { type: "heading", text: "Switch Between Your Accounts and Trade Them as a Group" },
    {
      type: "steps",
      items: [
        { title: "Open the Accounts Dropdown", html: "At the top of the platform, open the <strong class='text-white'>Accounts</strong> dropdown. It lists every account under your login, so you never have to sign out to reach another one." },
        { title: "Pick the Account You Want to Trade", html: "Click an account to make it active. From that point, the DOM, chart order entry, Orders, and Positions all point at the account you selected. Your layouts and settings stay put as you jump between them." },
        { title: "Open the Group Editor", html: "Switching one at a time is fine for two accounts. Once you're running more than that, Tradovate's built-in <strong class='text-white'>Group Trade</strong> lets you send a single order to a whole set of accounts, and it's free. Open the <strong class='text-white'>Accounts</strong> dropdown again and choose <strong class='text-white'>Manage Groups</strong>. That opens the group editor, where you build and save as many groups as you want." },
        { title: "Create and Name a Group", html: "Click the <strong class='text-white'>+</strong> button to start a new group and give it a name you'll recognize on a busy day, something like \"Apex evals\" or \"Live set.\" Clear names save you from routing an order to the wrong pile of accounts." },
        { title: "Add Accounts and Set Each Quantity", html: "Drag the accounts you want from the list into your new group. Each account gets its own <strong class='text-white'>Qty</strong> value. Set every account to <strong class='text-white'>1</strong> and the group behaves predictably: the order splits evenly. Bump an account's Qty higher only if you want it to carry more size than the rest." },
        { title: "Select the Group and Place Your Order", html: "Save the group, then pick it from the <strong class='text-white'>Accounts</strong> dropdown just like you'd pick a single account. With a group active, the DOM and chart show the group's aggregated position, and Orders and Positions for every member show inside the platform. Here's the one rule that trips people up: your order quantity has to be a <strong class='text-white'>multiple of the group's total quantity</strong>." },
      ],
    },
    { type: "paragraph", html: "Say you have three accounts, each set to Qty 1 (total = 3). The order size you type controls how many contracts land in each account:" },
    { type: "table", headers: ["You enter", "Each account gets"], rows: [
      ["3", "1 contract"],
      ["6", "2 contracts"],
      ["9", "3 contracts"],
    ] },
    { type: "paragraph", html: "Enter a number that isn't a multiple of the total and the order won't distribute cleanly, so keep the math in mind before you click Buy or Sell." },
    { type: "heading", text: "A Few Things to Watch" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Same provider only.</strong> A group can only combine accounts from one brokerage provider. A direct Tradovate brokerage account and a prop evaluation account can't share a group, but two accounts from the same source can.",
        "<strong class='text-white'>No bracket/ATM strategies in a group.</strong> Group Trade doesn't carry ATM bracket orders across accounts, so plan to manage stops and targets on each account or handle exits manually.",
        "<strong class='text-white'>Mind the quantity rule.</strong> Always enter a multiple of the group total, or the split won't work as expected.",
        "<strong class='text-white'>Account counts vary.</strong> How many evaluation or funded accounts you can run at once depends on your prop firm and account size, check your firm's current rules before scaling up.",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Want stops, targets, and brackets copied across accounts too, or accounts from different firms trading together? <strong class='text-white'>PickMyTrade automates and copies trades across multiple accounts</strong>, no shared-provider restriction and no manual bracket rebuilding." },
  ], de: [
    { type: "paragraph",html: "Wenn Sie mit ein paar Prop-Evaluierungen und Ihrem eigenen finanzierten Konto jonglieren, ist das ständige Aus- und Einloggen schnell lästig. Das müssen Sie nicht. Alle Konten, auf die Sie Zugriff haben, liegen unter einem einzigen Tradovate-Login, und die Plattform bringt ein kostenloses Werkzeug mit, das dieselbe Order in alle gleichzeitig senden kann." },
    { type: "paragraph",html: "Dieser Leitfaden behandelt zwei Dinge: das Wechseln zwischen Konten per Klick und das Gruppieren mehrerer Konten, sodass eine Order sie gemeinsam handelt." },
    { type: "heading",text: "Wie sich Konten unter einem Login stapeln" },
    { type: "paragraph",html: "Nach dem Login zeigt Tradovate jedes Konto, das Sie erreichen können: ein persönliches Konto, ein simuliertes Konto sowie alle Prop-Evaluierungs- oder finanzierten Konten, die Ihre Firma zugewiesen hat. Für die meisten davon gibt es keinen separaten Schritt „Konto hinzufügen“; eine Prop-Firma verknüpft sie mit Ihrem Login, wenn Sie eine Evaluierung kaufen oder bestehen. Ein Vorbehalt wird später wichtig: Konten funktionieren nur zusammen, wenn sie beim selben Brokerage-Anbieter liegen." },
    { type: "heading",text: "Zwischen Konten wechseln und sie als Gruppe handeln" },
    {
      type: "steps",
      items: [
        { title: "Öffnen Sie das Konten-Dropdown", html: "Öffnen Sie oben in der Plattform das Dropdown <strong class='text-white'>Accounts</strong>. Es listet jedes Konto unter Ihrem Login auf, sodass Sie sich nie abmelden müssen, um ein anderes zu erreichen." },
        { title: "Wählen Sie das Konto, das Sie handeln möchten", html: "Klicken Sie auf ein Konto, um es zu aktivieren. Ab diesem Moment beziehen sich DOM, Chart-Ordereingabe, Orders und Positions auf das ausgewählte Konto. Ihre Layouts und Einstellungen bleiben beim Wechseln erhalten." },
        { title: "Öffnen Sie den Gruppeneditor", html: "Das Wechseln einzeln ist bei zwei Konten in Ordnung. Sobald Sie mehr betreiben, können Sie mit Tradovates integriertem <strong class='text-white'>Group Trade</strong> eine einzelne Order an eine ganze Reihe von Konten senden, und das ist kostenlos. Öffnen Sie das Dropdown <strong class='text-white'>Accounts</strong> erneut und wählen Sie <strong class='text-white'>Manage Groups</strong>. Dadurch öffnet sich der Gruppeneditor, in dem Sie beliebig viele Gruppen erstellen und speichern können." },
        { title: "Erstellen und benennen Sie eine Gruppe", html: "Klicken Sie auf die Schaltfläche <strong class='text-white'>+</strong>, um eine neue Gruppe zu beginnen, und geben Sie ihr einen Namen, den Sie an einem hektischen Tag erkennen, etwa „Apex-Evaluierungen“ oder „Live-Set“. Klare Namen bewahren Sie davor, eine Order an den falschen Haufen von Konten zu senden." },
        { title: "Konten hinzufügen und jeweils die Menge festlegen", html: "Ziehen Sie die gewünschten Konten aus der Liste in Ihre neue Gruppe. Jedes Konto erhält einen eigenen <strong class='text-white'>Qty</strong>-Wert. Stellen Sie jedes Konto auf <strong class='text-white'>1</strong>, und die Gruppe verhält sich vorhersehbar: Die Order wird gleichmäßig aufgeteilt. Erhöhen Sie die Qty eines Kontos nur, wenn es mehr Größe tragen soll als die übrigen." },
        { title: "Gruppe auswählen und Order platzieren", html: "Speichern Sie die Gruppe und wählen Sie sie dann im Dropdown <strong class='text-white'>Accounts</strong> aus, genau wie ein einzelnes Konto. Ist eine Gruppe aktiv, zeigen DOM und Chart die aggregierte Position der Gruppe, und Orders und Positions aller Mitglieder werden innerhalb der Plattform angezeigt. Hier ist die eine Regel, über die viele stolpern: Ihre Ordermenge muss ein <strong class='text-white'>Vielfaches der Gesamtmenge der Gruppe</strong> sein." },
      ],
    },
    { type: "paragraph",html: "Angenommen, Sie haben drei Konten mit jeweils Qty 1 (Summe = 3). Die eingegebene Ordergröße bestimmt, wie viele Kontrakte in jedem Konto landen:" },
    { type: "table", headers: ["Sie geben ein","Jedes Konto erhält"], rows: [
      ["3","1 Kontrakt"],
      ["6","2 Kontrakte"],
      ["9","3 Kontrakte"],
    ] },
    { type: "paragraph",html: "Geben Sie eine Zahl ein, die kein Vielfaches der Summe ist, wird die Order nicht sauber verteilt. Behalten Sie die Rechnung daher im Kopf, bevor Sie auf Buy oder Sell klicken." },
    { type: "heading",text: "Einige Punkte, auf die Sie achten sollten" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Nur derselbe Anbieter.</strong> Eine Gruppe kann nur Konten eines Brokerage-Anbieters kombinieren. Ein direktes Tradovate-Brokerage-Konto und ein Prop-Evaluierungskonto können keine Gruppe teilen, zwei Konten derselben Quelle dagegen schon.",
        "<strong class='text-white'>Keine Bracket-/ATM-Strategien in einer Gruppe.</strong> Group Trade übernimmt ATM-Bracket-Orders nicht auf andere Konten. Planen Sie daher, Stopps und Kursziele auf jedem Konto zu verwalten oder Ausstiege manuell vorzunehmen.",
        "<strong class='text-white'>Beachten Sie die Mengenregel.</strong> Geben Sie immer ein Vielfaches der Gruppensumme ein, sonst funktioniert die Aufteilung nicht wie erwartet.",
        "<strong class='text-white'>Kontoanzahl variiert.</strong> Wie viele Evaluierungs- oder finanzierte Konten Sie gleichzeitig betreiben können, hängt von Ihrer Prop-Firma und der Kontogröße ab. Prüfen Sie die aktuellen Regeln Ihrer Firma, bevor Sie skalieren.",
      ],
    },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "Sollen auch Stopps, Kursziele und Brackets über Konten hinweg kopiert werden, oder Konten verschiedener Firmen gemeinsam handeln? <strong class='text-white'>PickMyTrade automatisiert und kopiert Trades über mehrere Konten hinweg</strong>, ohne Beschränkung auf einen gemeinsamen Anbieter und ohne manuelles Neuaufbauen von Brackets." },
  ], es: [
    { type: "paragraph",html: "Si está manejando un par de evaluaciones de prop firm además de su propia cuenta financiada, cerrar e iniciar sesión todo el día se vuelve pesado. No tiene por qué hacerlo. Todas las cuentas a las que tiene acceso están bajo un único inicio de sesión de Tradovate, y la plataforma incluye una herramienta gratuita que puede lanzar la misma orden en todas a la vez." },
    { type: "paragraph",html: "Esta guía cubre dos cosas: cambiar entre cuentas con un clic y agrupar varias cuentas para que una sola orden las opere juntas." },
    { type: "heading",text: "Cómo se apilan las cuentas bajo un mismo inicio de sesión" },
    { type: "paragraph",html: "Al iniciar sesión, Tradovate muestra todas las cuentas a las que puede acceder: una cuenta personal, una cuenta simulada y cualquier cuenta de evaluación o financiada de prop firm que su firma haya vinculado. En la mayoría de los casos no hay un paso separado de «añadir cuenta»; la prop firm las vincula a su inicio de sesión cuando compra o supera una evaluación. Una salvedad importa más adelante: las cuentas solo funcionan juntas si pertenecen al mismo proveedor de brokerage." },
    { type: "heading",text: "Cambie entre sus cuentas y opérelas como grupo" },
    {
      type: "steps",
      items: [
        { title: "Abra el menú desplegable de cuentas", html: "En la parte superior de la plataforma, abra el menú desplegable <strong class='text-white'>Accounts</strong>. Muestra todas las cuentas bajo su inicio de sesión, así que nunca tiene que cerrar sesión para acceder a otra." },
        { title: "Elija la cuenta con la que quiere operar", html: "Haga clic en una cuenta para activarla. Desde ese momento, el DOM, la entrada de órdenes del gráfico, Orders y Positions apuntan a la cuenta seleccionada. Sus diseños y ajustes se mantienen al saltar entre ellas." },
        { title: "Abra el editor de grupos", html: "Cambiar de una en una está bien con dos cuentas. Cuando maneja más, el <strong class='text-white'>Group Trade</strong> integrado de Tradovate le permite enviar una sola orden a un conjunto completo de cuentas, y es gratuito. Abra de nuevo el menú desplegable <strong class='text-white'>Accounts</strong> y elija <strong class='text-white'>Manage Groups</strong>. Se abre el editor de grupos, donde puede crear y guardar tantos grupos como quiera." },
        { title: "Cree y nombre un grupo", html: "Haga clic en el botón <strong class='text-white'>+</strong> para iniciar un nuevo grupo y póngale un nombre que reconozca en un día ajetreado, como «Evaluaciones Apex» o «Conjunto live». Los nombres claros evitan que enrute una orden al montón de cuentas equivocado." },
        { title: "Añada cuentas y defina la cantidad de cada una", html: "Arrastre las cuentas que quiera desde la lista a su nuevo grupo. Cada cuenta tiene su propio valor de <strong class='text-white'>Qty</strong>. Si configura cada cuenta en <strong class='text-white'>1</strong>, el grupo se comporta de forma predecible: la orden se reparte por igual. Aumente la Qty de una cuenta solo si quiere que lleve más tamaño que las demás." },
        { title: "Seleccione el grupo y envíe su orden", html: "Guarde el grupo y elíjalo en el menú desplegable <strong class='text-white'>Accounts</strong> igual que elegiría una cuenta individual. Con un grupo activo, el DOM y el gráfico muestran la posición agregada del grupo, y Orders y Positions de cada miembro se muestran dentro de la plataforma. Esta es la regla que hace tropezar a la gente: la cantidad de su orden debe ser un <strong class='text-white'>múltiplo de la cantidad total del grupo</strong>." },
      ],
    },
    { type: "paragraph",html: "Digamos que tiene tres cuentas, cada una con Qty 1 (total = 3). El tamaño de orden que escribe controla cuántos contratos llegan a cada cuenta:" },
    { type: "table", headers: ["Usted introduce","Cada cuenta recibe"], rows: [
      ["3","1 contrato"],
      ["6","2 contratos"],
      ["9","3 contratos"],
    ] },
    { type: "paragraph",html: "Si introduce un número que no es múltiplo del total, la orden no se distribuirá de forma limpia, así que tenga presente la cuenta antes de hacer clic en Buy o Sell." },
    { type: "heading",text: "Algunos puntos a tener en cuenta" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Solo el mismo proveedor.</strong> Un grupo solo puede combinar cuentas de un mismo proveedor de brokerage. Una cuenta de brokerage directa de Tradovate y una cuenta de evaluación de prop firm no pueden compartir grupo, pero dos cuentas del mismo origen sí.",
        "<strong class='text-white'>Sin estrategias bracket/ATM en un grupo.</strong> Group Trade no traslada las órdenes bracket ATM entre cuentas, así que planifique gestionar stops y objetivos en cada cuenta o manejar las salidas manualmente.",
        "<strong class='text-white'>Tenga presente la regla de cantidad.</strong> Introduzca siempre un múltiplo del total del grupo, o el reparto no funcionará como espera.",
        "<strong class='text-white'>El número de cuentas varía.</strong> Cuántas cuentas de evaluación o financiadas puede operar a la vez depende de su prop firm y del tamaño de la cuenta; revise las reglas vigentes de su firma antes de escalar.",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "¿Quiere que también se copien stops, objetivos y brackets entre cuentas, o que operen juntas cuentas de distintas firmas? <strong class='text-white'>PickMyTrade automatiza y copia operaciones entre varias cuentas</strong>, sin restricción de proveedor compartido y sin reconstruir brackets a mano." },
  ], fr: [
    { type: "paragraph",html: "Si vous jonglez avec quelques évaluations prop firm en plus de votre propre compte financé, se déconnecter et se reconnecter toute la journée devient vite pénible. Ce n’est pas nécessaire. Tous les comptes auxquels vous avez accès se trouvent sous une seule connexion Tradovate, et la plateforme propose un outil gratuit capable d’envoyer le même ordre sur tous à la fois." },
    { type: "paragraph",html: "Ce guide couvre deux choses : passer d’un compte à l’autre en un clic et regrouper plusieurs comptes afin qu’un seul ordre les trade ensemble." },
    { type: "heading",text: "Comment les comptes s’empilent sous une même connexion" },
    { type: "paragraph",html: "Une fois connecté, Tradovate affiche tous les comptes auxquels vous avez accès : un compte personnel, un compte simulé et tous les comptes d’évaluation prop ou financés que votre société a rattachés. Il n’y a pas d’étape distincte « ajouter un compte » pour la plupart d’entre eux ; une prop firm les lie à votre connexion lorsque vous achetez ou réussissez une évaluation. Une réserve compte plus tard : les comptes ne fonctionnent ensemble que s’ils relèvent du même fournisseur de brokerage." },
    { type: "heading",text: "Passez d’un compte à l’autre et tradez-les en groupe" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez la liste déroulante des comptes", html: "En haut de la plateforme, ouvrez la liste déroulante <strong class='text-white'>Accounts</strong>. Elle affiche tous les comptes liés à votre connexion, de sorte que vous n’avez jamais à vous déconnecter pour en rejoindre un autre." },
        { title: "Choisissez le compte que vous voulez trader", html: "Cliquez sur un compte pour l’activer. À partir de là, le DOM, la saisie d’ordres sur le graphique, Orders et Positions pointent vers le compte sélectionné. Vos mises en page et vos paramètres restent en place lorsque vous passez de l’un à l’autre." },
        { title: "Ouvrez l’éditeur de groupes", html: "Passer d’un compte à l’autre est correct avec deux comptes. Dès que vous en gérez davantage, le <strong class='text-white'>Group Trade</strong> intégré de Tradovate vous permet d’envoyer un seul ordre à tout un ensemble de comptes, et c’est gratuit. Ouvrez à nouveau la liste déroulante <strong class='text-white'>Accounts</strong> et choisissez <strong class='text-white'>Manage Groups</strong>. L’éditeur de groupes s’ouvre ; vous pouvez y créer et enregistrer autant de groupes que vous le souhaitez." },
        { title: "Créez et nommez un groupe", html: "Cliquez sur le bouton <strong class='text-white'>+</strong> pour créer un nouveau groupe et donnez-lui un nom que vous reconnaîtrez un jour agité, par exemple « Évaluations Apex » ou « Comptes live ». Des noms clairs vous évitent d’envoyer un ordre vers le mauvais lot de comptes." },
        { title: "Ajoutez des comptes et définissez la quantité de chacun", html: "Faites glisser les comptes souhaités de la liste vers votre nouveau groupe. Chaque compte possède sa propre valeur <strong class='text-white'>Qty</strong>. Réglez chaque compte sur <strong class='text-white'>1</strong> et le groupe se comporte de façon prévisible : l’ordre se répartit à parts égales. N’augmentez la Qty d’un compte que si vous voulez qu’il porte plus de taille que les autres." },
        { title: "Sélectionnez le groupe et passez votre ordre", html: "Enregistrez le groupe, puis choisissez-le dans la liste déroulante <strong class='text-white'>Accounts</strong> comme vous le feriez pour un compte unique. Lorsqu’un groupe est actif, le DOM et le graphique affichent la position agrégée du groupe, et Orders et Positions de chaque membre s’affichent dans la plateforme. Voici la règle qui piège beaucoup de monde : la quantité de votre ordre doit être un <strong class='text-white'>multiple de la quantité totale du groupe</strong>." },
      ],
    },
    { type: "paragraph",html: "Supposons que vous ayez trois comptes, chacun réglé sur Qty 1 (total = 3). La taille d’ordre que vous saisissez détermine le nombre de contrats qui arrivent dans chaque compte :" },
    { type: "table", headers: ["Vous saisissez","Chaque compte reçoit"], rows: [
      ["3","1 contrat"],
      ["6","2 contrats"],
      ["9","3 contrats"],
    ] },
    { type: "paragraph",html: "Si vous saisissez un nombre qui n’est pas un multiple du total, l’ordre ne se répartira pas proprement ; gardez donc le calcul en tête avant de cliquer sur Buy ou Sell." },
    { type: "heading",text: "Quelques points de vigilance" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Même fournisseur uniquement.</strong> Un groupe ne peut combiner que des comptes d’un seul fournisseur de brokerage. Un compte de brokerage Tradovate direct et un compte d’évaluation prop ne peuvent pas partager un groupe, mais deux comptes de la même source le peuvent.",
        "<strong class='text-white'>Pas de stratégies bracket/ATM dans un groupe.</strong> Group Trade ne reporte pas les ordres bracket ATM d’un compte à l’autre ; prévoyez donc de gérer les stops et les objectifs sur chaque compte ou de gérer les sorties manuellement.",
        "<strong class='text-white'>Respectez la règle de quantité.</strong> Saisissez toujours un multiple du total du groupe, faute de quoi la répartition ne fonctionnera pas comme prévu.",
        "<strong class='text-white'>Le nombre de comptes varie.</strong> Le nombre de comptes d’évaluation ou financés que vous pouvez gérer en même temps dépend de votre prop firm et de la taille du compte ; vérifiez les règles en vigueur de votre société avant de monter en charge.",
      ],
    },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Vous voulez que les stops, les objectifs et les brackets soient aussi copiés entre comptes, ou que des comptes de sociétés différentes tradent ensemble ? <strong class='text-white'>PickMyTrade automatise et copie les trades sur plusieurs comptes</strong>, sans restriction de fournisseur commun et sans reconstruction manuelle des brackets." },
  ], it: [
