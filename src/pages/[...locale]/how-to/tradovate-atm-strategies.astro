---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-atm-strategies";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Set Up ATM Strategies (Auto Bracket Orders)";
const META_DESCRIPTION =
  "Tradovate ATM strategies save a named bracket that auto-places your stop loss and profit target as an OCO the second your entry order fills.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "ATM-Strategien (automatische Bracket-Orders) einrichten", es: "Configurar estrategias ATM (órdenes bracket automáticas)", fr: "Configurer des stratégies ATM (ordres bracket automatiques)", it: "Configurare le strategie ATM (ordini bracket automatici)" },
  dek: { en: "Tired of rebuilding the same stop loss and profit target on every single trade? Set up an ATM strategy once, and Tradovate drops your full bracket onto the position the instant your entry fills.", de: "Sie haben es satt, bei jedem Trade denselben Stop-Loss und dasselbe Gewinnziel neu aufzubauen? Richten Sie eine ATM-Strategie einmal ein, und Tradovate legt Ihr komplettes Bracket auf die Position, sobald Ihr Einstieg ausgeführt wird.", es: "¿Cansado de reconstruir el mismo stop loss y objetivo de beneficio en cada operación? Configure una estrategia ATM una sola vez y Tradovate coloca su bracket completo sobre la posición en cuanto se ejecuta su entrada.", fr: "Vous en avez assez de reconstruire le même stop loss et le même objectif de profit à chaque trade ? Configurez une stratégie ATM une seule fois, et Tradovate place votre bracket complet sur la position dès que votre entrée est exécutée.", it: "Stanco di ricostruire lo stesso stop loss e lo stesso obiettivo di profitto a ogni singolo trade? Configuri una strategia ATM una sola volta e Tradovate applica il suo bracket completo alla posizione nell'istante in cui il suo ingresso viene eseguito." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Tired of rebuilding the same stop loss and profit target on every single trade? An ATM strategy fixes that. You set it up once, and Tradovate drops your full bracket onto the position the instant your entry fills. Here's exactly how to build one." },
    { type: "heading", text: "What Is an ATM Strategy?" },
    { type: "paragraph", html: "ATM stands for Advanced Trade Management. It's a saved profile that clips a stop loss and a profit target onto your position the moment your entry order fills. Those two exit legs are linked as an OCO, One-Cancels-the-Other, so when either one fills, Tradovate kills the remaining order for you. Build the profile once, give it a name, and reuse it on any Chart or SuperDOM." },
    { type: "heading", text: "Set Up ATM Strategies in Tradovate: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open ATM Settings", html: "On a Chart or SuperDOM module, look in the order-entry area for the ATM dropdown. Right next to it you'll spot a settings cogwheel, click it to open the ATM Settings panel." },
        { title: "Create and Name a New Strategy", html: "Hit the plus (+) button to add a new strategy, then name it something you'll recognize at a glance, \"ES 2T Scalp,\" for example. A clear name saves you from second-guessing which bracket you're grabbing from the dropdown mid-trade." },
        { title: "Choose Your Unit, Ticks, Delta Price, or $Value", html: "Decide how you want your distances measured. Tradovate gives you three options, Ticks, Delta Price, or a dollar ($Value) amount, and it measures in ticks by default. Pick whichever unit matches how you actually think about risk." },
        { title: "Enter Your Stop Loss and Profit Target", html: "Type in your stop loss and profit target distances. You're free to set both, a stop loss only, or a profit target only. The profit target goes in as a limit order, and the stop type is yours to choose, a plain Stop (stop-market), a Stop Limit with a limit offset, a Trailing Stop, or Auto Breakeven, plus a few other variations." },
        { title: "Add Multiple Targets to Scale Out (Optional)", html: "Want to scale out? Click the plus button beside the target row to add a second (or third) profit target, then split your quantity across them, bank part of the position at the first target and let the rest ride to a further one. Each target fills independently, the shared stop keeps protecting whatever contracts are still open, and the whole set stays OCO-linked." },
        { title: "Save, Select, and Place Your Trade", html: "Save the strategy, then pick it from the ATM dropdown on your Chart or SuperDOM. Place your entry the way you normally would, the moment it fills, Tradovate drops the stop loss and profit target(s) in as an OCO bracket. No scrambling, no manual clicks." },
      ],
    },
    { type: "heading", text: "Why You'd Need This" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Consistency</strong>, the same risk/reward gets applied to every trade automatically.",
        "<strong class='text-white'>Speed</strong>, no rebuilding a bracket by hand while price is moving.",
        "<strong class='text-white'>Scaling out</strong>, multiple targets let you bank partial profits and let a runner ride.",
        "<strong class='text-white'>Hands-free exits</strong>, the OCO logic closes the position one way or the other.",
        "<strong class='text-white'>Discipline</strong>, pre-set stops keep you inside your own (and your prop firm's) limits.",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "ATM strategies handle the exit bracket once you're in a trade, but the entry still needs a click. <strong class='text-white'>PickMyTrade links your TradingView alerts straight to your Tradovate account</strong>, so entries fire automatically and your bracket exits follow the same discipline every time, with no manual clicks." },
  ], de: [
    { type: "paragraph",html: "Sie haben es satt, bei jedem Trade denselben Stop-Loss und dasselbe Gewinnziel neu aufzubauen? Eine ATM-Strategie löst das. Sie richten sie einmal ein, und Tradovate legt Ihr komplettes Bracket auf die Position, sobald Ihr Einstieg ausgeführt wird. So bauen Sie eine auf." },
    { type: "heading",text: "Was ist eine ATM-Strategie?" },
    { type: "paragraph",html: "ATM steht für Advanced Trade Management. Es ist ein gespeichertes Profil, das einen Stop-Loss und ein Gewinnziel an Ihre Position hängt, sobald Ihre Einstiegsorder ausgeführt wird. Diese beiden Exit-Legs sind als OCO verknüpft, One-Cancels-the-Other: Wird eines ausgeführt, löscht Tradovate die verbleibende Order für Sie. Erstellen Sie das Profil einmal, geben Sie ihm einen Namen und verwenden Sie es in jedem Chart oder SuperDOM." },
    { type: "heading",text: "ATM-Strategien in Tradovate einrichten: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "ATM Settings öffnen", html: "Suchen Sie in einem Chart- oder SuperDOM-Modul im Bereich der Ordereingabe nach dem ATM-Dropdown. Direkt daneben finden Sie ein Zahnrad-Symbol für die Einstellungen. Klicken Sie darauf, um das Fenster ATM Settings zu öffnen." },
        { title: "Neue Strategie erstellen und benennen", html: "Klicken Sie auf die Plus-Schaltfläche (+), um eine neue Strategie hinzuzufügen, und geben Sie ihr einen Namen, den Sie auf einen Blick erkennen, etwa „ES 2T Scalp“. Ein klarer Name erspart Ihnen mitten im Trade das Rätseln, welches Bracket Sie gerade aus dem Dropdown wählen." },
        { title: "Einheit wählen: Ticks, Delta Price oder $Value", html: "Legen Sie fest, wie Ihre Abstände gemessen werden sollen. Tradovate bietet drei Optionen: Ticks, Delta Price oder einen Dollarbetrag ($Value); standardmäßig wird in Ticks gemessen. Wählen Sie die Einheit, die dazu passt, wie Sie tatsächlich über Risiko denken." },
        { title: "Stop-Loss und Gewinnziel eingeben", html: "Geben Sie Ihre Abstände für Stop-Loss und Gewinnziel ein. Sie können beides setzen, nur einen Stop-Loss oder nur ein Gewinnziel. Das Gewinnziel wird als Limit-Order platziert, und den Stop-Typ wählen Sie selbst: einen einfachen Stop (Stop-Market), einen Stop Limit mit Limit-Abstand, einen Trailing Stop oder Auto Breakeven, plus einige weitere Varianten." },
        { title: "Mehrere Ziele zum gestaffelten Ausstieg hinzufügen (optional)", html: "Möchten Sie gestaffelt aussteigen? Klicken Sie auf die Plus-Schaltfläche neben der Zielzeile, um ein zweites (oder drittes) Gewinnziel hinzuzufügen, und verteilen Sie dann Ihre Menge darauf: Nehmen Sie einen Teil der Position am ersten Ziel mit und lassen Sie den Rest bis zu einem weiter entfernten Ziel laufen. Jedes Ziel wird unabhängig ausgeführt, der gemeinsame Stop schützt weiterhin die noch offenen Kontrakte, und das gesamte Set bleibt OCO-verknüpft." },
        { title: "Speichern, auswählen und Trade platzieren", html: "Speichern Sie die Strategie und wählen Sie sie dann im ATM-Dropdown Ihres Charts oder SuperDOM aus. Platzieren Sie Ihren Einstieg wie gewohnt; sobald er ausgeführt wird, legt Tradovate Stop-Loss und Gewinnziel(e) als OCO-Bracket an. Kein Gehetze, keine manuellen Klicks." },
      ],
    },
    { type: "heading",text: "Warum Sie das brauchen" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Konsistenz</strong>, dasselbe Chance-Risiko-Verhältnis wird automatisch auf jeden Trade angewendet.",
        "<strong class='text-white'>Geschwindigkeit</strong>, kein manuelles Neuaufbauen eines Brackets, während sich der Preis bewegt.",
        "<strong class='text-white'>Gestaffelter Ausstieg</strong>, mit mehreren Zielen nehmen Sie Teilgewinne mit und lassen einen Runner laufen.",
        "<strong class='text-white'>Freihändige Exits</strong>, die OCO-Logik schließt die Position so oder so.",
        "<strong class='text-white'>Disziplin</strong>, voreingestellte Stops halten Sie innerhalb Ihrer eigenen (und der Limits Ihrer Prop-Firma).",
      ],
    },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "ATM-Strategien kümmern sich um das Exit-Bracket, sobald Sie in einem Trade sind, aber der Einstieg braucht weiterhin einen Klick. <strong class='text-white'>PickMyTrade verbindet Ihre TradingView-Alerts direkt mit Ihrem Tradovate-Konto</strong>, sodass Einstiege automatisch ausgelöst werden und Ihre Bracket-Exits jedes Mal derselben Disziplin folgen, ohne manuelle Klicks." },
  ], es: [
    { type: "paragraph",html: "¿Cansado de reconstruir el mismo stop loss y objetivo de beneficio en cada operación? Una estrategia ATM lo soluciona. La configura una vez y Tradovate coloca su bracket completo sobre la posición en cuanto se ejecuta su entrada. Así se crea una." },
    { type: "heading",text: "¿Qué es una estrategia ATM?" },
    { type: "paragraph",html: "ATM significa Advanced Trade Management. Es un perfil guardado que añade un stop loss y un objetivo de beneficio a su posición en el momento en que se ejecuta su orden de entrada. Esas dos patas de salida están vinculadas como OCO, One-Cancels-the-Other, de modo que cuando una se ejecuta, Tradovate cancela por usted la orden restante. Cree el perfil una vez, póngale un nombre y reutilícelo en cualquier gráfico o SuperDOM." },
    { type: "heading",text: "Configurar estrategias ATM en Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra ATM Settings", html: "En un módulo de gráfico o SuperDOM, busque en el área de introducción de órdenes el desplegable ATM. Justo al lado verá una rueda de ajustes; haga clic en ella para abrir el panel ATM Settings." },
        { title: "Cree y nombre una estrategia nueva", html: "Pulse el botón más (+) para añadir una estrategia nueva y póngale un nombre que reconozca de un vistazo, por ejemplo «ES 2T Scalp». Un nombre claro le evita dudar en plena operación sobre qué bracket está eligiendo en el desplegable." },
        { title: "Elija su unidad: Ticks, Delta Price o $Value", html: "Decida cómo quiere medir sus distancias. Tradovate ofrece tres opciones: Ticks, Delta Price o un importe en dólares ($Value), y mide en ticks por defecto. Elija la unidad que se ajuste a cómo piensa realmente en el riesgo." },
        { title: "Introduzca su stop loss y su objetivo de beneficio", html: "Escriba las distancias de su stop loss y de su objetivo de beneficio. Puede fijar ambos, solo un stop loss o solo un objetivo de beneficio. El objetivo de beneficio se introduce como orden limitada y el tipo de stop lo elige usted: un Stop simple (stop de mercado), un Stop Limit con un desplazamiento límite, un Trailing Stop o Auto Breakeven, además de algunas otras variantes." },
        { title: "Añada varios objetivos para cerrar parcialmente (opcional)", html: "¿Quiere cerrar parcialmente? Haga clic en el botón más junto a la fila del objetivo para añadir un segundo (o tercer) objetivo de beneficio y reparta su cantidad entre ellos: asegure parte de la posición en el primer objetivo y deje correr el resto hasta uno más lejano. Cada objetivo se ejecuta de forma independiente, el stop compartido sigue protegiendo los contratos aún abiertos y todo el conjunto permanece vinculado como OCO." },
        { title: "Guarde, seleccione y coloque su operación", html: "Guarde la estrategia y selecciónela en el desplegable ATM de su gráfico o SuperDOM. Coloque su entrada como lo hace normalmente: en cuanto se ejecuta, Tradovate coloca el stop loss y el o los objetivos de beneficio como un bracket OCO. Sin prisas, sin clics manuales." },
      ],
    },
    { type: "heading",text: "Por qué lo necesita" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Coherencia</strong>, la misma relación riesgo/beneficio se aplica automáticamente a cada operación.",
        "<strong class='text-white'>Rapidez</strong>, sin reconstruir un bracket a mano mientras el precio se mueve.",
        "<strong class='text-white'>Cierres parciales</strong>, varios objetivos le permiten asegurar beneficios parciales y dejar correr un runner.",
        "<strong class='text-white'>Salidas sin intervención</strong>, la lógica OCO cierra la posición de un modo u otro.",
        "<strong class='text-white'>Disciplina</strong>, los stops preestablecidos le mantienen dentro de sus propios límites (y de los de su prop firm).",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Las estrategias ATM se encargan del bracket de salida una vez que está dentro de una operación, pero la entrada sigue necesitando un clic. <strong class='text-white'>PickMyTrade vincula sus alertas de TradingView directamente con su cuenta de Tradovate</strong>, de modo que las entradas se disparan automáticamente y sus salidas bracket siguen la misma disciplina cada vez, sin clics manuales." },
  ], fr: [
    { type: "paragraph",html: "Vous en avez assez de reconstruire le même stop loss et le même objectif de profit à chaque trade ? Une stratégie ATM règle cela. Vous la configurez une fois, et Tradovate place votre bracket complet sur la position dès que votre entrée est exécutée. Voici exactement comment en créer une." },
    { type: "heading",text: "Qu'est-ce qu'une stratégie ATM ?" },
    { type: "paragraph",html: "ATM signifie Advanced Trade Management. C'est un profil enregistré qui fixe un stop loss et un objectif de profit à votre position dès l'exécution de votre ordre d'entrée. Ces deux jambes de sortie sont liées en OCO, One-Cancels-the-Other : lorsque l'une est exécutée, Tradovate annule l'ordre restant pour vous. Créez le profil une fois, donnez-lui un nom et réutilisez-le sur n'importe quel graphique ou SuperDOM." },
    { type: "heading",text: "Configurer des stratégies ATM dans Tradovate : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez ATM Settings", html: "Sur un module Chart ou SuperDOM, repérez dans la zone de saisie d'ordres la liste déroulante ATM. Juste à côté, vous verrez une roue dentée de paramètres ; cliquez dessus pour ouvrir le panneau ATM Settings." },
        { title: "Créez et nommez une nouvelle stratégie", html: "Cliquez sur le bouton plus (+) pour ajouter une nouvelle stratégie, puis donnez-lui un nom que vous reconnaîtrez d'un coup d'œil, par exemple « ES 2T Scalp ». Un nom clair vous évite d'hésiter, en plein trade, sur le bracket que vous sélectionnez dans la liste déroulante." },
        { title: "Choisissez votre unité : Ticks, Delta Price ou $Value", html: "Décidez comment vous voulez mesurer vos distances. Tradovate propose trois options, Ticks, Delta Price ou un montant en dollars ($Value), et mesure en ticks par défaut. Choisissez l'unité qui correspond à votre façon de penser le risque." },
        { title: "Saisissez votre stop loss et votre objectif de profit", html: "Saisissez les distances de votre stop loss et de votre objectif de profit. Vous pouvez définir les deux, un stop loss seul ou un objectif de profit seul. L'objectif de profit est placé comme ordre à cours limité, et le type de stop est à votre choix : un Stop simple (stop au marché), un Stop Limit avec un décalage limite, un Trailing Stop ou Auto Breakeven, ainsi que quelques autres variantes." },
        { title: "Ajoutez plusieurs objectifs pour sortir progressivement (facultatif)", html: "Vous voulez sortir progressivement ? Cliquez sur le bouton plus à côté de la ligne de l'objectif pour ajouter un deuxième (ou troisième) objectif de profit, puis répartissez votre quantité entre eux : encaissez une partie de la position au premier objectif et laissez le reste courir vers un objectif plus éloigné. Chaque objectif est exécuté indépendamment, le stop partagé continue de protéger les contrats encore ouverts et l'ensemble reste lié en OCO." },
        { title: "Enregistrez, sélectionnez et passez votre trade", html: "Enregistrez la stratégie, puis sélectionnez-la dans la liste déroulante ATM de votre graphique ou SuperDOM. Passez votre entrée comme d'habitude : dès qu'elle est exécutée, Tradovate place le stop loss et le ou les objectifs de profit sous forme de bracket OCO. Pas de précipitation, pas de clics manuels." },
      ],
    },
    { type: "heading",text: "Pourquoi en avez-vous besoin" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Cohérence</strong>, le même ratio risque/rendement est appliqué automatiquement à chaque trade.",
        "<strong class='text-white'>Rapidité</strong>, plus besoin de reconstruire un bracket à la main pendant que le prix bouge.",
        "<strong class='text-white'>Sorties progressives</strong>, plusieurs objectifs permettent d'encaisser des profits partiels et de laisser courir un runner.",
        "<strong class='text-white'>Sorties automatiques</strong>, la logique OCO clôture la position dans un sens ou dans l'autre.",
        "<strong class='text-white'>Discipline</strong>, des stops prédéfinis vous maintiennent dans vos propres limites (et dans celles de votre prop firm).",
      ],
    },
    { type: "heading",text: "Automatisez tout cela avec PickMyTrade" },
    { type: "paragraph",html: "Les stratégies ATM gèrent le bracket de sortie une fois que vous êtes dans un trade, mais l'entrée nécessite encore un clic. <strong class='text-white'>PickMyTrade relie vos alertes TradingView directement à votre compte Tradovate</strong> : les entrées se déclenchent automatiquement et vos sorties bracket suivent chaque fois la même discipline, sans clics manuels." },
  ], it: [
    { type: "paragraph",html: "Stanco di ricostruire lo stesso stop loss e lo stesso obiettivo di profitto a ogni singolo trade? Una strategia ATM risolve il problema. La configura una volta e Tradovate applica il suo bracket completo alla posizione nell'istante in cui il suo ingresso viene eseguito. Ecco esattamente come crearne una." },
    { type: "heading",text: "Che cos'è una strategia ATM?" },
    { type: "paragraph",html: "ATM sta per Advanced Trade Management. È un profilo salvato che applica uno stop loss e un obiettivo di profitto alla sua posizione nel momento in cui il suo ordine di ingresso viene eseguito. Queste due gambe di uscita sono collegate come OCO, One-Cancels-the-Other, quindi quando una viene eseguita, Tradovate annulla l'ordine rimanente per lei. Crei il profilo una volta, gli dia un nome e lo riutilizzi su qualsiasi Chart o SuperDOM." },
    { type: "heading",text: "Configurare le strategie ATM in Tradovate: guida passo passo" },
    {
      type: "steps",
      items: [
        { title: "Apra ATM Settings", html: "Su un modulo Chart o SuperDOM, cerchi nell'area di inserimento ordini il menu a tendina ATM. Subito accanto troverà l'icona a ingranaggio delle impostazioni: ci clicchi per aprire il pannello ATM Settings." },
        { title: "Crei e assegni un nome a una nuova strategia", html: "Prema il pulsante più (+) per aggiungere una nuova strategia, poi le dia un nome che riconosca a colpo d'occhio, ad esempio «ES 2T Scalp». Un nome chiaro le evita dubbi, in piena operazione, su quale bracket sta scegliendo dal menu a tendina." },
        { title: "Scelga l'unità: Ticks, Delta Price o $Value", html: "Decida come vuole misurare le distanze. Tradovate offre tre opzioni, Ticks, Delta Price o un importo in dollari ($Value), e misura in tick per impostazione predefinita. Scelga l'unità che corrisponde a come lei ragiona davvero sul rischio." },
        { title: "Inserisca stop loss e obiettivo di profitto", html: "Digiti le distanze di stop loss e obiettivo di profitto. Può impostare entrambi, solo uno stop loss o solo un obiettivo di profitto. L'obiettivo di profitto viene inserito come ordine limite e il tipo di stop lo sceglie lei: un semplice Stop (stop a mercato), uno Stop Limit con un offset limite, un Trailing Stop o Auto Breakeven, oltre ad alcune altre varianti." },
        { title: "Aggiunga più obiettivi per uscire gradualmente (facoltativo)", html: "Vuole uscire gradualmente? Clicchi sul pulsante più accanto alla riga dell'obiettivo per aggiungere un secondo (o terzo) obiettivo di profitto, poi ripartisca la quantità tra di essi: incassi parte della posizione al primo obiettivo e lasci correre il resto verso uno più lontano. Ogni obiettivo viene eseguito in modo indipendente, lo stop condiviso continua a proteggere i contratti ancora aperti e l'intero insieme resta collegato in OCO." },
        { title: "Salvi, selezioni e inserisca l'operazione", html: "Salvi la strategia, poi la selezioni dal menu a tendina ATM del suo Chart o SuperDOM. Inserisca l'ingresso come fa di solito: nel momento in cui viene eseguito, Tradovate inserisce stop loss e obiettivo/i di profitto come bracket OCO. Nessuna fretta, nessun clic manuale." },
      ],
    },
    { type: "heading",text: "Perché le serve" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Coerenza</strong>, lo stesso rapporto rischio/rendimento viene applicato automaticamente a ogni trade.",
        "<strong class='text-white'>Velocità</strong>, niente più ricostruzione manuale di un bracket mentre il prezzo si muove.",
        "<strong class='text-white'>Uscite graduali</strong>, più obiettivi consentono di incassare profitti parziali e lasciar correre un runner.",
        "<strong class='text-white'>Uscite automatiche</strong>, la logica OCO chiude la posizione in un modo o nell'altro.",
        "<strong class='text-white'>Disciplina</strong>, gli stop preimpostati la mantengono entro i suoi limiti (e quelli della sua prop firm).",
      ],
    },
    { type: "heading",text: "Automatizzi tutto questo con PickMyTrade" },
    { type: "paragraph",html: "Le strategie ATM gestiscono il bracket di uscita una volta entrato in un trade, ma l'ingresso richiede ancora un clic. <strong class='text-white'>PickMyTrade collega i suoi alert di TradingView direttamente al suo conto Tradovate</strong>, così gli ingressi partono automaticamente e le sue uscite bracket seguono ogni volta la stessa disciplina, senza clic manuali." },
  ] },
  ctaHeading: { en: "Automate the Entry Too", de: "Automatisieren Sie auch den Einstieg", es: "Automatice también la entrada", fr: "Automatisez aussi l'entrée", it: "Automatizzi anche l'ingresso" },
  ctaText: { en: "ATM strategies handle the exit bracket. Let PickMyTrade fire the entry automatically from your TradingView alerts.", de: "ATM-Strategien kümmern sich um das Exit-Bracket. Lassen Sie PickMyTrade den Einstieg automatisch aus Ihren TradingView-Alerts auslösen.", es: "Las estrategias ATM se encargan del bracket de salida. Deje que PickMyTrade dispare la entrada automáticamente desde sus alertas de TradingView.", fr: "Les stratégies ATM gèrent le bracket de sortie. Laissez PickMyTrade déclencher automatiquement l'entrée à partir de vos alertes TradingView.", it: "Le strategie ATM gestiscono il bracket di uscita. Lasci che PickMyTrade attivi automaticamente l'ingresso dai suoi alert di TradingView." },
