---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-order-flags";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Set Order Flags: DAY, GTC & GTD in Tradovate";
const META_DESCRIPTION =
  "Switch Tradovate order flags between DAY, GTC, and GTD, and set custom cancel or release times from the Order Flag Settings menu.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Order-Flags festlegen: DAY, GTC & GTD in Tradovate", es: "Configurar los indicadores de orden: DAY, GTC y GTD en Tradovate", fr: "Définir les indicateurs d’ordre : DAY, GTC et GTD dans Tradovate", it: "Impostare i flag degli ordini: DAY, GTC e GTD in Tradovate" },
  dek: { en: "An order flag decides how long your working order stays alive. Tradovate keeps all of this behind one small cogwheel, and once you know where it lives you can switch between DAY, GTC, and GTD in a couple of clicks.", de: "Ein Order-Flag bestimmt, wie lange Ihre aktive Order gültig bleibt. Tradovate bündelt alles hinter einem kleinen Zahnrad, und sobald Sie wissen, wo es sitzt, wechseln Sie mit wenigen Klicks zwischen DAY, GTC und GTD.", es: "Un indicador de orden decide cuánto tiempo permanece activa su orden. Tradovate lo agrupa todo tras una pequeña rueda dentada y, una vez que sabe dónde está, puede cambiar entre DAY, GTC y GTD en un par de clics.", fr: "Un indicateur d’ordre détermine combien de temps votre ordre en attente reste actif. Tradovate regroupe tout cela derrière une petite roue dentée et, une fois que vous savez où elle se trouve, vous passez de DAY à GTC ou GTD en quelques clics.", it: "Un flag dell’ordine decide per quanto tempo il suo ordine in lavorazione resta attivo. Tradovate raccoglie tutto dietro una piccola rotellina e, una volta che sa dove si trova, può passare tra DAY, GTC e GTD in un paio di clic." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-10",
  blocks: { en: [
    { type: "paragraph", html: "An order flag decides how long your working order stays alive. Get it wrong and a resting limit either vanishes at the session close or hangs around for days after you've forgotten it. Tradovate keeps all of this behind one small cogwheel, and once you know where it lives you can switch between DAY, GTC, and GTD in a couple of clicks, or schedule an order to cancel or fire on its own." },
    { type: "heading", text: "What Are Order Flags?" },
    { type: "paragraph", html: "The order flag is Tradovate's name for time in force, the rule that controls how long an unfilled order keeps working before it expires. You set it when you build the order, and it only matters for orders that rest in the book, like limit and stop orders. Here are the three you'll use:" },
    {
      type: "table",
      headers: ["Flag", "Full name", "Stays working until…"],
      rows: [
        ["DAY", "Day order", "The end of the current trading session, then it's cancelled automatically."],
        ["GTC", "Good Till Canceled", "You cancel it by hand. It carries across sessions until it fills or you pull it."],
        ["GTD", "Good Till Date", "The session close on a date you choose. A date/time picker appears when you select it."],
      ],
    },
    { type: "quote", html: "Prop and evaluation accounts often cancel working orders at the session close no matter which flag you set, so GTC and GTD may not actually persist overnight. This varies by firm and account, check your firm's current rules before you rely on a resting order carrying over." },
    { type: "heading", text: "How to Set Order Flags in Tradovate: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open the Order Flag Settings", html: "Look for the small cogwheel/gear icon sitting right next to the Day/GTC buttons. On a chart it's beside the Day/GTC toggle in the order-entry strip; on the SuperDOM it's tucked at the bottom next to the same toggle; and inside the Order Ticket the flag selector sits with your order details. Click the cog to open the Order Flag Settings menu, the control panel for everything below." },
        { title: "Choose DAY, GTC, or GTD", html: "Pick the flag that matches how long you want the order to live. DAY is the default and dies at the session close. GTC keeps a resting order working until you cancel it, handy for a limit you want parked for days. GTD splits the difference: the moment you select it, a date and time selector opens so you can set the exact day the order expires." },
        { title: "Set a Custom Cancel Time", html: "Want the order gone at a precise moment whether it filled or not? Turn on the Cancel toggle and pick a date and time. Tradovate treats this as Good-Till-Date behavior, so the order cancels itself the instant that time hits, handy if you only want a level live through a news window or the first hour." },
        { title: "Schedule a Time-Released Order", html: 'The Release toggle is the mirror image of Cancel. Instead of killing an order later, it holds your order back and sends it to the exchange at a future moment. You get two ways to set it: "at" a specific date and time, or "in" a set number of hours, minutes, or seconds from now. That lets you stage an order ahead of a session open or a data release without babysitting the screen.' },
        { title: "Place the Order and Confirm the Flag", html: 'Submit the order, then glance at the Orders module and make sure the flag column reads DAY, GTC, or GTD as you intended. One thing to watch: once an order is working, Tradovate generally won\'t let you switch its time in force, try it on a bracket and you\'ll hit a "Cannot Modify Time In Force" message. The fix is simple: cancel the order and place a fresh one with the right flag. Same goes for a scheduled release, pulling a working order back into the ticket to modify it switches the Release Time off, so set it again.' },
      ],
    },
    { type: "heading", text: "Quick Tips" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>DAY is the safe default</strong>, nothing lingers past the close by accident.",
        "<strong class='text-white'>Reach for GTC</strong> when you want a level parked across sessions.",
        "<strong class='text-white'>Use GTD or the Cancel toggle</strong> to auto-expire an order instead of remembering to pull it.",
        "<strong class='text-white'>Set the flag before you send</strong>, changing it live usually means cancel-and-replace.",
      ],
    },
    { type: "heading", text: "Skip the Manual Flag Setting Entirely" },
    { type: "paragraph", html: "Setting flags by hand is fine for a few orders, but if your entries come from a TradingView strategy you're clicking the same settings over and over. <strong class='text-white'>PickMyTrade routes your TradingView alerts straight into Tradovate</strong> and fires the orders for you, so your timing stays consistent on every trade." },
  ], de: [
    { type: "paragraph",html: "Ein Order-Flag legt fest, wie lange Ihre aktive Order gültig bleibt. Wählen Sie es falsch, verschwindet ein ruhendes Limit entweder zum Sitzungsende oder hängt tagelang im Markt, obwohl Sie es längst vergessen haben. Tradovate bündelt all das hinter einem kleinen Zahnrad, und sobald Sie wissen, wo es sitzt, wechseln Sie mit wenigen Klicks zwischen DAY, GTC und GTD oder planen eine Order so, dass sie sich selbst storniert oder ausgelöst wird." },
    { type: "heading",text: "Was sind Order-Flags?" },
    { type: "paragraph",html: "Das Order-Flag ist Tradovates Bezeichnung für die Gültigkeitsdauer (Time in Force), also die Regel, die steuert, wie lange eine nicht ausgeführte Order aktiv bleibt, bevor sie verfällt. Sie legen es beim Erstellen der Order fest, und es spielt nur für Orders eine Rolle, die im Orderbuch ruhen, etwa Limit- und Stop-Orders. Diese drei Flags werden Sie nutzen:" },
    { type: "table", headers: ["Flag","Vollständiger Name","Bleibt aktiv, bis…"], rows: [
      ["DAY","Tagesorder","Das Ende der aktuellen Handelssitzung, danach wird sie automatisch storniert."],
      ["GTC","Good Till Canceled","Sie sie von Hand stornieren. Sie bleibt über Sitzungen hinweg bestehen, bis sie ausgeführt oder von Ihnen entfernt wird."],
      ["GTD","Good Till Date","Das Sitzungsende an einem von Ihnen gewählten Datum. Bei der Auswahl erscheint eine Datums-/Zeitauswahl."],
    ] },
    { type: "quote",html: "Prop- und Evaluierungskonten stornieren aktive Orders häufig zum Sitzungsende, unabhängig davon, welches Flag Sie setzen. GTC und GTD bleiben daher möglicherweise nicht über Nacht bestehen. Das hängt von Firma und Konto ab. Prüfen Sie die aktuellen Regeln Ihrer Firma, bevor Sie sich darauf verlassen, dass eine ruhende Order erhalten bleibt." },
    { type: "heading",text: "Order-Flags in Tradovate festlegen: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Order Flag Settings öffnen", html: "Suchen Sie das kleine Zahnrad-Symbol direkt neben den Schaltflächen Day/GTC. In einem Chart sitzt es neben dem Day/GTC-Schalter in der Orderleiste, im SuperDOM unten neben demselben Schalter, und im Order Ticket befindet sich die Flag-Auswahl bei Ihren Orderdetails. Klicken Sie auf das Zahnrad, um das Menü Order Flag Settings zu öffnen, die Schaltzentrale für alles Folgende." },
        { title: "DAY, GTC oder GTD wählen", html: "Wählen Sie das Flag, das zur gewünschten Lebensdauer der Order passt. DAY ist der Standard und endet zum Sitzungsende. GTC hält eine ruhende Order aktiv, bis Sie sie stornieren, praktisch für ein Limit, das Sie tagelang parken möchten. GTD liegt dazwischen: Sobald Sie es auswählen, öffnet sich eine Datums- und Zeitauswahl, mit der Sie den genauen Tag festlegen, an dem die Order verfällt." },
        { title: "Eine individuelle Stornozeit festlegen", html: "Soll die Order zu einem genauen Zeitpunkt verschwinden, egal ob sie ausgeführt wurde oder nicht? Aktivieren Sie den Schalter Cancel und wählen Sie Datum und Uhrzeit. Tradovate behandelt dies wie Good-Till-Date: Die Order storniert sich in dem Moment selbst, in dem die Zeit erreicht ist. Praktisch, wenn ein Kursniveau nur während eines Nachrichtenfensters oder in der ersten Handelsstunde aktiv sein soll." },
        { title: "Eine zeitverzögerte Order planen", html: "Der Schalter Release ist das Spiegelbild von Cancel. Statt eine Order später zu beenden, hält er sie zurück und sendet sie zu einem künftigen Zeitpunkt an die Börse. Dafür gibt es zwei Möglichkeiten: „at“ zu einem bestimmten Datum und einer bestimmten Uhrzeit oder „in“ einer festgelegten Anzahl von Stunden, Minuten oder Sekunden ab jetzt. So können Sie eine Order vor einer Sitzungseröffnung oder Datenveröffentlichung vorbereiten, ohne am Bildschirm zu warten." },
        { title: "Order platzieren und Flag bestätigen", html: "Senden Sie die Order ab, werfen Sie dann einen Blick in das Modul Orders und prüfen Sie, ob die Flag-Spalte wie beabsichtigt DAY, GTC oder GTD anzeigt. Beachten Sie: Sobald eine Order aktiv ist, lässt Tradovate in der Regel keine Änderung der Gültigkeitsdauer zu. Versuchen Sie es bei einer Bracket-Order, erscheint die Meldung „Cannot Modify Time In Force“. Die Lösung ist einfach: Stornieren Sie die Order und platzieren Sie eine neue mit dem richtigen Flag. Dasselbe gilt für eine geplante Freigabe: Holen Sie eine aktive Order zum Ändern zurück in das Ticket, wird die Release Time deaktiviert, also legen Sie sie erneut fest." },
      ],
    },
    { type: "heading",text: "Kurztipps" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>DAY ist der sichere Standard</strong>, nichts bleibt versehentlich über das Sitzungsende hinaus bestehen.",
        "<strong class='text-white'>Greifen Sie zu GTC</strong>, wenn ein Kursniveau über mehrere Sitzungen geparkt bleiben soll.",
        "<strong class='text-white'>Nutzen Sie GTD oder den Schalter Cancel</strong>, damit eine Order automatisch verfällt, statt sich merken zu müssen, sie zu entfernen.",
        "<strong class='text-white'>Setzen Sie das Flag vor dem Senden</strong>, denn eine Änderung im laufenden Betrieb bedeutet meist Stornieren und Ersetzen.",
      ],
    },
    { type: "heading",text: "Manuelles Setzen von Flags komplett überspringen" },
    { type: "paragraph",html: "Flags von Hand zu setzen ist bei ein paar Orders in Ordnung, aber wenn Ihre Einstiege aus einer TradingView-Strategie stammen, klicken Sie immer wieder dieselben Einstellungen durch. <strong class='text-white'>PickMyTrade leitet Ihre TradingView-Alerts direkt an Tradovate weiter</strong> und platziert die Orders für Sie, damit Ihr Timing bei jedem Trade konsistent bleibt." },
  ], es: [
    { type: "paragraph",html: "Un indicador de orden decide cuánto tiempo permanece activa su orden. Si se equivoca, un límite en reposo desaparece al cierre de la sesión o se queda días en el mercado cuando ya se había olvidado de él. Tradovate lo agrupa todo tras una pequeña rueda dentada y, una vez que sabe dónde está, puede cambiar entre DAY, GTC y GTD en un par de clics, o programar una orden para que se cancele o se envíe por sí sola." },
    { type: "heading",text: "¿Qué son los indicadores de orden?" },
    { type: "paragraph",html: "El indicador de orden es el nombre que da Tradovate a la vigencia de la orden (time in force), la regla que controla cuánto tiempo sigue activa una orden sin ejecutar antes de caducar. Lo define al crear la orden y solo importa para las órdenes que quedan en el libro, como las órdenes límite y stop. Estos son los tres que utilizará:" },
    { type: "table", headers: ["Indicador","Nombre completo","Permanece activa hasta que…"], rows: [
      ["DAY","Orden del día","Termine la sesión de negociación actual; después se cancela automáticamente."],
      ["GTC","Good Till Canceled","Usted la cancele manualmente. Se mantiene entre sesiones hasta que se ejecuta o la retira."],
      ["GTD","Good Till Date","Llegue el cierre de la sesión de una fecha que usted elija. Al seleccionarla aparece un selector de fecha y hora."],
    ] },
    { type: "quote",html: "Las cuentas de prop firms y de evaluación suelen cancelar las órdenes activas al cierre de la sesión sin importar qué indicador establezca, por lo que GTC y GTD pueden no mantenerse durante la noche. Esto varía según la firma y la cuenta; compruebe las reglas vigentes de su firma antes de confiar en que una orden en reposo se mantenga." },
    { type: "heading",text: "Cómo configurar los indicadores de orden en Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra Order Flag Settings", html: "Busque el pequeño icono de rueda dentada junto a los botones Day/GTC. En un gráfico está junto al selector Day/GTC en la barra de entrada de órdenes; en el SuperDOM está en la parte inferior, junto al mismo selector; y en el Order Ticket el selector del indicador está con los detalles de su orden. Haga clic en la rueda dentada para abrir el menú Order Flag Settings, el panel de control de todo lo que sigue." },
        { title: "Elija DAY, GTC o GTD", html: "Elija el indicador que se ajuste al tiempo que quiere que viva la orden. DAY es el valor predeterminado y termina al cierre de la sesión. GTC mantiene una orden en reposo hasta que la cancela, útil para un límite que quiere dejar aparcado varios días. GTD es el punto medio: en cuanto lo selecciona, se abre un selector de fecha y hora para fijar el día exacto en que caduca la orden." },
        { title: "Establezca una hora de cancelación personalizada", html: "¿Quiere que la orden desaparezca en un momento preciso, se haya ejecutado o no? Active el interruptor Cancel y elija fecha y hora. Tradovate lo trata como comportamiento Good-Till-Date, por lo que la orden se cancela sola en cuanto llega esa hora, útil si solo quiere un nivel activo durante una ventana de noticias o la primera hora." },
        { title: "Programe una orden de liberación diferida", html: "El interruptor Release es la imagen opuesta de Cancel. En lugar de eliminar una orden más tarde, la retiene y la envía al mercado en un momento futuro. Tiene dos formas de configurarlo: “at” una fecha y hora concretas, o “in” un número determinado de horas, minutos o segundos a partir de ahora. Así puede preparar una orden antes de la apertura de una sesión o de un dato económico sin estar pendiente de la pantalla." },
        { title: "Coloque la orden y confirme el indicador", html: "Envíe la orden, revise el módulo Orders y compruebe que la columna del indicador muestra DAY, GTC o GTD según lo previsto. Un detalle importante: una vez que la orden está activa, Tradovate por lo general no permite cambiar su vigencia; si lo intenta en un bracket, aparecerá el mensaje “Cannot Modify Time In Force”. La solución es sencilla: cancele la orden y coloque una nueva con el indicador correcto. Lo mismo ocurre con una liberación programada: al devolver una orden activa al ticket para modificarla se desactiva la Release Time, así que vuelva a configurarla." },
      ],
    },
    { type: "heading",text: "Consejos rápidos" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>DAY es el valor seguro por defecto</strong>, nada se queda más allá del cierre por accidente.",
        "<strong class='text-white'>Recurra a GTC</strong> cuando quiera dejar un nivel aparcado durante varias sesiones.",
        "<strong class='text-white'>Use GTD o el interruptor Cancel</strong> para que una orden caduque automáticamente en lugar de acordarse de retirarla.",
        "<strong class='text-white'>Configure el indicador antes de enviar</strong>, porque cambiarlo en vivo suele significar cancelar y reemplazar.",
      ],
    },
    { type: "heading",text: "Olvídese por completo de configurar los indicadores a mano" },
    { type: "paragraph",html: "Configurar indicadores a mano está bien para unas pocas órdenes, pero si sus entradas provienen de una estrategia de TradingView, está repitiendo los mismos ajustes una y otra vez. <strong class='text-white'>PickMyTrade envía sus alertas de TradingView directamente a Tradovate</strong> y ejecuta las órdenes por usted, para que su sincronización se mantenga constante en cada operación." },
  ], fr: [
    { type: "paragraph",html: "Un indicateur d’ordre détermine combien de temps votre ordre en attente reste actif. Si vous vous trompez, un ordre à cours limité disparaît à la clôture de la séance ou traîne pendant des jours alors que vous l’avez oublié. Tradovate regroupe tout cela derrière une petite roue dentée et, une fois que vous savez où elle se trouve, vous passez de DAY à GTC ou GTD en quelques clics, ou vous programmez un ordre pour qu’il s’annule ou s’envoie de lui-même." },
    { type: "heading",text: "Que sont les indicateurs d’ordre ?" },
    { type: "paragraph",html: "L’indicateur d’ordre est le nom que Tradovate donne à la durée de validité (time in force), la règle qui contrôle combien de temps un ordre non exécuté reste actif avant d’expirer. Vous le définissez lors de la création de l’ordre, et il ne compte que pour les ordres qui restent dans le carnet, comme les ordres à cours limité et les ordres stop. Voici les trois que vous utiliserez :" },
    { type: "table", headers: ["Indicateur","Nom complet","Reste actif jusqu’à ce que…"], rows: [
      ["DAY","Ordre du jour","La fin de la séance de trading en cours, puis il est annulé automatiquement."],
      ["GTC","Good Till Canceled","Vous l’annuliez manuellement. Il se maintient d’une séance à l’autre jusqu’à son exécution ou son retrait."],
      ["GTD","Good Till Date","La clôture de la séance à une date que vous choisissez. Un sélecteur de date/heure apparaît lorsque vous le sélectionnez."],
    ] },
    { type: "quote",html: "Les comptes prop firm et d’évaluation annulent souvent les ordres actifs à la clôture de la séance, quel que soit l’indicateur défini ; GTC et GTD peuvent donc ne pas persister pendant la nuit. Cela varie selon la firme et le compte : vérifiez les règles en vigueur de votre firme avant de compter sur le maintien d’un ordre en attente." },
    { type: "heading",text: "Comment définir les indicateurs d’ordre dans Tradovate : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir Order Flag Settings", html: "Repérez la petite icône de roue dentée à côté des boutons Day/GTC. Sur un graphique, elle se trouve près du commutateur Day/GTC dans la barre de saisie d’ordres ; sur le SuperDOM, elle est en bas, à côté du même commutateur ; et dans l’Order Ticket, le sélecteur d’indicateur figure avec les détails de votre ordre. Cliquez sur la roue dentée pour ouvrir le menu Order Flag Settings, le panneau de contrôle de tout ce qui suit." },
        { title: "Choisir DAY, GTC ou GTD", html: "Choisissez l’indicateur qui correspond à la durée de vie souhaitée de l’ordre. DAY est la valeur par défaut et s’arrête à la clôture de la séance. GTC maintient un ordre en attente jusqu’à son annulation, pratique pour un ordre à cours limité que vous voulez garder plusieurs jours. GTD offre un compromis : dès que vous le sélectionnez, un sélecteur de date et d’heure s’ouvre pour fixer le jour exact d’expiration de l’ordre." },
        { title: "Définir une heure d’annulation personnalisée", html: "Vous voulez que l’ordre disparaisse à un moment précis, qu’il soit exécuté ou non ? Activez le commutateur Cancel et choisissez une date et une heure. Tradovate traite cela comme un comportement Good-Till-Date : l’ordre s’annule de lui-même à l’instant où l’heure est atteinte, pratique si vous ne voulez un niveau actif que pendant une fenêtre de publication de nouvelles ou la première heure." },
        { title: "Programmer un ordre à libération différée", html: "Le commutateur Release est l’image inverse de Cancel. Au lieu d’éliminer un ordre plus tard, il le retient et l’envoie à la bourse à un moment futur. Vous avez deux façons de le régler : « at » une date et une heure précises, ou « in » un nombre défini d’heures, de minutes ou de secondes à partir de maintenant. Vous pouvez ainsi préparer un ordre avant une ouverture de séance ou une publication de données sans surveiller l’écran." },
        { title: "Passer l’ordre et confirmer l’indicateur", html: "Envoyez l’ordre, puis jetez un œil au module Orders pour vérifier que la colonne de l’indicateur affiche bien DAY, GTC ou GTD comme prévu. Un point à surveiller : une fois l’ordre actif, Tradovate ne vous permet généralement pas de changer sa durée de validité ; essayez sur un bracket et vous obtiendrez le message « Cannot Modify Time In Force ». La solution est simple : annulez l’ordre et passez-en un nouveau avec le bon indicateur. Il en va de même pour une libération programmée : renvoyer un ordre actif dans le ticket pour le modifier désactive la Release Time, il faut donc la redéfinir." },
      ],
    },
    { type: "heading",text: "Conseils rapides" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>DAY est la valeur par défaut sûre</strong> : rien ne traîne par accident après la clôture.",
        "<strong class='text-white'>Optez pour GTC</strong> lorsque vous voulez garder un niveau en attente sur plusieurs séances.",
        "<strong class='text-white'>Utilisez GTD ou le commutateur Cancel</strong> pour faire expirer automatiquement un ordre plutôt que de devoir penser à le retirer.",
        "<strong class='text-white'>Définissez l’indicateur avant l’envoi</strong> : le modifier en direct revient généralement à annuler et remplacer.",
      ],
    },
    { type: "heading",text: "Oubliez complètement le réglage manuel des indicateurs" },
    { type: "paragraph",html: "Définir les indicateurs à la main convient pour quelques ordres, mais si vos entrées proviennent d’une stratégie TradingView, vous cliquez sans cesse sur les mêmes réglages. <strong class='text-white'>PickMyTrade achemine vos alertes TradingView directement vers Tradovate</strong> et passe les ordres à votre place, pour que votre timing reste constant à chaque trade." },
  ], it: [
    { type: "paragraph",html: "Un flag dell’ordine decide per quanto tempo il suo ordine in lavorazione resta attivo. Se sbaglia, un limite a riposo sparisce alla chiusura della sessione oppure resta nel mercato per giorni quando ormai se n’è dimenticato. Tradovate raccoglie tutto dietro una piccola rotellina e, una volta che sa dove si trova, può passare tra DAY, GTC e GTD in un paio di clic, oppure programmare un ordine perché si annulli o parta da solo." },
    { type: "heading",text: "Cosa sono i flag degli ordini?" },
    { type: "paragraph",html: "Il flag dell’ordine è il nome che Tradovate dà alla validità dell’ordine (time in force), la regola che controlla per quanto tempo un ordine non eseguito resta in lavorazione prima di scadere. Lo imposta quando costruisce l’ordine e conta solo per gli ordini che restano nel book, come gli ordini limite e stop. Ecco i tre che userà:" },
    { type: "table", headers: ["Flag","Nome completo","Resta in lavorazione finché…"], rows: [
      ["DAY","Ordine giornaliero","Termina la sessione di trading corrente; poi viene annullato automaticamente."],
