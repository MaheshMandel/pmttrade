---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-minimum-bars-to-load";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Fix Indicator Accuracy: Set Minimum Bars to Load";
const META_DESCRIPTION =
  "Fix indicators that calculate wrong on your charts. Raise the Minimum Number of Bars to Load so enough price history preloads for accurate values.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Indikatorgenauigkeit verbessern: Minimum Bars to Load festlegen", es: "Corrija la precisión de los indicadores: configure Minimum Bars to Load", fr: "Corriger la précision des indicateurs : définir Minimum Bars to Load", it: "Correggere l’accuratezza degli indicatori: impostare Minimum Bars to Load" },
  dek: { en: "Watched a moving average sit in the wrong place, then snap into position the moment you scrolled back? Your chart just didn't load enough price history. Here's the one setting that fixes it, plus a template so it sticks.", de: "Haben Sie gesehen, wie ein gleitender Durchschnitt an der falschen Stelle saß und beim Zurückscrollen plötzlich einrastete? Ihr Chart hat dann schlicht nicht genug Kurshistorie geladen. Hier ist die eine Einstellung, die das behebt, plus eine Vorlage, damit sie dauerhaft bleibt.", es: "¿Ha visto una media móvil en el lugar equivocado que luego encaja en su sitio en cuanto retrocede en el gráfico? Su gráfico simplemente no cargó suficiente historial de precios. Esta es la única configuración que lo soluciona, más una plantilla para que se conserve.", fr: "Vous avez déjà vu une moyenne mobile mal placée se remettre d’un coup en place dès que vous remontiez dans le graphique ? Votre graphique n’a tout simplement pas chargé assez d’historique de prix. Voici le réglage unique qui corrige cela, plus un modèle pour qu’il soit conservé.", it: "Ha mai visto una media mobile al posto sbagliato che poi scatta nella posizione giusta non appena scorre indietro nel grafico? Il suo grafico non ha semplicemente caricato abbastanza storico dei prezzi. Ecco l’unica impostazione che risolve il problema, più un modello perché resti." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-10",
  blocks: { en: [
    { type: "paragraph", html: "Ever dropped a 200-period moving average onto a chart, watched it sit in the wrong place, then seen it snap into position the second you scrolled back? Or noticed VWAP and your EMAs shift every time you flip between chart tabs? The indicator isn't broken. Your chart just didn't load enough price history for it to calculate against. The fix is one setting, plus a template so it sticks." },
    { type: "heading", text: "Why Your Indicators Calculate Wrong" },
    { type: "paragraph", html: "An indicator can only do math on the bars that are actually loaded on the chart. When you open a fresh chart tab, only a small slice of recent history loads by default, and studies with a long lookback get shortchanged." },
    { type: "paragraph", html: "Say you're running a 200-period moving average but the chart only pulled in 100 bars. It draws off a partial window and reads wrong. Scroll back, more bars stream in, the average recalculates, and it jumps to a new level. Session-anchored VWAP is even touchier, since it needs every bar back to the session open. Loading more bars up front gives those calculations the runway they need." },
    { type: "heading", text: "Fix It: Raise Minimum Bars to Load, Step by Step" },
    {
      type: "steps",
      items: [
        { title: "Open the Chart Settings", html: "Open the chart you're working on and go into its settings. On the chart toolbar, look for the settings (gear) icon, which opens the chart settings or Chart Editor panel. That's where the data and appearance options live." },
        { title: "Find Minimum Number of Bars to Load", html: "In the chart settings, find the field labeled <strong class='text-white'>Minimum Number of Bars to Load</strong> (some builds shorten it to Minimum Bars to Load). Out of the box it's set to <strong class='text-white'>100</strong> bars, and that's the root of the problem for anything with a lookback longer than about 100 periods." },
        { title: "Raise the Value to Cover Your Indicators", html: "Set the number high enough to comfortably clear the longest lookback on the chart. If your heaviest study is a 200-period average, don't set 200 exactly, give it room. A value in the <strong class='text-white'>1,000 to 2,000</strong> range covers most setups, and long-period studies or session VWAP do better higher still. The field accepts values well into the thousands, so err on the generous side. More bars adds a little load time, a fair trade for numbers you can trust." },
        { title: "Apply and Check the Indicator", html: "Apply the change and watch the indicator settle. A moving average that was floating in the wrong spot should snap to where it belongs, and it shouldn't jump anymore when you scroll back through history. If it still shifts, you haven't cleared the longest lookback yet, so bump the bar count higher and check again." },
        { title: "Save It as a Chart Template", html: "Here's the part most people miss: fixing one chart does nothing for the next one. Every new chart tab reopens at the default 100 bars. Save your configured chart as a <strong class='text-white'>template</strong> (through the chart's save or manage templates option) and set it as your default. Now every new chart inherits the higher bar count, and your indicators load correctly from the first candle instead of you fixing them one tab at a time." },
      ],
    },
    { type: "heading", text: "How Many Bars Do You Actually Need?" },
    { type: "paragraph", html: "Match the setting to the longest period across every indicator on the chart, then add a buffer. Rough starting points:" },
    { type: "table", headers: ["Your longest indicator lookback", "Bars to load (with buffer)"], rows: [
      ["Short studies (RSI, EMAs up to ~50)", "500+"],
      ["100 to 200-period moving averages", "1,000 to 2,000"],
      ["Session VWAP or long-lookback studies", "2,000+"],
    ] },
    { type: "paragraph", html: "These aren't hard rules, just a safe floor. When in doubt, set it higher than you think you need." },
    { type: "heading", text: "Signs You're Hitting This" },
    {
      type: "list",
      items: [
        "A long moving average sits in the wrong place until you scroll back to load more history.",
        "Indicators jump or redraw when you load older bars or switch between chart tabs.",
        "VWAP looks different from what another platform shows for the same session.",
      ],
    },
    { type: "heading", text: "Automate Your Entries with PickMyTrade" },
    { type: "paragraph", html: "Once your charts read straight, the next job is acting on them fast enough. <strong class='text-white'>PickMyTrade routes your TradingView alerts straight into your Tradovate account</strong>, so a signal fires and the order is placed for you, no manual clicks and no missed fills." },
  ], de: [
    { type: "paragraph",html: "Haben Sie schon einmal einen 200-Perioden-Durchschnitt auf einen Chart gelegt, ihn an der falschen Stelle gesehen und dann erlebt, wie er in dem Moment einrastet, in dem Sie zurückscrollen? Oder bemerkt, dass sich VWAP und Ihre EMAs verschieben, sobald Sie zwischen Chart-Tabs wechseln? Der Indikator ist nicht defekt. Ihr Chart hat nur nicht genug Kurshistorie geladen, auf der er rechnen kann. Die Lösung ist eine einzige Einstellung plus eine Vorlage, damit sie bleibt." },
    { type: "heading",text: "Warum Ihre Indikatoren falsch rechnen" },
    { type: "paragraph",html: "Ein Indikator kann nur mit den Balken rechnen, die tatsächlich im Chart geladen sind. Wenn Sie einen neuen Chart-Tab öffnen, wird standardmäßig nur ein kleiner Ausschnitt der jüngsten Historie geladen, und Studien mit langem Rückblick kommen zu kurz." },
    { type: "paragraph",html: "Angenommen, Sie nutzen einen 200-Perioden-Durchschnitt, aber der Chart hat nur 100 Balken geladen. Er wird aus einem Teilfenster gezeichnet und liest sich falsch. Scrollen Sie zurück, strömen weitere Balken nach, der Durchschnitt wird neu berechnet und springt auf ein neues Niveau. Sitzungsbasiertes VWAP ist noch empfindlicher, da es jeden Balken bis zur Sitzungseröffnung benötigt. Mehr Balken vorab geben diesen Berechnungen den nötigen Anlauf." },
    { type: "heading",text: "Die Lösung: Minimum Bars to Load erhöhen, Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Die Chart-Einstellungen öffnen", html: "Öffnen Sie den Chart, an dem Sie arbeiten, und gehen Sie in seine Einstellungen. In der Chart-Symbolleiste finden Sie das Einstellungssymbol (Zahnrad), das die Chart-Einstellungen bzw. das Chart-Editor-Panel öffnet. Dort liegen die Daten- und Darstellungsoptionen." },
        { title: "Minimum Number of Bars to Load finden", html: "Suchen Sie in den Chart-Einstellungen das Feld <strong class='text-white'>Minimum Number of Bars to Load</strong> (manche Builds kürzen es auf Minimum Bars to Load ab). Standardmäßig steht es auf <strong class='text-white'>100</strong> Balken, und das ist die Ursache des Problems bei allem mit einem Rückblick von mehr als etwa 100 Perioden." },
        { title: "Den Wert so erhöhen, dass er Ihre Indikatoren abdeckt", html: "Setzen Sie die Zahl so hoch, dass sie den längsten Rückblick im Chart komfortabel abdeckt. Ist Ihre aufwendigste Studie ein 200-Perioden-Durchschnitt, setzen Sie nicht genau 200, sondern geben Sie Spielraum. Ein Wert im Bereich <strong class='text-white'>1,000 bis 2,000</strong> deckt die meisten Setups ab, und Studien mit langen Perioden oder Sitzungs-VWAP fahren mit noch mehr besser. Das Feld akzeptiert Werte weit in den Tausenderbereich, also lieber großzügig. Mehr Balken bedeuten etwas längere Ladezeit, ein fairer Preis für verlässliche Zahlen." },
        { title: "Anwenden und den Indikator prüfen", html: "Wenden Sie die Änderung an und beobachten Sie, wie sich der Indikator einpendelt. Ein gleitender Durchschnitt, der an der falschen Stelle schwebte, sollte dorthin einrasten, wo er hingehört, und beim Zurückscrollen durch die Historie nicht mehr springen. Verschiebt er sich weiterhin, haben Sie den längsten Rückblick noch nicht abgedeckt; erhöhen Sie die Balkenanzahl und prüfen Sie erneut." },
        { title: "Als Chart-Vorlage speichern", html: "Das übersehen die meisten: Einen Chart zu korrigieren, nützt dem nächsten nichts. Jeder neue Chart-Tab öffnet sich wieder mit den standardmäßigen 100 Balken. Speichern Sie Ihren konfigurierten Chart als <strong class='text-white'>Vorlage</strong> (über die Speichern- oder Vorlagen-Verwalten-Option des Charts) und legen Sie sie als Standard fest. Nun übernimmt jeder neue Chart die höhere Balkenanzahl, und Ihre Indikatoren laden von der ersten Kerze an korrekt, statt dass Sie sie Tab für Tab korrigieren." },
      ],
    },
    { type: "heading",text: "Wie viele Balken brauchen Sie tatsächlich?" },
    { type: "paragraph",html: "Passen Sie die Einstellung an die längste Periode aller Indikatoren im Chart an und addieren Sie einen Puffer. Grobe Startwerte:" },
    { type: "table", headers: ["Ihr längster Indikator-Rückblick","Zu ladende Balken (mit Puffer)"], rows: [
      ["Kurze Studien (RSI, EMAs bis ca. 50)","500+"],
      ["Gleitende Durchschnitte mit 100 bis 200 Perioden","1,000 bis 2,000"],
      ["Sitzungs-VWAP oder Studien mit langem Rückblick","2,000+"],
    ] },
    { type: "paragraph",html: "Das sind keine festen Regeln, nur eine sichere Untergrenze. Im Zweifel setzen Sie den Wert höher, als Sie glauben zu brauchen." },
    { type: "heading",text: "Anzeichen, dass es Sie betrifft" },
    {
      type: "list",
      items: [
        "Ein langer gleitender Durchschnitt sitzt an der falschen Stelle, bis Sie zurückscrollen, um mehr Historie zu laden.",
        "Indikatoren springen oder werden neu gezeichnet, wenn Sie ältere Balken laden oder zwischen Chart-Tabs wechseln.",
        "VWAP sieht anders aus als das, was eine andere Plattform für dieselbe Sitzung zeigt.",
      ],
    },
    { type: "heading",text: "Automatisieren Sie Ihre Einstiege mit PickMyTrade" },
    { type: "paragraph",html: "Sobald Ihre Charts korrekt lesen, besteht die nächste Aufgabe darin, schnell genug darauf zu reagieren. <strong class='text-white'>PickMyTrade leitet Ihre TradingView-Alerts direkt an Ihr Tradovate-Konto weiter</strong>, sodass bei einem Signal die Order für Sie platziert wird, ohne manuelle Klicks und ohne verpasste Fills." },
  ], es: [
    { type: "paragraph",html: "¿Alguna vez colocó una media móvil de 200 períodos en un gráfico, la vio en el lugar equivocado y luego encajar en su sitio en cuanto retrocedió? ¿O notó que el VWAP y sus EMA cambian cada vez que alterna entre pestañas de gráfico? El indicador no está roto. Su gráfico simplemente no cargó suficiente historial de precios para calcularlo. La solución es una sola configuración, más una plantilla para que se conserve." },
    { type: "heading",text: "Por qué sus indicadores calculan mal" },
    { type: "paragraph",html: "Un indicador solo puede calcular con las barras que realmente están cargadas en el gráfico. Cuando abre una pestaña de gráfico nueva, por defecto solo se carga una pequeña porción del historial reciente, y los estudios con un período largo salen perjudicados." },
    { type: "paragraph",html: "Supongamos que usa una media móvil de 200 períodos, pero el gráfico solo trajo 100 barras. Se dibuja a partir de una ventana parcial y se lee mal. Al retroceder llegan más barras, la media se recalcula y salta a un nuevo nivel. El VWAP anclado a la sesión es aún más delicado, ya que necesita todas las barras hasta la apertura de la sesión. Cargar más barras de antemano da a esos cálculos el margen que necesitan." },
    { type: "heading",text: "La solución: aumente Minimum Bars to Load, paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra la configuración del gráfico", html: "Abra el gráfico en el que está trabajando y entre en su configuración. En la barra de herramientas del gráfico, busque el icono de configuración (engranaje), que abre la configuración del gráfico o el panel Chart Editor. Ahí están las opciones de datos y de apariencia." },
        { title: "Busque Minimum Number of Bars to Load", html: "En la configuración del gráfico, busque el campo llamado <strong class='text-white'>Minimum Number of Bars to Load</strong> (algunas versiones lo abrevian como Minimum Bars to Load). De fábrica está en <strong class='text-white'>100</strong> barras, y esa es la raíz del problema para cualquier cosa con un período de referencia superior a unos 100 períodos." },
        { title: "Aumente el valor para cubrir sus indicadores", html: "Fije un número lo bastante alto para superar con holgura el período más largo del gráfico. Si su estudio más pesado es una media de 200 períodos, no la fije exactamente en 200: deje margen. Un valor en el rango de <strong class='text-white'>1,000 a 2,000</strong> cubre la mayoría de las configuraciones, y los estudios de período largo o el VWAP de sesión funcionan mejor con aún más. El campo acepta valores de varios miles, así que sea generoso. Más barras añaden un poco de tiempo de carga, un precio justo por números en los que puede confiar." },
        { title: "Aplique y compruebe el indicador", html: "Aplique el cambio y observe cómo se asienta el indicador. Una media móvil que flotaba en el lugar equivocado debería encajar en su sitio y ya no debería saltar al retroceder por el historial. Si todavía se desplaza, aún no ha superado el período más largo; aumente la cantidad de barras y vuelva a comprobar." },
        { title: "Guárdelo como plantilla de gráfico", html: "Esta es la parte que la mayoría pasa por alto: corregir un gráfico no hace nada por el siguiente. Cada nueva pestaña de gráfico vuelve a abrirse con las 100 barras predeterminadas. Guarde su gráfico configurado como <strong class='text-white'>plantilla</strong> (mediante la opción de guardar o administrar plantillas del gráfico) y establézcala como predeterminada. Ahora cada gráfico nuevo hereda la mayor cantidad de barras, y sus indicadores cargan correctamente desde la primera vela en lugar de tener que corregirlos pestaña por pestaña." },
      ],
    },
    { type: "heading",text: "¿Cuántas barras necesita realmente?" },
    { type: "paragraph",html: "Ajuste la configuración al período más largo de todos los indicadores del gráfico y añada un margen. Puntos de partida aproximados:" },
    { type: "table", headers: ["Su período de referencia más largo","Barras a cargar (con margen)"], rows: [
      ["Estudios cortos (RSI, EMA hasta ~50)","500+"],
      ["Medias móviles de 100 a 200 períodos","1,000 a 2,000"],
      ["VWAP de sesión o estudios de período largo","2,000+"],
    ] },
    { type: "paragraph",html: "No son reglas rígidas, solo un mínimo seguro. En caso de duda, fíjelo más alto de lo que cree necesario." },
    { type: "heading",text: "Señales de que le está pasando esto" },
    {
      type: "list",
      items: [
        "Una media móvil larga está en el lugar equivocado hasta que retrocede para cargar más historial.",
        "Los indicadores saltan o se redibujan al cargar barras más antiguas o al cambiar entre pestañas de gráfico.",
        "El VWAP se ve distinto de lo que muestra otra plataforma para la misma sesión.",
      ],
    },
    { type: "heading",text: "Automatice sus entradas con PickMyTrade" },
    { type: "paragraph",html: "Una vez que sus gráficos se leen bien, el siguiente trabajo es actuar sobre ellos con la rapidez suficiente. <strong class='text-white'>PickMyTrade envía sus alertas de TradingView directamente a su cuenta de Tradovate</strong>, de modo que, cuando salta una señal, la orden se coloca por usted, sin clics manuales ni ejecuciones perdidas." },
  ], fr: [
    { type: "paragraph",html: "Vous avez déjà posé une moyenne mobile sur 200 périodes sur un graphique, constaté qu’elle était mal placée, puis vu qu’elle se remettait en place dès que vous remontiez ? Ou remarqué que le VWAP et vos EMA se décalent chaque fois que vous passez d’un onglet de graphique à l’autre ? L’indicateur n’est pas cassé. Votre graphique n’a simplement pas chargé assez d’historique de prix pour qu’il puisse calculer. La solution tient en un seul réglage, plus un modèle pour le conserver." },
    { type: "heading",text: "Pourquoi vos indicateurs calculent de travers" },
    { type: "paragraph",html: "Un indicateur ne peut calculer que sur les barres réellement chargées sur le graphique. Lorsque vous ouvrez un nouvel onglet de graphique, seule une petite portion de l’historique récent est chargée par défaut, et les études à longue période sont défavorisées." },
    { type: "paragraph",html: "Supposons que vous utilisiez une moyenne mobile sur 200 périodes alors que le graphique n’a chargé que 100 barres. Elle est tracée à partir d’une fenêtre partielle et se lit mal. Vous remontez, d’autres barres arrivent, la moyenne est recalculée et saute à un nouveau niveau. Le VWAP ancré sur la séance est encore plus délicat, car il a besoin de chaque barre depuis l’ouverture de la séance. Charger davantage de barres d’emblée donne à ces calculs l’élan nécessaire." },
    { type: "heading",text: "Le correctif : augmenter Minimum Bars to Load, pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir les paramètres du graphique", html: "Ouvrez le graphique sur lequel vous travaillez et accédez à ses paramètres. Dans la barre d’outils du graphique, repérez l’icône des paramètres (engrenage), qui ouvre les paramètres du graphique ou le panneau Chart Editor. C’est là que se trouvent les options de données et d’apparence." },
        { title: "Trouver Minimum Number of Bars to Load", html: "Dans les paramètres du graphique, trouvez le champ intitulé <strong class='text-white'>Minimum Number of Bars to Load</strong> (certaines versions l’abrègent en Minimum Bars to Load). Par défaut, il est réglé sur <strong class='text-white'>100</strong> barres, et c’est la racine du problème pour tout ce qui a une période supérieure à environ 100 périodes." },
        { title: "Augmenter la valeur pour couvrir vos indicateurs", html: "Réglez un nombre suffisamment élevé pour couvrir confortablement la période la plus longue du graphique. Si votre étude la plus lourde est une moyenne sur 200 périodes, ne réglez pas exactement 200 : laissez de la marge. Une valeur de l’ordre de <strong class='text-white'>1,000 à 2,000</strong> couvre la plupart des configurations, et les études à longue période ou le VWAP de séance s’en sortent mieux avec davantage encore. Le champ accepte des valeurs allant bien au-delà de plusieurs milliers ; soyez donc généreux. Plus de barres ajoutent un peu de temps de chargement, un compromis acceptable pour des chiffres fiables." },
        { title: "Appliquer et vérifier l’indicateur", html: "Appliquez la modification et regardez l’indicateur se stabiliser. Une moyenne mobile qui flottait au mauvais endroit devrait se remettre là où elle doit être, et elle ne devrait plus sauter lorsque vous remontez dans l’historique. Si elle se décale encore, vous n’avez pas encore dépassé la période la plus longue ; augmentez le nombre de barres et vérifiez à nouveau." },
        { title: "L’enregistrer comme modèle de graphique", html: "Voici la partie que la plupart des gens oublient : corriger un graphique ne change rien pour le suivant. Chaque nouvel onglet de graphique se rouvre avec les 100 barres par défaut. Enregistrez votre graphique configuré comme <strong class='text-white'>modèle</strong> (via l’option d’enregistrement ou de gestion des modèles du graphique) et définissez-le comme modèle par défaut. Désormais, chaque nouveau graphique hérite du nombre de barres plus élevé, et vos indicateurs se chargent correctement dès la première bougie, au lieu de devoir les corriger onglet par onglet." },
      ],
    },
    { type: "heading",text: "De combien de barres avez-vous réellement besoin ?" },
    { type: "paragraph",html: "Adaptez le réglage à la période la plus longue parmi tous les indicateurs du graphique, puis ajoutez une marge. Points de départ approximatifs :" },
    { type: "table", headers: ["Votre période d’indicateur la plus longue","Barres à charger (avec marge)"], rows: [
      ["Études courtes (RSI, EMA jusqu’à ~50)","500+"],
      ["Moyennes mobiles de 100 à 200 périodes","1,000 à 2,000"],
      ["VWAP de séance ou études à longue période","2,000+"],
    ] },
    { type: "paragraph",html: "Ce ne sont pas des règles strictes, simplement un plancher sûr. En cas de doute, réglez plus haut que ce que vous pensez nécessaire." },
    { type: "heading",text: "Signes que vous êtes concerné" },
    {
      type: "list",
      items: [
        "Une longue moyenne mobile est mal placée tant que vous ne remontez pas pour charger plus d’historique.",
        "Les indicateurs sautent ou se redessinent lorsque vous chargez des barres plus anciennes ou changez d’onglet de graphique.",
        "Le VWAP diffère de ce qu’affiche une autre plateforme pour la même séance.",
      ],
    },
    { type: "heading",text: "Automatisez vos entrées avec PickMyTrade" },
    { type: "paragraph",html: "Une fois que vos graphiques se lisent correctement, la tâche suivante consiste à agir assez vite. <strong class='text-white'>PickMyTrade achemine vos alertes TradingView directement vers votre compte Tradovate</strong>, de sorte que, lorsqu’un signal se déclenche, l’ordre est passé pour vous, sans clics manuels ni exécutions manquées." },
  ], it: [
    { type: "paragraph",html: "Ha mai applicato una media mobile a 200 periodi a un grafico, l’ha vista al posto sbagliato e poi l’ha vista scattare in posizione nell’istante in cui è tornato indietro? Oppure ha notato che VWAP e le sue EMA si spostano ogni volta che passa da una scheda del grafico all’altra? L’indicatore non è rotto. Il suo grafico non ha semplicemente caricato abbastanza storico dei prezzi su cui calcolare. La soluzione è una sola impostazione, più un modello perché resti." },
    { type: "heading",text: "Perché i suoi indicatori calcolano in modo errato" },
    { type: "paragraph",html: "Un indicatore può calcolare solo sulle barre effettivamente caricate sul grafico. Quando apre una nuova scheda del grafico, per impostazione predefinita viene caricata solo una piccola porzione dello storico recente, e gli studi con un lungo periodo di calcolo vengono penalizzati." },
    { type: "paragraph",html: "Supponga di usare una media mobile a 200 periodi, ma il grafico ha caricato solo 100 barre. Viene disegnata su una finestra parziale e si legge in modo errato. Scorra indietro, arrivano altre barre, la media viene ricalcolata e salta a un nuovo livello. Il VWAP ancorato alla sessione è ancora più delicato, perché richiede ogni barra fino all’apertura della sessione. Caricare più barre in anticipo dà a questi calcoli lo spazio di cui hanno bisogno." },
    { type: "heading",text: "La soluzione: aumentare Minimum Bars to Load, passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Aprire le impostazioni del grafico", html: "Apra il grafico su cui sta lavorando e acceda alle sue impostazioni. Nella barra degli strumenti del grafico cerchi l’icona delle impostazioni (ingranaggio), che apre le impostazioni del grafico o il pannello Chart Editor. Lì si trovano le opzioni dei dati e dell’aspetto." },
        { title: "Trovare Minimum Number of Bars to Load", html: "Nelle impostazioni del grafico trovi il campo chiamato <strong class='text-white'>Minimum Number of Bars to Load</strong> (in alcune build è abbreviato in Minimum Bars to Load). Per impostazione predefinita è fissato a <strong class='text-white'>100</strong> barre, ed è la radice del problema per qualsiasi cosa con un periodo di calcolo superiore a circa 100 periodi." },
        { title: "Aumentare il valore per coprire i suoi indicatori", html: "Imposti un numero abbastanza alto da superare con comodità il periodo più lungo presente sul grafico. Se il suo studio più pesante è una media a 200 periodi, non imposti esattamente 200: lasci un margine. Un valore nell’intervallo <strong class='text-white'>1,000 a 2,000</strong> copre la maggior parte dei setup, e gli studi a lungo periodo o il VWAP di sessione funzionano meglio con valori ancora più alti. Il campo accetta valori ben oltre le migliaia, quindi sia generoso. Più barre aggiungono un po’ di tempo di caricamento, un compromesso equo per numeri affidabili." },
        { title: "Applicare e verificare l’indicatore", html: "Applichi la modifica e osservi l’indicatore assestarsi. Una media mobile che fluttuava nel punto sbagliato dovrebbe scattare dove deve stare e non dovrebbe più saltare quando scorre indietro nello storico. Se continua a spostarsi, non ha ancora superato il periodo più lungo: aumenti il numero di barre e controlli di nuovo." },
        { title: "Salvarlo come modello di grafico", html: "Ecco la parte che la maggior parte delle persone trascura: correggere un grafico non fa nulla per il successivo. Ogni nuova scheda del grafico si riapre con le 100 barre predefinite. Salvi il suo grafico configurato come <strong class='text-white'>modello</strong> (tramite l’opzione di salvataggio o gestione dei modelli del grafico) e lo imposti come predefinito. Ora ogni nuovo grafico eredita il numero di barre più alto, e i suoi indicatori si caricano correttamente fin dalla prima candela, invece di doverli correggere scheda per scheda." },
      ],
    },
    { type: "heading",text: "Di quante barre ha davvero bisogno?" },
    { type: "paragraph",html: "Adatti l’impostazione al periodo più lungo tra tutti gli indicatori del grafico, poi aggiunga un margine. Punti di partenza indicativi:" },
    { type: "table", headers: ["Il suo periodo di indicatore più lungo","Barre da caricare (con margine)"], rows: [
      ["Studi brevi (RSI, EMA fino a ~50)","500+"],
      ["Medie mobili da 100 a 200 periodi","1,000 a 2,000"],
      ["VWAP di sessione o studi a lungo periodo","2,000+"],
    ] },
    { type: "paragraph",html: "Non sono regole rigide, solo una soglia minima sicura. In caso di dubbio, imposti un valore più alto di quanto pensa serva." },
    { type: "heading",text: "Segnali che sta incontrando questo problema" },
    {
      type: "list",
      items: [
        "Una media mobile lunga si trova al posto sbagliato finché non scorre indietro per caricare più storico.",
        "Gli indicatori saltano o si ridisegnano quando carica barre più vecchie o passa da una scheda del grafico all’altra.",
        "Il VWAP appare diverso da quello che mostra un’altra piattaforma per la stessa sessione.",
      ],
    },
    { type: "heading",text: "Automatizzi i suoi ingressi con PickMyTrade" },
    { type: "paragraph",html: "Una volta che i suoi grafici si leggono correttamente, il compito successivo è agire abbastanza in fretta. <strong class='text-white'>PickMyTrade instrada i suoi alert di TradingView direttamente sul suo conto Tradovate</strong>, così, quando scatta un segnale, l’ordine viene piazzato per lei, senza clic manuali e senza esecuzioni mancate." },
  ] },
  ctaHeading: { en: "Read Straight, Trade Fast", de: "Sauber lesen, schnell handeln", es: "Lea bien, opere rápido", fr: "Lisez juste, tradez vite", it: "Legga bene, operi in fretta" },
  ctaText: { en: "Once your indicators calculate correctly, let PickMyTrade route your TradingView alerts straight into Tradovate so no fill gets missed.", de: "Sobald Ihre Indikatoren korrekt berechnet werden, lassen Sie PickMyTrade Ihre TradingView-Alerts direkt an Tradovate weiterleiten, damit kein Fill verpasst wird.", es: "Una vez que sus indicadores calculen correctamente, deje que PickMyTrade envíe sus alertas de TradingView directamente a Tradovate para que no se pierda ninguna ejecución.", fr: "Une fois vos indicateurs correctement calculés, laissez PickMyTrade acheminer vos alertes TradingView directement vers Tradovate afin qu’aucune exécution ne soit manquée.", it: "Una volta che i suoi indicatori calcolano correttamente, lasci che PickMyTrade instradi i suoi alert di TradingView direttamente su Tradovate, così nessuna esecuzione va persa." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Why does my moving average jump when I scroll back?", a: "Because it recalculates as more history loads. With too few bars on the chart it draws off a partial window; once older bars stream in, it recomputes on the full data set and shifts. Raising Minimum Number of Bars to Load preloads enough history so it's right from the start." },
