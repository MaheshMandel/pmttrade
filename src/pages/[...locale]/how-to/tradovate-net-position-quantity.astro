---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-net-position-quantity";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Confirm Net Position Size in Tradovate";
const META_DESCRIPTION =
  "Confirm your real net long or short contract size using the Positions module Qty column, and reconcile it against your charts before you flatten a trade.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Netto-Positionsgröße in Tradovate bestätigen", es: "Confirme el tamaño neto de su posición en Tradovate", fr: "Confirmer la taille nette de votre position dans Tradovate", it: "Confermare la dimensione netta della posizione in Tradovate" },
  dek: { en: "Confirm your real net long or short contract size using the Positions module Qty column, and reconcile it against your charts before you flatten a trade.", de: "Bestätigen Sie Ihre tatsächliche Netto-Long- oder Short-Größe in Kontrakten anhand der Spalte Qty im Positions-Modul und gleichen Sie sie mit Ihren Charts ab, bevor Sie einen Trade glattstellen.", es: "Confirme su tamaño real neto en largo o corto usando la columna Qty del módulo Positions y concílielo con sus gráficos antes de cerrar una operación.", fr: "Confirmez votre taille nette réelle, longue ou courte, en contrats grâce à la colonne Qty du module Positions, et rapprochez-la de vos graphiques avant de clôturer un trade.", it: "Confermi la sua dimensione netta reale, long o short, in contratti usando la colonna Qty del modulo Positions e la riconcili con i suoi grafici prima di chiudere un trade." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You scaled into a trade, added a contract here, trimmed one there, and now you're not certain whether you're net long two or net long one. Or the chart shows three entry arrows stacked on top of each other and you can't tell what you're actually holding. The Positions module settles it. Its <strong class='text-white'>Qty</strong> column is the one number that tells you exactly how many contracts you hold and which direction you're leaning. Chart arrows, order history, and the TradingView order panel are all secondary. Read the Qty column and you know your true net exposure." },
    { type: "heading", text: "What the Positions Module Shows You" },
    { type: "paragraph", html: "The Positions module lists one row for every open position across your accounts. The columns you'll lean on:" },
    {
      type: "table",
      headers: ["Column", "What it tells you"],
      rows: [
        ["Instrument / Contract", "The market and contract month you're in, like ESZ5."],
        ["Qty", "Your net position size. Positive is long, negative is short, zero is flat."],
        ["Avg Price", "Your volume-weighted average entry, recalculated automatically as you add or trim."],
        ["P/L Open", "Unrealized profit or loss at the current price, updating tick by tick."],
        ["P/L Day", "Your total profit or loss for the session, including trades you've already closed."],
        ["Account", "Which account holds that position."],
      ],
    },
    { type: "paragraph", html: "Tradovate nets your fills, so you won't see a separate long line and short line fighting each other on the same contract in one account. Buy three, sell one, and the row simply reads +2. That single netted number is what your margin, your risk limits, and any prop-firm position cap are measured against, which is exactly why it's the figure worth trusting." },
    { type: "heading", text: "Steps to Confirm Your Net Position Size" },
    {
      type: "steps",
      items: [
        { title: "Open the Positions Module", html: "From the left sidebar, open the module that lists your open positions. It's the same panel you'd use to watch live P/L, so if you already keep it docked, you're a click away.", image: { src: `${IMG}/tradovate-net-position-quantity-1.png`, alt: "Tradovate left sidebar with the Positions module selected" } },
        { title: "Find Your Contract Row", html: "Scan for the row that matches the contract you're trading, and glance at the Account column on that row. If you run several accounts, it's easy to read the wrong line, so confirm both the instrument and the account before you act on the number.", image: { src: `${IMG}/tradovate-net-position-quantity-2.png`, alt: "Positions module row showing the instrument and account for an open contract" } },
        { title: "Read the Qty Column", html: "The sign in the Qty column is your answer. A positive value means you're net long that many contracts; a negative value means you're net short; zero means you're flat and holding nothing. No math on your part, no counting arrows.", image: { src: `${IMG}/tradovate-net-position-quantity-3.png`, alt: "Close-up of the Qty column showing a signed net position value" } },
        { title: "Cross-Check the Average Price, Then Flatten If the Size Is Wrong", html: "Glance at Avg Price to confirm the netted size lines up with the entries you meant to take. If the quantity isn't what you intended, close the row right there. Depending on your platform version the button reads <strong class='text-white'>Flatten</strong> or <strong class='text-white'>Close</strong>, and it shuts the whole position while canceling the working orders tied to it.", image: { src: `${IMG}/tradovate-net-position-quantity-4.png`, alt: "Position row with the flatten or close control that shuts the position and cancels related orders" } },
      ],
    },
    { type: "heading", text: "Reading Long vs Short at a Glance" },
    {
      type: "table",
      headers: ["Qty value", "What you're holding"],
      rows: [
        ["+3", "Net long 3 contracts"],
        ["-2", "Net short 2 contracts"],
        ["0", "Flat, no open exposure"],
      ],
    },
    { type: "heading", text: "Why the Number Changes as You Scale" },
    { type: "paragraph", html: "Every fill updates the row live. Add a contract and the Qty climbs while the Avg Price shifts to the blended entry. Trim a contract and the Qty drops, but the average holds at the level set by your remaining size. That's the point of confirming here rather than eyeballing the chart: after a few partial fills, the Positions module is the only place showing your consolidated size and blended entry in one clean line instead of a scatter of markers." },
    { type: "heading", text: "When the Qty Column Looks Wrong" },
    { type: "paragraph", html: "A few things trip people up. You may be looking at the wrong account in a multi-account setup, so re-check the Account column. Your position might be on a different contract month than the chart you're staring at. Working bracket or stop orders can also look like a position when they haven't filled yet, so separate resting orders from actual fills. And if the TradingView panel and Tradovate disagree, trust the Tradovate Positions module, since that's where the broker's netted truth lives." },
    { type: "paragraph", html: "If you're regularly ending up with more contracts than you meant to hold, put a hard ceiling on it. The maximum contracts you're allowed to carry varies by firm and account size, so check your firm's current rules, then set a max position limit so the platform blocks anything larger. To reconcile a full day of scaling against realized results, pull your account and performance reports after the close." },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "If you automate entries from TradingView, drift between your strategy's intended size and your real net position is where accounts get blown. <strong class='text-white'>PickMyTrade keeps your Tradovate net position in sync with your signals</strong>." },
  ], de: [
    { type: "paragraph",html: "Sie haben in einen Trade hinein aufgestockt, hier einen Kontrakt hinzugefügt, dort einen reduziert, und nun sind Sie nicht sicher, ob Sie netto long zwei oder netto long eins sind. Oder das Chart zeigt drei übereinanderliegende Einstiegspfeile und Sie können nicht erkennen, was Sie tatsächlich halten. Das Positions-Modul klärt das. Die Spalte <strong class='text-white'>Qty</strong> ist die eine Zahl, die Ihnen genau sagt, wie viele Kontrakte Sie halten und in welche Richtung Sie positioniert sind. Chart-Pfeile, Orderhistorie und das TradingView-Orderpanel sind alle nachrangig. Lesen Sie die Spalte Qty, und Sie kennen Ihr wahres Netto-Engagement." },
    { type: "heading",text: "Was das Positions-Modul Ihnen zeigt" },
    { type: "paragraph",html: "Das Positions-Modul listet eine Zeile für jede offene Position über alle Ihre Konten hinweg. Die Spalten, auf die Sie sich stützen werden:" },
    { type: "table", headers: ["Spalte","Was sie Ihnen sagt"], rows: [
      ["Instrument / Contract","Der Markt und der Kontraktmonat, in dem Sie sich befinden, etwa ESZ5."],
      ["Qty","Ihre Netto-Positionsgröße. Positiv ist long, negativ ist short, null ist flat."],
      ["Avg Price","Ihr volumengewichteter durchschnittlicher Einstiegspreis, der beim Aufstocken oder Reduzieren automatisch neu berechnet wird."],
      ["P/L Open","Nicht realisierter Gewinn oder Verlust zum aktuellen Kurs, der sich Tick für Tick aktualisiert."],
      ["P/L Day","Ihr gesamter Gewinn oder Verlust der Sitzung, einschließlich bereits geschlossener Trades."],
      ["Account","Welches Konto diese Position hält."],
    ] },
    { type: "paragraph",html: "Tradovate verrechnet Ihre Fills netto, sodass Sie auf demselben Kontrakt in einem Konto keine getrennten Long- und Short-Zeilen sehen, die gegeneinander laufen. Kaufen Sie drei und verkaufen Sie eins, steht in der Zeile einfach +2. Diese eine verrechnete Zahl ist die Größe, an der Ihre Margin, Ihre Risikolimits und jede Positionsobergrenze einer Prop-Firm gemessen werden, und genau deshalb ist sie die Zahl, der Sie vertrauen sollten." },
    { type: "heading",text: "Schritte zur Bestätigung Ihrer Netto-Positionsgröße" },
    {
      type: "steps",
      items: [
        { title: "Das Positions-Modul öffnen", html: "Öffnen Sie in der linken Seitenleiste das Modul, das Ihre offenen Positionen auflistet. Es ist dasselbe Panel, das Sie zur Beobachtung des laufenden P/L verwenden. Wenn Sie es bereits angedockt haben, sind Sie nur einen Klick entfernt.", image: {"src":`${IMG}/tradovate-net-position-quantity-1.png`,"alt":"Linke Tradovate-Seitenleiste mit ausgewähltem Positions-Modul"} },
        { title: "Ihre Kontraktzeile finden", html: "Suchen Sie die Zeile, die zu dem Kontrakt passt, den Sie handeln, und werfen Sie in dieser Zeile einen Blick auf die Spalte Account. Wenn Sie mehrere Konten betreiben, liest man leicht die falsche Zeile. Bestätigen Sie daher sowohl das Instrument als auch das Konto, bevor Sie auf die Zahl hin handeln.", image: {"src":`${IMG}/tradovate-net-position-quantity-2.png`,"alt":"Zeile im Positions-Modul mit Instrument und Konto für einen offenen Kontrakt"} },
        { title: "Die Spalte Qty lesen", html: "Das Vorzeichen in der Spalte Qty ist Ihre Antwort. Ein positiver Wert bedeutet, dass Sie netto so viele Kontrakte long sind, ein negativer Wert bedeutet netto short, und null bedeutet, dass Sie flat sind und nichts halten. Sie müssen nicht rechnen und keine Pfeile zählen.", image: {"src":`${IMG}/tradovate-net-position-quantity-3.png`,"alt":"Nahaufnahme der Spalte Qty mit einem vorzeichenbehafteten Netto-Positionswert"} },
        { title: "Den Durchschnittspreis gegenprüfen und bei falscher Größe glattstellen", html: "Werfen Sie einen Blick auf Avg Price, um zu bestätigen, dass die verrechnete Größe zu den Einstiegen passt, die Sie beabsichtigt hatten. Entspricht die Menge nicht Ihrer Absicht, schließen Sie die Zeile direkt dort. Je nach Version Ihrer Plattform lautet die Schaltfläche <strong class='text-white'>Flatten</strong> oder <strong class='text-white'>Close</strong>, und sie schließt die gesamte Position und storniert die zugehörigen aktiven Orders.", image: {"src":`${IMG}/tradovate-net-position-quantity-4.png`,"alt":"Positionszeile mit dem Flatten- bzw. Close-Steuerelement, das die Position schließt und zugehörige Orders storniert"} },
      ],
    },
    { type: "heading",text: "Long und Short auf einen Blick lesen" },
    { type: "table", headers: ["Qty-Wert","Was Sie halten"], rows: [
      ["+3","Netto long 3 Kontrakte"],
      ["-2","Netto short 2 Kontrakte"],
      ["0","Flat, kein offenes Engagement"],
    ] },
    { type: "heading",text: "Warum sich die Zahl beim Skalieren ändert" },
    { type: "paragraph",html: "Jeder Fill aktualisiert die Zeile live. Fügen Sie einen Kontrakt hinzu, steigt Qty, während sich Avg Price auf den gemischten Einstieg verschiebt. Reduzieren Sie um einen Kontrakt, sinkt Qty, aber der Durchschnitt bleibt auf dem Niveau, das durch Ihre verbleibende Größe bestimmt ist. Genau darum bestätigen Sie hier, statt das Chart nach Augenmaß zu lesen: Nach ein paar Teil-Fills ist das Positions-Modul der einzige Ort, der Ihre konsolidierte Größe und Ihren gemischten Einstieg in einer klaren Zeile zeigt statt in einer Streuung von Markierungen." },
    { type: "heading",text: "Wenn die Spalte Qty falsch aussieht" },
    { type: "paragraph",html: "Ein paar Dinge bringen Leute aus dem Konzept. Möglicherweise sehen Sie in einem Multi-Konto-Setup das falsche Konto an, prüfen Sie daher die Spalte Account noch einmal. Ihre Position könnte in einem anderen Kontraktmonat liegen als das Chart, auf das Sie starren. Aktive Bracket- oder Stop-Orders können außerdem wie eine Position aussehen, obwohl sie noch nicht ausgeführt wurden. Trennen Sie also wartende Orders von tatsächlichen Fills. Und wenn das TradingView-Panel und Tradovate nicht übereinstimmen, vertrauen Sie dem Tradovate-Positions-Modul, denn dort liegt die verrechnete Wahrheit des Brokers." },
    { type: "paragraph",html: "Wenn Sie regelmäßig mehr Kontrakte halten als beabsichtigt, setzen Sie eine feste Obergrenze. Die maximale Anzahl an Kontrakten, die Sie halten dürfen, hängt von Firma und Kontogröße ab. Prüfen Sie daher die aktuellen Regeln Ihrer Firma und legen Sie dann ein Maximum für die Positionsgröße fest, damit die Plattform alles Größere blockiert. Um einen ganzen Handelstag mit Skalierungen mit den realisierten Ergebnissen abzugleichen, rufen Sie nach Handelsschluss Ihre Konto- und Performance-Berichte ab." },
    { type: "heading",text: "Mit PickMyTrade automatisieren" },
    { type: "paragraph",html: "Wenn Sie Einstiege aus TradingView automatisieren, ist die Abweichung zwischen der beabsichtigten Größe Ihrer Strategie und Ihrer tatsächlichen Nettoposition die Stelle, an der Konten ruiniert werden. <strong class='text-white'>PickMyTrade hält Ihre Tradovate-Nettoposition mit Ihren Signalen synchron</strong>." },
  ], es: [
    { type: "paragraph",html: "Ha ido escalando en una operación, ha añadido un contrato aquí, ha reducido otro allá, y ahora no está seguro de si está neto largo en dos o neto largo en uno. O el gráfico muestra tres flechas de entrada apiladas y no sabe qué tiene realmente. El módulo Positions lo aclara. Su columna <strong class='text-white'>Qty</strong> es el único número que le dice exactamente cuántos contratos mantiene y hacia qué lado está posicionado. Las flechas del gráfico, el historial de órdenes y el panel de órdenes de TradingView son secundarios. Lea la columna Qty y conocerá su exposición neta real." },
    { type: "heading",text: "Qué le muestra el módulo Positions" },
    { type: "paragraph",html: "El módulo Positions muestra una fila por cada posición abierta en todas sus cuentas. Las columnas en las que más se apoyará:" },
    { type: "table", headers: ["Columna","Qué le indica"], rows: [
      ["Instrument / Contract","El mercado y el mes del contrato en el que está, como ESZ5."],
      ["Qty","El tamaño neto de su posición. Positivo es largo, negativo es corto y cero es plano."],
      ["Avg Price","Su precio medio de entrada ponderado por volumen, recalculado automáticamente al añadir o reducir."],
      ["P/L Open","Ganancia o pérdida no realizada al precio actual, que se actualiza tick a tick."],
      ["P/L Day","Su ganancia o pérdida total de la sesión, incluidas las operaciones que ya ha cerrado."],
      ["Account","Qué cuenta mantiene esa posición."],
    ] },
    { type: "paragraph",html: "Tradovate compensa sus ejecuciones, así que no verá una línea larga y otra corta enfrentadas sobre el mismo contrato en una cuenta. Compre tres, venda uno y la fila simplemente indica +2. Ese único número neto es el que se usa para medir su margen, sus límites de riesgo y cualquier tope de posición de una prop firm, y por eso es la cifra en la que merece la pena confiar." },
    { type: "heading",text: "Pasos para confirmar el tamaño neto de su posición" },
    {
      type: "steps",
      items: [
        { title: "Abra el módulo Positions", html: "En la barra lateral izquierda, abra el módulo que enumera sus posiciones abiertas. Es el mismo panel que usaría para vigilar el P/L en vivo, así que si ya lo tiene acoplado, está a un clic.", image: {"src":`${IMG}/tradovate-net-position-quantity-1.png`,"alt":"Barra lateral izquierda de Tradovate con el módulo Positions seleccionado"} },
        { title: "Encuentre la fila de su contrato", html: "Busque la fila que coincide con el contrato que está operando y fíjese en la columna Account de esa fila. Si trabaja con varias cuentas, es fácil leer la línea equivocada, así que confirme tanto el instrumento como la cuenta antes de actuar según el número.", image: {"src":`${IMG}/tradovate-net-position-quantity-2.png`,"alt":"Fila del módulo Positions que muestra el instrumento y la cuenta de un contrato abierto"} },
        { title: "Lea la columna Qty", html: "El signo de la columna Qty es su respuesta. Un valor positivo significa que está neto largo en esa cantidad de contratos; un valor negativo significa que está neto corto; cero significa que está plano y no mantiene nada. Sin cálculos por su parte y sin contar flechas.", image: {"src":`${IMG}/tradovate-net-position-quantity-3.png`,"alt":"Primer plano de la columna Qty con un valor de posición neta con signo"} },
        { title: "Compruebe el precio medio y cierre si el tamaño es incorrecto", html: "Eche un vistazo a Avg Price para confirmar que el tamaño neto coincide con las entradas que pretendía hacer. Si la cantidad no es la que quería, cierre la fila ahí mismo. Según la versión de su plataforma, el botón se llama <strong class='text-white'>Flatten</strong> o <strong class='text-white'>Close</strong>, y cierra la posición completa y cancela las órdenes activas asociadas.", image: {"src":`${IMG}/tradovate-net-position-quantity-4.png`,"alt":"Fila de posición con el control Flatten o Close que cierra la posición y cancela las órdenes relacionadas"} },
      ],
    },
    { type: "heading",text: "Largo frente a corto de un vistazo" },
    { type: "table", headers: ["Valor de Qty","Lo que mantiene"], rows: [
      ["+3","Neto largo en 3 contratos"],
      ["-2","Neto corto en 2 contratos"],
      ["0","Plano, sin exposición abierta"],
    ] },
    { type: "heading",text: "Por qué cambia el número al escalar" },
    { type: "paragraph",html: "Cada ejecución actualiza la fila en vivo. Si añade un contrato, Qty sube mientras Avg Price pasa a la entrada combinada. Si reduce un contrato, Qty baja, pero la media se mantiene en el nivel fijado por el tamaño restante. Ese es el motivo de confirmarlo aquí en lugar de calcularlo a ojo en el gráfico: tras varias ejecuciones parciales, el módulo Positions es el único lugar que muestra su tamaño consolidado y su entrada combinada en una sola línea clara, en lugar de una dispersión de marcadores." },
    { type: "heading",text: "Cuando la columna Qty parece incorrecta" },
    { type: "paragraph",html: "Hay varias cosas que suelen confundir. Puede que esté mirando la cuenta equivocada en una configuración multicuenta, así que vuelva a comprobar la columna Account. Su posición podría estar en un mes de contrato distinto al del gráfico que está mirando. Las órdenes bracket o stop activas también pueden parecer una posición cuando aún no se han ejecutado, así que distinga las órdenes pendientes de las ejecuciones reales. Y si el panel de TradingView y Tradovate no coinciden, confíe en el módulo Positions de Tradovate, porque ahí está la verdad neta del bróker." },
    { type: "paragraph",html: "Si con frecuencia termina con más contratos de los que pretendía mantener, fije un tope firme. El máximo de contratos que puede mantener varía según la empresa y el tamaño de la cuenta, así que consulte las normas vigentes de su empresa y después establezca un límite de posición máxima para que la plataforma bloquee cualquier cosa mayor. Para conciliar un día completo de escalado con los resultados realizados, descargue sus informes de cuenta y de rendimiento después del cierre." },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Si automatiza las entradas desde TradingView, la desviación entre el tamaño previsto por su estrategia y su posición neta real es donde se arruinan las cuentas. <strong class='text-white'>PickMyTrade mantiene su posición neta de Tradovate sincronizada con sus señales</strong>." },
  ], fr: [
    { type: "paragraph",html: "Vous avez renforcé un trade, ajouté un contrat ici, en avez allégé un là, et vous ne savez plus si vous êtes net long de deux ou net long d'un. Ou bien le graphique affiche trois flèches d'entrée empilées et vous ne voyez plus ce que vous détenez réellement. Le module Positions tranche. Sa colonne <strong class='text-white'>Qty</strong> est le seul chiffre qui vous indique exactement combien de contrats vous détenez et dans quel sens vous êtes positionné. Les flèches du graphique, l'historique des ordres et le panneau d'ordres TradingView sont tous secondaires. Lisez la colonne Qty et vous connaissez votre véritable exposition nette." },
    { type: "heading",text: "Ce que le module Positions vous montre" },
    { type: "paragraph",html: "Le module Positions liste une ligne pour chaque position ouverte sur l'ensemble de vos comptes. Les colonnes sur lesquelles vous vous appuierez :" },
    { type: "table", headers: ["Colonne","Ce qu'elle vous indique"], rows: [
      ["Instrument / Contract","Le marché et l'échéance du contrat dans lequel vous êtes, par exemple ESZ5."],
      ["Qty","La taille nette de votre position. Positif signifie long, négatif signifie short, zéro signifie à plat."],
      ["Avg Price","Votre prix d'entrée moyen pondéré par le volume, recalculé automatiquement quand vous renforcez ou allégez."],
      ["P/L Open","Le gain ou la perte latent(e) au cours actuel, mis(e) à jour tick par tick."],
      ["P/L Day","Votre gain ou perte total sur la séance, y compris les trades déjà clôturés."],
      ["Account","Le compte qui détient cette position."],
    ] },
    { type: "paragraph",html: "Tradovate compense vos exécutions : vous ne verrez donc pas une ligne longue et une ligne courte s'opposer sur le même contrat au sein d'un compte. Achetez trois, vendez un, et la ligne indique simplement +2. Ce chiffre net unique est celui sur lequel se mesurent votre marge, vos limites de risque et tout plafond de position d'une prop firm, et c'est précisément pourquoi c'est celui auquel il faut se fier." },
    { type: "heading",text: "Étapes pour confirmer la taille nette de votre position" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir le module Positions", html: "Dans la barre latérale gauche, ouvrez le module qui liste vos positions ouvertes. C'est le même panneau que vous utilisez pour suivre le P/L en direct ; si vous l'avez déjà ancré, vous n'êtes qu'à un clic.", image: {"src":`${IMG}/tradovate-net-position-quantity-1.png`,"alt":"Barre latérale gauche de Tradovate avec le module Positions sélectionné"} },
        { title: "Trouver la ligne de votre contrat", html: "Repérez la ligne qui correspond au contrat que vous tradez et jetez un œil à la colonne Account de cette ligne. Si vous gérez plusieurs comptes, il est facile de lire la mauvaise ligne ; confirmez donc à la fois l'instrument et le compte avant d'agir sur le chiffre.", image: {"src":`${IMG}/tradovate-net-position-quantity-2.png`,"alt":"Ligne du module Positions affichant l'instrument et le compte d'un contrat ouvert"} },
        { title: "Lire la colonne Qty", html: "Le signe dans la colonne Qty est votre réponse. Une valeur positive signifie que vous êtes net long de ce nombre de contrats ; une valeur négative signifie que vous êtes net short ; zéro signifie que vous êtes à plat et ne détenez rien. Aucun calcul de votre part, aucune flèche à compter.", image: {"src":`${IMG}/tradovate-net-position-quantity-3.png`,"alt":"Gros plan sur la colonne Qty affichant une valeur de position nette signée"} },
        { title: "Vérifier le prix moyen, puis clôturer si la taille est incorrecte", html: "Jetez un œil à Avg Price pour confirmer que la taille nette correspond aux entrées que vous aviez prévues. Si la quantité n'est pas celle voulue, fermez la ligne sur-le-champ. Selon la version de votre plateforme, le bouton s'intitule <strong class='text-white'>Flatten</strong> ou <strong class='text-white'>Close</strong>, et il ferme la position entière tout en annulant les ordres actifs qui y sont liés.", image: {"src":`${IMG}/tradovate-net-position-quantity-4.png`,"alt":"Ligne de position avec le contrôle Flatten ou Close qui ferme la position et annule les ordres associés"} },
      ],
    },
    { type: "heading",text: "Lire long et short en un coup d'œil" },
    { type: "table", headers: ["Valeur de Qty","Ce que vous détenez"], rows: [
      ["+3","Net long de 3 contrats"],
      ["-2","Net short de 2 contrats"],
      ["0","À plat, aucune exposition ouverte"],
    ] },
    { type: "heading",text: "Pourquoi le chiffre change quand vous renforcez ou allégez" },
    { type: "paragraph",html: "Chaque exécution met la ligne à jour en direct. Ajoutez un contrat et Qty augmente tandis que Avg Price passe à l'entrée moyenne pondérée. Allégez d'un contrat et Qty diminue, mais la moyenne reste au niveau défini par la taille restante. C'est tout l'intérêt de vérifier ici plutôt que d'évaluer à l'œil sur le graphique : après plusieurs exécutions partielles, le module Positions est le seul endroit qui affiche votre taille consolidée et votre entrée moyenne en une seule ligne claire, plutôt qu'une dispersion de repères." },
    { type: "heading",text: "Quand la colonne Qty semble erronée" },
    { type: "paragraph",html: "Quelques éléments piègent régulièrement. Vous regardez peut-être le mauvais compte dans une configuration multi-comptes ; revérifiez donc la colonne Account. Votre position peut se trouver sur une échéance différente de celle du graphique que vous fixez. Des ordres bracket ou stop actifs peuvent aussi ressembler à une position alors qu'ils n'ont pas encore été exécutés ; distinguez donc les ordres en attente des exécutions réelles. Et si le panneau TradingView et Tradovate divergent, faites confiance au module Positions de Tradovate, car c'est là que se trouve la vérité nette du courtier." },
    { type: "paragraph",html: "Si vous vous retrouvez régulièrement avec plus de contrats que prévu, fixez un plafond strict. Le nombre maximal de contrats que vous pouvez détenir varie selon la société et la taille du compte ; vérifiez donc les règles actuelles de votre société, puis définissez une limite de position maximale afin que la plateforme bloque tout ce qui la dépasse. Pour rapprocher une journée complète de renforcements des résultats réalisés, récupérez vos rapports de compte et de performance après la clôture." },
    { type: "heading",text: "Automatisez tout cela avec PickMyTrade" },
    { type: "paragraph",html: "Si vous automatisez vos entrées depuis TradingView, l'écart entre la taille prévue par votre stratégie et votre position nette réelle est ce qui fait exploser les comptes. <strong class='text-white'>PickMyTrade garde votre position nette Tradovate synchronisée avec vos signaux</strong>." },
  ], it: [
    { type: "paragraph",html: "Ha scalato un trade, ha aggiunto un contratto qui, ne ha ridotto uno là, e ora non è sicuro di essere net long due o net long uno. Oppure il grafico mostra tre frecce di ingresso sovrapposte e non capisce cosa detiene davvero. Il modulo Positions risolve il dubbio. La sua colonna <strong class='text-white'>Qty</strong> è l'unico numero che le dice esattamente quanti contratti detiene e in quale direzione è posizionato. Le frecce sul grafico, lo storico degli ordini e il pannello ordini di TradingView sono tutti secondari. Legga la colonna Qty e conoscerà la sua vera esposizione netta." },
    { type: "heading",text: "Cosa le mostra il modulo Positions" },
    { type: "paragraph",html: "Il modulo Positions elenca una riga per ogni posizione aperta su tutti i suoi conti. Le colonne su cui si baserà:" },
    { type: "table", headers: ["Colonna","Cosa le indica"], rows: [
      ["Instrument / Contract","Il mercato e la scadenza del contratto in cui si trova, ad esempio ESZ5."],
      ["Qty","La dimensione netta della sua posizione. Positivo è long, negativo è short, zero è flat."],
      ["Avg Price","Il suo prezzo medio di ingresso ponderato per il volume, ricalcolato automaticamente man mano che aggiunge o riduce."],
      ["P/L Open","Profitto o perdita non realizzati al prezzo corrente, aggiornati tick dopo tick."],
      ["P/L Day","Il suo profitto o la sua perdita totale della sessione, inclusi i trade già chiusi."],
      ["Account","Quale conto detiene quella posizione."],
    ] },
    { type: "paragraph",html: "Tradovate compensa le sue esecuzioni, quindi non vedrà una riga long e una riga short in contrasto sullo stesso contratto all'interno di un conto. Compri tre, venda uno e la riga indicherà semplicemente +2. Quel singolo numero netto è quello rispetto a cui vengono misurati il suo margine, i suoi limiti di rischio e qualsiasi tetto di posizione di una prop firm, ed è esattamente per questo che è la cifra di cui fidarsi." },
    { type: "heading",text: "Passaggi per confermare la dimensione netta della posizione" },
    {
      type: "steps",
      items: [
        { title: "Aprire il modulo Positions", html: "Dalla barra laterale sinistra, apra il modulo che elenca le sue posizioni aperte. È lo stesso pannello che usa per seguire il P/L in tempo reale, quindi se lo ha già agganciato, è a un clic di distanza.", image: {"src":`${IMG}/tradovate-net-position-quantity-1.png`,"alt":"Barra laterale sinistra di Tradovate con il modulo Positions selezionato"} },
        { title: "Trovare la riga del suo contratto", html: "Cerchi la riga che corrisponde al contratto che sta operando e dia un'occhiata alla colonna Account di quella riga. Se gestisce più conti, è facile leggere la riga sbagliata, quindi confermi sia lo strumento sia il conto prima di agire sul numero.", image: {"src":`${IMG}/tradovate-net-position-quantity-2.png`,"alt":"Riga del modulo Positions che mostra lo strumento e il conto di un contratto aperto"} },
        { title: "Leggere la colonna Qty", html: "Il segno nella colonna Qty è la sua risposta. Un valore positivo significa che è net long di quel numero di contratti; un valore negativo significa che è net short; zero significa che è flat e non detiene nulla. Nessun calcolo da parte sua, nessuna freccia da contare.", image: {"src":`${IMG}/tradovate-net-position-quantity-3.png`,"alt":"Primo piano della colonna Qty con un valore di posizione netta con segno"} },
        { title: "Verificare il prezzo medio, poi chiudere se la dimensione è sbagliata", html: "Dia un'occhiata ad Avg Price per confermare che la dimensione netta corrisponda agli ingressi che intendeva effettuare. Se la quantità non è quella voluta, chiuda subito la riga. A seconda della versione della piattaforma, il pulsante si chiama <strong class='text-white'>Flatten</strong> oppure <strong class='text-white'>Close</strong>, e chiude l'intera posizione annullando gli ordini attivi ad essa collegati.", image: {"src":`${IMG}/tradovate-net-position-quantity-4.png`,"alt":"Riga della posizione con il controllo Flatten o Close che chiude la posizione e annulla gli ordini correlati"} },
      ],
    },
    { type: "heading",text: "Leggere long e short a colpo d'occhio" },
    { type: "table", headers: ["Valore di Qty","Cosa sta detenendo"], rows: [
      ["+3","Net long di 3 contratti"],
      ["-2","Net short di 2 contratti"],
      ["0","Flat, nessuna esposizione aperta"],
    ] },
    { type: "heading",text: "Perché il numero cambia mentre scala" },
    { type: "paragraph",html: "Ogni esecuzione aggiorna la riga in tempo reale. Aggiunga un contratto e Qty sale mentre Avg Price si sposta sull'ingresso medio. Riduca un contratto e Qty scende, ma la media resta al livello determinato dalla dimensione rimanente. Questo è il motivo per cui conviene confermare qui anziché stimare a occhio sul grafico: dopo alcune esecuzioni parziali, il modulo Positions è l'unico posto che mostra la sua dimensione consolidata e il suo ingresso medio in un'unica riga chiara anziché in una dispersione di segnaposto." },
    { type: "heading",text: "Quando la colonna Qty sembra sbagliata" },
    { type: "paragraph",html: "Alcune cose mettono in difficoltà. Potrebbe star guardando il conto sbagliato in una configurazione multi-conto, quindi ricontrolli la colonna Account. La sua posizione potrebbe essere su una scadenza diversa da quella del grafico che sta osservando. Anche gli ordini bracket o stop attivi possono sembrare una posizione quando non sono ancora stati eseguiti, quindi distingua gli ordini in attesa dalle esecuzioni effettive. E se il pannello di TradingView e Tradovate non concordano, si fidi del modulo Positions di Tradovate, perché è lì che si trova la verità netta del broker." },
    { type: "paragraph",html: "Se si ritrova regolarmente con più contratti di quanti intendeva detenere, imposti un tetto rigido. Il numero massimo di contratti che può detenere varia in base alla società e alla dimensione del conto, quindi verifichi le regole attuali della sua società, poi imposti un limite di posizione massima in modo che la piattaforma blocchi qualsiasi cosa più grande. Per riconciliare un'intera giornata di scalatura con i risultati realizzati, scarichi i report del conto e delle performance dopo la chiusura." },
    { type: "heading",text: "Automatizzi tutto con PickMyTrade" },
    { type: "paragraph",html: "Se automatizza gli ingressi da TradingView, lo scostamento tra la dimensione prevista dalla sua strategia e la sua posizione netta reale è il punto in cui i conti saltano. <strong class='text-white'>PickMyTrade mantiene la sua posizione netta su Tradovate sincronizzata con i suoi segnali</strong>." },
  ] },
  ctaHeading: { en: "Keep Your Positions in Sync", de: "Halten Sie Ihre Positionen synchron", es: "Mantenga sus posiciones sincronizadas", fr: "Gardez vos positions synchronisées", it: "Mantenga le sue posizioni sincronizzate" },
