---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-access-token";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Get a Tradovate API Access Token";
const META_DESCRIPTION =
  "Tradovate access token guide: POST your API credentials to accessTokenRequest, get a Bearer token, and authenticate every REST and WebSocket call fast.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate API", de: "Tradovate API", es: "Tradovate API", fr: "Tradovate API", it: "Tradovate API" },
  h1: { en: META_TITLE, de: "Ein Tradovate-API-Access-Token erhalten", es: "Cómo obtener un token de acceso a la API de Tradovate", fr: "Obtenir un jeton d'accès à l'API Tradovate", it: "Come ottenere un token di accesso all'API di Tradovate" },
  dek: { en: "Need to authenticate against the Tradovate API? This guide walks you through trading your credentials for a Bearer access token, one step at a time.", de: "Sie müssen sich an der Tradovate-API authentifizieren? Diese Anleitung zeigt Ihnen Schritt für Schritt, wie Sie Ihre Zugangsdaten gegen ein Bearer-Access-Token eintauschen.", es: "¿Necesita autenticarse en la API de Tradovate? Esta guía le explica, paso a paso, cómo canjear sus credenciales por un token de acceso Bearer.", fr: "Vous devez vous authentifier auprès de l'API Tradovate ? Ce guide vous explique, étape par étape, comment échanger vos identifiants contre un jeton d'accès Bearer.", it: "Deve autenticarsi sull'API di Tradovate? Questa guida le spiega, passo dopo passo, come scambiare le sue credenziali con un token di accesso Bearer." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Need to authenticate against the Tradovate API? Whether you're wiring up a trading bot, pulling account data, or connecting automation like PickMyTrade, this guide walks you through trading your credentials for a Bearer access token, one step at a time." },
    { type: "heading", text: "What Is a Tradovate API Access Token?" },
    { type: "paragraph", html: "A Tradovate access token is a short-lived JWT the API hands back once you send it valid credentials at its <strong class='text-white'>accessTokenRequest</strong> endpoint. From there, you attach that token as a <strong class='text-white'>Bearer</strong> token in the <code>Authorization</code> header of every REST and WebSocket call. It's the key that proves each request belongs to your account. Tokens don't last forever, so any bot or integration has to request one, put it to work, and renew it before it lapses." },
    { type: "heading", text: "Getting a Tradovate Access Token: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Enable API Access and Grab Your Key (cid) and Secret (sec)", html: "Before you can request a token, your account needs the <strong class='text-white'>API Access add-on</strong> switched on. That gives you an API Key, which becomes your <code>cid</code> (client ID), and an API Secret, which becomes your <code>sec</code>. Haven't set that up yet? Run through <a href='https://pickmytrade.trade/how-to/tradovate-api-access/'>Get Tradovate API Access &amp; Generate a Key</a> first, then come back here with your <code>cid</code> and <code>sec</code> in hand." },
        { title: "Build the accessTokenRequest Payload", html: "Put together a JSON body with your Tradovate login <code>name</code> and <code>password</code>, plus <code>appId</code> (any label for your app), <code>appVersion</code>, your <code>cid</code>, your <code>sec</code>, and a stable <code>deviceId</code>. Reuse that same <code>deviceId</code>, a consistent UUID, every single time. It feeds Tradovate's device recognition and 2FA checks, so a value that keeps changing will trip you up." },
        { title: "POST to the accesstokenrequest Endpoint", html: "Send the payload as an HTTP <strong class='text-white'>POST</strong> to <code>/v1/auth/accesstokenrequest</code>. While you're testing, hit the demo host at <code>https://demo.tradovateapi.com</code>; for a funded account, use the live host at <code>https://live.tradovateapi.com</code>. The path is identical, only the host changes." },
        { title: "Read the Access Token From the Response", html: "A successful call comes back with an <code>accessToken</code> (that's your Bearer token), an <code>mdAccessToken</code> for market data, an <code>expirationTime</code>, your <code>userId</code>, and account flags such as <code>hasLive</code>. Grab the <code>accessToken</code> and its <code>expirationTime</code> and hold onto both, so you know exactly when the clock runs out." },
        { title: "Send the Token as a Bearer Header, and Renew Before It Expires", html: "On every request that follows, add the header <code>Authorization: Bearer {accessToken}</code>. Tokens live for roughly <strong class='text-white'>90 minutes</strong>, so a few minutes before that window closes, call <code>/auth/renewAccessToken</code> instead of logging in from scratch. That keeps your session alive without hammering the login endpoint." },
      ],
    },
    { type: "heading", text: "Why You'd Need This" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Build or debug a custom trading bot</strong> or dashboard on Tradovate's API.",
        "<strong class='text-white'>Stream real-time quotes</strong> over the Tradovate WebSocket feed.",
        "<strong class='text-white'>Place, modify, or flatten orders</strong> programmatically.",
        "<strong class='text-white'>Wire a third-party tool or webhook bridge</strong> into your account.",
        "<strong class='text-white'>Pull account, fill, and position data</strong> for journaling or analytics.",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Requesting tokens, tracking expirations, renewing them before they lapse, juggling device IDs, that's a lot of plumbing to babysit. <strong class='text-white'>PickMyTrade connects your TradingView alerts straight to your Tradovate account</strong> and handles the connection and authentication for you. Your signals turn into live orders automatically, with no tokens to manage on your end." },
  ], de: [
    { type: "paragraph",html: "Sie müssen sich an der Tradovate-API authentifizieren? Ob Sie einen Trading-Bot anbinden, Kontodaten abrufen oder eine Automatisierung wie PickMyTrade verbinden: Diese Anleitung zeigt Ihnen Schritt für Schritt, wie Sie Ihre Zugangsdaten gegen ein Bearer-Access-Token eintauschen." },
    { type: "heading",text: "Was ist ein Tradovate-API-Access-Token?" },
    { type: "paragraph",html: "Ein Tradovate-Access-Token ist ein kurzlebiges JWT, das die API zurückgibt, sobald Sie gültige Zugangsdaten an den Endpunkt <strong class='text-white'>accessTokenRequest</strong> senden. Anschließend hängen Sie dieses Token als <strong class='text-white'>Bearer</strong>-Token im <code>Authorization</code>-Header an jeden REST- und WebSocket-Aufruf an. Es ist der Schlüssel, der belegt, dass jede Anfrage zu Ihrem Konto gehört. Tokens gelten nicht ewig, daher muss jeder Bot und jede Integration eines anfordern, nutzen und vor dem Ablauf erneuern." },
    { type: "heading",text: "Ein Tradovate-Access-Token erhalten: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "API-Zugriff aktivieren und Ihren Key (cid) und Secret (sec) abrufen", html: "Bevor Sie ein Token anfordern können, muss für Ihr Konto das <strong class='text-white'>API Access add-on</strong> aktiviert sein. Damit erhalten Sie einen API Key, der zu Ihrer <code>cid</code> (Client-ID) wird, und ein API Secret, das zu Ihrer <code>sec</code> wird. Noch nicht eingerichtet? Gehen Sie zuerst <a href='https://pickmytrade.trade/how-to/tradovate-api-access/'>Tradovate-API-Zugriff erhalten &amp; einen Key erzeugen</a> durch und kehren Sie dann mit Ihrer <code>cid</code> und <code>sec</code> hierher zurück." },
        { title: "Die accessTokenRequest-Payload erstellen", html: "Stellen Sie einen JSON-Body zusammen mit Ihrem Tradovate-Login <code>name</code> und <code>password</code> sowie <code>appId</code> (eine beliebige Bezeichnung für Ihre App), <code>appVersion</code>, Ihrer <code>cid</code>, Ihrer <code>sec</code> und einer stabilen <code>deviceId</code>. Verwenden Sie dieselbe <code>deviceId</code>, eine konsistente UUID, jedes einzelne Mal. Sie fließt in die Geräteerkennung und die 2FA-Prüfungen von Tradovate ein, ein sich ständig ändernder Wert bringt Sie daher zum Stolpern." },
        { title: "An den accesstokenrequest-Endpunkt POSTen", html: "Senden Sie die Payload als HTTP-<strong class='text-white'>POST</strong> an <code>/v1/auth/accesstokenrequest</code>. Während Sie testen, verwenden Sie den Demo-Host unter <code>https://demo.tradovateapi.com</code>; für ein Konto mit echtem Kapital nutzen Sie den Live-Host unter <code>https://live.tradovateapi.com</code>. Der Pfad ist identisch, nur der Host ändert sich." },
        { title: "Das Access-Token aus der Antwort auslesen", html: "Ein erfolgreicher Aufruf liefert einen <code>accessToken</code> (Ihr Bearer-Token), einen <code>mdAccessToken</code> für Marktdaten, eine <code>expirationTime</code>, Ihre <code>userId</code> und Konto-Flags wie <code>hasLive</code>. Übernehmen Sie den <code>accessToken</code> und seine <code>expirationTime</code> und bewahren Sie beide auf, damit Sie genau wissen, wann die Zeit abläuft." },
        { title: "Das Token als Bearer-Header senden und vor Ablauf erneuern", html: "Fügen Sie bei jeder folgenden Anfrage den Header <code>Authorization: Bearer {accessToken}</code> hinzu. Tokens leben etwa <strong class='text-white'>90 Minuten</strong>, rufen Sie daher einige Minuten vor Ende dieses Zeitfensters <code>/auth/renewAccessToken</code> auf, statt sich neu anzumelden. So bleibt Ihre Sitzung aktiv, ohne den Login-Endpunkt zu überlasten." },
      ],
    },
    { type: "heading",text: "Warum Sie das benötigen" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Einen eigenen Trading-Bot</strong> oder ein Dashboard auf Basis der Tradovate-API bauen oder debuggen.",
        "<strong class='text-white'>Echtzeit-Kurse streamen</strong> über den Tradovate-WebSocket-Feed.",
        "<strong class='text-white'>Orders programmatisch platzieren, ändern oder glattstellen</strong>.",
        "<strong class='text-white'>Ein Drittanbieter-Tool oder eine Webhook-Brücke</strong> in Ihr Konto einbinden.",
        "<strong class='text-white'>Konto-, Fill- und Positionsdaten abrufen</strong> für Journal und Analysen.",
      ],
    },
    { type: "heading",text: "Automatisieren Sie das mit PickMyTrade" },
    { type: "paragraph",html: "Tokens anfordern, Ablaufzeiten verfolgen, sie vor dem Verfall erneuern, Geräte-IDs verwalten, das ist eine Menge Installationsaufwand, den man betreuen muss. <strong class='text-white'>PickMyTrade verbindet Ihre TradingView-Alerts direkt mit Ihrem Tradovate-Konto</strong> und übernimmt die Verbindung und die Authentifizierung für Sie. Ihre Signale werden automatisch zu Live-Orders, ohne dass Sie Tokens verwalten müssen." },
  ], es: [
    { type: "paragraph",html: "¿Necesita autenticarse en la API de Tradovate? Ya sea que esté conectando un bot de trading, obteniendo datos de cuenta o integrando una automatización como PickMyTrade, esta guía le explica, paso a paso, cómo canjear sus credenciales por un token de acceso Bearer." },
    { type: "heading",text: "¿Qué es un token de acceso a la API de Tradovate?" },
    { type: "paragraph",html: "Un token de acceso de Tradovate es un JWT de corta duración que la API le devuelve cuando envía credenciales válidas a su endpoint <strong class='text-white'>accessTokenRequest</strong>. A partir de ahí, adjunta ese token como token <strong class='text-white'>Bearer</strong> en el encabezado <code>Authorization</code> de cada llamada REST y WebSocket. Es la clave que demuestra que cada solicitud pertenece a su cuenta. Los tokens no duran para siempre, por lo que cualquier bot o integración debe solicitar uno, usarlo y renovarlo antes de que caduque." },
    { type: "heading",text: "Cómo obtener un token de acceso de Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Habilite el acceso a la API y obtenga su clave (cid) y su secreto (sec)", html: "Antes de poder solicitar un token, su cuenta necesita tener activado el <strong class='text-white'>API Access add-on</strong>. Eso le proporciona una API Key, que se convierte en su <code>cid</code> (ID de cliente), y un API Secret, que se convierte en su <code>sec</code>. ¿Aún no lo ha configurado? Siga primero <a href='https://pickmytrade.trade/how-to/tradovate-api-access/'>Obtener acceso a la API de Tradovate &amp; generar una clave</a> y luego vuelva aquí con su <code>cid</code> y su <code>sec</code> a mano." },
        { title: "Construya el payload de accessTokenRequest", html: "Prepare un cuerpo JSON con su <code>name</code> y <code>password</code> de inicio de sesión de Tradovate, además de <code>appId</code> (cualquier etiqueta para su aplicación), <code>appVersion</code>, su <code>cid</code>, su <code>sec</code> y un <code>deviceId</code> estable. Reutilice ese mismo <code>deviceId</code>, un UUID consistente, absolutamente siempre. Alimenta el reconocimiento de dispositivos y las comprobaciones de 2FA de Tradovate, por lo que un valor que cambia constantemente le causará problemas." },
        { title: "Haga POST al endpoint accesstokenrequest", html: "Envíe el payload como una solicitud HTTP <strong class='text-white'>POST</strong> a <code>/v1/auth/accesstokenrequest</code>. Mientras prueba, use el host demo en <code>https://demo.tradovateapi.com</code>; para una cuenta con fondos reales, use el host live en <code>https://live.tradovateapi.com</code>. La ruta es idéntica, solo cambia el host." },
        { title: "Lea el token de acceso de la respuesta", html: "Una llamada correcta devuelve un <code>accessToken</code> (su token Bearer), un <code>mdAccessToken</code> para datos de mercado, un <code>expirationTime</code>, su <code>userId</code> e indicadores de cuenta como <code>hasLive</code>. Conserve el <code>accessToken</code> y su <code>expirationTime</code> para saber exactamente cuándo se agota el tiempo." },
        { title: "Envíe el token como encabezado Bearer y renuévelo antes de que caduque", html: "En cada solicitud posterior, añada el encabezado <code>Authorization: Bearer {accessToken}</code>. Los tokens duran aproximadamente <strong class='text-white'>90 minutos</strong>, así que unos minutos antes de que se cierre esa ventana, llame a <code>/auth/renewAccessToken</code> en lugar de iniciar sesión desde cero. Así mantiene viva su sesión sin saturar el endpoint de inicio de sesión." },
      ],
    },
    { type: "heading",text: "Por qué lo necesitaría" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Crear o depurar un bot de trading personalizado</strong> o un panel sobre la API de Tradovate.",
        "<strong class='text-white'>Transmitir cotizaciones en tiempo real</strong> a través del feed WebSocket de Tradovate.",
        "<strong class='text-white'>Colocar, modificar o cerrar órdenes</strong> de forma programática.",
        "<strong class='text-white'>Conectar una herramienta de terceros o un puente de webhooks</strong> a su cuenta.",
        "<strong class='text-white'>Obtener datos de cuenta, ejecuciones y posiciones</strong> para diario o analítica.",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Solicitar tokens, controlar vencimientos, renovarlos antes de que caduquen, gestionar IDs de dispositivo, es mucha infraestructura que vigilar. <strong class='text-white'>PickMyTrade conecta sus alertas de TradingView directamente con su cuenta de Tradovate</strong> y se encarga de la conexión y la autenticación por usted. Sus señales se convierten automáticamente en órdenes reales, sin tokens que gestionar por su parte." },
  ], fr: [
    { type: "paragraph",html: "Vous devez vous authentifier auprès de l'API Tradovate ? Que vous connectiez un bot de trading, récupériez des données de compte ou intégriez une automatisation comme PickMyTrade, ce guide vous explique, étape par étape, comment échanger vos identifiants contre un jeton d'accès Bearer." },
    { type: "heading",text: "Qu'est-ce qu'un jeton d'accès à l'API Tradovate ?" },
    { type: "paragraph",html: "Un jeton d'accès Tradovate est un JWT de courte durée que l'API vous renvoie dès que vous envoyez des identifiants valides à son endpoint <strong class='text-white'>accessTokenRequest</strong>. Vous joignez ensuite ce jeton comme jeton <strong class='text-white'>Bearer</strong> dans l'en-tête <code>Authorization</code> de chaque appel REST et WebSocket. C'est la clé qui prouve que chaque requête appartient à votre compte. Les jetons ne durent pas éternellement : tout bot ou toute intégration doit donc en demander un, l'utiliser et le renouveler avant son expiration." },
    { type: "heading",text: "Obtenir un jeton d'accès Tradovate : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Activez l'accès API et récupérez votre clé (cid) et votre secret (sec)", html: "Avant de pouvoir demander un jeton, votre compte doit avoir le <strong class='text-white'>API Access add-on</strong> activé. Vous obtenez ainsi une API Key, qui devient votre <code>cid</code> (identifiant client), et un API Secret, qui devient votre <code>sec</code>. Vous ne l'avez pas encore configuré ? Suivez d'abord <a href='https://pickmytrade.trade/how-to/tradovate-api-access/'>Obtenir l'accès à l'API Tradovate &amp; générer une clé</a>, puis revenez ici avec votre <code>cid</code> et votre <code>sec</code> en main." },
        { title: "Construisez le payload accessTokenRequest", html: "Composez un corps JSON avec votre <code>name</code> et votre <code>password</code> de connexion Tradovate, ainsi que <code>appId</code> (n'importe quel libellé pour votre application), <code>appVersion</code>, votre <code>cid</code>, votre <code>sec</code> et un <code>deviceId</code> stable. Réutilisez ce même <code>deviceId</code>, un UUID constant, à chaque fois. Il alimente la reconnaissance d'appareil et les contrôles 2FA de Tradovate ; une valeur qui change sans cesse vous posera donc problème." },
        { title: "Faites un POST vers l'endpoint accesstokenrequest", html: "Envoyez le payload en <strong class='text-white'>POST</strong> HTTP vers <code>/v1/auth/accesstokenrequest</code>. Pendant vos tests, utilisez l'hôte demo à l'adresse <code>https://demo.tradovateapi.com</code> ; pour un compte financé, utilisez l'hôte live à l'adresse <code>https://live.tradovateapi.com</code>. Le chemin est identique, seul l'hôte change." },
        { title: "Lisez le jeton d'accès dans la réponse", html: "Un appel réussi renvoie un <code>accessToken</code> (votre jeton Bearer), un <code>mdAccessToken</code> pour les données de marché, un <code>expirationTime</code>, votre <code>userId</code> et des indicateurs de compte tels que <code>hasLive</code>. Récupérez l'<code>accessToken</code> et son <code>expirationTime</code> et conservez-les tous deux, afin de savoir exactement quand le délai s'écoule." },
        { title: "Envoyez le jeton en en-tête Bearer et renouvelez-le avant son expiration", html: "Sur chaque requête suivante, ajoutez l'en-tête <code>Authorization: Bearer {accessToken}</code>. Les jetons durent environ <strong class='text-white'>90 minutes</strong> ; quelques minutes avant la fin de cette fenêtre, appelez donc <code>/auth/renewAccessToken</code> au lieu de vous reconnecter de zéro. Cela maintient votre session active sans solliciter à outrance l'endpoint de connexion." },
      ],
    },
    { type: "heading",text: "Pourquoi vous en auriez besoin" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Créer ou déboguer un bot de trading personnalisé</strong> ou un tableau de bord sur l'API Tradovate.",
        "<strong class='text-white'>Diffuser des cotations en temps réel</strong> via le flux WebSocket de Tradovate.",
        "<strong class='text-white'>Passer, modifier ou clôturer des ordres</strong> par programmation.",
        "<strong class='text-white'>Raccorder un outil tiers ou un pont webhook</strong> à votre compte.",
        "<strong class='text-white'>Récupérer les données de compte, d'exécutions et de positions</strong> pour le journal ou l'analyse.",
      ],
    },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Demander des jetons, suivre les expirations, les renouveler avant l'échéance, jongler avec les identifiants d'appareil : cela représente beaucoup de plomberie à surveiller. <strong class='text-white'>PickMyTrade relie vos alertes TradingView directement à votre compte Tradovate</strong> et gère la connexion et l'authentification pour vous. Vos signaux deviennent automatiquement des ordres réels, sans aucun jeton à gérer de votre côté." },
  ], it: [
    { type: "paragraph",html: "Deve autenticarsi sull'API di Tradovate? Che stia collegando un bot di trading, recuperando dati del conto o integrando un'automazione come PickMyTrade, questa guida le spiega, passo dopo passo, come scambiare le sue credenziali con un token di accesso Bearer." },
    { type: "heading",text: "Che cos'è un token di accesso all'API di Tradovate?" },
    { type: "paragraph",html: "Un token di accesso di Tradovate è un JWT di breve durata che l'API le restituisce quando invia credenziali valide al suo endpoint <strong class='text-white'>accessTokenRequest</strong>. Da lì, allega quel token come token <strong class='text-white'>Bearer</strong> nell'header <code>Authorization</code> di ogni chiamata REST e WebSocket. È la chiave che dimostra che ogni richiesta appartiene al suo conto. I token non durano per sempre, quindi qualsiasi bot o integrazione deve richiederne uno, utilizzarlo e rinnovarlo prima che scada." },
    { type: "heading",text: "Ottenere un token di accesso di Tradovate: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Abiliti l'accesso API e prenda la sua chiave (cid) e il suo secret (sec)", html: "Prima di poter richiedere un token, sul suo conto deve essere attivato l'<strong class='text-white'>API Access add-on</strong>. Questo le fornisce una API Key, che diventa il suo <code>cid</code> (ID client), e un API Secret, che diventa il suo <code>sec</code>. Non lo ha ancora configurato? Segua prima <a href='https://pickmytrade.trade/how-to/tradovate-api-access/'>Ottenere l'accesso all'API di Tradovate &amp; generare una chiave</a>, poi torni qui con il suo <code>cid</code> e il suo <code>sec</code> a portata di mano." },
        { title: "Costruisca il payload di accessTokenRequest", html: "Prepari un body JSON con il <code>name</code> e la <code>password</code> del suo login Tradovate, più <code>appId</code> (un'etichetta qualsiasi per la sua app), <code>appVersion</code>, il suo <code>cid</code>, il suo <code>sec</code> e un <code>deviceId</code> stabile. Riutilizzi lo stesso <code>deviceId</code>, un UUID costante, ogni singola volta. Alimenta il riconoscimento dei dispositivi e i controlli 2FA di Tradovate, quindi un valore che cambia di continuo le creerà problemi." },
        { title: "Invii una POST all'endpoint accesstokenrequest", html: "Invii il payload come <strong class='text-white'>POST</strong> HTTP a <code>/v1/auth/accesstokenrequest</code>. Durante i test, usi l'host demo all'indirizzo <code>https://demo.tradovateapi.com</code>; per un conto finanziato, usi l'host live all'indirizzo <code>https://live.tradovateapi.com</code>. Il percorso è identico, cambia solo l'host." },
        { title: "Legga il token di accesso dalla risposta", html: "Una chiamata riuscita restituisce un <code>accessToken</code> (il suo token Bearer), un <code>mdAccessToken</code> per i dati di mercato, un <code>expirationTime</code>, il suo <code>userId</code> e flag del conto come <code>hasLive</code>. Prenda l'<code>accessToken</code> e il suo <code>expirationTime</code> e li conservi entrambi, così sa esattamente quando scade il tempo." },
