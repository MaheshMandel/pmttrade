---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-mobile-app";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Install the Tradovate Mobile App (iOS & Android)";
const META_DESCRIPTION =
  "Install the Tradovate mobile app on iPhone, iPad, or Android in minutes, then monitor positions, manage orders, and trade futures from anywhere.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Die Tradovate-Mobile-App installieren (iOS & Android)", es: "Instale la aplicación móvil de Tradovate (iOS y Android)", fr: "Installer l'application mobile Tradovate (iOS et Android)", it: "Installare l'app mobile di Tradovate (iOS e Android)" },
  dek: { en: "Being chained to a desktop isn't realistic when you trade futures. Here's how to get the native Tradovate app installed on an iPhone, iPad, or Android device, plus what to try if the download stalls.", de: "An einen Desktop gefesselt zu sein, ist beim Futures-Handel unrealistisch. So installieren Sie die native Tradovate-App auf einem iPhone, iPad oder Android-Gerät und was Sie versuchen können, wenn der Download hängt.", es: "Estar atado a un ordenador de escritorio no es realista cuando opera con futuros. Así se instala la aplicación nativa de Tradovate en un iPhone, un iPad o un dispositivo Android, y qué probar si la descarga se detiene.", fr: "Être rivé à un ordinateur de bureau n'est pas réaliste quand on trade les contrats à terme. Voici comment installer l'application native Tradovate sur un iPhone, un iPad ou un appareil Android, et que faire si le téléchargement bloque.", it: "Essere legati a un desktop non è realistico quando si fa trading sui futures. Ecco come installare l'app nativa di Tradovate su iPhone, iPad o dispositivo Android, e cosa provare se il download si blocca." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Being chained to a desktop isn't realistic when you trade futures. Price keeps moving while you're away from the screen, and at the very least you want to check your positions and flatten a trade from your phone. The native Tradovate app puts that in your pocket, charts, the DOM, brackets, and your live or simulated account, all laid out for a phone." },
    { type: "paragraph", html: "Here's how to get it installed on an iPhone, iPad, or Android device, plus what to try if the download stalls." },
    { type: "heading", text: "Before You Start" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>You need a Tradovate account already.</strong> If you're on a prop-firm evaluation, your login comes from the firm, not from Tradovate directly, check your firm's dashboard for the exact username and password. Those details vary by firm and account, so use whatever your firm's current rules point you to.",
        "<strong class='text-white'>Your device has to be recent enough.</strong> If you're running an old or discontinued operating system, the app may not even show up as installable in the store. When that happens, updating the OS usually fixes it.",
      ],
    },
    { type: "table", headers: ["", "iPhone / iPad", "Android"], rows: [
      ["App name in the store", "Tradovate: Trade &amp; Invest", "Tradovate: Futures Trading"],
      ["Published by", "Tradovate LLC", "Tradovate LLC"],
      ["Price", "Free", "Free"],
      ["Where to get it", "Apple App Store", "Google Play Store"],
    ] },
    { type: "heading", text: "Install It in Five Steps" },
    {
      type: "steps",
      items: [
        { title: "Confirm Your Device Can Run It", html: "Before you go hunting, make sure your phone or tablet is current enough. The iPhone and iPad app runs on iOS 12.4 or later; the Android app needs Android 7.0 or newer. Those minimums creep up over time as the app gets updated, so treat the store listing as the source of truth. If your device is too old, the app simply won't appear as installable." },
        { title: "Open Your App Store", html: "On an iPhone or iPad, open the <strong class='text-white'>App Store</strong>. On Android, open the <strong class='text-white'>Google Play Store</strong>. Both come preinstalled on the device, so there's nothing extra to download to get started.", image: { src: `${IMG}/tradovate-mobile-app-2.jpg`, alt: "App Store icon on iOS and Google Play Store icon on Android" } },
        { title: "Search for Tradovate and Grab the Right App", html: "Tap search and type <strong class='text-white'>Tradovate</strong>. On iOS you want <strong class='text-white'>Tradovate: Trade &amp; Invest</strong>; on Android it's <strong class='text-white'>Tradovate: Futures Trading</strong>. Both are published by Tradovate LLC and both are free. Check that developer name before you tap, copycat finance apps love to ride on a known brand, and you don't want to hand credentials to the wrong one.", image: { src: `${IMG}/tradovate-mobile-app-3.jpg`, alt: "Search results showing the official Tradovate app published by Tradovate LLC" } },
        { title: "Download and Open It", html: "Tap <strong class='text-white'>Get</strong> on iOS or <strong class='text-white'>Install</strong> on Android. You may be asked for Face ID, a fingerprint, or your account password to approve the download. Once it finishes, open it straight from the store button, or find the icon on your home screen or in your app drawer.", image: { src: `${IMG}/tradovate-mobile-app-4.jpg`, alt: "Get and Install buttons for downloading the Tradovate mobile app" } },
        { title: "Log In and Pick Your Account", html: "Sign in with the same email and password you use on the Tradovate web platform. Prop-firm traders use the credentials the firm issued, those are separate from a personal Tradovate login. After you accept the standard agreements, you choose which account to trade: a <strong class='text-white'>Simulation</strong> (demo) account for practice, or your <strong class='text-white'>Live</strong> account for real money. The selector sits right on the login and account screen; tap the one you want and you're in. Since the app gets updated regularly, the exact label on that toggle can shift, so just pick the account type that matches what you're trying to do." },
      ],
    },
    { type: "heading", text: "If the App Won't Install" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Old operating system.</strong> This is the usual culprit. Update iOS or Android to a supported version, then try the store again.",
        "<strong class='text-white'>Storage or account limits.</strong> Make sure you've got free space, and that your App Store or Google Play account isn't restricted from finance apps.",
        "<strong class='text-white'>Still stuck?</strong> Use the web platform in the meantime. Open <strong class='text-white'>trader.tradovate.com</strong> in any mobile browser and you'll have your account right there.",
      ],
    },
    { type: "heading", text: "Want the Full Desktop Layout on Your Phone?" },
    { type: "paragraph", html: "The app is deliberately trimmed down for a small screen. If you'd rather have the complete web layout, open <strong class='text-white'>trader.tradovate.com</strong> in Safari or Chrome and use your browser's \"Add to Home Screen\" option. That gives you a full-featured shortcut that behaves like an app, without going through an app store at all." },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Watching your account from your phone is one thing, not having to babysit it is better. <strong class='text-white'>PickMyTrade automates your TradingView strategies straight into Tradovate</strong>, so your entries and exits fire on their own whether the mobile app is open or not." },
  ], de: [
    { type: "paragraph",html: "An einen Desktop gefesselt zu sein, ist beim Futures-Handel unrealistisch. Der Kurs bewegt sich weiter, während Sie nicht am Bildschirm sind, und zumindest möchten Sie Ihre Positionen prüfen und einen Trade vom Smartphone aus glattstellen können. Die native Tradovate-App bringt das in Ihre Tasche: Charts, das DOM, Brackets und Ihr Live- oder Simulationskonto, alles für das Smartphone aufbereitet." },
    { type: "paragraph",html: "So installieren Sie sie auf einem iPhone, iPad oder Android-Gerät, und was Sie versuchen können, wenn der Download hängt." },
    { type: "heading",text: "Bevor Sie beginnen" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Sie benötigen bereits ein Tradovate-Konto.</strong> Wenn Sie eine Prop-Firm-Evaluierung nutzen, stammen Ihre Zugangsdaten von der Firma und nicht direkt von Tradovate. Den genauen Benutzernamen und das Passwort finden Sie im Dashboard Ihrer Firma. Diese Angaben unterscheiden sich je nach Firma und Konto, richten Sie sich also nach den aktuellen Regeln Ihrer Firma.",
        "<strong class='text-white'>Ihr Gerät muss aktuell genug sein.</strong> Läuft darauf ein altes oder nicht mehr unterstütztes Betriebssystem, wird die App im Store möglicherweise nicht einmal als installierbar angezeigt. In diesem Fall behebt ein Update des Betriebssystems das Problem meist.",
      ],
    },
    { type: "table", headers: ["","iPhone / iPad","Android"], rows: [
      ["App-Name im Store","Tradovate: Trade &amp; Invest","Tradovate: Futures Trading"],
      ["Herausgegeben von","Tradovate LLC","Tradovate LLC"],
      ["Preis","Kostenlos","Kostenlos"],
      ["Bezugsquelle","Apple App Store","Google Play Store"],
    ] },
    { type: "heading",text: "In fünf Schritten installieren" },
    {
      type: "steps",
      items: [
        { title: "Prüfen, ob Ihr Gerät sie ausführen kann", html: "Stellen Sie vor der Suche sicher, dass Ihr Smartphone oder Tablet aktuell genug ist. Die App für iPhone und iPad läuft ab iOS 12.4, die Android-App benötigt Android 7.0 oder neuer. Diese Mindestanforderungen steigen mit der Zeit, wenn die App aktualisiert wird, betrachten Sie daher den Store-Eintrag als maßgebliche Quelle. Ist Ihr Gerät zu alt, erscheint die App schlicht nicht als installierbar." },
        { title: "Ihren App Store öffnen", html: "Öffnen Sie auf einem iPhone oder iPad den <strong class='text-white'>App Store</strong>. Auf Android öffnen Sie den <strong class='text-white'>Google Play Store</strong>. Beide sind auf dem Gerät vorinstalliert, Sie müssen also nichts zusätzlich herunterladen, um zu beginnen.", image: {"src":`${IMG}/tradovate-mobile-app-2.jpg`,"alt":"App-Store-Symbol unter iOS und Google-Play-Store-Symbol unter Android"} },
        { title: "Nach Tradovate suchen und die richtige App wählen", html: "Tippen Sie auf die Suche und geben Sie <strong class='text-white'>Tradovate</strong> ein. Unter iOS benötigen Sie <strong class='text-white'>Tradovate: Trade &amp; Invest</strong>, unter Android <strong class='text-white'>Tradovate: Futures Trading</strong>. Beide werden von Tradovate LLC herausgegeben und beide sind kostenlos. Prüfen Sie den Namen des Entwicklers, bevor Sie tippen: Nachahmer-Finanz-Apps hängen sich gern an bekannte Marken, und Sie möchten Ihre Zugangsdaten nicht der falschen App anvertrauen.", image: {"src":`${IMG}/tradovate-mobile-app-3.jpg`,"alt":"Suchergebnisse mit der offiziellen Tradovate-App von Tradovate LLC"} },
        { title: "Herunterladen und öffnen", html: "Tippen Sie unter iOS auf <strong class='text-white'>Get</strong> bzw. unter Android auf <strong class='text-white'>Install</strong>. Eventuell werden Sie nach Face ID, Fingerabdruck oder Ihrem Kontopasswort gefragt, um den Download zu bestätigen. Sobald er abgeschlossen ist, öffnen Sie die App direkt über die Store-Schaltfläche oder finden das Symbol auf Ihrem Home-Bildschirm oder in Ihrer App-Übersicht.", image: {"src":`${IMG}/tradovate-mobile-app-4.jpg`,"alt":"Schaltflächen Get und Install zum Herunterladen der Tradovate-Mobile-App"} },
        { title: "Anmelden und Ihr Konto wählen", html: "Melden Sie sich mit derselben E-Mail-Adresse und demselben Passwort an, die Sie auf der Tradovate-Webplattform verwenden. Prop-Firm-Trader nutzen die von der Firma ausgestellten Zugangsdaten, diese sind getrennt von einem persönlichen Tradovate-Login. Nachdem Sie die üblichen Vereinbarungen akzeptiert haben, wählen Sie das Konto zum Handeln: ein <strong class='text-white'>Simulation</strong>-Konto (Demo) zum Üben oder Ihr <strong class='text-white'>Live</strong>-Konto für echtes Geld. Die Auswahl befindet sich direkt auf dem Anmelde- und Kontobildschirm. Tippen Sie auf das gewünschte Konto, und Sie sind drin. Da die App regelmäßig aktualisiert wird, kann sich die genaue Bezeichnung dieses Schalters ändern. Wählen Sie also einfach den Kontotyp, der zu Ihrem Vorhaben passt." },
      ],
    },
    { type: "heading",text: "Wenn sich die App nicht installieren lässt" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Altes Betriebssystem.</strong> Das ist die übliche Ursache. Aktualisieren Sie iOS oder Android auf eine unterstützte Version und versuchen Sie es dann erneut im Store.",
        "<strong class='text-white'>Speicherplatz oder Kontobeschränkungen.</strong> Stellen Sie sicher, dass genügend freier Speicher vorhanden ist und dass Ihr App-Store- oder Google-Play-Konto nicht für Finanz-Apps eingeschränkt ist.",
        "<strong class='text-white'>Immer noch Probleme?</strong> Nutzen Sie in der Zwischenzeit die Webplattform. Öffnen Sie <strong class='text-white'>trader.tradovate.com</strong> in einem beliebigen mobilen Browser, und Ihr Konto steht Ihnen sofort zur Verfügung.",
      ],
    },
    { type: "heading",text: "Den vollständigen Desktop-Aufbau auf dem Smartphone?" },
    { type: "paragraph",html: "Die App ist bewusst für einen kleinen Bildschirm abgespeckt. Wenn Sie lieber das komplette Web-Layout möchten, öffnen Sie <strong class='text-white'>trader.tradovate.com</strong> in Safari oder Chrome und verwenden Sie die Browser-Option „Add to Home Screen“. Damit erhalten Sie eine voll ausgestattete Verknüpfung, die sich wie eine App verhält, ganz ohne Umweg über einen App Store." },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "Ihr Konto vom Smartphone aus zu beobachten ist eine Sache, es nicht beaufsichtigen zu müssen, ist besser. <strong class='text-white'>PickMyTrade automatisiert Ihre TradingView-Strategien direkt in Tradovate</strong>, sodass Ihre Einstiege und Ausstiege von selbst ausgelöst werden, ob die Mobile-App geöffnet ist oder nicht." },
  ], es: [
    { type: "paragraph",html: "Estar atado a un ordenador de escritorio no es realista cuando opera con futuros. El precio sigue moviéndose mientras usted está lejos de la pantalla y, como mínimo, querrá revisar sus posiciones y cerrar una operación desde el teléfono. La aplicación nativa de Tradovate pone eso en su bolsillo: gráficos, el DOM, brackets y su cuenta real o simulada, todo adaptado al teléfono." },
    { type: "paragraph",html: "Así se instala en un iPhone, un iPad o un dispositivo Android, y qué probar si la descarga se detiene." },
    { type: "heading",text: "Antes de empezar" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Ya necesita una cuenta de Tradovate.</strong> Si está en una evaluación de prop firm, sus credenciales las proporciona la firma, no Tradovate directamente; consulte el panel de su firma para ver el nombre de usuario y la contraseña exactos. Esos datos varían según la firma y la cuenta, así que use lo que indiquen las reglas actuales de su firma.",
        "<strong class='text-white'>Su dispositivo debe ser lo bastante reciente.</strong> Si tiene un sistema operativo antiguo o discontinuado, es posible que la aplicación ni siquiera aparezca como instalable en la tienda. En ese caso, actualizar el sistema operativo suele solucionarlo.",
      ],
    },
    { type: "table", headers: ["","iPhone / iPad","Android"], rows: [
      ["Nombre de la app en la tienda","Tradovate: Trade &amp; Invest","Tradovate: Futures Trading"],
      ["Publicada por","Tradovate LLC","Tradovate LLC"],
      ["Precio","Gratis","Gratis"],
      ["Dónde obtenerla","Apple App Store","Google Play Store"],
    ] },
    { type: "heading",text: "Instálela en cinco pasos" },
    {
      type: "steps",
      items: [
        { title: "Confirme que su dispositivo puede ejecutarla", html: "Antes de buscarla, asegúrese de que su teléfono o tableta sea lo bastante reciente. La aplicación para iPhone y iPad funciona en iOS 12.4 o posterior; la de Android requiere Android 7.0 o superior. Esos mínimos aumentan con el tiempo a medida que se actualiza la aplicación, así que tome la ficha de la tienda como fuente de referencia. Si su dispositivo es demasiado antiguo, la aplicación simplemente no aparecerá como instalable." },
        { title: "Abra su tienda de aplicaciones", html: "En un iPhone o iPad, abra la <strong class='text-white'>App Store</strong>. En Android, abra la <strong class='text-white'>Google Play Store</strong>. Ambas vienen preinstaladas en el dispositivo, así que no hay nada extra que descargar para empezar.", image: {"src":`${IMG}/tradovate-mobile-app-2.jpg`,"alt":"Icono de App Store en iOS e icono de Google Play Store en Android"} },
        { title: "Busque Tradovate y elija la aplicación correcta", html: "Toque la búsqueda y escriba <strong class='text-white'>Tradovate</strong>. En iOS necesita <strong class='text-white'>Tradovate: Trade &amp; Invest</strong>; en Android es <strong class='text-white'>Tradovate: Futures Trading</strong>. Ambas están publicadas por Tradovate LLC y ambas son gratuitas. Compruebe el nombre del desarrollador antes de tocar: a las aplicaciones financieras imitadoras les encanta aprovecharse de una marca conocida, y no querrá entregar sus credenciales a la equivocada.", image: {"src":`${IMG}/tradovate-mobile-app-3.jpg`,"alt":"Resultados de búsqueda con la aplicación oficial de Tradovate publicada por Tradovate LLC"} },
        { title: "Descárguela y ábrala", html: "Toque <strong class='text-white'>Get</strong> en iOS o <strong class='text-white'>Install</strong> en Android. Es posible que se le pida Face ID, una huella dactilar o la contraseña de su cuenta para aprobar la descarga. Cuando termine, ábrala directamente desde el botón de la tienda o busque el icono en su pantalla de inicio o en el cajón de aplicaciones.", image: {"src":`${IMG}/tradovate-mobile-app-4.jpg`,"alt":"Botones Get e Install para descargar la aplicación móvil de Tradovate"} },
        { title: "Inicie sesión y elija su cuenta", html: "Inicie sesión con el mismo correo electrónico y la misma contraseña que usa en la plataforma web de Tradovate. Los traders de prop firm usan las credenciales que emitió la firma, que son independientes de un inicio de sesión personal de Tradovate. Tras aceptar los acuerdos habituales, elige la cuenta con la que operar: una cuenta de <strong class='text-white'>Simulation</strong> (demo) para practicar o su cuenta <strong class='text-white'>Live</strong> para dinero real. El selector está justo en la pantalla de inicio de sesión y de cuenta; toque el que desee y ya está dentro. Como la aplicación se actualiza con regularidad, la etiqueta exacta de ese interruptor puede cambiar, así que elija el tipo de cuenta que corresponda a lo que quiere hacer." },
      ],
    },
    { type: "heading",text: "Si la aplicación no se instala" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Sistema operativo antiguo.</strong> Es la causa habitual. Actualice iOS o Android a una versión compatible y vuelva a intentarlo en la tienda.",
        "<strong class='text-white'>Almacenamiento o límites de la cuenta.</strong> Asegúrese de tener espacio libre y de que su cuenta de App Store o Google Play no tenga restringidas las aplicaciones financieras.",
        "<strong class='text-white'>¿Sigue sin funcionar?</strong> Use la plataforma web mientras tanto. Abra <strong class='text-white'>trader.tradovate.com</strong> en cualquier navegador móvil y tendrá su cuenta allí mismo.",
      ],
    },
    { type: "heading",text: "¿Quiere el diseño completo de escritorio en su teléfono?" },
    { type: "paragraph",html: "La aplicación está deliberadamente simplificada para una pantalla pequeña. Si prefiere el diseño web completo, abra <strong class='text-white'>trader.tradovate.com</strong> en Safari o Chrome y use la opción «Add to Home Screen» de su navegador. Eso le da un acceso directo con todas las funciones que se comporta como una aplicación, sin pasar por ninguna tienda de aplicaciones." },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Vigilar su cuenta desde el teléfono es una cosa; no tener que estar pendiente de ella es mejor. <strong class='text-white'>PickMyTrade automatiza sus estrategias de TradingView directamente en Tradovate</strong>, de modo que sus entradas y salidas se ejecutan solas, con la aplicación móvil abierta o no." },
  ], fr: [
    { type: "paragraph",html: "Être rivé à un ordinateur de bureau n'est pas réaliste quand on trade les contrats à terme. Le prix continue de bouger pendant que vous êtes loin de l'écran, et vous voulez au minimum vérifier vos positions et clôturer un trade depuis votre téléphone. L'application native Tradovate met cela dans votre poche : graphiques, DOM, brackets et votre compte réel ou simulé, le tout adapté au téléphone." },
    { type: "paragraph",html: "Voici comment l'installer sur un iPhone, un iPad ou un appareil Android, et que tenter si le téléchargement bloque." },
    { type: "heading",text: "Avant de commencer" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Vous avez déjà besoin d'un compte Tradovate.</strong> Si vous êtes en évaluation avec une prop firm, vos identifiants viennent de la firme et non directement de Tradovate ; consultez le tableau de bord de votre firme pour le nom d'utilisateur et le mot de passe exacts. Ces informations varient selon la firme et le compte, alors suivez les règles actuelles de votre firme.",
        "<strong class='text-white'>Votre appareil doit être assez récent.</strong> Si vous utilisez un système d'exploitation ancien ou abandonné, l'application peut même ne pas apparaître comme installable dans la boutique. Dans ce cas, mettre à jour le système résout généralement le problème.",
      ],
    },
    { type: "table", headers: ["","iPhone / iPad","Android"], rows: [
      ["Nom de l'app dans la boutique","Tradovate: Trade &amp; Invest","Tradovate: Futures Trading"],
      ["Éditée par","Tradovate LLC","Tradovate LLC"],
      ["Prix","Gratuite","Gratuite"],
      ["Où la trouver","Apple App Store","Google Play Store"],
    ] },
    { type: "heading",text: "L'installer en cinq étapes" },
    {
      type: "steps",
      items: [
        { title: "Vérifier que votre appareil peut l'exécuter", html: "Avant de la chercher, assurez-vous que votre téléphone ou votre tablette est assez récent. L'application iPhone et iPad fonctionne sous iOS 12.4 ou version ultérieure ; l'application Android nécessite Android 7.0 ou plus récent. Ces minimums augmentent avec le temps au fil des mises à jour de l'application ; considérez donc la fiche de la boutique comme la source de référence. Si votre appareil est trop ancien, l'application n'apparaîtra tout simplement pas comme installable." },
        { title: "Ouvrir votre boutique d'applications", html: "Sur un iPhone ou un iPad, ouvrez l'<strong class='text-white'>App Store</strong>. Sur Android, ouvrez le <strong class='text-white'>Google Play Store</strong>. Les deux sont préinstallés sur l'appareil ; il n'y a donc rien de plus à télécharger pour commencer.", image: {"src":`${IMG}/tradovate-mobile-app-2.jpg`,"alt":"Icône App Store sur iOS et icône Google Play Store sur Android"} },
        { title: "Rechercher Tradovate et choisir la bonne application", html: "Appuyez sur la recherche et saisissez <strong class='text-white'>Tradovate</strong>. Sur iOS, vous voulez <strong class='text-white'>Tradovate: Trade &amp; Invest</strong> ; sur Android, c'est <strong class='text-white'>Tradovate: Futures Trading</strong>. Les deux sont éditées par Tradovate LLC et les deux sont gratuites. Vérifiez le nom du développeur avant d'appuyer : les applications financières imitatrices adorent profiter d'une marque connue, et vous ne voulez pas confier vos identifiants à la mauvaise.", image: {"src":`${IMG}/tradovate-mobile-app-3.jpg`,"alt":"Résultats de recherche affichant l'application Tradovate officielle éditée par Tradovate LLC"} },
        { title: "Télécharger et ouvrir", html: "Appuyez sur <strong class='text-white'>Get</strong> sur iOS ou sur <strong class='text-white'>Install</strong> sur Android. Il se peut qu'on vous demande Face ID, une empreinte digitale ou le mot de passe de votre compte pour valider le téléchargement. Une fois terminé, ouvrez l'application directement depuis le bouton de la boutique, ou repérez l'icône sur votre écran d'accueil ou dans votre tiroir d'applications.", image: {"src":`${IMG}/tradovate-mobile-app-4.jpg`,"alt":"Boutons Get et Install pour télécharger l'application mobile Tradovate"} },
        { title: "Se connecter et choisir votre compte", html: "Connectez-vous avec la même adresse e-mail et le même mot de passe que sur la plateforme web Tradovate. Les traders prop utilisent les identifiants émis par la firme, distincts d'une connexion Tradovate personnelle. Après avoir accepté les accords habituels, vous choisissez le compte à trader : un compte <strong class='text-white'>Simulation</strong> (démo) pour vous exercer, ou votre compte <strong class='text-white'>Live</strong> pour de l'argent réel. Le sélecteur se trouve directement sur l'écran de connexion et de compte ; appuyez sur celui que vous voulez et vous y êtes. Comme l'application est régulièrement mise à jour, le libellé exact de cette bascule peut changer ; choisissez simplement le type de compte qui correspond à ce que vous voulez faire." },
      ],
