  ctaHeading: { en: "Trade From Anywhere, Hands-Free", de: "Handeln Sie von überall, freihändig", es: "Opere desde cualquier lugar, sin intervención manual", fr: "Tradez de n'importe où, sans intervention", it: "Operi da ovunque, senza intervenire" },
