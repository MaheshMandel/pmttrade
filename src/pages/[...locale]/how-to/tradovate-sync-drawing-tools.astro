---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-sync-drawing-tools";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Sync Drawing Tools Across Tradovate Charts";
const META_DESCRIPTION =
  "Make trendlines and levels appear on every linked chart at once by matching chart link colors and switching on Sync Charts. Simple step-by-step guide.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Zeichenwerkzeuge über Tradovate-Charts hinweg synchronisieren", es: "Sincronice las herramientas de dibujo entre gráficos de Tradovate", fr: "Synchroniser les outils de dessin entre les graphiques Tradovate", it: "Sincronizzare gli strumenti di disegno tra i grafici di Tradovate" },
  dek: { en: "Tradovate can push a drawing from one chart to every chart you've linked. Draw a level once and it shows up on all of them. Here's how to set it up.", de: "Tradovate kann eine Zeichnung von einem Chart auf alle verknüpften Charts übertragen. Zeichnen Sie ein Level einmal, und es erscheint auf allen. So richten Sie es ein.", es: "Tradovate puede enviar un dibujo de un gráfico a todos los gráficos que haya vinculado. Dibuje un nivel una vez y aparecerá en todos. Así se configura.", fr: "Tradovate peut propager un dessin d’un graphique à tous les graphiques que vous avez liés. Tracez un niveau une fois et il apparaît sur tous. Voici comment le configurer.", it: "Tradovate può propagare un disegno da un grafico a tutti i grafici collegati. Disegni un livello una sola volta e comparirà su tutti. Ecco come configurarlo." },
  readTime: { en: "4 min read", de: "4 Min. Lesezeit", es: "Lectura de 4 min", fr: "Lecture : 4 min", it: "Lettura di 4 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "If you watch the same instrument on two or three charts at once, say a 5-minute next to a 15-minute and a daily, redrawing the same support line on each one gets old fast. Tradovate can push a drawing from one chart to every chart you've linked. Draw a level once and it shows up on all of them. Here's how to set it up." },
    { type: "paragraph", html: "The setup has two parts: link the charts together with a matching color, then flip on Sync Charts. Both controls live in the web platform, and the whole thing takes about a minute. If you're new to the chart module, the charting basics guide covers opening and arranging charts first." },
    { type: "heading", text: "What You'll Need" },
    {
      type: "list",
      items: [
        "Two or more Chart windows open in the Tradovate web platform.",
        "The same, or related, symbols loaded on the charts you want to keep in sync.",
      ],
    },
    { type: "heading", text: "How to Sync Drawings Across Charts" },
    {
      type: "steps",
      items: [
        { title: "Open the Charts You Want to Link", html: "Open each Chart module and arrange them side by side, or in whatever tab layout you use. You can link charts on the same symbol across timeframes, or charts on different symbols. The sync follows the color you assign next, not the instrument.", image: { src: `${IMG}/tradovate-sync-drawing-tools-1.png`, alt: "Two Tradovate chart windows arranged side by side ready to be linked" } },
        { title: "Give Each Chart the Same Link Color", html: "Look for the small grey dot near the chart interval. Click it and a menu of colored dots pops up. Pick the same color on every chart you want to link together, blue on chart one, blue on chart two, and so on. That shared color is what ties them into one group. One thing to watch: Tradovate uses this same color system to link other modules too, like a Quote Board that changes a chart's symbol when you click a row. Pick a color for your chart sync that you're not already using for a Quote Board link, otherwise a symbol change can jump between modules you didn't mean to connect.", image: { src: `${IMG}/tradovate-sync-drawing-tools-2.png`, alt: "Color link dot menu open on a Tradovate chart with a colored dot selected" } },
        { title: "Turn On Sync Charts", html: "Now open the Drawing Tools menu on one of the linked charts and switch on <strong class='text-white'>Sync Charts</strong>. You only need to enable it once for the group; you don't have to repeat it on every chart. This is the toggle that actually shares the drawings, so if drawings aren't crossing over, this is the first thing to check.", image: { src: `${IMG}/tradovate-sync-drawing-tools-3.png`, alt: "Sync Charts option enabled in the Tradovate chart Drawing Tools menu" } },
        { title: "Draw Once, See It Everywhere", html: "Draw a trendline, a horizontal level, or any object on one of the linked charts. It shows up on the other charts sharing that color. Move it or delete it, and the change carries across too. That's the whole point: mark a level on your execution chart and it's already sitting on your higher-timeframe chart.", image: { src: `${IMG}/tradovate-sync-drawing-tools-4.png`, alt: "A trendline drawn on one chart appearing on the linked Tradovate chart" } },
      ],
    },
    { type: "heading", text: "Why Tradovate Links by Color" },
    { type: "paragraph", html: "Instead of a single \"sync everything\" button, Tradovate groups modules by color, and charts, DOMs, and quote boards all use the same dots. That's flexible once you get it: you can run one blue group of charts that share drawings and a separate green group that doesn't. The trade-off is you have to keep your colors straight so a Quote Board link and a Chart Sync don't accidentally share the same color." },
    { type: "heading", text: "If Your Drawings Don't Sync" },
    { type: "paragraph", html: "Run through these quick checks:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Same color on both charts.</strong> If one chart is on a slightly different shade, they're in different groups and won't share.",
        "<strong class='text-white'>Sync Charts is on.</strong> Re-open the Drawing Tools menu and confirm the toggle is active.",
        "<strong class='text-white'>Scroll back to where you drew.</strong> Older objects sometimes only reload once you scroll the chart back to the date they were created.",
      ],
    },
    { type: "paragraph", html: "If drawings keep vanishing after a restart, on a new device, or when you drop to a lower timeframe, that's a separate, long-standing quirk rather than a sync-setup problem." },
    { type: "heading", text: "Automate Your Entries with PickMyTrade" },
    { type: "paragraph", html: "Tired of hand-drawing levels and clicking every entry? PickMyTrade routes your TradingView alerts straight into Tradovate so your strategy fires the moment your signal hits, no manual clicks required." },
  ], de: [
    { type: "paragraph",html: "Wenn Sie dasselbe Instrument gleichzeitig auf zwei oder drei Charts beobachten, etwa einen 5-Minuten-Chart neben einem 15-Minuten- und einem Tages-Chart, wird es schnell lästig, dieselbe Unterstützungslinie auf jedem einzeln neu zu zeichnen. Tradovate kann eine Zeichnung von einem Chart auf alle verknüpften Charts übertragen. Zeichnen Sie ein Level einmal, und es erscheint auf allen. So richten Sie es ein." },
    { type: "paragraph",html: "Die Einrichtung besteht aus zwei Teilen: Verknüpfen Sie die Charts über eine übereinstimmende Farbe und aktivieren Sie dann Sync Charts. Beide Bedienelemente befinden sich in der Web-Plattform, und das Ganze dauert etwa eine Minute. Wenn Sie das Chart-Modul noch nicht kennen, erklärt die Anleitung zu den Chart-Grundlagen zunächst, wie Sie Charts öffnen und anordnen." },
    { type: "heading",text: "Was Sie benötigen" },
    {
      type: "list",
      items: [
        "Zwei oder mehr geöffnete Chart-Fenster in der Tradovate-Web-Plattform.",
        "Dieselben oder verwandte Symbole, die auf den Charts geladen sind, die Sie synchron halten möchten.",
      ],
    },
    { type: "heading",text: "So synchronisieren Sie Zeichnungen über Charts hinweg" },
    {
      type: "steps",
      items: [
        { title: "Die zu verknüpfenden Charts öffnen", html: "Öffnen Sie jedes Chart-Modul und ordnen Sie sie nebeneinander oder in dem Tab-Layout an, das Sie verwenden. Sie können Charts desselben Symbols über verschiedene Zeitrahmen hinweg verknüpfen oder Charts mit unterschiedlichen Symbolen. Die Synchronisierung folgt der Farbe, die Sie als Nächstes zuweisen, nicht dem Instrument.", image: {"src":`${IMG}/tradovate-sync-drawing-tools-1.png`,"alt":"Zwei nebeneinander angeordnete Tradovate-Chart-Fenster, bereit zum Verknüpfen"} },
        { title: "Jedem Chart dieselbe Verknüpfungsfarbe geben", html: "Suchen Sie den kleinen grauen Punkt neben dem Chart-Intervall. Klicken Sie darauf, und es öffnet sich ein Menü mit farbigen Punkten. Wählen Sie auf jedem Chart, das Sie verknüpfen möchten, dieselbe Farbe, also Blau auf Chart eins, Blau auf Chart zwei und so weiter. Diese gemeinsame Farbe verbindet sie zu einer Gruppe. Ein Hinweis: Tradovate nutzt dasselbe Farbsystem auch, um andere Module zu verknüpfen, etwa ein Quote Board, das das Symbol eines Charts ändert, wenn Sie auf eine Zeile klicken. Wählen Sie für Ihre Chart-Synchronisierung eine Farbe, die Sie noch nicht für eine Quote-Board-Verknüpfung verwenden, sonst kann ein Symbolwechsel zwischen Modulen springen, die Sie gar nicht verbinden wollten.", image: {"src":`${IMG}/tradovate-sync-drawing-tools-2.png`,"alt":"Geöffnetes Farbpunkt-Menü an einem Tradovate-Chart mit ausgewähltem farbigem Punkt"} },
        { title: "Sync Charts einschalten", html: "Öffnen Sie nun das Menü Drawing Tools auf einem der verknüpften Charts und schalten Sie <strong class='text-white'>Sync Charts</strong> ein. Sie müssen es nur einmal für die Gruppe aktivieren; eine Wiederholung auf jedem Chart ist nicht nötig. Dieser Schalter ist es, der die Zeichnungen tatsächlich teilt. Wenn Zeichnungen also nicht übertragen werden, prüfen Sie zuerst ihn.", image: {"src":`${IMG}/tradovate-sync-drawing-tools-3.png`,"alt":"Aktivierte Option Sync Charts im Drawing-Tools-Menü des Tradovate-Charts"} },
        { title: "Einmal zeichnen, überall sehen", html: "Zeichnen Sie eine Trendlinie, ein horizontales Level oder ein beliebiges Objekt auf einem der verknüpften Charts. Es erscheint auf den anderen Charts mit derselben Farbe. Verschieben oder löschen Sie es, und die Änderung wird ebenfalls übernommen. Genau das ist der Sinn: Markieren Sie ein Level auf Ihrem Ausführungs-Chart, und es liegt bereits auf Ihrem Chart des höheren Zeitrahmens.", image: {"src":`${IMG}/tradovate-sync-drawing-tools-4.png`,"alt":"Eine auf einem Chart gezeichnete Trendlinie erscheint auf dem verknüpften Tradovate-Chart"} },
      ],
    },
    { type: "heading",text: "Warum Tradovate nach Farbe verknüpft" },
    { type: "paragraph",html: "Statt einer einzigen Schaltfläche „Alles synchronisieren“ gruppiert Tradovate Module nach Farbe, und Charts, DOMs und Quote Boards verwenden alle dieselben Punkte. Das ist flexibel, sobald man es verstanden hat: Sie können eine blaue Gruppe von Charts betreiben, die Zeichnungen teilen, und eine separate grüne Gruppe, die das nicht tut. Der Kompromiss ist, dass Sie Ihre Farben auseinanderhalten müssen, damit sich eine Quote-Board-Verknüpfung und eine Chart-Synchronisierung nicht versehentlich dieselbe Farbe teilen." },
    { type: "heading",text: "Wenn Ihre Zeichnungen nicht synchronisiert werden" },
    { type: "paragraph",html: "Gehen Sie diese kurzen Prüfungen durch:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Gleiche Farbe auf beiden Charts.</strong> Hat ein Chart einen leicht anderen Farbton, befinden sich beide in unterschiedlichen Gruppen und teilen nichts.",
        "<strong class='text-white'>Sync Charts ist eingeschaltet.</strong> Öffnen Sie das Menü Drawing Tools erneut und bestätigen Sie, dass der Schalter aktiv ist.",
        "<strong class='text-white'>Zurück zur gezeichneten Stelle scrollen.</strong> Ältere Objekte werden manchmal erst geladen, wenn Sie den Chart bis zu dem Datum zurückscrollen, an dem sie erstellt wurden.",
      ],
    },
    { type: "paragraph",html: "Wenn Zeichnungen nach einem Neustart, auf einem neuen Gerät oder beim Wechsel auf einen niedrigeren Zeitrahmen immer wieder verschwinden, ist das eine separate, seit Langem bekannte Eigenheit und kein Problem der Sync-Einrichtung." },
    { type: "heading",text: "Automatisieren Sie Ihre Einstiege mit PickMyTrade" },
    { type: "paragraph",html: "Sie haben es satt, Levels von Hand zu zeichnen und jeden Einstieg anzuklicken? PickMyTrade leitet Ihre TradingView-Alerts direkt an Tradovate weiter, sodass Ihre Strategie genau dann auslöst, wenn Ihr Signal eintrifft, ganz ohne manuelle Klicks." },
  ], es: [
    { type: "paragraph",html: "Si observa el mismo instrumento en dos o tres gráficos a la vez, por ejemplo uno de 5 minutos junto a uno de 15 minutos y uno diario, volver a dibujar la misma línea de soporte en cada uno resulta tedioso enseguida. Tradovate puede enviar un dibujo de un gráfico a todos los gráficos que haya vinculado. Dibuje un nivel una vez y aparecerá en todos. Así se configura." },
    { type: "paragraph",html: "La configuración tiene dos partes: vincular los gráficos con un color coincidente y, después, activar Sync Charts. Ambos controles están en la plataforma web y todo el proceso lleva aproximadamente un minuto. Si es nuevo en el módulo de gráficos, la guía de conceptos básicos de gráficos explica primero cómo abrir y organizar gráficos." },
    { type: "heading",text: "Lo que necesitará" },
    {
      type: "list",
      items: [
        "Dos o más ventanas de gráfico abiertas en la plataforma web de Tradovate.",
        "Los mismos símbolos, o símbolos relacionados, cargados en los gráficos que desea mantener sincronizados.",
      ],
    },
    { type: "heading",text: "Cómo sincronizar dibujos entre gráficos" },
    {
      type: "steps",
      items: [
        { title: "Abra los gráficos que desea vincular", html: "Abra cada módulo de gráfico y organícelos uno al lado del otro o en el diseño de pestañas que utilice. Puede vincular gráficos del mismo símbolo en distintos marcos temporales, o gráficos de símbolos diferentes. La sincronización sigue el color que asigne a continuación, no el instrumento.", image: {"src":`${IMG}/tradovate-sync-drawing-tools-1.png`,"alt":"Dos ventanas de gráfico de Tradovate dispuestas una al lado de la otra, listas para vincularse"} },
        { title: "Asigne a cada gráfico el mismo color de vínculo", html: "Busque el pequeño punto gris junto al intervalo del gráfico. Haga clic en él y aparecerá un menú de puntos de colores. Elija el mismo color en cada gráfico que desee vincular: azul en el primer gráfico, azul en el segundo, y así sucesivamente. Ese color compartido es lo que los une en un grupo. Una advertencia: Tradovate usa este mismo sistema de colores para vincular también otros módulos, como un Quote Board que cambia el símbolo de un gráfico al hacer clic en una fila. Elija para la sincronización de gráficos un color que no esté usando ya para un vínculo de Quote Board; de lo contrario, un cambio de símbolo puede saltar entre módulos que no pretendía conectar.", image: {"src":`${IMG}/tradovate-sync-drawing-tools-2.png`,"alt":"Menú de puntos de color abierto en un gráfico de Tradovate con un punto de color seleccionado"} },
        { title: "Active Sync Charts", html: "Ahora abra el menú Drawing Tools en uno de los gráficos vinculados y active <strong class='text-white'>Sync Charts</strong>. Solo necesita habilitarlo una vez para el grupo; no tiene que repetirlo en cada gráfico. Este es el interruptor que realmente comparte los dibujos, así que si los dibujos no se transfieren, es lo primero que debe comprobar.", image: {"src":`${IMG}/tradovate-sync-drawing-tools-3.png`,"alt":"Opción Sync Charts activada en el menú Drawing Tools del gráfico de Tradovate"} },
        { title: "Dibuje una vez, véalo en todas partes", html: "Dibuje una línea de tendencia, un nivel horizontal o cualquier objeto en uno de los gráficos vinculados. Aparecerá en los demás gráficos que compartan ese color. Muévalo o elimínelo y el cambio también se traslada. Ese es el objetivo: marque un nivel en su gráfico de ejecución y ya estará en su gráfico de marco temporal superior.", image: {"src":`${IMG}/tradovate-sync-drawing-tools-4.png`,"alt":"Una línea de tendencia dibujada en un gráfico que aparece en el gráfico vinculado de Tradovate"} },
      ],
    },
    { type: "heading",text: "Por qué Tradovate vincula por color" },
    { type: "paragraph",html: "En lugar de un único botón de «sincronizarlo todo», Tradovate agrupa los módulos por color, y los gráficos, los DOM y los quote boards usan los mismos puntos. Eso es flexible una vez que lo entiende: puede tener un grupo azul de gráficos que comparten dibujos y un grupo verde aparte que no. La contrapartida es que debe mantener sus colores ordenados para que un vínculo de Quote Board y una sincronización de gráficos no compartan por accidente el mismo color." },
    { type: "heading",text: "Si sus dibujos no se sincronizan" },
    { type: "paragraph",html: "Realice estas comprobaciones rápidas:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Mismo color en ambos gráficos.</strong> Si un gráfico tiene un tono ligeramente distinto, están en grupos diferentes y no compartirán.",
        "<strong class='text-white'>Sync Charts está activado.</strong> Vuelva a abrir el menú Drawing Tools y confirme que el interruptor está activo.",
        "<strong class='text-white'>Desplácese hacia atrás hasta donde dibujó.</strong> A veces los objetos antiguos solo se recargan cuando desplaza el gráfico hasta la fecha en que se crearon.",
      ],
    },
    { type: "paragraph",html: "Si los dibujos siguen desapareciendo tras un reinicio, en un dispositivo nuevo o al bajar a un marco temporal inferior, se trata de una peculiaridad distinta y de larga data, no de un problema de configuración de la sincronización." },
    { type: "heading",text: "Automatice sus entradas con PickMyTrade" },
    { type: "paragraph",html: "¿Está cansado de dibujar niveles a mano y hacer clic en cada entrada? PickMyTrade envía sus alertas de TradingView directamente a Tradovate para que su estrategia se dispare en el momento en que llega su señal, sin clics manuales." },
  ], fr: [
    { type: "paragraph",html: "Si vous suivez le même instrument sur deux ou trois graphiques à la fois, par exemple un graphique 5 minutes à côté d’un 15 minutes et d’un journalier, redessiner la même ligne de support sur chacun devient vite fastidieux. Tradovate peut propager un dessin d’un graphique à tous les graphiques que vous avez liés. Tracez un niveau une fois et il apparaît sur tous. Voici comment le configurer." },
    { type: "paragraph",html: "La configuration comprend deux parties : lier les graphiques entre eux avec une couleur identique, puis activer Sync Charts. Les deux commandes se trouvent dans la plateforme web et l’ensemble prend environ une minute. Si vous découvrez le module de graphiques, le guide sur les bases des graphiques explique d’abord comment ouvrir et organiser les graphiques." },
    { type: "heading",text: "Ce dont vous aurez besoin" },
    {
      type: "list",
      items: [
        "Au moins deux fenêtres de graphique ouvertes dans la plateforme web de Tradovate.",
        "Les mêmes symboles, ou des symboles liés, chargés sur les graphiques que vous souhaitez garder synchronisés.",
      ],
    },
    { type: "heading",text: "Comment synchroniser les dessins entre les graphiques" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir les graphiques à lier", html: "Ouvrez chaque module de graphique et disposez-les côte à côte, ou selon la disposition en onglets que vous utilisez. Vous pouvez lier des graphiques du même symbole sur différentes unités de temps, ou des graphiques de symboles différents. La synchronisation suit la couleur que vous attribuez ensuite, pas l’instrument.", image: {"src":`${IMG}/tradovate-sync-drawing-tools-1.png`,"alt":"Deux fenêtres de graphique Tradovate disposées côte à côte, prêtes à être liées"} },
        { title: "Attribuer la même couleur de lien à chaque graphique", html: "Repérez le petit point gris près de l’intervalle du graphique. Cliquez dessus et un menu de points colorés apparaît. Choisissez la même couleur sur chaque graphique que vous souhaitez lier : bleu sur le graphique un, bleu sur le graphique deux, et ainsi de suite. Cette couleur partagée les réunit en un seul groupe. Une précaution : Tradovate utilise ce même système de couleurs pour lier aussi d’autres modules, comme un Quote Board qui change le symbole d’un graphique lorsque vous cliquez sur une ligne. Choisissez pour la synchronisation de vos graphiques une couleur que vous n’utilisez pas déjà pour un lien de Quote Board ; sinon, un changement de symbole peut sauter entre des modules que vous ne vouliez pas connecter.", image: {"src":`${IMG}/tradovate-sync-drawing-tools-2.png`,"alt":"Menu des points de couleur ouvert sur un graphique Tradovate avec un point coloré sélectionné"} },
        { title: "Activer Sync Charts", html: "Ouvrez maintenant le menu Drawing Tools sur l’un des graphiques liés et activez <strong class='text-white'>Sync Charts</strong>. Vous n’avez besoin de l’activer qu’une seule fois pour le groupe ; inutile de le répéter sur chaque graphique. C’est cette option qui partage réellement les dessins ; si les dessins ne se propagent pas, c’est donc la première chose à vérifier.", image: {"src":`${IMG}/tradovate-sync-drawing-tools-3.png`,"alt":"Option Sync Charts activée dans le menu Drawing Tools du graphique Tradovate"} },
        { title: "Dessiner une fois, le voir partout", html: "Tracez une ligne de tendance, un niveau horizontal ou n’importe quel objet sur l’un des graphiques liés. Il apparaît sur les autres graphiques partageant cette couleur. Déplacez-le ou supprimez-le, et la modification se répercute aussi. C’est tout l’intérêt : marquez un niveau sur votre graphique d’exécution et il est déjà présent sur votre graphique d’unité de temps supérieure.", image: {"src":`${IMG}/tradovate-sync-drawing-tools-4.png`,"alt":"Une ligne de tendance tracée sur un graphique et apparaissant sur le graphique Tradovate lié"} },
      ],
    },
    { type: "heading",text: "Pourquoi Tradovate lie par couleur" },
    { type: "paragraph",html: "Plutôt qu’un seul bouton « tout synchroniser », Tradovate regroupe les modules par couleur, et les graphiques, les DOM et les quote boards utilisent tous les mêmes points. C’est flexible une fois qu’on a compris : vous pouvez avoir un groupe bleu de graphiques qui partagent leurs dessins et un groupe vert distinct qui ne le fait pas. La contrepartie est qu’il faut bien gérer vos couleurs pour qu’un lien de Quote Board et une synchronisation de graphiques ne partagent pas la même couleur par accident." },
    { type: "heading",text: "Si vos dessins ne se synchronisent pas" },
    { type: "paragraph",html: "Effectuez ces vérifications rapides :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Même couleur sur les deux graphiques.</strong> Si un graphique a une teinte légèrement différente, ils appartiennent à des groupes différents et ne partageront rien.",
        "<strong class='text-white'>Sync Charts est activé.</strong> Rouvrez le menu Drawing Tools et vérifiez que l’option est active.",
        "<strong class='text-white'>Faites défiler jusqu’à l’endroit où vous avez dessiné.</strong> Les objets plus anciens ne se rechargent parfois que lorsque vous faites défiler le graphique jusqu’à la date de leur création.",
      ],
    },
    { type: "paragraph",html: "Si les dessins disparaissent régulièrement après un redémarrage, sur un nouvel appareil ou en passant à une unité de temps inférieure, il s’agit d’une particularité distincte et ancienne, et non d’un problème de configuration de la synchronisation." },
    { type: "heading",text: "Automatisez vos entrées avec PickMyTrade" },
    { type: "paragraph",html: "Fatigué de tracer vos niveaux à la main et de cliquer sur chaque entrée ? PickMyTrade achemine vos alertes TradingView directement vers Tradovate afin que votre stratégie se déclenche dès que votre signal arrive, sans aucun clic manuel." },
  ], it: [
    { type: "paragraph",html: "Se osserva lo stesso strumento su due o tre grafici contemporaneamente, ad esempio un grafico a 5 minuti accanto a uno a 15 minuti e a uno giornaliero, ridisegnare la stessa linea di supporto su ciascuno diventa presto noioso. Tradovate può propagare un disegno da un grafico a tutti i grafici collegati. Disegni un livello una sola volta e comparirà su tutti. Ecco come configurarlo." },
    { type: "paragraph",html: "La configurazione si compone di due parti: collegare i grafici tra loro con un colore corrispondente, quindi attivare Sync Charts. Entrambi i controlli si trovano nella piattaforma web e l’intera operazione richiede circa un minuto. Se non ha ancora familiarità con il modulo dei grafici, la guida sulle basi dei grafici spiega prima come aprire e disporre i grafici." },
    { type: "heading",text: "Che cosa Le serve" },
    {
      type: "list",
      items: [
        "Due o più finestre di grafico aperte nella piattaforma web di Tradovate.",
        "Gli stessi simboli, o simboli correlati, caricati sui grafici che desidera mantenere sincronizzati.",
      ],
    },
    { type: "heading",text: "Come sincronizzare i disegni tra i grafici" },
    {
      type: "steps",
      items: [
        { title: "Aprire i grafici da collegare", html: "Apra ciascun modulo grafico e li disponga uno accanto all’altro o nel layout a schede che utilizza. Può collegare grafici dello stesso simbolo su timeframe diversi, oppure grafici di simboli diversi. La sincronizzazione segue il colore che assegnerà nel passaggio successivo, non lo strumento.", image: {"src":`${IMG}/tradovate-sync-drawing-tools-1.png`,"alt":"Due finestre di grafico di Tradovate disposte una accanto all’altra, pronte per essere collegate"} },
        { title: "Assegnare a ogni grafico lo stesso colore di collegamento", html: "Cerchi il piccolo punto grigio vicino all’intervallo del grafico. Vi faccia clic e comparirà un menu di punti colorati. Scelga lo stesso colore su ogni grafico che desidera collegare: blu sul primo grafico, blu sul secondo, e così via. Quel colore condiviso li unisce in un unico gruppo. Un’avvertenza: Tradovate usa lo stesso sistema di colori anche per collegare altri moduli, come un Quote Board che cambia il simbolo di un grafico quando si fa clic su una riga. Scelga per la sincronizzazione dei grafici un colore che non sta già usando per un collegamento con un Quote Board, altrimenti un cambio di simbolo può passare tra moduli che non intendeva collegare.", image: {"src":`${IMG}/tradovate-sync-drawing-tools-2.png`,"alt":"Menu dei punti colorati aperto su un grafico di Tradovate con un punto colorato selezionato"} },
        { title: "Attivare Sync Charts", html: "Ora apra il menu Drawing Tools su uno dei grafici collegati e attivi <strong class='text-white'>Sync Charts</strong>. Deve abilitarlo una sola volta per il gruppo; non occorre ripeterlo su ogni grafico. È questo l’interruttore che condivide effettivamente i disegni, quindi se i disegni non passano da un grafico all’altro, è la prima cosa da controllare.", image: {"src":`${IMG}/tradovate-sync-drawing-tools-3.png`,"alt":"Opzione Sync Charts attivata nel menu Drawing Tools del grafico di Tradovate"} },
        { title: "Disegnare una volta, vederlo ovunque", html: "Disegni una trendline, un livello orizzontale o qualsiasi oggetto su uno dei grafici collegati. Comparirà sugli altri grafici che condividono quel colore. Lo sposti o lo elimini, e la modifica si riflette anche sugli altri. È proprio questo lo scopo: segni un livello sul Suo grafico di esecuzione e sarà già presente sul Suo grafico a timeframe superiore.", image: {"src":`${IMG}/tradovate-sync-drawing-tools-4.png`,"alt":"Una trendline disegnata su un grafico che compare sul grafico Tradovate collegato"} },
      ],
    },
    { type: "heading",text: "Perché Tradovate collega per colore" },
    { type: "paragraph",html: "Invece di un unico pulsante «sincronizza tutto», Tradovate raggruppa i moduli per colore, e grafici, DOM e quote board usano tutti gli stessi punti. È flessibile una volta capito il meccanismo: può avere un gruppo blu di grafici che condividono i disegni e un gruppo verde separato che non lo fa. Il compromesso è che deve tenere in ordine i Suoi colori, in modo che un collegamento con un Quote Board e una sincronizzazione dei grafici non condividano per errore lo stesso colore." },
    { type: "heading",text: "Se i Suoi disegni non si sincronizzano" },
    { type: "paragraph",html: "Esegua questi rapidi controlli:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Stesso colore su entrambi i grafici.</strong> Se un grafico ha una tonalità leggermente diversa, si trovano in gruppi diversi e non condivideranno nulla.",
        "<strong class='text-white'>Sync Charts è attivo.</strong> Riapra il menu Drawing Tools e verifichi che l’interruttore sia attivo.",
        "<strong class='text-white'>Torni indietro fino al punto in cui ha disegnato.</strong> A volte gli oggetti più vecchi si ricaricano solo quando fa scorrere il grafico indietro fino alla data in cui sono stati creati.",
      ],
    },
    { type: "paragraph",html: "Se i disegni continuano a sparire dopo un riavvio, su un nuovo dispositivo o passando a un timeframe inferiore, si tratta di una particolarità distinta e di lunga data, non di un problema di configurazione della sincronizzazione." },
    { type: "heading",text: "Automatizzi i Suoi ingressi con PickMyTrade" },
    { type: "paragraph",html: "Stanco di disegnare i livelli a mano e di cliccare ogni ingresso? PickMyTrade instrada i Suoi alert di TradingView direttamente a Tradovate, così la Sua strategia scatta nel momento in cui arriva il Suo segnale, senza clic manuali." },
  ] },
