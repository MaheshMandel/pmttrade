---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-reset-password";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Reset a Forgotten Tradovate Password";
const META_DESCRIPTION =
  "Locked out by a forgotten password? Reset it from the login screen in four quick steps and get back into your trading account in minutes.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Vergessenes Tradovate-Passwort zurücksetzen", es: "Cómo restablecer una contraseña de Tradovate olvidada", fr: "Réinitialiser un mot de passe Tradovate oublié", it: "Come reimpostare una password Tradovate dimenticata" },
  dek: { en: "Locked out right before the open? Here's exactly how to reset a forgotten Tradovate password from the login screen, step by step.", de: "Kurz vor der Eröffnung ausgesperrt? So setzen Sie ein vergessenes Tradovate-Passwort direkt vom Anmeldebildschirm aus zurück, Schritt für Schritt.", es: "¿Bloqueado justo antes de la apertura? Así se restablece una contraseña de Tradovate olvidada desde la pantalla de inicio de sesión, paso a paso.", fr: "Bloqué juste avant l'ouverture ? Voici comment réinitialiser un mot de passe Tradovate oublié depuis l'écran de connexion, étape par étape.", it: "Bloccato proprio prima dell'apertura? Ecco come reimpostare una password Tradovate dimenticata dalla schermata di accesso, passo dopo passo." },
  readTime: { en: "4 min read", de: "4 Min. Lesezeit", es: "Lectura de 4 min", fr: "Lecture : 4 min", it: "Lettura di 4 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Blanking on your password right before the open is a rotten feeling. The good news: you don't need to email support or sit on hold. You can reset a forgotten Tradovate password straight from the login screen, and the whole thing takes a couple of minutes once the email lands." },
    { type: "paragraph", html: "One thing worth knowing up front. This works for accounts Tradovate actually owns. If you're trading a prop firm evaluation, your login belongs to the firm, not to Tradovate, so skip down to the prop-account note." },
    { type: "heading", text: "Before You Start" },
    { type: "paragraph", html: "You'll need two things: the email address attached to your Tradovate account, and access to that inbox. The reset link always goes to the address on file, so if you can't get into that email, sort that out first." },
    { type: "heading", text: "Reset Your Password from the Login Screen" },
    {
      type: "steps",
      items: [
        { title: "Open the Login Screen and Click \"Need Help?\"", html: "Head to the Tradovate web app or open the desktop or mobile app. Under the username and password fields you'll spot a \"Need Help?\" link. Click it. Both username recovery and password reset live behind that one link.", image: { src: `${IMG}/tradovate-reset-password-1.png`, alt: "Tradovate login screen with the Need Help link highlighted below the password field" } },
        { title: "Choose \"Reset Password\"", html: "The panel gives you two options: \"Retrieve Username\" and \"Reset Password.\" If you've also lost track of which username you use, grab that first. Pick Retrieve Username, enter your email, and your username gets sent over. Otherwise go straight to Reset Password.", image: { src: `${IMG}/tradovate-reset-password-2.png`, alt: "Tradovate Need Help panel showing Retrieve Username and Reset Password options" } },
        { title: "Enter Your Username or Email", html: "On the reset form, type the username or the email tied to your account, then submit. Tradovate sends the instructions to the email on file, not to whatever address you type in, so it has to match the one on your account. Type it carefully.", image: { src: `${IMG}/tradovate-reset-password-3.png`, alt: "Tradovate password reset form with a field for username or email address" } },
        { title: "Open the Email and Set a New Password", html: "Check your inbox for the reset message and click the link inside. Set a new password, save it, then go back to the login screen and sign in. The link is time-sensitive, so don't leave it sitting for hours. Do it while you're at your desk.", image: { src: `${IMG}/tradovate-reset-password-4.png`, alt: "Tradovate password reset email and the form for entering a new password" } },
      ],
    },
    { type: "heading", text: "Didn't Get the Email?" },
    {
      type: "list",
      items: [
        "Check your spam and junk folders. Reset mail lands there more often than you'd think.",
        "Confirm the address. If you're not sure which email is on file, run \"Retrieve Username\" and see where that lands.",
        "Give it a few minutes, then request the reset once more. Firing it off repeatedly won't speed anything up.",
      ],
    },
    { type: "quote", html: "Tradovate will never ask you for your password. Any message or person asking you to hand it over is a scam, no matter how official it looks." },
    { type: "heading", text: "Prop Firm or Evaluation Accounts" },
    { type: "paragraph", html: "If you log in with credentials from a prop firm or evaluation service, the \"Need Help?\" reset won't do anything for you. Those accounts aren't managed by Tradovate, so the reset flow can't touch them. Recovery rules vary by firm and account, so contact your provider directly to reset or recover the login. They own the account, and they're the only ones who can hand you a fresh password." },
    { type: "heading", text: "Already Logged In and Just Want to Change It?" },
    { type: "paragraph", html: "This reset flow is for when you're locked out and can't remember the password. If you still know your current one and simply want to swap it for something new, you don't need any of this. Do it from inside the platform while you're logged in, where changing the password is a settings task rather than a recovery one. Keep the reset route for the moments you're actually stuck at the login screen." },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Back in and ready to trade? Don't babysit the login. <strong class='text-white'>PickMyTrade routes your TradingView alerts straight to Tradovate automatically</strong>, so your strategy keeps running whether you're watching or not." },
  ], de: [
    { type: "paragraph",html: "Kurz vor der Eröffnung das Passwort vergessen zu haben, ist ein mieses Gefühl. Die gute Nachricht: Sie müssen weder dem Support schreiben noch in der Warteschleife hängen. Sie können ein vergessenes Tradovate-Passwort direkt vom Anmeldebildschirm aus zurücksetzen, und das Ganze dauert nur ein paar Minuten, sobald die E-Mail eintrifft." },
    { type: "paragraph",html: "Eine Sache vorab. Das funktioniert für Konten, die tatsächlich bei Tradovate geführt werden. Wenn Sie eine Prop-Firm-Evaluierung handeln, gehört Ihr Login der Firma und nicht Tradovate. Springen Sie in diesem Fall zum Hinweis zu Prop-Konten." },
    { type: "heading",text: "Bevor Sie beginnen" },
    { type: "paragraph",html: "Sie benötigen zwei Dinge: die mit Ihrem Tradovate-Konto verknüpfte E-Mail-Adresse und Zugriff auf dieses Postfach. Der Reset-Link geht immer an die hinterlegte Adresse. Wenn Sie nicht in diese E-Mail gelangen, klären Sie das zuerst." },
    { type: "heading",text: "Passwort vom Anmeldebildschirm aus zurücksetzen" },
    {
      type: "steps",
      items: [
        { title: "Öffnen Sie den Anmeldebildschirm und klicken Sie auf „Need Help?“", html: "Rufen Sie die Tradovate-Web-App auf oder öffnen Sie die Desktop- bzw. Mobile-App. Unter den Feldern für Benutzername und Passwort sehen Sie den Link „Need Help?“. Klicken Sie darauf. Sowohl die Wiederherstellung des Benutzernamens als auch das Zurücksetzen des Passworts befinden sich hinter diesem einen Link.", image: {"src":`${IMG}/tradovate-reset-password-1.png`,"alt":"Tradovate-Anmeldebildschirm mit hervorgehobenem Link Need Help unter dem Passwortfeld"} },
        { title: "Wählen Sie „Reset Password“", html: "Das Panel bietet zwei Optionen: „Retrieve Username“ und „Reset Password.“ Wenn Sie auch nicht mehr wissen, welchen Benutzernamen Sie verwenden, holen Sie sich diesen zuerst. Wählen Sie Retrieve Username, geben Sie Ihre E-Mail-Adresse ein, und Ihr Benutzername wird Ihnen zugesandt. Andernfalls gehen Sie direkt zu Reset Password.", image: {"src":`${IMG}/tradovate-reset-password-2.png`,"alt":"Tradovate-Need-Help-Panel mit den Optionen Retrieve Username und Reset Password"} },
        { title: "Geben Sie Ihren Benutzernamen oder Ihre E-Mail-Adresse ein", html: "Tippen Sie im Reset-Formular den Benutzernamen oder die mit Ihrem Konto verknüpfte E-Mail-Adresse ein und senden Sie ab. Tradovate schickt die Anweisungen an die hinterlegte E-Mail-Adresse, nicht an die Adresse, die Sie eintippen. Sie muss also mit der Adresse Ihres Kontos übereinstimmen. Tippen Sie sorgfältig.", image: {"src":`${IMG}/tradovate-reset-password-3.png`,"alt":"Tradovate-Formular zum Zurücksetzen des Passworts mit einem Feld für Benutzername oder E-Mail-Adresse"} },
        { title: "Öffnen Sie die E-Mail und legen Sie ein neues Passwort fest", html: "Prüfen Sie Ihr Postfach auf die Reset-Nachricht und klicken Sie auf den enthaltenen Link. Legen Sie ein neues Passwort fest, speichern Sie es, kehren Sie dann zum Anmeldebildschirm zurück und melden Sie sich an. Der Link ist zeitlich begrenzt, lassen Sie ihn also nicht stundenlang liegen. Erledigen Sie es, solange Sie am Schreibtisch sitzen.", image: {"src":`${IMG}/tradovate-reset-password-4.png`,"alt":"Tradovate-E-Mail zum Zurücksetzen des Passworts und das Formular zur Eingabe eines neuen Passworts"} },
      ],
    },
    { type: "heading",text: "Keine E-Mail erhalten?" },
    {
      type: "list",
      items: [
        "Prüfen Sie Ihre Spam- und Junk-Ordner. Reset-E-Mails landen dort öfter, als man denkt.",
        "Bestätigen Sie die Adresse. Wenn Sie nicht sicher sind, welche E-Mail hinterlegt ist, führen Sie „Retrieve Username“ aus und sehen Sie, wo diese ankommt.",
        "Warten Sie ein paar Minuten und fordern Sie das Zurücksetzen dann noch einmal an. Wiederholtes Absenden beschleunigt nichts.",
      ],
    },
    { type: "quote",html: "Tradovate wird Sie niemals nach Ihrem Passwort fragen. Jede Nachricht oder Person, die Sie auffordert, es herauszugeben, ist ein Betrug, egal wie offiziell sie wirkt." },
    { type: "heading",text: "Prop-Firm- oder Evaluierungskonten" },
    { type: "paragraph",html: "Wenn Sie sich mit Zugangsdaten einer Prop Firm oder eines Evaluierungsdienstes anmelden, nützt Ihnen das Zurücksetzen über „Need Help?“ nichts. Diese Konten werden nicht von Tradovate verwaltet, daher kann der Reset-Ablauf sie nicht erreichen. Die Wiederherstellungsregeln unterscheiden sich je nach Firma und Konto. Wenden Sie sich daher direkt an Ihren Anbieter, um den Login zurückzusetzen oder wiederherzustellen. Ihm gehört das Konto, und nur er kann Ihnen ein neues Passwort ausstellen." },
    { type: "heading",text: "Bereits angemeldet und möchten es nur ändern?" },
    { type: "paragraph",html: "Dieser Reset-Ablauf ist für den Fall gedacht, dass Sie ausgesperrt sind und sich nicht an das Passwort erinnern. Wenn Sie Ihr aktuelles Passwort noch kennen und es einfach gegen ein neues tauschen möchten, brauchen Sie das alles nicht. Erledigen Sie es innerhalb der Plattform, während Sie angemeldet sind. Dort ist das Ändern des Passworts eine Einstellungsaufgabe und keine Wiederherstellung. Nutzen Sie den Reset-Weg nur für die Momente, in denen Sie tatsächlich am Anmeldebildschirm festhängen." },
    { type: "heading",text: "Automatisieren Sie das mit PickMyTrade" },
    { type: "paragraph",html: "Wieder drin und bereit zum Handeln? Babysitten Sie den Login nicht. <strong class='text-white'>PickMyTrade leitet Ihre TradingView-Alerts automatisch direkt an Tradovate weiter</strong>, damit Ihre Strategie weiterläuft, egal ob Sie zuschauen oder nicht." },
  ], es: [
    { type: "paragraph",html: "Quedarse en blanco con la contraseña justo antes de la apertura es una sensación horrible. La buena noticia: no necesita escribir a soporte ni esperar en línea. Puede restablecer una contraseña de Tradovate olvidada directamente desde la pantalla de inicio de sesión, y todo el proceso lleva un par de minutos una vez que llega el correo." },
    { type: "paragraph",html: "Una cosa que conviene saber de antemano. Esto funciona para cuentas que Tradovate gestiona realmente. Si opera una evaluación de prop firm, su inicio de sesión pertenece a la firma, no a Tradovate, así que salte a la nota sobre cuentas prop." },
    { type: "heading",text: "Antes de empezar" },
    { type: "paragraph",html: "Necesitará dos cosas: la dirección de correo asociada a su cuenta de Tradovate y acceso a esa bandeja de entrada. El enlace de restablecimiento siempre va a la dirección registrada, así que si no puede acceder a ese correo, resuélvalo primero." },
    { type: "heading",text: "Restablezca su contraseña desde la pantalla de inicio de sesión" },
    {
      type: "steps",
      items: [
        { title: "Abra la pantalla de inicio de sesión y haga clic en «Need Help?»", html: "Vaya a la aplicación web de Tradovate o abra la aplicación de escritorio o móvil. Debajo de los campos de usuario y contraseña verá un enlace «Need Help?». Haga clic en él. Tanto la recuperación del nombre de usuario como el restablecimiento de la contraseña están detrás de ese único enlace.", image: {"src":`${IMG}/tradovate-reset-password-1.png`,"alt":"Pantalla de inicio de sesión de Tradovate con el enlace Need Help resaltado debajo del campo de contraseña"} },
        { title: "Elija «Reset Password»", html: "El panel le ofrece dos opciones: «Retrieve Username» y «Reset Password.» Si también ha perdido la pista de qué nombre de usuario utiliza, consígalo primero. Elija Retrieve Username, introduzca su correo y se le enviará su nombre de usuario. En caso contrario, vaya directamente a Reset Password.", image: {"src":`${IMG}/tradovate-reset-password-2.png`,"alt":"Panel Need Help de Tradovate con las opciones Retrieve Username y Reset Password"} },
        { title: "Introduzca su nombre de usuario o correo electrónico", html: "En el formulario de restablecimiento, escriba el nombre de usuario o el correo asociado a su cuenta y envíelo. Tradovate envía las instrucciones al correo registrado, no a la dirección que usted escriba, así que debe coincidir con la de su cuenta. Escríbala con cuidado.", image: {"src":`${IMG}/tradovate-reset-password-3.png`,"alt":"Formulario de restablecimiento de contraseña de Tradovate con un campo para el nombre de usuario o la dirección de correo"} },
        { title: "Abra el correo y establezca una nueva contraseña", html: "Revise su bandeja de entrada en busca del mensaje de restablecimiento y haga clic en el enlace que contiene. Establezca una nueva contraseña, guárdela, vuelva a la pantalla de inicio de sesión e inicie sesión. El enlace tiene un tiempo limitado, así que no lo deje parado durante horas. Hágalo mientras está frente a su escritorio.", image: {"src":`${IMG}/tradovate-reset-password-4.png`,"alt":"Correo de restablecimiento de contraseña de Tradovate y formulario para introducir una nueva contraseña"} },
      ],
    },
    { type: "heading",text: "¿No recibió el correo?" },
    {
      type: "list",
      items: [
        "Revise sus carpetas de spam y correo no deseado. Los correos de restablecimiento acaban allí más a menudo de lo que cree.",
        "Confirme la dirección. Si no está seguro de qué correo está registrado, ejecute «Retrieve Username» y vea dónde llega.",
        "Espere unos minutos y solicite el restablecimiento una vez más. Enviarlo repetidamente no lo acelerará.",
      ],
    },
    { type: "quote",html: "Tradovate nunca le pedirá su contraseña. Cualquier mensaje o persona que le pida que la entregue es una estafa, por oficial que parezca." },
    { type: "heading",text: "Cuentas de prop firm o de evaluación" },
    { type: "paragraph",html: "Si inicia sesión con credenciales de una prop firm o de un servicio de evaluación, el restablecimiento «Need Help?» no le servirá de nada. Esas cuentas no las gestiona Tradovate, por lo que el flujo de restablecimiento no puede alcanzarlas. Las reglas de recuperación varían según la firma y la cuenta, así que póngase en contacto directamente con su proveedor para restablecer o recuperar el acceso. La cuenta es suya, y solo ellos pueden entregarle una contraseña nueva." },
    { type: "heading",text: "¿Ya ha iniciado sesión y solo quiere cambiarla?" },
    { type: "paragraph",html: "Este flujo de restablecimiento es para cuando está bloqueado y no recuerda la contraseña. Si todavía conoce la actual y simplemente quiere cambiarla por otra nueva, no necesita nada de esto. Hágalo desde dentro de la plataforma mientras está conectado, donde cambiar la contraseña es una tarea de configuración y no de recuperación. Reserve la vía de restablecimiento para los momentos en que realmente esté atascado en la pantalla de inicio de sesión." },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "¿Ya ha vuelto a entrar y está listo para operar? No vigile el inicio de sesión. <strong class='text-white'>PickMyTrade envía sus alertas de TradingView directamente a Tradovate de forma automática</strong>, para que su estrategia siga funcionando tanto si está mirando como si no." },
  ], fr: [
    { type: "paragraph",html: "Avoir un trou de mémoire sur son mot de passe juste avant l'ouverture est un sentiment désagréable. La bonne nouvelle : inutile d'écrire au support ou de patienter au téléphone. Vous pouvez réinitialiser un mot de passe Tradovate oublié directement depuis l'écran de connexion, et l'ensemble prend quelques minutes une fois l'e-mail reçu." },
    { type: "paragraph",html: "Un point à savoir d'emblée. Cela fonctionne pour les comptes réellement gérés par Tradovate. Si vous tradez une évaluation de prop firm, votre identifiant appartient à la société, pas à Tradovate ; passez alors directement à la note sur les comptes prop." },
    { type: "heading",text: "Avant de commencer" },
    { type: "paragraph",html: "Il vous faut deux choses : l'adresse e-mail associée à votre compte Tradovate et l'accès à cette boîte de réception. Le lien de réinitialisation est toujours envoyé à l'adresse enregistrée ; si vous ne pouvez pas accéder à cet e-mail, réglez d'abord ce problème." },
    { type: "heading",text: "Réinitialisez votre mot de passe depuis l'écran de connexion" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez l'écran de connexion et cliquez sur « Need Help? »", html: "Rendez-vous sur l'application web Tradovate ou ouvrez l'application de bureau ou mobile. Sous les champs du nom d'utilisateur et du mot de passe, vous verrez un lien « Need Help? ». Cliquez dessus. La récupération du nom d'utilisateur et la réinitialisation du mot de passe se trouvent toutes deux derrière ce seul lien.", image: {"src":`${IMG}/tradovate-reset-password-1.png`,"alt":"Écran de connexion Tradovate avec le lien Need Help mis en évidence sous le champ du mot de passe"} },
        { title: "Choisissez « Reset Password »", html: "Le panneau propose deux options : « Retrieve Username » et « Reset Password. » Si vous avez aussi perdu la trace du nom d'utilisateur que vous employez, récupérez-le d'abord. Choisissez Retrieve Username, saisissez votre e-mail et votre nom d'utilisateur vous est envoyé. Sinon, allez directement à Reset Password.", image: {"src":`${IMG}/tradovate-reset-password-2.png`,"alt":"Panneau Need Help de Tradovate affichant les options Retrieve Username et Reset Password"} },
        { title: "Saisissez votre nom d'utilisateur ou votre e-mail", html: "Dans le formulaire de réinitialisation, saisissez le nom d'utilisateur ou l'e-mail associé à votre compte, puis validez. Tradovate envoie les instructions à l'e-mail enregistré, et non à l'adresse que vous saisissez ; elle doit donc correspondre à celle de votre compte. Saisissez-la avec soin.", image: {"src":`${IMG}/tradovate-reset-password-3.png`,"alt":"Formulaire de réinitialisation du mot de passe Tradovate avec un champ pour le nom d'utilisateur ou l'adresse e-mail"} },
        { title: "Ouvrez l'e-mail et définissez un nouveau mot de passe", html: "Vérifiez votre boîte de réception pour trouver le message de réinitialisation et cliquez sur le lien qu'il contient. Définissez un nouveau mot de passe, enregistrez-le, puis revenez à l'écran de connexion et connectez-vous. Le lien a une durée de validité limitée ; ne le laissez donc pas traîner des heures. Faites-le tant que vous êtes à votre bureau.", image: {"src":`${IMG}/tradovate-reset-password-4.png`,"alt":"E-mail de réinitialisation du mot de passe Tradovate et formulaire de saisie d'un nouveau mot de passe"} },
      ],
    },
    { type: "heading",text: "Vous n'avez pas reçu l'e-mail ?" },
    {
      type: "list",
      items: [
        "Vérifiez vos dossiers spam et courriers indésirables. Les e-mails de réinitialisation y atterrissent plus souvent qu'on ne le pense.",
        "Confirmez l'adresse. Si vous ne savez pas quel e-mail est enregistré, lancez « Retrieve Username » et voyez où il arrive.",
        "Patientez quelques minutes, puis redemandez la réinitialisation une fois. L'envoyer à répétition ne l'accélérera pas.",
      ],
    },
    { type: "quote",html: "Tradovate ne vous demandera jamais votre mot de passe. Tout message ou toute personne qui vous demande de le communiquer est une arnaque, aussi officielle soit-elle en apparence." },
    { type: "heading",text: "Comptes de prop firm ou d'évaluation" },
    { type: "paragraph",html: "Si vous vous connectez avec des identifiants fournis par une prop firm ou un service d'évaluation, la réinitialisation « Need Help? » ne vous sera d'aucune utilité. Ces comptes ne sont pas gérés par Tradovate ; le processus de réinitialisation ne peut donc pas les atteindre. Les règles de récupération varient selon la société et le compte ; contactez directement votre fournisseur pour réinitialiser ou récupérer l'identifiant. Il possède le compte, et lui seul peut vous remettre un nouveau mot de passe." },
    { type: "heading",text: "Déjà connecté et vous souhaitez simplement le modifier ?" },
    { type: "paragraph",html: "Ce processus de réinitialisation sert lorsque vous êtes bloqué et ne vous souvenez plus du mot de passe. Si vous connaissez encore le mot de passe actuel et souhaitez simplement le remplacer par un nouveau, rien de tout cela n'est nécessaire. Faites-le depuis la plateforme une fois connecté : changer le mot de passe y relève des paramètres, et non de la récupération. Gardez la réinitialisation pour les moments où vous êtes réellement bloqué sur l'écran de connexion." },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "De nouveau connecté et prêt à trader ? Ne surveillez pas la connexion. <strong class='text-white'>PickMyTrade achemine automatiquement vos alertes TradingView directement vers Tradovate</strong>, afin que votre stratégie continue de tourner, que vous soyez devant l'écran ou non." },
  ], it: [
    { type: "paragraph",html: "Avere un vuoto sulla password proprio prima dell'apertura è una sensazione orribile. La buona notizia: non deve scrivere al supporto né restare in attesa al telefono. Può reimpostare una password Tradovate dimenticata direttamente dalla schermata di accesso, e il tutto richiede un paio di minuti una volta che l'e-mail arriva." },
    { type: "paragraph",html: "Una cosa da sapere subito. Questo funziona per gli account effettivamente gestiti da Tradovate. Se opera con una valutazione di prop firm, le Sue credenziali appartengono alla società e non a Tradovate, quindi passi direttamente alla nota sugli account prop." },
    { type: "heading",text: "Prima di iniziare" },
    { type: "paragraph",html: "Le serviranno due cose: l'indirizzo e-mail associato al Suo account Tradovate e l'accesso a quella casella di posta. Il link di reset viene sempre inviato all'indirizzo registrato, quindi se non riesce ad accedere a quell'e-mail, risolva prima questo problema." },
    { type: "heading",text: "Reimposti la password dalla schermata di accesso" },
    {
      type: "steps",
      items: [
        { title: "Apra la schermata di accesso e clicchi su «Need Help?»", html: "Vada all'app web di Tradovate oppure apra l'app desktop o mobile. Sotto i campi del nome utente e della password noterà un link «Need Help?». Ci clicchi. Sia il recupero del nome utente sia il reset della password si trovano dietro quell'unico link.", image: {"src":`${IMG}/tradovate-reset-password-1.png`,"alt":"Schermata di accesso di Tradovate con il link Need Help evidenziato sotto il campo della password"} },
