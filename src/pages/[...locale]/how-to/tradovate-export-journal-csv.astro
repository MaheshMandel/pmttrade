---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-export-journal-csv";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Export Tradovate Trades to CSV for a Journal";
const META_DESCRIPTION =
  "Export Tradovate trades to CSV without import errors: pull the Orders report, append Cash history for commissions, and get a clean journal-ready file.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate-Trades als CSV für ein Journal exportieren", es: "Exporte sus operaciones de Tradovate a CSV para un diario", fr: "Exporter vos trades Tradovate en CSV pour un journal", it: "Esportare i trade di Tradovate in CSV per un journal" },
  dek: { en: "If your journal keeps rejecting your Tradovate export, or it imports with every commission field blank, here's exactly how to fix it, step by step.", de: "Wenn Ihr Journal Ihren Tradovate-Export immer wieder ablehnt oder alle Provisionsfelder leer importiert werden, zeigen wir Ihnen hier Schritt für Schritt, wie Sie das beheben.", es: "Si su diario rechaza una y otra vez su exportación de Tradovate, o se importa con todos los campos de comisión en blanco, aquí le explicamos paso a paso cómo solucionarlo.", fr: "Si votre journal rejette sans cesse votre export Tradovate, ou si tous les champs de commission sont vides à l'import, voici exactement comment y remédier, étape par étape.", it: "Se il suo journal continua a rifiutare l'esportazione di Tradovate, oppure la importa con tutti i campi delle commissioni vuoti, ecco come risolvere il problema, passo dopo passo." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "If your journal keeps rejecting your Tradovate export, or it imports with every commission field blank, the file itself is usually the problem. Two things fix it: pull your data from the <strong class='text-white'>Orders</strong> tab (not Performance), and append the <strong class='text-white'>Cash History</strong> report so the fees ride along with the trades. Do those in the right order and most journals read the file on the first try." },
    { type: "quote", html: "<strong>Quick answer:</strong> Export the <strong>Orders</strong> report as CSV for your date range, export <strong>Cash History</strong> for the exact same dates, then paste the Cash rows below the Orders rows and import that one combined file. Skip the Performance tab entirely." },
    { type: "heading", text: "Why the Performance Tab Breaks the Import" },
    { type: "paragraph", html: "It's the most common reason a Tradovate import fails. The Performance report is built for reading on screen, so its columns and layout don't match what journal importers expect. The Orders report is the raw list of your orders and fills, and that's the shape the importers are written against. Grab the wrong one and you'll either get an error or a mangled import. So before anything else: Orders, not Performance." },
    { type: "heading", text: "Export Tradovate Trades to CSV: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open Account Reports", html: "Sign in to the Tradovate platform. Click the dropdown next to your account name, then click the small <strong class='text-white'>gear icon</strong> beside it, that opens the <strong class='text-white'>Account Reports</strong> section, where you'll see tabs like Orders, Fills, Cash History, and Performance. If you run more than one account, double-check you've got the right account selected before you pull anything." },
        { title: "Open the Orders Tab and Set Your Dates", html: "Click the <strong class='text-white'>Orders</strong> tab. Set a custom From and To date range that covers exactly the sessions you want in your journal. There are usually preset ranges like Today, This Week, and This Month too, but a custom range gives you cleaner control, especially if you only want to import a specific stretch. Take a second to confirm the list on screen is actually the trades you expect before you download." },
        { title: "Download the Orders Report as CSV", html: "Choose <strong class='text-white'>CSV</strong> as the format (reports also export as PDF, which won't import), then download. Save it somewhere obvious and give it a name you'll recognize, like <em>Orders.csv</em>. If your journal accepts the Orders export as-is, you can stop here and import it now, and just live with blank commission fields. If you want your fees and net numbers to line up, keep going." },
        { title: "Export Cash History for the Same Dates", html: "Here's the part people miss. The Orders export doesn't carry commissions or exchange fees, so a journal built only from it can't show your true net P&amp;L. Switch to the <strong class='text-white'>Cash History</strong> tab, set the <em>exact same</em> date range you used for Orders, and download it as CSV. This report logs the cash movements, the trade-paired closes, commissions, and fees that the Orders file leaves out." },
        { title: "Merge the Two Files and Import", html: "Open both CSVs. Copy every row from the Cash History file and paste it directly <strong class='text-white'>below the last row</strong> of the Orders file. Save that combined file and upload it to your journal as a single CSV. The importer reads the Orders rows for the trades and the Cash rows for the fees, and your commissions finally show up where they belong. Import order matters here, so don't paste Orders under Cash or split them into two uploads unless your journal specifically asks for that." },
      ],
    },
    { type: "heading", text: "Which Tab Does What" },
    {
      type: "table",
      headers: ["Report tab", "Use it for", "Journal import?"],
      rows: [
        ["Orders", "Your orders and fills, the core trade data", "Yes, start here"],
        ["Cash History", "Commissions, fees, trade-paired closes", "Yes, append to Orders"],
        ["Performance", "On-screen stats and P&amp;L charts", "No, breaks most importers"],
      ],
    },
    { type: "heading", text: "Two Things That Trip People Up" },
    { type: "paragraph", html: "First, gross vs net. If your journal's total doesn't match what Tradovate shows, remember the Orders file is gross. Compare gross to gross until the Cash History fees are folded in, then check net against net." },
    { type: "paragraph", html: "Second, timezone. Most journals ask for your local timezone on import so the fill times land on the correct trading day. Set it, or your last trades of the session can slide into the next day." },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Tired of exporting and reconciling by hand every week? <strong class='text-white'>PickMyTrade automates your Tradovate order flow</strong> so your fills are logged consistently from the start, less cleanup, fewer broken imports." },
    { type: "paragraph", html: "That's the whole trick. Orders for the trades, Cash History for the fees, same dates on both, and one merged file into your journal. Labels shift around as Tradovate updates the platform, so if a button reads slightly differently than described, look for the equivalent CSV download on each tab." },
  ], de: [
    { type: "paragraph",html: "Wenn Ihr Journal Ihren Tradovate-Export immer wieder ablehnt oder alle Provisionsfelder leer importiert werden, liegt das Problem meist an der Datei selbst. Zwei Dinge beheben es: Holen Sie Ihre Daten aus dem Tab <strong class='text-white'>Orders</strong> (nicht Performance) und hängen Sie den Bericht <strong class='text-white'>Cash History</strong> an, damit die Gebühren zu den Trades mitgeliefert werden. Wenn Sie das in der richtigen Reihenfolge tun, liest die meisten Journale die Datei auf Anhieb." },
    { type: "quote",html: "<strong>Kurzantwort:</strong> Exportieren Sie den Bericht <strong>Orders</strong> als CSV für Ihren Datumsbereich, exportieren Sie <strong>Cash History</strong> für exakt dieselben Daten, fügen Sie dann die Cash-Zeilen unter die Orders-Zeilen ein und importieren Sie diese eine kombinierte Datei. Überspringen Sie den Tab Performance vollständig." },
    { type: "heading",text: "Warum der Tab Performance den Import scheitern lässt" },
    { type: "paragraph",html: "Das ist der häufigste Grund, warum ein Tradovate-Import fehlschlägt. Der Bericht Performance ist zum Lesen auf dem Bildschirm gedacht, daher entsprechen seine Spalten und sein Layout nicht dem, was Journal-Importer erwarten. Der Bericht Orders ist die Rohliste Ihrer Orders und Fills, und genau dafür sind die Importer geschrieben. Wenn Sie den falschen greifen, erhalten Sie entweder eine Fehlermeldung oder einen verstümmelten Import. Also vor allem anderen: Orders, nicht Performance." },
    { type: "heading",text: "Tradovate-Trades als CSV exportieren: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Öffnen Sie die Account Reports", html: "Melden Sie sich bei der Tradovate-Plattform an. Klicken Sie auf das Dropdown-Menü neben Ihrem Kontonamen und dann auf das kleine <strong class='text-white'>Zahnrad-Symbol</strong> daneben; damit öffnen Sie den Bereich <strong class='text-white'>Account Reports</strong>, in dem Sie Tabs wie Orders, Fills, Cash History und Performance sehen. Wenn Sie mehr als ein Konto betreiben, prüfen Sie noch einmal, ob das richtige Konto ausgewählt ist, bevor Sie etwas abrufen." },
        { title: "Öffnen Sie den Tab Orders und legen Sie die Daten fest", html: "Klicken Sie auf den Tab <strong class='text-white'>Orders</strong>. Legen Sie einen benutzerdefinierten Datumsbereich From und To fest, der genau die Sessions abdeckt, die in Ihrem Journal erscheinen sollen. Es gibt meist auch voreingestellte Bereiche wie Today, This Week und This Month, aber ein benutzerdefinierter Bereich gibt Ihnen mehr Kontrolle, besonders wenn Sie nur einen bestimmten Zeitraum importieren möchten. Nehmen Sie sich eine Sekunde, um zu bestätigen, dass die Liste auf dem Bildschirm tatsächlich die erwarteten Trades enthält, bevor Sie sie herunterladen." },
        { title: "Laden Sie den Bericht Orders als CSV herunter", html: "Wählen Sie <strong class='text-white'>CSV</strong> als Format (Berichte lassen sich auch als PDF exportieren, das sich nicht importieren lässt) und laden Sie ihn herunter. Speichern Sie die Datei an einem leicht auffindbaren Ort und geben Sie ihr einen Namen, den Sie wiedererkennen, etwa <em>Orders.csv</em>. Wenn Ihr Journal den Orders-Export unverändert akzeptiert, können Sie hier aufhören und ihn jetzt importieren, müssen dann aber mit leeren Provisionsfeldern leben. Wenn Sie möchten, dass Ihre Gebühren und Nettozahlen stimmen, machen Sie weiter." },
        { title: "Exportieren Sie Cash History für dieselben Daten", html: "Hier ist der Teil, den viele übersehen. Der Orders-Export enthält keine Provisionen oder Börsengebühren, daher kann ein nur daraus erstelltes Journal Ihren echten Netto-P&amp;L nicht anzeigen. Wechseln Sie zum Tab <strong class='text-white'>Cash History</strong>, legen Sie <em>exakt denselben</em> Datumsbereich fest, den Sie für Orders verwendet haben, und laden Sie ihn als CSV herunter. Dieser Bericht protokolliert die Cash-Bewegungen, die den Trades zugeordneten Schließungen, Provisionen und Gebühren, die die Orders-Datei auslässt." },
        { title: "Führen Sie die beiden Dateien zusammen und importieren Sie", html: "Öffnen Sie beide CSV-Dateien. Kopieren Sie jede Zeile der Cash-History-Datei und fügen Sie sie direkt <strong class='text-white'>unter der letzten Zeile</strong> der Orders-Datei ein. Speichern Sie diese kombinierte Datei und laden Sie sie als einzelne CSV in Ihr Journal hoch. Der Importer liest die Orders-Zeilen für die Trades und die Cash-Zeilen für die Gebühren, und Ihre Provisionen erscheinen endlich dort, wo sie hingehören. Die Reihenfolge ist hier wichtig; fügen Sie also nicht Orders unter Cash ein und teilen Sie sie nicht auf zwei Uploads auf, es sei denn, Ihr Journal verlangt dies ausdrücklich." },
      ],
    },
    { type: "heading",text: "Welcher Tab wofür zuständig ist" },
    { type: "table", headers: ["Berichts-Tab","Verwendung","Journal-Import?"], rows: [
      ["Orders","Ihre Orders und Fills, die zentralen Trade-Daten","Ja, beginnen Sie hier"],
      ["Cash History","Provisionen, Gebühren, zugeordnete Schließungen","Ja, an Orders anhängen"],
      ["Performance","Statistiken und P&amp;L-Diagramme auf dem Bildschirm","Nein, bringt die meisten Importer zum Scheitern"],
    ] },
    { type: "heading",text: "Zwei Dinge, über die man oft stolpert" },
    { type: "paragraph",html: "Erstens: brutto gegen netto. Wenn die Summe Ihres Journals nicht mit dem übereinstimmt, was Tradovate anzeigt, denken Sie daran, dass die Orders-Datei brutto ist. Vergleichen Sie brutto mit brutto, bis die Gebühren aus Cash History eingearbeitet sind, und prüfen Sie dann netto gegen netto." },
    { type: "paragraph",html: "Zweitens: die Zeitzone. Die meisten Journale fragen beim Import nach Ihrer lokalen Zeitzone, damit die Fill-Zeiten dem richtigen Handelstag zugeordnet werden. Stellen Sie sie ein, sonst können die letzten Trades Ihrer Session auf den nächsten Tag rutschen." },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "Sie sind es leid, jede Woche von Hand zu exportieren und abzugleichen? <strong class='text-white'>PickMyTrade automatisiert Ihren Tradovate-Orderfluss</strong>, damit Ihre Fills von Anfang an einheitlich protokolliert werden, weniger Nacharbeit, weniger fehlgeschlagene Importe." },
    { type: "paragraph",html: "Das ist der ganze Trick. Orders für die Trades, Cash History für die Gebühren, dieselben Daten bei beiden und eine zusammengeführte Datei für Ihr Journal. Bezeichnungen ändern sich, wenn Tradovate die Plattform aktualisiert; wenn eine Schaltfläche also etwas anders heißt als beschrieben, suchen Sie auf jedem Tab nach dem entsprechenden CSV-Download." },
  ], es: [
    { type: "paragraph",html: "Si su diario rechaza una y otra vez su exportación de Tradovate, o se importa con todos los campos de comisión en blanco, el problema suele ser el propio archivo. Dos cosas lo resuelven: extraiga sus datos de la pestaña <strong class='text-white'>Orders</strong> (no de Performance) y añada el informe <strong class='text-white'>Cash History</strong> para que las tarifas acompañen a las operaciones. Si lo hace en el orden correcto, la mayoría de los diarios leen el archivo a la primera." },
    { type: "quote",html: "<strong>Respuesta rápida:</strong> Exporte el informe <strong>Orders</strong> como CSV para su rango de fechas, exporte <strong>Cash History</strong> para exactamente las mismas fechas, pegue las filas de Cash debajo de las filas de Orders e importe ese único archivo combinado. Omita por completo la pestaña Performance." },
    { type: "heading",text: "Por qué la pestaña Performance rompe la importación" },
    { type: "paragraph",html: "Es el motivo más común por el que falla una importación de Tradovate. El informe Performance está pensado para leerse en pantalla, por lo que sus columnas y su diseño no coinciden con lo que esperan los importadores de diarios. El informe Orders es la lista sin procesar de sus órdenes y ejecuciones, y esa es la forma para la que están escritos los importadores. Si elige el equivocado, obtendrá un error o una importación desordenada. Así que, antes que nada: Orders, no Performance." },
    { type: "heading",text: "Exportar operaciones de Tradovate a CSV: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra Account Reports", html: "Inicie sesión en la plataforma Tradovate. Haga clic en el menú desplegable junto al nombre de su cuenta y luego en el pequeño <strong class='text-white'>icono de engranaje</strong> que hay a su lado; eso abre la sección <strong class='text-white'>Account Reports</strong>, donde verá pestañas como Orders, Fills, Cash History y Performance. Si maneja más de una cuenta, verifique que tiene seleccionada la correcta antes de extraer nada." },
        { title: "Abra la pestaña Orders y establezca las fechas", html: "Haga clic en la pestaña <strong class='text-white'>Orders</strong>. Establezca un rango de fechas personalizado From y To que cubra exactamente las sesiones que quiere en su diario. Normalmente también hay rangos predefinidos como Today, This Week y This Month, pero un rango personalizado le da un control más preciso, sobre todo si solo quiere importar un periodo concreto. Tómese un segundo para confirmar que la lista en pantalla contiene realmente las operaciones que espera antes de descargar." },
        { title: "Descargue el informe Orders como CSV", html: "Elija <strong class='text-white'>CSV</strong> como formato (los informes también se exportan como PDF, que no se puede importar) y descárguelo. Guárdelo en un lugar fácil de encontrar y póngale un nombre que reconozca, como <em>Orders.csv</em>. Si su diario acepta la exportación de Orders tal cual, puede detenerse aquí e importarla ahora, aceptando los campos de comisión en blanco. Si quiere que sus tarifas y cifras netas cuadren, siga adelante." },
        { title: "Exporte Cash History para las mismas fechas", html: "Esta es la parte que muchos pasan por alto. La exportación de Orders no incluye comisiones ni tarifas de bolsa, por lo que un diario creado solo con ella no puede mostrar su P&amp;L neto real. Cambie a la pestaña <strong class='text-white'>Cash History</strong>, establezca <em>exactamente el mismo</em> rango de fechas que usó para Orders y descárguela como CSV. Este informe registra los movimientos de efectivo, los cierres emparejados con las operaciones, las comisiones y las tarifas que el archivo de Orders deja fuera." },
        { title: "Combine los dos archivos e importe", html: "Abra ambos CSV. Copie todas las filas del archivo de Cash History y péguelas directamente <strong class='text-white'>debajo de la última fila</strong> del archivo de Orders. Guarde ese archivo combinado y cárguelo en su diario como un único CSV. El importador lee las filas de Orders para las operaciones y las de Cash para las tarifas, y por fin sus comisiones aparecen donde corresponde. El orden importa aquí, así que no pegue Orders debajo de Cash ni los divida en dos cargas a menos que su diario lo pida específicamente." },
      ],
    },
    { type: "heading",text: "Qué hace cada pestaña" },
    { type: "table", headers: ["Pestaña del informe","Para qué sirve","¿Importar al diario?"], rows: [
      ["Orders","Sus órdenes y ejecuciones, los datos centrales de las operaciones","Sí, empiece aquí"],
      ["Cash History","Comisiones, tarifas, cierres emparejados","Sí, añádala a Orders"],
      ["Performance","Estadísticas en pantalla y gráficos de P&amp;L","No, rompe la mayoría de los importadores"],
    ] },
    { type: "heading",text: "Dos cosas con las que tropieza la gente" },
    { type: "paragraph",html: "Primero, bruto frente a neto. Si el total de su diario no coincide con lo que muestra Tradovate, recuerde que el archivo de Orders es bruto. Compare bruto con bruto hasta incorporar las tarifas de Cash History y luego compare neto con neto." },
    { type: "paragraph",html: "Segundo, la zona horaria. La mayoría de los diarios piden su zona horaria local al importar para que las horas de ejecución caigan en el día de trading correcto. Configúrela, o las últimas operaciones de su sesión pueden pasar al día siguiente." },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "¿Cansado de exportar y conciliar a mano cada semana? <strong class='text-white'>PickMyTrade automatiza el flujo de órdenes de Tradovate</strong> para que sus ejecuciones queden registradas de forma uniforme desde el principio, menos limpieza, menos importaciones fallidas." },
    { type: "paragraph",html: "Ese es todo el truco. Orders para las operaciones, Cash History para las tarifas, las mismas fechas en ambos y un solo archivo combinado en su diario. Las etiquetas cambian cuando Tradovate actualiza la plataforma, así que si un botón se llama de forma ligeramente distinta a la descrita, busque la descarga CSV equivalente en cada pestaña." },
  ], fr: [
    { type: "paragraph",html: "Si votre journal rejette sans cesse votre export Tradovate, ou si tous les champs de commission sont vides à l'import, le problème vient généralement du fichier lui-même. Deux choses le règlent : extrayez vos données de l'onglet <strong class='text-white'>Orders</strong> (et non Performance), puis ajoutez le rapport <strong class='text-white'>Cash History</strong> pour que les frais accompagnent les trades. En les faisant dans le bon ordre, la plupart des journaux lisent le fichier du premier coup." },
    { type: "quote",html: "<strong>Réponse rapide :</strong> Exportez le rapport <strong>Orders</strong> en CSV pour votre plage de dates, exportez <strong>Cash History</strong> pour exactement les mêmes dates, collez les lignes de Cash sous les lignes d'Orders, puis importez ce fichier combiné unique. Ignorez complètement l'onglet Performance." },
    { type: "heading",text: "Pourquoi l'onglet Performance fait échouer l'import" },
    { type: "paragraph",html: "C'est la cause la plus fréquente d'un échec d'import Tradovate. Le rapport Performance est conçu pour être lu à l'écran ; ses colonnes et sa mise en page ne correspondent donc pas à ce qu'attendent les outils d'import des journaux. Le rapport Orders est la liste brute de vos ordres et exécutions, et c'est la forme pour laquelle les outils d'import sont écrits. Si vous prenez le mauvais, vous obtiendrez soit une erreur, soit un import déformé. Donc, avant toute chose : Orders, pas Performance." },
    { type: "heading",text: "Exporter vos trades Tradovate en CSV : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez Account Reports", html: "Connectez-vous à la plateforme Tradovate. Cliquez sur le menu déroulant à côté du nom de votre compte, puis sur la petite <strong class='text-white'>icône d'engrenage</strong> à côté ; cela ouvre la section <strong class='text-white'>Account Reports</strong>, où vous verrez des onglets tels que Orders, Fills, Cash History et Performance. Si vous gérez plusieurs comptes, vérifiez que le bon compte est sélectionné avant d'extraire quoi que ce soit." },
        { title: "Ouvrez l'onglet Orders et définissez vos dates", html: "Cliquez sur l'onglet <strong class='text-white'>Orders</strong>. Définissez une plage de dates personnalisée From et To qui couvre exactement les séances que vous voulez dans votre journal. Il existe généralement aussi des plages prédéfinies comme Today, This Week et This Month, mais une plage personnalisée vous offre un meilleur contrôle, surtout si vous ne voulez importer qu'une période précise. Prenez une seconde pour vérifier que la liste à l'écran correspond bien aux trades attendus avant de télécharger." },
        { title: "Téléchargez le rapport Orders en CSV", html: "Choisissez <strong class='text-white'>CSV</strong> comme format (les rapports s'exportent aussi en PDF, qui ne s'importe pas), puis téléchargez. Enregistrez le fichier dans un endroit évident et donnez-lui un nom que vous reconnaîtrez, par exemple <em>Orders.csv</em>. Si votre journal accepte l'export Orders tel quel, vous pouvez vous arrêter ici et l'importer maintenant, en vous accommodant de champs de commission vides. Si vous voulez que vos frais et vos chiffres nets concordent, continuez." },
        { title: "Exportez Cash History pour les mêmes dates", html: "Voici la partie que beaucoup oublient. L'export Orders ne contient ni commissions ni frais de bourse ; un journal construit uniquement à partir de celui-ci ne peut donc pas afficher votre véritable P&amp;L net. Passez à l'onglet <strong class='text-white'>Cash History</strong>, définissez <em>exactement la même</em> plage de dates que pour Orders et téléchargez-la en CSV. Ce rapport consigne les mouvements de trésorerie, les clôtures appariées aux trades, les commissions et les frais que le fichier Orders omet." },
        { title: "Fusionnez les deux fichiers et importez", html: "Ouvrez les deux CSV. Copiez toutes les lignes du fichier Cash History et collez-les directement <strong class='text-white'>sous la dernière ligne</strong> du fichier Orders. Enregistrez ce fichier combiné et envoyez-le à votre journal en un seul CSV. L'outil d'import lit les lignes Orders pour les trades et les lignes Cash pour les frais, et vos commissions apparaissent enfin là où elles doivent. L'ordre compte ici : ne collez donc pas Orders sous Cash et ne scindez pas les fichiers en deux envois, sauf si votre journal le demande expressément." },
      ],
    },
    { type: "heading",text: "Quel onglet sert à quoi" },
    { type: "table", headers: ["Onglet du rapport","À quoi il sert","Import dans le journal ?"], rows: [
      ["Orders","Vos ordres et exécutions, les données de trade essentielles","Oui, commencez ici"],
      ["Cash History","Commissions, frais, clôtures appariées","Oui, à ajouter à Orders"],
      ["Performance","Statistiques à l'écran et graphiques de P&amp;L","Non, fait échouer la plupart des imports"],
    ] },
    { type: "heading",text: "Deux pièges fréquents" },
    { type: "paragraph",html: "Premièrement, brut contre net. Si le total de votre journal ne correspond pas à ce que Tradovate affiche, rappelez-vous que le fichier Orders est brut. Comparez brut à brut jusqu'à ce que les frais de Cash History soient intégrés, puis vérifiez net contre net." },
    { type: "paragraph",html: "Deuxièmement, le fuseau horaire. La plupart des journaux demandent votre fuseau horaire local à l'import afin que les heures d'exécution tombent sur le bon jour de trading. Renseignez-le, sinon vos derniers trades de la séance peuvent glisser au jour suivant." },
    { type: "heading",text: "Automatisez tout cela avec PickMyTrade" },
    { type: "paragraph",html: "Fatigué d'exporter et de rapprocher à la main chaque semaine ? <strong class='text-white'>PickMyTrade automatise votre flux d'ordres Tradovate</strong> afin que vos exécutions soient enregistrées de manière cohérente dès le départ, moins de nettoyage, moins d'imports en échec." },
    { type: "paragraph",html: "Voilà toute l'astuce. Orders pour les trades, Cash History pour les frais, les mêmes dates sur les deux, et un seul fichier fusionné dans votre journal. Les libellés évoluent quand Tradovate met à jour la plateforme ; si un bouton est légèrement différent de la description, cherchez le téléchargement CSV équivalent sur chaque onglet." },
  ], it: [
    { type: "paragraph",html: "Se il suo journal continua a rifiutare l'esportazione di Tradovate, oppure la importa con tutti i campi delle commissioni vuoti, il problema è di solito il file stesso. Bastano due cose: estragga i dati dalla scheda <strong class='text-white'>Orders</strong> (non da Performance) e aggiunga il report <strong class='text-white'>Cash History</strong>, in modo che le commissioni accompagnino i trade. Se le esegue nell'ordine giusto, la maggior parte dei journal legge il file al primo tentativo." },
    { type: "quote",html: "<strong>Risposta rapida:</strong> Esporti il report <strong>Orders</strong> in CSV per il suo intervallo di date, esporti <strong>Cash History</strong> per le stesse identiche date, incolli le righe di Cash sotto le righe di Orders e importi quell'unico file combinato. Salti del tutto la scheda Performance." },
    { type: "heading",text: "Perché la scheda Performance fa fallire l'importazione" },
    { type: "paragraph",html: "È il motivo più comune per cui un'importazione da Tradovate fallisce. Il report Performance è pensato per essere letto a schermo, quindi le sue colonne e il suo layout non corrispondono a ciò che si aspettano gli importatori dei journal. Il report Orders è l'elenco grezzo dei suoi ordini ed esecuzioni, ed è la forma per cui sono scritti gli importatori. Se sceglie quello sbagliato, otterrà un errore oppure un'importazione corrotta. Quindi, prima di tutto: Orders, non Performance." },
    { type: "heading",text: "Esportare i trade di Tradovate in CSV: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Apra Account Reports", html: "Acceda alla piattaforma Tradovate. Clicchi sul menu a discesa accanto al nome del suo conto, quindi sulla piccola <strong class='text-white'>icona a forma di ingranaggio</strong> accanto; si apre la sezione <strong class='text-white'>Account Reports</strong>, dove vedrà schede come Orders, Fills, Cash History e Performance. Se gestisce più di un conto, controlli di aver selezionato quello giusto prima di estrarre qualsiasi dato." },
        { title: "Apra la scheda Orders e imposti le date", html: "Clicchi sulla scheda <strong class='text-white'>Orders</strong>. Imposti un intervallo di date personalizzato From e To che copra esattamente le sessioni che desidera nel suo journal. Di solito ci sono anche intervalli predefiniti come Today, This Week e This Month, ma un intervallo personalizzato offre un controllo più preciso, soprattutto se vuole importare solo un periodo specifico. Si prenda un secondo per verificare che l'elenco a schermo contenga davvero i trade che si aspetta prima di scaricare." },
        { title: "Scarichi il report Orders in CSV", html: "Scelga <strong class='text-white'>CSV</strong> come formato (i report si esportano anche in PDF, che non può essere importato) e scarichi. Salvi il file in un posto facile da ritrovare e gli dia un nome riconoscibile, come <em>Orders.csv</em>. Se il suo journal accetta l'esportazione di Orders così com'è, può fermarsi qui e importarla subito, accettando i campi delle commissioni vuoti. Se vuole che commissioni e cifre nette quadrino, prosegua." },
        { title: "Esporti Cash History per le stesse date", html: "Ecco la parte che molti trascurano. L'esportazione di Orders non contiene commissioni né spese di borsa, quindi un journal costruito solo su di essa non può mostrare il suo vero P&amp;L netto. Passi alla scheda <strong class='text-white'>Cash History</strong>, imposti <em>esattamente lo stesso</em> intervallo di date usato per Orders e la scarichi in CSV. Questo report registra i movimenti di cassa, le chiusure abbinate ai trade, le commissioni e le spese che il file Orders omette." },
        { title: "Unisca i due file e importi", html: "Apra entrambi i CSV. Copi tutte le righe del file Cash History e le incolli direttamente <strong class='text-white'>sotto l'ultima riga</strong> del file Orders. Salvi il file combinato e lo carichi nel suo journal come un unico CSV. L'importatore legge le righe di Orders per i trade e quelle di Cash per le commissioni, e finalmente le sue commissioni compaiono dove devono. L'ordine qui è importante: non incolli Orders sotto Cash e non li divida in due caricamenti, a meno che il suo journal non lo richieda espressamente." },
      ],
    },
    { type: "heading",text: "A cosa serve ciascuna scheda" },
    { type: "table", headers: ["Scheda del report","A cosa serve","Importazione nel journal?"], rows: [
      ["Orders","I suoi ordini ed esecuzioni, i dati principali dei trade","Sì, parta da qui"],
      ["Cash History","Commissioni, spese, chiusure abbinate","Sì, da aggiungere a Orders"],
      ["Performance","Statistiche a schermo e grafici di P&amp;L","No, fa fallire la maggior parte degli importatori"],
    ] },
    { type: "heading",text: "Due cose su cui si inciampa spesso" },
    { type: "paragraph",html: "Primo, lordo contro netto. Se il totale del suo journal non coincide con quanto mostra Tradovate, ricordi che il file Orders è al lordo. Confronti lordo con lordo finché le commissioni di Cash History non sono state integrate, poi verifichi netto contro netto." },
    { type: "paragraph",html: "Secondo, il fuso orario. La maggior parte dei journal chiede il suo fuso orario locale all'importazione, in modo che gli orari di esecuzione ricadano nel giorno di trading corretto. Lo imposti, altrimenti gli ultimi trade della sessione possono scivolare al giorno successivo." },
    { type: "heading",text: "Automatizzi tutto questo con PickMyTrade" },
    { type: "paragraph",html: "Stanco di esportare e riconciliare a mano ogni settimana? <strong class='text-white'>PickMyTrade automatizza il suo flusso di ordini Tradovate</strong> così le sue esecuzioni vengono registrate in modo coerente fin dall'inizio, meno pulizia, meno importazioni fallite." },
    { type: "paragraph",html: "Questo è tutto il trucco. Orders per i trade, Cash History per le commissioni, le stesse date su entrambi e un unico file unito nel suo journal. Le etichette cambiano quando Tradovate aggiorna la piattaforma, quindi se un pulsante ha un nome leggermente diverso da quello descritto, cerchi il download CSV equivalente in ciascuna scheda." },
  ] },
  ctaHeading: { en: "Stop Reconciling Fills by Hand", de: "Schluss mit dem manuellen Abgleich von Fills", es: "Deje de conciliar ejecuciones a mano", fr: "Arrêtez de rapprocher vos exécutions à la main", it: "Smetta di riconciliare le esecuzioni a mano" },
