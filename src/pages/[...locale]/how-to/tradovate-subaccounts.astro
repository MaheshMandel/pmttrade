---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-subaccounts";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Use Subaccounts at Tradovate";
const META_DESCRIPTION =
  "Run separate strategies and segment capital across trading subaccounts under one login, switch between them quickly, and move funds internally.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Subkonten bei Tradovate nutzen", es: "Use subcuentas en Tradovate", fr: "Utiliser les sous-comptes chez Tradovate", it: "Usare i sotto-conti su Tradovate" },
  dek: { en: "Subaccounts let you run multiple, fully separate trading accounts under a single Tradovate login. Here's how to add them, switch between them, and shuffle money around without touching your bank.", de: "Mit Subkonten betreiben Sie mehrere, vollständig getrennte Handelskonten unter einem einzigen Tradovate-Login. So fügen Sie sie hinzu, wechseln zwischen ihnen und verschieben Geld, ohne Ihre Bank zu bemühen.", es: "Las subcuentas le permiten operar con varias cuentas de trading totalmente independientes bajo un único inicio de sesión de Tradovate. Así puede añadirlas, alternar entre ellas y mover dinero sin tocar su banco.", fr: "Les sous-comptes vous permettent de gérer plusieurs comptes de trading entièrement séparés sous une seule connexion Tradovate. Voici comment les ajouter, passer de l'un à l'autre et déplacer des fonds sans passer par votre banque.", it: "I sotto-conti le permettono di gestire più conti di trading completamente separati con un unico login Tradovate. Ecco come aggiungerli, passare dall'uno all'altro e spostare fondi senza toccare la sua banca." },
  readTime: { en: "4 min read", de: "4 Min. Lesezeit", es: "Lectura de 4 min", fr: "Lecture : 4 min", it: "Lettura di 4 min" },
  lastUpdated: "2026-07-10",
  blocks: { en: [
    { type: "paragraph", html: "Running everything out of one account works fine until it doesn't. Maybe you want your scalping capital walled off from your swing money, or a clean slate to test a new system without putting your main balance on the line. Subaccounts let you do exactly that: multiple, fully separate trading accounts sitting under a single Tradovate login. Here's how to add them, switch between them, and shuffle money around without touching your bank." },
    { type: "heading", text: "What Is a Tradovate Subaccount?" },
    { type: "paragraph", html: "A subaccount is a standalone trading account tied to your existing login. Each one keeps its own balance, its own open positions, its own statements, and its own risk settings. You log in once and toggle between them from inside the platform, which beats juggling separate usernames and passwords." },
    { type: "paragraph", html: "Why bother splitting things up? A few common reasons:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Strategy separation</strong>, keep a mean-reversion book and a trend book in different accounts so their P&amp;L never bleeds together.",
        "<strong class='text-white'>Capital segmenting</strong>, ring-fence a fixed amount for a higher-risk approach and leave the rest untouched.",
        "<strong class='text-white'>Clean records</strong>, one account per strategy means every statement and performance report is already sorted for you.",
        "<strong class='text-white'>Testing</strong>, trade a new idea in its own account before you scale it into the main one.",
      ],
    },
    { type: "heading", text: "How to Use Subaccounts at Tradovate: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open the Accounts Settings", html: "In the Tradovate platform, open the settings menu in the top-right corner. It lands on the <strong class='text-white'>Accounts</strong> tab by default, and any accounts you already have are listed right there. This is home base for adding a new one." },
        { title: "Request a New Subaccount", html: "From the Accounts tab, choose the option to add a trading or live account. You'll fill in the required fields and upload the documents Tradovate asks for, typically a proof-of-account form, a government ID, and a proof of address. You'll also pick an <strong class='text-white'>auto-liquidation</strong> risk profile for the new account. Live subaccounts go through a short approval, so don't expect the balance to appear the same second you hit submit. Tradovate has generally allowed several subaccounts per login, so if you hit a cap, that's the ceiling on your plan rather than a mistake on your end." },
        { title: "Switch Between Your Accounts", html: "Once a subaccount is live, the account name shown at the <strong class='text-white'>top-center</strong> of the platform becomes your switch. Click it and a dropdown lists every account you can trade. Pick one, and the charts, DOM, orders, and positions all snap to that account. Get in the habit of glancing at that account name before you fire an order, because it's the single easiest thing to get wrong when you're moving fast." },
        { title: "Move Funds Between Subaccounts", html: "Rebalancing is quick because it stays inside Tradovate. Open <strong class='text-white'>Application Settings</strong>, find the <strong class='text-white'>Transfers &amp; Payments</strong> area, and use the internal funds transfer to shift money from one of your accounts to another. No wire, no ACH hold, no waiting on a bank, funds land in the receiving account almost immediately. That makes it easy to top up a strategy that's working or pull profit back to your main account." },
        { title: "Set Risk Limits Per Subaccount", html: "The real payoff of separating accounts is separate risk. Open the risk settings on each subaccount and give it its own max position size, daily loss limit, and auto-liquidation profile. A rougher, experimental strategy can run on a tight leash while your core account keeps a wider one, and a bad day in one can't reach across and drain the others." },
      ],
    },
    { type: "heading", text: "A Note on Prop-Firm Accounts" },
    { type: "paragraph", html: "If you're trading a funded or evaluation account, the setup is different. Prop-firm accounts are provisioned by the firm and usually come as their own separate login, not as a subaccount you can create yourself. You can't add or fund those from the Accounts tab, and the number of accounts, drawdown rules, and buffers all vary by firm and account size, so check your firm's current rules rather than assuming a fixed number. Personal, directly funded Tradovate accounts are the ones where you control subaccounts end to end." },
    { type: "heading", text: "Automate Across Every Subaccount with PickMyTrade" },
    { type: "paragraph", html: "Placing the same signal into two, three, or five accounts by hand is exactly the kind of repetitive clicking that leads to mistakes. PickMyTrade takes one TradingView alert and routes it into whichever Tradovate accounts you choose, each with its own contract sizing. Your strategies stay cleanly split across subaccounts while the execution happens for you." },
  ], de: [
    { type: "paragraph",html: "Alles über ein einziges Konto abzuwickeln funktioniert gut, bis es nicht mehr funktioniert. Vielleicht möchten Sie Ihr Scalping-Kapital von Ihrem Swing-Geld abschotten oder einen sauberen Neuanfang, um ein neues System zu testen, ohne Ihr Hauptguthaben aufs Spiel zu setzen. Genau das ermöglichen Subkonten: mehrere, vollständig getrennte Handelskonten unter einem einzigen Tradovate-Login. So fügen Sie sie hinzu, wechseln zwischen ihnen und verschieben Geld, ohne Ihre Bank zu bemühen." },
    { type: "heading",text: "Was ist ein Tradovate-Subkonto?" },
    { type: "paragraph",html: "Ein Subkonto ist ein eigenständiges Handelskonto, das an Ihren bestehenden Login gebunden ist. Jedes führt sein eigenes Guthaben, seine eigenen offenen Positionen, seine eigenen Kontoauszüge und seine eigenen Risikoeinstellungen. Sie loggen sich einmal ein und wechseln innerhalb der Plattform zwischen ihnen, was besser ist, als mit getrennten Benutzernamen und Passwörtern zu jonglieren." },
    { type: "paragraph",html: "Warum überhaupt aufteilen? Ein paar gängige Gründe:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Strategietrennung</strong>, halten Sie ein Mean-Reversion-Buch und ein Trend-Buch in verschiedenen Konten, damit sich ihr G&amp;V nie vermischt.",
        "<strong class='text-white'>Kapitalaufteilung</strong>, reservieren Sie einen festen Betrag für einen risikoreicheren Ansatz und lassen Sie den Rest unberührt.",
        "<strong class='text-white'>Saubere Aufzeichnungen</strong>, ein Konto pro Strategie bedeutet, dass jeder Kontoauszug und jeder Performance-Bericht bereits sortiert ist.",
        "<strong class='text-white'>Testen</strong>, handeln Sie eine neue Idee in einem eigenen Konto, bevor Sie sie in das Hauptkonto übernehmen.",
      ],
    },
    { type: "heading",text: "Subkonten bei Tradovate nutzen: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Die Konto-Einstellungen öffnen", html: "Öffnen Sie in der Tradovate-Plattform das Einstellungsmenü oben rechts. Es landet standardmäßig im Tab <strong class='text-white'>Accounts</strong>, und alle bereits vorhandenen Konten werden dort aufgelistet. Dies ist die Anlaufstelle, um ein neues hinzuzufügen." },
        { title: "Ein neues Subkonto beantragen", html: "Wählen Sie im Tab Accounts die Option zum Hinzufügen eines Trading- oder Live-Kontos. Sie füllen die erforderlichen Felder aus und laden die von Tradovate verlangten Dokumente hoch, in der Regel ein Kontonachweis-Formular, einen amtlichen Ausweis und einen Adressnachweis. Außerdem wählen Sie ein <strong class='text-white'>Auto-Liquidations</strong>-Risikoprofil für das neue Konto. Live-Subkonten durchlaufen eine kurze Genehmigung, rechnen Sie also nicht damit, dass das Guthaben im selben Moment erscheint, in dem Sie auf Absenden klicken. Tradovate hat im Allgemeinen mehrere Subkonten pro Login erlaubt. Wenn Sie an eine Grenze stoßen, ist das die Obergrenze Ihres Tarifs und kein Fehler Ihrerseits." },
        { title: "Zwischen Ihren Konten wechseln", html: "Sobald ein Subkonto aktiv ist, wird der oben in der <strong class='text-white'>Mitte</strong> der Plattform angezeigte Kontoname zu Ihrem Umschalter. Klicken Sie darauf, und ein Dropdown listet jedes Konto auf, mit dem Sie handeln können. Wählen Sie eines aus, und Charts, DOM, Orders und Positionen springen auf dieses Konto um. Gewöhnen Sie sich an, vor jeder Order auf diesen Kontonamen zu schauen, denn hier passiert der häufigste Fehler, wenn man schnell unterwegs ist." },
        { title: "Geld zwischen Subkonten verschieben", html: "Das Umschichten geht schnell, weil es innerhalb von Tradovate bleibt. Öffnen Sie die <strong class='text-white'>Application Settings</strong>, suchen Sie den Bereich <strong class='text-white'>Transfers &amp; Payments</strong> und nutzen Sie die interne Geldüberweisung, um Geld von einem Ihrer Konten auf ein anderes zu verschieben. Keine Überweisung, keine ACH-Sperrfrist, kein Warten auf eine Bank, das Geld trifft nahezu sofort auf dem Empfängerkonto ein. So können Sie eine gut laufende Strategie leicht aufstocken oder Gewinne auf Ihr Hauptkonto zurückholen." },
        { title: "Risikolimits pro Subkonto festlegen", html: "Der eigentliche Vorteil getrennter Konten ist getrenntes Risiko. Öffnen Sie die Risikoeinstellungen jedes Subkontos und geben Sie ihm eine eigene maximale Positionsgröße, ein eigenes Tagesverlustlimit und ein eigenes Auto-Liquidations-Profil. Eine rauere, experimentelle Strategie kann an der kurzen Leine laufen, während Ihr Kernkonto mehr Spielraum behält, und ein schlechter Tag auf einem Konto kann nicht auf die anderen durchschlagen und sie leeren." },
      ],
    },
    { type: "heading",text: "Ein Hinweis zu Prop-Firm-Konten" },
    { type: "paragraph",html: "Wenn Sie ein finanziertes Konto oder ein Evaluierungskonto handeln, ist die Einrichtung anders. Prop-Firm-Konten werden von der Firma bereitgestellt und kommen meist mit einem eigenen, separaten Login, nicht als Subkonto, das Sie selbst anlegen können. Sie können diese nicht im Tab Accounts hinzufügen oder aufstocken, und die Anzahl der Konten, Drawdown-Regeln und Puffer variieren je nach Firma und Kontogröße. Prüfen Sie daher die aktuellen Regeln Ihrer Firma, statt von einer festen Zahl auszugehen. Persönliche, direkt finanzierte Tradovate-Konten sind diejenigen, bei denen Sie Subkonten von Anfang bis Ende selbst steuern." },
    { type: "heading",text: "Automatisieren Sie jedes Subkonto mit PickMyTrade" },
    { type: "paragraph",html: "Dasselbe Signal von Hand in zwei, drei oder fünf Konten zu platzieren ist genau die Art von repetitivem Klicken, die zu Fehlern führt. PickMyTrade nimmt einen TradingView-Alert und leitet ihn an die von Ihnen gewählten Tradovate-Konten weiter, jeweils mit eigener Kontraktgröße. Ihre Strategien bleiben sauber auf Subkonten verteilt, während die Ausführung für Sie erledigt wird." },
  ], es: [
    { type: "paragraph",html: "Operar todo desde una sola cuenta funciona bien hasta que deja de hacerlo. Quizá quiera aislar su capital de scalping del dinero de swing, o disponer de una hoja en blanco para probar un nuevo sistema sin poner en juego su saldo principal. Las subcuentas le permiten justamente eso: varias cuentas de trading totalmente independientes bajo un único inicio de sesión de Tradovate. Así puede añadirlas, alternar entre ellas y mover dinero sin tocar su banco." },
    { type: "heading",text: "¿Qué es una subcuenta de Tradovate?" },
    { type: "paragraph",html: "Una subcuenta es una cuenta de trading independiente vinculada a su inicio de sesión existente. Cada una mantiene su propio saldo, sus propias posiciones abiertas, sus propios extractos y su propia configuración de riesgo. Inicia sesión una vez y alterna entre ellas desde dentro de la plataforma, lo cual es mejor que lidiar con usuarios y contraseñas separados." },
    { type: "paragraph",html: "¿Por qué separarlo todo? Algunos motivos habituales:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Separación de estrategias</strong>, mantenga una cartera de reversión a la media y otra de tendencia en cuentas distintas para que sus P&amp;L nunca se mezclen.",
        "<strong class='text-white'>Segmentación del capital</strong>, reserve una cantidad fija para un enfoque de mayor riesgo y deje intacto el resto.",
        "<strong class='text-white'>Registros limpios</strong>, una cuenta por estrategia significa que cada extracto e informe de rendimiento ya viene ordenado.",
        "<strong class='text-white'>Pruebas</strong>, opere una idea nueva en su propia cuenta antes de escalarla a la principal.",
      ],
    },
    { type: "heading",text: "Cómo usar subcuentas en Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra la configuración de cuentas", html: "En la plataforma Tradovate, abra el menú de configuración en la esquina superior derecha. Se abre por defecto en la pestaña <strong class='text-white'>Accounts</strong>, y allí aparecen listadas las cuentas que ya tenga. Este es el punto de partida para añadir una nueva." },
        { title: "Solicite una nueva subcuenta", html: "Desde la pestaña Accounts, elija la opción de añadir una cuenta de trading o real. Rellenará los campos obligatorios y subirá los documentos que Tradovate solicita, normalmente un formulario de justificante de cuenta, un documento de identidad oficial y un comprobante de domicilio. También elegirá un perfil de riesgo de <strong class='text-white'>auto-liquidación</strong> para la nueva cuenta. Las subcuentas reales pasan por una breve aprobación, así que no espere que el saldo aparezca en el mismo segundo en que envía la solicitud. Tradovate ha permitido en general varias subcuentas por inicio de sesión, de modo que si alcanza un límite, es el tope de su plan y no un error suyo." },
        { title: "Alterne entre sus cuentas", html: "Una vez que una subcuenta está activa, el nombre de cuenta que aparece en la parte <strong class='text-white'>superior central</strong> de la plataforma se convierte en su selector. Haga clic en él y un desplegable lista todas las cuentas con las que puede operar. Elija una y los gráficos, el DOM, las órdenes y las posiciones cambian a esa cuenta. Adquiera el hábito de mirar ese nombre de cuenta antes de lanzar una orden, porque es lo más fácil de equivocar cuando se actúa deprisa." },
        { title: "Mueva fondos entre subcuentas", html: "Reequilibrar es rápido porque todo queda dentro de Tradovate. Abra <strong class='text-white'>Application Settings</strong>, busque el área <strong class='text-white'>Transfers &amp; Payments</strong> y use la transferencia interna de fondos para pasar dinero de una de sus cuentas a otra. Sin transferencia bancaria, sin retención ACH, sin esperar a un banco: los fondos llegan a la cuenta receptora casi al instante. Eso facilita reforzar una estrategia que funciona o retirar beneficios a su cuenta principal." },
        { title: "Establezca límites de riesgo por subcuenta", html: "La verdadera ventaja de separar cuentas es separar el riesgo. Abra la configuración de riesgo de cada subcuenta y asígnele su propio tamaño máximo de posición, límite de pérdida diaria y perfil de auto-liquidación. Una estrategia más ruda y experimental puede operar con la correa corta mientras su cuenta principal mantiene más margen, y un mal día en una no puede alcanzar a las demás ni vaciarlas." },
      ],
    },
    { type: "heading",text: "Una nota sobre las cuentas de prop firms" },
    { type: "paragraph",html: "Si opera con una cuenta fondeada o de evaluación, la configuración es distinta. Las cuentas de prop firms las aprovisiona la propia firma y suelen venir con un inicio de sesión separado, no como una subcuenta que usted pueda crear. No puede añadirlas ni fondearlas desde la pestaña Accounts, y el número de cuentas, las reglas de drawdown y los colchones varían según la firma y el tamaño de la cuenta, así que consulte las reglas vigentes de su firma en lugar de dar por hecho un número fijo. Las cuentas personales de Tradovate financiadas directamente son aquellas en las que usted controla las subcuentas de principio a fin." },
    { type: "heading",text: "Automatice todas las subcuentas con PickMyTrade" },
    { type: "paragraph",html: "Colocar la misma señal a mano en dos, tres o cinco cuentas es justo el tipo de clics repetitivos que conduce a errores. PickMyTrade toma una única alerta de TradingView y la envía a las cuentas de Tradovate que usted elija, cada una con su propio tamaño de contratos. Sus estrategias permanecen limpiamente repartidas entre subcuentas mientras la ejecución se realiza por usted." },
  ], fr: [
    { type: "paragraph",html: "Tout gérer depuis un seul compte fonctionne bien, jusqu'au moment où ce n'est plus le cas. Peut-être souhaitez-vous isoler votre capital de scalping de votre argent de swing, ou repartir d'une page blanche pour tester un nouveau système sans mettre votre solde principal en jeu. Les sous-comptes permettent exactement cela : plusieurs comptes de trading entièrement séparés sous une seule connexion Tradovate. Voici comment les ajouter, passer de l'un à l'autre et déplacer des fonds sans passer par votre banque." },
    { type: "heading",text: "Qu'est-ce qu'un sous-compte Tradovate ?" },
    { type: "paragraph",html: "Un sous-compte est un compte de trading autonome rattaché à votre connexion existante. Chacun conserve son propre solde, ses propres positions ouvertes, ses propres relevés et ses propres paramètres de risque. Vous vous connectez une seule fois et passez de l'un à l'autre depuis la plateforme, ce qui vaut mieux que de jongler avec des identifiants et mots de passe distincts." },
    { type: "paragraph",html: "Pourquoi séparer les choses ? Quelques raisons courantes :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Séparation des stratégies</strong>, gardez un portefeuille de retour à la moyenne et un portefeuille de tendance dans des comptes différents pour que leurs P&amp;L ne se mélangent jamais.",
        "<strong class='text-white'>Segmentation du capital</strong>, isolez un montant fixe pour une approche plus risquée et laissez le reste intact.",
        "<strong class='text-white'>Historique propre</strong>, un compte par stratégie signifie que chaque relevé et chaque rapport de performance sont déjà triés pour vous.",
        "<strong class='text-white'>Tests</strong>, tradez une nouvelle idée dans son propre compte avant de la déployer sur le compte principal.",
      ],
    },
    { type: "heading",text: "Comment utiliser les sous-comptes chez Tradovate : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir les paramètres des comptes", html: "Dans la plateforme Tradovate, ouvrez le menu des paramètres en haut à droite. Il s'ouvre par défaut sur l'onglet <strong class='text-white'>Accounts</strong>, et les comptes que vous possédez déjà y sont listés. C'est le point de départ pour en ajouter un nouveau." },
        { title: "Demander un nouveau sous-compte", html: "Depuis l'onglet Accounts, choisissez l'option d'ajout d'un compte de trading ou d'un compte réel. Vous remplirez les champs requis et téléverserez les documents demandés par Tradovate, généralement un formulaire de justificatif de compte, une pièce d'identité officielle et un justificatif de domicile. Vous choisirez également un profil de risque d'<strong class='text-white'>auto-liquidation</strong> pour le nouveau compte. Les sous-comptes réels passent par une brève approbation ; ne vous attendez donc pas à voir le solde apparaître à la seconde où vous validez. Tradovate a généralement autorisé plusieurs sous-comptes par connexion ; si vous atteignez une limite, c'est le plafond de votre formule et non une erreur de votre part." },
        { title: "Passer d'un compte à l'autre", html: "Une fois qu'un sous-compte est actif, le nom du compte affiché en <strong class='text-white'>haut au centre</strong> de la plateforme devient votre sélecteur. Cliquez dessus et une liste déroulante affiche chaque compte avec lequel vous pouvez trader. Choisissez-en un, et les graphiques, le DOM, les ordres et les positions basculent sur ce compte. Prenez l'habitude de jeter un œil à ce nom de compte avant d'envoyer un ordre, car c'est la chose la plus facile à rater quand on va vite." },
        { title: "Déplacer des fonds entre sous-comptes", html: "Le rééquilibrage est rapide car il reste dans Tradovate. Ouvrez <strong class='text-white'>Application Settings</strong>, repérez la zone <strong class='text-white'>Transfers &amp; Payments</strong> et utilisez le transfert de fonds interne pour déplacer de l'argent d'un de vos comptes vers un autre. Pas de virement, pas de blocage ACH, pas d'attente d'une banque : les fonds arrivent sur le compte destinataire presque immédiatement. Il est ainsi facile d'alimenter une stratégie qui fonctionne ou de rapatrier des profits vers votre compte principal." },
        { title: "Définir des limites de risque par sous-compte", html: "Le véritable avantage de la séparation des comptes est la séparation du risque. Ouvrez les paramètres de risque de chaque sous-compte et attribuez-lui sa propre taille de position maximale, sa propre limite de perte quotidienne et son propre profil d'auto-liquidation. Une stratégie plus brutale et expérimentale peut tourner sous bride serrée pendant que votre compte principal garde plus de marge, et une mauvaise journée sur l'un ne peut pas déborder sur les autres pour les vider." },
      ],
    },
    { type: "heading",text: "Remarque sur les comptes de prop firms" },
    { type: "paragraph",html: "Si vous tradez un compte financé ou d'évaluation, la configuration est différente. Les comptes de prop firms sont fournis par la firme et arrivent généralement avec une connexion distincte, et non comme un sous-compte que vous pouvez créer vous-même. Vous ne pouvez pas les ajouter ni les alimenter depuis l'onglet Accounts, et le nombre de comptes, les règles de drawdown et les marges varient selon la firme et la taille du compte ; vérifiez donc les règles actuelles de votre firme plutôt que de supposer un nombre fixe. Les comptes Tradovate personnels, financés directement, sont ceux pour lesquels vous contrôlez les sous-comptes de bout en bout." },
    { type: "heading",text: "Automatisez chaque sous-compte avec PickMyTrade" },
    { type: "paragraph",html: "Placer le même signal à la main dans deux, trois ou cinq comptes est exactement le genre de clics répétitifs qui mène aux erreurs. PickMyTrade prend une seule alerte TradingView et l'achemine vers les comptes Tradovate de votre choix, chacun avec sa propre taille de contrats. Vos stratégies restent proprement réparties entre les sous-comptes pendant que l'exécution se fait pour vous." },
  ], it: [
    { type: "paragraph",html: "Gestire tutto da un solo conto funziona bene finché non smette di funzionare. Forse vuole separare il capitale per lo scalping dai soldi dello swing, o avere una base pulita per testare un nuovo sistema senza mettere a rischio il saldo principale. I sotto-conti le permettono esattamente questo: più conti di trading completamente separati con un unico login Tradovate. Ecco come aggiungerli, passare dall'uno all'altro e spostare fondi senza toccare la sua banca." },
    { type: "heading",text: "Che cos'è un sotto-conto Tradovate?" },
    { type: "paragraph",html: "Un sotto-conto è un conto di trading autonomo collegato al suo login esistente. Ciascuno mantiene il proprio saldo, le proprie posizioni aperte, i propri estratti conto e le proprie impostazioni di rischio. Accede una sola volta e passa dall'uno all'altro dall'interno della piattaforma, il che è meglio che destreggiarsi tra nomi utente e password separati." },
    { type: "paragraph",html: "Perché separare le cose? Alcuni motivi comuni:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Separazione delle strategie</strong>, tenga un portafoglio mean-reversion e uno trend in conti diversi, così che i loro P&amp;L non si mescolino mai.",
        "<strong class='text-white'>Segmentazione del capitale</strong>, riservi un importo fisso a un approccio più rischioso e lasci intatto il resto.",
        "<strong class='text-white'>Registri puliti</strong>, un conto per strategia significa che ogni estratto conto e ogni report di performance sono già ordinati.",
        "<strong class='text-white'>Test</strong>, operi una nuova idea nel suo conto dedicato prima di portarla su quello principale.",
      ],
    },
    { type: "heading",text: "Come usare i sotto-conti su Tradovate: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Apra le impostazioni dei conti", html: "Nella piattaforma Tradovate, apra il menu delle impostazioni in alto a destra. Si apre per impostazione predefinita sulla scheda <strong class='text-white'>Accounts</strong>, e i conti che ha già sono elencati lì. È il punto di partenza per aggiungerne uno nuovo." },
        { title: "Richieda un nuovo sotto-conto", html: "Dalla scheda Accounts, scelga l'opzione per aggiungere un conto di trading o reale. Compilerà i campi obbligatori e caricherà i documenti richiesti da Tradovate, in genere un modulo di prova del conto, un documento d'identità ufficiale e una prova di indirizzo. Sceglierà inoltre un profilo di rischio di <strong class='text-white'>auto-liquidazione</strong> per il nuovo conto. I sotto-conti reali passano per una breve approvazione, quindi non si aspetti che il saldo compaia nello stesso istante in cui invia la richiesta. Tradovate ha generalmente consentito diversi sotto-conti per login, quindi se raggiunge un limite, è il tetto del suo piano e non un errore da parte sua." },
        { title: "Passi da un conto all'altro", html: "Una volta che un sotto-conto è attivo, il nome del conto mostrato in <strong class='text-white'>alto al centro</strong> della piattaforma diventa il suo selettore. Ci clicchi e un menu a discesa elenca ogni conto con cui può operare. Ne scelga uno, e grafici, DOM, ordini e posizioni passano a quel conto. Prenda l'abitudine di dare un'occhiata al nome del conto prima di inviare un ordine, perché è la cosa più facile da sbagliare quando si va di fretta." },
        { title: "Sposti fondi tra i sotto-conti", html: "Il ribilanciamento è rapido perché resta all'interno di Tradovate. Apra <strong class='text-white'>Application Settings</strong>, trovi l'area <strong class='text-white'>Transfers &amp; Payments</strong> e usi il trasferimento interno di fondi per spostare denaro da uno dei suoi conti a un altro. Nessun bonifico, nessun blocco ACH, nessuna attesa di una banca: i fondi arrivano sul conto ricevente quasi immediatamente. Così è facile rifornire una strategia che funziona o riportare i profitti sul conto principale." },
        { title: "Imposti limiti di rischio per ciascun sotto-conto", html: "Il vero vantaggio di separare i conti è separare il rischio. Apra le impostazioni di rischio di ogni sotto-conto e gli assegni la propria dimensione massima di posizione, il proprio limite di perdita giornaliera e il proprio profilo di auto-liquidazione. Una strategia più aggressiva e sperimentale può operare con il guinzaglio corto mentre il suo conto principale mantiene più margine, e una brutta giornata su uno non può estendersi agli altri e prosciugarli." },
      ],
    },
    { type: "heading",text: "Una nota sui conti prop firm" },
    { type: "paragraph",html: "Se opera con un conto finanziato o di valutazione, la configurazione è diversa. I conti delle prop firm sono forniti dalla società e di solito arrivano con un login separato, non come un sotto-conto che può creare da sé. Non può aggiungerli né finanziarli dalla scheda Accounts, e il numero di conti, le regole di drawdown e i buffer variano in base alla società e alla dimensione del conto, quindi verifichi le regole attuali della sua società invece di dare per scontato un numero fisso. I conti Tradovate personali, finanziati direttamente, sono quelli in cui lei controlla i sotto-conti dall'inizio alla fine." },
    { type: "heading",text: "Automatizzi ogni sotto-conto con PickMyTrade" },
    { type: "paragraph",html: "Inserire lo stesso segnale a mano in due, tre o cinque conti è esattamente il tipo di clic ripetitivo che porta a errori. PickMyTrade prende un unico alert di TradingView e lo instrada ai conti Tradovate da lei scelti, ciascuno con la propria dimensione dei contratti. Le sue strategie restano ordinatamente suddivise tra i sotto-conti mentre l'esecuzione avviene al posto suo." },
  ] },
  ctaHeading: { en: "Automate Every Subaccount at Once", de: "Automatisieren Sie jedes Subkonto gleichzeitig", es: "Automatice todas las subcuentas a la vez", fr: "Automatisez chaque sous-compte en une fois", it: "Automatizzi tutti i sotto-conti in una volta" },
  ctaText: { en: "PickMyTrade takes one TradingView alert and routes it into whichever Tradovate accounts you choose, each with its own contract sizing.", de: "PickMyTrade nimmt einen TradingView-Alert und leitet ihn an die von Ihnen gewählten Tradovate-Konten weiter, jeweils mit eigener Kontraktgröße.", es: "PickMyTrade toma una única alerta de TradingView y la envía a las cuentas de Tradovate que usted elija, cada una con su propio tamaño de contratos.", fr: "PickMyTrade prend une seule alerte TradingView et l'achemine vers les comptes Tradovate de votre choix, chacun avec sa propre taille de contrats.", it: "PickMyTrade prende un unico alert di TradingView e lo instrada ai conti Tradovate da lei scelti, ciascuno con la propria dimensione dei contratti." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "How many subaccounts can I have at Tradovate?", a: "Tradovate lets you run more than one account under a single login. There's a limit tied to your plan, so if you can't add another, you've likely reached the cap for your account type. Confirm the current number in the platform before you plan around it." },
