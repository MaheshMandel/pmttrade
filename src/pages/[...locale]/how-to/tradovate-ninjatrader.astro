---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-ninjatrader";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Connect Tradovate to NinjaTrader 8";
const META_DESCRIPTION =
  "Add a native Tradovate connection in NinjaTrader 8.1: enter your login, pick live or simulated, and confirm the green connection light in minutes.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate mit NinjaTrader 8 verbinden", es: "Conectar Tradovate a NinjaTrader 8", fr: "Connecter Tradovate à NinjaTrader 8", it: "Collegare Tradovate a NinjaTrader 8" },
  dek: { en: "Add a native Tradovate connection in NinjaTrader 8.1: enter your login, pick live or simulated, and confirm the green connection light in minutes.", de: "Fügen Sie in NinjaTrader 8.1 eine native Tradovate-Verbindung hinzu: Zugangsdaten eingeben, Live oder Simuliert wählen und in wenigen Minuten das grüne Verbindungslicht bestätigen.", es: "Añada una conexión nativa de Tradovate en NinjaTrader 8.1: introduzca sus credenciales, elija real o simulada y confirme la luz verde de conexión en minutos.", fr: "Ajoutez une connexion Tradovate native dans NinjaTrader 8.1 : saisissez vos identifiants, choisissez réel ou simulé et confirmez le voyant vert de connexion en quelques minutes.", it: "Aggiunga una connessione Tradovate nativa in NinjaTrader 8.1: inserisca le credenziali, scelga live o simulato e confermi la luce verde di connessione in pochi minuti." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "NinjaTrader owns Tradovate, so the two are built to talk to each other directly. No third-party bridge, no old Rithmic workaround. If you're on a current build, adding your Tradovate account takes about five minutes." },
    { type: "paragraph", html: "The catch most people trip on is the version. The native connection only exists in NinjaTrader 8.1 and later. On an older 8.0 build you'll hit a login error and never quite figure out why. Here's the whole setup, start to finish." },
    { type: "heading", text: "What You'll Need" },
    {
      type: "list",
      items: [
        "NinjaTrader Desktop <strong class='text-white'>8.1 or later</strong> installed",
        "Your Tradovate <strong class='text-white'>username and password</strong>, the same login you use on the Tradovate web platform. Prop-firm and data accounts usually receive these in a \"Tradovate Data Credentials\" email.",
        "Platform and market-data agreements accepted on the NinjaTrader/Tradovate welcome page",
      ],
    },
    { type: "heading", text: "Connect Tradovate to NinjaTrader 8: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Confirm You're on NinjaTrader 8.1 or Later", html: "Open NinjaTrader Desktop and go to <strong class='text-white'>Help &rsaquo; About</strong>. Read the build number. Anything that starts with 8.1 works; 8.0.xx does not include the Tradovate adapter. If you're behind, grab the current installer from your NinjaTrader account and update before you go any further." },
        { title: "Sign the Agreements on the Welcome Page", html: "Before NinjaTrader will route your data, you have to accept the platform and market-data agreements tied to your account. Log in once at the NinjaTrader/Tradovate welcome page using your Tradovate credentials, then clear any pending documents or the market-data subscriber certification. Skip this and the connection can still go green while your quotes stay dark." },
        { title: "Open Connections &rsaquo; Configure", html: "In the Control Center, open the <strong class='text-white'>Connections</strong> menu and choose <strong class='text-white'>Configure</strong>. Don't see Configure? You're in single-provider mode. Open the <strong class='text-white'>Tools</strong> menu &rsaquo; <strong class='text-white'>Options</strong> (a few builds label it Settings), find the <strong class='text-white'>General</strong> section, and switch on <strong class='text-white'>Multi-Provider</strong>. Reopen the Connections menu and Configure will be there." },
        { title: "Add the Connection and Enter Your Tradovate Login", html: "In the list of available connections, double-click <strong class='text-white'>NinjaTrader</strong> (or select it and click Add). That's the right one. Because Tradovate accounts now ride on the unified NinjaTrader–Tradovate API, the adapter is listed under NinjaTrader rather than a separate \"Tradovate\" entry. On the right, type your Tradovate <strong class='text-white'>username</strong> and <strong class='text-white'>password</strong>. Then set the environment: pick <strong class='text-white'>Live</strong> for a funded, real-money account, or <strong class='text-white'>Simulated</strong> for an evaluation or practice account. Save with <strong class='text-white'>OK</strong>." },
        { title: "Connect and Check for the Green Light", html: "Back in the Control Center, open the <strong class='text-white'>Connections</strong> menu and click your new connection by name. Give it a few seconds. A <strong class='text-white'>green status light</strong> next to the connection, and in the lower-left corner of the Control Center, means you're live. Yellow or red means it's still handshaking or something's off; recheck your password and the environment you picked first. Once it's green, your Tradovate accounts show up in the Control Center's Accounts tab, and you can trade them from a chart, the SuperDOM, or the order entry window like any other NinjaTrader connection." },
      ],
    },
    { type: "heading", text: "Trading a Prop or Evaluation Account?" },
    { type: "paragraph", html: "Position limits, allowed contracts, and daily loss rules vary by firm and account size, check your firm's current rules. NinjaTrader just enforces whatever the account is set to, so a rejected order is usually the account's risk profile talking, not the connection." },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Rather automate than sit on the ladder all day? <strong class='text-white'>PickMyTrade routes your TradingView strategy alerts straight to Tradovate</strong>, no NinjaTrader instance left running on a home PC to catch every signal." },
  ], de: [
    { type: "paragraph",html: "NinjaTrader besitzt Tradovate, daher sind die beiden darauf ausgelegt, direkt miteinander zu kommunizieren. Keine Drittanbieter-Brücke, kein altes Rithmic-Provisorium. Wenn Sie mit einem aktuellen Build arbeiten, dauert das Hinzufügen Ihres Tradovate-Kontos etwa fünf Minuten." },
    { type: "paragraph",html: "Der Haken, über den die meisten stolpern, ist die Version. Die native Verbindung gibt es nur in NinjaTrader 8.1 und neuer. Bei einem älteren 8.0-Build erhalten Sie einen Anmeldefehler und kommen nie ganz darauf, warum. Hier ist die gesamte Einrichtung von Anfang bis Ende." },
    { type: "heading",text: "Was Sie benötigen" },
    {
      type: "list",
      items: [
        "NinjaTrader Desktop <strong class='text-white'>8.1 oder neuer</strong> installiert",
        "Ihr Tradovate-<strong class='text-white'>Benutzername und Passwort</strong>, also dieselben Zugangsdaten wie auf der Tradovate-Webplattform. Prop-Firm- und Daten-Konten erhalten diese in der Regel in einer E-Mail mit „Tradovate Data Credentials“.",
        "Plattform- und Marktdaten-Vereinbarungen, die auf der NinjaTrader/Tradovate-Willkommensseite akzeptiert wurden",
      ],
    },
    { type: "heading",text: "Tradovate mit NinjaTrader 8 verbinden: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Prüfen Sie, ob Sie NinjaTrader 8.1 oder neuer verwenden", html: "Öffnen Sie NinjaTrader Desktop und gehen Sie zu <strong class='text-white'>Help &rsaquo; About</strong>. Lesen Sie die Build-Nummer ab. Alles, was mit 8.1 beginnt, funktioniert; 8.0.xx enthält den Tradovate-Adapter nicht. Wenn Sie zurückliegen, laden Sie das aktuelle Installationsprogramm aus Ihrem NinjaTrader-Konto herunter und aktualisieren Sie, bevor Sie fortfahren." },
        { title: "Vereinbarungen auf der Willkommensseite unterzeichnen", html: "Bevor NinjaTrader Ihre Daten weiterleitet, müssen Sie die mit Ihrem Konto verknüpften Plattform- und Marktdaten-Vereinbarungen akzeptieren. Melden Sie sich einmal auf der NinjaTrader/Tradovate-Willkommensseite mit Ihren Tradovate-Zugangsdaten an und erledigen Sie dann alle ausstehenden Dokumente oder die Zertifizierung als Marktdaten-Abonnent. Wenn Sie das überspringen, kann die Verbindung trotzdem grün werden, während Ihre Kurse dunkel bleiben." },
        { title: "Connections &rsaquo; Configure öffnen", html: "Öffnen Sie im Control Center das Menü <strong class='text-white'>Connections</strong> und wählen Sie <strong class='text-white'>Configure</strong>. Sehen Sie Configure nicht? Dann befinden Sie sich im Einzelanbieter-Modus. Öffnen Sie das Menü <strong class='text-white'>Tools</strong> &rsaquo; <strong class='text-white'>Options</strong> (einige Builds nennen es Settings), suchen Sie den Abschnitt <strong class='text-white'>General</strong> und aktivieren Sie <strong class='text-white'>Multi-Provider</strong>. Öffnen Sie das Menü Connections erneut, und Configure ist da." },
        { title: "Verbindung hinzufügen und Tradovate-Zugangsdaten eingeben", html: "Doppelklicken Sie in der Liste der verfügbaren Verbindungen auf <strong class='text-white'>NinjaTrader</strong> (oder wählen Sie den Eintrag aus und klicken Sie auf Add). Das ist die richtige. Da Tradovate-Konten jetzt über die einheitliche NinjaTrader-Tradovate-API laufen, ist der Adapter unter NinjaTrader aufgeführt und nicht als eigener Eintrag „Tradovate“. Geben Sie rechts Ihren Tradovate-<strong class='text-white'>Benutzernamen</strong> und Ihr <strong class='text-white'>Passwort</strong> ein. Legen Sie dann die Umgebung fest: Wählen Sie <strong class='text-white'>Live</strong> für ein finanziertes Echtgeld-Konto oder <strong class='text-white'>Simulated</strong> für ein Evaluierungs- oder Übungskonto. Speichern Sie mit <strong class='text-white'>OK</strong>." },
        { title: "Verbinden und auf das grüne Licht achten", html: "Öffnen Sie zurück im Control Center das Menü <strong class='text-white'>Connections</strong> und klicken Sie Ihre neue Verbindung mit ihrem Namen an. Warten Sie ein paar Sekunden. Ein <strong class='text-white'>grünes Statuslicht</strong> neben der Verbindung und in der unteren linken Ecke des Control Centers bedeutet, dass Sie live sind. Gelb oder Rot heißt, dass noch der Handshake läuft oder etwas nicht stimmt; prüfen Sie zuerst Ihr Passwort und die gewählte Umgebung. Sobald es grün ist, erscheinen Ihre Tradovate-Konten im Reiter Accounts des Control Centers, und Sie können sie wie jede andere NinjaTrader-Verbindung über einen Chart, das SuperDOM oder das Order-Eingabefenster handeln." },
      ],
    },
    { type: "heading",text: "Handeln Sie ein Prop- oder Evaluierungskonto?" },
    { type: "paragraph",html: "Positionslimits, erlaubte Kontrakte und tägliche Verlustregeln unterscheiden sich je nach Firma und Kontogröße; prüfen Sie die aktuellen Regeln Ihrer Firma. NinjaTrader setzt lediglich durch, was für das Konto eingestellt ist. Eine abgelehnte Order geht also meist auf das Risikoprofil des Kontos zurück, nicht auf die Verbindung." },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "Möchten Sie lieber automatisieren, als den ganzen Tag vor der Leiter zu sitzen? <strong class='text-white'>PickMyTrade leitet Ihre TradingView-Strategie-Alerts direkt an Tradovate weiter</strong>, ohne dass auf einem Heim-PC eine NinjaTrader-Instanz laufen muss, um jedes Signal aufzufangen." },
  ], es: [
    { type: "paragraph",html: "NinjaTrader es propietaria de Tradovate, así que ambas están diseñadas para comunicarse directamente. Sin puentes de terceros ni apaños antiguos con Rithmic. Si usa una versión actual, añadir su cuenta de Tradovate lleva unos cinco minutos." },
    { type: "paragraph",html: "El problema en el que tropieza la mayoría es la versión. La conexión nativa solo existe en NinjaTrader 8.1 y posteriores. En una versión 8.0 anterior obtendrá un error de inicio de sesión y no sabrá por qué. Aquí tiene toda la configuración, de principio a fin." },
    { type: "heading",text: "Qué necesitará" },
    {
      type: "list",
      items: [
        "NinjaTrader Desktop <strong class='text-white'>8.1 o posterior</strong> instalado",
        "Su <strong class='text-white'>usuario y contraseña</strong> de Tradovate, el mismo acceso que usa en la plataforma web de Tradovate. Las cuentas de prop firms y de datos suelen recibirlos en un correo titulado «Tradovate Data Credentials».",
        "Los acuerdos de plataforma y de datos de mercado aceptados en la página de bienvenida de NinjaTrader/Tradovate",
      ],
    },
    { type: "heading",text: "Conectar Tradovate a NinjaTrader 8: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Confirme que usa NinjaTrader 8.1 o posterior", html: "Abra NinjaTrader Desktop y vaya a <strong class='text-white'>Help &rsaquo; About</strong>. Lea el número de versión. Cualquier cosa que empiece por 8.1 funciona; 8.0.xx no incluye el adaptador de Tradovate. Si está desactualizado, descargue el instalador actual desde su cuenta de NinjaTrader y actualice antes de continuar." },
        { title: "Firme los acuerdos en la página de bienvenida", html: "Antes de que NinjaTrader enrute sus datos, debe aceptar los acuerdos de plataforma y de datos de mercado vinculados a su cuenta. Inicie sesión una vez en la página de bienvenida de NinjaTrader/Tradovate con sus credenciales de Tradovate y complete los documentos pendientes o la certificación de suscriptor de datos de mercado. Si se lo salta, la conexión puede ponerse en verde mientras sus cotizaciones siguen apagadas." },
        { title: "Abra Connections &rsaquo; Configure", html: "En el Control Center, abra el menú <strong class='text-white'>Connections</strong> y elija <strong class='text-white'>Configure</strong>. ¿No ve Configure? Está en modo de proveedor único. Abra el menú <strong class='text-white'>Tools</strong> &rsaquo; <strong class='text-white'>Options</strong> (algunas versiones lo llaman Settings), busque la sección <strong class='text-white'>General</strong> y active <strong class='text-white'>Multi-Provider</strong>. Vuelva a abrir el menú Connections y Configure aparecerá." },
        { title: "Añada la conexión e introduzca su acceso de Tradovate", html: "En la lista de conexiones disponibles, haga doble clic en <strong class='text-white'>NinjaTrader</strong> (o selecciónela y haga clic en Add). Esa es la correcta. Como las cuentas de Tradovate ahora funcionan con la API unificada NinjaTrader-Tradovate, el adaptador aparece bajo NinjaTrader y no como una entrada «Tradovate» independiente. A la derecha, escriba su <strong class='text-white'>usuario</strong> y su <strong class='text-white'>contraseña</strong> de Tradovate. Luego defina el entorno: elija <strong class='text-white'>Live</strong> para una cuenta fondeada con dinero real o <strong class='text-white'>Simulated</strong> para una cuenta de evaluación o de práctica. Guarde con <strong class='text-white'>OK</strong>." },
        { title: "Conecte y compruebe la luz verde", html: "De vuelta en el Control Center, abra el menú <strong class='text-white'>Connections</strong> y haga clic en su nueva conexión por su nombre. Espere unos segundos. Una <strong class='text-white'>luz de estado verde</strong> junto a la conexión y en la esquina inferior izquierda del Control Center significa que está en vivo. Amarillo o rojo significa que aún está negociando la conexión o que algo falla; revise primero su contraseña y el entorno que eligió. Una vez en verde, sus cuentas de Tradovate aparecen en la pestaña Accounts del Control Center y puede operarlas desde un gráfico, el SuperDOM o la ventana de entrada de órdenes como cualquier otra conexión de NinjaTrader." },
      ],
    },
    { type: "heading",text: "¿Opera una cuenta de prop firm o de evaluación?" },
    { type: "paragraph",html: "Los límites de posición, los contratos permitidos y las reglas de pérdida diaria varían según la firma y el tamaño de la cuenta; consulte las reglas vigentes de su firma. NinjaTrader solo aplica lo que tenga configurado la cuenta, así que una orden rechazada suele deberse al perfil de riesgo de la cuenta y no a la conexión." },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "¿Prefiere automatizar en lugar de pasar todo el día frente al ladder? <strong class='text-white'>PickMyTrade envía las alertas de su estrategia de TradingView directamente a Tradovate</strong>, sin dejar una instancia de NinjaTrader encendida en un PC doméstico para capturar cada señal." },
  ], fr: [
    { type: "paragraph",html: "NinjaTrader possède Tradovate : les deux sont donc conçus pour communiquer directement. Pas de passerelle tierce, pas de vieux contournement Rithmic. Si vous utilisez une version récente, l'ajout de votre compte Tradovate prend environ cinq minutes." },
    { type: "paragraph",html: "Le piège dans lequel tombent la plupart des utilisateurs est la version. La connexion native n'existe que dans NinjaTrader 8.1 et les versions ultérieures. Avec une ancienne version 8.0, vous obtiendrez une erreur de connexion sans jamais comprendre pourquoi. Voici toute la configuration, du début à la fin." },
    { type: "heading",text: "Ce dont vous avez besoin" },
    {
      type: "list",
      items: [
        "NinjaTrader Desktop <strong class='text-white'>8.1 ou version ultérieure</strong> installé",
        "Votre <strong class='text-white'>nom d'utilisateur et mot de passe</strong> Tradovate, les mêmes identifiants que sur la plateforme web Tradovate. Les comptes de prop firms et de données les reçoivent généralement dans un e-mail « Tradovate Data Credentials ».",
        "Les accords de plateforme et de données de marché acceptés sur la page d'accueil NinjaTrader/Tradovate",
      ],
    },
    { type: "heading",text: "Connecter Tradovate à NinjaTrader 8 : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Vérifiez que vous utilisez NinjaTrader 8.1 ou une version ultérieure", html: "Ouvrez NinjaTrader Desktop et allez dans <strong class='text-white'>Help &rsaquo; About</strong>. Lisez le numéro de version. Tout ce qui commence par 8.1 fonctionne ; la version 8.0.xx n'inclut pas l'adaptateur Tradovate. Si vous êtes en retard, téléchargez le dernier programme d'installation depuis votre compte NinjaTrader et mettez à jour avant d'aller plus loin." },
        { title: "Signez les accords sur la page d'accueil", html: "Avant que NinjaTrader n'achemine vos données, vous devez accepter les accords de plateforme et de données de marché liés à votre compte. Connectez-vous une fois sur la page d'accueil NinjaTrader/Tradovate avec vos identifiants Tradovate, puis traitez les documents en attente ou la certification d'abonné aux données de marché. Si vous l'ignorez, la connexion peut passer au vert alors que vos cotations restent éteintes." },
        { title: "Ouvrez Connections &rsaquo; Configure", html: "Dans le Control Center, ouvrez le menu <strong class='text-white'>Connections</strong> et choisissez <strong class='text-white'>Configure</strong>. Vous ne voyez pas Configure ? Vous êtes en mode fournisseur unique. Ouvrez le menu <strong class='text-white'>Tools</strong> &rsaquo; <strong class='text-white'>Options</strong> (certaines versions l'appellent Settings), repérez la section <strong class='text-white'>General</strong> et activez <strong class='text-white'>Multi-Provider</strong>. Rouvrez le menu Connections et Configure sera là." },
        { title: "Ajoutez la connexion et saisissez vos identifiants Tradovate", html: "Dans la liste des connexions disponibles, double-cliquez sur <strong class='text-white'>NinjaTrader</strong> (ou sélectionnez-la et cliquez sur Add). C'est la bonne. Comme les comptes Tradovate passent désormais par l'API unifiée NinjaTrader-Tradovate, l'adaptateur figure sous NinjaTrader plutôt que dans une entrée « Tradovate » distincte. Sur la droite, saisissez votre <strong class='text-white'>nom d'utilisateur</strong> et votre <strong class='text-white'>mot de passe</strong> Tradovate. Définissez ensuite l'environnement : choisissez <strong class='text-white'>Live</strong> pour un compte financé en argent réel, ou <strong class='text-white'>Simulated</strong> pour un compte d'évaluation ou d'entraînement. Enregistrez avec <strong class='text-white'>OK</strong>." },
        { title: "Connectez-vous et vérifiez le voyant vert", html: "De retour dans le Control Center, ouvrez le menu <strong class='text-white'>Connections</strong> et cliquez sur votre nouvelle connexion par son nom. Patientez quelques secondes. Un <strong class='text-white'>voyant d'état vert</strong> à côté de la connexion et dans le coin inférieur gauche du Control Center indique que vous êtes en direct. Jaune ou rouge signifie que la connexion est encore en cours ou que quelque chose cloche ; vérifiez d'abord votre mot de passe et l'environnement choisi. Une fois le voyant vert, vos comptes Tradovate apparaissent dans l'onglet Accounts du Control Center et vous pouvez les trader depuis un graphique, le SuperDOM ou la fenêtre de saisie d'ordres comme n'importe quelle autre connexion NinjaTrader." },
      ],
    },
    { type: "heading",text: "Vous tradez un compte prop firm ou d'évaluation ?" },
    { type: "paragraph",html: "Les limites de position, les contrats autorisés et les règles de perte quotidienne varient selon la société et la taille du compte ; consultez les règles en vigueur de votre société. NinjaTrader applique simplement ce qui est configuré sur le compte : un ordre rejeté provient donc généralement du profil de risque du compte, pas de la connexion." },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Vous préférez automatiser plutôt que de rester devant l'échelle toute la journée ? <strong class='text-white'>PickMyTrade transmet les alertes de votre stratégie TradingView directement à Tradovate</strong>, sans instance NinjaTrader laissée allumée sur un PC à la maison pour capter chaque signal." },
  ], it: [
    { type: "paragraph",html: "NinjaTrader possiede Tradovate, quindi le due piattaforme sono progettate per dialogare direttamente. Nessun ponte di terze parti, nessun vecchio ripiego con Rithmic. Se usa una build recente, aggiungere il Suo conto Tradovate richiede circa cinque minuti." },
    { type: "paragraph",html: "Il problema in cui inciampa la maggior parte degli utenti è la versione. La connessione nativa esiste solo in NinjaTrader 8.1 e successive. Su una build 8.0 meno recente riceverà un errore di accesso senza mai capirne il motivo. Ecco l'intera configurazione, dall'inizio alla fine." },
    { type: "heading",text: "Di che cosa ha bisogno" },
    {
      type: "list",
      items: [
        "NinjaTrader Desktop <strong class='text-white'>8.1 o successivo</strong> installato",
        "Il Suo <strong class='text-white'>nome utente e password</strong> Tradovate, le stesse credenziali che usa sulla piattaforma web di Tradovate. I conti prop firm e dati di solito le ricevono in un'email «Tradovate Data Credentials».",
        "Gli accordi di piattaforma e di dati di mercato accettati sulla pagina di benvenuto di NinjaTrader/Tradovate",
      ],
    },
    { type: "heading",text: "Collegare Tradovate a NinjaTrader 8: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Verifichi di usare NinjaTrader 8.1 o successivo", html: "Apra NinjaTrader Desktop e vada su <strong class='text-white'>Help &rsaquo; About</strong>. Legga il numero di build. Qualunque cosa inizi con 8.1 funziona; la 8.0.xx non include l'adattatore Tradovate. Se è indietro, scarichi l'installer attuale dal Suo account NinjaTrader e aggiorni prima di proseguire." },
        { title: "Firmi gli accordi nella pagina di benvenuto", html: "Prima che NinjaTrader instradi i Suoi dati, deve accettare gli accordi di piattaforma e di dati di mercato associati al Suo conto. Acceda una volta alla pagina di benvenuto di NinjaTrader/Tradovate con le Sue credenziali Tradovate, quindi completi i documenti in sospeso o la certificazione di abbonato ai dati di mercato. Se salta questo passaggio, la connessione può comunque diventare verde mentre le quotazioni restano spente." },
        { title: "Apra Connections &rsaquo; Configure", html: "Nel Control Center, apra il menu <strong class='text-white'>Connections</strong> e scelga <strong class='text-white'>Configure</strong>. Non vede Configure? È in modalità fornitore singolo. Apra il menu <strong class='text-white'>Tools</strong> &rsaquo; <strong class='text-white'>Options</strong> (alcune build lo chiamano Settings), trovi la sezione <strong class='text-white'>General</strong> e attivi <strong class='text-white'>Multi-Provider</strong>. Riapra il menu Connections e Configure sarà presente." },
        { title: "Aggiunga la connessione e inserisca le credenziali Tradovate", html: "Nell'elenco delle connessioni disponibili, faccia doppio clic su <strong class='text-white'>NinjaTrader</strong> (oppure lo selezioni e clicchi su Add). È quella giusta. Poiché i conti Tradovate ora passano attraverso l'API unificata NinjaTrader-Tradovate, l'adattatore è elencato sotto NinjaTrader e non come voce «Tradovate» separata. A destra, digiti il Suo <strong class='text-white'>nome utente</strong> e la Sua <strong class='text-white'>password</strong> Tradovate. Poi imposti l'ambiente: scelga <strong class='text-white'>Live</strong> per un conto finanziato con denaro reale oppure <strong class='text-white'>Simulated</strong> per un conto di valutazione o di prova. Salvi con <strong class='text-white'>OK</strong>." },
        { title: "Si connetta e controlli la luce verde", html: "Tornato nel Control Center, apra il menu <strong class='text-white'>Connections</strong> e clicchi sulla nuova connessione per nome. Attenda qualche secondo. Una <strong class='text-white'>luce di stato verde</strong> accanto alla connessione e nell'angolo in basso a sinistra del Control Center indica che è operativo. Giallo o rosso significa che la connessione è ancora in corso o che qualcosa non va; ricontrolli prima la password e l'ambiente scelto. Una volta verde, i Suoi conti Tradovate compaiono nella scheda Accounts del Control Center e può operare da un grafico, dal SuperDOM o dalla finestra di inserimento ordini come con qualsiasi altra connessione NinjaTrader." },
      ],
    },
    { type: "heading",text: "Opera con un conto prop o di valutazione?" },
    { type: "paragraph",html: "I limiti di posizione, i contratti consentiti e le regole sulla perdita giornaliera variano in base alla società e alle dimensioni del conto; verifichi le regole attuali della Sua società. NinjaTrader si limita a far rispettare ciò che è impostato sul conto, quindi un ordine rifiutato dipende di solito dal profilo di rischio del conto, non dalla connessione." },
    { type: "heading",text: "Automatizzi tutto con PickMyTrade" },
    { type: "paragraph",html: "Preferisce automatizzare piuttosto che restare davanti al ladder tutto il giorno? <strong class='text-white'>PickMyTrade instrada gli alert della Sua strategia TradingView direttamente a Tradovate</strong>, senza lasciare un'istanza di NinjaTrader accesa su un PC di casa per intercettare ogni segnale." },
  ] },
  ctaHeading: { en: "Automate Your Tradovate Trades", de: "Automatisieren Sie Ihre Tradovate-Trades", es: "Automatice sus operaciones en Tradovate", fr: "Automatisez vos trades Tradovate", it: "Automatizzi i Suoi trade su Tradovate" },
  ctaText: { en: "Skip the always-on NinjaTrader instance. PickMyTrade routes your TradingView strategy alerts straight to Tradovate.", de: "Verzichten Sie auf die ständig laufende NinjaTrader-Instanz. PickMyTrade leitet Ihre TradingView-Strategie-Alerts direkt an Tradovate weiter.", es: "Olvídese de mantener NinjaTrader siempre encendido. PickMyTrade envía las alertas de su estrategia de TradingView directamente a Tradovate.", fr: "Oubliez l'instance NinjaTrader toujours allumée. PickMyTrade transmet les alertes de votre stratégie TradingView directement à Tradovate.", it: "Rinunci all'istanza di NinjaTrader sempre accesa. PickMyTrade instrada gli alert della Sua strategia TradingView direttamente a Tradovate." },
