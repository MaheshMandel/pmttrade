---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-windows-smartscreen";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Install Tradovate Past Windows SmartScreen";
const META_DESCRIPTION =
  "SmartScreen blocking the Tradovate desktop app? Click More info, then Run anyway to install past the Windows warning safely, step by step.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate trotz Windows SmartScreen installieren", es: "Instale Tradovate superando Windows SmartScreen", fr: "Installer Tradovate malgré Windows SmartScreen", it: "Installare Tradovate superando Windows SmartScreen" },
  dek: { en: "Windows threw up a blue box saying it \"protected your PC\"? Nothing's broken, and you didn't download a virus. Two clicks get you through it, here's the exact path.", de: "Windows zeigt ein blaues Fenster mit der Meldung, es habe Ihren PC „geschützt“? Nichts ist kaputt, und Sie haben keinen Virus heruntergeladen. Zwei Klicks bringen Sie durch, hier ist der genaue Weg.", es: "¿Windows le ha mostrado un cuadro azul diciendo que «protegió su PC»? No se ha roto nada y no ha descargado ningún virus. Dos clics bastan para continuar; aquí tiene el camino exacto.", fr: "Windows affiche une fenêtre bleue indiquant qu'il a « protégé votre PC » ? Rien n'est cassé et vous n'avez pas téléchargé de virus. Deux clics suffisent pour passer, voici le chemin exact.", it: "Windows Le ha mostrato una finestra blu con scritto che ha «protetto il Suo PC»? Non è rotto nulla e non ha scaricato alcun virus. Bastano due clic per proseguire: ecco il percorso esatto." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You grabbed the Tradovate desktop app, double-clicked the installer, and Windows threw up a blue box saying it \"protected your PC.\" Nothing's broken, and you didn't download a virus. That's Microsoft Defender SmartScreen doing its job on a file it hasn't seen many times yet. Two clicks get you through it. Here's the exact path, plus a cleaner way to clear the flag before you even launch the file." },
    { type: "heading", text: "Why Windows Flags the Installer" },
    { type: "paragraph", html: "SmartScreen weighs two things before it lets a downloaded file run: whether the file is signed by a publisher Windows already trusts, and how often that exact file has been downloaded and run cleanly by other people. A fresh installer, or a new version of one, starts with little of that download history, so Windows shows the \"unrecognized app\" prompt even when the software is perfectly legitimate. The warning fades on its own as more people install the same file. There's one check SmartScreen can't do for you, though: make sure you actually pulled the installer from the official Tradovate site and not some random mirror before you wave it through." },
    { type: "heading", text: "Get Past SmartScreen in Four Clicks" },
    {
      type: "steps",
      items: [
        { title: "Download From the Official Source", html: "Get the Windows installer straight from Tradovate's own download page (download.tradovate.com) or the Devices page on tradovate.com. Save it somewhere easy to find, like your Downloads folder. Sourcing the file from the official site is the one security check that genuinely matters here, so don't skip it." },
        { title: "Run It and Let the Warning Appear", html: "Double-click the downloaded .exe. Instead of the setup wizard, you'll get a blue window headed \"Windows protected your PC\" (some builds word it \"Microsoft Defender SmartScreen prevented an unrecognized app from starting\"). At first the only button is \"Don't run\", that's expected, and it's exactly why people assume they're stuck." },
        { title: "Click \"More Info\"", html: "Look for the small \"More info\" link inside that same box, usually just under the message text. Click it. The window expands to show the app name and, if the file is signed, the publisher, and a new button drops in at the bottom." },
        { title: "Click \"Run Anyway\"", html: "Click \"Run anyway.\" SmartScreen steps aside and the normal Tradovate installer opens, accept the prompts and finish the install like any other program. You'll only meet this warning on the installer itself; once the app is on your machine, launching it day to day doesn't trigger the prompt again." },
      ],
    },
    { type: "heading", text: "Prefer to Unblock the File First?" },
    { type: "paragraph", html: "If you'd rather not stare down a warning at all, clear the flag before you launch:" },
    {
      type: "list",
      items: [
        "Right-click the downloaded installer and choose <strong class='text-white'>Properties</strong>.",
        "On the <strong class='text-white'>General</strong> tab, look near the bottom for a Security line with an <strong class='text-white'>Unblock</strong> checkbox.",
        "Tick <strong class='text-white'>Unblock</strong>, click <strong class='text-white'>Apply</strong>, then <strong class='text-white'>OK</strong>.",
        "Double-click the installer, it now runs without the SmartScreen prompt.",
      ],
    },
    { type: "paragraph", html: "That checkbox only appears on files Windows tagged as downloaded from the internet. If you don't see it, the file has already been cleared and you can just run it." },
    { type: "heading", text: "Still Won't Run?" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>No \"Run anyway\" button, only \"Don't run\"</strong>, a Windows administrator or company policy may have locked SmartScreen down. This is common on work laptops and prop-firm-managed machines, and you'll need the admin to allow the app or you'll have to install on a personal PC.",
        "<strong class='text-white'>Windows 11 blocks it outright</strong>, the newer Smart App Control feature can refuse unsigned apps even after Run anyway. If it's on, you can turn it off in Windows Security, though that resets it into evaluation mode.",
        "<strong class='text-white'>Your antivirus quarantined the file</strong>, open your antivirus quarantine and restore or allow the installer, but only if you're certain it came from the official source.",
      ],
    },
    { type: "paragraph", html: "Would rather skip the desktop install entirely? Tradovate also runs in any modern browser, and plenty of traders never touch the desktop app because they automate their fills instead. If you're routing TradingView alerts to Tradovate, PickMyTrade handles execution for you, no local software babysitting required." },
    { type: "heading", text: "Automate Your Tradovate Trades" },
    { type: "paragraph", html: "Automate your Tradovate trades with PickMyTrade and skip the local software babysitting altogether." },
  ], de: [
    { type: "paragraph",html: "Sie haben die Tradovate-Desktop-App heruntergeladen, den Installer doppelt angeklickt, und Windows zeigt ein blaues Fenster mit dem Hinweis, es habe Ihren PC „geschützt“. Nichts ist kaputt, und Sie haben keinen Virus heruntergeladen. Das ist Microsoft Defender SmartScreen, der bei einer Datei seinen Job macht, die er noch nicht oft gesehen hat. Zwei Klicks bringen Sie hindurch. Hier ist der genaue Weg, dazu eine sauberere Methode, die Markierung zu entfernen, noch bevor Sie die Datei starten." },
    { type: "heading",text: "Warum Windows den Installer markiert" },
    { type: "paragraph",html: "SmartScreen wägt zwei Dinge ab, bevor es eine heruntergeladene Datei ausführen lässt: ob die Datei von einem Herausgeber signiert ist, dem Windows bereits vertraut, und wie oft genau diese Datei von anderen Nutzern heruntergeladen und problemlos ausgeführt wurde. Ein frischer Installer oder eine neue Version davon hat noch wenig solche Download-Historie, daher zeigt Windows die Meldung „unbekannte App“, selbst wenn die Software völlig legitim ist. Die Warnung verschwindet von selbst, sobald mehr Personen dieselbe Datei installieren. Eine Prüfung kann SmartScreen Ihnen allerdings nicht abnehmen: Stellen Sie sicher, dass Sie den Installer tatsächlich von der offiziellen Tradovate-Website bezogen haben und nicht von irgendeinem Spiegelserver, bevor Sie ihn durchwinken." },
    { type: "heading",text: "SmartScreen in vier Klicks überwinden" },
    {
      type: "steps",
      items: [
        { title: "Von der offiziellen Quelle herunterladen", html: "Laden Sie den Windows-Installer direkt von der Download-Seite von Tradovate (download.tradovate.com) oder von der Seite „Devices“ auf tradovate.com herunter. Speichern Sie ihn an einem leicht auffindbaren Ort, etwa in Ihrem Downloads-Ordner. Die Beschaffung der Datei von der offiziellen Website ist die eine Sicherheitsprüfung, auf die es hier wirklich ankommt, überspringen Sie sie also nicht." },
        { title: "Ausführen und die Warnung erscheinen lassen", html: "Doppelklicken Sie auf die heruntergeladene .exe-Datei. Statt des Setup-Assistenten erscheint ein blaues Fenster mit der Überschrift „Windows protected your PC“ (manche Builds formulieren es „Microsoft Defender SmartScreen prevented an unrecognized app from starting“). Zunächst ist die einzige Schaltfläche „Don't run“, das ist zu erwarten und der Grund, warum viele glauben, sie säßen fest." },
        { title: "Auf „More info“ klicken", html: "Suchen Sie im selben Fenster nach dem kleinen Link „More info“, meist direkt unter dem Meldungstext. Klicken Sie darauf. Das Fenster erweitert sich und zeigt den App-Namen und, falls die Datei signiert ist, den Herausgeber, und unten erscheint eine neue Schaltfläche." },
        { title: "Auf „Run anyway“ klicken", html: "Klicken Sie auf „Run anyway“. SmartScreen tritt beiseite und der normale Tradovate-Installer öffnet sich. Bestätigen Sie die Eingabeaufforderungen und schließen Sie die Installation wie bei jedem anderen Programm ab. Diese Warnung begegnet Ihnen nur beim Installer selbst; sobald die App auf Ihrem Rechner ist, löst der tägliche Start sie nicht erneut aus." },
      ],
    },
    { type: "heading",text: "Lieber die Datei zuerst entsperren?" },
    { type: "paragraph",html: "Wenn Sie sich gar nicht erst mit einer Warnung auseinandersetzen möchten, entfernen Sie die Markierung vor dem Start:" },
    {
      type: "list",
      items: [
        "Klicken Sie mit der rechten Maustaste auf den heruntergeladenen Installer und wählen Sie <strong class='text-white'>Properties</strong>.",
        "Suchen Sie auf der Registerkarte <strong class='text-white'>General</strong> weiter unten nach einer Zeile „Security“ mit dem Kontrollkästchen <strong class='text-white'>Unblock</strong>.",
        "Aktivieren Sie <strong class='text-white'>Unblock</strong>, klicken Sie auf <strong class='text-white'>Apply</strong> und dann auf <strong class='text-white'>OK</strong>.",
        "Doppelklicken Sie auf den Installer, er läuft nun ohne die SmartScreen-Meldung.",
      ],
    },
    { type: "paragraph",html: "Dieses Kontrollkästchen erscheint nur bei Dateien, die Windows als aus dem Internet heruntergeladen gekennzeichnet hat. Sehen Sie es nicht, wurde die Datei bereits freigegeben, und Sie können sie einfach ausführen." },
    { type: "heading",text: "Läuft es immer noch nicht?" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Keine Schaltfläche „Run anyway“, nur „Don't run“</strong>: Ein Windows-Administrator oder eine Unternehmensrichtlinie hat SmartScreen möglicherweise gesperrt. Das ist auf Arbeitslaptops und von Prop-Firmen verwalteten Rechnern üblich; der Administrator muss die App zulassen, oder Sie müssen auf einem privaten PC installieren.",
        "<strong class='text-white'>Windows 11 blockiert die Datei komplett</strong>: Die neuere Funktion Smart App Control kann unsignierte Apps selbst nach „Run anyway“ ablehnen. Ist sie aktiv, können Sie sie in der Windows-Sicherheit ausschalten, was sie jedoch in den Evaluierungsmodus zurücksetzt.",
        "<strong class='text-white'>Ihr Virenschutz hat die Datei unter Quarantäne gestellt</strong>: Öffnen Sie die Quarantäne Ihres Virenschutzes und stellen Sie den Installer wieder her oder erlauben Sie ihn, aber nur, wenn Sie sicher sind, dass er von der offiziellen Quelle stammt.",
      ],
    },
    { type: "paragraph",html: "Möchten Sie die Desktop-Installation ganz überspringen? Tradovate läuft auch in jedem modernen Browser, und viele Trader fassen die Desktop-App nie an, weil sie ihre Orders automatisieren. Wenn Sie TradingView-Alerts an Tradovate weiterleiten, übernimmt PickMyTrade die Ausführung für Sie, ganz ohne lokale Software, die Sie betreuen müssten." },
    { type: "heading",text: "Automatisieren Sie Ihre Tradovate-Trades" },
    { type: "paragraph",html: "Automatisieren Sie Ihre Tradovate-Trades mit PickMyTrade und verzichten Sie ganz auf die Betreuung lokaler Software." },
  ], es: [
    { type: "paragraph",html: "Ha descargado la aplicación de escritorio de Tradovate, ha hecho doble clic en el instalador y Windows le ha mostrado un cuadro azul diciendo que «protegió su PC». No se ha roto nada y no ha descargado ningún virus. Es Microsoft Defender SmartScreen haciendo su trabajo con un archivo que todavía no ha visto muchas veces. Dos clics bastan para continuar. Aquí tiene el camino exacto, además de una forma más limpia de quitar la marca antes de ejecutar el archivo." },
    { type: "heading",text: "Por qué Windows marca el instalador" },
    { type: "paragraph",html: "SmartScreen sopesa dos cosas antes de dejar ejecutar un archivo descargado: si el archivo está firmado por un editor en el que Windows ya confía y con qué frecuencia otras personas han descargado y ejecutado ese mismo archivo sin problemas. Un instalador nuevo, o una versión nueva de uno, parte con poco de ese historial de descargas, por lo que Windows muestra el aviso de «aplicación no reconocida» aunque el software sea perfectamente legítimo. La advertencia se desvanece sola a medida que más personas instalan el mismo archivo. Hay, sin embargo, una comprobación que SmartScreen no puede hacer por usted: asegúrese de haber descargado el instalador del sitio oficial de Tradovate y no de un espejo cualquiera antes de darle paso." },
    { type: "heading",text: "Supere SmartScreen en cuatro clics" },
    {
      type: "steps",
      items: [
        { title: "Descargue desde la fuente oficial", html: "Obtenga el instalador de Windows directamente de la página de descargas de Tradovate (download.tradovate.com) o de la página Devices de tradovate.com. Guárdelo en un lugar fácil de encontrar, como su carpeta de Descargas. Obtener el archivo del sitio oficial es la única comprobación de seguridad que realmente importa aquí, así que no se la salte." },
        { title: "Ejecútelo y deje que aparezca la advertencia", html: "Haga doble clic en el .exe descargado. En lugar del asistente de instalación, verá una ventana azul con el encabezado «Windows protected your PC» (algunas compilaciones lo formulan como «Microsoft Defender SmartScreen prevented an unrecognized app from starting»). Al principio el único botón es «Don't run»; es lo esperado y es justo por lo que mucha gente cree que se ha quedado atascada." },
        { title: "Haga clic en «More info»", html: "Busque el pequeño enlace «More info» dentro de esa misma ventana, normalmente justo debajo del texto del mensaje. Haga clic en él. La ventana se amplía para mostrar el nombre de la aplicación y, si el archivo está firmado, el editor, y aparece un nuevo botón en la parte inferior." },
        { title: "Haga clic en «Run anyway»", html: "Haga clic en «Run anyway». SmartScreen se aparta y se abre el instalador normal de Tradovate; acepte los avisos y termine la instalación como con cualquier otro programa. Solo encontrará esta advertencia en el instalador; una vez que la aplicación está en su equipo, abrirla a diario no vuelve a activarla." },
      ],
    },
    { type: "heading",text: "¿Prefiere desbloquear el archivo primero?" },
    { type: "paragraph",html: "Si prefiere no enfrentarse a ninguna advertencia, quite la marca antes de ejecutarlo:" },
    {
      type: "list",
      items: [
        "Haga clic con el botón derecho en el instalador descargado y elija <strong class='text-white'>Properties</strong>.",
        "En la pestaña <strong class='text-white'>General</strong>, busque cerca de la parte inferior una línea Security con una casilla <strong class='text-white'>Unblock</strong>.",
        "Marque <strong class='text-white'>Unblock</strong>, haga clic en <strong class='text-white'>Apply</strong> y luego en <strong class='text-white'>OK</strong>.",
        "Haga doble clic en el instalador; ahora se ejecuta sin el aviso de SmartScreen.",
      ],
    },
    { type: "paragraph",html: "Esa casilla solo aparece en archivos que Windows ha etiquetado como descargados de internet. Si no la ve, el archivo ya ha sido autorizado y puede ejecutarlo directamente." },
    { type: "heading",text: "¿Sigue sin ejecutarse?" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>No hay botón «Run anyway», solo «Don't run»</strong>: es posible que un administrador de Windows o una política de empresa haya bloqueado SmartScreen. Es habitual en portátiles de trabajo y en equipos gestionados por prop firms; necesitará que el administrador permita la aplicación o tendrá que instalarla en un PC personal.",
        "<strong class='text-white'>Windows 11 lo bloquea por completo</strong>: la función más reciente, Smart App Control, puede rechazar aplicaciones sin firmar incluso después de «Run anyway». Si está activada, puede desactivarla en Seguridad de Windows, aunque eso la devuelve al modo de evaluación.",
        "<strong class='text-white'>Su antivirus puso el archivo en cuarentena</strong>: abra la cuarentena de su antivirus y restaure o permita el instalador, pero solo si está seguro de que procede de la fuente oficial.",
      ],
    },
    { type: "paragraph",html: "¿Prefiere evitar por completo la instalación de escritorio? Tradovate también funciona en cualquier navegador moderno, y muchos traders nunca abren la aplicación de escritorio porque automatizan sus ejecuciones. Si envía alertas de TradingView a Tradovate, PickMyTrade se encarga de la ejecución por usted, sin software local que vigilar." },
    { type: "heading",text: "Automatice sus operaciones de Tradovate" },
    { type: "paragraph",html: "Automatice sus operaciones de Tradovate con PickMyTrade y olvídese por completo de vigilar el software local." },
  ], fr: [
    { type: "paragraph",html: "Vous avez téléchargé l'application de bureau Tradovate, double-cliqué sur l'installateur, et Windows a affiché une fenêtre bleue indiquant qu'il a « protégé votre PC ». Rien n'est cassé et vous n'avez pas téléchargé de virus. C'est Microsoft Defender SmartScreen qui fait son travail sur un fichier qu'il n'a pas encore beaucoup vu. Deux clics suffisent pour passer. Voici le chemin exact, ainsi qu'une méthode plus propre pour lever le blocage avant même de lancer le fichier." },
    { type: "heading",text: "Pourquoi Windows signale l'installateur" },
    { type: "paragraph",html: "SmartScreen évalue deux éléments avant d'autoriser l'exécution d'un fichier téléchargé : si le fichier est signé par un éditeur auquel Windows fait déjà confiance, et combien de fois ce fichier précis a été téléchargé puis exécuté sans incident par d'autres personnes. Un installateur récent, ou une nouvelle version, dispose de peu d'historique de téléchargement ; Windows affiche donc l'invite « application non reconnue » même lorsque le logiciel est parfaitement légitime. L'avertissement s'estompe de lui-même à mesure que davantage de personnes installent le même fichier. Il y a toutefois une vérification que SmartScreen ne peut pas faire à votre place : assurez-vous d'avoir bien récupéré l'installateur sur le site officiel de Tradovate et non sur un site miroir quelconque avant de le laisser passer." },
    { type: "heading",text: "Passer SmartScreen en quatre clics" },
    {
      type: "steps",
      items: [
        { title: "Télécharger depuis la source officielle", html: "Récupérez l'installateur Windows directement sur la page de téléchargement de Tradovate (download.tradovate.com) ou sur la page Devices de tradovate.com. Enregistrez-le dans un endroit facile à retrouver, comme votre dossier Téléchargements. Obtenir le fichier depuis le site officiel est la seule vérification de sécurité qui compte vraiment ici, ne la sautez donc pas." },
        { title: "L'exécuter et laisser l'avertissement apparaître", html: "Double-cliquez sur le fichier .exe téléchargé. Au lieu de l'assistant d'installation, vous verrez une fenêtre bleue intitulée « Windows protected your PC » (certaines versions affichent « Microsoft Defender SmartScreen prevented an unrecognized app from starting »). Au départ, le seul bouton est « Don't run » ; c'est normal, et c'est précisément pourquoi beaucoup de gens se croient bloqués." },
        { title: "Cliquer sur « More info »", html: "Repérez le petit lien « More info » dans cette même fenêtre, en général juste sous le texte du message. Cliquez dessus. La fenêtre s'agrandit pour afficher le nom de l'application et, si le fichier est signé, l'éditeur, et un nouveau bouton apparaît en bas." },
        { title: "Cliquer sur « Run anyway »", html: "Cliquez sur « Run anyway ». SmartScreen s'efface et l'installateur Tradovate habituel s'ouvre ; acceptez les invites et terminez l'installation comme n'importe quel autre programme. Vous ne rencontrerez cet avertissement que sur l'installateur lui-même ; une fois l'application installée, son lancement quotidien ne le redéclenche pas." },
      ],
    },
    { type: "heading",text: "Vous préférez débloquer le fichier d'abord ?" },
    { type: "paragraph",html: "Si vous préférez ne pas affronter d'avertissement du tout, levez le blocage avant de lancer le fichier :" },
    {
      type: "list",
      items: [
        "Faites un clic droit sur l'installateur téléchargé et choisissez <strong class='text-white'>Properties</strong>.",
        "Dans l'onglet <strong class='text-white'>General</strong>, cherchez vers le bas une ligne Security avec une case <strong class='text-white'>Unblock</strong>.",
        "Cochez <strong class='text-white'>Unblock</strong>, cliquez sur <strong class='text-white'>Apply</strong>, puis sur <strong class='text-white'>OK</strong>.",
        "Double-cliquez sur l'installateur : il s'exécute désormais sans l'invite SmartScreen.",
      ],
    },
    { type: "paragraph",html: "Cette case n'apparaît que sur les fichiers que Windows a marqués comme téléchargés depuis Internet. Si vous ne la voyez pas, le fichier a déjà été autorisé et vous pouvez simplement l'exécuter." },
    { type: "heading",text: "Ça ne s'exécute toujours pas ?" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Pas de bouton « Run anyway », seulement « Don't run »</strong> : un administrateur Windows ou une politique d'entreprise a peut-être verrouillé SmartScreen. C'est fréquent sur les ordinateurs professionnels et les machines gérées par une prop firm ; il faudra que l'administrateur autorise l'application, ou que vous l'installiez sur un PC personnel.",
        "<strong class='text-white'>Windows 11 le bloque purement et simplement</strong> : la fonction plus récente Smart App Control peut refuser les applications non signées même après « Run anyway ». Si elle est activée, vous pouvez la désactiver dans Sécurité Windows, mais elle repasse alors en mode d'évaluation.",
        "<strong class='text-white'>Votre antivirus a mis le fichier en quarantaine</strong> : ouvrez la quarantaine de votre antivirus et restaurez ou autorisez l'installateur, mais seulement si vous êtes certain qu'il provient de la source officielle.",
      ],
    },
    { type: "paragraph",html: "Vous préférez éviter complètement l'installation de bureau ? Tradovate fonctionne aussi dans n'importe quel navigateur moderne, et de nombreux traders n'ouvrent jamais l'application de bureau parce qu'ils automatisent leurs exécutions. Si vous acheminez des alertes TradingView vers Tradovate, PickMyTrade s'occupe de l'exécution pour vous, sans aucun logiciel local à surveiller." },
    { type: "heading",text: "Automatisez vos trades Tradovate" },
    { type: "paragraph",html: "Automatisez vos trades Tradovate avec PickMyTrade et dites adieu à la surveillance des logiciels locaux." },
  ], it: [
    { type: "paragraph",html: "Ha scaricato l'app desktop di Tradovate, ha fatto doppio clic sull'installer e Windows Le ha mostrato una finestra blu con scritto che ha «protetto il Suo PC». Non è rotto nulla e non ha scaricato alcun virus. È Microsoft Defender SmartScreen che fa il proprio lavoro su un file che non ha ancora visto molte volte. Bastano due clic per proseguire. Ecco il percorso esatto, più un modo più pulito per rimuovere il blocco ancora prima di avviare il file." },
    { type: "heading",text: "Perché Windows segnala l'installer" },
    { type: "paragraph",html: "SmartScreen valuta due elementi prima di consentire l'esecuzione di un file scaricato: se il file è firmato da un editore di cui Windows si fida già e quante volte quel preciso file è stato scaricato ed eseguito senza problemi da altre persone. Un installer nuovo, o una nuova versione, parte con poca cronologia di download, quindi Windows mostra l'avviso di «app non riconosciuta» anche quando il software è perfettamente legittimo. L'avviso svanisce da solo man mano che più persone installano lo stesso file. C'è però un controllo che SmartScreen non può fare al Suo posto: si assicuri di aver scaricato l'installer dal sito ufficiale di Tradovate e non da un mirror qualsiasi prima di lasciarlo passare." },
    { type: "heading",text: "Superi SmartScreen in quattro clic" },
    {
      type: "steps",
      items: [
