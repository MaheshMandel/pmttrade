---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-fibonacci-levels";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Customize Fibonacci Levels on Tradovate Charts";
const META_DESCRIPTION =
  "Add, edit, and toggle custom Fibonacci retracement and extension levels on your futures charts, then set your own ratios and colors as the default.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Fibonacci-Levels in Tradovate-Charts anpassen", es: "Personalice los niveles de Fibonacci en los gráficos de Tradovate", fr: "Personnaliser les niveaux de Fibonacci sur les graphiques Tradovate", it: "Personalizzare i livelli di Fibonacci sui grafici Tradovate" },
  dek: { en: "A Fibonacci retracement is only as useful as the levels sitting on it. Here's how to add and edit custom Fibonacci levels on Tradovate charts, step by step.", de: "Ein Fibonacci-Retracement ist nur so nützlich wie die Levels, die darauf liegen. Hier erfahren Sie Schritt für Schritt, wie Sie benutzerdefinierte Fibonacci-Levels in Tradovate-Charts hinzufügen und bearbeiten.", es: "Un retroceso de Fibonacci es tan útil como los niveles que contiene. Aquí le explicamos paso a paso cómo agregar y editar niveles de Fibonacci personalizados en los gráficos de Tradovate.", fr: "Un retracement de Fibonacci n'est utile que par les niveaux qu'il porte. Voici, étape par étape, comment ajouter et modifier des niveaux de Fibonacci personnalisés sur les graphiques Tradovate.", it: "Un ritracciamento di Fibonacci è utile quanto i livelli che contiene. Ecco come aggiungere e modificare livelli di Fibonacci personalizzati sui grafici Tradovate, passo dopo passo." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-10",
  blocks: { en: [
    { type: "paragraph", html: "A Fibonacci retracement is only as useful as the levels sitting on it. Maybe you trade the 50% and 61.8% and nothing else, or you want the 78.6% plus a couple of extension targets above the swing. Tradovate lets you set all of that on the chart. Pick the tool, draw it across a move, then open its settings and dial the ratios in the way you actually trade them. Here's how to add and edit custom Fibonacci levels, and how to squeeze extension targets out of the same tool." },
    { type: "heading", text: "How Fibonacci Works on Tradovate Charts" },
    { type: "paragraph", html: "Tradovate has a <strong class='text-white'>Fibonacci Retracement</strong> tool built into the chart's drawing menu, the same place your trendlines and rectangles live. Draw it across a swing and it plots the standard retracement ratios between your two anchors: the familiar 23.6%, 38.2%, 50%, 61.8%, and 78.6% band, bracketed by 0% and 100%. The extension ratios that project past the swing, <strong class='text-white'>161.8%</strong> and <strong class='text-white'>261.8%</strong>, ship with the tool too but start switched off. There's no separate \"Fibonacci Extension\" tool to hunt for; you turn those higher levels on in the retracement tool's own settings and it doubles as an extension tool. Every level is a line you can recolor, hide, or edit outright." },
    { type: "heading", text: "Customize Fibonacci Levels on Tradovate: Step by Step" },
    {
      type: "steps",
      items: [
        { title: "Open the Fibonacci Tool", html: "Hover your cursor over the chart so the toolbars fade in along the <strong class='text-white'>upper-left</strong> edge, then click the <strong class='text-white'>Drawing Tools</strong> icon on that vertical strip. The tool menu pops out to the side. Left-click <strong class='text-white'>Fibonacci Retracement</strong> once to arm it. The tool is now active and waiting for your first click on the chart." },
        { title: "Draw It Across the Swing", html: "<strong class='text-white'>Left-click once</strong> on one end of the move, say the swing low, then move the cursor to the other end and <strong class='text-white'>left-click again</strong> on the swing high to drop the retracement. Two clean clicks, not a click-and-drag; a drag just pans the chart. Draw low-to-high in an uptrend and high-to-low in a downtrend, and the levels orient to that direction." },
        { title: "Open the Drawing's Settings", html: "With the fib on the chart, open its settings to get at the levels. <strong class='text-white'>Double-click</strong> the drawing (or <strong class='text-white'>right-click</strong> it and choose <strong class='text-white'>Settings</strong>) and a properties panel opens with the level list and the style controls. If a double-click doesn't do it, right-click the object and look for a Settings or Properties option." },
        { title: "Add, Edit, and Toggle Levels", html: "This is where you make it yours. Each level has a checkbox, a percentage value, and a color. Untick the ratios you don't trade; plenty of people run 38.2, 50, and 61.8 and clear the rest. Tick on the <strong class='text-white'>161.8%</strong> and <strong class='text-white'>261.8%</strong> extension levels when you want targets projected past the swing. To change a ratio, click its value and type a new one; to change how it reads, set the level and label colors. The tool caps how many custom levels you can stack, but there's room for the full standard set plus a couple of extensions." },
        { title: "Save Your Set as the Default", html: "Once your level set looks right, save it so you don't rebuild it on every chart. In the same settings panel, turn on <strong class='text-white'>Save As Default</strong> (some builds label it as applying to all drawings of this type). Every new Fibonacci you draw then comes out with your ratios, colors, and extensions already on, so you draw and go." },
      ],
    },
    { type: "quote", html: "<strong>Extension heads-up:</strong> the 161.8% and 261.8% levels project off the same two anchors you clicked. If a target lands somewhere odd, flip the draw direction, which flips where those higher levels point." },
    { type: "heading", text: "Why This Matters" },
    {
      type: "list",
      items: [
        "Trade only the levels you actually use, so your chart isn't a ladder of noise.",
        "Turn on 161.8% and 261.8% to get extension targets without a second tool.",
        "Recolor levels so your entry zone and your target zone read at a glance.",
        "Save your set as default and stop rebuilding the same fib chart after chart.",
      ],
    },
    { type: "heading", text: "Automate the Trade Off Your Fibonacci Levels" },
    { type: "paragraph", html: "Marking the level is the planning. Acting on it the second price tags it is the hard part. PickMyTrade turns your TradingView alerts into live Tradovate orders automatically, so when price hits the 61.8% you mapped, the order is already working instead of waiting on your click." },
  ], de: [
    { type: "paragraph",html: "Ein Fibonacci-Retracement ist nur so nützlich wie die Levels, die darauf liegen. Vielleicht handeln Sie nur die 50% und 61.8%, oder Sie möchten die 78.6% plus ein paar Extension-Ziele oberhalb des Swings. Tradovate lässt Sie all das im Chart festlegen. Wählen Sie das Werkzeug, zeichnen Sie es über eine Bewegung, öffnen Sie dann seine Einstellungen und stellen Sie die Verhältnisse so ein, wie Sie sie tatsächlich handeln. Hier erfahren Sie, wie Sie benutzerdefinierte Fibonacci-Levels hinzufügen und bearbeiten und wie Sie mit demselben Werkzeug Extension-Ziele erhalten." },
    { type: "heading",text: "So funktioniert Fibonacci in Tradovate-Charts" },
    { type: "paragraph",html: "Tradovate hat ein Werkzeug <strong class='text-white'>Fibonacci Retracement</strong> im Zeichenmenü des Charts, an derselben Stelle, an der Ihre Trendlinien und Rechtecke liegen. Zeichnen Sie es über einen Swing, und es trägt die üblichen Retracement-Verhältnisse zwischen Ihren beiden Ankern ein: das vertraute Band aus 23.6%, 38.2%, 50%, 61.8% und 78.6%, eingefasst von 0% und 100%. Die Extension-Verhältnisse, die über den Swing hinaus projizieren, <strong class='text-white'>161.8%</strong> und <strong class='text-white'>261.8%</strong>, sind ebenfalls im Werkzeug enthalten, aber zunächst ausgeschaltet. Es gibt kein separates Werkzeug „Fibonacci Extension“, das Sie suchen müssten; Sie schalten diese höheren Levels in den eigenen Einstellungen des Retracement-Werkzeugs ein, und es dient zugleich als Extension-Werkzeug. Jedes Level ist eine Linie, die Sie umfärben, ausblenden oder direkt bearbeiten können." },
    { type: "heading",text: "Fibonacci-Levels in Tradovate anpassen: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Öffnen Sie das Fibonacci-Werkzeug", html: "Bewegen Sie den Cursor über den Chart, damit die Symbolleisten am <strong class='text-white'>oberen linken</strong> Rand eingeblendet werden, und klicken Sie dann in dieser vertikalen Leiste auf das Symbol <strong class='text-white'>Drawing Tools</strong>. Das Werkzeugmenü klappt seitlich auf. Klicken Sie einmal mit der linken Maustaste auf <strong class='text-white'>Fibonacci Retracement</strong>, um es zu aktivieren. Das Werkzeug ist nun aktiv und wartet auf Ihren ersten Klick im Chart." },
        { title: "Zeichnen Sie es über den Swing", html: "<strong class='text-white'>Klicken Sie einmal mit links</strong> auf ein Ende der Bewegung, etwa das Swing-Tief, bewegen Sie dann den Cursor zum anderen Ende und <strong class='text-white'>klicken Sie erneut mit links</strong> auf das Swing-Hoch, um das Retracement zu setzen. Zwei saubere Klicks, kein Klicken und Ziehen; ein Ziehen verschiebt nur den Chart. Zeichnen Sie im Aufwärtstrend von unten nach oben und im Abwärtstrend von oben nach unten, dann richten sich die Levels nach dieser Richtung aus." },
        { title: "Öffnen Sie die Einstellungen der Zeichnung", html: "Öffnen Sie bei einem Fib im Chart dessen Einstellungen, um an die Levels zu gelangen. <strong class='text-white'>Doppelklicken</strong> Sie auf die Zeichnung (oder klicken Sie mit der <strong class='text-white'>rechten Maustaste</strong> darauf und wählen Sie <strong class='text-white'>Settings</strong>), und es öffnet sich ein Eigenschaftenfenster mit der Level-Liste und den Stilsteuerungen. Falls ein Doppelklick nicht funktioniert, klicken Sie mit rechts auf das Objekt und suchen Sie nach einer Option Settings oder Properties." },
        { title: "Levels hinzufügen, bearbeiten und umschalten", html: "Hier machen Sie es zu Ihrem eigenen. Jedes Level hat ein Kontrollkästchen, einen Prozentwert und eine Farbe. Deaktivieren Sie die Verhältnisse, die Sie nicht handeln; viele nutzen 38.2, 50 und 61.8 und blenden den Rest aus. Aktivieren Sie die Extension-Levels <strong class='text-white'>161.8%</strong> und <strong class='text-white'>261.8%</strong>, wenn Sie Ziele über den Swing hinaus projizieren möchten. Um ein Verhältnis zu ändern, klicken Sie auf seinen Wert und geben Sie einen neuen ein; um die Darstellung zu ändern, legen Sie die Level- und Beschriftungsfarben fest. Das Werkzeug begrenzt, wie viele benutzerdefinierte Levels Sie stapeln können, aber es ist Platz für den vollständigen Standardsatz plus ein paar Extensions." },
        { title: "Speichern Sie Ihren Satz als Standard", html: "Wenn Ihr Level-Satz passt, speichern Sie ihn, damit Sie ihn nicht in jedem Chart neu aufbauen müssen. Aktivieren Sie im selben Einstellungsfenster <strong class='text-white'>Save As Default</strong> (manche Versionen beschriften es als Anwendung auf alle Zeichnungen dieses Typs). Jedes neue Fibonacci, das Sie zeichnen, erscheint dann mit Ihren Verhältnissen, Farben und Extensions bereits aktiviert, sodass Sie einfach zeichnen und loslegen." },
      ],
    },
    { type: "quote",html: "<strong>Hinweis zu Extensions:</strong> Die Levels 161.8% und 261.8% werden von denselben zwei Ankern projiziert, die Sie angeklickt haben. Wenn ein Ziel an einer merkwürdigen Stelle landet, kehren Sie die Zeichenrichtung um, wodurch sich ändert, wohin diese höheren Levels zeigen." },
    { type: "heading",text: "Warum das wichtig ist" },
    {
      type: "list",
      items: [
        "Handeln Sie nur die Levels, die Sie tatsächlich nutzen, damit Ihr Chart keine Leiter aus Rauschen wird.",
        "Aktivieren Sie 161.8% und 261.8%, um Extension-Ziele ohne ein zweites Werkzeug zu erhalten.",
        "Färben Sie Levels um, damit Ihre Einstiegszone und Ihre Zielzone auf einen Blick lesbar sind.",
        "Speichern Sie Ihren Satz als Standard und hören Sie auf, dasselbe Fib Chart für Chart neu aufzubauen.",
      ],
    },
    { type: "heading",text: "Automatisieren Sie den Trade auf Basis Ihrer Fibonacci-Levels" },
    { type: "paragraph",html: "Das Markieren des Levels ist die Planung. Im Moment der Berührung durch den Kurs zu handeln, ist der schwierige Teil. PickMyTrade verwandelt Ihre TradingView-Alerts automatisch in echte Tradovate-Orders, sodass die Order bereits aktiv ist, wenn der Kurs das von Ihnen markierte Level 61.8% erreicht, statt auf Ihren Klick zu warten." },
  ], es: [
    { type: "paragraph",html: "Un retroceso de Fibonacci es tan útil como los niveles que contiene. Quizá usted opere solo el 50% y el 61.8%, o quiera el 78.6% más un par de objetivos de extensión por encima del swing. Tradovate le permite configurar todo eso en el gráfico. Elija la herramienta, dibújela sobre un movimiento, abra su configuración y ajuste las razones tal como realmente las opera. Aquí le explicamos cómo agregar y editar niveles de Fibonacci personalizados, y cómo obtener objetivos de extensión de la misma herramienta." },
    { type: "heading",text: "Cómo funciona Fibonacci en los gráficos de Tradovate" },
    { type: "paragraph",html: "Tradovate tiene una herramienta <strong class='text-white'>Fibonacci Retracement</strong> integrada en el menú de dibujo del gráfico, el mismo lugar donde están sus líneas de tendencia y rectángulos. Dibújela sobre un swing y trazará las razones de retroceso estándar entre sus dos anclas: la conocida banda de 23.6%, 38.2%, 50%, 61.8% y 78.6%, delimitada por 0% y 100%. Las razones de extensión que se proyectan más allá del swing, <strong class='text-white'>161.8%</strong> y <strong class='text-white'>261.8%</strong>, también vienen con la herramienta, pero inicialmente están desactivadas. No hay una herramienta «Fibonacci Extension» separada que buscar; usted activa esos niveles superiores en la propia configuración de la herramienta de retroceso y esta funciona también como herramienta de extensión. Cada nivel es una línea que puede recolorear, ocultar o editar directamente." },
    { type: "heading",text: "Personalizar niveles de Fibonacci en Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra la herramienta de Fibonacci", html: "Pase el cursor sobre el gráfico para que las barras de herramientas aparezcan en el borde <strong class='text-white'>superior izquierdo</strong> y luego haga clic en el icono <strong class='text-white'>Drawing Tools</strong> de esa franja vertical. El menú de herramientas se despliega a un lado. Haga clic una vez con el botón izquierdo en <strong class='text-white'>Fibonacci Retracement</strong> para activarla. La herramienta queda activa y esperando su primer clic en el gráfico." },
        { title: "Dibújela sobre el swing", html: "<strong class='text-white'>Haga clic una vez con el botón izquierdo</strong> en un extremo del movimiento, por ejemplo el mínimo del swing, mueva el cursor al otro extremo y <strong class='text-white'>haga clic de nuevo con el botón izquierdo</strong> en el máximo del swing para colocar el retroceso. Dos clics limpios, no hacer clic y arrastrar; arrastrar solo desplaza el gráfico. Dibuje de mínimo a máximo en una tendencia alcista y de máximo a mínimo en una bajista, y los niveles se orientarán en esa dirección." },
        { title: "Abra la configuración del dibujo", html: "Con el fibo en el gráfico, abra su configuración para acceder a los niveles. <strong class='text-white'>Haga doble clic</strong> en el dibujo (o haga <strong class='text-white'>clic derecho</strong> sobre él y elija <strong class='text-white'>Settings</strong>) y se abre un panel de propiedades con la lista de niveles y los controles de estilo. Si el doble clic no funciona, haga clic derecho en el objeto y busque una opción Settings o Properties." },
        { title: "Agregue, edite y active o desactive niveles", html: "Aquí es donde lo hace suyo. Cada nivel tiene una casilla, un valor porcentual y un color. Desmarque las razones que no opera; muchos usan 38.2, 50 y 61.8 y eliminan el resto. Active los niveles de extensión <strong class='text-white'>161.8%</strong> y <strong class='text-white'>261.8%</strong> cuando quiera proyectar objetivos más allá del swing. Para cambiar una razón, haga clic en su valor y escriba uno nuevo; para cambiar su aspecto, defina los colores del nivel y de la etiqueta. La herramienta limita cuántos niveles personalizados puede apilar, pero hay espacio para el conjunto estándar completo más un par de extensiones." },
        { title: "Guarde su conjunto como predeterminado", html: "Cuando su conjunto de niveles esté bien, guárdelo para no reconstruirlo en cada gráfico. En el mismo panel de configuración, active <strong class='text-white'>Save As Default</strong> (algunas versiones lo etiquetan como aplicable a todos los dibujos de este tipo). Cada nuevo Fibonacci que dibuje saldrá entonces con sus razones, colores y extensiones ya activados, de modo que solo tiene que dibujar y listo." },
      ],
    },
    { type: "quote",html: "<strong>Aviso sobre extensiones:</strong> los niveles 161.8% y 261.8% se proyectan desde las mismas dos anclas en las que hizo clic. Si un objetivo cae en un lugar extraño, invierta la dirección del trazado, lo que cambia hacia dónde apuntan esos niveles superiores." },
    { type: "heading",text: "Por qué es importante" },
    {
      type: "list",
      items: [
        "Opere solo los niveles que realmente usa, para que su gráfico no sea una escalera de ruido.",
        "Active 161.8% y 261.8% para obtener objetivos de extensión sin una segunda herramienta.",
        "Recolore los niveles para que su zona de entrada y su zona de objetivo se lean de un vistazo.",
        "Guarde su conjunto como predeterminado y deje de reconstruir el mismo fibo gráfico tras gráfico.",
      ],
    },
    { type: "heading",text: "Automatice la operación a partir de sus niveles de Fibonacci" },
    { type: "paragraph",html: "Marcar el nivel es la planificación. Actuar en el instante en que el precio lo toca es lo difícil. PickMyTrade convierte sus alertas de TradingView en órdenes reales de Tradovate de forma automática, de modo que cuando el precio llegue al 61.8% que marcó, la orden ya esté activa en lugar de esperar su clic." },
  ], fr: [
    { type: "paragraph",html: "Un retracement de Fibonacci n'est utile que par les niveaux qu'il porte. Peut-être ne négociez-vous que le 50 % et le 61.8 %, ou voulez-vous le 78.6 % ainsi que quelques objectifs d'extension au-dessus du swing. Tradovate vous permet de régler tout cela sur le graphique. Choisissez l'outil, tracez-le sur un mouvement, puis ouvrez ses paramètres et réglez les ratios comme vous les négociez réellement. Voici comment ajouter et modifier des niveaux de Fibonacci personnalisés, et comment obtenir des objectifs d'extension avec le même outil." },
    { type: "heading",text: "Comment fonctionne Fibonacci sur les graphiques Tradovate" },
    { type: "paragraph",html: "Tradovate propose un outil <strong class='text-white'>Fibonacci Retracement</strong> intégré au menu de dessin du graphique, là où se trouvent déjà vos lignes de tendance et vos rectangles. Tracez-le sur un swing et il affiche les ratios de retracement standard entre vos deux ancrages : la bande familière 23.6 %, 38.2 %, 50 %, 61.8 % et 78.6 %, encadrée par 0 % et 100 %. Les ratios d'extension qui se projettent au-delà du swing, <strong class='text-white'>161.8%</strong> et <strong class='text-white'>261.8%</strong>, sont eux aussi fournis avec l'outil mais désactivés au départ. Il n'existe pas d'outil « Fibonacci Extension » distinct à chercher ; vous activez ces niveaux supérieurs dans les paramètres propres à l'outil de retracement, et il sert aussi d'outil d'extension. Chaque niveau est une ligne que vous pouvez recolorer, masquer ou modifier directement." },
    { type: "heading",text: "Personnaliser les niveaux de Fibonacci sur Tradovate : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez l'outil Fibonacci", html: "Placez le curseur sur le graphique pour que les barres d'outils apparaissent le long du bord <strong class='text-white'>supérieur gauche</strong>, puis cliquez sur l'icône <strong class='text-white'>Drawing Tools</strong> de cette bande verticale. Le menu des outils s'ouvre sur le côté. Cliquez une fois avec le bouton gauche sur <strong class='text-white'>Fibonacci Retracement</strong> pour l'armer. L'outil est maintenant actif et attend votre premier clic sur le graphique." },
        { title: "Tracez-le sur le swing", html: "<strong class='text-white'>Cliquez une fois avec le bouton gauche</strong> à une extrémité du mouvement, par exemple le creux du swing, puis déplacez le curseur vers l'autre extrémité et <strong class='text-white'>cliquez de nouveau avec le bouton gauche</strong> sur le sommet du swing pour poser le retracement. Deux clics nets, pas un cliquer-glisser ; un glissement ne fait que déplacer le graphique. Tracez du bas vers le haut dans une tendance haussière et du haut vers le bas dans une tendance baissière, et les niveaux s'orienteront dans cette direction." },
        { title: "Ouvrez les paramètres du dessin", html: "Une fois le fibo sur le graphique, ouvrez ses paramètres pour accéder aux niveaux. <strong class='text-white'>Double-cliquez</strong> sur le dessin (ou faites un <strong class='text-white'>clic droit</strong> dessus et choisissez <strong class='text-white'>Settings</strong>) et un panneau de propriétés s'ouvre avec la liste des niveaux et les contrôles de style. Si le double-clic ne fonctionne pas, faites un clic droit sur l'objet et cherchez une option Settings ou Properties." },
        { title: "Ajoutez, modifiez et activez ou désactivez des niveaux", html: "C'est ici que vous le personnalisez. Chaque niveau a une case à cocher, une valeur en pourcentage et une couleur. Décochez les ratios que vous ne négociez pas ; beaucoup utilisent 38.2, 50 et 61.8 et suppriment le reste. Cochez les niveaux d'extension <strong class='text-white'>161.8%</strong> et <strong class='text-white'>261.8%</strong> quand vous voulez projeter des objectifs au-delà du swing. Pour modifier un ratio, cliquez sur sa valeur et saisissez-en une nouvelle ; pour changer son apparence, définissez les couleurs du niveau et du libellé. L'outil plafonne le nombre de niveaux personnalisés empilables, mais il y a de la place pour l'ensemble standard complet plus quelques extensions." },
        { title: "Enregistrez votre ensemble par défaut", html: "Une fois votre ensemble de niveaux au point, enregistrez-le pour ne pas le reconstruire sur chaque graphique. Dans le même panneau de paramètres, activez <strong class='text-white'>Save As Default</strong> (certaines versions l'indiquent comme s'appliquant à tous les dessins de ce type). Chaque nouveau Fibonacci que vous tracez sort alors avec vos ratios, vos couleurs et vos extensions déjà activés ; vous n'avez plus qu'à tracer et à y aller." },
      ],
    },
    { type: "quote",html: "<strong>Remarque sur les extensions :</strong> les niveaux 161.8% et 261.8% se projettent à partir des deux mêmes ancrages que vous avez cliqués. Si un objectif tombe à un endroit étrange, inversez la direction du tracé, ce qui change la direction vers laquelle pointent ces niveaux supérieurs." },
    { type: "heading",text: "Pourquoi c'est important" },
    {
      type: "list",
      items: [
        "Ne négociez que les niveaux que vous utilisez réellement, pour que votre graphique ne devienne pas une échelle de bruit.",
        "Activez 161.8% et 261.8% pour obtenir des objectifs d'extension sans second outil.",
        "Recolorez les niveaux pour que votre zone d'entrée et votre zone d'objectif se lisent d'un coup d'œil.",
        "Enregistrez votre ensemble par défaut et cessez de reconstruire le même fibo graphique après graphique.",
      ],
    },
    { type: "heading",text: "Automatisez le trade à partir de vos niveaux de Fibonacci" },
    { type: "paragraph",html: "Marquer le niveau, c'est la planification. Agir à la seconde où le prix l'atteint, c'est la partie difficile. PickMyTrade transforme automatiquement vos alertes TradingView en ordres Tradovate réels, de sorte que lorsque le prix touche le 61.8 % que vous avez repéré, l'ordre est déjà en place au lieu d'attendre votre clic." },
  ], it: [
    { type: "paragraph",html: "Un ritracciamento di Fibonacci è utile quanto i livelli che contiene. Magari lei opera solo il 50% e il 61.8%, oppure vuole il 78.6% più un paio di target di estensione sopra lo swing. Tradovate le permette di impostare tutto questo sul grafico. Scelga lo strumento, lo tracci su un movimento, poi apra le sue impostazioni e regoli i rapporti come li opera davvero. Ecco come aggiungere e modificare livelli di Fibonacci personalizzati e come ricavare target di estensione dallo stesso strumento." },
    { type: "heading",text: "Come funziona Fibonacci sui grafici Tradovate" },
    { type: "paragraph",html: "Tradovate ha uno strumento <strong class='text-white'>Fibonacci Retracement</strong> integrato nel menu di disegno del grafico, lo stesso punto in cui si trovano trendline e rettangoli. Lo tracci su uno swing e disegna i rapporti di ritracciamento standard tra i suoi due ancoraggi: la familiare fascia 23.6%, 38.2%, 50%, 61.8% e 78.6%, racchiusa da 0% e 100%. I rapporti di estensione che si proiettano oltre lo swing, <strong class='text-white'>161.8%</strong> e <strong class='text-white'>261.8%</strong>, sono inclusi anch'essi nello strumento ma inizialmente disattivati. Non c'è uno strumento «Fibonacci Extension» separato da cercare; attivi questi livelli superiori nelle impostazioni dello stesso strumento di ritracciamento, che funge anche da strumento di estensione. Ogni livello è una linea che può ricolorare, nascondere o modificare direttamente." },
    { type: "heading",text: "Personalizzare i livelli di Fibonacci su Tradovate: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Apra lo strumento Fibonacci", html: "Passi il cursore sul grafico in modo che le barre degli strumenti compaiano lungo il bordo <strong class='text-white'>superiore sinistro</strong>, poi clicchi sull'icona <strong class='text-white'>Drawing Tools</strong> di quella barra verticale. Il menu degli strumenti si apre di lato. Clicchi una volta con il tasto sinistro su <strong class='text-white'>Fibonacci Retracement</strong> per attivarlo. Lo strumento è ora attivo e attende il suo primo clic sul grafico." },
        { title: "Lo tracci sullo swing", html: "<strong class='text-white'>Clicchi una volta con il tasto sinistro</strong> su un'estremità del movimento, ad esempio il minimo dello swing, poi sposti il cursore all'altra estremità e <strong class='text-white'>clicchi di nuovo con il tasto sinistro</strong> sul massimo dello swing per posizionare il ritracciamento. Due clic netti, non un clic e trascina; trascinare sposta soltanto il grafico. Tracci dal basso verso l'alto in un trend rialzista e dall'alto verso il basso in un trend ribassista, e i livelli si orienteranno in quella direzione." },
        { title: "Apra le impostazioni del disegno", html: "Con il fib sul grafico, apra le sue impostazioni per accedere ai livelli. <strong class='text-white'>Faccia doppio clic</strong> sul disegno (oppure faccia <strong class='text-white'>clic destro</strong> su di esso e scelga <strong class='text-white'>Settings</strong>) e si apre un pannello delle proprietà con l'elenco dei livelli e i controlli di stile. Se il doppio clic non funziona, faccia clic destro sull'oggetto e cerchi un'opzione Settings o Properties." },
        { title: "Aggiunga, modifichi e attivi o disattivi i livelli", html: "È qui che lo rende suo. Ogni livello ha una casella di controllo, un valore percentuale e un colore. Deselezioni i rapporti che non opera; molti usano 38.2, 50 e 61.8 e tolgono il resto. Attivi i livelli di estensione <strong class='text-white'>161.8%</strong> e <strong class='text-white'>261.8%</strong> quando vuole proiettare target oltre lo swing. Per cambiare un rapporto, clicchi sul suo valore e ne digiti uno nuovo; per cambiarne l'aspetto, imposti i colori del livello e dell'etichetta. Lo strumento limita il numero di livelli personalizzati che può accumulare, ma c'è spazio per l'intero set standard più un paio di estensioni." },
        { title: "Salvi il suo set come predefinito", html: "Quando il suo set di livelli è a posto, lo salvi per non doverlo ricostruire su ogni grafico. Nello stesso pannello delle impostazioni, attivi <strong class='text-white'>Save As Default</strong> (alcune versioni lo indicano come applicabile a tutti i disegni di questo tipo). Ogni nuovo Fibonacci che traccerà uscirà quindi con i suoi rapporti, colori ed estensioni già attivi, così basta tracciare e partire." },
      ],
    },
    { type: "quote",html: "<strong>Nota sulle estensioni:</strong> i livelli 161.8% e 261.8% si proiettano dagli stessi due ancoraggi su cui ha cliccato. Se un target finisce in un punto strano, inverta la direzione del tracciamento, il che cambia verso dove puntano questi livelli superiori." },
    { type: "heading",text: "Perché è importante" },
    {
      type: "list",
      items: [
        "Operi solo i livelli che usa davvero, così il suo grafico non diventa una scala di rumore.",
        "Attivi 161.8% e 261.8% per ottenere target di estensione senza un secondo strumento.",
        "Ricolori i livelli in modo che la sua zona di ingresso e la sua zona di target si leggano a colpo d'occhio.",
        "Salvi il suo set come predefinito e smetta di ricostruire lo stesso fib grafico dopo grafico.",
      ],
    },
    { type: "heading",text: "Automatizzi il trade a partire dai suoi livelli di Fibonacci" },
    { type: "paragraph",html: "Segnare il livello è la pianificazione. Agire nell'istante in cui il prezzo lo tocca è la parte difficile. PickMyTrade trasforma automaticamente i suoi alert di TradingView in ordini reali su Tradovate, così quando il prezzo raggiunge il 61.8% che ha segnato, l'ordine è già attivo invece di attendere il suo clic." },
  ] },
  ctaHeading: { en: "Turn Your Levels Into Live Orders", de: "Machen Sie aus Ihren Levels echte Orders", es: "Convierta sus niveles en órdenes reales", fr: "Transformez vos niveaux en ordres réels", it: "Trasformi i suoi livelli in ordini reali" },
  ctaText: { en: "PickMyTrade turns your TradingView alerts into live Tradovate orders automatically, so your levels trade themselves.", de: "PickMyTrade verwandelt Ihre TradingView-Alerts automatisch in echte Tradovate-Orders, sodass Ihre Levels von selbst handeln.", es: "PickMyTrade convierte sus alertas de TradingView en órdenes reales de Tradovate de forma automática, para que sus niveles operen solos.", fr: "PickMyTrade transforme automatiquement vos alertes TradingView en ordres Tradovate réels, afin que vos niveaux se négocient tout seuls.", it: "PickMyTrade trasforma automaticamente i suoi alert di TradingView in ordini reali su Tradovate, così i suoi livelli operano da soli." },
  ctaButtonText: { en: "Start Your Free Trial", de: "Starten Sie Ihre kostenlose Testphase", es: "Comience su prueba gratuita", fr: "Commencez votre essai gratuit", it: "Inizi la prova gratuita" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Does Tradovate have a separate Fibonacci extension tool?", a: "No. Extensions live inside the Fibonacci Retracement tool. The 161.8% and 261.8% levels ship with it but start switched off. Open the drawing's settings and tick them on to project targets past the swing you drew." },
    { q: "Can I change the actual percentage values, not just turn levels on and off?", a: "Yes. In the fib's settings, each level shows an editable percentage, so click the value and type your own ratio. You can also recolor each level and its label. There's a limit on how many custom levels you can stack, so drop the ones you don't use to make room." },
    { q: "Why do my Fibonacci lines look wrong or land in odd places?", a: "Usually it's the draw direction. Levels and extensions are measured from your first click to your second, so a fib drawn high-to-low projects the opposite way from one drawn low-to-high. Redraw from the correct swing extreme, or drag an anchor to the right price." },
  ], de: [
    { q: "Hat Tradovate ein separates Fibonacci-Extension-Werkzeug?", a: "Nein. Die Extensions sind im Werkzeug Fibonacci Retracement enthalten. Die Levels 161.8% und 261.8% sind dabei, aber zunächst ausgeschaltet. Öffnen Sie die Einstellungen der Zeichnung und aktivieren Sie sie, um Ziele über den gezeichneten Swing hinaus zu projizieren." },
    { q: "Kann ich die tatsächlichen Prozentwerte ändern, nicht nur Levels ein- und ausschalten?", a: "Ja. In den Einstellungen des Fibs zeigt jedes Level einen bearbeitbaren Prozentwert; klicken Sie auf den Wert und geben Sie Ihr eigenes Verhältnis ein. Sie können außerdem jedes Level und seine Beschriftung umfärben. Die Anzahl der benutzerdefinierten Levels ist begrenzt, entfernen Sie daher nicht benötigte, um Platz zu schaffen." },
    { q: "Warum sehen meine Fibonacci-Linien falsch aus oder liegen an merkwürdigen Stellen?", a: "Meistens liegt es an der Zeichenrichtung. Levels und Extensions werden von Ihrem ersten zu Ihrem zweiten Klick gemessen; ein von oben nach unten gezeichnetes Fib projiziert daher in die entgegengesetzte Richtung wie eines von unten nach oben. Zeichnen Sie es vom richtigen Swing-Extrempunkt neu oder ziehen Sie einen Anker auf den richtigen Preis." },
  ], es: [
    { q: "¿Tiene Tradovate una herramienta separada de extensión de Fibonacci?", a: "No. Las extensiones están dentro de la herramienta Fibonacci Retracement. Los niveles 161.8% y 261.8% vienen incluidos, pero inicialmente están desactivados. Abra la configuración del dibujo y actívelos para proyectar objetivos más allá del swing que dibujó." },
    { q: "¿Puedo cambiar los valores porcentuales reales, y no solo activar y desactivar niveles?", a: "Sí. En la configuración del fibo, cada nivel muestra un porcentaje editable; haga clic en el valor y escriba su propia razón. También puede cambiar el color de cada nivel y de su etiqueta. Hay un límite de niveles personalizados que puede apilar, así que elimine los que no use para liberar espacio." },
    { q: "¿Por qué mis líneas de Fibonacci se ven mal o caen en lugares extraños?", a: "Normalmente es la dirección del trazado. Los niveles y las extensiones se miden desde su primer clic hasta el segundo, así que un fibo trazado de máximo a mínimo se proyecta en sentido contrario a uno trazado de mínimo a máximo. Vuelva a trazarlo desde el extremo correcto del swing o arrastre un ancla al precio adecuado." },
  ], fr: [
    { q: "Tradovate dispose-t-il d'un outil d'extension de Fibonacci distinct ?", a: "Non. Les extensions se trouvent dans l'outil Fibonacci Retracement. Les niveaux 161.8% et 261.8% sont fournis avec l'outil mais désactivés au départ. Ouvrez les paramètres du dessin et cochez-les pour projeter des objectifs au-delà du swing que vous avez tracé." },
    { q: "Puis-je modifier les valeurs en pourcentage elles-mêmes, et pas seulement activer ou désactiver des niveaux ?", a: "Oui. Dans les paramètres du fibo, chaque niveau affiche un pourcentage modifiable ; cliquez sur la valeur et saisissez votre propre ratio. Vous pouvez aussi changer la couleur de chaque niveau et de son libellé. Le nombre de niveaux personnalisés empilables est limité ; supprimez donc ceux que vous n'utilisez pas pour faire de la place." },
    { q: "Pourquoi mes lignes de Fibonacci semblent-elles fausses ou tombent-elles à des endroits étranges ?", a: "C'est généralement la direction du tracé. Les niveaux et les extensions se mesurent de votre premier clic au second ; un fibo tracé du haut vers le bas se projette donc dans le sens opposé à celui d'un fibo tracé du bas vers le haut. Retracez-le depuis le bon extrême du swing, ou faites glisser un ancrage au bon prix." },
  ], it: [
    { q: "Tradovate ha uno strumento separato per le estensioni di Fibonacci?", a: "No. Le estensioni si trovano all'interno dello strumento Fibonacci Retracement. I livelli 161.8% e 261.8% sono inclusi ma inizialmente disattivati. Apra le impostazioni del disegno e li attivi per proiettare target oltre lo swing che ha tracciato." },
    { q: "Posso cambiare i valori percentuali veri e propri, non solo attivare e disattivare i livelli?", a: "Sì. Nelle impostazioni del fib, ogni livello mostra una percentuale modificabile; clicchi sul valore e digiti il suo rapporto. Può anche cambiare il colore di ogni livello e della sua etichetta. C'è un limite al numero di livelli personalizzati che può accumulare, quindi elimini quelli che non usa per fare spazio." },
    { q: "Perché le mie linee di Fibonacci sembrano sbagliate o cadono in punti strani?", a: "Di solito dipende dalla direzione del tracciamento. Livelli ed estensioni sono misurati dal primo al secondo clic, quindi un fib tracciato dall'alto verso il basso si proietta nel verso opposto rispetto a uno tracciato dal basso verso l'alto. Lo ritracci dall'estremo corretto dello swing oppure trascini un'ancora sul prezzo giusto." },
  ] },
  relatedHeading: { en: "Related Guides", de: "Verwandte Anleitungen", es: "Guías relacionadas", fr: "Guides associés", it: "Guide correlate" },
