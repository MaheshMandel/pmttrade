---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-indicator-alerts";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Indicator Alerts in Tradovate: What's Possible";
const META_DESCRIPTION =
  "Tradovate alerts trigger on price, position, and account levels, not indicators. See what's possible and how to get indicator-based alerts working.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Indikator-Alerts in Tradovate: Was ist möglich", es: "Alertas de indicadores en Tradovate: qué es posible", fr: "Alertes d'indicateurs dans Tradovate : ce qui est possible", it: "Alert sugli indicatori in Tradovate: che cosa è possibile" },
  dek: { en: "Tradovate's built-in alerts watch price and account numbers, not indicators. Here's the honest state of the platform, and how to get indicator alerts working anyway.", de: "Die integrierten Alerts von Tradovate überwachen Kurs und Kontowerte, keine Indikatoren. Hier lesen Sie den ehrlichen Stand der Plattform und erfahren, wie Sie Indikator-Alerts trotzdem zum Laufen bringen.", es: "Las alertas integradas de Tradovate vigilan el precio y los valores de la cuenta, no los indicadores. Aquí tiene el estado real de la plataforma y cómo conseguir que las alertas de indicadores funcionen de todos modos.", fr: "Les alertes intégrées de Tradovate surveillent le prix et les valeurs du compte, pas les indicateurs. Voici l'état réel de la plateforme et comment faire fonctionner malgré tout des alertes d'indicateurs.", it: "Gli alert integrati di Tradovate monitorano il prezzo e i valori del conto, non gli indicatori. Ecco lo stato reale della piattaforma e come far funzionare comunque gli alert sugli indicatori." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "If you're waiting for Tradovate to ping you the second your moving average crosses or RSI tags 70, here's the short version: it won't. Tradovate's built-in alerts watch price and account numbers, not indicators. There's no setting anywhere that lets you point an alert at a study on your chart. That's the honest state of the platform today, and it hasn't changed in a long time." },
    { type: "paragraph", html: "You still have good options, though. You can set sharp price and account alerts right inside Tradovate, and you can get real indicator alerts by pairing Tradovate with a platform that actually reads your indicators. Here's how both pieces fit together." },
    { type: "heading", text: "What Tradovate Alerts Can Actually Do" },
    { type: "paragraph", html: "Click the bell-shaped Alerts icon at the top-left of the workspace, right next to the New + button, and you'll find two kinds of alert:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Simple Alert</strong>, one condition. Choose the price of an instrument, a position value, or an account value, then set the level it has to reach.",
        "<strong class='text-white'>Advanced Alert</strong>, several conditions stacked together. You decide whether it fires when <em>all</em> of them are true or when <em>any</em> single one trips.",
      ],
    },
    { type: "paragraph", html: "Every condition is price-driven: touch a level, cross above it, or cross below it. You can also build an alert straight off a chart or the DOM by clicking a price line, which beats typing numbers by hand. When an alert triggers, your browser plays a sound, the bell picks up a red dot, and any note you attached shows in a small flag underneath. The mobile app can push the same alert to your phone." },
    {
      type: "table",
      headers: ["What you want to alert on", "Example", "Native in Tradovate?"],
      rows: [
        ["Instrument price", "ES touches 5,600", "Yes"],
        ["Position value", "Open P&amp;L hits -$400", "Yes"],
        ["Account value", "Balance drops under your line", "Yes"],
        ["Indicator value", "9 EMA crosses the 21 EMA", "No"],
        ["Study condition", "RSI crosses 70", "No"],
      ],
    },
    { type: "heading", text: "Why There's No Indicator Alert Button" },
    { type: "paragraph", html: "Indicator alerts have sat on the wish list for years. There's been talk of a cloud-based alert server that would start with Tradovate's own built-in studies, but it hasn't shipped. So right now there's simply no field where you can say \"ping me when the MACD crosses.\" Even custom indicators you add to a chart can't carry a sound or an alert. When you need that, you build the alert somewhere else and route it in. Tradovate does have a deep library of chart indicators you can display, but displaying a study and getting alerted off it are two different things." },
    { type: "heading", text: "How to Get Indicator-Based Alerts Working" },
    { type: "paragraph", html: "The workaround is straightforward: keep price alerts native, and borrow indicator alerts from a platform that supports them." },
    {
      type: "steps",
      items: [
        { title: "Set the Price Alerts Tradovate Does Support", html: "Start with what's already there. Click the Alerts bell, add a Simple or Advanced alert, and cover the price and account levels that matter, like a session high, a stop zone, or a drawdown line. These fire reliably and cost you nothing, so there's no reason to skip them." },
        { title: "Build the Indicator Alert in TradingView", html: "TradingView reads indicators and fires alerts off them, which is exactly the gap Tradovate leaves. Load your study on a TradingView chart, open the alert panel, and set the condition on the indicator itself, say a fast EMA crossing a slow one or RSI tagging a level. This is the piece Tradovate can't do on its own." },
        { title: "Route That Alert to Tradovate", html: "Now connect the two. Link Tradovate to TradingView through the add-on so you can act on the alert without leaving your workflow, or send the TradingView alert to a webhook bridge that places the Tradovate order for you. Manual routing keeps a human in the loop; a bridge turns the indicator alert into an automatic trade." },
        { title: "Test on a Simulated Account First", html: "Before a cent of real money rides on it, run the whole chain on a Tradovate simulated account. Confirm the alert fires, the signal arrives, and the order lands the way you meant it to. If you're on a prop or evaluation account, automation rules vary by firm and account size, so check your firm's current rules before you flip it live." },
      ],
    },
    { type: "heading", text: "The Bottom Line" },
    { type: "paragraph", html: "Tradovate's alerts are price and account tools, full stop. They're genuinely useful for level-based warnings, but they won't watch a study for you. If your strategy lives on indicators, build those alerts in TradingView and pipe them into Tradovate, either by hand or through automation. That combination gives you everything the native alert menu is missing." },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Want your TradingView indicator alerts to actually place trades in Tradovate? PickMyTrade turns each alert into a live order automatically, no API license or coding required." },
  ], de: [
    { type: "paragraph",html: "Wenn Sie darauf warten, dass Tradovate Sie benachrichtigt, sobald Ihr gleitender Durchschnitt kreuzt oder der RSI die 70 berührt, die Kurzfassung: Das passiert nicht. Die integrierten Alerts von Tradovate überwachen Kurs und Kontowerte, keine Indikatoren. Es gibt nirgendwo eine Einstellung, mit der Sie einen Alert auf eine Studie in Ihrem Chart richten können. Das ist der ehrliche Stand der Plattform heute, und er hat sich seit langer Zeit nicht geändert." },
    { type: "paragraph",html: "Sie haben dennoch gute Möglichkeiten. Sie können präzise Kurs- und Konto-Alerts direkt in Tradovate einrichten, und echte Indikator-Alerts erhalten Sie, indem Sie Tradovate mit einer Plattform kombinieren, die Ihre Indikatoren tatsächlich auswertet. So greifen beide Teile ineinander." },
    { type: "heading",text: "Was Tradovate-Alerts tatsächlich können" },
    { type: "paragraph",html: "Klicken Sie oben links im Arbeitsbereich auf das glockenförmige Alerts-Symbol, direkt neben der Schaltfläche New +, und Sie finden zwei Arten von Alerts:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Simple Alert</strong>, eine Bedingung. Wählen Sie den Kurs eines Instruments, einen Positionswert oder einen Kontowert und legen Sie dann das Level fest, das erreicht werden muss.",
        "<strong class='text-white'>Advanced Alert</strong>, mehrere Bedingungen kombiniert. Sie legen fest, ob er auslöst, wenn <em>alle</em> zutreffen oder wenn <em>eine beliebige</em> einzelne ausgelöst wird.",
      ],
    },
    { type: "paragraph",html: "Jede Bedingung ist kursgesteuert: ein Level berühren, darüber kreuzen oder darunter kreuzen. Sie können einen Alert auch direkt aus einem Chart oder dem DOM erstellen, indem Sie auf eine Kurslinie klicken, was besser ist, als Zahlen von Hand einzutippen. Wenn ein Alert auslöst, spielt Ihr Browser einen Ton ab, die Glocke erhält einen roten Punkt, und eine angehängte Notiz erscheint in einer kleinen Markierung darunter. Die mobile App kann denselben Alert auf Ihr Smartphone pushen." },
    { type: "table", headers: ["Worauf Sie einen Alert setzen möchten","Beispiel","In Tradovate nativ?"], rows: [
      ["Instrumentenkurs","ES berührt 5,600","Ja"],
      ["Positionswert","Offener P&amp;L erreicht -$400","Ja"],
      ["Kontowert","Kontostand fällt unter Ihre Linie","Ja"],
      ["Indikatorwert","Der 9 EMA kreuzt den 21 EMA","Nein"],
      ["Studienbedingung","RSI kreuzt 70","Nein"],
    ] },
    { type: "heading",text: "Warum es keine Schaltfläche für Indikator-Alerts gibt" },
    { type: "paragraph",html: "Indikator-Alerts stehen seit Jahren auf der Wunschliste. Es gab Gerede über einen cloudbasierten Alert-Server, der mit den eigenen integrierten Studien von Tradovate starten sollte, aber er wurde nie ausgeliefert. Derzeit gibt es also schlicht kein Feld, in dem Sie sagen können: \"Benachrichtige mich, wenn der MACD kreuzt.\" Selbst benutzerdefinierte Indikatoren, die Sie einem Chart hinzufügen, können weder einen Ton noch einen Alert auslösen. Wenn Sie das brauchen, bauen Sie den Alert an anderer Stelle und leiten ihn weiter. Tradovate verfügt zwar über eine umfangreiche Bibliothek an Chartindikatoren, die Sie anzeigen können, aber eine Studie anzuzeigen und von ihr alarmiert zu werden sind zwei verschiedene Dinge." },
    { type: "heading",text: "So bringen Sie indikatorbasierte Alerts zum Laufen" },
    { type: "paragraph",html: "Die Umgehungslösung ist einfach: Behalten Sie Kurs-Alerts nativ und leihen Sie sich Indikator-Alerts von einer Plattform, die sie unterstützt." },
    {
      type: "steps",
      items: [
        { title: "Richten Sie die Kurs-Alerts ein, die Tradovate unterstützt", html: "Beginnen Sie mit dem, was bereits vorhanden ist. Klicken Sie auf die Alerts-Glocke, fügen Sie einen Simple oder Advanced Alert hinzu und decken Sie die Kurs- und Kontolevel ab, die zählen, etwa ein Sitzungshoch, eine Stopp-Zone oder eine Drawdown-Linie. Diese lösen zuverlässig aus und kosten Sie nichts, es gibt also keinen Grund, sie auszulassen." },
        { title: "Erstellen Sie den Indikator-Alert in TradingView", html: "TradingView liest Indikatoren aus und löst darauf basierend Alerts aus, genau die Lücke, die Tradovate lässt. Laden Sie Ihre Studie in einen TradingView-Chart, öffnen Sie das Alert-Panel und legen Sie die Bedingung auf den Indikator selbst fest, etwa einen schnellen EMA, der einen langsamen kreuzt, oder den RSI, der ein Level berührt. Das ist der Teil, den Tradovate allein nicht leisten kann." },
        { title: "Leiten Sie diesen Alert an Tradovate weiter", html: "Verbinden Sie nun beides. Verknüpfen Sie Tradovate über das Add-on mit TradingView, damit Sie auf den Alert reagieren können, ohne Ihren Workflow zu verlassen, oder senden Sie den TradingView-Alert an eine Webhook-Brücke, die die Tradovate-Order für Sie platziert. Manuelles Weiterleiten hält einen Menschen im Prozess; eine Brücke macht aus dem Indikator-Alert einen automatischen Trade." },
        { title: "Testen Sie zuerst mit einem Simulationskonto", html: "Bevor auch nur ein Cent echtes Geld im Spiel ist, lassen Sie die gesamte Kette in einem simulierten Tradovate-Konto laufen. Bestätigen Sie, dass der Alert auslöst, das Signal ankommt und die Order so landet, wie Sie es vorgesehen haben. Wenn Sie ein Prop- oder Evaluation-Konto nutzen, unterscheiden sich die Automatisierungsregeln je nach Firma und Kontogröße. Prüfen Sie daher die aktuellen Regeln Ihrer Firma, bevor Sie live gehen." },
      ],
    },
    { type: "heading",text: "Das Fazit" },
    { type: "paragraph",html: "Die Alerts von Tradovate sind Kurs- und Kontowerkzeuge, mehr nicht. Für levelbasierte Warnungen sind sie wirklich nützlich, aber eine Studie überwachen sie nicht für Sie. Wenn Ihre Strategie auf Indikatoren beruht, bauen Sie diese Alerts in TradingView und leiten Sie sie nach Tradovate weiter, entweder von Hand oder per Automatisierung. Diese Kombination liefert Ihnen alles, was dem nativen Alert-Menü fehlt." },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "Möchten Sie, dass Ihre TradingView-Indikator-Alerts tatsächlich Trades in Tradovate platzieren? PickMyTrade verwandelt jeden Alert automatisch in eine Live-Order, ganz ohne API-Lizenz oder Programmierung." },
  ], es: [
    { type: "paragraph",html: "Si espera que Tradovate le avise en el instante en que su media móvil se cruza o el RSI toca 70, la versión corta es esta: no lo hará. Las alertas integradas de Tradovate vigilan el precio y los valores de la cuenta, no los indicadores. No existe ningún ajuste que le permita apuntar una alerta a un estudio de su gráfico. Ese es el estado real de la plataforma hoy, y no ha cambiado en mucho tiempo." },
    { type: "paragraph",html: "Aun así, tiene buenas opciones. Puede configurar alertas precisas de precio y de cuenta directamente en Tradovate, y puede obtener alertas de indicadores reales combinando Tradovate con una plataforma que sí lea sus indicadores. Así encajan ambas piezas." },
    { type: "heading",text: "Lo que las alertas de Tradovate sí pueden hacer" },
    { type: "paragraph",html: "Haga clic en el icono de campana de Alerts, en la parte superior izquierda del espacio de trabajo, justo al lado del botón New +, y encontrará dos tipos de alerta:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Simple Alert</strong>, una condición. Elija el precio de un instrumento, el valor de una posición o el valor de una cuenta y fije el nivel que debe alcanzar.",
        "<strong class='text-white'>Advanced Alert</strong>, varias condiciones combinadas. Usted decide si se activa cuando se cumplen <em>todas</em> o cuando se activa <em>cualquiera</em> de ellas.",
      ],
    },
    { type: "paragraph",html: "Toda condición se basa en el precio: tocar un nivel, cruzarlo por encima o cruzarlo por debajo. También puede crear una alerta directamente desde un gráfico o desde el DOM haciendo clic en una línea de precio, lo cual es mejor que teclear números a mano. Cuando una alerta se activa, su navegador reproduce un sonido, la campana muestra un punto rojo y cualquier nota que haya añadido aparece en una pequeña etiqueta debajo. La aplicación móvil puede enviar la misma alerta a su teléfono." },
    { type: "table", headers: ["Sobre qué quiere alertar","Ejemplo","¿Nativo en Tradovate?"], rows: [
      ["Precio del instrumento","ES toca 5,600","Sí"],
      ["Valor de la posición","El P&amp;L abierto llega a -$400","Sí"],
      ["Valor de la cuenta","El saldo cae por debajo de su línea","Sí"],
      ["Valor de un indicador","La EMA de 9 cruza la EMA de 21","No"],
      ["Condición de un estudio","El RSI cruza 70","No"],
    ] },
    { type: "heading",text: "Por qué no hay un botón de alertas de indicadores" },
    { type: "paragraph",html: "Las alertas de indicadores llevan años en la lista de deseos. Se habló de un servidor de alertas en la nube que empezaría con los estudios integrados de Tradovate, pero no ha llegado. Así que, ahora mismo, simplemente no hay ningún campo donde pueda decir \"avíseme cuando el MACD se cruce\". Incluso los indicadores personalizados que añade a un gráfico no pueden llevar sonido ni alerta. Cuando lo necesite, cree la alerta en otro lugar y enrútela hacia Tradovate. Tradovate sí dispone de una amplia biblioteca de indicadores de gráfico que puede mostrar, pero mostrar un estudio y recibir alertas de él son dos cosas distintas." },
    { type: "heading",text: "Cómo conseguir que funcionen las alertas basadas en indicadores" },
    { type: "paragraph",html: "La solución es sencilla: mantenga las alertas de precio de forma nativa y tome prestadas las alertas de indicadores de una plataforma que las admita." },
    {
      type: "steps",
      items: [
        { title: "Configure las alertas de precio que Tradovate sí admite", html: "Empiece por lo que ya está disponible. Haga clic en la campana de Alerts, añada una alerta Simple o Advanced y cubra los niveles de precio y de cuenta que importan, como un máximo de sesión, una zona de stop o una línea de drawdown. Se activan de forma fiable y no cuestan nada, así que no hay motivo para omitirlas." },
        { title: "Cree la alerta del indicador en TradingView", html: "TradingView lee los indicadores y lanza alertas a partir de ellos, justo el hueco que deja Tradovate. Cargue su estudio en un gráfico de TradingView, abra el panel de alertas y fije la condición sobre el propio indicador, por ejemplo una EMA rápida cruzando una lenta o el RSI tocando un nivel. Esta es la pieza que Tradovate no puede cubrir por sí solo." },
        { title: "Enrute esa alerta a Tradovate", html: "Ahora conecte ambos. Vincule Tradovate con TradingView mediante el complemento para poder actuar sobre la alerta sin salir de su flujo de trabajo, o envíe la alerta de TradingView a un puente de webhook que coloque la orden en Tradovate por usted. El enrutamiento manual mantiene a una persona en el proceso; un puente convierte la alerta del indicador en una operación automática." },
        { title: "Pruebe primero en una cuenta simulada", html: "Antes de arriesgar un solo centavo de dinero real, ejecute toda la cadena en una cuenta simulada de Tradovate. Confirme que la alerta se activa, que la señal llega y que la orden se coloca como pretendía. Si utiliza una cuenta de prop firm o de evaluación, las reglas de automatización varían según la firma y el tamaño de la cuenta, así que revise las reglas vigentes de su firma antes de pasar a real." },
      ],
    },
    { type: "heading",text: "En resumen" },
    { type: "paragraph",html: "Las alertas de Tradovate son herramientas de precio y de cuenta, y nada más. Son realmente útiles para avisos basados en niveles, pero no vigilarán un estudio por usted. Si su estrategia se basa en indicadores, cree esas alertas en TradingView y envíelas a Tradovate, ya sea a mano o mediante automatización. Esa combinación le da todo lo que le falta al menú de alertas nativo." },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "¿Quiere que sus alertas de indicadores de TradingView coloquen realmente operaciones en Tradovate? PickMyTrade convierte cada alerta en una orden real automáticamente, sin licencia de API ni programación." },
  ], fr: [
    { type: "paragraph",html: "Si vous attendez que Tradovate vous prévienne à l'instant où votre moyenne mobile se croise ou où le RSI touche 70, voici la version courte : cela n'arrivera pas. Les alertes intégrées de Tradovate surveillent le prix et les valeurs du compte, pas les indicateurs. Aucun paramètre ne permet de pointer une alerte vers une étude de votre graphique. C'est l'état réel de la plateforme aujourd'hui, et il n'a pas changé depuis longtemps." },
    { type: "paragraph",html: "Vous avez toutefois de bonnes options. Vous pouvez configurer des alertes de prix et de compte précises directement dans Tradovate, et obtenir de véritables alertes d'indicateurs en associant Tradovate à une plateforme qui lit réellement vos indicateurs. Voici comment les deux éléments s'articulent." },
    { type: "heading",text: "Ce que les alertes Tradovate peuvent réellement faire" },
    { type: "paragraph",html: "Cliquez sur l'icône de cloche Alerts en haut à gauche de l'espace de travail, juste à côté du bouton New +, et vous trouverez deux types d'alertes :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Simple Alert</strong>, une seule condition. Choisissez le prix d'un instrument, la valeur d'une position ou la valeur d'un compte, puis définissez le niveau à atteindre.",
        "<strong class='text-white'>Advanced Alert</strong>, plusieurs conditions empilées. Vous décidez si elle se déclenche lorsque <em>toutes</em> sont vraies ou lorsque <em>n'importe laquelle</em> se produit.",
      ],
    },
    { type: "paragraph",html: "Chaque condition repose sur le prix : toucher un niveau, le croiser à la hausse ou le croiser à la baisse. Vous pouvez aussi créer une alerte directement depuis un graphique ou le DOM en cliquant sur une ligne de prix, ce qui vaut mieux que de saisir les chiffres à la main. Lorsqu'une alerte se déclenche, votre navigateur émet un son, la cloche affiche un point rouge, et toute note jointe apparaît dans un petit drapeau en dessous. L'application mobile peut envoyer la même alerte sur votre téléphone." },
    { type: "table", headers: ["Sur quoi vous voulez être alerté","Exemple","Natif dans Tradovate ?"], rows: [
      ["Prix de l'instrument","ES touche 5,600","Oui"],
      ["Valeur de la position","Le P&amp;L ouvert atteint -$400","Oui"],
      ["Valeur du compte","Le solde passe sous votre seuil","Oui"],
      ["Valeur d'un indicateur","L'EMA 9 croise l'EMA 21","Non"],
      ["Condition d'une étude","Le RSI croise 70","Non"],
    ] },
    { type: "heading",text: "Pourquoi il n'existe pas de bouton d'alerte d'indicateur" },
    { type: "paragraph",html: "Les alertes d'indicateurs figurent sur la liste de souhaits depuis des années. Il a été question d'un serveur d'alertes dans le cloud qui commencerait par les études intégrées de Tradovate, mais il n'a pas vu le jour. Aujourd'hui, il n'existe donc tout simplement aucun champ où dire « prévenez-moi quand le MACD se croise ». Même les indicateurs personnalisés que vous ajoutez à un graphique ne peuvent porter ni son ni alerte. Quand vous en avez besoin, vous créez l'alerte ailleurs et vous l'acheminez vers Tradovate. Tradovate dispose bien d'une vaste bibliothèque d'indicateurs de graphique que vous pouvez afficher, mais afficher une étude et être alerté à partir d'elle sont deux choses différentes." },
    { type: "heading",text: "Comment faire fonctionner des alertes basées sur des indicateurs" },
    { type: "paragraph",html: "Le contournement est simple : gardez les alertes de prix en natif et empruntez les alertes d'indicateurs à une plateforme qui les prend en charge." },
    {
      type: "steps",
      items: [
        { title: "Configurez les alertes de prix que Tradovate prend en charge", html: "Commencez par ce qui existe déjà. Cliquez sur la cloche Alerts, ajoutez une alerte Simple ou Advanced et couvrez les niveaux de prix et de compte qui comptent, comme un plus haut de séance, une zone de stop ou un seuil de drawdown. Elles se déclenchent de manière fiable et ne coûtent rien : il n'y a donc aucune raison de les ignorer." },
        { title: "Créez l'alerte d'indicateur dans TradingView", html: "TradingView lit les indicateurs et déclenche des alertes à partir d'eux, exactement la lacune que laisse Tradovate. Chargez votre étude sur un graphique TradingView, ouvrez le panneau d'alertes et définissez la condition sur l'indicateur lui-même, par exemple une EMA rapide croisant une EMA lente ou le RSI touchant un niveau. C'est la pièce que Tradovate ne peut pas fournir seul." },
        { title: "Acheminez cette alerte vers Tradovate", html: "Connectez maintenant les deux. Reliez Tradovate à TradingView grâce au module complémentaire afin de pouvoir agir sur l'alerte sans quitter votre flux de travail, ou envoyez l'alerte TradingView vers un pont webhook qui passe l'ordre Tradovate à votre place. L'acheminement manuel garde un humain dans la boucle ; un pont transforme l'alerte d'indicateur en trade automatique." },
        { title: "Testez d'abord sur un compte simulé", html: "Avant qu'un seul centime d'argent réel ne soit en jeu, faites tourner toute la chaîne sur un compte simulé Tradovate. Vérifiez que l'alerte se déclenche, que le signal arrive et que l'ordre est passé comme prévu. Si vous êtes sur un compte de prop firm ou d'évaluation, les règles d'automatisation varient selon la firme et la taille du compte : vérifiez donc les règles en vigueur de votre firme avant de passer en réel." },
      ],
    },
    { type: "heading",text: "En résumé" },
    { type: "paragraph",html: "Les alertes de Tradovate sont des outils de prix et de compte, point final. Elles sont réellement utiles pour des avertissements basés sur des niveaux, mais elles ne surveilleront pas une étude à votre place. Si votre stratégie repose sur des indicateurs, créez ces alertes dans TradingView et acheminez-les vers Tradovate, à la main ou par automatisation. Cette combinaison vous apporte tout ce qui manque au menu d'alertes natif." },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
