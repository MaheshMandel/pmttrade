---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-daily-pnl-session";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Why Tradovate Daily P&L Uses a 5PM CT Session";
const META_DESCRIPTION =
  "Daily profit and loss and statements roll over at 5PM Central, not midnight. Here's why the trading session works this way and how to read them right.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Warum das tägliche G/V bei Tradovate eine Sitzung ab 17 Uhr CT nutzt", es: "Por qué el P&L diario de Tradovate usa una sesión de las 5PM CT", fr: "Pourquoi le P&L quotidien de Tradovate utilise une session à 17 h CT", it: "Perché il P&L giornaliero di Tradovate usa una sessione alle 17:00 CT" },
  dek: { en: "If your daily P&L looks like it flipped back to zero at a strange hour, you didn't miss a bug. Here's why the Tradovate trading day starts at 5PM Central, and how to read your Day P&L, statement, and risk limits against that boundary.", de: "Wenn Ihr tägliches G/V zu einer seltsamen Uhrzeit auf null zurückgesprungen zu sein scheint, haben Sie keinen Fehler übersehen. So erklärt sich, warum der Tradovate-Handelstag um 17 Uhr Central beginnt und wie Sie Ihr Day P&L, den Kontoauszug und Ihre Risikolimits an dieser Grenze ablesen.", es: "Si su P&L diario parece haber vuelto a cero a una hora extraña, no se le ha pasado ningún error. Aquí le explicamos por qué el día de trading de Tradovate empieza a las 5PM Central y cómo leer su Day P&L, su extracto y sus límites de riesgo con respecto a ese límite.", fr: "Si votre P&L quotidien semble être revenu à zéro à une heure étrange, vous n'avez pas manqué de bug. Voici pourquoi la journée de trading Tradovate commence à 17 h Central, et comment lire votre Day P&L, votre relevé et vos limites de risque par rapport à cette frontière.", it: "Se il Suo P&L giornaliero sembra essere tornato a zero a un orario strano, non Le è sfuggito alcun bug. Ecco perché la giornata di trading di Tradovate inizia alle 17:00 Central e come leggere Day P&L, estratto conto e limiti di rischio rispetto a quel confine." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "If your daily P&amp;L looks like it flipped back to zero at a strange hour, you didn't miss a bug. A Tradovate trading day doesn't begin at midnight. It begins at <strong class='text-white'>5:00 PM Central Time</strong>, the exact moment the CME futures session rolls into a new trade date. Everything the platform labels \"daily\" is measured from that mark: the Day P&amp;L column, the statement that lands in your inbox each night, and the daily loss limit that locks your account." },
    { type: "quote", html: "Short version: your trading day runs from 5PM Central to the next afternoon. Any fill after 5PM CT counts toward the <em>next</em> date's statement, and your daily P&amp;L counter resets at that same boundary." },
    { type: "heading", text: "What the 5PM CT Boundary Actually Means" },
    { type: "paragraph", html: "Futures trade nearly around the clock. The session opens Sunday at 5:00 PM Central, runs through the week, and pauses briefly each late afternoon (around 4:00 PM CT for the stock-index products) while the exchange settles positions and recalculates margin. Then it reopens at 5:00 PM CT under a fresh trade date. Tradovate simply follows that clock." },
    { type: "paragraph", html: "So a long you take at 6:00 PM CT Monday evening isn't a Monday trade in the platform's eyes. It's Tuesday's. That one fact clears up most end-of-day confusion: an overnight winner you closed before bed can land on what feels like \"tomorrow's\" statement, because the session it belongs to only closes the next afternoon." },
    { type: "paragraph", html: "Keep one thing straight: this is <em>local</em> Central Time, so it shifts with daylight saving. It stays 5PM in Chicago year-round, which is why the matching Eastern time drifts by an hour across the seasons. Don't hardcode a fixed offset from your own zone." },
    { type: "heading", text: "How to Read Your Daily P&L Against the Session" },
    {
      type: "steps",
      items: [
        { title: "Watch Live Day P&L in the Account Module", html: "Open the Account module and make sure the Day P&amp;L column is showing. This is your running profit and loss for the current session, updated in real time and net of fees and commissions. Watch it once through a 5PM CT rollover and you'll see it snap back to zero as the new session starts, even though your open position and its unrealized P&amp;L carry straight over." },
        { title: "Pull the Daily Statement From the Statements Report", html: "The account statement is generated after the session settles each night and is emailed to you automatically. You can also grab it inside the platform: open the reporting area and select the Statements report, then choose the daily statement for the date you want. This is the document that reconciles to your broker of record, so treat it as the source of truth over any quick on-screen tally." },
        { title: "Confirm the Trade Date on the Statement", html: "Read the trade date printed on the statement header before you compare numbers. If a fill happened after 5PM CT, it sits under the next trade date, not the calendar day the clock on your wall showed. When your own spreadsheet math doesn't match the statement, this is almost always why: you're bucketing trades by midnight, and the statement is bucketing them by the 5PM CT session. Line the two up and the gap disappears." },
        { title: "Line Up Your Risk Limits With the Same Reset", html: "Daily loss limits and daily profit triggers use the identical 5PM CT session start. Your daily loss is calculated on net P&amp;L from the beginning of the session, including fees, commissions, and both realized and open profit and loss, then it resets when the next session opens. If you're on a prop or evaluation account, the exact loss figure and how the reset is enforced vary by firm and account size, so check your firm's current rules." },
      ],
    },
    { type: "heading", text: "Common Mix-Ups This Clears Up" },
    { type: "table", headers: ["What you notice", "What's really happening"], rows: [
      ["Day P&L reset in the evening", "A new session started at 5PM CT, so the daily counter went back to zero."],
      ["An overnight trade shows on the next day's statement", "The fill happened after 5PM CT, so it belongs to the next trade date."],
      ["Your midnight-to-midnight math doesn't match the statement", "The statement buckets by the 5PM CT session, not calendar midnight."],
      ["A daily loss limit tripped \"early\"", "The limit is measured from 5PM CT; the amount varies by firm and account size."],
    ] },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Running a strategy from TradingView into Tradovate? <strong class='text-white'>PickMyTrade automates your Tradovate orders</strong> so your entries, exits, and risk fire on the same session clock without you babysitting the platform." },
  ], de: [
    { type: "paragraph",html: "Wenn Ihr tägliches G/V zu einer seltsamen Uhrzeit auf null zurückgesprungen zu sein scheint, haben Sie keinen Fehler übersehen. Ein Tradovate-Handelstag beginnt nicht um Mitternacht. Er beginnt um <strong class='text-white'>17:00 Uhr Central Time</strong>, genau in dem Moment, in dem die CME-Futures-Sitzung auf ein neues Handelsdatum wechselt. Alles, was die Plattform als „täglich“ bezeichnet, wird ab dieser Marke gemessen: die Spalte Day P&amp;L, der Kontoauszug, der jeden Abend in Ihrem Posteingang landet, und das tägliche Verlustlimit, das Ihr Konto sperrt." },
    { type: "quote",html: "Kurz gesagt: Ihr Handelstag läuft von 17 Uhr Central bis zum nächsten Nachmittag. Jeder Fill nach 17 Uhr CT zählt zum Kontoauszug des <em>nächsten</em> Datums, und Ihr täglicher G/V-Zähler wird an derselben Grenze zurückgesetzt." },
    { type: "heading",text: "Was die Grenze um 17 Uhr CT tatsächlich bedeutet" },
    { type: "paragraph",html: "Futures werden fast rund um die Uhr gehandelt. Die Sitzung öffnet sonntags um 17:00 Uhr Central, läuft durch die Woche und pausiert jeden späten Nachmittag kurz (bei den Aktienindex-Produkten gegen 16:00 Uhr CT), während die Börse Positionen abrechnet und die Margin neu berechnet. Danach öffnet sie um 17:00 Uhr CT erneut mit einem neuen Handelsdatum. Tradovate folgt schlicht dieser Uhr." },
    { type: "paragraph",html: "Ein Long, den Sie am Montagabend um 18:00 Uhr CT eingehen, ist in den Augen der Plattform daher kein Montags-Trade, sondern ein Dienstags-Trade. Diese eine Tatsache klärt die meisten Verwirrungen am Tagesende: Ein Gewinner über Nacht, den Sie vor dem Schlafengehen geschlossen haben, kann auf dem Kontoauszug von „morgen“ landen, weil die Sitzung, zu der er gehört, erst am nächsten Nachmittag endet." },
    { type: "paragraph",html: "Merken Sie sich eines: Es handelt sich um die <em>lokale</em> Central Time und sie verschiebt sich daher mit der Sommerzeit. In Chicago bleibt es ganzjährig 17 Uhr, weshalb sich die entsprechende Eastern-Zeit im Lauf der Jahreszeiten um eine Stunde verschiebt. Codieren Sie daher keinen festen Versatz von Ihrer eigenen Zeitzone aus fest." },
    { type: "heading",text: "So lesen Sie Ihr tägliches G/V im Verhältnis zur Sitzung" },
    {
      type: "steps",
      items: [
        { title: "Live-Day-P&L im Account-Modul beobachten", html: "Öffnen Sie das Account-Modul und stellen Sie sicher, dass die Spalte Day P&amp;L angezeigt wird. Das ist Ihr laufender Gewinn und Verlust für die aktuelle Sitzung, in Echtzeit aktualisiert und netto nach Gebühren und Provisionen. Beobachten Sie es einmal über einen Wechsel um 17 Uhr CT, und Sie sehen, wie es mit Beginn der neuen Sitzung auf null zurückspringt, obwohl Ihre offene Position und deren nicht realisiertes G/V einfach übernommen werden." },
        { title: "Tagesauszug im Bericht „Statements“ abrufen", html: "Der Kontoauszug wird nach der Abrechnung der Sitzung jeden Abend erstellt und Ihnen automatisch per E-Mail zugesandt. Sie können ihn auch in der Plattform abrufen: Öffnen Sie den Berichtsbereich, wählen Sie den Bericht Statements und dann den Tagesauszug für das gewünschte Datum. Dieses Dokument wird mit Ihrem Broker abgeglichen, betrachten Sie es daher als maßgebliche Quelle gegenüber jeder schnellen Rechnung auf dem Bildschirm." },
        { title: "Handelsdatum auf dem Kontoauszug prüfen", html: "Lesen Sie das im Kopf des Kontoauszugs aufgedruckte Handelsdatum, bevor Sie Zahlen vergleichen. Wurde ein Fill nach 17 Uhr CT ausgeführt, steht er unter dem nächsten Handelsdatum, nicht unter dem Kalendertag, den die Uhr an Ihrer Wand anzeigte. Wenn Ihre eigene Tabellenrechnung nicht mit dem Kontoauszug übereinstimmt, ist das fast immer der Grund: Sie ordnen Trades nach Mitternacht zu, der Kontoauszug dagegen nach der Sitzung ab 17 Uhr CT. Gleichen Sie beides ab, und die Differenz verschwindet." },
        { title: "Risikolimits auf dasselbe Zurücksetzen abstimmen", html: "Tägliche Verlustlimits und tägliche Gewinnschwellen nutzen denselben Sitzungsbeginn um 17 Uhr CT. Ihr Tagesverlust wird auf Basis des Netto-G/V seit Sitzungsbeginn berechnet, einschließlich Gebühren, Provisionen sowie realisiertem und offenem Gewinn und Verlust, und wird zurückgesetzt, sobald die nächste Sitzung öffnet. Wenn Sie ein Prop- oder Evaluierungskonto haben, hängen der genaue Verlustbetrag und die Durchsetzung des Zurücksetzens vom Unternehmen und der Kontogröße ab. Prüfen Sie daher die aktuellen Regeln Ihres Unternehmens." },
      ],
    },
    { type: "heading",text: "Häufige Verwechslungen, die sich damit klären" },
    { type: "table", headers: ["Was Ihnen auffällt","Was tatsächlich passiert"], rows: [
      ["Das Day P&L wurde am Abend zurückgesetzt","Um 17 Uhr CT begann eine neue Sitzung, daher ging der Tageszähler auf null zurück."],
      ["Ein Trade über Nacht erscheint auf dem Kontoauszug des nächsten Tages","Der Fill erfolgte nach 17 Uhr CT und gehört daher zum nächsten Handelsdatum."],
      ["Ihre Rechnung von Mitternacht bis Mitternacht stimmt nicht mit dem Kontoauszug überein","Der Kontoauszug ordnet nach der Sitzung ab 17 Uhr CT zu, nicht nach Kalendermitternacht."],
      ["Ein tägliches Verlustlimit wurde „früh“ ausgelöst","Das Limit wird ab 17 Uhr CT gemessen; der Betrag hängt vom Unternehmen und der Kontogröße ab."],
    ] },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "Sie führen eine Strategie von TradingView in Tradovate aus? <strong class='text-white'>PickMyTrade automatisiert Ihre Tradovate-Orders</strong>, sodass Ihre Einstiege, Ausstiege und Ihr Risiko nach derselben Sitzungsuhr ausgelöst werden, ohne dass Sie die Plattform beaufsichtigen müssen." },
  ], es: [
    { type: "paragraph",html: "Si su P&amp;L diario parece haber vuelto a cero a una hora extraña, no se le ha pasado ningún error. Un día de trading en Tradovate no empieza a medianoche. Empieza a las <strong class='text-white'>5:00 PM hora Central</strong>, el momento exacto en que la sesión de futuros del CME pasa a una nueva fecha de operaciones. Todo lo que la plataforma etiqueta como «diario» se mide desde esa marca: la columna Day P&amp;L, el extracto que llega a su bandeja de entrada cada noche y el límite de pérdida diaria que bloquea su cuenta." },
    { type: "quote",html: "En resumen: su día de trading va de las 5PM Central hasta la tarde siguiente. Cualquier ejecución posterior a las 5PM CT cuenta para el extracto de la <em>siguiente</em> fecha, y su contador de P&amp;L diario se reinicia en ese mismo límite." },
    { type: "heading",text: "Qué significa realmente el límite de las 5PM CT" },
    { type: "paragraph",html: "Los futuros se negocian casi las 24 horas. La sesión abre el domingo a las 5:00 PM Central, continúa durante la semana y se detiene brevemente cada tarde (alrededor de las 4:00 PM CT para los productos de índices bursátiles) mientras la bolsa liquida posiciones y recalcula el margen. Luego reabre a las 5:00 PM CT con una nueva fecha de operaciones. Tradovate simplemente sigue ese reloj." },
    { type: "paragraph",html: "Así, una posición larga que abre a las 6:00 PM CT del lunes por la noche no es una operación del lunes a ojos de la plataforma. Es del martes. Ese único dato aclara la mayoría de las confusiones de fin de día: una ganancia nocturna que cerró antes de acostarse puede aparecer en lo que parece el extracto de «mañana», porque la sesión a la que pertenece solo cierra la tarde siguiente." },
    { type: "paragraph",html: "Tenga presente una cosa: es hora Central <em>local</em>, así que cambia con el horario de verano. Sigue siendo las 5PM en Chicago todo el año, por lo que la hora del Este equivalente se desplaza una hora a lo largo de las estaciones. No fije un desfase constante desde su propia zona horaria." },
    { type: "heading",text: "Cómo leer su P&L diario con respecto a la sesión" },
    {
      type: "steps",
      items: [
        { title: "Vigile el Day P&L en vivo en el módulo Account", html: "Abra el módulo Account y asegúrese de que se muestra la columna Day P&amp;L. Es su ganancia y pérdida acumulada de la sesión actual, actualizada en tiempo real y neta de tarifas y comisiones. Obsérvela durante un cambio de las 5PM CT y verá cómo vuelve a cero cuando empieza la nueva sesión, aunque su posición abierta y su P&amp;L no realizado se mantengan." },
        { title: "Obtenga el extracto diario del informe Statements", html: "El extracto de cuenta se genera después de que la sesión se liquida cada noche y se le envía automáticamente por correo. También puede obtenerlo dentro de la plataforma: abra el área de informes, seleccione el informe Statements y elija el extracto diario de la fecha que desee. Este es el documento que se concilia con su bróker, así que considérelo la fuente de verdad frente a cualquier cálculo rápido en pantalla." },
        { title: "Confirme la fecha de operaciones en el extracto", html: "Lea la fecha de operaciones impresa en el encabezado del extracto antes de comparar cifras. Si una ejecución ocurrió después de las 5PM CT, figura bajo la siguiente fecha de operaciones, no bajo el día natural que marcaba el reloj de su pared. Cuando sus propios cálculos en una hoja de cálculo no coinciden con el extracto, casi siempre es por esto: usted agrupa las operaciones por medianoche y el extracto las agrupa por la sesión de las 5PM CT. Alinee ambos y la diferencia desaparece." },
        { title: "Alinee sus límites de riesgo con el mismo reinicio", html: "Los límites de pérdida diaria y los umbrales de beneficio diario usan el mismo inicio de sesión de las 5PM CT. Su pérdida diaria se calcula sobre el P&amp;L neto desde el inicio de la sesión, incluidas tarifas, comisiones y las ganancias y pérdidas realizadas y abiertas, y se reinicia cuando abre la siguiente sesión. Si opera una cuenta de prop firm o de evaluación, la cifra exacta de pérdida y la forma de aplicar el reinicio varían según la firma y el tamaño de la cuenta, así que consulte las reglas vigentes de su firma." },
      ],
    },
    { type: "heading",text: "Confusiones habituales que esto aclara" },
    { type: "table", headers: ["Lo que observa","Lo que realmente ocurre"], rows: [
      ["El Day P&L se reinició por la tarde-noche","Una nueva sesión empezó a las 5PM CT, por lo que el contador diario volvió a cero."],
      ["Una operación nocturna aparece en el extracto del día siguiente","La ejecución ocurrió después de las 5PM CT, por lo que pertenece a la siguiente fecha de operaciones."],
      ["Su cálculo de medianoche a medianoche no coincide con el extracto","El extracto agrupa por la sesión de las 5PM CT, no por la medianoche natural."],
      ["Un límite de pérdida diaria se activó «antes de tiempo»","El límite se mide desde las 5PM CT; el importe varía según la firma y el tamaño de la cuenta."],
    ] },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "¿Ejecuta una estrategia desde TradingView en Tradovate? <strong class='text-white'>PickMyTrade automatiza sus órdenes de Tradovate</strong> para que sus entradas, salidas y riesgo se lancen con el mismo reloj de sesión, sin que usted tenga que vigilar la plataforma." },
  ], fr: [
    { type: "paragraph",html: "Si votre P&amp;L quotidien semble être revenu à zéro à une heure étrange, vous n'avez pas manqué de bug. Une journée de trading Tradovate ne commence pas à minuit. Elle commence à <strong class='text-white'>17 h 00, heure Centrale</strong>, à l'instant précis où la session des futures du CME passe à une nouvelle date de négociation. Tout ce que la plateforme qualifie de « quotidien » est mesuré à partir de ce repère : la colonne Day P&amp;L, le relevé qui arrive dans votre boîte de réception chaque soir et la limite de perte quotidienne qui verrouille votre compte." },
    { type: "quote",html: "En bref : votre journée de trading va de 17 h Central jusqu'à l'après-midi suivant. Toute exécution après 17 h CT compte pour le relevé de la date <em>suivante</em>, et votre compteur de P&amp;L quotidien se réinitialise à cette même frontière." },
    { type: "heading",text: "Ce que signifie réellement la frontière de 17 h CT" },
    { type: "paragraph",html: "Les futures se négocient presque 24 heures sur 24. La session ouvre le dimanche à 17 h 00 Central, se poursuit toute la semaine et marque une brève pause chaque fin d'après-midi (vers 16 h 00 CT pour les produits sur indices boursiers) pendant que la bourse règle les positions et recalcule les marges. Elle rouvre ensuite à 17 h 00 CT sous une nouvelle date de négociation. Tradovate suit simplement cette horloge." },
    { type: "paragraph",html: "Ainsi, une position longue prise à 18 h 00 CT le lundi soir n'est pas un trade du lundi aux yeux de la plateforme. C'est un trade du mardi. Ce seul fait dissipe la plupart des confusions de fin de journée : un gain overnight clôturé avant d'aller dormir peut figurer sur ce qui semble être le relevé de « demain », car la session à laquelle il appartient ne se termine que l'après-midi suivant." },
    { type: "paragraph",html: "Retenez une chose : il s'agit de l'heure Centrale <em>locale</em>, qui suit donc l'heure d'été. Il reste 17 h à Chicago toute l'année, c'est pourquoi l'heure de l'Est correspondante varie d'une heure au fil des saisons. Ne codez pas en dur un décalage fixe à partir de votre propre fuseau horaire." },
    { type: "heading",text: "Comment lire votre P&L quotidien par rapport à la session" },
    {
      type: "steps",
      items: [
        { title: "Surveiller le Day P&L en direct dans le module Account", html: "Ouvrez le module Account et assurez-vous que la colonne Day P&amp;L est affichée. Il s'agit de vos gains et pertes cumulés de la session en cours, mis à jour en temps réel et nets de frais et de commissions. Observez-le lors d'un passage de 17 h CT et vous le verrez revenir à zéro au début de la nouvelle session, alors que votre position ouverte et son P&amp;L latent sont simplement reportés." },
        { title: "Récupérer le relevé quotidien dans le rapport Statements", html: "Le relevé de compte est généré après le règlement de la session chaque soir et vous est envoyé automatiquement par e-mail. Vous pouvez aussi le récupérer dans la plateforme : ouvrez la zone des rapports, sélectionnez le rapport Statements, puis choisissez le relevé quotidien de la date souhaitée. C'est le document qui se rapproche de votre courtier, considérez-le donc comme la source de vérité par rapport à tout calcul rapide à l'écran." },
        { title: "Confirmer la date de négociation sur le relevé", html: "Lisez la date de négociation imprimée dans l'en-tête du relevé avant de comparer les chiffres. Si une exécution a eu lieu après 17 h CT, elle figure sous la date de négociation suivante, et non sous le jour calendaire qu'indiquait l'horloge murale. Lorsque vos propres calculs dans un tableur ne correspondent pas au relevé, c'est presque toujours la raison : vous regroupez les trades par minuit, alors que le relevé les regroupe par session de 17 h CT. Alignez les deux et l'écart disparaît." },
        { title: "Aligner vos limites de risque sur la même réinitialisation", html: "Les limites de perte quotidienne et les seuils de gain quotidien utilisent le même début de session à 17 h CT. Votre perte quotidienne est calculée sur le P&amp;L net depuis le début de la session, y compris les frais, les commissions ainsi que les gains et pertes réalisés et ouverts, puis elle se réinitialise à l'ouverture de la session suivante. Si vous êtes sur un compte prop ou d'évaluation, le montant exact de la perte et la manière dont la réinitialisation est appliquée varient selon la société et la taille du compte ; vérifiez donc les règles en vigueur de votre société." },
      ],
    },
    { type: "heading",text: "Confusions courantes que cela dissipe" },
    { type: "table", headers: ["Ce que vous constatez","Ce qui se passe réellement"], rows: [
      ["Le Day P&L s'est réinitialisé en soirée","Une nouvelle session a commencé à 17 h CT, le compteur quotidien est donc revenu à zéro."],
      ["Un trade overnight figure sur le relevé du lendemain","L'exécution a eu lieu après 17 h CT ; elle appartient donc à la date de négociation suivante."],
      ["Votre calcul de minuit à minuit ne correspond pas au relevé","Le relevé regroupe par session de 17 h CT, et non par minuit calendaire."],
      ["Une limite de perte quotidienne s'est déclenchée « trop tôt »","La limite est mesurée à partir de 17 h CT ; le montant varie selon la société et la taille du compte."],
    ] },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Vous exécutez une stratégie de TradingView vers Tradovate ? <strong class='text-white'>PickMyTrade automatise vos ordres Tradovate</strong> afin que vos entrées, sorties et votre gestion du risque se déclenchent sur la même horloge de session, sans que vous ayez à surveiller la plateforme." },
  ], it: [
    { type: "paragraph",html: "Se il Suo P&amp;L giornaliero sembra essere tornato a zero a un orario strano, non Le è sfuggito alcun bug. Una giornata di trading di Tradovate non inizia a mezzanotte. Inizia alle <strong class='text-white'>17:00 Central Time</strong>, il momento esatto in cui la sessione dei futures CME passa a una nuova data di negoziazione. Tutto ciò che la piattaforma definisce «giornaliero» viene misurato da quel punto: la colonna Day P&amp;L, l'estratto conto che arriva ogni sera nella Sua casella di posta e il limite di perdita giornaliera che blocca il Suo conto." },
    { type: "quote",html: "In breve: la Sua giornata di trading va dalle 17:00 Central al pomeriggio successivo. Qualsiasi esecuzione dopo le 17:00 CT conta per l'estratto conto della data <em>successiva</em>, e il Suo contatore di P&amp;L giornaliero si azzera allo stesso confine." },
    { type: "heading",text: "Cosa significa davvero il confine delle 17:00 CT" },
    { type: "paragraph",html: "I futures si negoziano quasi 24 ore su 24. La sessione apre la domenica alle 17:00 Central, prosegue per tutta la settimana e si ferma brevemente ogni tardo pomeriggio (verso le 16:00 CT per i prodotti sugli indici azionari) mentre la borsa regola le posizioni e ricalcola il margine. Poi riapre alle 17:00 CT con una nuova data di negoziazione. Tradovate segue semplicemente quell'orologio." },
    { type: "paragraph",html: "Quindi un long aperto alle 18:00 CT del lunedì sera non è un trade del lunedì per la piattaforma. È un trade del martedì. Questo solo fatto chiarisce la maggior parte delle confusioni di fine giornata: un trade vincente overnight chiuso prima di andare a dormire può finire su quello che sembra l'estratto conto di «domani», perché la sessione a cui appartiene si chiude solo il pomeriggio successivo." },
    { type: "paragraph",html: "Tenga presente una cosa: si tratta dell'ora Central <em>locale</em>, quindi cambia con l'ora legale. Resta alle 17:00 a Chicago tutto l'anno, motivo per cui l'ora Eastern corrispondente cambia di un'ora nel corso delle stagioni. Non codifichi uno scostamento fisso partendo dal Suo fuso orario." },
    { type: "heading",text: "Come leggere il P&L giornaliero rispetto alla sessione" },
    {
      type: "steps",
      items: [
        { title: "Osservare il Day P&L in tempo reale nel modulo Account", html: "Apra il modulo Account e si assicuri che la colonna Day P&amp;L sia visibile. È il Suo profitto e la Sua perdita correnti per la sessione in corso, aggiornati in tempo reale e al netto di commissioni e spese. Lo osservi durante un passaggio delle 17:00 CT e vedrà che torna a zero all'avvio della nuova sessione, mentre la Sua posizione aperta e il relativo P&amp;L non realizzato vengono semplicemente riportati." },
        { title: "Scaricare l'estratto conto giornaliero dal report Statements", html: "L'estratto conto viene generato dopo il regolamento della sessione ogni sera e Le viene inviato automaticamente via e-mail. Può anche recuperarlo nella piattaforma: apra l'area dei report, selezioni il report Statements e scelga l'estratto conto giornaliero per la data desiderata. Questo è il documento che si riconcilia con il Suo broker, quindi lo consideri la fonte di verità rispetto a qualsiasi conteggio rapido a schermo." },
        { title: "Verificare la data di negoziazione sull'estratto conto", html: "Legga la data di negoziazione riportata nell'intestazione dell'estratto conto prima di confrontare i numeri. Se un'esecuzione è avvenuta dopo le 17:00 CT, si trova sotto la data di negoziazione successiva, non sotto il giorno di calendario indicato dall'orologio alla Sua parete. Quando i Suoi calcoli su un foglio di calcolo non corrispondono all'estratto conto, quasi sempre è per questo motivo: raggruppa i trade per mezzanotte, mentre l'estratto conto li raggruppa per la sessione delle 17:00 CT. Allinei i due criteri e la differenza scompare." },
        { title: "Allineare i limiti di rischio allo stesso azzeramento", html: "I limiti di perdita giornaliera e le soglie di profitto giornaliero usano lo stesso inizio di sessione alle 17:00 CT. La Sua perdita giornaliera viene calcolata sul P&amp;L netto dall'inizio della sessione, comprese commissioni, spese e profitti e perdite realizzati e aperti, quindi si azzera all'apertura della sessione successiva. Se utilizza un conto prop o di valutazione, l'importo esatto della perdita e le modalità di applicazione dell'azzeramento variano in base alla società e alla dimensione del conto, quindi verifichi le regole attuali della Sua società." },
      ],
    },
    { type: "heading",text: "Confusioni comuni che questo chiarisce" },
    { type: "table", headers: ["Cosa nota","Cosa sta realmente accadendo"], rows: [
      ["Il Day P&L si è azzerato in serata","Alle 17:00 CT è iniziata una nuova sessione, quindi il contatore giornaliero è tornato a zero."],
      ["Un trade overnight compare sull'estratto conto del giorno successivo","L'esecuzione è avvenuta dopo le 17:00 CT, quindi appartiene alla data di negoziazione successiva."],
      ["Il Suo calcolo da mezzanotte a mezzanotte non corrisponde all'estratto conto","L'estratto conto raggruppa per la sessione delle 17:00 CT, non per la mezzanotte di calendario."],
      ["Un limite di perdita giornaliera è scattato «in anticipo»","Il limite è misurato dalle 17:00 CT; l'importo varia in base alla società e alla dimensione del conto."],
    ] },
    { type: "heading",text: "Automatizzi tutto questo con PickMyTrade" },
