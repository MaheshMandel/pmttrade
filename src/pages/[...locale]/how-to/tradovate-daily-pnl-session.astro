  ] },
  ctaHeading: { en: "Automate Your Tradovate Trades", de: "Automatisieren Sie Ihre Tradovate-Trades", es: "Automatice sus operaciones en Tradovate", fr: "Automatisez vos trades Tradovate", it: "Automatizzi i Suoi trade su Tradovate" },
  ctaText: { en: "Running a strategy from TradingView into Tradovate? Let PickMyTrade fire your entries, exits, and risk on the same session clock without you babysitting the platform.", de: "Sie führen eine Strategie von TradingView in Tradovate aus? Lassen Sie PickMyTrade Ihre Einstiege, Ausstiege und Ihr Risiko nach derselben Sitzungsuhr auslösen, ohne dass Sie die Plattform beaufsichtigen müssen.", es: "¿Ejecuta una estrategia desde TradingView en Tradovate? Deje que PickMyTrade lance sus entradas, salidas y riesgo con el mismo reloj de sesión, sin que usted tenga que vigilar la plataforma.", fr: "Vous exécutez une stratégie de TradingView vers Tradovate ? Laissez PickMyTrade déclencher vos entrées, sorties et votre gestion du risque sur la même horloge de session, sans que vous ayez à surveiller la plateforme.", it: "Esegue una strategia da TradingView su Tradovate? Lasci che PickMyTrade attivi le Sue entrate, uscite e il rischio sullo stesso orologio di sessione, senza dover sorvegliare la piattaforma." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Does the Tradovate trading day start at midnight?", a: "No. It starts at 5:00 PM Central Time, when the futures session opens a new trade date. Daily P&L, statements, and daily risk limits all reset from that point." },
    { q: "Why is a trade I placed tonight on tomorrow's statement?", a: "Because it filled after 5PM CT. Any fill after the session start belongs to the next trade date, so it lands on the statement for the following calendar day." },
  ], de: [
    { q: "Beginnt der Tradovate-Handelstag um Mitternacht?", a: "Nein. Er beginnt um 17:00 Uhr Central Time, wenn die Futures-Sitzung ein neues Handelsdatum eröffnet. Tägliches G/V, Kontoauszüge und tägliche Risikolimits werden ab diesem Zeitpunkt zurückgesetzt." },
    { q: "Warum steht ein Trade von heute Abend auf dem Kontoauszug von morgen?", a: "Weil er nach 17 Uhr CT ausgeführt wurde. Jeder Fill nach Sitzungsbeginn gehört zum nächsten Handelsdatum und erscheint daher auf dem Kontoauszug für den folgenden Kalendertag." },
  ], es: [
    { q: "¿Empieza el día de trading de Tradovate a medianoche?", a: "No. Empieza a las 5:00 PM hora Central, cuando la sesión de futuros abre una nueva fecha de operaciones. El P&L diario, los extractos y los límites de riesgo diarios se reinician desde ese momento." },
    { q: "¿Por qué una operación que hice esta noche aparece en el extracto de mañana?", a: "Porque se ejecutó después de las 5PM CT. Cualquier ejecución posterior al inicio de la sesión pertenece a la siguiente fecha de operaciones, por lo que aparece en el extracto del día natural siguiente." },
  ], fr: [
    { q: "La journée de trading Tradovate commence-t-elle à minuit ?", a: "Non. Elle commence à 17 h 00, heure Centrale, lorsque la session des futures ouvre une nouvelle date de négociation. Le P&L quotidien, les relevés et les limites de risque quotidiennes se réinitialisent à partir de ce moment." },
    { q: "Pourquoi un trade passé ce soir figure-t-il sur le relevé de demain ?", a: "Parce qu'il a été exécuté après 17 h CT. Toute exécution après le début de la session appartient à la date de négociation suivante et apparaît donc sur le relevé du jour calendaire suivant." },
  ], it: [
    { q: "La giornata di trading di Tradovate inizia a mezzanotte?", a: "No. Inizia alle 17:00 Central Time, quando la sessione dei futures apre una nuova data di negoziazione. P&L giornaliero, estratti conto e limiti di rischio giornalieri si azzerano da quel momento." },
    { q: "Perché un trade eseguito stasera compare sull'estratto conto di domani?", a: "Perché è stato eseguito dopo le 17:00 CT. Qualsiasi esecuzione successiva all'inizio della sessione appartiene alla data di negoziazione successiva, quindi compare sull'estratto conto del giorno di calendario seguente." },
  ] },
  relatedHeading: { en: "Related Guides", de: "Verwandte Anleitungen", es: "Guías relacionadas", fr: "Guides associés", it: "Guide correlate" },
