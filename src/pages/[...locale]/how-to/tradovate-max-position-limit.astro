---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-max-position-limit";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Set a Max Position Limit in Tradovate Risk Settings";
const META_DESCRIPTION =
  "Tradovate max position limit: set a Max Position Size in Risk Settings to cap open contracts across all products and stop oversized futures orders.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Ein Max-Positionslimit in den Tradovate-Risikoeinstellungen festlegen", es: "Configure un límite de posición máxima en los ajustes de riesgo de Tradovate", fr: "Définir une limite de position maximale dans les paramètres de risque Tradovate", it: "Impostare un limite di posizione massima nelle impostazioni di rischio di Tradovate" },
  dek: { en: "Want a hard ceiling on how many contracts you can hold at once in Tradovate? A few clicks in Risk Settings gives you a Max Position Size a runaway order can't blow past.", de: "Möchten Sie eine feste Obergrenze dafür, wie viele Kontrakte Sie in Tradovate gleichzeitig halten können? Mit wenigen Klicks in den Risk Settings erhalten Sie eine Max Position Size, die eine außer Kontrolle geratene Order nicht überschreiten kann.", es: "¿Quiere un tope firme de contratos que puede mantener a la vez en Tradovate? Con unos pocos clics en Risk Settings obtiene un Max Position Size que una orden descontrolada no puede superar.", fr: "Vous voulez un plafond strict au nombre de contrats que vous pouvez détenir en même temps dans Tradovate ? Quelques clics dans Risk Settings vous donnent une Max Position Size qu'un ordre incontrôlé ne peut pas franchir.", it: "Vuole un tetto rigido al numero di contratti che può detenere contemporaneamente in Tradovate? Con pochi clic in Risk Settings ottiene una Max Position Size che un ordine fuori controllo non può superare." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Want a hard ceiling on how many contracts you can hold at once in Tradovate? Maybe you're protecting a funded evaluation, holding yourself to a trading plan, or wiring up automation like PickMyTrade. Either way, a few clicks in Risk Settings gives you a <strong class='text-white'>Max Position Size</strong> that a runaway order simply can't blow past. Here's how to set it." },
    { type: "heading", text: "What a Max Position Limit Actually Does" },
    { type: "paragraph", html: "A max position limit, Tradovate labels it <strong class='text-white'>Max Position Size</strong>, is an account-level risk control. It caps the total number of contracts you can hold open at any one time, and that cap applies across all products, not per symbol. Hit the ceiling and Tradovate rejects any order that would push you past it. Simple as that. It's your guardrail against fat-finger sizing, over-leverage, or an algo that keeps piling onto a position that's already full." },
    { type: "heading", text: "Set a Max Position Limit in Tradovate: Step by Step" },
    {
      type: "steps",
      items: [
        { title: "Open Application Settings", html: "Log in to Tradovate, web or desktop, doesn't matter, and open <strong class='text-white'>Application Settings</strong> from the button in the upper-right corner of the toolbar.", image: { src: `${IMG}/tradovate-max-position-limit-1.png`, alt: "Tradovate Application Settings button in the top-right toolbar" } },
        { title: "Open the Accounts Tab and Risk Settings", html: "Inside Application Settings, click the <strong class='text-white'>Accounts</strong> tab, select the account you want to protect, and hit the <strong class='text-white'>Risk Settings</strong> button to expand the risk-control panel.", image: { src: `${IMG}/tradovate-max-position-limit-2.png`, alt: "Tradovate Application Settings Accounts tab showing the Risk Settings button" } },
        { title: "Enable Max Position Size and Enter a Value", html: "Scroll to <strong class='text-white'>Max Position Size</strong>, flip its toggle on, and type the maximum number of contracts you want open at once, say, 3. Remember, that number is your overall ceiling across every product you trade, not a per-symbol limit. Three means three contracts total.", image: { src: `${IMG}/tradovate-max-position-limit-3.png`, alt: "Tradovate Risk Settings showing the Max Position Size toggle and contract value field" } },
        { title: "Save and Test the Limit", html: "Save your settings, then prove it works. Try to open more contracts than your cap allows. Tradovate should reject the order that would breach the limit and leave your position sitting right at the maximum you set.", image: { src: `${IMG}/tradovate-max-position-limit-4.png`, alt: "Tradovate order rejected after exceeding the Max Position Size limit" } },
      ],
    },
    { type: "heading", text: "Why You'd Want This" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Enforce your trading plan</strong>, kill the revenge trade or the \"sure thing\" before you can over-size into it.",
        "<strong class='text-white'>Protect a funded or evaluation account</strong>, stay inside the risk box instead of tripping a hard rule.",
        "<strong class='text-white'>Contain your automation</strong>, cap the damage if a strategy or webhook misfires and fires repeat entries.",
        "<strong class='text-white'>Keep multi-account discipline</strong>, hold every account you trade to the same sizing ceiling.",
      ],
    },
    { type: "paragraph", html: "One thing to watch if you're a prop trader: on a prop-firm or evaluation account, the firm usually stacks its own position caps on top of yours. Those limits vary by firm and account size, so check your firm's current rules. A firm-side cap can reject an order even when your personal Max Position Size would have allowed it." },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "<strong class='text-white'>PickMyTrade links your TradingView alerts straight to your Tradovate account</strong>, so your sizing rules ride along with every automated order, no manual clicks, no oversized entries slipping through. Set your quantity once and let validated orders route to a single account or many at the same time." },
  ], de: [
    { type: "paragraph",html: "Möchten Sie eine feste Obergrenze dafür, wie viele Kontrakte Sie in Tradovate gleichzeitig halten können? Vielleicht schützen Sie eine finanzierte Evaluierung, halten sich an Ihren Handelsplan oder richten eine Automatisierung wie PickMyTrade ein. In jedem Fall erhalten Sie mit wenigen Klicks in den Risk Settings eine <strong class='text-white'>Max Position Size</strong>, die eine außer Kontrolle geratene Order schlicht nicht überschreiten kann. So legen Sie sie fest." },
    { type: "heading",text: "Was ein Max-Positionslimit tatsächlich bewirkt" },
    { type: "paragraph",html: "Ein Max-Positionslimit, bei Tradovate als <strong class='text-white'>Max Position Size</strong> bezeichnet, ist eine Risikokontrolle auf Kontoebene. Es begrenzt die Gesamtzahl der Kontrakte, die Sie zu einem Zeitpunkt offen halten können, und diese Grenze gilt über alle Produkte hinweg, nicht pro Symbol. Erreichen Sie die Obergrenze, lehnt Tradovate jede Order ab, die Sie darüber hinausbringen würde. So einfach ist das. Es ist Ihre Leitplanke gegen Vertipper bei der Größe, Überhebelung oder einen Algo, der immer weiter auf eine bereits volle Position aufstockt." },
    { type: "heading",text: "Max-Positionslimit in Tradovate festlegen: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Application Settings öffnen", html: "Melden Sie sich bei Tradovate an, im Web oder auf dem Desktop, das spielt keine Rolle, und öffnen Sie <strong class='text-white'>Application Settings</strong> über die Schaltfläche in der oberen rechten Ecke der Symbolleiste.", image: {"src":`${IMG}/tradovate-max-position-limit-1.png`,"alt":"Schaltfläche Application Settings von Tradovate in der Symbolleiste oben rechts"} },
        { title: "Den Tab Accounts und Risk Settings öffnen", html: "Klicken Sie in den Application Settings auf den Tab <strong class='text-white'>Accounts</strong>, wählen Sie das Konto aus, das Sie schützen möchten, und klicken Sie auf die Schaltfläche <strong class='text-white'>Risk Settings</strong>, um das Panel mit den Risikokontrollen zu erweitern.", image: {"src":`${IMG}/tradovate-max-position-limit-2.png`,"alt":"Tab Accounts in den Tradovate Application Settings mit der Schaltfläche Risk Settings"} },
        { title: "Max Position Size aktivieren und einen Wert eingeben", html: "Scrollen Sie zu <strong class='text-white'>Max Position Size</strong>, schalten Sie den Schalter ein und geben Sie die maximale Anzahl an Kontrakten ein, die Sie gleichzeitig offen haben möchten, zum Beispiel 3. Denken Sie daran: Diese Zahl ist Ihre Gesamtobergrenze über alle gehandelten Produkte hinweg, kein Limit pro Symbol. Drei bedeutet insgesamt drei Kontrakte.", image: {"src":`${IMG}/tradovate-max-position-limit-3.png`,"alt":"Tradovate Risk Settings mit dem Schalter Max Position Size und dem Feld für die Kontraktanzahl"} },
        { title: "Speichern und das Limit testen", html: "Speichern Sie Ihre Einstellungen und prüfen Sie dann, ob es funktioniert. Versuchen Sie, mehr Kontrakte zu eröffnen, als Ihre Grenze erlaubt. Tradovate sollte die Order ablehnen, die das Limit überschreiten würde, und Ihre Position genau auf dem von Ihnen festgelegten Maximum belassen.", image: {"src":`${IMG}/tradovate-max-position-limit-4.png`,"alt":"Von Tradovate abgelehnte Order nach Überschreiten des Max-Position-Size-Limits"} },
      ],
    },
    { type: "heading",text: "Warum Sie das wollen" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Setzen Sie Ihren Handelsplan durch</strong>: Beenden Sie den Revenge-Trade oder den „sicheren Tipp“, bevor Sie sich damit überdimensionieren können.",
        "<strong class='text-white'>Schützen Sie ein finanziertes oder Evaluierungskonto</strong>: Bleiben Sie innerhalb des Risikorahmens, statt eine harte Regel zu verletzen.",
        "<strong class='text-white'>Begrenzen Sie Ihre Automatisierung</strong>: Deckeln Sie den Schaden, falls eine Strategie oder ein Webhook fehlerhaft auslöst und wiederholte Einstiege sendet.",
        "<strong class='text-white'>Behalten Sie Disziplin über mehrere Konten</strong>: Halten Sie jedes Konto, das Sie handeln, an dieselbe Größenobergrenze.",
      ],
    },
    { type: "paragraph",html: "Ein Hinweis, wenn Sie Prop-Trader sind: Bei einem Prop-Firm- oder Evaluierungskonto setzt die Firma in der Regel eigene Positionslimits zusätzlich zu Ihren. Diese Limits unterscheiden sich je nach Firma und Kontogröße, prüfen Sie daher die aktuellen Regeln Ihrer Firma. Ein Limit der Firma kann eine Order ablehnen, selbst wenn Ihre persönliche Max Position Size sie erlaubt hätte." },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "<strong class='text-white'>PickMyTrade verbindet Ihre TradingView-Alerts direkt mit Ihrem Tradovate-Konto</strong>, sodass Ihre Größenregeln jede automatisierte Order begleiten, ohne manuelle Klicks und ohne durchrutschende übergroße Einstiege. Legen Sie Ihre Menge einmal fest und lassen Sie validierte Orders an ein einzelnes Konto oder an mehrere gleichzeitig weiterleiten." },
  ], es: [
    { type: "paragraph",html: "¿Quiere un tope firme de contratos que puede mantener a la vez en Tradovate? Quizá esté protegiendo una evaluación financiada, siguiendo su plan de trading o configurando una automatización como PickMyTrade. En cualquier caso, con unos pocos clics en Risk Settings obtiene un <strong class='text-white'>Max Position Size</strong> que una orden descontrolada sencillamente no puede superar. Así se configura." },
    { type: "heading",text: "Qué hace realmente un límite de posición máxima" },
    { type: "paragraph",html: "Un límite de posición máxima, que Tradovate denomina <strong class='text-white'>Max Position Size</strong>, es un control de riesgo a nivel de cuenta. Limita el número total de contratos que puede mantener abiertos en un momento dado, y ese tope se aplica a todos los productos, no por símbolo. Al alcanzar el techo, Tradovate rechaza cualquier orden que lo hiciera superarlo. Así de simple. Es su barrera de protección contra errores de dedo en el tamaño, el sobreapalancamiento o un algoritmo que sigue acumulando sobre una posición que ya está llena." },
    { type: "heading",text: "Configurar un límite de posición máxima en Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra Application Settings", html: "Inicie sesión en Tradovate, en la web o en el escritorio, da igual, y abra <strong class='text-white'>Application Settings</strong> desde el botón de la esquina superior derecha de la barra de herramientas.", image: {"src":`${IMG}/tradovate-max-position-limit-1.png`,"alt":"Botón Application Settings de Tradovate en la barra de herramientas superior derecha"} },
        { title: "Abra la pestaña Accounts y Risk Settings", html: "Dentro de Application Settings, haga clic en la pestaña <strong class='text-white'>Accounts</strong>, seleccione la cuenta que desea proteger y pulse el botón <strong class='text-white'>Risk Settings</strong> para desplegar el panel de controles de riesgo.", image: {"src":`${IMG}/tradovate-max-position-limit-2.png`,"alt":"Pestaña Accounts de Application Settings de Tradovate con el botón Risk Settings"} },
        { title: "Active Max Position Size e introduzca un valor", html: "Desplácese hasta <strong class='text-white'>Max Position Size</strong>, active su interruptor y escriba el número máximo de contratos que quiere tener abiertos a la vez, por ejemplo, 3. Recuerde que ese número es su techo global para todos los productos que opera, no un límite por símbolo. Tres significa tres contratos en total.", image: {"src":`${IMG}/tradovate-max-position-limit-3.png`,"alt":"Risk Settings de Tradovate con el interruptor Max Position Size y el campo del valor de contratos"} },
        { title: "Guarde y pruebe el límite", html: "Guarde su configuración y compruebe que funciona. Intente abrir más contratos de los que permite su tope. Tradovate debería rechazar la orden que superaría el límite y dejar su posición justo en el máximo que fijó.", image: {"src":`${IMG}/tradovate-max-position-limit-4.png`,"alt":"Orden rechazada en Tradovate tras superar el límite de Max Position Size"} },
      ],
    },
    { type: "heading",text: "Por qué le conviene" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Haga cumplir su plan de trading</strong>: elimine la operación de venganza o la «apuesta segura» antes de poder sobredimensionarla.",
        "<strong class='text-white'>Proteja una cuenta financiada o de evaluación</strong>: manténgase dentro del marco de riesgo en lugar de incumplir una regla estricta.",
        "<strong class='text-white'>Contenga su automatización</strong>: limite el daño si una estrategia o un webhook falla y dispara entradas repetidas.",
        "<strong class='text-white'>Mantenga la disciplina en varias cuentas</strong>: sujete todas las cuentas que opera al mismo tope de tamaño.",
      ],
    },
    { type: "paragraph",html: "Un aspecto a vigilar si es trader de prop firm: en una cuenta de prop firm o de evaluación, la firma suele añadir sus propios límites de posición sobre los suyos. Esos límites varían según la firma y el tamaño de la cuenta, así que revise las reglas actuales de su firma. Un límite de la firma puede rechazar una orden incluso cuando su Max Position Size personal la habría permitido." },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "<strong class='text-white'>PickMyTrade conecta sus alertas de TradingView directamente con su cuenta de Tradovate</strong>, de modo que sus reglas de tamaño acompañan a cada orden automatizada, sin clics manuales y sin que se cuelen entradas sobredimensionadas. Fije su cantidad una vez y deje que las órdenes validadas se envíen a una sola cuenta o a varias al mismo tiempo." },
  ], fr: [
    { type: "paragraph",html: "Vous voulez un plafond strict au nombre de contrats que vous pouvez détenir en même temps dans Tradovate ? Peut-être protégez-vous une évaluation financée, vous en tenez-vous à votre plan de trading ou mettez-vous en place une automatisation comme PickMyTrade. Dans tous les cas, quelques clics dans Risk Settings vous donnent une <strong class='text-white'>Max Position Size</strong> qu'un ordre incontrôlé ne peut tout simplement pas franchir. Voici comment la définir." },
    { type: "heading",text: "Ce que fait réellement une limite de position maximale" },
    { type: "paragraph",html: "Une limite de position maximale, que Tradovate appelle <strong class='text-white'>Max Position Size</strong>, est un contrôle de risque au niveau du compte. Elle plafonne le nombre total de contrats que vous pouvez détenir ouverts à un instant donné, et ce plafond s'applique à tous les produits, pas par symbole. Une fois le plafond atteint, Tradovate rejette tout ordre qui vous ferait le dépasser. Aussi simple que cela. C'est votre garde-fou contre les fautes de frappe sur la taille, le surlevier ou un algorithme qui continue d'empiler sur une position déjà pleine." },
    { type: "heading",text: "Définir une limite de position maximale dans Tradovate : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir Application Settings", html: "Connectez-vous à Tradovate, sur le web ou le bureau, peu importe, et ouvrez <strong class='text-white'>Application Settings</strong> depuis le bouton situé dans le coin supérieur droit de la barre d'outils.", image: {"src":`${IMG}/tradovate-max-position-limit-1.png`,"alt":"Bouton Application Settings de Tradovate dans la barre d'outils en haut à droite"} },
        { title: "Ouvrir l'onglet Accounts et Risk Settings", html: "Dans Application Settings, cliquez sur l'onglet <strong class='text-white'>Accounts</strong>, sélectionnez le compte que vous souhaitez protéger, puis cliquez sur le bouton <strong class='text-white'>Risk Settings</strong> pour développer le panneau des contrôles de risque.", image: {"src":`${IMG}/tradovate-max-position-limit-2.png`,"alt":"Onglet Accounts des Application Settings de Tradovate avec le bouton Risk Settings"} },
        { title: "Activer Max Position Size et saisir une valeur", html: "Faites défiler jusqu'à <strong class='text-white'>Max Position Size</strong>, activez son interrupteur et saisissez le nombre maximal de contrats que vous voulez ouverts en même temps, par exemple 3. N'oubliez pas que ce nombre est votre plafond global sur tous les produits que vous tradez, pas une limite par symbole. Trois signifie trois contrats au total.", image: {"src":`${IMG}/tradovate-max-position-limit-3.png`,"alt":"Risk Settings de Tradovate avec l'interrupteur Max Position Size et le champ de valeur en contrats"} },
        { title: "Enregistrer et tester la limite", html: "Enregistrez vos paramètres, puis vérifiez que cela fonctionne. Essayez d'ouvrir plus de contrats que votre plafond ne le permet. Tradovate doit rejeter l'ordre qui dépasserait la limite et laisser votre position exactement au maximum que vous avez défini.", image: {"src":`${IMG}/tradovate-max-position-limit-4.png`,"alt":"Ordre rejeté dans Tradovate après dépassement de la limite Max Position Size"} },
      ],
    },
    { type: "heading",text: "Pourquoi vous voudrez l'activer" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Faites respecter votre plan de trading</strong> : coupez court au revenge trade ou au « coup sûr » avant de pouvoir vous surdimensionner.",
        "<strong class='text-white'>Protégez un compte financé ou d'évaluation</strong> : restez dans le cadre de risque au lieu de déclencher une règle stricte.",
        "<strong class='text-white'>Contenez votre automatisation</strong> : plafonnez les dégâts si une stratégie ou un webhook se déclenche à tort et envoie des entrées répétées.",
        "<strong class='text-white'>Gardez de la discipline sur plusieurs comptes</strong> : imposez à chaque compte que vous tradez le même plafond de taille.",
      ],
    },
    { type: "paragraph",html: "Un point à surveiller si vous êtes trader prop : sur un compte de prop firm ou d'évaluation, la firme ajoute généralement ses propres plafonds de position par-dessus les vôtres. Ces limites varient selon la firme et la taille du compte ; vérifiez donc les règles actuelles de votre firme. Un plafond côté firme peut rejeter un ordre même si votre Max Position Size personnelle l'aurait autorisé." },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "<strong class='text-white'>PickMyTrade relie directement vos alertes TradingView à votre compte Tradovate</strong>, de sorte que vos règles de taille accompagnent chaque ordre automatisé, sans clics manuels et sans entrées surdimensionnées qui passent. Définissez votre quantité une fois et laissez les ordres validés être acheminés vers un seul compte ou vers plusieurs en même temps." },
  ], it: [
    { type: "paragraph",html: "Vuole un tetto rigido al numero di contratti che può detenere contemporaneamente in Tradovate? Magari sta proteggendo una valutazione finanziata, rispettando il suo piano di trading o configurando un'automazione come PickMyTrade. In ogni caso, con pochi clic in Risk Settings ottiene una <strong class='text-white'>Max Position Size</strong> che un ordine fuori controllo semplicemente non può superare. Ecco come impostarla." },
    { type: "heading",text: "Cosa fa realmente un limite di posizione massima" },
    { type: "paragraph",html: "Un limite di posizione massima, che Tradovate chiama <strong class='text-white'>Max Position Size</strong>, è un controllo del rischio a livello di account. Limita il numero totale di contratti che può detenere aperti in un dato momento, e questo tetto vale per tutti i prodotti, non per singolo simbolo. Una volta raggiunto il limite, Tradovate rifiuta qualsiasi ordine che la porterebbe oltre. Semplice così. È la sua protezione contro errori di digitazione nella dimensione, eccesso di leva o un algoritmo che continua ad accumulare su una posizione già piena." },
    { type: "heading",text: "Impostare un limite di posizione massima in Tradovate: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Apra Application Settings", html: "Acceda a Tradovate, da web o da desktop, non fa differenza, e apra <strong class='text-white'>Application Settings</strong> dal pulsante nell'angolo in alto a destra della barra degli strumenti.", image: {"src":`${IMG}/tradovate-max-position-limit-1.png`,"alt":"Pulsante Application Settings di Tradovate nella barra degli strumenti in alto a destra"} },
        { title: "Apra la scheda Accounts e Risk Settings", html: "In Application Settings faccia clic sulla scheda <strong class='text-white'>Accounts</strong>, selezioni l'account che vuole proteggere e prema il pulsante <strong class='text-white'>Risk Settings</strong> per espandere il pannello dei controlli di rischio.", image: {"src":`${IMG}/tradovate-max-position-limit-2.png`,"alt":"Scheda Accounts di Application Settings di Tradovate con il pulsante Risk Settings"} },
        { title: "Attivi Max Position Size e inserisca un valore", html: "Scorra fino a <strong class='text-white'>Max Position Size</strong>, attivi l'interruttore e digiti il numero massimo di contratti che vuole avere aperti contemporaneamente, per esempio 3. Ricordi che quel numero è il suo tetto complessivo su tutti i prodotti che negozia, non un limite per simbolo. Tre significa tre contratti in totale.", image: {"src":`${IMG}/tradovate-max-position-limit-3.png`,"alt":"Risk Settings di Tradovate con l'interruttore Max Position Size e il campo del valore in contratti"} },
        { title: "Salvi e verifichi il limite", html: "Salvi le impostazioni, poi verifichi che funzioni. Provi ad aprire più contratti di quanti ne consenta il suo tetto. Tradovate dovrebbe rifiutare l'ordine che supererebbe il limite e lasciare la sua posizione esattamente al massimo impostato.", image: {"src":`${IMG}/tradovate-max-position-limit-4.png`,"alt":"Ordine rifiutato in Tradovate dopo aver superato il limite di Max Position Size"} },
      ],
    },
    { type: "heading",text: "Perché le conviene" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Faccia rispettare il suo piano di trading</strong>: elimini il revenge trade o la «cosa sicura» prima di poterla sovradimensionare.",
        "<strong class='text-white'>Protegga un account finanziato o di valutazione</strong>: resti entro il perimetro di rischio invece di violare una regola rigida.",
        "<strong class='text-white'>Contenga la sua automazione</strong>: limiti i danni se una strategia o un webhook si attiva per errore e invia ingressi ripetuti.",
        "<strong class='text-white'>Mantenga la disciplina su più account</strong>: sottoponga ogni account che negozia allo stesso tetto di dimensione.",
      ],
    },
