---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-simple-advanced-alerts";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Tradovate Simple vs Advanced Alerts Explained";
const META_DESCRIPTION =
  "See how single-condition Simple alerts differ from multi-condition Advanced alerts in Tradovate, plus step-by-step setup for price and account triggers.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Einfache vs. erweiterte Alerts in Tradovate erklärt", es: "Alertas simples frente a avanzadas en Tradovate, explicadas", fr: "Alertes simples et avancées dans Tradovate expliquées", it: "Alert semplici e avanzati in Tradovate spiegati" },
  dek: { en: "Both alert types in Tradovate do the same job: they watch the market or your account and ping you when something you care about happens. Here's how each works and how to set them up.", de: "Beide Alert-Typen in Tradovate erfüllen dieselbe Aufgabe: Sie beobachten den Markt oder Ihr Konto und melden sich, wenn etwas Wichtiges passiert. So funktioniert jeder Typ und so richten Sie sie ein.", es: "Ambos tipos de alerta de Tradovate hacen el mismo trabajo: vigilan el mercado o su cuenta y le avisan cuando ocurre algo que le interesa. Así funciona cada una y cómo configurarlas.", fr: "Les deux types d’alerte de Tradovate font le même travail : ils surveillent le marché ou votre compte et vous préviennent quand quelque chose d’important se produit. Voici comment fonctionne chacun et comment les configurer.", it: "Entrambi i tipi di alert di Tradovate svolgono lo stesso compito: tengono d’occhio il mercato o il Suo conto e La avvisano quando accade qualcosa che Le interessa. Ecco come funziona ciascuno e come configurarli." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-10",
  blocks: { en: [
    { type: "paragraph", html: "Both alert types in Tradovate do the same job: they watch the market or your account and ping you when something you care about happens. The difference is how many things they watch at once. A Simple alert tracks one condition. An Advanced alert tracks several and lets you decide whether all of them, or just one, has to be true before it fires. Here's how each works and how to set them up." },
    { type: "heading", text: "Simple vs Advanced at a Glance" },
    {
      type: "table",
      headers: ["", "Simple alert", "Advanced alert"],
      rows: [
        ["Conditions", "One", "Two or more"],
        ["Trigger logic", "Fires on that single condition", "Fires when all conditions match, or when any one does"],
        ["Watches", "Instrument price, Position, or Account value", "Any mix of Instrument, Position, and Account values"],
        ["Best for", "\"Tell me when ES touches 5,000.\"", "\"Tell me when ES touches 5,000 and my open P&L is above $500.\""],
      ],
    },
    { type: "heading", text: "What a Simple Alert Does" },
    { type: "paragraph", html: "A Simple alert is a single-condition trigger. You point it at one thing, an instrument's price, a position value, or an account value, and set the level. When that level is hit, the alert fires. Think price crossing a key support line, an open position reaching a certain profit, or your balance dropping below a number you don't want to cross. It's the fastest alert to set up and what most traders reach for day to day." },
    { type: "heading", text: "What an Advanced Alert Adds" },
    { type: "paragraph", html: "An Advanced alert is built the same way, but you're not stuck with one condition. You can stack several, then tell Tradovate whether they all have to be true at once or whether any single one is enough. That \"all versus any\" switch is the whole point. \"All\" is an AND filter that only fires when the full setup lines up. \"Any\" is an OR net that catches whichever condition trips first." },
    { type: "heading", text: "How to Set Up Alerts in Tradovate: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open the New Alert Menu", html: "In the Tradovate web app, look at the top-left corner for the bell-shaped Alerts icon, sitting right next to the New + button. Click it to open the New Alert menu. This is also where your Alerts Log lives, so you'll come back here to review anything that has fired.", image: { src: `${IMG}/tradovate-simple-advanced-alerts-1.png`, alt: "Tradovate web app top-left toolbar showing the bell-shaped Alerts icon next to the New plus button" } },
        { title: "Build a Simple Alert (One Condition)", html: "Start by choosing what the alert should watch: an Instrument price, a Position parameter, or an Account parameter. Next, set the condition, whether the value should be greater than, less than, or equal to your number. Then type the trigger Value using your keyboard or the arrow buttons. Stop here and you've got a Simple alert: one thing watched, one level, one trigger.", image: { src: `${IMG}/tradovate-simple-advanced-alerts-2.png`, alt: "Tradovate New Alert menu showing the Instrument, Position, Account selector with a condition and Value field for a single-condition Simple alert" } },
        { title: "Turn It Into an Advanced Alert (Multiple Conditions)", html: "Want more than one condition? Click the green +Add button to drop in another one, and repeat for as many as you need. Made a mistake? The trash-can icon next to a condition removes it. Once you have two or more, choose the logic: fire when <strong class='text-white'>all</strong> conditions are met, or fire when <strong class='text-white'>any</strong> single condition is met. That choice is what turns a plain trigger into a proper multi-condition Advanced alert.", image: { src: `${IMG}/tradovate-simple-advanced-alerts-3.png`, alt: "Tradovate Advanced alert with two stacked conditions, the green plus Add button, a trash-can remove icon, and the all-versus-any logic toggle" } },
        { title: "Set Duration and Notification, Then Create", html: "Decide how long the alert should stay live using the Duration dropdown: keep it active until it triggers, until you cancel it yourself, or until a specific date and time. Pick your notification type too, sound, a popup, or both. When it's ready, click Create. Once an alert fires, your browser plays a sound, a red dot appears on the bell icon, and any custom message you added shows up in a small flag beneath it.", image: { src: `${IMG}/tradovate-simple-advanced-alerts-4.png`, alt: "Tradovate alert setup showing the Duration dropdown, notification type options, and the Create button" } },
        { title: "Manage Alerts From the Alerts Log", html: "Back at the bell icon, open the Alerts Log (the List of Alerts tab) to see everything in one place, split into Active, Triggered, and Disabled. From here you can Edit an alert's conditions, Reset one that already fired so it can trigger again, Disable it temporarily, or Delete it for good. Sweep it now and then so stale alerts aren't firing on levels you moved past long ago.", image: { src: `${IMG}/tradovate-simple-advanced-alerts-5.png`, alt: "Tradovate Alerts Log showing Active, Triggered, and Disabled alerts with Edit, Reset, Disable, and Delete controls" } },
      ],
    },
    { type: "heading", text: "Which One Should You Use?" },
    { type: "paragraph", html: "Reach for a Simple alert when a single level tells you everything you need: a price, a profit figure, a balance. Step up to an Advanced alert when a decision depends on more than one thing lining up, like price at a level <em>and</em> your position sitting at a certain size. Start simple, and only add conditions when the extra precision earns its keep." },
    { type: "heading", text: "From Alert to Automatic Execution" },
    { type: "paragraph", html: "Alerts tell you when your setup hits, but you still have to click the trade yourself. If you want the entry to fire on its own, PickMyTrade routes your TradingView alerts straight to your Tradovate account, so the order goes in automatically the moment your condition triggers." },
  ], de: [
    { type: "paragraph",html: "Beide Alert-Typen in Tradovate erfüllen dieselbe Aufgabe: Sie beobachten den Markt oder Ihr Konto und melden sich, wenn etwas Wichtiges passiert. Der Unterschied liegt darin, wie viele Dinge sie gleichzeitig überwachen. Ein einfacher Alert verfolgt eine Bedingung. Ein erweiterter Alert verfolgt mehrere und lässt Sie entscheiden, ob alle oder nur eine davon zutreffen muss, bevor er auslöst. So funktioniert jeder und so richten Sie sie ein." },
    { type: "heading",text: "Einfach vs. erweitert im Überblick" },
    { type: "table", headers: ["","Einfacher Alert","Erweiterter Alert"], rows: [
      ["Bedingungen","Eine","Zwei oder mehr"],
      ["Auslöselogik","Löst bei dieser einen Bedingung aus","Löst aus, wenn alle Bedingungen erfüllt sind oder wenn eine davon erfüllt ist"],
      ["Überwacht","Instrument-Preis, Position oder Account-Wert","Beliebige Kombination aus Instrument-, Position- und Account-Werten"],
      ["Am besten für","„Sag mir Bescheid, wenn ES 5,000 berührt.“","„Sag mir Bescheid, wenn ES 5,000 berührt und mein offener P&L über $500 liegt.“"],
    ] },
    { type: "heading",text: "Was ein einfacher Alert leistet" },
    { type: "paragraph",html: "Ein einfacher Alert ist ein Auslöser mit einer einzigen Bedingung. Sie richten ihn auf eine Sache, den Preis eines Instruments, einen Positionswert oder einen Kontowert, und legen das Niveau fest. Wird dieses Niveau erreicht, löst der Alert aus. Denken Sie an einen Kurs, der eine wichtige Unterstützung kreuzt, eine offene Position, die einen bestimmten Gewinn erreicht, oder Ihr Kontostand, der unter eine Marke fällt, die Sie nicht unterschreiten wollen. Er ist der schnellste Alert zum Einrichten und das, wonach die meisten Trader im Alltag greifen." },
    { type: "heading",text: "Was ein erweiterter Alert zusätzlich bietet" },
    { type: "paragraph",html: "Ein erweiterter Alert wird auf dieselbe Weise erstellt, aber Sie sind nicht auf eine Bedingung beschränkt. Sie können mehrere stapeln und Tradovate dann sagen, ob alle gleichzeitig zutreffen müssen oder ob eine einzige genügt. Dieser Schalter „alle versus eine“ ist der ganze Sinn. „All“ ist ein UND-Filter, der nur auslöst, wenn das gesamte Setup zusammenpasst. „Any“ ist ein ODER-Netz, das fängt, welche Bedingung auch immer zuerst anspringt." },
    { type: "heading",text: "Alerts in Tradovate einrichten: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Das Menü „New Alert“ öffnen", html: "Suchen Sie in der Tradovate-Web-App oben links nach dem glockenförmigen Alerts-Symbol direkt neben der Schaltfläche New +. Klicken Sie darauf, um das Menü New Alert zu öffnen. Hier befindet sich auch Ihr Alerts Log, Sie kommen also hierher zurück, um alles zu prüfen, was ausgelöst wurde.", image: {"src":`${IMG}/tradovate-simple-advanced-alerts-1.png`,"alt":"Obere linke Symbolleiste der Tradovate-Web-App mit dem glockenförmigen Alerts-Symbol neben der Schaltfläche New plus"} },
        { title: "Einen einfachen Alert erstellen (eine Bedingung)", html: "Wählen Sie zuerst, was der Alert beobachten soll: einen Instrument-Preis, einen Position-Parameter oder einen Account-Parameter. Legen Sie dann die Bedingung fest, ob der Wert größer als, kleiner als oder gleich Ihrer Zahl sein soll. Geben Sie anschließend den Auslöser-Wert (Value) per Tastatur oder mit den Pfeiltasten ein. Hören Sie hier auf, und Sie haben einen einfachen Alert: eine beobachtete Größe, ein Niveau, ein Auslöser.", image: {"src":`${IMG}/tradovate-simple-advanced-alerts-2.png`,"alt":"Tradovate-Menü New Alert mit der Auswahl Instrument, Position, Account sowie Bedingung und Value-Feld für einen einfachen Alert mit einer Bedingung"} },
        { title: "In einen erweiterten Alert umwandeln (mehrere Bedingungen)", html: "Möchten Sie mehr als eine Bedingung? Klicken Sie auf die grüne Schaltfläche +Add, um eine weitere hinzuzufügen, und wiederholen Sie das so oft, wie nötig. Fehler gemacht? Das Papierkorb-Symbol neben einer Bedingung entfernt sie. Sobald Sie zwei oder mehr haben, wählen Sie die Logik: Auslösen, wenn <strong class='text-white'>alle</strong> Bedingungen erfüllt sind, oder auslösen, wenn <strong class='text-white'>eine</strong> einzelne Bedingung erfüllt ist. Diese Wahl macht aus einem schlichten Auslöser einen echten erweiterten Alert mit mehreren Bedingungen.", image: {"src":`${IMG}/tradovate-simple-advanced-alerts-3.png`,"alt":"Erweiterter Tradovate-Alert mit zwei gestapelten Bedingungen, der grünen Schaltfläche plus Add, einem Papierkorb-Symbol zum Entfernen und dem Umschalter Logik alle oder eine"} },
        { title: "Dauer und Benachrichtigung festlegen, dann erstellen", html: "Legen Sie mit dem Dropdown Duration fest, wie lange der Alert aktiv bleiben soll: bis er auslöst, bis Sie ihn selbst abbrechen oder bis zu einem bestimmten Datum und einer bestimmten Uhrzeit. Wählen Sie auch die Benachrichtigungsart, Ton, Popup oder beides. Wenn alles bereit ist, klicken Sie auf Create. Sobald ein Alert auslöst, spielt Ihr Browser einen Ton ab, ein roter Punkt erscheint am Glockensymbol, und eine von Ihnen hinzugefügte eigene Nachricht wird in einem kleinen Fähnchen darunter angezeigt.", image: {"src":`${IMG}/tradovate-simple-advanced-alerts-4.png`,"alt":"Tradovate-Alert-Einrichtung mit dem Dropdown Duration, den Benachrichtigungsoptionen und der Schaltfläche Create"} },
        { title: "Alerts im Alerts Log verwalten", html: "Öffnen Sie am Glockensymbol den Alerts Log (den Tab List of Alerts), um alles an einem Ort zu sehen, aufgeteilt in Active, Triggered und Disabled. Von hier aus können Sie die Bedingungen eines Alerts mit Edit ändern, einen bereits ausgelösten Alert mit Reset zurücksetzen, damit er erneut auslösen kann, ihn mit Disable vorübergehend deaktivieren oder ihn mit Delete endgültig löschen. Räumen Sie hier ab und zu auf, damit keine veralteten Alerts auf Niveaus auslösen, die Sie längst hinter sich gelassen haben.", image: {"src":`${IMG}/tradovate-simple-advanced-alerts-5.png`,"alt":"Tradovate Alerts Log mit Active-, Triggered- und Disabled-Alerts sowie den Bedienelementen Edit, Reset, Disable und Delete"} },
      ],
    },
    { type: "heading",text: "Welchen sollten Sie verwenden?" },
    { type: "paragraph",html: "Greifen Sie zu einem einfachen Alert, wenn ein einzelnes Niveau alles sagt, was Sie wissen müssen: ein Preis, ein Gewinnbetrag, ein Kontostand. Steigen Sie auf einen erweiterten Alert um, wenn eine Entscheidung davon abhängt, dass mehrere Dinge zusammenpassen, etwa der Preis auf einem Niveau <em>und</em> Ihre Position in einer bestimmten Größe. Beginnen Sie einfach und fügen Sie Bedingungen nur hinzu, wenn sich die zusätzliche Präzision lohnt." },
    { type: "heading",text: "Vom Alert zur automatischen Ausführung" },
    { type: "paragraph",html: "Alerts melden Ihnen, wann Ihr Setup eintritt, aber den Trade müssen Sie weiterhin selbst klicken. Wenn der Einstieg von allein erfolgen soll, leitet PickMyTrade Ihre TradingView-Alerts direkt an Ihr Tradovate-Konto weiter, sodass die Order automatisch aufgegeben wird, sobald Ihre Bedingung auslöst." },
  ], es: [
    { type: "paragraph",html: "Ambos tipos de alerta de Tradovate hacen el mismo trabajo: vigilan el mercado o su cuenta y le avisan cuando ocurre algo que le interesa. La diferencia está en cuántas cosas vigilan a la vez. Una alerta simple sigue una condición. Una alerta avanzada sigue varias y le permite decidir si deben cumplirse todas o basta con una antes de dispararse. Así funciona cada una y cómo configurarlas." },
    { type: "heading",text: "Simple frente a avanzada de un vistazo" },
    { type: "table", headers: ["","Alerta simple","Alerta avanzada"], rows: [
      ["Condiciones","Una","Dos o más"],
      ["Lógica de disparo","Se dispara con esa única condición","Se dispara cuando se cumplen todas las condiciones o cuando se cumple cualquiera de ellas"],
      ["Vigila","Precio de Instrument, Position o valor de Account","Cualquier combinación de valores de Instrument, Position y Account"],
      ["Ideal para","\"Avíseme cuando ES toque 5,000.\"","\"Avíseme cuando ES toque 5,000 y mi P&L abierto supere los $500.\""],
    ] },
    { type: "heading",text: "Qué hace una alerta simple" },
    { type: "paragraph",html: "Una alerta simple es un disparador de una sola condición. La apunta a una cosa, el precio de un instrumento, el valor de una posición o el valor de una cuenta, y fija el nivel. Cuando se alcanza ese nivel, la alerta se dispara. Piense en un precio que cruza una línea de soporte clave, una posición abierta que alcanza cierta ganancia o su saldo cayendo por debajo de una cifra que no quiere cruzar. Es la alerta más rápida de configurar y a la que la mayoría recurre en el día a día." },
    { type: "heading",text: "Qué añade una alerta avanzada" },
    { type: "paragraph",html: "Una alerta avanzada se construye igual, pero no está limitado a una condición. Puede apilar varias y luego indicar a Tradovate si deben cumplirse todas a la vez o si basta con una. Ese interruptor \"todas frente a cualquiera\" es el punto central. \"All\" es un filtro AND que solo se dispara cuando todo el setup coincide. \"Any\" es una red OR que capta la condición que salte primero." },
    { type: "heading",text: "Cómo configurar alertas en Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra el menú New Alert", html: "En la aplicación web de Tradovate, mire en la esquina superior izquierda: verá el icono de campana de Alerts junto al botón New +. Haga clic para abrir el menú New Alert. Aquí también está su Alerts Log, así que volverá aquí para revisar todo lo que se haya disparado.", image: {"src":`${IMG}/tradovate-simple-advanced-alerts-1.png`,"alt":"Barra de herramientas superior izquierda de la aplicación web de Tradovate con el icono de campana de Alerts junto al botón New plus"} },
        { title: "Cree una alerta simple (una condición)", html: "Empiece eligiendo qué debe vigilar la alerta: un precio de Instrument, un parámetro de Position o un parámetro de Account. Después fije la condición: si el valor debe ser mayor que, menor que o igual a su número. A continuación escriba el Value del disparador con el teclado o con los botones de flecha. Si se detiene aquí, tiene una alerta simple: una cosa vigilada, un nivel, un disparador.", image: {"src":`${IMG}/tradovate-simple-advanced-alerts-2.png`,"alt":"Menú New Alert de Tradovate con el selector Instrument, Position, Account y una condición con campo Value para una alerta simple de una condición"} },
        { title: "Conviértala en una alerta avanzada (varias condiciones)", html: "¿Quiere más de una condición? Haga clic en el botón verde +Add para añadir otra y repita cuantas veces necesite. ¿Se ha equivocado? El icono de papelera junto a una condición la elimina. Cuando tenga dos o más, elija la lógica: dispararse cuando se cumplan <strong class='text-white'>todas</strong> las condiciones, o dispararse cuando se cumpla <strong class='text-white'>cualquiera</strong> de ellas. Esa elección es lo que convierte un simple disparador en una verdadera alerta avanzada de varias condiciones.", image: {"src":`${IMG}/tradovate-simple-advanced-alerts-3.png`,"alt":"Alerta avanzada de Tradovate con dos condiciones apiladas, el botón verde plus Add, un icono de papelera para eliminar y el interruptor de lógica todas o cualquiera"} },
        { title: "Fije la duración y la notificación, y cree la alerta", html: "Decida cuánto tiempo debe permanecer activa la alerta con el menú desplegable Duration: hasta que se dispare, hasta que usted la cancele o hasta una fecha y hora concretas. Elija también el tipo de notificación: sonido, ventana emergente o ambos. Cuando esté lista, haga clic en Create. Cuando una alerta se dispara, su navegador reproduce un sonido, aparece un punto rojo en el icono de campana y cualquier mensaje personalizado que haya añadido se muestra en una pequeña bandera debajo.", image: {"src":`${IMG}/tradovate-simple-advanced-alerts-4.png`,"alt":"Configuración de alerta de Tradovate con el menú desplegable Duration, las opciones de tipo de notificación y el botón Create"} },
        { title: "Gestione las alertas desde el Alerts Log", html: "De vuelta en el icono de campana, abra el Alerts Log (la pestaña List of Alerts) para ver todo en un solo lugar, dividido en Active, Triggered y Disabled. Desde aquí puede usar Edit para modificar las condiciones de una alerta, Reset para reiniciar una que ya se disparó y que pueda volver a dispararse, Disable para desactivarla temporalmente o Delete para eliminarla definitivamente. Revíselo de vez en cuando para que no queden alertas obsoletas disparándose en niveles que superó hace tiempo.", image: {"src":`${IMG}/tradovate-simple-advanced-alerts-5.png`,"alt":"Alerts Log de Tradovate con alertas Active, Triggered y Disabled y los controles Edit, Reset, Disable y Delete"} },
      ],
    },
    { type: "heading",text: "¿Cuál debería usar?" },
    { type: "paragraph",html: "Recurra a una alerta simple cuando un único nivel le diga todo lo que necesita: un precio, una cifra de ganancia, un saldo. Pase a una alerta avanzada cuando una decisión dependa de que coincidan varias cosas, como el precio en un nivel <em>y</em> su posición con un tamaño determinado. Empiece por lo simple y añada condiciones solo cuando la precisión extra lo justifique." },
    { type: "heading",text: "De la alerta a la ejecución automática" },
    { type: "paragraph",html: "Las alertas le avisan cuando se da su setup, pero aún tiene que hacer clic en la operación usted mismo. Si quiere que la entrada se dispare sola, PickMyTrade enruta sus alertas de TradingView directamente a su cuenta de Tradovate, de modo que la orden entra automáticamente en cuanto se activa su condición." },
  ], fr: [
    { type: "paragraph",html: "Les deux types d’alerte de Tradovate font le même travail : ils surveillent le marché ou votre compte et vous préviennent quand quelque chose d’important se produit. La différence tient au nombre d’éléments surveillés simultanément. Une alerte simple suit une condition. Une alerte avancée en suit plusieurs et vous laisse décider si toutes, ou une seule, doivent être vraies avant de se déclencher. Voici comment fonctionne chacune et comment les configurer." },
    { type: "heading",text: "Simple et avancée en un coup d’œil" },
    { type: "table", headers: ["","Alerte simple","Alerte avancée"], rows: [
      ["Conditions","Une","Deux ou plus"],
      ["Logique de déclenchement","Se déclenche sur cette condition unique","Se déclenche quand toutes les conditions sont remplies, ou quand l’une d’elles l’est"],
      ["Surveille","Prix d’Instrument, Position ou valeur de Account","Toute combinaison de valeurs d’Instrument, de Position et de Account"],
      ["Idéal pour","« Préviens-moi quand ES touche 5,000. »","« Préviens-moi quand ES touche 5,000 et que mon P&L ouvert dépasse $500. »"],
    ] },
    { type: "heading",text: "Ce que fait une alerte simple" },
    { type: "paragraph",html: "Une alerte simple est un déclencheur à condition unique. Vous la pointez sur un élément, le prix d’un instrument, la valeur d’une position ou celle d’un compte, et vous fixez le niveau. Quand ce niveau est atteint, l’alerte se déclenche. Pensez à un prix qui franchit un support clé, à une position ouverte qui atteint un certain gain ou à votre solde qui passe sous un seuil que vous ne voulez pas franchir. C’est l’alerte la plus rapide à configurer et celle que la plupart des traders utilisent au quotidien." },
    { type: "heading",text: "Ce qu’ajoute une alerte avancée" },
    { type: "paragraph",html: "Une alerte avancée se construit de la même façon, mais vous n’êtes pas limité à une seule condition. Vous pouvez en empiler plusieurs, puis indiquer à Tradovate si elles doivent toutes être vraies en même temps ou si une seule suffit. Ce choix « toutes ou une seule » est tout l’intérêt. « All » est un filtre ET qui ne se déclenche que lorsque tout le setup s’aligne. « Any » est un filet OU qui attrape la condition qui se déclenche en premier." },
    { type: "heading",text: "Comment configurer des alertes dans Tradovate : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez le menu New Alert", html: "Dans l’application web Tradovate, regardez en haut à gauche : l’icône de cloche Alerts se trouve juste à côté du bouton New +. Cliquez dessus pour ouvrir le menu New Alert. C’est aussi là que se trouve votre Alerts Log ; vous reviendrez donc ici pour consulter tout ce qui s’est déclenché.", image: {"src":`${IMG}/tradovate-simple-advanced-alerts-1.png`,"alt":"Barre d’outils en haut à gauche de l’application web Tradovate avec l’icône de cloche Alerts à côté du bouton New plus"} },
        { title: "Créez une alerte simple (une condition)", html: "Commencez par choisir ce que l’alerte doit surveiller : un prix d’Instrument, un paramètre de Position ou un paramètre de Account. Définissez ensuite la condition : la valeur doit-elle être supérieure à, inférieure à ou égale à votre nombre. Saisissez enfin la Value de déclenchement avec le clavier ou les boutons fléchés. Arrêtez-vous ici et vous avez une alerte simple : un élément surveillé, un niveau, un déclencheur.", image: {"src":`${IMG}/tradovate-simple-advanced-alerts-2.png`,"alt":"Menu New Alert de Tradovate avec le sélecteur Instrument, Position, Account, une condition et un champ Value pour une alerte simple à une condition"} },
        { title: "Transformez-la en alerte avancée (plusieurs conditions)", html: "Vous voulez plus d’une condition ? Cliquez sur le bouton vert +Add pour en ajouter une autre, et répétez autant que nécessaire. Une erreur ? L’icône de corbeille à côté d’une condition la supprime. Dès que vous en avez deux ou plus, choisissez la logique : se déclencher quand <strong class='text-white'>toutes</strong> les conditions sont remplies, ou quand <strong class='text-white'>n’importe laquelle</strong> l’est. Ce choix transforme un simple déclencheur en véritable alerte avancée à plusieurs conditions.", image: {"src":`${IMG}/tradovate-simple-advanced-alerts-3.png`,"alt":"Alerte avancée Tradovate avec deux conditions empilées, le bouton vert plus Add, une icône de corbeille pour supprimer et le sélecteur de logique toutes ou n’importe laquelle"} },
        { title: "Définissez la durée et la notification, puis créez", html: "Décidez combien de temps l’alerte doit rester active avec la liste déroulante Duration : jusqu’à ce qu’elle se déclenche, jusqu’à ce que vous l’annuliez vous-même ou jusqu’à une date et une heure précises. Choisissez aussi le type de notification : son, fenêtre contextuelle ou les deux. Quand tout est prêt, cliquez sur Create. Lorsqu’une alerte se déclenche, votre navigateur joue un son, un point rouge apparaît sur l’icône de cloche et tout message personnalisé que vous avez ajouté s’affiche dans un petit drapeau en dessous.", image: {"src":`${IMG}/tradovate-simple-advanced-alerts-4.png`,"alt":"Configuration d’alerte Tradovate avec la liste déroulante Duration, les options de type de notification et le bouton Create"} },
        { title: "Gérez les alertes depuis l’Alerts Log", html: "De retour sur l’icône de cloche, ouvrez l’Alerts Log (l’onglet List of Alerts) pour tout voir au même endroit, réparti entre Active, Triggered et Disabled. De là, vous pouvez utiliser Edit pour modifier les conditions d’une alerte, Reset pour réinitialiser une alerte déjà déclenchée afin qu’elle puisse se redéclencher, Disable pour la désactiver temporairement ou Delete pour la supprimer définitivement. Faites un peu de ménage de temps en temps pour que des alertes obsolètes ne se déclenchent pas sur des niveaux que vous avez dépassés depuis longtemps.", image: {"src":`${IMG}/tradovate-simple-advanced-alerts-5.png`,"alt":"Alerts Log de Tradovate affichant les alertes Active, Triggered et Disabled avec les commandes Edit, Reset, Disable et Delete"} },
      ],
    },
    { type: "heading",text: "Laquelle utiliser ?" },
    { type: "paragraph",html: "Choisissez une alerte simple quand un seul niveau vous dit tout ce qu’il faut savoir : un prix, un chiffre de gain, un solde. Passez à une alerte avancée quand une décision dépend de la conjonction de plusieurs éléments, comme un prix à un niveau <em>et</em> votre position à une certaine taille. Commencez simple, et n’ajoutez des conditions que lorsque la précision supplémentaire en vaut la peine." },
    { type: "heading",text: "De l’alerte à l’exécution automatique" },
    { type: "paragraph",html: "Les alertes vous disent quand votre setup se présente, mais vous devez encore cliquer le trade vous-même. Si vous voulez que l’entrée parte toute seule, PickMyTrade achemine vos alertes TradingView directement vers votre compte Tradovate, de sorte que l’ordre est passé automatiquement dès que votre condition se déclenche." },
  ], it: [
    { type: "paragraph",html: "Entrambi i tipi di alert di Tradovate svolgono lo stesso compito: tengono d’occhio il mercato o il Suo conto e La avvisano quando accade qualcosa che Le interessa. La differenza sta in quante cose controllano contemporaneamente. Un alert semplice segue una condizione. Un alert avanzato ne segue diverse e Le lascia decidere se devono essere vere tutte oppure basta una sola prima che scatti. Ecco come funziona ciascuno e come configurarli." },
    { type: "heading",text: "Semplice e avanzato in sintesi" },
    { type: "table", headers: ["","Alert semplice","Alert avanzato"], rows: [
      ["Condizioni","Una","Due o più"],
      ["Logica di attivazione","Scatta su quella singola condizione","Scatta quando tutte le condizioni sono soddisfatte, oppure quando lo è una qualsiasi"],
      ["Controlla","Prezzo di Instrument, Position o valore di Account","Qualsiasi combinazione di valori di Instrument, Position e Account"],
      ["Ideale per","\"Mi avvisi quando ES tocca 5,000.\"","\"Mi avvisi quando ES tocca 5,000 e il mio P&L aperto supera $500.\""],
    ] },
    { type: "heading",text: "Cosa fa un alert semplice" },
    { type: "paragraph",html: "Un alert semplice è un trigger a condizione singola. Lo punta su una sola cosa, il prezzo di uno strumento, il valore di una posizione o il valore di un conto, e imposta il livello. Quando quel livello viene raggiunto, l’alert scatta. Pensi al prezzo che incrocia un supporto chiave, a una posizione aperta che raggiunge un certo profitto o al saldo che scende sotto una soglia che non vuole superare. È l’alert più rapido da configurare e quello a cui la maggior parte dei trader ricorre ogni giorno." },
    { type: "heading",text: "Cosa aggiunge un alert avanzato" },
    { type: "paragraph",html: "Un alert avanzato si costruisce allo stesso modo, ma non è limitato a una sola condizione. Può impilarne diverse e poi indicare a Tradovate se devono essere vere tutte insieme oppure se ne basta una. Quell’interruttore \"tutte contro una qualsiasi\" è il punto centrale. \"All\" è un filtro AND che scatta solo quando l’intero setup si allinea. \"Any\" è una rete OR che cattura la condizione che scatta per prima." },
    { type: "heading",text: "Come configurare gli alert in Tradovate: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Apra il menu New Alert", html: "Nell’app web di Tradovate, guardi nell’angolo in alto a sinistra: l’icona a campanella di Alerts si trova accanto al pulsante New +. Faccia clic per aprire il menu New Alert. Qui si trova anche il Suo Alerts Log, quindi tornerà qui per rivedere tutto ciò che è scattato.", image: {"src":`${IMG}/tradovate-simple-advanced-alerts-1.png`,"alt":"Barra degli strumenti in alto a sinistra dell’app web di Tradovate con l’icona a campanella di Alerts accanto al pulsante New plus"} },
        { title: "Crei un alert semplice (una condizione)", html: "Inizi scegliendo cosa deve controllare l’alert: un prezzo di Instrument, un parametro di Position o un parametro di Account. Poi imposti la condizione, cioè se il valore debba essere maggiore di, minore di o uguale al Suo numero. Quindi inserisca il Value del trigger con la tastiera o con i pulsanti freccia. Si fermi qui e avrà un alert semplice: una cosa controllata, un livello, un trigger.", image: {"src":`${IMG}/tradovate-simple-advanced-alerts-2.png`,"alt":"Menu New Alert di Tradovate con il selettore Instrument, Position, Account e una condizione con campo Value per un alert semplice a condizione singola"} },
        { title: "Lo trasformi in un alert avanzato (più condizioni)", html: "Vuole più di una condizione? Faccia clic sul pulsante verde +Add per aggiungerne un’altra e ripeta quante volte serve. Ha sbagliato? L’icona del cestino accanto a una condizione la rimuove. Una volta che ne ha due o più, scelga la logica: scatta quando sono soddisfatte <strong class='text-white'>tutte</strong> le condizioni, oppure quando lo è <strong class='text-white'>una qualsiasi</strong>. Questa scelta trasforma un semplice trigger in un vero alert avanzato a più condizioni.", image: {"src":`${IMG}/tradovate-simple-advanced-alerts-3.png`,"alt":"Alert avanzato di Tradovate con due condizioni impilate, il pulsante verde plus Add, un’icona del cestino per rimuovere e l’interruttore di logica tutte o una qualsiasi"} },
        { title: "Imposti durata e notifica, poi crei", html: "Decida per quanto tempo l’alert deve restare attivo con il menu a discesa Duration: finché scatta, finché lo annulla Lei stesso o fino a una data e un’ora precise. Scelga anche il tipo di notifica: suono, popup o entrambi. Quando è pronto, faccia clic su Create. Quando un alert scatta, il browser riproduce un suono, compare un punto rosso sull’icona della campanella e l’eventuale messaggio personalizzato che ha aggiunto appare in una piccola bandierina sotto di essa.", image: {"src":`${IMG}/tradovate-simple-advanced-alerts-4.png`,"alt":"Configurazione di un alert di Tradovate con il menu a discesa Duration, le opzioni del tipo di notifica e il pulsante Create"} },
        { title: "Gestisca gli alert dall’Alerts Log", html: "Tornando all’icona della campanella, apra l’Alerts Log (la scheda List of Alerts) per vedere tutto in un unico posto, suddiviso in Active, Triggered e Disabled. Da qui può usare Edit per modificare le condizioni di un alert, Reset per reimpostare uno già scattato in modo che possa scattare di nuovo, Disable per disattivarlo temporaneamente o Delete per eliminarlo definitivamente. Faccia pulizia di tanto in tanto, in modo che alert obsoleti non scattino su livelli che ha superato da tempo.", image: {"src":`${IMG}/tradovate-simple-advanced-alerts-5.png`,"alt":"Alerts Log di Tradovate con alert Active, Triggered e Disabled e i controlli Edit, Reset, Disable e Delete"} },
      ],
    },
    { type: "heading",text: "Quale dovrebbe usare?" },
    { type: "paragraph",html: "Scelga un alert semplice quando un singolo livello Le dice tutto ciò che serve: un prezzo, una cifra di profitto, un saldo. Passi a un alert avanzato quando una decisione dipende dal fatto che più cose si allineino, come il prezzo a un livello <em>e</em> la Sua posizione di una certa dimensione. Inizi in modo semplice e aggiunga condizioni solo quando la precisione in più lo giustifica." },
    { type: "heading",text: "Dall’alert all’esecuzione automatica" },
    { type: "paragraph",html: "Gli alert Le dicono quando il Suo setup si presenta, ma deve comunque cliccare il trade da solo. Se vuole che l’entrata parta da sola, PickMyTrade instrada i Suoi alert di TradingView direttamente al Suo conto Tradovate, così l’ordine viene inserito automaticamente nel momento in cui la Sua condizione scatta." },
  ] },
  ctaHeading: { en: "From Alert to Automatic Execution", de: "Vom Alert zur automatischen Ausführung", es: "De la alerta a la ejecución automática", fr: "De l’alerte à l’exécution automatique", it: "Dall’alert all’esecuzione automatica" },
  ctaText: { en: "Alerts tell you when your setup hits, but you still have to click the trade yourself. PickMyTrade routes your TradingView alerts straight to your Tradovate account so the order goes in automatically.", de: "Alerts melden Ihnen, wann Ihr Setup eintritt, aber den Trade müssen Sie weiterhin selbst klicken. PickMyTrade leitet Ihre TradingView-Alerts direkt an Ihr Tradovate-Konto weiter, sodass die Order automatisch aufgegeben wird.", es: "Las alertas le avisan cuando se da su setup, pero aún tiene que hacer clic en la operación usted mismo. PickMyTrade enruta sus alertas de TradingView directamente a su cuenta de Tradovate para que la orden se envíe automáticamente.", fr: "Les alertes vous disent quand votre setup se présente, mais vous devez encore cliquer le trade vous-même. PickMyTrade achemine vos alertes TradingView directement vers votre compte Tradovate pour que l’ordre soit passé automatiquement.", it: "Gli alert Le dicono quando il Suo setup si presenta, ma deve comunque cliccare il trade da solo. PickMyTrade instrada i Suoi alert di TradingView direttamente al Suo conto Tradovate, così l’ordine viene inserito automaticamente." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "What's the actual difference between a Simple and an Advanced alert?", a: "A Simple alert watches one condition and fires when it's met. An Advanced alert watches two or more conditions and lets you choose whether all of them or any one of them has to be true before it fires." },
    { q: "Can an alert watch my account or position, not just price?", a: "Yes. When you build an alert you choose whether it tracks an Instrument price, a Position parameter, or an Account parameter, and Advanced alerts can mix all three." },
    { q: "Does a Tradovate alert place a trade for me?", a: "No. Alerts only notify you with a sound, popup, or both. To turn a trigger into an actual order automatically, you need an execution tool like PickMyTrade connected to your account." },
  ], de: [
    { q: "Was ist der eigentliche Unterschied zwischen einem einfachen und einem erweiterten Alert?", a: "Ein einfacher Alert überwacht eine Bedingung und löst aus, sobald sie erfüllt ist. Ein erweiterter Alert überwacht zwei oder mehr Bedingungen und lässt Sie wählen, ob alle oder nur eine davon zutreffen muss, bevor er auslöst." },
    { q: "Kann ein Alert mein Konto oder meine Position überwachen, nicht nur den Preis?", a: "Ja. Beim Erstellen eines Alerts wählen Sie, ob er einen Instrument-Preis, einen Position-Parameter oder einen Account-Parameter verfolgt, und erweiterte Alerts können alle drei kombinieren." },
    { q: "Platziert ein Tradovate-Alert einen Trade für mich?", a: "Nein. Alerts benachrichtigen Sie nur per Ton, Popup oder beidem. Um aus einem Auslöser automatisch eine echte Order zu machen, benötigen Sie ein Ausführungstool wie PickMyTrade, das mit Ihrem Konto verbunden ist." },
  ], es: [
    { q: "¿Cuál es la diferencia real entre una alerta simple y una avanzada?", a: "Una alerta simple vigila una condición y se dispara cuando se cumple. Una alerta avanzada vigila dos o más condiciones y le permite elegir si deben cumplirse todas o basta con una antes de dispararse." },
    { q: "¿Puede una alerta vigilar mi cuenta o mi posición, no solo el precio?", a: "Sí. Al crear una alerta elige si sigue un precio de Instrument, un parámetro de Position o un parámetro de Account, y las alertas avanzadas pueden combinar los tres." },
    { q: "¿Una alerta de Tradovate hace una operación por mí?", a: "No. Las alertas solo le notifican con un sonido, una ventana emergente o ambos. Para convertir un disparador en una orden real de forma automática, necesita una herramienta de ejecución como PickMyTrade conectada a su cuenta." },
  ], fr: [
    { q: "Quelle est la vraie différence entre une alerte simple et une alerte avancée ?", a: "Une alerte simple surveille une condition et se déclenche lorsqu’elle est remplie. Une alerte avancée surveille deux conditions ou plus et vous laisse choisir si toutes ou une seule doivent être vraies avant de se déclencher." },
    { q: "Une alerte peut-elle surveiller mon compte ou ma position, pas seulement le prix ?", a: "Oui. Lorsque vous créez une alerte, vous choisissez si elle suit un prix d’Instrument, un paramètre de Position ou un paramètre de Account, et les alertes avancées peuvent combiner les trois." },
    { q: "Une alerte Tradovate passe-t-elle un trade pour moi ?", a: "Non. Les alertes ne font que vous notifier par un son, une fenêtre contextuelle ou les deux. Pour transformer un déclencheur en ordre réel de façon automatique, vous avez besoin d’un outil d’exécution comme PickMyTrade connecté à votre compte." },
  ], it: [
    { q: "Qual è la vera differenza tra un alert semplice e uno avanzato?", a: "Un alert semplice controlla una condizione e scatta quando è soddisfatta. Un alert avanzato controlla due o più condizioni e Le permette di scegliere se devono essere vere tutte oppure basta una sola prima che scatti." },
    { q: "Un alert può controllare il mio conto o la mia posizione, non solo il prezzo?", a: "Sì. Quando crea un alert sceglie se deve seguire un prezzo di Instrument, un parametro di Position o un parametro di Account, e gli alert avanzati possono combinarli tutti e tre." },
    { q: "Un alert di Tradovate piazza un trade per me?", a: "No. Gli alert La avvisano soltanto con un suono, un popup o entrambi. Per trasformare un trigger in un ordine vero in modo automatico, serve uno strumento di esecuzione come PickMyTrade collegato al Suo conto." },
  ] },
  relatedHeading: { en: "Related Guides", de: "Verwandte Anleitungen", es: "Guías relacionadas", fr: "Guides associés", it: "Guide correlate" },
  disclosureText: { en: `This guide is for educational and informational purposes only and is not financial, investment, or trading advice. Trading futures and other leveraged products carries a substantial risk of loss and is not suitable for every investor. PickMyTrade is an independent third-party automation platform and is not affiliated with, endorsed by, or sponsored by Tradovate, Inc. "Tradovate" and all related names, logos, and trademarks are the property of their respective owners. Platform features and steps change over time, so always confirm the current process in the official Tradovate platform and documentation before acting.`, de: "Diese Anleitung dient ausschließlich Bildungs- und Informationszwecken und stellt keine Finanz-, Anlage- oder Handelsberatung dar. Der Handel mit Futures und anderen gehebelten Produkten birgt ein erhebliches Verlustrisiko und ist nicht für jeden Anleger geeignet. PickMyTrade ist eine unabhängige Automatisierungsplattform eines Drittanbieters und steht in keiner Verbindung zu Tradovate, Inc., wird weder von diesem unterstützt noch gesponsert. „Tradovate“ sowie alle zugehörigen Namen, Logos und Marken sind Eigentum der jeweiligen Inhaber. Funktionen und Schritte der Plattform ändern sich im Laufe der Zeit. Bestätigen Sie daher stets den aktuellen Ablauf in der offiziellen Tradovate-Plattform und -Dokumentation, bevor Sie handeln.", es: "Esta guía tiene únicamente fines educativos e informativos y no constituye asesoramiento financiero, de inversión ni de trading. Operar con futuros y otros productos apalancados conlleva un riesgo sustancial de pérdida y no es adecuado para todos los inversores. PickMyTrade es una plataforma de automatización independiente de terceros y no está afiliada, respaldada ni patrocinada por Tradovate, Inc. «Tradovate» y todos los nombres, logotipos y marcas relacionados son propiedad de sus respectivos titulares. Las funciones y los pasos de la plataforma cambian con el tiempo, por lo que debe confirmar siempre el proceso vigente en la plataforma y la documentación oficiales de Tradovate antes de actuar.", fr: "Ce guide est fourni à des fins éducatives et informatives uniquement et ne constitue pas un conseil financier, d’investissement ou de trading. Le trading de contrats à terme et d’autres produits à effet de levier comporte un risque de perte important et ne convient pas à tous les investisseurs. PickMyTrade est une plateforme d’automatisation tierce indépendante et n’est ni affiliée à Tradovate, Inc., ni approuvée ou parrainée par celle-ci. « Tradovate » ainsi que tous les noms, logos et marques associés sont la propriété de leurs détenteurs respectifs. Les fonctionnalités et les étapes de la plateforme évoluent avec le temps ; vérifiez donc toujours la procédure actuelle dans la plateforme et la documentation officielles de Tradovate avant d’agir.", it: "Questa guida ha esclusivamente scopo educativo e informativo e non costituisce consulenza finanziaria, di investimento o di trading. Il trading di futures e di altri prodotti a leva comporta un rischio sostanziale di perdita e non è adatto a tutti gli investitori. PickMyTrade è una piattaforma di automazione indipendente di terze parti e non è affiliata, approvata né sponsorizzata da Tradovate, Inc. «Tradovate» e tutti i nomi, loghi e marchi correlati sono di proprietà dei rispettivi titolari. Le funzionalità e i passaggi della piattaforma cambiano nel tempo, quindi confermi sempre la procedura attuale nella piattaforma e nella documentazione ufficiali di Tradovate prima di agire." },
