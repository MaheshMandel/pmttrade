---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-security-key";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Use a Hardware Security Key for Tradovate 2FA";
const META_DESCRIPTION =
  "Add a hardware security key as a strong second factor for your futures login. Set up USB, NFC, or passkey 2FA and register a backup in minutes.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Hardware-Sicherheitsschlüssel für die Tradovate-2FA verwenden", es: "Use una llave de seguridad de hardware para la 2FA de Tradovate", fr: "Utiliser une clé de sécurité matérielle pour la 2FA de Tradovate", it: "Usare una chiave di sicurezza hardware per la 2FA di Tradovate" },
  dek: { en: "Guarding a funded account or live login? Here's how to register a physical security key as an extra Tradovate 2FA step, including the backup key most people forget.", de: "Sie schützen ein finanziertes Konto oder einen Live-Login? So registrieren Sie einen physischen Sicherheitsschlüssel als zusätzlichen 2FA-Schritt bei Tradovate – samt dem Ersatzschlüssel, den die meisten vergessen.", es: "¿Protege una cuenta fondeada o un acceso en vivo? Así se registra una llave de seguridad física como paso adicional de 2FA en Tradovate, incluida la llave de respaldo que casi todos olvidan.", fr: "Vous protégez un compte financé ou une connexion en réel ? Voici comment enregistrer une clé de sécurité physique comme étape 2FA supplémentaire sur Tradovate, y compris la clé de secours que la plupart des gens oublient.", it: "Protegge un conto finanziato o un accesso live? Ecco come registrare una chiave di sicurezza fisica come ulteriore passaggio 2FA su Tradovate, compresa la chiave di riserva che quasi tutti dimenticano." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-10",
  blocks: { en: [
    { type: "paragraph", html: "An email approval is fine for casual logins, but if you're guarding a funded evaluation or a live account, a physical security key is the strongest second factor you can put on it. A key can't be phished or handed over in a fake support call the way a code can. Tradovate lets you register one as an extra verification step in a couple of minutes. Here's how, including the backup key most people forget." },
    { type: "heading", text: "What You Need First" },
    { type: "paragraph", html: "A security key sits on top of standard two-factor authentication, so 2FA has to be on before the option to add a key appears. You'll also want the key in hand. That can be a physical FIDO key over USB, NFC, or Bluetooth, or a platform passkey like your phone's fingerprint reader, a password manager, or Windows Hello. Any of those work as your \"key.\"" },
    { type: "paragraph", html: "One thing to check up front: these extra verification steps are tied to accounts with live access. If you only log in to a demo or a prop-firm-managed evaluation, the option may not appear. Security handling varies by firm and account type, so confirm your firm's current rules if you don't see it." },
    { type: "heading", text: "Add a Security Key: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open Security & Privacy in Application Settings", html: "Sign in to the Tradovate web trader, open <strong class='text-white'>Application Settings</strong>, and select the <strong class='text-white'>Security &amp; Privacy</strong> tab. This is where 2FA and every extra verification option are managed from one screen." },
        { title: "Confirm Standard 2FA Is On", html: "Check that two-factor authentication is already enabled. The security key is an <em>additional</em> step, not a replacement, so Tradovate won't let you register one until basic 2FA is active. If it's off, flip it on first, then come back to this screen." },
        { title: "Click \"Add a Security Key\"", html: "Scroll down to the <strong class='text-white'>Add additional verification steps</strong> section. Alongside the authenticator-app and SMS options you'll see <strong class='text-white'>Add a security key</strong>. Click it to kick off registration." },
        { title: "Register Your Key in the Browser Prompt", html: "Your browser takes over here with its own security-key dialog. Pick how you want to authenticate, then finish the physical step: insert the USB key and tap it, hold an NFC key to the reader, or approve a phone passkey or Windows Hello prompt. If you're asked to name the key, give it something you'll recognize later, like \"YubiKey backup\" or \"work laptop.\" That name is what you'll see when you manage or remove keys down the road." },
        { title: "Add a Backup Key and Set Enforcement", html: "This is the step to not skip. Register a <strong class='text-white'>second</strong> key the exact same way. If you only have one and it gets lost or breaks, you're locked out and stuck on a support ticket to get back in. Two keys, stored in different places, is the sane default. While you're here, decide how strict you want to be. Tradovate has a setting that requires a security key on <em>every</em> login, not just logins from a new device. Turn that on for maximum protection on a live account. If you'd rather keep it to new-device checks, leave it off." },
      ],
    },
    { type: "heading", text: "Which Keys Work" },
    {
      type: "table",
      headers: ["Type", "How it connects", "Good for"],
      rows: [
        ["USB security key", "Plug into a USB port, tap to confirm", "Desktop and laptop logins"],
        ["NFC key", "Tap against an NFC reader", "Phones and NFC-equipped laptops"],
        ["Phone passkey", "QR scan, approve with fingerprint or face", "No extra hardware to buy"],
        ["Windows Hello / password manager", "Built-in prompt on your device", "Fast logins on a trusted PC"],
      ],
    },
    { type: "heading", text: "A Few Things to Keep in Mind" },
    { type: "paragraph", html: "Store your backup key somewhere separate from your everyday one, so a single lost bag doesn't take out both. When you retire a key, remove it from the Security &amp; Privacy list so an old device can't get in. Tradovate asks you to confirm before it drops a verification step, which guards against deleting your last method by accident." },
    { type: "heading", text: "Automate Your Trading Once Security Is Locked Down" },
    { type: "paragraph", html: "With your key registered, your account is about as hard to break into as it gets. From there, <strong class='text-white'>PickMyTrade connects your TradingView alerts straight to Tradovate</strong> so entries, exits, and brackets fire automatically. Your login and security settings stay entirely yours while the strategy runs on its own." },
  ], de: [
    { type: "paragraph",html: "Eine E-Mail-Bestätigung genügt für gelegentliche Logins. Wenn Sie jedoch eine finanzierte Evaluierung oder ein Live-Konto schützen, ist ein physischer Sicherheitsschlüssel der stärkste zweite Faktor, den Sie einrichten können. Ein Schlüssel lässt sich nicht phishen oder in einem gefälschten Support-Anruf weitergeben wie ein Code. Tradovate lässt Sie einen solchen Schlüssel in wenigen Minuten als zusätzlichen Verifizierungsschritt registrieren. So geht's – einschließlich des Ersatzschlüssels, den die meisten vergessen." },
    { type: "heading",text: "Was Sie zuerst benötigen" },
    { type: "paragraph",html: "Ein Sicherheitsschlüssel baut auf der Standard-Zwei-Faktor-Authentifizierung auf. Die 2FA muss also aktiv sein, bevor die Option zum Hinzufügen eines Schlüssels erscheint. Außerdem sollten Sie den Schlüssel griffbereit haben. Das kann ein physischer FIDO-Schlüssel per USB, NFC oder Bluetooth sein oder ein Plattform-Passkey wie der Fingerabdruckleser Ihres Smartphones, ein Passwortmanager oder Windows Hello. Alle diese Varianten funktionieren als Ihr „Schlüssel“." },
    { type: "paragraph",html: "Eines sollten Sie vorab prüfen: Diese zusätzlichen Verifizierungsschritte sind an Konten mit Live-Zugang gebunden. Wenn Sie sich nur bei einem Demo-Konto oder einer von einer Prop-Firma verwalteten Evaluierung anmelden, erscheint die Option möglicherweise nicht. Die Sicherheitsverwaltung unterscheidet sich je nach Firma und Kontotyp. Prüfen Sie daher die aktuellen Regeln Ihrer Firma, falls Sie die Option nicht sehen." },
    { type: "heading",text: "Sicherheitsschlüssel hinzufügen: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Security & Privacy in den Application Settings öffnen", html: "Melden Sie sich im Tradovate-Webtrader an, öffnen Sie die <strong class='text-white'>Application Settings</strong> und wählen Sie den Tab <strong class='text-white'>Security &amp; Privacy</strong>. Hier werden die 2FA und alle zusätzlichen Verifizierungsoptionen auf einem Bildschirm verwaltet." },
        { title: "Bestätigen, dass die Standard-2FA aktiv ist", html: "Prüfen Sie, ob die Zwei-Faktor-Authentifizierung bereits aktiviert ist. Der Sicherheitsschlüssel ist ein <em>zusätzlicher</em> Schritt und kein Ersatz, deshalb lässt Tradovate keine Registrierung zu, solange die einfache 2FA nicht aktiv ist. Ist sie deaktiviert, schalten Sie sie zuerst ein und kehren Sie dann zu diesem Bildschirm zurück." },
        { title: "Auf „Add a Security Key“ klicken", html: "Scrollen Sie zum Abschnitt <strong class='text-white'>Add additional verification steps</strong>. Neben den Optionen für Authenticator-App und SMS sehen Sie <strong class='text-white'>Add a security key</strong>. Klicken Sie darauf, um die Registrierung zu starten." },
        { title: "Schlüssel im Browser-Dialog registrieren", html: "Jetzt übernimmt Ihr Browser mit seinem eigenen Sicherheitsschlüssel-Dialog. Wählen Sie die gewünschte Authentifizierungsmethode und schließen Sie dann den physischen Schritt ab: Stecken Sie den USB-Schlüssel ein und tippen Sie darauf, halten Sie einen NFC-Schlüssel an das Lesegerät oder bestätigen Sie die Abfrage eines Smartphone-Passkeys oder von Windows Hello. Wenn Sie nach einem Namen für den Schlüssel gefragt werden, wählen Sie etwas, das Sie später wiedererkennen, etwa „YubiKey backup“ oder „work laptop“. Unter diesem Namen sehen Sie den Schlüssel, wenn Sie Schlüssel später verwalten oder entfernen." },
        { title: "Ersatzschlüssel hinzufügen und Erzwingung festlegen", html: "Diesen Schritt sollten Sie nicht überspringen. Registrieren Sie einen <strong class='text-white'>zweiten</strong> Schlüssel auf genau dieselbe Weise. Wenn Sie nur einen haben und er verloren geht oder kaputtgeht, sind Sie ausgesperrt und hängen in einem Support-Ticket fest, um wieder hineinzukommen. Zwei Schlüssel, an unterschiedlichen Orten aufbewahrt, sind die vernünftige Standardlösung. Entscheiden Sie bei dieser Gelegenheit auch, wie streng Sie sein möchten. Tradovate bietet eine Einstellung, die bei <em>jedem</em> Login einen Sicherheitsschlüssel verlangt, nicht nur bei Logins von einem neuen Gerät. Aktivieren Sie sie für maximalen Schutz bei einem Live-Konto. Wenn Sie es lieber bei Prüfungen für neue Geräte belassen möchten, lassen Sie sie ausgeschaltet." },
      ],
    },
    { type: "heading",text: "Welche Schlüssel funktionieren" },
    { type: "table", headers: ["Typ","Verbindung","Geeignet für"], rows: [
      ["USB-Sicherheitsschlüssel","In einen USB-Port stecken, zur Bestätigung antippen","Logins am Desktop und Laptop"],
      ["NFC-Schlüssel","An ein NFC-Lesegerät halten","Smartphones und Laptops mit NFC"],
      ["Smartphone-Passkey","QR-Code scannen, mit Fingerabdruck oder Gesicht bestätigen","Keine zusätzliche Hardware nötig"],
      ["Windows Hello / Passwortmanager","Integrierte Abfrage auf Ihrem Gerät","Schnelle Logins an einem vertrauenswürdigen PC"],
    ] },
    { type: "heading",text: "Worauf Sie achten sollten" },
    { type: "paragraph",html: "Bewahren Sie Ihren Ersatzschlüssel getrennt von Ihrem Alltagsschlüssel auf, damit nicht eine einzige verlorene Tasche beide erwischt. Wenn Sie einen Schlüssel ausmustern, entfernen Sie ihn aus der Liste unter Security &amp; Privacy, damit ein altes Gerät nicht mehr hineinkommt. Tradovate fordert eine Bestätigung an, bevor ein Verifizierungsschritt entfernt wird. Das schützt davor, versehentlich Ihre letzte Methode zu löschen." },
    { type: "heading",text: "Automatisieren Sie Ihr Trading, sobald die Sicherheit steht" },
    { type: "paragraph",html: "Mit Ihrem registrierten Schlüssel ist Ihr Konto so gut abgesichert, wie es nur geht. Ab da <strong class='text-white'>verbindet PickMyTrade Ihre TradingView-Alerts direkt mit Tradovate</strong>, sodass Einstiege, Ausstiege und Brackets automatisch ausgelöst werden. Ihr Login und Ihre Sicherheitseinstellungen bleiben ganz bei Ihnen, während die Strategie von allein läuft." },
  ], es: [
    { type: "paragraph",html: "La aprobación por correo electrónico basta para accesos ocasionales, pero si protege una evaluación fondeada o una cuenta real, una llave de seguridad física es el segundo factor más sólido que puede añadir. Una llave no se puede suplantar mediante phishing ni entregar en una falsa llamada de soporte como ocurre con un código. Tradovate le permite registrar una como paso de verificación adicional en un par de minutos. Así se hace, incluida la llave de respaldo que casi todos olvidan." },
    { type: "heading",text: "Lo que necesita primero" },
    { type: "paragraph",html: "Una llave de seguridad se suma a la autenticación en dos pasos estándar, por lo que la 2FA debe estar activada antes de que aparezca la opción para añadir una llave. También conviene tener la llave a mano. Puede ser una llave FIDO física por USB, NFC o Bluetooth, o una passkey de plataforma, como el lector de huellas de su teléfono, un gestor de contraseñas o Windows Hello. Cualquiera de ellas funciona como su \"llave\"." },
    { type: "paragraph",html: "Conviene comprobar algo de antemano: estos pasos de verificación adicionales están vinculados a cuentas con acceso en vivo. Si solo inicia sesión en una cuenta demo o en una evaluación gestionada por una prop firm, es posible que la opción no aparezca. La gestión de la seguridad varía según la firma y el tipo de cuenta, así que confirme las normas vigentes de su firma si no la ve." },
    { type: "heading",text: "Añadir una llave de seguridad: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra Security & Privacy en Application Settings", html: "Inicie sesión en el Tradovate web trader, abra <strong class='text-white'>Application Settings</strong> y seleccione la pestaña <strong class='text-white'>Security &amp; Privacy</strong>. Desde esta pantalla se gestionan la 2FA y todas las opciones de verificación adicionales." },
        { title: "Confirme que la 2FA estándar está activada", html: "Compruebe que la autenticación en dos pasos ya está habilitada. La llave de seguridad es un paso <em>adicional</em>, no un sustituto, por lo que Tradovate no le permitirá registrar una hasta que la 2FA básica esté activa. Si está desactivada, actívela primero y vuelva a esta pantalla." },
        { title: "Haga clic en \"Add a Security Key\"", html: "Desplácese hasta la sección <strong class='text-white'>Add additional verification steps</strong>. Junto a las opciones de aplicación de autenticación y SMS verá <strong class='text-white'>Add a security key</strong>. Haga clic para iniciar el registro." },
        { title: "Registre su llave en el aviso del navegador", html: "Ahora el navegador toma el control con su propio cuadro de diálogo de llaves de seguridad. Elija cómo desea autenticarse y complete el paso físico: inserte la llave USB y tóquela, acerque una llave NFC al lector o apruebe el aviso de una passkey del teléfono o de Windows Hello. Si le piden un nombre para la llave, elija algo que reconozca más adelante, como \"YubiKey backup\" o \"work laptop\". Ese nombre es el que verá cuando gestione o elimine llaves en el futuro." },
        { title: "Añada una llave de respaldo y defina la exigencia", html: "Este es el paso que no debe omitir. Registre una <strong class='text-white'>segunda</strong> llave exactamente del mismo modo. Si solo tiene una y se pierde o se estropea, se quedará sin acceso y atascado en un ticket de soporte para volver a entrar. Dos llaves guardadas en lugares distintos es lo sensato. Mientras está aquí, decida qué nivel de rigor desea. Tradovate tiene un ajuste que exige una llave de seguridad en <em>cada</em> inicio de sesión, no solo en los de un dispositivo nuevo. Actívelo para obtener la máxima protección en una cuenta real. Si prefiere limitarlo a las comprobaciones de dispositivos nuevos, déjelo desactivado." },
      ],
    },
    { type: "heading",text: "Qué llaves funcionan" },
    { type: "table", headers: ["Tipo","Cómo se conecta","Ideal para"], rows: [
      ["Llave de seguridad USB","Se conecta a un puerto USB y se toca para confirmar","Inicios de sesión en equipos de escritorio y portátiles"],
      ["Llave NFC","Se acerca a un lector NFC","Teléfonos y portátiles con NFC"],
      ["Passkey del teléfono","Escaneo de QR y aprobación con huella o rostro","No requiere comprar hardware adicional"],
      ["Windows Hello / gestor de contraseñas","Aviso integrado en su dispositivo","Inicios de sesión rápidos en un PC de confianza"],
    ] },
    { type: "heading",text: "Algunos puntos a tener en cuenta" },
    { type: "paragraph",html: "Guarde su llave de respaldo en un lugar distinto de la de uso diario para que una sola bolsa perdida no se lleve ambas. Cuando retire una llave, elimínela de la lista de Security &amp; Privacy para que un dispositivo antiguo no pueda acceder. Tradovate le pide confirmación antes de eliminar un paso de verificación, lo que evita borrar por accidente su último método." },
    { type: "heading",text: "Automatice su trading cuando la seguridad esté resuelta" },
    { type: "paragraph",html: "Con su llave registrada, su cuenta queda tan protegida como es posible. A partir de ahí, <strong class='text-white'>PickMyTrade conecta sus alertas de TradingView directamente con Tradovate</strong> para que las entradas, las salidas y los brackets se ejecuten automáticamente. Su inicio de sesión y sus ajustes de seguridad siguen siendo totalmente suyos mientras la estrategia funciona sola." },
  ], fr: [
    { type: "paragraph",html: "Une approbation par e-mail suffit pour les connexions occasionnelles, mais si vous protégez une évaluation financée ou un compte réel, une clé de sécurité physique est le deuxième facteur le plus solide que vous puissiez ajouter. Une clé ne peut pas être hameçonnée ni remise lors d'un faux appel du support, contrairement à un code. Tradovate vous permet d'en enregistrer une comme étape de vérification supplémentaire en quelques minutes. Voici comment faire, y compris la clé de secours que la plupart des gens oublient." },
    { type: "heading",text: "Ce dont vous avez besoin d'abord" },
    { type: "paragraph",html: "Une clé de sécurité s'ajoute à l'authentification à deux facteurs standard : la 2FA doit donc être activée avant que l'option d'ajout d'une clé n'apparaisse. Prévoyez aussi d'avoir la clé sous la main. Il peut s'agir d'une clé FIDO physique en USB, NFC ou Bluetooth, ou d'une passkey de plateforme comme le lecteur d'empreintes de votre téléphone, un gestionnaire de mots de passe ou Windows Hello. Chacune de ces options fait office de « clé »." },
    { type: "paragraph",html: "Un point à vérifier dès le départ : ces étapes de vérification supplémentaires sont liées aux comptes disposant d'un accès réel. Si vous ne vous connectez qu'à un compte démo ou à une évaluation gérée par une prop firm, l'option peut ne pas apparaître. La gestion de la sécurité varie selon la firme et le type de compte ; vérifiez donc les règles en vigueur de votre firme si vous ne la voyez pas." },
    { type: "heading",text: "Ajouter une clé de sécurité : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir Security & Privacy dans Application Settings", html: "Connectez-vous au web trader Tradovate, ouvrez <strong class='text-white'>Application Settings</strong> et sélectionnez l'onglet <strong class='text-white'>Security &amp; Privacy</strong>. C'est depuis cet écran que la 2FA et toutes les options de vérification supplémentaires sont gérées." },
        { title: "Vérifier que la 2FA standard est activée", html: "Vérifiez que l'authentification à deux facteurs est déjà activée. La clé de sécurité est une étape <em>supplémentaire</em>, pas un remplacement : Tradovate ne vous laissera donc pas en enregistrer une tant que la 2FA de base n'est pas active. Si elle est désactivée, activez-la d'abord, puis revenez à cet écran." },
        { title: "Cliquer sur « Add a Security Key »", html: "Faites défiler jusqu'à la section <strong class='text-white'>Add additional verification steps</strong>. À côté des options d'application d'authentification et de SMS, vous verrez <strong class='text-white'>Add a security key</strong>. Cliquez dessus pour lancer l'enregistrement." },
        { title: "Enregistrer votre clé dans la fenêtre du navigateur", html: "Votre navigateur prend alors le relais avec sa propre boîte de dialogue de clé de sécurité. Choisissez comment vous souhaitez vous authentifier, puis terminez l'étape physique : insérez la clé USB et touchez-la, approchez une clé NFC du lecteur ou validez l'invite d'une passkey de téléphone ou de Windows Hello. Si on vous demande de nommer la clé, choisissez un nom que vous reconnaîtrez plus tard, comme « YubiKey backup » ou « work laptop ». C'est ce nom que vous verrez lorsque vous gérerez ou supprimerez des clés par la suite." },
        { title: "Ajouter une clé de secours et définir l'application", html: "C'est l'étape à ne pas sauter. Enregistrez une <strong class='text-white'>deuxième</strong> clé exactement de la même façon. Si vous n'en avez qu'une et qu'elle est perdue ou cassée, vous êtes bloqué et coincé dans un ticket de support pour retrouver l'accès. Deux clés, rangées à des endroits différents, c'est le réflexe raisonnable. Pendant que vous y êtes, décidez du niveau d'exigence souhaité. Tradovate propose un réglage qui impose une clé de sécurité à <em>chaque</em> connexion, pas seulement à celles d'un nouvel appareil. Activez-le pour une protection maximale sur un compte réel. Si vous préférez vous limiter aux vérifications de nouvel appareil, laissez-le désactivé." },
      ],
    },
    { type: "heading",text: "Quelles clés fonctionnent" },
    { type: "table", headers: ["Type","Mode de connexion","Idéal pour"], rows: [
      ["Clé de sécurité USB","Se branche sur un port USB, on la touche pour confirmer","Connexions sur ordinateur de bureau et portable"],
      ["Clé NFC","On l'approche d'un lecteur NFC","Téléphones et portables équipés du NFC"],
      ["Passkey de téléphone","Scan d'un QR code, validation par empreinte ou visage","Aucun matériel supplémentaire à acheter"],
      ["Windows Hello / gestionnaire de mots de passe","Invite intégrée à votre appareil","Connexions rapides sur un PC de confiance"],
    ] },
    { type: "heading",text: "Quelques points à garder à l'esprit" },
    { type: "paragraph",html: "Rangez votre clé de secours à un endroit distinct de celle que vous utilisez au quotidien, afin qu'un seul sac perdu n'emporte pas les deux. Lorsque vous mettez une clé au rebut, supprimez-la de la liste Security &amp; Privacy pour qu'un ancien appareil ne puisse plus accéder au compte. Tradovate vous demande de confirmer avant de supprimer une étape de vérification, ce qui évite d'effacer par accident votre dernière méthode." },
    { type: "heading",text: "Automatisez votre trading une fois la sécurité verrouillée" },
    { type: "paragraph",html: "Avec votre clé enregistrée, votre compte est aussi difficile à pirater que possible. Ensuite, <strong class='text-white'>PickMyTrade relie vos alertes TradingView directement à Tradovate</strong> afin que les entrées, les sorties et les brackets se déclenchent automatiquement. Votre connexion et vos paramètres de sécurité restent entièrement à vous pendant que la stratégie tourne seule." },
  ], it: [
    { type: "paragraph",html: "L'approvazione via e-mail va bene per gli accessi occasionali, ma se protegge una valutazione finanziata o un conto live, una chiave di sicurezza fisica è il secondo fattore più robusto che possa applicare. Una chiave non può essere sottratta con il phishing né consegnata in una falsa telefonata di assistenza come invece accade con un codice. Tradovate Le consente di registrarne una come passaggio di verifica aggiuntivo in un paio di minuti. Ecco come fare, compresa la chiave di riserva che quasi tutti dimenticano." },
    { type: "heading",text: "Cosa Le serve prima" },
    { type: "paragraph",html: "Una chiave di sicurezza si aggiunge all'autenticazione a due fattori standard, quindi la 2FA deve essere attiva prima che compaia l'opzione per aggiungere una chiave. Conviene anche avere la chiave a portata di mano. Può essere una chiave FIDO fisica via USB, NFC o Bluetooth, oppure una passkey di piattaforma come il lettore di impronte dello smartphone, un password manager o Windows Hello. Qualsiasi di queste funziona come la Sua \"chiave\"." },
    { type: "paragraph",html: "Un aspetto da verificare subito: questi passaggi di verifica aggiuntivi sono legati ai conti con accesso live. Se accede soltanto a un conto demo o a una valutazione gestita da una prop firm, l'opzione potrebbe non comparire. La gestione della sicurezza varia in base alla società e al tipo di conto, quindi verifichi le regole attuali della Sua società se non la vede." },
    { type: "heading",text: "Aggiungere una chiave di sicurezza: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Aprire Security & Privacy in Application Settings", html: "Acceda al web trader di Tradovate, apra <strong class='text-white'>Application Settings</strong> e selezioni la scheda <strong class='text-white'>Security &amp; Privacy</strong>. È qui che si gestiscono la 2FA e tutte le opzioni di verifica aggiuntive, da un'unica schermata." },
        { title: "Verificare che la 2FA standard sia attiva", html: "Controlli che l'autenticazione a due fattori sia già abilitata. La chiave di sicurezza è un passaggio <em>aggiuntivo</em>, non un sostituto, quindi Tradovate non Le permetterà di registrarne una finché la 2FA di base non è attiva. Se è disattivata, la attivi prima, poi torni a questa schermata." },
        { title: "Fare clic su \"Add a Security Key\"", html: "Scorra fino alla sezione <strong class='text-white'>Add additional verification steps</strong>. Accanto alle opzioni per l'app di autenticazione e gli SMS vedrà <strong class='text-white'>Add a security key</strong>. Faccia clic per avviare la registrazione." },
        { title: "Registrare la chiave nella finestra del browser", html: "A questo punto il browser prende il controllo con la propria finestra di dialogo per le chiavi di sicurezza. Scelga come autenticarsi, poi completi il passaggio fisico: inserisca la chiave USB e la tocchi, avvicini una chiave NFC al lettore oppure approvi la richiesta di una passkey dello smartphone o di Windows Hello. Se Le viene chiesto di dare un nome alla chiave, ne scelga uno che riconoscerà in seguito, come \"YubiKey backup\" o \"work laptop\". È il nome che vedrà quando gestirà o rimuoverà le chiavi in futuro." },
        { title: "Aggiungere una chiave di riserva e impostare l'obbligo", html: "Questo è il passaggio da non saltare. Registri una <strong class='text-white'>seconda</strong> chiave esattamente nello stesso modo. Se ne ha una sola e va persa o si rompe, resta bloccato fuori e dipende da un ticket di assistenza per rientrare. Due chiavi, conservate in luoghi diversi, sono la scelta sensata. Già che c'è, decida quanto essere rigoroso. Tradovate ha un'impostazione che richiede una chiave di sicurezza a <em>ogni</em> accesso, non solo a quelli da un nuovo dispositivo. La attivi per la massima protezione su un conto live. Se preferisce limitarsi ai controlli sui nuovi dispositivi, la lasci disattivata." },
      ],
    },
    { type: "heading",text: "Quali chiavi funzionano" },
    { type: "table", headers: ["Tipo","Come si collega","Adatta per"], rows: [
      ["Chiave di sicurezza USB","Si inserisce in una porta USB e si tocca per confermare","Accessi da desktop e laptop"],
      ["Chiave NFC","Si avvicina a un lettore NFC","Smartphone e laptop dotati di NFC"],
      ["Passkey dello smartphone","Scansione del QR e approvazione con impronta o volto","Nessun hardware aggiuntivo da acquistare"],
      ["Windows Hello / password manager","Richiesta integrata nel dispositivo","Accessi rapidi su un PC fidato"],
    ] },
    { type: "heading",text: "Alcune cose da tenere presente" },
    { type: "paragraph",html: "Conservi la chiave di riserva in un luogo separato da quella di uso quotidiano, così che una sola borsa smarrita non porti via entrambe. Quando mette da parte una chiave, la rimuova dall'elenco di Security &amp; Privacy affinché un vecchio dispositivo non possa accedere. Tradovate chiede conferma prima di eliminare un passaggio di verifica, per evitare di cancellare per errore l'ultimo metodo." },
    { type: "heading",text: "Automatizzi il Suo trading quando la sicurezza è a posto" },
    { type: "paragraph",html: "Con la chiave registrata, il Suo conto è protetto al massimo. Da lì, <strong class='text-white'>PickMyTrade collega i Suoi alert di TradingView direttamente a Tradovate</strong>, così ingressi, uscite e bracket partono in automatico. L'accesso e le impostazioni di sicurezza restano interamente Suoi mentre la strategia procede da sola." },
  ] },
  ctaHeading: { en: "Automate Once Security Is Locked Down", de: "Automatisieren Sie, sobald die Sicherheit steht", es: "Automatice cuando la seguridad esté resuelta", fr: "Automatisez une fois la sécurité verrouillée", it: "Automatizzi quando la sicurezza è a posto" },
  ctaText: { en: "With your key registered, your account is about as hard to break into as it gets. PickMyTrade connects your TradingView alerts straight to Tradovate so entries, exits, and brackets fire automatically.", de: "Mit Ihrem registrierten Schlüssel ist Ihr Konto so gut abgesichert, wie es nur geht. PickMyTrade verbindet Ihre TradingView-Alerts direkt mit Tradovate, sodass Einstiege, Ausstiege und Brackets automatisch ausgelöst werden.", es: "Con su llave registrada, su cuenta queda tan protegida como es posible. PickMyTrade conecta sus alertas de TradingView directamente con Tradovate para que las entradas, las salidas y los brackets se ejecuten automáticamente.", fr: "Avec votre clé enregistrée, votre compte est aussi difficile à pirater que possible. PickMyTrade relie vos alertes TradingView directement à Tradovate afin que les entrées, les sorties et les brackets se déclenchent automatiquement.", it: "Con la chiave registrata, il Suo conto è protetto al massimo. PickMyTrade collega i Suoi alert di TradingView direttamente a Tradovate, così ingressi, uscite e bracket partono in automatico." },
