  ] },
  ctaHeading: { en: "Trade on Live Quotes, Automatically", de: "Handeln Sie automatisch auf Live-Kursen", es: "Opere con cotizaciones en vivo, automáticamente", fr: "Tradez sur des cotations en direct, automatiquement", it: "Operi su quotazioni live, in automatico" },
  ctaText: { en: "Once your data feed is billed correctly, let PickMyTrade wire your TradingView alerts straight through to your Tradovate account.", de: "Sobald Ihr Datenfeed korrekt abgerechnet wird, lassen Sie PickMyTrade Ihre TradingView-Alerts direkt an Ihr Tradovate-Konto weiterleiten.", es: "Una vez que su feed de datos se facture correctamente, deje que PickMyTrade conecte sus alertas de TradingView directamente con su cuenta de Tradovate.", fr: "Une fois votre flux de données correctement facturé, laissez PickMyTrade relier vos alertes TradingView directement à votre compte Tradovate.", it: "Una volta che il Suo feed di dati è fatturato correttamente, lasci che PickMyTrade colleghi i Suoi alert di TradingView direttamente al Suo conto Tradovate." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Where do I change how I pay for Tradovate market data?", a: "Open Application Settings in the upper-right corner, go to the Subscriptions tab, scroll to the Market Data section, and click Edit Payment Method. From there you can update a card or switch to your account balance." },
    { q: "Can I pay for market data from my account balance instead of a card?", a: "Yes. On the payment screen, use the Change link below the card fields to bill the subscription from your Tradovate account balance. Just keep enough in the balance to cover the fee on the renewal date." },
    { q: "Will changing the payment source fix my delayed data?", a: "No. The payment source only controls who gets charged. A delayed feed comes from the data subscription and account funding, not the billing method. Make sure you hold an active real-time subscription on a funded live account." },
  ], de: [
    { q: "Wo ändere ich die Zahlungsart für Tradovate-Marktdaten?", a: "Öffnen Sie die Application Settings in der oberen rechten Ecke, wechseln Sie zur Registerkarte Subscriptions, scrollen Sie zum Abschnitt Market Data und klicken Sie auf Edit Payment Method. Dort können Sie eine Karte aktualisieren oder auf Ihr Kontoguthaben umstellen." },
    { q: "Kann ich Marktdaten statt per Karte über mein Kontoguthaben bezahlen?", a: "Ja. Verwenden Sie auf dem Zahlungsbildschirm den Link Change unterhalb der Kartenfelder, um das Abonnement über Ihr Tradovate-Kontoguthaben abzurechnen. Halten Sie am Verlängerungstag einfach genug Guthaben bereit, um die Gebühr zu decken." },
    { q: "Behebt eine Änderung der Zahlungsquelle meine verzögerten Daten?", a: "Nein. Die Zahlungsquelle bestimmt nur, wer belastet wird. Ein verzögerter Feed hängt vom Datenabonnement und der Kontofinanzierung ab, nicht von der Zahlungsart. Stellen Sie sicher, dass Sie ein aktives Echtzeit-Abonnement auf einem finanzierten Live-Konto besitzen." },
  ], es: [
    { q: "¿Dónde cambio cómo pago los datos de mercado de Tradovate?", a: "Abra Application Settings en la esquina superior derecha, vaya a la pestaña Subscriptions, desplácese hasta la sección Market Data y haga clic en Edit Payment Method. Desde ahí puede actualizar una tarjeta o cambiar al saldo de su cuenta." },
    { q: "¿Puedo pagar los datos de mercado con el saldo de mi cuenta en lugar de con tarjeta?", a: "Sí. En la pantalla de pago, use el enlace Change situado bajo los campos de la tarjeta para facturar la suscripción con el saldo de su cuenta de Tradovate. Solo asegúrese de mantener saldo suficiente para cubrir la tarifa en la fecha de renovación." },
    { q: "¿Cambiar la fuente de pago solucionará mis datos retrasados?", a: "No. La fuente de pago solo controla a quién se le cobra. Un feed retrasado depende de la suscripción de datos y de la financiación de la cuenta, no del método de facturación. Asegúrese de tener una suscripción activa en tiempo real en una cuenta real fondeada." },
  ], fr: [
    { q: "Où modifier le mode de paiement des données de marché Tradovate ?", a: "Ouvrez Application Settings dans le coin supérieur droit, allez dans l'onglet Subscriptions, faites défiler jusqu'à la section Market Data et cliquez sur Edit Payment Method. Vous pouvez alors mettre à jour une carte ou passer au solde de votre compte." },
    { q: "Puis-je payer les données de marché avec le solde de mon compte plutôt qu'avec une carte ?", a: "Oui. Sur l'écran de paiement, utilisez le lien Change sous les champs de la carte pour facturer l'abonnement sur le solde de votre compte Tradovate. Veillez simplement à conserver un solde suffisant pour couvrir les frais à la date de renouvellement." },
    { q: "Changer la source de paiement corrigera-t-il mes données différées ?", a: "Non. La source de paiement détermine uniquement qui est débité. Un flux différé provient de l'abonnement aux données et du financement du compte, pas du mode de facturation. Assurez-vous de détenir un abonnement temps réel actif sur un compte réel financé." },
  ], it: [
    { q: "Dove cambio il metodo di pagamento dei dati di mercato Tradovate?", a: "Apra Application Settings nell'angolo in alto a destra, vada alla scheda Subscriptions, scorra fino alla sezione Market Data e clicchi su Edit Payment Method. Da lì può aggiornare una carta o passare al saldo del conto." },
    { q: "Posso pagare i dati di mercato con il saldo del conto invece che con una carta?", a: "Sì. Nella schermata di pagamento usi il link Change sotto i campi della carta per addebitare l'abbonamento sul saldo del Suo conto Tradovate. Si assicuri solo di mantenere un saldo sufficiente a coprire la commissione alla data di rinnovo." },
    { q: "Cambiare la fonte di pagamento risolverà i miei dati ritardati?", a: "No. La fonte di pagamento stabilisce solo a chi viene addebitato l'importo. Un feed ritardato dipende dall'abbonamento ai dati e dal finanziamento del conto, non dal metodo di fatturazione. Si assicuri di avere un abbonamento in tempo reale attivo su un conto live finanziato." },
  ] },
  relatedHeading: { en: "Related Guides", de: "Ähnliche Anleitungen", es: "Guías relacionadas", fr: "Guides associés", it: "Guide correlate" },
