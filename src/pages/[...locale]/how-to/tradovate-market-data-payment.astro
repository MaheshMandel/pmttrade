---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-market-data-payment";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Change How You Pay for Tradovate Market Data";
const META_DESCRIPTION =
  "Tradovate market data billing explained: switch between a saved card and your funded account balance in the Subscriptions settings in about a minute.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "So ändern Sie die Zahlungsart für Tradovate-Marktdaten", es: "Cambie cómo paga los datos de mercado de Tradovate", fr: "Modifier le mode de paiement des données de marché Tradovate", it: "Cambiare il metodo di pagamento dei dati di mercato Tradovate" },
  dek: { en: "Tradovate lets you pay for real-time market data with a debit or credit card, or your funded account balance. Here's the exact path to switch the billing source yourself in about a minute.", de: "Mit Tradovate können Sie Echtzeit-Marktdaten per Debit- oder Kreditkarte oder über Ihr Kontoguthaben bezahlen. Hier ist der genaue Weg, wie Sie die Abrechnungsquelle in etwa einer Minute selbst ändern.", es: "Tradovate le permite pagar los datos de mercado en tiempo real con una tarjeta de débito o crédito, o con el saldo de su cuenta fondeada. Esta es la ruta exacta para cambiar usted mismo la fuente de facturación en aproximadamente un minuto.", fr: "Tradovate vous permet de payer les données de marché en temps réel par carte de débit ou de crédit, ou avec le solde de votre compte financé. Voici le chemin exact pour changer vous-même la source de facturation en environ une minute.", it: "Tradovate Le consente di pagare i dati di mercato in tempo reale con una carta di debito o di credito, oppure con il saldo del Suo conto finanziato. Ecco il percorso esatto per cambiare Lei stesso la fonte di fatturazione in circa un minuto." },
  readTime: { en: "4 min read", de: "4 Min. Lesezeit", es: "Lectura de 4 min", fr: "Lecture : 4 min", it: "Lettura di 4 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Tradovate lets you pay for real-time market data two ways: a debit or credit card you keep on file, or the cash balance in your funded account. If the wrong one is getting charged, or a card just expired and your quotes dropped to delayed, you can switch the billing source yourself in about a minute. Here's the exact path, plus what changes and what doesn't when you flip it." },
    { type: "heading", text: "What You Can Pay With" },
    { type: "paragraph", html: "A market-data subscription can be billed to a debit/credit card or drawn straight from your Tradovate account balance. Both routes need a funded live account behind them, since real-time exchange data isn't available on an unfunded login. Changing the payment source only changes <em>who</em> gets charged. It doesn't add or remove a data subscription, and it won't turn a delayed feed into a live one." },
    { type: "quote", html: "Real-time market data requires a funded live account. If you're on a prop-firm or evaluation account, the firm usually controls the data feed and its billing, so these settings may not appear for you at all." },
    { type: "heading", text: "Change Your Market Data Payment Source: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open Application Settings", html: "Log in to the Tradovate web or desktop platform. Click the <strong class='text-white'>Application Settings</strong> (gear) icon in the upper-right corner of the screen to open the Settings menu.", image: { src: `${IMG}/tradovate-market-data-payment-1.png`, alt: "Tradovate platform with the Application Settings gear icon highlighted in the upper-right corner" } },
        { title: "Open the Subscriptions Tab", html: "In the Settings menu, select the <strong class='text-white'>Subscriptions</strong> tab. This is the one place where every recurring charge on the account lives: your account plan, any add-ons, and your market-data feeds.", image: { src: `${IMG}/tradovate-market-data-payment-2.png`, alt: "Tradovate Settings menu with the Subscriptions tab selected" } },
        { title: "Find the Market Data Section", html: "Scroll down until you reach the <strong class='text-white'>Market Data</strong> section. You'll see your active exchange subscriptions and how they're currently billed. Click <strong class='text-white'>Edit Payment Method</strong> to change the source.", image: { src: `${IMG}/tradovate-market-data-payment-3.png`, alt: "Tradovate Subscriptions tab scrolled to the Market Data section with the Edit Payment Method option" } },
        { title: "Choose Your Payment Source and Save", html: "On the payment screen you can add or update a debit/credit card for future use. To bill from your account balance instead, look for the <strong class='text-white'>Change</strong> link below the card fields, which switches billing off the card and onto your Tradovate account. Pick the source you want, then save. The next data charge follows the source you set here.", image: { src: `${IMG}/tradovate-market-data-payment-4.png`, alt: "Tradovate Edit Payment Method screen showing the card fields and the Change link to bill from account balance" } },
      ],
    },
    { type: "heading", text: "Card vs Account Balance" },
    { type: "paragraph", html: "Neither option is cheaper than the other; you're just choosing which pocket the fee comes out of. Here's how to think about it:" },
    {
      type: "table",
      headers: ["Pay with", "Good when", "Keep in mind"],
      rows: [
        ["Debit / credit card", "You'd rather keep data fees off your trading balance and out of your margin.", "The card has to stay valid, or the renewal can fail and your data can lapse."],
        ["Tradovate account balance", "You keep a funded cushion and want one less card on file.", "The balance has to cover the fee on the renewal date, or the charge won't clear."],
      ],
    },
    { type: "heading", text: "Why You'd Need This" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Fix a failed renewal</strong>, an expired card can silently kill your live feed; point billing at a fresh card or your balance to bring quotes back.",
        "<strong class='text-white'>Protect your margin</strong>, moving fees onto a card keeps your account balance free for trading.",
        "<strong class='text-white'>Simplify billing</strong>, draw the fee from your funded balance so there's no card to maintain.",
        "<strong class='text-white'>Update expired details</strong>, swap in a new card before the next renewal instead of after your data drops.",
      ],
    },
    { type: "heading", text: "Prop and Evaluation Accounts" },
    { type: "paragraph", html: "On most prop-firm and evaluation accounts, the firm owns the data feed and handles the billing for it. If the Market Data controls are greyed out or missing entirely, that's expected. Data entitlements and who pays for them vary by firm and account size, so check your firm's current rules rather than trying to subscribe or change payment yourself." },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Once your data feed is billed correctly and running live, <strong class='text-white'>PickMyTrade wires your TradingView alerts straight through to your Tradovate account</strong>, so your strategy executes on its own with fills priced off live quotes. No manual clicks, no missed entries." },
  ], de: [
    { type: "paragraph",html: "Mit Tradovate können Sie Echtzeit-Marktdaten auf zwei Arten bezahlen: mit einer hinterlegten Debit- oder Kreditkarte oder über das Guthaben Ihres finanzierten Kontos. Wird die falsche Quelle belastet oder ist eine Karte gerade abgelaufen und Ihre Kurse sind auf verzögert gefallen, können Sie die Abrechnungsquelle in etwa einer Minute selbst ändern. Hier ist der genaue Weg, und was sich beim Umstellen ändert und was nicht." },
    { type: "heading",text: "Womit Sie bezahlen können" },
    { type: "paragraph",html: "Ein Marktdaten-Abonnement kann einer Debit-/Kreditkarte belastet oder direkt von Ihrem Tradovate-Kontoguthaben abgebucht werden. Beide Wege setzen ein finanziertes Live-Konto voraus, da Echtzeit-Börsendaten mit einem nicht finanzierten Login nicht verfügbar sind. Die Änderung der Zahlungsquelle ändert nur, <em>wer</em> belastet wird. Sie fügt kein Datenabonnement hinzu oder entfernt es, und sie macht aus einem verzögerten Feed keinen Live-Feed." },
    { type: "quote",html: "Echtzeit-Marktdaten erfordern ein finanziertes Live-Konto. Wenn Sie ein Prop-Firm- oder Evaluierungskonto nutzen, kontrolliert in der Regel die Firma den Datenfeed und dessen Abrechnung, sodass diese Einstellungen für Sie möglicherweise gar nicht erscheinen." },
    { type: "heading",text: "Zahlungsquelle für Marktdaten ändern: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Application Settings öffnen", html: "Melden Sie sich bei der Web- oder Desktop-Plattform von Tradovate an. Klicken Sie in der oberen rechten Ecke des Bildschirms auf das Symbol <strong class='text-white'>Application Settings</strong> (Zahnrad), um das Menü Settings zu öffnen.", image: {"src":`${IMG}/tradovate-market-data-payment-1.png`,"alt":"Tradovate-Plattform mit hervorgehobenem Zahnradsymbol Application Settings in der oberen rechten Ecke"} },
        { title: "Die Registerkarte Subscriptions öffnen", html: "Wählen Sie im Menü Settings die Registerkarte <strong class='text-white'>Subscriptions</strong>. Hier finden Sie an einer Stelle jede wiederkehrende Belastung des Kontos: Ihren Kontotarif, alle Add-ons und Ihre Marktdaten-Feeds.", image: {"src":`${IMG}/tradovate-market-data-payment-2.png`,"alt":"Tradovate-Menü Settings mit ausgewählter Registerkarte Subscriptions"} },
        { title: "Den Abschnitt Market Data finden", html: "Scrollen Sie nach unten bis zum Abschnitt <strong class='text-white'>Market Data</strong>. Dort sehen Sie Ihre aktiven Börsenabonnements und wie sie derzeit abgerechnet werden. Klicken Sie auf <strong class='text-white'>Edit Payment Method</strong>, um die Quelle zu ändern.", image: {"src":`${IMG}/tradovate-market-data-payment-3.png`,"alt":"Registerkarte Subscriptions von Tradovate, zum Abschnitt Market Data gescrollt, mit der Option Edit Payment Method"} },
        { title: "Zahlungsquelle wählen und speichern", html: "Auf dem Zahlungsbildschirm können Sie eine Debit-/Kreditkarte für die künftige Nutzung hinzufügen oder aktualisieren. Um stattdessen über Ihr Kontoguthaben abzurechnen, suchen Sie den Link <strong class='text-white'>Change</strong> unterhalb der Kartenfelder, der die Abrechnung von der Karte auf Ihr Tradovate-Konto umstellt. Wählen Sie die gewünschte Quelle und speichern Sie. Die nächste Datenbelastung folgt der hier festgelegten Quelle.", image: {"src":`${IMG}/tradovate-market-data-payment-4.png`,"alt":"Tradovate-Bildschirm Edit Payment Method mit den Kartenfeldern und dem Link Change zur Abrechnung über das Kontoguthaben"} },
      ],
    },
    { type: "heading",text: "Karte oder Kontoguthaben" },
    { type: "paragraph",html: "Keine der beiden Optionen ist günstiger als die andere; Sie entscheiden nur, aus welcher Tasche die Gebühr abgebucht wird. So denken Sie darüber nach:" },
    { type: "table", headers: ["Bezahlen mit","Geeignet, wenn","Zu beachten"], rows: [
      ["Debit-/Kreditkarte","Sie Datengebühren lieber von Ihrem Handelsguthaben und Ihrer Margin fernhalten möchten.","Die Karte muss gültig bleiben, sonst kann die Verlängerung fehlschlagen und Ihre Daten können auslaufen."],
      ["Tradovate-Kontoguthaben","Sie ein finanzielles Polster halten und eine Karte weniger hinterlegt haben möchten.","Das Guthaben muss am Verlängerungstag die Gebühr decken, sonst wird die Belastung nicht ausgeführt."],
    ] },
    { type: "heading",text: "Warum Sie das brauchen" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Eine fehlgeschlagene Verlängerung beheben</strong>, eine abgelaufene Karte kann Ihren Live-Feed unbemerkt beenden; stellen Sie die Abrechnung auf eine neue Karte oder Ihr Guthaben um, damit die Kurse zurückkehren.",
        "<strong class='text-white'>Ihre Margin schützen</strong>, wenn Sie Gebühren auf eine Karte verlagern, bleibt Ihr Kontoguthaben für den Handel frei.",
        "<strong class='text-white'>Die Abrechnung vereinfachen</strong>, buchen Sie die Gebühr von Ihrem finanzierten Guthaben ab, sodass keine Karte gepflegt werden muss.",
        "<strong class='text-white'>Abgelaufene Angaben aktualisieren</strong>, tauschen Sie eine neue Karte vor der nächsten Verlängerung aus, statt erst nachdem Ihre Daten ausfallen.",
      ],
    },
    { type: "heading",text: "Prop- und Evaluierungskonten" },
    { type: "paragraph",html: "Bei den meisten Prop-Firm- und Evaluierungskonten besitzt die Firma den Datenfeed und kümmert sich um dessen Abrechnung. Sind die Market-Data-Steuerelemente ausgegraut oder fehlen ganz, ist das zu erwarten. Datenberechtigungen und wer dafür zahlt, variieren je nach Firma und Kontogröße. Prüfen Sie daher die aktuellen Regeln Ihrer Firma, statt selbst zu abonnieren oder die Zahlung zu ändern." },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "Sobald Ihr Datenfeed korrekt abgerechnet wird und live läuft, <strong class='text-white'>leitet PickMyTrade Ihre TradingView-Alerts direkt an Ihr Tradovate-Konto weiter</strong>, sodass Ihre Strategie von selbst ausgeführt wird, mit Fills auf Basis von Live-Kursen. Keine manuellen Klicks, keine verpassten Einstiege." },
  ], es: [
    { type: "paragraph",html: "Tradovate le permite pagar los datos de mercado en tiempo real de dos maneras: con una tarjeta de débito o crédito guardada, o con el saldo en efectivo de su cuenta fondeada. Si se está cobrando la fuente equivocada, o una tarjeta acaba de caducar y sus cotizaciones han pasado a retrasadas, puede cambiar usted mismo la fuente de facturación en aproximadamente un minuto. Esta es la ruta exacta, además de lo que cambia y lo que no al hacerlo." },
    { type: "heading",text: "Con qué puede pagar" },
    { type: "paragraph",html: "Una suscripción de datos de mercado puede facturarse a una tarjeta de débito/crédito o descontarse directamente del saldo de su cuenta de Tradovate. Ambas vías requieren una cuenta real fondeada, ya que los datos de bolsa en tiempo real no están disponibles con un acceso sin fondos. Cambiar la fuente de pago solo cambia <em>a quién</em> se le cobra. No añade ni elimina una suscripción de datos, y no convertirá un feed retrasado en uno en vivo." },
    { type: "quote",html: "Los datos de mercado en tiempo real requieren una cuenta real fondeada. Si usa una cuenta de prop firm o de evaluación, la firma suele controlar el feed de datos y su facturación, por lo que estos ajustes puede que ni siquiera le aparezcan." },
    { type: "heading",text: "Cambie su fuente de pago de datos de mercado: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra Application Settings", html: "Inicie sesión en la plataforma web o de escritorio de Tradovate. Haga clic en el icono de <strong class='text-white'>Application Settings</strong> (engranaje) en la esquina superior derecha de la pantalla para abrir el menú Settings.", image: {"src":`${IMG}/tradovate-market-data-payment-1.png`,"alt":"Plataforma Tradovate con el icono de engranaje Application Settings resaltado en la esquina superior derecha"} },
        { title: "Abra la pestaña Subscriptions", html: "En el menú Settings, seleccione la pestaña <strong class='text-white'>Subscriptions</strong>. Es el único lugar donde se reúnen todos los cargos recurrentes de la cuenta: su plan de cuenta, los complementos y sus feeds de datos de mercado.", image: {"src":`${IMG}/tradovate-market-data-payment-2.png`,"alt":"Menú Settings de Tradovate con la pestaña Subscriptions seleccionada"} },
        { title: "Localice la sección Market Data", html: "Desplácese hacia abajo hasta llegar a la sección <strong class='text-white'>Market Data</strong>. Verá sus suscripciones de bolsa activas y cómo se facturan actualmente. Haga clic en <strong class='text-white'>Edit Payment Method</strong> para cambiar la fuente.", image: {"src":`${IMG}/tradovate-market-data-payment-3.png`,"alt":"Pestaña Subscriptions de Tradovate desplazada a la sección Market Data con la opción Edit Payment Method"} },
        { title: "Elija su fuente de pago y guarde", html: "En la pantalla de pago puede añadir o actualizar una tarjeta de débito/crédito para uso futuro. Para facturar con el saldo de su cuenta, busque el enlace <strong class='text-white'>Change</strong> bajo los campos de la tarjeta, que traslada la facturación de la tarjeta a su cuenta de Tradovate. Elija la fuente que desee y guarde. El siguiente cargo de datos seguirá la fuente que establezca aquí.", image: {"src":`${IMG}/tradovate-market-data-payment-4.png`,"alt":"Pantalla Edit Payment Method de Tradovate con los campos de la tarjeta y el enlace Change para facturar con el saldo de la cuenta"} },
      ],
    },
    { type: "heading",text: "Tarjeta o saldo de la cuenta" },
    { type: "paragraph",html: "Ninguna opción es más barata que la otra; simplemente elige de qué bolsillo sale la tarifa. Así conviene plantearlo:" },
    { type: "table", headers: ["Pagar con","Conviene cuando","Tenga en cuenta"], rows: [
      ["Tarjeta de débito / crédito","Prefiere mantener las tarifas de datos fuera de su saldo de trading y de su margen.","La tarjeta debe seguir siendo válida o la renovación puede fallar y sus datos pueden caducar."],
      ["Saldo de la cuenta de Tradovate","Mantiene un colchón fondeado y quiere una tarjeta menos registrada.","El saldo debe cubrir la tarifa en la fecha de renovación o el cargo no se completará."],
    ] },
    { type: "heading",text: "Por qué lo necesitaría" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Solucionar una renovación fallida</strong>, una tarjeta caducada puede acabar silenciosamente con su feed en vivo; dirija la facturación a una tarjeta nueva o a su saldo para recuperar las cotizaciones.",
        "<strong class='text-white'>Proteger su margen</strong>, trasladar las tarifas a una tarjeta mantiene libre el saldo de su cuenta para operar.",
        "<strong class='text-white'>Simplificar la facturación</strong>, descuente la tarifa de su saldo fondeado y no tendrá que mantener una tarjeta.",
        "<strong class='text-white'>Actualizar datos caducados</strong>, cambie a una tarjeta nueva antes de la próxima renovación en lugar de después de que sus datos se corten.",
      ],
    },
    { type: "heading",text: "Cuentas de prop firm y de evaluación" },
    { type: "paragraph",html: "En la mayoría de las cuentas de prop firm y de evaluación, la firma es la propietaria del feed de datos y gestiona su facturación. Si los controles de Market Data aparecen atenuados o directamente no aparecen, es lo esperado. Los permisos de datos y quién los paga varían según la firma y el tamaño de la cuenta, así que consulte las reglas vigentes de su firma en lugar de intentar suscribirse o cambiar el pago por su cuenta." },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Una vez que su feed de datos esté bien facturado y funcionando en vivo, <strong class='text-white'>PickMyTrade conecta sus alertas de TradingView directamente con su cuenta de Tradovate</strong>, de modo que su estrategia se ejecuta sola con ejecuciones valoradas según cotizaciones en vivo. Sin clics manuales ni entradas perdidas." },
  ], fr: [
    { type: "paragraph",html: "Tradovate vous permet de payer les données de marché en temps réel de deux façons : une carte de débit ou de crédit enregistrée, ou le solde en espèces de votre compte financé. Si la mauvaise source est débitée, ou si une carte vient d'expirer et que vos cotations sont passées en différé, vous pouvez changer vous-même la source de facturation en environ une minute. Voici le chemin exact, ainsi que ce qui change et ce qui ne change pas lorsque vous basculez." },
    { type: "heading",text: "Ce avec quoi vous pouvez payer" },
    { type: "paragraph",html: "Un abonnement aux données de marché peut être facturé sur une carte de débit/crédit ou prélevé directement sur le solde de votre compte Tradovate. Les deux options nécessitent un compte réel financé, car les données de bourse en temps réel ne sont pas disponibles avec un identifiant non financé. Changer la source de paiement modifie uniquement <em>qui</em> est débité. Cela n'ajoute ni ne supprime d'abonnement aux données, et ne transformera pas un flux différé en flux en direct." },
    { type: "quote",html: "Les données de marché en temps réel nécessitent un compte réel financé. Si vous utilisez un compte de prop firm ou d'évaluation, la société contrôle généralement le flux de données et sa facturation ; ces paramètres peuvent donc ne pas du tout apparaître pour vous." },
    { type: "heading",text: "Modifier votre source de paiement des données de marché : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir Application Settings", html: "Connectez-vous à la plateforme web ou de bureau de Tradovate. Cliquez sur l'icône <strong class='text-white'>Application Settings</strong> (engrenage) dans le coin supérieur droit de l'écran pour ouvrir le menu Settings.", image: {"src":`${IMG}/tradovate-market-data-payment-1.png`,"alt":"Plateforme Tradovate avec l'icône d'engrenage Application Settings mise en évidence dans le coin supérieur droit"} },
        { title: "Ouvrir l'onglet Subscriptions", html: "Dans le menu Settings, sélectionnez l'onglet <strong class='text-white'>Subscriptions</strong>. C'est le seul endroit où figurent tous les prélèvements récurrents du compte : votre forfait de compte, les modules complémentaires et vos flux de données de marché.", image: {"src":`${IMG}/tradovate-market-data-payment-2.png`,"alt":"Menu Settings de Tradovate avec l'onglet Subscriptions sélectionné"} },
        { title: "Trouver la section Market Data", html: "Faites défiler jusqu'à la section <strong class='text-white'>Market Data</strong>. Vous y verrez vos abonnements boursiers actifs et la manière dont ils sont facturés actuellement. Cliquez sur <strong class='text-white'>Edit Payment Method</strong> pour changer la source.", image: {"src":`${IMG}/tradovate-market-data-payment-3.png`,"alt":"Onglet Subscriptions de Tradovate défilé jusqu'à la section Market Data avec l'option Edit Payment Method"} },
        { title: "Choisir votre source de paiement et enregistrer", html: "Sur l'écran de paiement, vous pouvez ajouter ou mettre à jour une carte de débit/crédit pour un usage futur. Pour facturer sur le solde de votre compte, repérez le lien <strong class='text-white'>Change</strong> sous les champs de la carte, qui fait passer la facturation de la carte à votre compte Tradovate. Choisissez la source souhaitée, puis enregistrez. Le prochain prélèvement de données suivra la source que vous définissez ici.", image: {"src":`${IMG}/tradovate-market-data-payment-4.png`,"alt":"Écran Edit Payment Method de Tradovate affichant les champs de la carte et le lien Change pour facturer sur le solde du compte"} },
      ],
    },
    { type: "heading",text: "Carte ou solde du compte" },
    { type: "paragraph",html: "Aucune des deux options n'est moins chère que l'autre ; vous choisissez simplement de quelle poche les frais sont prélevés. Voici comment raisonner :" },
    { type: "table", headers: ["Payer avec","Convient lorsque","À garder à l'esprit"], rows: [
      ["Carte de débit / crédit","Vous préférez garder les frais de données hors de votre solde de trading et de votre marge.","La carte doit rester valide, sinon le renouvellement peut échouer et vos données peuvent expirer."],
      ["Solde du compte Tradovate","Vous conservez une réserve financée et souhaitez une carte de moins enregistrée.","Le solde doit couvrir les frais à la date de renouvellement, sinon le prélèvement ne passera pas."],
    ] },
    { type: "heading",text: "Pourquoi en avez-vous besoin" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Corriger un renouvellement échoué</strong>, une carte expirée peut couper silencieusement votre flux en direct ; orientez la facturation vers une carte à jour ou votre solde pour retrouver les cotations.",
        "<strong class='text-white'>Protéger votre marge</strong>, déplacer les frais sur une carte laisse le solde de votre compte disponible pour trader.",
        "<strong class='text-white'>Simplifier la facturation</strong>, prélevez les frais sur votre solde financé : aucune carte à entretenir.",
        "<strong class='text-white'>Mettre à jour des informations expirées</strong>, remplacez la carte avant le prochain renouvellement plutôt qu'après la coupure de vos données.",
      ],
    },
    { type: "heading",text: "Comptes de prop firm et d'évaluation" },
    { type: "paragraph",html: "Sur la plupart des comptes de prop firm et d'évaluation, la société détient le flux de données et s'occupe de sa facturation. Si les commandes Market Data sont grisées ou totalement absentes, c'est normal. Les droits d'accès aux données et la personne qui les paie varient selon la firme et la taille du compte ; vérifiez donc les règles en vigueur de votre firme plutôt que d'essayer de vous abonner ou de modifier le paiement vous-même." },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Une fois votre flux de données correctement facturé et actif en direct, <strong class='text-white'>PickMyTrade relie vos alertes TradingView directement à votre compte Tradovate</strong> : votre stratégie s'exécute d'elle-même, avec des exécutions basées sur les cotations en direct. Aucun clic manuel, aucune entrée manquée." },
  ], it: [
    { type: "paragraph",html: "Tradovate Le consente di pagare i dati di mercato in tempo reale in due modi: con una carta di debito o di credito registrata, oppure con il saldo in contanti del Suo conto finanziato. Se viene addebitata la fonte sbagliata, oppure una carta è appena scaduta e le quotazioni sono passate a ritardate, può cambiare Lei stesso la fonte di fatturazione in circa un minuto. Ecco il percorso esatto, insieme a ciò che cambia e ciò che non cambia quando la modifica." },
    { type: "heading",text: "Con che cosa può pagare" },
    { type: "paragraph",html: "Un abbonamento ai dati di mercato può essere addebitato su una carta di debito/credito oppure prelevato direttamente dal saldo del Suo conto Tradovate. Entrambe le vie richiedono un conto live finanziato, poiché i dati di borsa in tempo reale non sono disponibili con un accesso non finanziato. Cambiare la fonte di pagamento modifica solo <em>a chi</em> viene addebitato l'importo. Non aggiunge né rimuove un abbonamento ai dati e non trasformerà un feed ritardato in uno live." },
    { type: "quote",html: "I dati di mercato in tempo reale richiedono un conto live finanziato. Se utilizza un conto di una prop firm o di valutazione, di solito è la società a controllare il feed di dati e la relativa fatturazione, quindi queste impostazioni potrebbero non comparire affatto." },
    { type: "heading",text: "Cambiare la fonte di pagamento dei dati di mercato: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Apra Application Settings", html: "Acceda alla piattaforma web o desktop di Tradovate. Clicchi sull'icona <strong class='text-white'>Application Settings</strong> (ingranaggio) nell'angolo in alto a destra dello schermo per aprire il menu Settings.", image: {"src":`${IMG}/tradovate-market-data-payment-1.png`,"alt":"Piattaforma Tradovate con l'icona a ingranaggio Application Settings evidenziata nell'angolo in alto a destra"} },
        { title: "Apra la scheda Subscriptions", html: "Nel menu Settings, selezioni la scheda <strong class='text-white'>Subscriptions</strong>. È l'unico posto in cui si trovano tutti gli addebiti ricorrenti del conto: il piano del conto, eventuali componenti aggiuntivi e i feed di dati di mercato.", image: {"src":`${IMG}/tradovate-market-data-payment-2.png`,"alt":"Menu Settings di Tradovate con la scheda Subscriptions selezionata"} },
        { title: "Trovi la sezione Market Data", html: "Scorra verso il basso fino alla sezione <strong class='text-white'>Market Data</strong>. Vedrà i Suoi abbonamenti di borsa attivi e come vengono attualmente fatturati. Clicchi su <strong class='text-white'>Edit Payment Method</strong> per cambiare la fonte.", image: {"src":`${IMG}/tradovate-market-data-payment-3.png`,"alt":"Scheda Subscriptions di Tradovate scorsa fino alla sezione Market Data con l'opzione Edit Payment Method"} },
        { title: "Scelga la fonte di pagamento e salvi", html: "Nella schermata di pagamento può aggiungere o aggiornare una carta di debito/credito per usi futuri. Per addebitare invece sul saldo del conto, cerchi il link <strong class='text-white'>Change</strong> sotto i campi della carta, che sposta la fatturazione dalla carta al Suo conto Tradovate. Scelga la fonte desiderata e salvi. Il prossimo addebito dei dati seguirà la fonte impostata qui.", image: {"src":`${IMG}/tradovate-market-data-payment-4.png`,"alt":"Schermata Edit Payment Method di Tradovate con i campi della carta e il link Change per addebitare sul saldo del conto"} },
      ],
    },
    { type: "heading",text: "Carta o saldo del conto" },
    { type: "paragraph",html: "Nessuna delle due opzioni costa meno dell'altra; sceglie semplicemente da quale tasca esce la commissione. Ecco come ragionare:" },
    { type: "table", headers: ["Pagare con","Va bene quando","Da tenere presente"], rows: [
      ["Carta di debito / credito","Preferisce tenere le commissioni dei dati fuori dal saldo di trading e dal margine.","La carta deve restare valida, altrimenti il rinnovo può fallire e i dati possono scadere."],
      ["Saldo del conto Tradovate","Mantiene un cuscinetto finanziato e vuole una carta in meno registrata.","Il saldo deve coprire la commissione alla data di rinnovo, altrimenti l'addebito non andrà a buon fine."],
    ] },
    { type: "heading",text: "Perché Le serve" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Risolvere un rinnovo fallito</strong>, una carta scaduta può interrompere in silenzio il Suo feed live; indirizzi la fatturazione su una carta aggiornata o sul saldo per ripristinare le quotazioni.",
        "<strong class='text-white'>Proteggere il margine</strong>, spostare le commissioni su una carta mantiene libero il saldo del conto per operare.",
        "<strong class='text-white'>Semplificare la fatturazione</strong>, prelevi la commissione dal saldo finanziato, così non c'è nessuna carta da mantenere.",
        "<strong class='text-white'>Aggiornare dati scaduti</strong>, inserisca una nuova carta prima del prossimo rinnovo anziché dopo l'interruzione dei dati.",
      ],
