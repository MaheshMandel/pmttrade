---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-desktop-app";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Download the Tradovate Desktop App (Win/Mac)";
const META_DESCRIPTION =
  "Download the Tradovate desktop app for Windows or Mac using the official links, install it step by step, and log in the first time in minutes.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Die Tradovate-Desktop-App herunterladen (Win/Mac)", es: "Descargue la aplicación de escritorio de Tradovate (Win/Mac)", fr: "Télécharger l'application de bureau Tradovate (Win/Mac)", it: "Scaricare l'app desktop di Tradovate (Win/Mac)" },
  dek: { en: "The Tradovate desktop app gets its own window, stays out of your browser tabs, and won't vanish if you accidentally close Chrome mid-session. It's free and setup takes about five minutes. Here's exactly how to get it on Windows or Mac.", de: "Die Tradovate-Desktop-App hat ein eigenes Fenster, belegt keine Browser-Tabs und verschwindet nicht, wenn Sie mitten in der Sitzung versehentlich Chrome schließen. Sie ist kostenlos, und die Einrichtung dauert etwa fünf Minuten. So holen Sie sie sich für Windows oder Mac.", es: "La aplicación de escritorio de Tradovate tiene su propia ventana, no ocupa pestañas del navegador y no desaparece si cierra Chrome por accidente en plena sesión. Es gratuita y la configuración lleva unos cinco minutos. Así se instala en Windows o Mac.", fr: "L'application de bureau Tradovate dispose de sa propre fenêtre, n'occupe aucun onglet de navigateur et ne disparaît pas si vous fermez Chrome par erreur en pleine session. Elle est gratuite et l'installation prend environ cinq minutes. Voici comment l'obtenir sous Windows ou sur Mac.", it: "L'app desktop di Tradovate ha una finestra tutta sua, non occupa le schede del browser e non scompare se chiude Chrome per errore a sessione in corso. È gratuita e la configurazione richiede circa cinque minuti. Ecco come ottenerla su Windows o Mac." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "The web platform runs fine in a browser, but plenty of futures traders would rather have a dedicated app. The Tradovate desktop app gets its own window, stays out of your browser tabs, and won't vanish if you accidentally close Chrome mid-session. It's free, it's the same platform you already know, and setup takes about five minutes. Here's exactly how to get it on Windows or Mac." },
    { type: "heading", text: "What Is the Tradovate Desktop App?" },
    { type: "paragraph", html: "It's a standalone version of the Tradovate platform you install on a Windows PC or a Mac. Same charts, same DOM, same order tickets as the browser-based Web Trader, just wrapped in its own application instead of a browser tab. You sign in with the same credentials, so you're not creating a new account or paying anything extra to use it." },
    { type: "heading", text: "Before You Download" },
    {
      type: "list",
      items: [
        "A Tradovate account. Trading your own money or through a prop firm both work. Don't have one yet? Here's <a href='https://pickmytrade.trade/how-to/tradovate-open-account/'>how to open a Tradovate account</a>.",
        "A Windows or Mac computer with permission to install software (you'll need admin rights on locked-down work machines).",
        "Your login details handy, personal account credentials, or the username your prop firm issued you.",
      ],
    },
    { type: "heading", text: "Download the Tradovate Desktop App: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open the Official Download Page", html: "Head to Tradovate's official devices page at <strong class='text-white'>tradovate.com/devices</strong>. That's the one page that carries every version, desktop, web, and mobile. Stick to it. Grabbing the app from a random \"free download\" site is a fast way to end up with something you don't want on a machine that touches your brokerage account." },
        { title: "Choose Windows or Mac", html: "You'll see two clearly labeled buttons: <strong class='text-white'>Download Windows</strong> and <strong class='text-white'>Download Mac</strong>. Click the one that matches your machine. Windows pulls down an installer file; Mac pulls down a disk image. If the page auto-detects your system, the right button is usually front and center, just double-check it before you click." },
        { title: "Install on Windows", html: "Open the downloaded installer from your Downloads folder and follow the prompts. Windows may flash a SmartScreen or User Account Control warning, that's normal for a freshly downloaded app. Choose to run it anyway and allow the install to continue. When it finishes, Tradovate shows up in your Start menu and (usually) on your desktop, ready to open." },
        { title: "Install on Mac", html: "Double-click the downloaded disk image, then drag the Tradovate icon into your <strong class='text-white'>Applications</strong> folder. The first time you open it, macOS might say the app is from an unidentified developer. If it does, go to <strong class='text-white'>System Settings &rsaquo; Privacy &amp; Security</strong> and click <strong class='text-white'>Open Anyway</strong>, or right-click the app and choose <strong class='text-white'>Open</strong>. After that one approval, it launches normally every time." },
        { title: "Open the App and Log In", html: "Launch Tradovate and sign in. On a personal account, use your Tradovate email and password. On a prop-firm or evaluation account, log in with the username your firm gave you, the exact format and where you start the login vary by firm, so check your firm's welcome email or member area if you're unsure. Pick the account you want to trade, and you're in." },
      ],
    },
    { type: "heading", text: "Prefer Not to Install? Use Web or Mobile" },
    { type: "paragraph", html: "Not everyone wants another app on their machine, and that's fine. The browser version does everything the desktop app does, and there are iPhone and Android apps if you'd rather watch positions on the go. For a rundown of every option, see <a href='https://pickmytrade.trade/how-to/tradovate-platforms/'>the full Tradovate platforms guide</a>." },
    { type: "heading", text: "Troubleshooting a Failed Install or Login" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Stuck on a loading or login screen?</strong> Nine times out of ten it's your system clock. Set your computer's date, time, and timezone to update automatically and sync them, then try again.",
        "<strong class='text-white'>App acting broken after an update?</strong> The install can occasionally get corrupted. Uninstall it and reinstall from the official link, a clean copy usually clears it up.",
        "<strong class='text-white'>Credentials rejected?</strong> Make sure you're using the right login for the right account type. Our <a href='https://pickmytrade.trade/how-to/tradovate-login/'>Tradovate login guide</a> walks through the common mix-ups.",
      ],
    },
    { type: "heading", text: "Automate Tradovate with PickMyTrade" },
    { type: "paragraph", html: "Once the app is installed, you can go one step further and stop clicking altogether. <strong class='text-white'>PickMyTrade routes your TradingView alerts straight to your Tradovate account</strong>, so your strategy fires on its own, whether the desktop app is open or not." },
  ], de: [
    { type: "paragraph",html: "Die Webplattform läuft im Browser einwandfrei, aber viele Futures-Trader hätten lieber eine eigene App. Die Tradovate-Desktop-App hat ein eigenes Fenster, belegt keine Browser-Tabs und verschwindet nicht, wenn Sie mitten in der Sitzung versehentlich Chrome schließen. Sie ist kostenlos, es ist dieselbe Plattform, die Sie bereits kennen, und die Einrichtung dauert etwa fünf Minuten. So holen Sie sie sich für Windows oder Mac." },
    { type: "heading",text: "Was ist die Tradovate-Desktop-App?" },
    { type: "paragraph",html: "Es ist eine eigenständige Version der Tradovate-Plattform, die Sie auf einem Windows-PC oder Mac installieren. Dieselben Charts, dieselbe DOM, dieselben Order-Tickets wie im browserbasierten Web Trader, nur in einer eigenen Anwendung statt in einem Browser-Tab. Sie melden sich mit denselben Zugangsdaten an, legen also kein neues Konto an und zahlen nichts extra für die Nutzung." },
    { type: "heading",text: "Vor dem Download" },
    {
      type: "list",
      items: [
        "Ein Tradovate-Konto. Handel mit eigenem Geld oder über eine Prop Firm funktioniert beides. Noch keines? So <a href='https://pickmytrade.trade/how-to/tradovate-open-account/'>eröffnen Sie ein Tradovate-Konto</a>.",
        "Ein Windows-PC oder Mac mit der Berechtigung, Software zu installieren (auf stark abgesicherten Arbeitsrechnern benötigen Sie Administratorrechte).",
        "Ihre Zugangsdaten griffbereit, die Daten Ihres persönlichen Kontos oder der von Ihrer Prop Firm ausgestellte Benutzername.",
      ],
    },
    { type: "heading",text: "Die Tradovate-Desktop-App herunterladen: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Die offizielle Download-Seite öffnen", html: "Rufen Sie Tradovates offizielle Geräteseite unter <strong class='text-white'>tradovate.com/devices</strong> auf. Das ist die eine Seite, die alle Versionen enthält, Desktop, Web und Mobil. Halten Sie sich daran. Die App von einer beliebigen „Free-Download“-Seite zu laden, ist ein sicherer Weg, etwas auf einem Rechner zu landen, der mit Ihrem Brokerage-Konto in Kontakt steht, das Sie dort nicht haben möchten." },
        { title: "Windows oder Mac wählen", html: "Sie sehen zwei deutlich beschriftete Schaltflächen: <strong class='text-white'>Download Windows</strong> und <strong class='text-white'>Download Mac</strong>. Klicken Sie auf die, die zu Ihrem Rechner passt. Unter Windows laden Sie eine Installationsdatei herunter, unter Mac ein Disk-Image. Erkennt die Seite Ihr System automatisch, steht meist schon die richtige Schaltfläche im Vordergrund, prüfen Sie sie dennoch, bevor Sie klicken." },
        { title: "Unter Windows installieren", html: "Öffnen Sie die heruntergeladene Installationsdatei aus Ihrem Download-Ordner und folgen Sie den Anweisungen. Windows zeigt eventuell eine SmartScreen- oder Benutzerkontensteuerungs-Warnung an, das ist bei einer frisch heruntergeladenen App normal. Wählen Sie, die Datei trotzdem auszuführen, und lassen Sie die Installation fortfahren. Danach erscheint Tradovate im Startmenü und (meist) auf dem Desktop, bereit zum Öffnen." },
        { title: "Unter Mac installieren", html: "Doppelklicken Sie auf das heruntergeladene Disk-Image und ziehen Sie das Tradovate-Symbol in Ihren Ordner <strong class='text-white'>Applications</strong>. Beim ersten Öffnen meldet macOS möglicherweise, die App stamme von einem nicht identifizierten Entwickler. In diesem Fall gehen Sie zu <strong class='text-white'>System Settings &rsaquo; Privacy &amp; Security</strong> und klicken auf <strong class='text-white'>Open Anyway</strong>, oder Sie klicken mit der rechten Maustaste auf die App und wählen <strong class='text-white'>Open</strong>. Nach dieser einmaligen Bestätigung startet sie jedes Mal normal." },
        { title: "App öffnen und anmelden", html: "Starten Sie Tradovate und melden Sie sich an. Bei einem persönlichen Konto verwenden Sie Ihre Tradovate-E-Mail-Adresse und Ihr Passwort. Bei einem Prop-Firm- oder Evaluierungskonto melden Sie sich mit dem Benutzernamen an, den Ihre Firma Ihnen gegeben hat, das genaue Format und der Ort, an dem Sie die Anmeldung starten, unterscheiden sich je nach Firma. Schauen Sie im Zweifel in die Willkommens-E-Mail oder den Mitgliederbereich Ihrer Firma. Wählen Sie das Konto, mit dem Sie handeln möchten, und schon sind Sie drin." },
      ],
    },
    { type: "heading",text: "Lieber nichts installieren? Web oder Mobil nutzen" },
    { type: "paragraph",html: "Nicht jeder möchte noch eine App auf dem Rechner, und das ist in Ordnung. Die Browser-Version kann alles, was die Desktop-App kann, und es gibt iPhone- und Android-Apps, wenn Sie Positionen lieber unterwegs im Blick behalten. Einen Überblick über alle Optionen finden Sie in <a href='https://pickmytrade.trade/how-to/tradovate-platforms/'>der vollständigen Anleitung zu den Tradovate-Plattformen</a>." },
    { type: "heading",text: "Fehlgeschlagene Installation oder Anmeldung beheben" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Hängen Sie auf einem Lade- oder Anmeldebildschirm fest?</strong> In neun von zehn Fällen liegt es an Ihrer Systemuhr. Stellen Sie Datum, Uhrzeit und Zeitzone Ihres Rechners auf automatische Aktualisierung und synchronisieren Sie sie, dann versuchen Sie es erneut.",
        "<strong class='text-white'>App verhält sich nach einem Update fehlerhaft?</strong> Die Installation kann gelegentlich beschädigt werden. Deinstallieren Sie sie und installieren Sie sie über den offiziellen Link neu, eine saubere Kopie behebt das meist.",
        "<strong class='text-white'>Zugangsdaten werden abgelehnt?</strong> Stellen Sie sicher, dass Sie die richtigen Zugangsdaten für den richtigen Kontotyp verwenden. Unsere <a href='https://pickmytrade.trade/how-to/tradovate-login/'>Anleitung zur Tradovate-Anmeldung</a> geht die häufigsten Verwechslungen durch.",
      ],
    },
    { type: "heading",text: "Tradovate mit PickMyTrade automatisieren" },
    { type: "paragraph",html: "Sobald die App installiert ist, können Sie noch einen Schritt weitergehen und gar nicht mehr klicken. <strong class='text-white'>PickMyTrade leitet Ihre TradingView-Alerts direkt an Ihr Tradovate-Konto weiter</strong>, sodass Ihre Strategie von selbst ausgeführt wird, ob die Desktop-App geöffnet ist oder nicht." },
  ], es: [
    { type: "paragraph",html: "La plataforma web funciona bien en un navegador, pero muchos traders de futuros prefieren una aplicación dedicada. La aplicación de escritorio de Tradovate tiene su propia ventana, no ocupa pestañas del navegador y no desaparece si cierra Chrome por accidente en plena sesión. Es gratuita, es la misma plataforma que ya conoce y la configuración lleva unos cinco minutos. Así se instala en Windows o Mac." },
    { type: "heading",text: "¿Qué es la aplicación de escritorio de Tradovate?" },
    { type: "paragraph",html: "Es una versión independiente de la plataforma Tradovate que se instala en un PC con Windows o en un Mac. Los mismos gráficos, el mismo DOM, los mismos tickets de orden que en el Web Trader del navegador, solo que dentro de su propia aplicación en lugar de una pestaña del navegador. Inicia sesión con las mismas credenciales, así que no crea una cuenta nueva ni paga nada adicional por usarla." },
    { type: "heading",text: "Antes de descargar" },
    {
      type: "list",
      items: [
        "Una cuenta de Tradovate. Sirve tanto operar con su propio dinero como a través de una prop firm. ¿Todavía no tiene una? Aquí le explicamos <a href='https://pickmytrade.trade/how-to/tradovate-open-account/'>cómo abrir una cuenta de Tradovate</a>.",
        "Un ordenador con Windows o un Mac con permiso para instalar software (necesitará derechos de administrador en equipos de trabajo restringidos).",
        "Sus datos de inicio de sesión a mano, las credenciales de su cuenta personal o el nombre de usuario que le asignó su prop firm.",
      ],
    },
    { type: "heading",text: "Descargue la aplicación de escritorio de Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra la página de descarga oficial", html: "Vaya a la página oficial de dispositivos de Tradovate en <strong class='text-white'>tradovate.com/devices</strong>. Es la única página que reúne todas las versiones, escritorio, web y móvil. Ciñase a ella. Descargar la aplicación desde cualquier sitio de «descarga gratuita» es la forma más rápida de acabar con algo que no quiere en un equipo que toca su cuenta de corretaje." },
        { title: "Elija Windows o Mac", html: "Verá dos botones claramente etiquetados: <strong class='text-white'>Download Windows</strong> y <strong class='text-white'>Download Mac</strong>. Haga clic en el que corresponda a su equipo. En Windows se descarga un archivo instalador; en Mac, una imagen de disco. Si la página detecta su sistema automáticamente, el botón correcto suele aparecer en primer plano, pero compruébelo antes de hacer clic." },
        { title: "Instale en Windows", html: "Abra el instalador descargado desde su carpeta de Descargas y siga las indicaciones. Windows puede mostrar una advertencia de SmartScreen o de Control de cuentas de usuario, algo normal en una aplicación recién descargada. Elija ejecutarla de todos modos y permita que continúe la instalación. Al terminar, Tradovate aparece en el menú Inicio y (normalmente) en el escritorio, listo para abrirse." },
        { title: "Instale en Mac", html: "Haga doble clic en la imagen de disco descargada y arrastre el icono de Tradovate a su carpeta <strong class='text-white'>Applications</strong>. La primera vez que la abra, es posible que macOS indique que la aplicación es de un desarrollador no identificado. Si es así, vaya a <strong class='text-white'>System Settings &rsaquo; Privacy &amp; Security</strong> y haga clic en <strong class='text-white'>Open Anyway</strong>, o haga clic con el botón derecho en la aplicación y elija <strong class='text-white'>Open</strong>. Tras esa única aprobación, se inicia con normalidad siempre." },
        { title: "Abra la aplicación e inicie sesión", html: "Inicie Tradovate e inicie sesión. En una cuenta personal, use su correo electrónico y contraseña de Tradovate. En una cuenta de prop firm o de evaluación, inicie sesión con el nombre de usuario que le dio su firma, el formato exacto y desde dónde se inicia sesión varían según la firma, así que consulte el correo de bienvenida o el área de miembros de su firma si tiene dudas. Elija la cuenta con la que desea operar y ya está dentro." },
      ],
    },
    { type: "heading",text: "¿Prefiere no instalar nada? Use la web o el móvil" },
    { type: "paragraph",html: "No todo el mundo quiere otra aplicación en su equipo, y no pasa nada. La versión de navegador hace todo lo que hace la aplicación de escritorio, y hay aplicaciones para iPhone y Android si prefiere vigilar sus posiciones en movimiento. Para un resumen de todas las opciones, consulte <a href='https://pickmytrade.trade/how-to/tradovate-platforms/'>la guía completa de plataformas de Tradovate</a>." },
    { type: "heading",text: "Solución de problemas de una instalación o un inicio de sesión fallidos" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>¿Se queda atascado en una pantalla de carga o de inicio de sesión?</strong> Nueve de cada diez veces es el reloj de su sistema. Configure la fecha, la hora y la zona horaria de su ordenador para que se actualicen automáticamente y sincronícelas; después vuelva a intentarlo.",
        "<strong class='text-white'>¿La aplicación falla después de una actualización?</strong> La instalación puede corromperse en ocasiones. Desinstálela y vuelva a instalarla desde el enlace oficial; una copia limpia suele resolverlo.",
        "<strong class='text-white'>¿Se rechazan sus credenciales?</strong> Asegúrese de usar el inicio de sesión correcto para el tipo de cuenta correcto. Nuestra <a href='https://pickmytrade.trade/how-to/tradovate-login/'>guía de inicio de sesión de Tradovate</a> repasa las confusiones más habituales.",
      ],
    },
    { type: "heading",text: "Automatice Tradovate con PickMyTrade" },
    { type: "paragraph",html: "Una vez instalada la aplicación, puede ir un paso más allá y dejar de hacer clic por completo. <strong class='text-white'>PickMyTrade enruta sus alertas de TradingView directamente a su cuenta de Tradovate</strong>, de modo que su estrategia se ejecuta sola, tenga o no abierta la aplicación de escritorio." },
  ], fr: [
    { type: "paragraph",html: "La plateforme web fonctionne très bien dans un navigateur, mais beaucoup de traders de contrats à terme préfèrent une application dédiée. L'application de bureau Tradovate dispose de sa propre fenêtre, n'occupe aucun onglet de navigateur et ne disparaît pas si vous fermez Chrome par erreur en pleine session. Elle est gratuite, c'est la même plateforme que celle que vous connaissez déjà, et l'installation prend environ cinq minutes. Voici comment l'obtenir sous Windows ou sur Mac." },
    { type: "heading",text: "Qu'est-ce que l'application de bureau Tradovate ?" },
    { type: "paragraph",html: "C'est une version autonome de la plateforme Tradovate que vous installez sur un PC Windows ou un Mac. Mêmes graphiques, même DOM, mêmes tickets d'ordre que dans le Web Trader du navigateur, simplement intégrés à leur propre application au lieu d'un onglet de navigateur. Vous vous connectez avec les mêmes identifiants : vous ne créez donc pas de nouveau compte et ne payez rien de plus pour l'utiliser." },
    { type: "heading",text: "Avant de télécharger" },
    {
      type: "list",
      items: [
        "Un compte Tradovate. Trader avec votre propre argent ou via une prop firm fonctionne dans les deux cas. Vous n'en avez pas encore ? Voici <a href='https://pickmytrade.trade/how-to/tradovate-open-account/'>comment ouvrir un compte Tradovate</a>.",
        "Un ordinateur Windows ou un Mac avec l'autorisation d'installer des logiciels (il vous faudra les droits d'administrateur sur les machines professionnelles verrouillées).",
        "Vos identifiants de connexion à portée de main, ceux de votre compte personnel ou le nom d'utilisateur fourni par votre prop firm.",
      ],
    },
    { type: "heading",text: "Télécharger l'application de bureau Tradovate : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir la page de téléchargement officielle", html: "Rendez-vous sur la page officielle des appareils de Tradovate à l'adresse <strong class='text-white'>tradovate.com/devices</strong>. C'est l'unique page qui regroupe toutes les versions, bureau, web et mobile. Tenez-vous-y. Récupérer l'application sur un site de « téléchargement gratuit » quelconque est le moyen le plus sûr de se retrouver avec quelque chose dont vous ne voulez pas sur une machine qui touche votre compte de courtage." },
        { title: "Choisir Windows ou Mac", html: "Vous verrez deux boutons clairement libellés : <strong class='text-white'>Download Windows</strong> et <strong class='text-white'>Download Mac</strong>. Cliquez sur celui qui correspond à votre machine. Windows télécharge un fichier d'installation ; Mac télécharge une image disque. Si la page détecte automatiquement votre système, le bon bouton est généralement mis en avant, mais vérifiez-le avant de cliquer." },
        { title: "Installer sous Windows", html: "Ouvrez le programme d'installation téléchargé depuis votre dossier Téléchargements et suivez les instructions. Windows peut afficher un avertissement SmartScreen ou du Contrôle de compte d'utilisateur, ce qui est normal pour une application fraîchement téléchargée. Choisissez de l'exécuter quand même et laissez l'installation se poursuivre. Une fois terminée, Tradovate apparaît dans le menu Démarrer et (généralement) sur le bureau, prêt à s'ouvrir." },
        { title: "Installer sur Mac", html: "Double-cliquez sur l'image disque téléchargée, puis faites glisser l'icône Tradovate dans votre dossier <strong class='text-white'>Applications</strong>. À la première ouverture, macOS peut indiquer que l'application provient d'un développeur non identifié. Si c'est le cas, allez dans <strong class='text-white'>System Settings &rsaquo; Privacy &amp; Security</strong> et cliquez sur <strong class='text-white'>Open Anyway</strong>, ou faites un clic droit sur l'application et choisissez <strong class='text-white'>Open</strong>. Après cette unique validation, elle se lance normalement à chaque fois." },
        { title: "Ouvrir l'application et se connecter", html: "Lancez Tradovate et connectez-vous. Avec un compte personnel, utilisez votre e-mail et votre mot de passe Tradovate. Avec un compte de prop firm ou d'évaluation, connectez-vous avec le nom d'utilisateur que votre firme vous a donné, le format exact et l'endroit d'où vous démarrez la connexion varient selon la firme ; consultez donc l'e-mail de bienvenue ou l'espace membre de votre firme en cas de doute. Choisissez le compte sur lequel vous voulez trader, et vous y êtes." },
      ],
    },
    { type: "heading",text: "Vous préférez ne rien installer ? Utilisez le web ou le mobile" },
    { type: "paragraph",html: "Tout le monde ne veut pas d'une application de plus sur sa machine, et c'est très bien. La version navigateur fait tout ce que fait l'application de bureau, et il existe des applications iPhone et Android si vous préférez suivre vos positions en déplacement. Pour un tour d'horizon de toutes les options, consultez <a href='https://pickmytrade.trade/how-to/tradovate-platforms/'>le guide complet des plateformes Tradovate</a>." },
    { type: "heading",text: "Dépannage d'une installation ou d'une connexion qui échoue" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Bloqué sur un écran de chargement ou de connexion ?</strong> Neuf fois sur dix, c'est l'horloge de votre système. Réglez la date, l'heure et le fuseau horaire de votre ordinateur sur une mise à jour automatique, synchronisez-les, puis réessayez.",
        "<strong class='text-white'>L'application dysfonctionne après une mise à jour ?</strong> L'installation peut parfois être corrompue. Désinstallez-la et réinstallez-la depuis le lien officiel ; une copie propre règle généralement le problème.",
        "<strong class='text-white'>Identifiants refusés ?</strong> Vérifiez que vous utilisez le bon identifiant pour le bon type de compte. Notre <a href='https://pickmytrade.trade/how-to/tradovate-login/'>guide de connexion à Tradovate</a> passe en revue les confusions les plus courantes.",
