---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-notification-sounds";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Customize Tradovate Notification Sounds";
const META_DESCRIPTION =
  "Assign custom notification sounds to order fills, rejections, and cancels from the built-in audio library, and preview each sound before you set it.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Benachrichtigungssounds in Tradovate anpassen", es: "Personalice los sonidos de notificación de Tradovate", fr: "Personnaliser les sons de notification de Tradovate", it: "Personalizzare i suoni di notifica di Tradovate" },
  dek: { en: "Assign custom notification sounds to order fills, rejections, and cancels from the built-in audio library, and preview each sound before you set it.", de: "Weisen Sie Order-Ausführungen, Ablehnungen und Stornierungen individuelle Benachrichtigungssounds aus der integrierten Audiobibliothek zu und hören Sie jeden Sound vorab an, bevor Sie ihn festlegen.", es: "Asigne sonidos de notificación personalizados a las ejecuciones, rechazos y cancelaciones de órdenes desde la biblioteca de audio integrada y escuche cada sonido antes de configurarlo.", fr: "Attribuez des sons de notification personnalisés aux exécutions, rejets et annulations d'ordres depuis la bibliothèque audio intégrée, et écoutez chaque son avant de le définir.", it: "Assegni suoni di notifica personalizzati a esecuzioni, rifiuti e cancellazioni degli ordini dalla libreria audio integrata e ascolti ogni suono in anteprima prima di impostarlo." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "A fill that slips by while you're staring at the chart can cost you a clean exit. Tradovate lets you swap the stock beep for a sound you'll actually react to, and you can set a different one for each order event, so a fill and a rejection never sound identical. Here's how to pick sounds from the built-in library and tune them event by event." },
    { type: "paragraph", html: "Everything lives in one place: <strong class='text-white'>Application Settings &rsaquo; Notifications &rsaquo; Audio Notifications</strong>. That panel lists every order status you can attach a sound to, and each row has its own controls. You're choosing from a set of built-in sounds, not uploading your own files, so the job is really about matching the right pre-made tone to the right event." },
    { type: "heading", text: "What You Can Attach a Sound To" },
    { type: "paragraph", html: "Audio notifications fire on order status changes, and each state gets its own row you can customize or silence:" },
    {
      type: "table",
      headers: ["Order event", "Why you'd want a distinct sound"],
      rows: [
        ["Filled / Partial Fill", "Confirms you're in (or partially in) without looking at the ladder."],
        ["Rejected", "The one you never want to miss. Make it sharp and different from a fill."],
        ["Canceled / Modification Rejected", "Tells you a working order or an edit didn't stick."],
        ["Working / Stop Fill / Suspended / Expired", "Useful cues for stops triggering or orders aging out of the session."],
      ],
    },
    { type: "heading", text: "Customize Notification Sounds: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open Application Settings and Go to Notifications", html: "In the Tradovate web trader, open <strong class='text-white'>Application Settings</strong> from the settings icon, then select <strong class='text-white'>Notifications</strong>. This is the same panel that controls order status pop-ups and push notifications, so you'll see a few tabs or sections grouped together.", image: { src: `${IMG}/tradovate-notification-sounds-1.png`, alt: "Tradovate web trader Application Settings menu with the Notifications option selected" } },
        { title: "Find the Audio Notifications Section", html: "Scroll to <strong class='text-white'>Audio Notifications</strong>. You'll see a list of order events, and each row carries an on/off toggle plus a blue link. That blue link is the important part: it shows the sound currently assigned to the event, either the word <strong class='text-white'>Default</strong> or the name of a sound you picked earlier.", image: { src: `${IMG}/tradovate-notification-sounds-2.png`, alt: "Audio Notifications list showing order events with toggles and blue current-sound links" } },
        { title: "Open the Sound Library", html: "Click the blue sound link on the event you want to change, say <strong class='text-white'>Filled</strong>. A list of the available sounds opens. This is the library that shipped with the \"choose from a library of sounds\" feature, so you get a spread of tones to work with rather than one flat beep.", image: { src: `${IMG}/tradovate-notification-sounds-3.png`, alt: "Tradovate notification sound library open with a list of selectable sounds" } },
        { title: "Preview and Choose a Sound", html: "Click the play icon next to any sound to hear it before you commit. Audio plays straight through your browser, so turn your volume up enough to judge it. When you find one you like, select it. The blue link updates to show the new sound's name, and it applies to that event right away, no separate save step.", image: { src: `${IMG}/tradovate-notification-sounds-4.png`, alt: "Previewing and selecting a notification sound with the play icon in Tradovate" } },
        { title: "Repeat Per Event and Mute What You Don't Need", html: "Do the same for the events that matter to your style. A good rule of thumb: give <strong class='text-white'>Filled</strong>, <strong class='text-white'>Rejected</strong>, and <strong class='text-white'>Canceled</strong> three clearly different sounds so you can tell them apart with your eyes on price. And if the constant \"order filled\" chime wears thin during heavy scalping, flip that row's toggle off to silence it while keeping rejections loud." },
      ],
    },
    { type: "heading", text: "A Few Things Worth Knowing" },
    { type: "paragraph", html: "The library is a fixed set of built-in sounds. There's no option to upload your own MP3 into the trader, so pick the closest match from what's there. Audio notifications are also separate from price alerts, which carry their own sound settings, and separate from mobile push notifications. If you reinstall the app or move to a new device, check these settings again since they don't always follow you." },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Tired of babysitting every fill and manually firing each entry? <strong class='text-white'>PickMyTrade automates your TradingView strategy straight into Tradovate</strong>, so the platform executes for you while those custom sounds just confirm what already happened." },
  ], de: [
    { type: "paragraph",html: "Eine Ausführung, die an Ihnen vorbeigeht, während Sie auf den Chart starren, kann Sie einen sauberen Ausstieg kosten. Mit Tradovate können Sie den Standard-Piepton durch einen Sound ersetzen, auf den Sie wirklich reagieren, und für jedes Order-Ereignis einen eigenen festlegen, sodass eine Ausführung und eine Ablehnung nie gleich klingen. So wählen Sie Sounds aus der integrierten Bibliothek und stimmen sie Ereignis für Ereignis ab." },
    { type: "paragraph",html: "Alles befindet sich an einem Ort: <strong class='text-white'>Application Settings &rsaquo; Notifications &rsaquo; Audio Notifications</strong>. Dieses Panel listet jeden Order-Status auf, dem Sie einen Sound zuweisen können, und jede Zeile hat eigene Steuerelemente. Sie wählen aus einer Reihe integrierter Sounds und laden keine eigenen Dateien hoch; es geht also darum, den passenden vorgefertigten Ton dem richtigen Ereignis zuzuordnen." },
    { type: "heading",text: "Welchen Ereignissen Sie einen Sound zuweisen können" },
    { type: "paragraph",html: "Audio-Benachrichtigungen werden bei Änderungen des Order-Status ausgelöst, und jeder Zustand hat eine eigene Zeile, die Sie anpassen oder stummschalten können:" },
    { type: "table", headers: ["Order-Ereignis","Warum Sie einen eigenen Sound möchten"], rows: [
      ["Filled / Partial Fill","Bestätigt, dass Sie drin (oder teilweise drin) sind, ohne auf die Leiter zu schauen."],
      ["Rejected","Das Ereignis, das Sie nie verpassen möchten. Wählen Sie einen scharfen, von der Ausführung klar unterscheidbaren Ton."],
      ["Canceled / Modification Rejected","Zeigt Ihnen, dass eine aktive Order oder eine Änderung nicht übernommen wurde."],
      ["Working / Stop Fill / Suspended / Expired","Nützliche Hinweise darauf, dass Stops ausgelöst werden oder Orders aus der Session fallen."],
    ] },
    { type: "heading",text: "Benachrichtigungssounds anpassen: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Application Settings öffnen und zu Notifications wechseln", html: "Öffnen Sie im Tradovate-Web-Trader über das Einstellungssymbol die <strong class='text-white'>Application Settings</strong> und wählen Sie dann <strong class='text-white'>Notifications</strong>. Dieses Panel steuert auch die Order-Status-Pop-ups und Push-Benachrichtigungen, sodass Sie mehrere Tabs oder Abschnitte gebündelt sehen.", image: {"src":`${IMG}/tradovate-notification-sounds-1.png`,"alt":"Menü Application Settings im Tradovate-Web-Trader mit ausgewählter Option Notifications"} },
        { title: "Abschnitt Audio Notifications finden", html: "Scrollen Sie zu <strong class='text-white'>Audio Notifications</strong>. Sie sehen eine Liste von Order-Ereignissen, und jede Zeile hat einen Ein/Aus-Schalter sowie einen blauen Link. Dieser blaue Link ist der wichtigste Teil: Er zeigt den Sound, der dem Ereignis aktuell zugewiesen ist, entweder das Wort <strong class='text-white'>Default</strong> oder den Namen eines Sounds, den Sie zuvor gewählt haben.", image: {"src":`${IMG}/tradovate-notification-sounds-2.png`,"alt":"Liste Audio Notifications mit Order-Ereignissen, Schaltern und blauen Links zum aktuellen Sound"} },
        { title: "Soundbibliothek öffnen", html: "Klicken Sie auf den blauen Sound-Link des Ereignisses, das Sie ändern möchten, etwa <strong class='text-white'>Filled</strong>. Eine Liste der verfügbaren Sounds öffnet sich. Dies ist die Bibliothek, die mit der Funktion „Sound aus einer Bibliothek auswählen“ eingeführt wurde, sodass Sie eine Auswahl an Tönen statt eines einzigen flachen Pieptons haben.", image: {"src":`${IMG}/tradovate-notification-sounds-3.png`,"alt":"Geöffnete Soundbibliothek für Benachrichtigungen in Tradovate mit einer Liste auswählbarer Sounds"} },
        { title: "Sound anhören und auswählen", html: "Klicken Sie auf das Wiedergabesymbol neben einem Sound, um ihn vor der Auswahl anzuhören. Das Audio wird direkt über Ihren Browser abgespielt; stellen Sie die Lautstärke also hoch genug ein, um den Sound zu beurteilen. Wenn Sie einen passenden gefunden haben, wählen Sie ihn aus. Der blaue Link zeigt nun den Namen des neuen Sounds, und er gilt sofort für dieses Ereignis, ganz ohne separaten Speichern-Schritt.", image: {"src":`${IMG}/tradovate-notification-sounds-4.png`,"alt":"Sound mit dem Wiedergabesymbol in Tradovate anhören und auswählen"} },
        { title: "Pro Ereignis wiederholen und Unnötiges stummschalten", html: "Gehen Sie für die Ereignisse, die für Ihren Handelsstil wichtig sind, genauso vor. Eine gute Faustregel: Geben Sie <strong class='text-white'>Filled</strong>, <strong class='text-white'>Rejected</strong> und <strong class='text-white'>Canceled</strong> drei deutlich verschiedene Sounds, damit Sie sie auseinanderhalten können, während Ihr Blick auf dem Kurs liegt. Und wenn Ihnen der ständige „Order filled“-Ton beim intensiven Scalping auf die Nerven geht, schalten Sie den Schalter dieser Zeile aus, um ihn stummzuschalten, während Ablehnungen laut bleiben." },
      ],
    },
    { type: "heading",text: "Ein paar Dinge, die Sie wissen sollten" },
    { type: "paragraph",html: "Die Bibliothek ist ein fester Satz integrierter Sounds. Es gibt keine Möglichkeit, eigene MP3-Dateien in den Trader hochzuladen; wählen Sie also die nächstliegende Entsprechung aus dem Angebot. Audio-Benachrichtigungen sind außerdem getrennt von Preis-Alerts, die eigene Soundeinstellungen haben, und getrennt von mobilen Push-Benachrichtigungen. Wenn Sie die App neu installieren oder auf ein neues Gerät wechseln, prüfen Sie diese Einstellungen erneut, da sie Ihnen nicht immer folgen." },
    { type: "heading",text: "Mit PickMyTrade automatisieren" },
    { type: "paragraph",html: "Haben Sie es satt, jede Ausführung zu beobachten und jeden Einstieg manuell auszulösen? <strong class='text-white'>PickMyTrade automatisiert Ihre TradingView-Strategie direkt in Tradovate</strong>, sodass die Plattform für Sie ausführt, während Ihre individuellen Sounds nur bestätigen, was bereits geschehen ist." },
  ], es: [
    { type: "paragraph",html: "Una ejecución que pasa desapercibida mientras mira el gráfico puede costarle una salida limpia. Tradovate le permite cambiar el pitido estándar por un sonido al que sí reaccione, y puede asignar uno distinto a cada evento de orden, de modo que una ejecución y un rechazo nunca suenen igual. Aquí le explicamos cómo elegir sonidos de la biblioteca integrada y ajustarlos evento por evento." },
    { type: "paragraph",html: "Todo está en un solo lugar: <strong class='text-white'>Application Settings &rsaquo; Notifications &rsaquo; Audio Notifications</strong>. Ese panel enumera cada estado de orden al que puede asociar un sonido, y cada fila tiene sus propios controles. Elige entre un conjunto de sonidos integrados, no sube sus propios archivos, por lo que se trata de asociar el tono predefinido adecuado al evento correcto." },
    { type: "heading",text: "A qué eventos puede asociar un sonido" },
    { type: "paragraph",html: "Las notificaciones de audio se activan con los cambios de estado de las órdenes, y cada estado tiene su propia fila que puede personalizar o silenciar:" },
    { type: "table", headers: ["Evento de orden","Por qué querría un sonido distinto"], rows: [
      ["Filled / Partial Fill","Confirma que está dentro (o parcialmente dentro) sin mirar la escalera."],
      ["Rejected","El que nunca querrá perderse. Hágalo agudo y distinto al de una ejecución."],
      ["Canceled / Modification Rejected","Le indica que una orden activa o una modificación no se aplicó."],
      ["Working / Stop Fill / Suspended / Expired","Avisos útiles cuando se activan stops o las órdenes caducan al terminar la sesión."],
    ] },
    { type: "heading",text: "Personalice los sonidos de notificación paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra Application Settings y vaya a Notifications", html: "En el trader web de Tradovate, abra <strong class='text-white'>Application Settings</strong> desde el icono de ajustes y luego seleccione <strong class='text-white'>Notifications</strong>. Este es el mismo panel que controla las ventanas emergentes de estado de órdenes y las notificaciones push, por lo que verá varias pestañas o secciones agrupadas.", image: {"src":`${IMG}/tradovate-notification-sounds-1.png`,"alt":"Menú Application Settings del trader web de Tradovate con la opción Notifications seleccionada"} },
        { title: "Busque la sección Audio Notifications", html: "Desplácese hasta <strong class='text-white'>Audio Notifications</strong>. Verá una lista de eventos de órdenes y cada fila incluye un interruptor de activación y un enlace azul. Ese enlace azul es lo más importante: muestra el sonido asignado actualmente al evento, ya sea la palabra <strong class='text-white'>Default</strong> o el nombre de un sonido que eligió antes.", image: {"src":`${IMG}/tradovate-notification-sounds-2.png`,"alt":"Lista Audio Notifications con eventos de órdenes, interruptores y enlaces azules del sonido actual"} },
        { title: "Abra la biblioteca de sonidos", html: "Haga clic en el enlace azul del sonido del evento que desea cambiar, por ejemplo <strong class='text-white'>Filled</strong>. Se abre una lista de los sonidos disponibles. Es la biblioteca que llegó con la función «elegir entre una biblioteca de sonidos», de modo que dispone de una variedad de tonos en lugar de un único pitido plano.", image: {"src":`${IMG}/tradovate-notification-sounds-3.png`,"alt":"Biblioteca de sonidos de notificación de Tradovate abierta con una lista de sonidos seleccionables"} },
        { title: "Escuche y elija un sonido", html: "Haga clic en el icono de reproducción junto a cualquier sonido para oírlo antes de confirmar. El audio se reproduce directamente a través de su navegador, así que suba el volumen lo suficiente para valorarlo. Cuando encuentre uno que le guste, selecciónelo. El enlace azul se actualiza con el nombre del nuevo sonido y se aplica al evento de inmediato, sin un paso de guardado aparte.", image: {"src":`${IMG}/tradovate-notification-sounds-4.png`,"alt":"Escucha y selección de un sonido de notificación con el icono de reproducción en Tradovate"} },
        { title: "Repita por evento y silencie lo que no necesite", html: "Haga lo mismo con los eventos que importan para su estilo. Una buena regla general: asigne a <strong class='text-white'>Filled</strong>, <strong class='text-white'>Rejected</strong> y <strong class='text-white'>Canceled</strong> tres sonidos claramente distintos para diferenciarlos con la vista en el precio. Y si el constante aviso de «order filled» le cansa durante un scalping intenso, desactive el interruptor de esa fila para silenciarlo y mantener fuertes los rechazos." },
      ],
    },
    { type: "heading",text: "Algunas cosas que conviene saber" },
    { type: "paragraph",html: "La biblioteca es un conjunto fijo de sonidos integrados. No hay opción de subir sus propios MP3 al trader, así que elija la coincidencia más cercana entre los disponibles. Las notificaciones de audio también son independientes de las alertas de precio, que tienen sus propios ajustes de sonido, y de las notificaciones push móviles. Si reinstala la aplicación o cambia de dispositivo, revise de nuevo estos ajustes, ya que no siempre le acompañan." },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "¿Cansado de vigilar cada ejecución y de lanzar cada entrada manualmente? <strong class='text-white'>PickMyTrade automatiza su estrategia de TradingView directamente en Tradovate</strong>, para que la plataforma ejecute por usted mientras esos sonidos personalizados solo confirman lo que ya ocurrió." },
  ], fr: [
    { type: "paragraph",html: "Une exécution qui vous échappe pendant que vous fixez le graphique peut vous coûter une sortie propre. Tradovate vous permet de remplacer le bip par défaut par un son auquel vous réagirez vraiment, et vous pouvez en définir un différent pour chaque événement d'ordre, de sorte qu'une exécution et un rejet ne sonnent jamais pareil. Voici comment choisir des sons dans la bibliothèque intégrée et les régler événement par événement." },
    { type: "paragraph",html: "Tout se trouve au même endroit : <strong class='text-white'>Application Settings &rsaquo; Notifications &rsaquo; Audio Notifications</strong>. Ce panneau répertorie chaque statut d'ordre auquel vous pouvez associer un son, et chaque ligne a ses propres commandes. Vous choisissez parmi un ensemble de sons intégrés, sans téléverser vos propres fichiers ; il s'agit donc d'associer le bon son préenregistré au bon événement." },
    { type: "heading",text: "Les événements auxquels vous pouvez associer un son" },
    { type: "paragraph",html: "Les notifications audio se déclenchent lors des changements de statut d'ordre, et chaque état dispose de sa propre ligne que vous pouvez personnaliser ou faire taire :" },
    { type: "table", headers: ["Événement d'ordre","Pourquoi vous voudriez un son distinct"], rows: [
      ["Filled / Partial Fill","Confirme que vous êtes en position (ou partiellement) sans regarder l'échelle."],
      ["Rejected","Celui que vous ne voulez jamais manquer. Choisissez un son net, différent de celui d'une exécution."],
      ["Canceled / Modification Rejected","Vous indique qu'un ordre en attente ou une modification n'a pas été pris en compte."],
      ["Working / Stop Fill / Suspended / Expired","Repères utiles lorsque des stops se déclenchent ou que des ordres expirent en fin de session."],
    ] },
    { type: "heading",text: "Personnaliser les sons de notification : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir Application Settings et aller dans Notifications", html: "Dans le trader web de Tradovate, ouvrez <strong class='text-white'>Application Settings</strong> depuis l'icône des paramètres, puis sélectionnez <strong class='text-white'>Notifications</strong>. C'est le même panneau qui contrôle les fenêtres contextuelles de statut d'ordre et les notifications push ; vous y verrez donc plusieurs onglets ou sections regroupés.", image: {"src":`${IMG}/tradovate-notification-sounds-1.png`,"alt":"Menu Application Settings du trader web Tradovate avec l'option Notifications sélectionnée"} },
        { title: "Trouver la section Audio Notifications", html: "Faites défiler jusqu'à <strong class='text-white'>Audio Notifications</strong>. Vous verrez une liste d'événements d'ordre, chaque ligne comportant un interrupteur marche/arrêt et un lien bleu. Ce lien bleu est l'élément essentiel : il indique le son actuellement attribué à l'événement, soit le mot <strong class='text-white'>Default</strong>, soit le nom d'un son que vous avez choisi auparavant.", image: {"src":`${IMG}/tradovate-notification-sounds-2.png`,"alt":"Liste Audio Notifications montrant les événements d'ordre avec interrupteurs et liens bleus du son actuel"} },
        { title: "Ouvrir la bibliothèque de sons", html: "Cliquez sur le lien bleu du son de l'événement que vous souhaitez modifier, par exemple <strong class='text-white'>Filled</strong>. Une liste des sons disponibles s'ouvre. C'est la bibliothèque livrée avec la fonction « choisir parmi une bibliothèque de sons » : vous disposez donc d'une palette de tonalités plutôt que d'un seul bip monotone.", image: {"src":`${IMG}/tradovate-notification-sounds-3.png`,"alt":"Bibliothèque de sons de notification Tradovate ouverte avec une liste de sons sélectionnables"} },
        { title: "Écouter et choisir un son", html: "Cliquez sur l'icône de lecture à côté d'un son pour l'entendre avant de vous décider. L'audio est lu directement par votre navigateur ; montez donc suffisamment le volume pour en juger. Lorsque vous en trouvez un qui vous plaît, sélectionnez-le. Le lien bleu affiche alors le nom du nouveau son, et il s'applique immédiatement à cet événement, sans étape d'enregistrement séparée.", image: {"src":`${IMG}/tradovate-notification-sounds-4.png`,"alt":"Écoute et sélection d'un son de notification avec l'icône de lecture dans Tradovate"} },
        { title: "Répéter pour chaque événement et couper ce dont vous n'avez pas besoin", html: "Faites de même pour les événements importants selon votre style. Une bonne règle : attribuez à <strong class='text-white'>Filled</strong>, <strong class='text-white'>Rejected</strong> et <strong class='text-white'>Canceled</strong> trois sons nettement différents afin de les distinguer sans quitter le prix des yeux. Et si le carillon constant « order filled » devient lassant pendant un scalping intensif, désactivez l'interrupteur de cette ligne pour le faire taire tout en gardant les rejets bien audibles." },
      ],
    },
    { type: "heading",text: "Quelques points utiles à savoir" },
    { type: "paragraph",html: "La bibliothèque est un ensemble fixe de sons intégrés. Il n'est pas possible de téléverser vos propres fichiers MP3 dans le trader ; choisissez donc la correspondance la plus proche parmi ceux proposés. Les notifications audio sont par ailleurs distinctes des alertes de prix, qui ont leurs propres paramètres sonores, et des notifications push mobiles. Si vous réinstallez l'application ou changez d'appareil, vérifiez à nouveau ces paramètres, car ils ne vous suivent pas toujours." },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Fatigué de surveiller chaque exécution et de déclencher chaque entrée manuellement ? <strong class='text-white'>PickMyTrade automatise votre stratégie TradingView directement dans Tradovate</strong>, de sorte que la plateforme exécute pour vous pendant que ces sons personnalisés se contentent de confirmer ce qui s'est déjà produit." },
  ], it: [
    { type: "paragraph",html: "Un'esecuzione che Le sfugge mentre fissa il grafico può costarLe un'uscita pulita. Tradovate permette di sostituire il bip predefinito con un suono a cui reagirà davvero, e di impostarne uno diverso per ogni evento dell'ordine, così un'esecuzione e un rifiuto non suonano mai uguali. Ecco come scegliere i suoni dalla libreria integrata e regolarli evento per evento." },
    { type: "paragraph",html: "Tutto si trova in un unico posto: <strong class='text-white'>Application Settings &rsaquo; Notifications &rsaquo; Audio Notifications</strong>. Quel pannello elenca ogni stato dell'ordine a cui può associare un suono, e ogni riga ha i propri controlli. Sceglie da un insieme di suoni integrati e non carica file propri; si tratta quindi di abbinare il tono predefinito giusto all'evento giusto." },
    { type: "heading",text: "A quali eventi può associare un suono" },
    { type: "paragraph",html: "Le notifiche audio scattano ai cambiamenti di stato dell'ordine, e ogni stato ha una propria riga che può personalizzare o silenziare:" },
