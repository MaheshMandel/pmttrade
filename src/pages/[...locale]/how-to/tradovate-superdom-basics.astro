---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-superdom-basics";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Place Orders on the Tradovate SuperDOM Ladder";
const META_DESCRIPTION =
  "Tradovate SuperDOM order entry made simple: left-click for limits, right-click for stops, and one-click market buttons to trade the ladder fast.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Orders auf der Tradovate SuperDOM-Leiter platzieren", es: "Coloque órdenes en la escalera SuperDOM de Tradovate", fr: "Passer des ordres sur l'échelle SuperDOM de Tradovate", it: "Inserire ordini sulla scala SuperDOM di Tradovate" },
  dek: { en: "Need to place, move, and cancel futures orders fast in Tradovate? This guide walks you through order entry on the SuperDOM ladder, one click at a time.", de: "Sie möchten Futures-Orders in Tradovate schnell platzieren, verschieben und stornieren? Diese Anleitung zeigt Ihnen die Ordereingabe auf der SuperDOM-Leiter, Klick für Klick.", es: "¿Necesita colocar, mover y cancelar órdenes de futuros rápidamente en Tradovate? Esta guía le explica la entrada de órdenes en la escalera SuperDOM, clic a clic.", fr: "Vous devez placer, déplacer et annuler rapidement des ordres sur contrats à terme dans Tradovate ? Ce guide vous explique la saisie d'ordres sur l'échelle SuperDOM, clic après clic.", it: "Ha bisogno di inserire, spostare e cancellare rapidamente ordini sui futures in Tradovate? Questa guida Le mostra l'inserimento degli ordini sulla scala SuperDOM, un clic alla volta." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Need to place, move, and cancel futures orders fast in Tradovate? Whether you're scalping ES and NQ, reacting to order flow, or wiring up automation with PickMyTrade, this guide walks you through order entry on the SuperDOM ladder, one click at a time." },
    { type: "heading", text: "What Is the Tradovate SuperDOM?" },
    { type: "paragraph", html: "The <strong class='text-white'>SuperDOM</strong> (Super Depth of Market) is Tradovate's price ladder: a vertical column of prices showing live Level II data, the bid size, ask size, and volume traded at each price, that doubles as a one-click order-entry window. You read order flow on it and drop orders at exact price levels without ever typing into an order ticket." },
    { type: "heading", text: "Placing Orders on the SuperDOM: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open the SuperDOM and Set Your Quantity", html: "Launch a SuperDOM from the <strong class='text-white'>New (+) menu</strong> in Tradovate Web and choose your instrument, say the front-month ES contract. Before you click a single price, set your order size in the <strong class='text-white'>quantity (Qty) field</strong> at the top of the module. Every order you fire from the ladder uses that quantity until you change it, so this is the one setting to double-check first." },
        { title: "Buy or Sell Instantly With the Market Buttons", html: "Want in at the current price? Click <strong class='text-white'>Buy Mkt</strong> or <strong class='text-white'>Sell Mkt</strong> at the top of the SuperDOM. These send a market order for your selected quantity and fill immediately at the best available price. Reach for them when speed matters more than a specific fill." },
        { title: "Left-Click a Price to Place a Limit Order", html: "By default, <strong class='text-white'>left-clicking</strong> a price level on the ladder rests a <strong class='text-white'>limit order</strong> for your set quantity. Left-click below the current price on the buy side for a Buy Limit, or above it on the sell side for a Sell Limit. Your order shows up next to that price with its working quantity and only fills if the market comes to your level." },
        { title: "Right-Click a Price to Place a Stop Order", html: "<strong class='text-white'>Right-click</strong> a price in the bid/ask column to drop a <strong class='text-white'>stop order</strong> at that level. In Tradovate Web the default stop type is a <strong class='text-white'>Stop Market</strong>, which fires a market order the moment price trades through your level. Want different behavior? Open the SuperDOM's <strong class='text-white'>Settings</strong> from the <strong class='text-white'>gear icon</strong> at the top-right to change the click behavior and the default stop type." },
        { title: "Modify or Cancel Orders on the Ladder", html: "To move a working order, <strong class='text-white'>click and drag it</strong> up or down to a new price; Tradovate modifies the resting order in place. To kill a single order, hover over it and click the <strong class='text-white'>X</strong> beside it. Need out of everything at once? The module has two exit buttons: one offsets your open position at market and cancels working orders, the other reverses your position and cancels orders in that instrument." },
      ],
    },
    { type: "heading", text: "Why You'd Need This" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Scalp fast markets</strong> like ES and NQ, where an order ticket is just too slow.",
        "<strong class='text-white'>Rest limit orders</strong> at exact support and resistance levels.",
        "<strong class='text-white'>Stage protective stops</strong> without ever leaving the ladder.",
        "<strong class='text-white'>Flatten or reverse instantly</strong> when a trade turns against you.",
        "<strong class='text-white'>Read live order flow</strong>, the bid/ask depth at each price, while you trade.",
      ],
    },
    { type: "heading", text: "Automate This With PickMyTrade" },
    { type: "paragraph", html: "Manual laddering is great for discretionary trading, but you don't have to babysit the DOM all day. PickMyTrade links your TradingView alerts straight to your Tradovate account, so entries, stops, and targets fire automatically, no manual clicks on the ladder." },
  ], de: [
    { type: "paragraph",html: "Sie möchten Futures-Orders in Tradovate schnell platzieren, verschieben und stornieren? Ob Sie ES und NQ scalpen, auf den Orderflow reagieren oder eine Automatisierung mit PickMyTrade einrichten: Diese Anleitung zeigt Ihnen die Ordereingabe auf der SuperDOM-Leiter, Klick für Klick." },
    { type: "heading",text: "Was ist die Tradovate SuperDOM?" },
    { type: "paragraph",html: "Die <strong class='text-white'>SuperDOM</strong> (Super Depth of Market) ist die Preisleiter von Tradovate: eine vertikale Preisspalte mit Live-Level-II-Daten, die Bid-Größe, Ask-Größe und das gehandelte Volumen auf jedem Preisniveau zeigt und zugleich als Ein-Klick-Orderfenster dient. Sie lesen darauf den Orderflow und setzen Orders auf exakten Preisniveaus, ohne jemals in ein Orderticket tippen zu müssen." },
    { type: "heading",text: "Orders auf der SuperDOM platzieren: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "SuperDOM öffnen und Ihre Menge festlegen", html: "Starten Sie eine SuperDOM über das <strong class='text-white'>New (+) menu</strong> in Tradovate Web und wählen Sie Ihr Instrument, etwa den Front-Month-ES-Kontrakt. Bevor Sie einen einzigen Preis anklicken, legen Sie Ihre Ordergröße im <strong class='text-white'>quantity (Qty) field</strong> am oberen Rand des Moduls fest. Jede Order, die Sie von der Leiter aus abfeuern, verwendet diese Menge, bis Sie sie ändern. Dies ist also die eine Einstellung, die Sie zuerst doppelt prüfen sollten." },
        { title: "Sofort kaufen oder verkaufen mit den Market-Schaltflächen", html: "Sie wollen zum aktuellen Preis einsteigen? Klicken Sie am oberen Rand der SuperDOM auf <strong class='text-white'>Buy Mkt</strong> oder <strong class='text-white'>Sell Mkt</strong>. Diese senden eine Market-Order für Ihre gewählte Menge und werden sofort zum besten verfügbaren Preis ausgeführt. Greifen Sie dazu, wenn Geschwindigkeit wichtiger ist als ein bestimmter Ausführungspreis." },
        { title: "Preis per Linksklick anklicken, um eine Limit-Order zu platzieren", html: "Standardmäßig legt ein <strong class='text-white'>Linksklick</strong> auf ein Preisniveau der Leiter eine <strong class='text-white'>Limit-Order</strong> für Ihre eingestellte Menge ab. Klicken Sie unterhalb des aktuellen Preises auf der Kaufseite für ein Buy Limit oder oberhalb davon auf der Verkaufsseite für ein Sell Limit. Ihre Order erscheint neben diesem Preis mit ihrer aktiven Menge und wird nur ausgeführt, wenn der Markt Ihr Niveau erreicht." },
        { title: "Preis per Rechtsklick anklicken, um eine Stop-Order zu platzieren", html: "<strong class='text-white'>Rechtsklicken</strong> Sie einen Preis in der Bid/Ask-Spalte, um auf diesem Niveau eine <strong class='text-white'>Stop-Order</strong> zu setzen. In Tradovate Web ist der Standard-Stopptyp <strong class='text-white'>Stop Market</strong>, der eine Market-Order auslöst, sobald der Kurs Ihr Niveau durchläuft. Sie möchten ein anderes Verhalten? Öffnen Sie die <strong class='text-white'>Settings</strong> der SuperDOM über das <strong class='text-white'>Zahnradsymbol</strong> oben rechts, um das Klickverhalten und den Standard-Stopptyp zu ändern." },
        { title: "Orders auf der Leiter ändern oder stornieren", html: "Um eine aktive Order zu verschieben, <strong class='text-white'>klicken und ziehen Sie sie</strong> nach oben oder unten auf einen neuen Preis; Tradovate ändert die ruhende Order an Ort und Stelle. Um eine einzelne Order zu löschen, fahren Sie mit der Maus darüber und klicken Sie auf das <strong class='text-white'>X</strong> daneben. Sie müssen aus allem gleichzeitig aussteigen? Das Modul hat zwei Exit-Schaltflächen: Die eine schließt Ihre offene Position zum Marktpreis und storniert aktive Orders, die andere kehrt Ihre Position um und storniert die Orders in diesem Instrument." },
      ],
    },
    { type: "heading",text: "Warum Sie das brauchen" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Schnelle Märkte scalpen</strong> wie ES und NQ, wo ein Orderticket schlicht zu langsam ist.",
        "<strong class='text-white'>Limit-Orders platzieren</strong> exakt auf Unterstützungs- und Widerstandsniveaus.",
        "<strong class='text-white'>Schutz-Stopps vorbereiten</strong>, ohne die Leiter je zu verlassen.",
        "<strong class='text-white'>Sofort glätten oder umkehren</strong>, wenn ein Trade gegen Sie läuft.",
        "<strong class='text-white'>Live-Orderflow lesen</strong>, also die Bid/Ask-Tiefe auf jedem Preis, während Sie handeln.",
      ],
    },
    { type: "heading",text: "Automatisieren Sie das mit PickMyTrade" },
    { type: "paragraph",html: "Das manuelle Handeln auf der Leiter ist ideal für diskretionären Handel, aber Sie müssen die DOM nicht den ganzen Tag beaufsichtigen. PickMyTrade verbindet Ihre TradingView-Alerts direkt mit Ihrem Tradovate-Konto, sodass Einstiege, Stopps und Ziele automatisch ausgelöst werden, ganz ohne manuelle Klicks auf der Leiter." },
  ], es: [
    { type: "paragraph",html: "¿Necesita colocar, mover y cancelar órdenes de futuros rápidamente en Tradovate? Ya sea que haga scalping en ES y NQ, reaccione al flujo de órdenes o configure una automatización con PickMyTrade, esta guía le explica la entrada de órdenes en la escalera SuperDOM, clic a clic." },
    { type: "heading",text: "¿Qué es la SuperDOM de Tradovate?" },
    { type: "paragraph",html: "La <strong class='text-white'>SuperDOM</strong> (Super Depth of Market) es la escalera de precios de Tradovate: una columna vertical de precios que muestra datos Level II en vivo, el tamaño del bid, el tamaño del ask y el volumen negociado en cada precio, y que además funciona como una ventana de entrada de órdenes con un clic. En ella usted lee el flujo de órdenes y coloca órdenes en niveles de precio exactos sin tener que escribir nunca en un ticket de orden." },
    { type: "heading",text: "Cómo colocar órdenes en la SuperDOM: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra la SuperDOM y establezca su cantidad", html: "Abra una SuperDOM desde el <strong class='text-white'>New (+) menu</strong> en Tradovate Web y elija su instrumento, por ejemplo el contrato ES del mes frontal. Antes de hacer clic en cualquier precio, establezca el tamaño de su orden en el <strong class='text-white'>quantity (Qty) field</strong> en la parte superior del módulo. Cada orden que lance desde la escalera usa esa cantidad hasta que la cambie, así que este es el primer ajuste que debe revisar dos veces." },
        { title: "Compre o venda al instante con los botones de mercado", html: "¿Quiere entrar al precio actual? Haga clic en <strong class='text-white'>Buy Mkt</strong> o <strong class='text-white'>Sell Mkt</strong> en la parte superior de la SuperDOM. Estos botones envían una orden de mercado por la cantidad seleccionada y se ejecutan de inmediato al mejor precio disponible. Recurra a ellos cuando la velocidad importe más que un precio de ejecución concreto." },
        { title: "Haga clic izquierdo en un precio para colocar una orden límite", html: "Por defecto, hacer <strong class='text-white'>clic izquierdo</strong> en un nivel de precio de la escalera deja en reposo una <strong class='text-white'>orden límite</strong> por la cantidad establecida. Haga clic izquierdo por debajo del precio actual en el lado de compra para un Buy Limit, o por encima en el lado de venta para un Sell Limit. Su orden aparece junto a ese precio con su cantidad activa y solo se ejecuta si el mercado llega a su nivel." },
        { title: "Haga clic derecho en un precio para colocar una orden stop", html: "Haga <strong class='text-white'>clic derecho</strong> en un precio de la columna bid/ask para colocar una <strong class='text-white'>orden stop</strong> en ese nivel. En Tradovate Web, el tipo de stop predeterminado es <strong class='text-white'>Stop Market</strong>, que dispara una orden de mercado en cuanto el precio atraviesa su nivel. ¿Quiere un comportamiento distinto? Abra los <strong class='text-white'>Settings</strong> de la SuperDOM desde el <strong class='text-white'>icono de engranaje</strong> en la esquina superior derecha para cambiar el comportamiento de clic y el tipo de stop predeterminado." },
        { title: "Modifique o cancele órdenes en la escalera", html: "Para mover una orden activa, <strong class='text-white'>haga clic y arrástrela</strong> hacia arriba o hacia abajo a un nuevo precio; Tradovate modifica la orden en reposo en el mismo lugar. Para eliminar una sola orden, pase el cursor sobre ella y haga clic en la <strong class='text-white'>X</strong> a su lado. ¿Necesita salir de todo a la vez? El módulo tiene dos botones de salida: uno compensa su posición abierta a mercado y cancela las órdenes activas, y el otro invierte su posición y cancela las órdenes de ese instrumento." },
      ],
    },
    { type: "heading",text: "Por qué lo necesitaría" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Haga scalping en mercados rápidos</strong> como ES y NQ, donde un ticket de orden resulta demasiado lento.",
        "<strong class='text-white'>Deje órdenes límite en reposo</strong> en niveles exactos de soporte y resistencia.",
        "<strong class='text-white'>Prepare stops de protección</strong> sin salir nunca de la escalera.",
        "<strong class='text-white'>Aplane o invierta al instante</strong> cuando una operación se vuelva en su contra.",
        "<strong class='text-white'>Lea el flujo de órdenes en vivo</strong>, es decir, la profundidad bid/ask en cada precio, mientras opera.",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Operar manualmente en la escalera es ideal para el trading discrecional, pero no tiene que vigilar la DOM todo el día. PickMyTrade conecta sus alertas de TradingView directamente con su cuenta de Tradovate, de modo que las entradas, los stops y los objetivos se disparan automáticamente, sin clics manuales en la escalera." },
  ], fr: [
    { type: "paragraph",html: "Vous devez placer, déplacer et annuler rapidement des ordres sur contrats à terme dans Tradovate ? Que vous fassiez du scalping sur ES et NQ, que vous réagissiez au flux d'ordres ou que vous mettiez en place une automatisation avec PickMyTrade, ce guide vous explique la saisie d'ordres sur l'échelle SuperDOM, clic après clic." },
    { type: "heading",text: "Qu'est-ce que la SuperDOM de Tradovate ?" },
    { type: "paragraph",html: "La <strong class='text-white'>SuperDOM</strong> (Super Depth of Market) est l'échelle de prix de Tradovate : une colonne verticale de prix qui affiche les données Level II en direct, la taille du bid, la taille de l'ask et le volume échangé à chaque prix, et qui sert aussi de fenêtre de saisie d'ordres en un clic. Vous y lisez le flux d'ordres et placez des ordres à des niveaux de prix exacts sans jamais avoir à saisir quoi que ce soit dans un ticket d'ordre." },
    { type: "heading",text: "Passer des ordres sur la SuperDOM : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez la SuperDOM et définissez votre quantité", html: "Lancez une SuperDOM depuis le <strong class='text-white'>New (+) menu</strong> de Tradovate Web et choisissez votre instrument, par exemple le contrat ES du mois en cours. Avant de cliquer sur un prix, définissez la taille de votre ordre dans le <strong class='text-white'>quantity (Qty) field</strong> en haut du module. Chaque ordre lancé depuis l'échelle utilise cette quantité jusqu'à ce que vous la changiez : c'est donc le premier réglage à vérifier deux fois." },
        { title: "Achetez ou vendez instantanément avec les boutons au marché", html: "Vous voulez entrer au prix actuel ? Cliquez sur <strong class='text-white'>Buy Mkt</strong> ou <strong class='text-white'>Sell Mkt</strong> en haut de la SuperDOM. Ils envoient un ordre au marché pour la quantité sélectionnée et sont exécutés immédiatement au meilleur prix disponible. Utilisez-les quand la rapidité compte plus qu'un prix d'exécution précis." },
        { title: "Faites un clic gauche sur un prix pour placer un ordre à cours limité", html: "Par défaut, un <strong class='text-white'>clic gauche</strong> sur un niveau de prix de l'échelle place un <strong class='text-white'>ordre à cours limité</strong> pour la quantité définie. Cliquez sous le prix actuel côté achat pour un Buy Limit, ou au-dessus côté vente pour un Sell Limit. Votre ordre apparaît à côté de ce prix avec sa quantité active et n'est exécuté que si le marché atteint votre niveau." },
        { title: "Faites un clic droit sur un prix pour placer un ordre stop", html: "Faites un <strong class='text-white'>clic droit</strong> sur un prix dans la colonne bid/ask pour placer un <strong class='text-white'>ordre stop</strong> à ce niveau. Dans Tradovate Web, le type de stop par défaut est <strong class='text-white'>Stop Market</strong>, qui déclenche un ordre au marché dès que le prix franchit votre niveau. Vous souhaitez un comportement différent ? Ouvrez les <strong class='text-white'>Settings</strong> de la SuperDOM via l'<strong class='text-white'>icône en forme d'engrenage</strong> en haut à droite pour modifier le comportement du clic et le type de stop par défaut." },
        { title: "Modifiez ou annulez des ordres sur l'échelle", html: "Pour déplacer un ordre actif, <strong class='text-white'>cliquez dessus et faites-le glisser</strong> vers le haut ou vers le bas jusqu'à un nouveau prix ; Tradovate modifie l'ordre en attente sur place. Pour supprimer un seul ordre, survolez-le et cliquez sur le <strong class='text-white'>X</strong> à côté. Besoin de tout quitter d'un coup ? Le module propose deux boutons de sortie : l'un compense votre position ouverte au marché et annule les ordres actifs, l'autre inverse votre position et annule les ordres sur cet instrument." },
      ],
    },
    { type: "heading",text: "Pourquoi vous en avez besoin" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Scalper les marchés rapides</strong> comme ES et NQ, où un ticket d'ordre est tout simplement trop lent.",
        "<strong class='text-white'>Placer des ordres à cours limité</strong> à des niveaux exacts de support et de résistance.",
        "<strong class='text-white'>Préparer des stops de protection</strong> sans jamais quitter l'échelle.",
        "<strong class='text-white'>Clôturer ou inverser instantanément</strong> quand un trade tourne en votre défaveur.",
        "<strong class='text-white'>Lire le flux d'ordres en direct</strong>, c'est-à-dire la profondeur bid/ask à chaque prix, pendant que vous tradez.",
      ],
    },
    { type: "heading",text: "Automatisez tout cela avec PickMyTrade" },
    { type: "paragraph",html: "Trader manuellement sur l'échelle est idéal pour le trading discrétionnaire, mais vous n'avez pas besoin de surveiller la DOM toute la journée. PickMyTrade relie vos alertes TradingView directement à votre compte Tradovate : entrées, stops et objectifs se déclenchent automatiquement, sans clic manuel sur l'échelle." },
  ], it: [
    { type: "paragraph",html: "Ha bisogno di inserire, spostare e cancellare rapidamente ordini sui futures in Tradovate? Che faccia scalping su ES e NQ, reagisca all'order flow o configuri un'automazione con PickMyTrade, questa guida Le mostra l'inserimento degli ordini sulla scala SuperDOM, un clic alla volta." },
    { type: "heading",text: "Che cos'è la SuperDOM di Tradovate?" },
    { type: "paragraph",html: "La <strong class='text-white'>SuperDOM</strong> (Super Depth of Market) è la scala dei prezzi di Tradovate: una colonna verticale di prezzi che mostra dati Level II in tempo reale, la dimensione del bid, la dimensione dell'ask e il volume scambiato a ogni prezzo, e che funge anche da finestra di inserimento ordini con un clic. Su di essa legge l'order flow e inserisce ordini a livelli di prezzo precisi senza dover mai digitare in un ticket d'ordine." },
    { type: "heading",text: "Inserire ordini sulla SuperDOM: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Apra la SuperDOM e imposti la quantità", html: "Avvii una SuperDOM dal <strong class='text-white'>New (+) menu</strong> in Tradovate Web e scelga il Suo strumento, ad esempio il contratto ES front-month. Prima di cliccare su un qualsiasi prezzo, imposti la dimensione dell'ordine nel <strong class='text-white'>quantity (Qty) field</strong> in alto nel modulo. Ogni ordine che invia dalla scala usa quella quantità finché non la cambia, quindi questa è l'impostazione da ricontrollare per prima." },
        { title: "Compri o venda subito con i pulsanti a mercato", html: "Vuole entrare al prezzo corrente? Clicchi su <strong class='text-white'>Buy Mkt</strong> o <strong class='text-white'>Sell Mkt</strong> in alto nella SuperDOM. Inviano un ordine a mercato per la quantità selezionata e vengono eseguiti immediatamente al miglior prezzo disponibile. Li utilizzi quando la velocità conta più di un prezzo di esecuzione specifico." },
        { title: "Clic sinistro su un prezzo per inserire un ordine limite", html: "Per impostazione predefinita, il <strong class='text-white'>clic sinistro</strong> su un livello di prezzo della scala lascia in attesa un <strong class='text-white'>ordine limite</strong> per la quantità impostata. Clicchi sotto il prezzo corrente sul lato acquisto per un Buy Limit, oppure sopra sul lato vendita per un Sell Limit. Il Suo ordine compare accanto a quel prezzo con la quantità attiva e viene eseguito solo se il mercato raggiunge il Suo livello." },
        { title: "Clic destro su un prezzo per inserire un ordine stop", html: "Faccia <strong class='text-white'>clic destro</strong> su un prezzo nella colonna bid/ask per inserire un <strong class='text-white'>ordine stop</strong> a quel livello. In Tradovate Web il tipo di stop predefinito è <strong class='text-white'>Stop Market</strong>, che invia un ordine a mercato non appena il prezzo attraversa il Suo livello. Desidera un comportamento diverso? Apra le <strong class='text-white'>Settings</strong> della SuperDOM dall'<strong class='text-white'>icona a forma di ingranaggio</strong> in alto a destra per modificare il comportamento dei clic e il tipo di stop predefinito." },
        { title: "Modifichi o cancelli gli ordini sulla scala", html: "Per spostare un ordine attivo, <strong class='text-white'>clicchi e lo trascini</strong> verso l'alto o verso il basso su un nuovo prezzo; Tradovate modifica l'ordine in attesa sul posto. Per eliminare un singolo ordine, ci passi sopra con il mouse e clicchi sulla <strong class='text-white'>X</strong> accanto. Deve uscire da tutto in una volta? Il modulo ha due pulsanti di uscita: uno compensa la Sua posizione aperta a mercato e cancella gli ordini attivi, l'altro inverte la Sua posizione e cancella gli ordini su quello strumento." },
      ],
    },
    { type: "heading",text: "Perché Le serve" },
    {
