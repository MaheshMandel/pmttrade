---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-prop-accounts";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Connect & Manage Prop-Firm Accounts in Tradovate";
const META_DESCRIPTION =
  "Log into and manage a prop-firm evaluation account on Tradovate: pick the right account, sign the agreements, and see which risk limits your firm controls.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Prop-Firm-Konten in Tradovate verbinden und verwalten", es: "Conectar y gestionar cuentas de prop firm en Tradovate", fr: "Connecter et gérer des comptes de prop firm dans Tradovate", it: "Collegare e gestire i conti di prop firm in Tradovate" },
  dek: { en: "A prop-firm account doesn't work quite like a personal Tradovate account. Here's how to get into your evaluation or funded account and manage it without tripping over the parts the firm locks down.", de: "Ein Prop-Firm-Konto funktioniert nicht ganz wie ein privates Tradovate-Konto. So gelangen Sie in Ihr Evaluierungs- oder finanziertes Konto und verwalten es, ohne über die Bereiche zu stolpern, die die Firma sperrt.", es: "Una cuenta de prop firm no funciona exactamente como una cuenta personal de Tradovate. Así se accede a su cuenta de evaluación o fondeada y se gestiona sin tropezar con las partes que la firma bloquea.", fr: "Un compte de prop firm ne fonctionne pas tout à fait comme un compte Tradovate personnel. Voici comment accéder à votre compte d'évaluation ou financé et le gérer sans vous heurter aux éléments que la société verrouille.", it: "Un conto di prop firm non funziona esattamente come un conto Tradovate personale. Ecco come accedere al suo conto di valutazione o finanziato e gestirlo senza inciampare nelle parti che la società blocca." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "A prop-firm account doesn't work quite like a personal Tradovate account. You didn't open this one, your funding firm did, and that changes where you log in, what you're allowed to adjust, and who you call when something breaks. Here's how to get into your evaluation or funded account and manage it without tripping over the parts the firm locks down." },
    { type: "quote", html: "The account lives on Tradovate's platform, but your prop firm owns it. Log in with the credentials the firm gave you, not a Tradovate account you created on your own. If you're brand new to the platform, it helps to first read how to log in to Tradovate." },
    { type: "heading", text: "Connect a Prop-Firm Account in Tradovate: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Get Your Login From the Prop Firm", html: "Your username and password come from the firm, Apex, Topstep, Take Profit Trader, MyFundedFutures, whoever you bought the evaluation from. They usually land in your email or sit in your firm dashboard shortly after payment. Provisioning time varies by firm and market conditions; some accounts appear in minutes, others take a few hours. If nothing shows up, chase the firm, not Tradovate. One small thing that catches people out: strip any stray spaces off the front or back of the username and password when you copy them across." },
        { title: "Open Tradovate Web and Sign In on the Simulated Side", html: "Head to trader.tradovate.com in a desktop browser and click Login. Evaluation and funded prop accounts run as simulated accounts, so you sign in on the Demo / Simulation side rather than Live. Skip the desktop download app for this first sign-in, the web platform is the most reliable place to get everything set up." },
        { title: "Sign the Agreements and Launch the Account", html: "The first time in, Tradovate asks you to accept a few agreements, market-data terms and the Non-Professional agreement among them, before anything will route. Sign them. Your prop account then shows up under the Simulation section; click Launch (or Continue) to open it. The commission schedule you see is set by the firm, not your retail Tradovate plan, so don't be surprised if the numbers differ from a personal account." },
        { title: "Select the Right Account", html: "If you bought more than one evaluation, or you also trade a personal Tradovate account, they all live in the same interface. The account selector, usually a dropdown near the top of the platform, decides where your orders actually go. Check the account name in the banner before you place a single order. Firing a trade into the wrong evaluation is an easy and genuinely painful mistake." },
        { title: "Confirm Data and Connect Any Add-Ons", html: "Real-time data on a prop account is enabled by the firm, not by you. If quotes look delayed or a symbol won't trade, that's usually a data-entitlement issue on the firm's side rather than something you can fix in your own settings. Planning to trade through TradingView? Enable that add-on first, it lives under Application Settings, in the add-ons area, otherwise you'll hit an entitlement error the moment you try to route an order." },
      ],
    },
    { type: "heading", text: "What You Can and Can't Change on a Prop Account" },
    { type: "paragraph", html: "This is where prop accounts surprise people. Tradovate's own Risk Settings only work on live and demo Tradovate <em>brokerage</em> accounts, they don't apply to evaluation accounts. On an evaluation, the firm's risk engine is the one that counts, and it's enforced in real time." },
    {
      type: "table",
      headers: ["Setting", "Who controls it on a prop / eval account"],
      rows: [
        ["Trailing drawdown / max loss", "Your prop firm, enforced live; you can't loosen it"],
        ["Daily loss limit / profit target", "Firm rules apply; Tradovate's built-in Risk Settings don't apply to eval accounts"],
        ["Max position / contract limit", "Set by the firm's plan and account size"],
        ["Market data subscription", "Enabled by the firm"],
        ["Commission schedule", "Set by the firm"],
        ["Charts, hotkeys, add-ons, layout", "You, these are yours to configure"],
      ],
    },
    { type: "paragraph", html: "The exact drawdown, loss limit, and contract numbers vary by firm and account size, so check your firm's current rules rather than assuming. If you want to understand how the platform's risk controls behave in general, see configure account risk settings in Tradovate." },
    { type: "heading", text: "When Something Breaks, Know Who to Call" },
    { type: "paragraph", html: "Tradovate's support team can help you set up the connection. Past that, anything about the account itself, resets, a disabled or inactive account, market-data problems, funding, payouts, goes to your prop firm. Tradovate doesn't own the account and can't reinstate it, refund it, or change its limits. If your evaluation isn't showing up at all after you paid, give it time to provision, log out and back in, then open a ticket with the firm." },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Running the same setup across several prop evaluations? <strong class='text-white'>Routing your TradingView alerts into each account</strong> keeps every entry identical instead of racing between tabs to fill them by hand." },
  ], de: [
    { type: "paragraph",html: "Ein Prop-Firm-Konto funktioniert nicht ganz wie ein privates Tradovate-Konto. Sie haben es nicht eröffnet, Ihre Finanzierungsfirma hat es getan, und das ändert, wo Sie sich anmelden, was Sie anpassen dürfen und wen Sie anrufen, wenn etwas schiefgeht. So gelangen Sie in Ihr Evaluierungs- oder finanziertes Konto und verwalten es, ohne über die Bereiche zu stolpern, die die Firma sperrt." },
    { type: "quote",html: "Das Konto liegt auf der Plattform von Tradovate, gehört aber Ihrer Prop Firm. Melden Sie sich mit den Zugangsdaten an, die Ihnen die Firma gegeben hat, nicht mit einem Tradovate-Konto, das Sie selbst erstellt haben. Wenn Sie neu auf der Plattform sind, hilft es, zuerst zu lesen, wie Sie sich bei Tradovate anmelden." },
    { type: "heading",text: "Ein Prop-Firm-Konto in Tradovate verbinden: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Zugangsdaten von der Prop Firm erhalten", html: "Ihr Benutzername und Ihr Passwort stammen von der Firma, etwa Apex, Topstep, Take Profit Trader, MyFundedFutures oder wo auch immer Sie die Evaluierung gekauft haben. Sie landen in der Regel kurz nach der Zahlung in Ihrem E-Mail-Postfach oder stehen in Ihrem Dashboard bei der Firma. Die Bereitstellungszeit variiert je nach Firma und Marktlage; manche Konten erscheinen in Minuten, andere brauchen einige Stunden. Wenn nichts ankommt, fragen Sie bei der Firma nach, nicht bei Tradovate. Eine Kleinigkeit, die viele ins Stolpern bringt: Entfernen Sie beim Kopieren überflüssige Leerzeichen am Anfang oder Ende von Benutzername und Passwort." },
        { title: "Tradovate Web öffnen und auf der Simulationsseite anmelden", html: "Rufen Sie trader.tradovate.com in einem Desktop-Browser auf und klicken Sie auf Login. Evaluierungs- und finanzierte Prop-Konten laufen als simulierte Konten, daher melden Sie sich auf der Seite Demo / Simulation und nicht auf Live an. Verzichten Sie bei dieser ersten Anmeldung auf die Desktop-Download-App; die Web-Plattform ist der zuverlässigste Ort, um alles einzurichten." },
        { title: "Vereinbarungen unterzeichnen und das Konto starten", html: "Beim ersten Zugriff bittet Tradovate Sie, einige Vereinbarungen zu akzeptieren, darunter die Marktdaten-Bedingungen und die Non-Professional-Vereinbarung, bevor Orders geroutet werden. Unterzeichnen Sie sie. Ihr Prop-Konto erscheint dann im Bereich Simulation; klicken Sie auf Launch (oder Continue), um es zu öffnen. Der angezeigte Provisionsplan wird von der Firma festgelegt, nicht von Ihrem Tradovate-Privatplan. Wundern Sie sich also nicht, wenn die Zahlen von einem privaten Konto abweichen." },
        { title: "Das richtige Konto auswählen", html: "Wenn Sie mehr als eine Evaluierung gekauft haben oder zusätzlich ein privates Tradovate-Konto handeln, befinden sich alle in derselben Oberfläche. Das Kontoauswahlmenü, in der Regel ein Dropdown oben in der Plattform, entscheidet, wohin Ihre Orders tatsächlich gehen. Prüfen Sie den Kontonamen im Banner, bevor Sie auch nur eine Order platzieren. Einen Trade in die falsche Evaluierung abzusetzen ist ein leicht passierender und wirklich schmerzhafter Fehler." },
        { title: "Daten bestätigen und Add-ons verbinden", html: "Echtzeitdaten auf einem Prop-Konto werden von der Firma freigeschaltet, nicht von Ihnen. Wenn Kurse verzögert wirken oder ein Symbol sich nicht handeln lässt, liegt meist ein Problem mit der Datenberechtigung auf Seiten der Firma vor, das Sie nicht in Ihren eigenen Einstellungen beheben können. Möchten Sie über TradingView handeln? Aktivieren Sie zuerst dieses Add-on, es befindet sich unter Application Settings im Bereich Add-ons. Andernfalls erhalten Sie einen Berechtigungsfehler, sobald Sie versuchen, eine Order zu routen." },
      ],
    },
    { type: "heading",text: "Was Sie bei einem Prop-Konto ändern können und was nicht" },
    { type: "paragraph",html: "Hier überraschen Prop-Konten viele. Tradovates eigene Risk Settings funktionieren nur bei Live- und Demo-<em>Brokerage</em>-Konten von Tradovate, nicht bei Evaluierungskonten. Bei einer Evaluierung zählt die Risiko-Engine der Firma, und sie wird in Echtzeit durchgesetzt." },
    { type: "table", headers: ["Einstellung","Wer sie bei einem Prop- / Evaluierungskonto kontrolliert"], rows: [
      ["Trailing Drawdown / maximaler Verlust","Ihre Prop Firm, live durchgesetzt; Sie können sie nicht lockern"],
      ["Tägliches Verlustlimit / Gewinnziel","Es gelten die Regeln der Firma; Tradovates integrierte Risk Settings gelten nicht für Evaluierungskonten"],
      ["Maximale Position / Kontraktlimit","Wird durch den Plan und die Kontogröße der Firma festgelegt"],
      ["Marktdaten-Abonnement","Von der Firma freigeschaltet"],
      ["Provisionsplan","Von der Firma festgelegt"],
      ["Charts, Hotkeys, Add-ons, Layout","Sie, diese konfigurieren Sie selbst"],
    ] },
    { type: "paragraph",html: "Die genauen Zahlen für Drawdown, Verlustlimit und Kontrakte variieren je nach Firma und Kontogröße. Prüfen Sie daher die aktuellen Regeln Ihrer Firma, statt Annahmen zu treffen. Wenn Sie verstehen möchten, wie sich die Risikokontrollen der Plattform allgemein verhalten, lesen Sie, wie Sie die Konto-Risikoeinstellungen in Tradovate konfigurieren." },
    { type: "heading",text: "Wenn etwas schiefgeht: Wissen, wen Sie anrufen" },
    { type: "paragraph",html: "Der Support von Tradovate kann Ihnen bei der Einrichtung der Verbindung helfen. Alles darüber hinaus, was das Konto selbst betrifft, also Resets, ein deaktiviertes oder inaktives Konto, Marktdatenprobleme, Finanzierung und Auszahlungen, gehört zu Ihrer Prop Firm. Tradovate besitzt das Konto nicht und kann es weder wiederherstellen noch erstatten noch seine Limits ändern. Wenn Ihre Evaluierung nach der Zahlung gar nicht erscheint, geben Sie ihr Zeit zur Bereitstellung, melden Sie sich ab und wieder an und eröffnen Sie dann ein Ticket bei der Firma." },
    { type: "heading",text: "Mit PickMyTrade automatisieren" },
    { type: "paragraph",html: "Sie fahren dasselbe Setup über mehrere Prop-Evaluierungen? <strong class='text-white'>Wenn Sie Ihre TradingView-Alerts in jedes Konto routen</strong>, bleibt jeder Einstieg identisch, statt dass Sie zwischen Tabs hin und her hetzen, um sie von Hand auszuführen." },
  ], es: [
    { type: "paragraph",html: "Una cuenta de prop firm no funciona exactamente como una cuenta personal de Tradovate. Usted no la abrió; lo hizo su empresa de fondeo, y eso cambia dónde inicia sesión, qué puede ajustar y a quién llamar cuando algo falla. Así se accede a su cuenta de evaluación o fondeada y se gestiona sin tropezar con las partes que la firma bloquea." },
    { type: "quote",html: "La cuenta reside en la plataforma de Tradovate, pero su prop firm es la propietaria. Inicie sesión con las credenciales que le dio la firma, no con una cuenta de Tradovate que haya creado por su cuenta. Si es nuevo en la plataforma, conviene leer primero cómo iniciar sesión en Tradovate." },
    { type: "heading",text: "Conectar una cuenta de prop firm en Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Obtenga sus credenciales de la prop firm", html: "Su nombre de usuario y su contraseña proceden de la firma: Apex, Topstep, Take Profit Trader, MyFundedFutures o quien le haya vendido la evaluación. Suelen llegar a su correo o aparecer en el panel de la firma poco después del pago. El tiempo de aprovisionamiento varía según la firma y las condiciones del mercado; algunas cuentas aparecen en minutos y otras tardan unas horas. Si no llega nada, reclame a la firma, no a Tradovate. Un detalle que suele pasar desapercibido: elimine los espacios sobrantes al principio o al final del nombre de usuario y de la contraseña cuando los copie." },
        { title: "Abra Tradovate Web e inicie sesión en el lado simulado", html: "Vaya a trader.tradovate.com en un navegador de escritorio y haga clic en Login. Las cuentas prop de evaluación y fondeadas funcionan como cuentas simuladas, así que inicia sesión en el lado Demo / Simulation y no en Live. Omita la aplicación de escritorio para este primer inicio de sesión; la plataforma web es el lugar más fiable para configurarlo todo." },
        { title: "Firme los acuerdos y lance la cuenta", html: "La primera vez, Tradovate le pide aceptar varios acuerdos, entre ellos las condiciones de datos de mercado y el acuerdo Non-Professional, antes de enrutar nada. Fírmelos. Su cuenta prop aparecerá en la sección Simulation; haga clic en Launch (o Continue) para abrirla. El plan de comisiones que ve lo fija la firma, no su plan minorista de Tradovate, así que no se sorprenda si las cifras difieren de las de una cuenta personal." },
        { title: "Seleccione la cuenta correcta", html: "Si compró más de una evaluación, o también opera una cuenta personal de Tradovate, todas conviven en la misma interfaz. El selector de cuentas, normalmente un desplegable cerca de la parte superior de la plataforma, decide adónde van realmente sus órdenes. Compruebe el nombre de la cuenta en el banner antes de colocar una sola orden. Lanzar una operación en la evaluación equivocada es un error fácil y muy doloroso." },
        { title: "Confirme los datos y conecte los complementos", html: "Los datos en tiempo real de una cuenta prop los activa la firma, no usted. Si las cotizaciones parecen retrasadas o un símbolo no se deja operar, suele tratarse de un problema de autorización de datos por parte de la firma, y no de algo que pueda arreglar en sus propios ajustes. ¿Piensa operar a través de TradingView? Active primero ese complemento: está en Application Settings, en el área de Add-ons; de lo contrario, obtendrá un error de autorización en cuanto intente enrutar una orden." },
      ],
    },
    { type: "heading",text: "Qué puede y qué no puede cambiar en una cuenta prop" },
    { type: "paragraph",html: "Aquí es donde las cuentas prop sorprenden a la gente. Los Risk Settings propios de Tradovate solo funcionan en cuentas de <em>brokerage</em> reales y demo de Tradovate; no se aplican a las cuentas de evaluación. En una evaluación cuenta el motor de riesgo de la firma, que se aplica en tiempo real." },
    { type: "table", headers: ["Ajuste","Quién lo controla en una cuenta prop / de evaluación"], rows: [
      ["Drawdown dinámico (trailing) / pérdida máxima","Su prop firm, aplicado en vivo; usted no puede flexibilizarlo"],
      ["Límite de pérdida diaria / objetivo de beneficio","Se aplican las reglas de la firma; los Risk Settings integrados de Tradovate no se aplican a las cuentas de evaluación"],
      ["Posición máxima / límite de contratos","Lo fija el plan y el tamaño de cuenta de la firma"],
      ["Suscripción de datos de mercado","La activa la firma"],
      ["Plan de comisiones","Lo fija la firma"],
      ["Gráficos, atajos, complementos, diseño","Usted: son suyos para configurar"],
    ] },
    { type: "paragraph",html: "Las cifras exactas de drawdown, límite de pérdida y contratos varían según la firma y el tamaño de la cuenta, así que consulte las reglas vigentes de su firma en lugar de suponerlas. Si quiere entender cómo se comportan en general los controles de riesgo de la plataforma, consulte cómo configurar los ajustes de riesgo de la cuenta en Tradovate." },
    { type: "heading",text: "Cuando algo falla, sepa a quién llamar" },
    { type: "paragraph",html: "El equipo de soporte de Tradovate puede ayudarle a configurar la conexión. Más allá de eso, todo lo relativo a la cuenta en sí, restablecimientos, una cuenta desactivada o inactiva, problemas de datos de mercado, fondeo, pagos, corresponde a su prop firm. Tradovate no es el propietario de la cuenta y no puede reactivarla, reembolsarla ni cambiar sus límites. Si su evaluación no aparece tras pagar, dele tiempo para aprovisionarse, cierre sesión y vuelva a entrar, y luego abra un ticket con la firma." },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "¿Ejecuta la misma configuración en varias evaluaciones prop? <strong class='text-white'>Enrutar sus alertas de TradingView a cada cuenta</strong> mantiene cada entrada idéntica, en lugar de correr entre pestañas para ejecutarlas a mano." },
  ], fr: [
    { type: "paragraph",html: "Un compte de prop firm ne fonctionne pas tout à fait comme un compte Tradovate personnel. Ce n'est pas vous qui l'avez ouvert, mais votre société de financement, ce qui change l'endroit où vous vous connectez, ce que vous pouvez ajuster et qui appeler en cas de problème. Voici comment accéder à votre compte d'évaluation ou financé et le gérer sans vous heurter aux éléments que la société verrouille." },
    { type: "quote",html: "Le compte se trouve sur la plateforme de Tradovate, mais c'est votre prop firm qui en est propriétaire. Connectez-vous avec les identifiants que la société vous a fournis, et non avec un compte Tradovate que vous auriez créé vous-même. Si vous découvrez la plateforme, il est utile de lire d'abord comment se connecter à Tradovate." },
    { type: "heading",text: "Connecter un compte de prop firm dans Tradovate : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Obtenez vos identifiants auprès de la prop firm", html: "Votre nom d'utilisateur et votre mot de passe viennent de la société, Apex, Topstep, Take Profit Trader, MyFundedFutures, ou celle qui vous a vendu l'évaluation. Ils arrivent généralement dans votre boîte e-mail ou apparaissent dans le tableau de bord de la société peu après le paiement. Le délai de mise à disposition varie selon la société et les conditions de marché ; certains comptes apparaissent en quelques minutes, d'autres en quelques heures. Si rien n'arrive, relancez la société, pas Tradovate. Un petit détail qui piège souvent : supprimez les espaces superflus au début ou à la fin du nom d'utilisateur et du mot de passe lorsque vous les copiez." },
        { title: "Ouvrez Tradovate Web et connectez-vous du côté simulé", html: "Rendez-vous sur trader.tradovate.com dans un navigateur de bureau et cliquez sur Login. Les comptes prop d'évaluation et financés fonctionnent comme des comptes simulés ; vous vous connectez donc du côté Demo / Simulation et non Live. Évitez l'application de bureau à télécharger pour cette première connexion : la plateforme web est l'endroit le plus fiable pour tout configurer." },
        { title: "Signez les accords et lancez le compte", html: "À la première connexion, Tradovate vous demande d'accepter plusieurs accords, dont les conditions relatives aux données de marché et l'accord Non-Professional, avant que quoi que ce soit ne soit acheminé. Signez-les. Votre compte prop apparaît alors dans la section Simulation ; cliquez sur Launch (ou Continue) pour l'ouvrir. La grille de commissions affichée est fixée par la société, et non par votre formule Tradovate de particulier ; ne soyez donc pas surpris si les chiffres diffèrent de ceux d'un compte personnel." },
        { title: "Sélectionnez le bon compte", html: "Si vous avez acheté plusieurs évaluations, ou si vous tradez aussi un compte Tradovate personnel, tous se trouvent dans la même interface. Le sélecteur de compte, généralement une liste déroulante en haut de la plateforme, détermine où vos ordres sont réellement envoyés. Vérifiez le nom du compte dans la bannière avant de passer le moindre ordre. Envoyer un trade sur la mauvaise évaluation est une erreur facile à commettre et vraiment douloureuse." },
        { title: "Confirmez les données et connectez les modules complémentaires", html: "Les données en temps réel d'un compte prop sont activées par la société, pas par vous. Si les cotations semblent différées ou si un symbole ne se négocie pas, il s'agit généralement d'un problème d'autorisation de données côté société, et non de quelque chose que vous pouvez corriger dans vos propres paramètres. Vous comptez trader via TradingView ? Activez d'abord ce module : il se trouve dans Application Settings, dans la zone Add-ons ; sinon, vous obtiendrez une erreur d'autorisation dès que vous tenterez d'acheminer un ordre." },
      ],
    },
    { type: "heading",text: "Ce que vous pouvez et ne pouvez pas modifier sur un compte prop" },
    { type: "paragraph",html: "C'est là que les comptes prop surprennent. Les Risk Settings de Tradovate ne fonctionnent que sur les comptes de <em>courtage</em> Tradovate réels et démo ; ils ne s'appliquent pas aux comptes d'évaluation. Sur une évaluation, c'est le moteur de risque de la société qui compte, et il est appliqué en temps réel." },
    { type: "table", headers: ["Paramètre","Qui le contrôle sur un compte prop / d'évaluation"], rows: [
      ["Drawdown dynamique (trailing) / perte maximale","Votre prop firm, appliqué en direct ; vous ne pouvez pas l'assouplir"],
      ["Limite de perte quotidienne / objectif de profit","Les règles de la société s'appliquent ; les Risk Settings intégrés de Tradovate ne s'appliquent pas aux comptes d'évaluation"],
      ["Position maximale / limite de contrats","Fixée par la formule et la taille de compte de la société"],
      ["Abonnement aux données de marché","Activé par la société"],
      ["Grille de commissions","Fixée par la société"],
      ["Graphiques, raccourcis, modules complémentaires, disposition","Vous : c'est à vous de les configurer"],
    ] },
    { type: "paragraph",html: "Les chiffres exacts de drawdown, de limite de perte et de contrats varient selon la société et la taille du compte ; vérifiez donc les règles actuelles de votre société au lieu de les supposer. Si vous souhaitez comprendre comment les contrôles de risque de la plateforme se comportent en général, consultez comment configurer les paramètres de risque du compte dans Tradovate." },
    { type: "heading",text: "En cas de problème, sachez qui contacter" },
    { type: "paragraph",html: "L'équipe d'assistance de Tradovate peut vous aider à configurer la connexion. Au-delà, tout ce qui concerne le compte lui-même, réinitialisations, compte désactivé ou inactif, problèmes de données de marché, financement, paiements, relève de votre prop firm. Tradovate n'est pas propriétaire du compte et ne peut ni le rétablir, ni le rembourser, ni modifier ses limites. Si votre évaluation n'apparaît pas du tout après paiement, laissez-lui le temps d'être provisionnée, déconnectez-vous puis reconnectez-vous, puis ouvrez un ticket auprès de la société." },
    { type: "heading",text: "Automatisez avec PickMyTrade" },
