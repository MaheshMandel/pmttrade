---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-change-password";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Change Your Tradovate Password In-App";
const META_DESCRIPTION =
  "Change your Tradovate password in under a minute from the Your Profile tab, or reset it by email if you're locked out of your account.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Ändern Sie Ihr Tradovate-Passwort direkt in der App", es: "Cambie su contraseña de Tradovate desde la aplicación", fr: "Modifiez votre mot de passe Tradovate directement dans l’application", it: "Cambi la Sua password Tradovate direttamente nell’app" },
  dek: { en: "Your Tradovate password guards your order routing, your funded accounts, and ultimately your money. Here's exactly how to change it yourself in under a minute, no support ticket needed.", de: "Ihr Tradovate-Passwort schützt Ihre Orderweiterleitung, Ihre finanzierten Konten und letztlich Ihr Geld. So ändern Sie es selbst in unter einer Minute, ganz ohne Support-Ticket.", es: "Su contraseña de Tradovate protege el enrutamiento de sus órdenes, sus cuentas fondeadas y, en última instancia, su dinero. Así puede cambiarla usted mismo en menos de un minuto, sin necesidad de abrir un ticket de soporte.", fr: "Votre mot de passe Tradovate protège l’acheminement de vos ordres, vos comptes financés et, au bout du compte, votre argent. Voici comment le modifier vous-même en moins d’une minute, sans ticket de support.", it: "La Sua password Tradovate protegge l’instradamento dei Suoi ordini, i Suoi conti finanziati e, in ultima analisi, il Suo denaro. Ecco come cambiarla in autonomia in meno di un minuto, senza aprire alcun ticket di supporto." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Your Tradovate password guards your order routing, your funded accounts, and ultimately your money. If you reused it somewhere risky, shared it with a service you no longer trust, or you just rotate credentials on a schedule, you can swap it yourself in under a minute. No support ticket needed. The whole thing lives inside your profile settings, and here's the exact path." },
    { type: "quote", html: "You'll need your <strong class='text-white'>current password</strong> to change it from inside the platform. If you've already forgotten it and can't log in at all, skip to the email reset method further down. Trading a prop firm evaluation? Read the note near the end first, because those logins follow their own rules." },
    { type: "heading", text: "Change Your Password Step by Step" },
    {
      type: "steps",
      items: [
        { title: "Open Application Settings", html: "Log in to the Tradovate Web App as usual. Look to the top-right corner of the screen and click the <strong class='text-white'>Application Settings</strong> icon. That's the same menu where your account preferences, risk settings, and profile details all live." },
        { title: "Open the Your Profile Tab", html: "The Settings menu opens with a list of sections down the left side. Select the <strong class='text-white'>Your Profile</strong> tab. This is where your account-level details sit, separate from the trading and display preferences." },
        { title: "Click Change Password", html: "Inside Your Profile, scroll down to the <strong class='text-white'>User Profile</strong> heading. You'll see a <strong class='text-white'>Change Password</strong> button there. Click it and a small pop-up window opens for the actual change." },
        { title: "Enter and Confirm Your New Password", html: "The pop-up asks for three things: your <strong class='text-white'>current password</strong>, your <strong class='text-white'>new password</strong>, and a <strong class='text-white'>confirmation</strong> of the new one. Type them in, then save to apply. Tradovate enforces its own minimum length and complexity, and the form will flag a weak entry before it lets you finish, so pick something long and unique that you don't use anywhere else. Once it saves, that new password is live everywhere you sign in, including the desktop app, mobile, and any TradingView connection." },
      ],
    },
    { type: "heading", text: "Forgot Your Password? Reset It by Email" },
    { type: "paragraph", html: "If you can't log in, you can't use the in-app method, because it needs your current password. Reset by email instead. On the login screen, click <strong class='text-white'>Need Help?</strong>, then choose <strong class='text-white'>Reset Password</strong>. Enter the username or email tied to your account and Tradovate sends reset instructions to the email it has on file. Keep these in mind:" },
    {
      type: "list",
      items: [
        "Tradovate will never ask you for your password directly, so ignore anyone who does.",
        "If the email doesn't land in a couple of minutes, check your spam and junk folders.",
        "Reset links expire. If you requested more than one, use the newest email.",
      ],
    },
    { type: "heading", text: "On a Prop Firm or Evaluation Account?" },
    { type: "paragraph", html: "Evaluation and funded logins are managed by the firm, not by Tradovate directly. The self-service reset usually won't work on them, and the password and access rules vary by firm and account size, so check your firm's current rules. If you need to change or reset the password on an Apex, Topstep, or similar evaluation login, contact that provider's support rather than Tradovate." },
    { type: "heading", text: "Quick Troubleshooting" },
    {
      type: "table",
      headers: ["Problem", "What to Try"],
      rows: [
        ["New password gets rejected", "Make it longer, mix in numbers or symbols, and make sure it's different from the old one."],
        ["\"Current password is incorrect\"", "You may be entering a prop firm's password on the wrong login. Confirm the account, or reset by email."],
        ["Locked out after several attempts", "Stop retrying and wait out the temporary lock before trying again."],
        ["Can't find the option on mobile", "Make the change in the Web App, then sign back in on mobile with the new password."],
      ],
    },
    { type: "paragraph", html: "One more habit worth building: right after a password change, sign in fresh on any new device so you clear device-approval prompts early. If two-factor is on, you'll get a confirmation step, so a routing hiccup doesn't catch you off guard mid-session." },
  ], de: [
    { type: "paragraph",html: "Ihr Tradovate-Passwort schützt Ihre Orderweiterleitung, Ihre finanzierten Konten und letztlich Ihr Geld. Haben Sie es an riskanter Stelle wiederverwendet, es mit einem Dienst geteilt, dem Sie nicht mehr vertrauen, oder wechseln Sie Ihre Zugangsdaten einfach regelmäßig, können Sie es in unter einer Minute selbst austauschen. Kein Support-Ticket nötig. Alles befindet sich in Ihren Profileinstellungen, und hier ist der genaue Weg." },
    { type: "quote",html: "Sie benötigen Ihr <strong class='text-white'>aktuelles Passwort</strong>, um es innerhalb der Plattform zu ändern. Falls Sie es bereits vergessen haben und sich gar nicht mehr anmelden können, springen Sie weiter unten direkt zur Zurücksetzung per E-Mail. Handeln Sie in einer Prop-Firm-Evaluation? Lesen Sie zuerst den Hinweis gegen Ende, denn diese Logins folgen eigenen Regeln." },
    { type: "heading",text: "Ändern Sie Ihr Passwort Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Application Settings öffnen", html: "Melden Sie sich wie gewohnt in der Tradovate Web App an. Suchen Sie in der oberen rechten Ecke des Bildschirms und klicken Sie auf das Symbol <strong class='text-white'>Application Settings</strong>. Dieses Menü enthält Ihre Kontoeinstellungen, Risikoeinstellungen und Profildetails." },
        { title: "Den Tab Your Profile öffnen", html: "Das Einstellungsmenü zeigt links eine Liste von Bereichen. Wählen Sie den Tab <strong class='text-white'>Your Profile</strong>. Hier finden Sie Ihre kontobezogenen Angaben, getrennt von den Handels- und Anzeigeeinstellungen." },
        { title: "Auf Change Password klicken", html: "Scrollen Sie in Your Profile nach unten zur Überschrift <strong class='text-white'>User Profile</strong>. Dort sehen Sie die Schaltfläche <strong class='text-white'>Change Password</strong>. Klicken Sie darauf, und ein kleines Pop-up-Fenster für die eigentliche Änderung öffnet sich." },
        { title: "Neues Passwort eingeben und bestätigen", html: "Das Pop-up verlangt drei Angaben: Ihr <strong class='text-white'>aktuelles Passwort</strong>, Ihr <strong class='text-white'>neues Passwort</strong> und eine <strong class='text-white'>Bestätigung</strong> des neuen Passworts. Geben Sie diese ein und speichern Sie anschließend. Tradovate erzwingt eigene Mindestlängen und Komplexitätsregeln, und das Formular weist eine schwache Eingabe ab, bevor Sie fertig werden. Wählen Sie also etwas Langes und Einzigartiges, das Sie nirgendwo sonst verwenden. Sobald es gespeichert ist, gilt das neue Passwort überall, wo Sie sich anmelden, einschließlich Desktop-App, Mobilgerät und jeder TradingView-Verbindung." },
      ],
    },
    { type: "heading",text: "Passwort vergessen? Per E-Mail zurücksetzen" },
    { type: "paragraph",html: "Wenn Sie sich nicht anmelden können, funktioniert die In-App-Methode nicht, da sie Ihr aktuelles Passwort benötigt. Setzen Sie es stattdessen per E-Mail zurück. Klicken Sie auf dem Anmeldebildschirm auf <strong class='text-white'>Need Help?</strong> und wählen Sie dann <strong class='text-white'>Reset Password</strong>. Geben Sie den mit Ihrem Konto verknüpften Benutzernamen oder die E-Mail-Adresse ein, und Tradovate sendet die Anweisungen zum Zurücksetzen an die hinterlegte E-Mail-Adresse. Beachten Sie dabei Folgendes:" },
    {
      type: "list",
      items: [
        "Tradovate fragt Sie niemals direkt nach Ihrem Passwort. Ignorieren Sie daher jeden, der das tut.",
        "Falls die E-Mail nicht innerhalb weniger Minuten eintrifft, prüfen Sie Ihre Spam- und Junk-Ordner.",
        "Links zum Zurücksetzen laufen ab. Wenn Sie mehrere angefordert haben, verwenden Sie die neueste E-Mail.",
      ],
    },
    { type: "heading",text: "Prop-Firm- oder Evaluation-Konto?" },
    { type: "paragraph",html: "Evaluation- und Funded-Logins werden von der Firma verwaltet, nicht direkt von Tradovate. Das Self-Service-Zurücksetzen funktioniert dort in der Regel nicht, und die Regeln für Passwort und Zugang unterscheiden sich je nach Firma und Kontogröße. Prüfen Sie daher die aktuellen Regeln Ihrer Firma. Wenn Sie das Passwort eines Apex-, Topstep- oder ähnlichen Evaluation-Logins ändern oder zurücksetzen müssen, wenden Sie sich an den Support dieses Anbieters und nicht an Tradovate." },
    { type: "heading",text: "Schnelle Fehlerbehebung" },
    { type: "table", headers: ["Problem","Was Sie versuchen können"], rows: [
      ["Neues Passwort wird abgelehnt","Wählen Sie ein längeres Passwort, ergänzen Sie Zahlen oder Symbole und achten Sie darauf, dass es sich vom alten unterscheidet."],
      ["„Current password is incorrect“","Möglicherweise geben Sie das Passwort einer Prop Firm beim falschen Login ein. Prüfen Sie das Konto oder setzen Sie es per E-Mail zurück."],
      ["Nach mehreren Versuchen gesperrt","Hören Sie auf, es erneut zu versuchen, und warten Sie die vorübergehende Sperre ab, bevor Sie es noch einmal probieren."],
      ["Option auf dem Mobilgerät nicht zu finden","Führen Sie die Änderung in der Web App durch und melden Sie sich anschließend mit dem neuen Passwort wieder auf dem Mobilgerät an."],
    ] },
    { type: "paragraph",html: "Noch eine Gewohnheit, die sich lohnt: Melden Sie sich direkt nach einer Passwortänderung auf jedem neuen Gerät frisch an, damit Sie Geräte-Freigaben frühzeitig erledigen. Ist die Zwei-Faktor-Authentifizierung aktiv, erhalten Sie einen Bestätigungsschritt, sodass Sie ein Problem bei der Orderweiterleitung nicht mitten in einer Sitzung überrascht." },
  ], es: [
    { type: "paragraph",html: "Su contraseña de Tradovate protege el enrutamiento de sus órdenes, sus cuentas fondeadas y, en última instancia, su dinero. Si la reutilizó en un lugar poco seguro, la compartió con un servicio en el que ya no confía o simplemente rota sus credenciales con regularidad, puede cambiarla usted mismo en menos de un minuto. No necesita ningún ticket de soporte. Todo está en la configuración de su perfil, y aquí tiene la ruta exacta." },
    { type: "quote",html: "Necesitará su <strong class='text-white'>contraseña actual</strong> para cambiarla desde la plataforma. Si ya la olvidó y no puede iniciar sesión, vaya directamente al método de restablecimiento por correo electrónico más abajo. ¿Opera una evaluación de una prop firm? Lea primero la nota cercana al final, porque esos accesos siguen sus propias reglas." },
    { type: "heading",text: "Cambie su contraseña paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra Application Settings", html: "Inicie sesión en la Tradovate Web App como de costumbre. Busque en la esquina superior derecha de la pantalla y haga clic en el icono <strong class='text-white'>Application Settings</strong>. Es el mismo menú donde se encuentran las preferencias de su cuenta, la configuración de riesgo y los datos de su perfil." },
        { title: "Abra la pestaña Your Profile", html: "El menú de configuración se abre con una lista de secciones a la izquierda. Seleccione la pestaña <strong class='text-white'>Your Profile</strong>. Aquí se encuentran los datos a nivel de cuenta, separados de las preferencias de trading y de visualización." },
        { title: "Haga clic en Change Password", html: "Dentro de Your Profile, desplácese hacia abajo hasta el encabezado <strong class='text-white'>User Profile</strong>. Allí verá un botón <strong class='text-white'>Change Password</strong>. Haga clic en él y se abrirá una pequeña ventana emergente para realizar el cambio." },
        { title: "Introduzca y confirme su nueva contraseña", html: "La ventana emergente solicita tres datos: su <strong class='text-white'>contraseña actual</strong>, su <strong class='text-white'>nueva contraseña</strong> y una <strong class='text-white'>confirmación</strong> de la nueva. Escríbalas y guarde para aplicar el cambio. Tradovate aplica sus propios requisitos mínimos de longitud y complejidad, y el formulario señalará una contraseña débil antes de permitirle terminar, así que elija una larga y única que no utilice en ningún otro sitio. Una vez guardada, la nueva contraseña estará activa en todos los lugares donde inicie sesión, incluidos la aplicación de escritorio, el móvil y cualquier conexión con TradingView." },
      ],
    },
    { type: "heading",text: "¿Olvidó su contraseña? Restablézcala por correo electrónico" },
    { type: "paragraph",html: "Si no puede iniciar sesión, no puede usar el método dentro de la aplicación, porque requiere su contraseña actual. Restablézcala por correo electrónico. En la pantalla de inicio de sesión, haga clic en <strong class='text-white'>Need Help?</strong> y luego elija <strong class='text-white'>Reset Password</strong>. Introduzca el nombre de usuario o el correo electrónico asociado a su cuenta y Tradovate enviará las instrucciones de restablecimiento al correo que tiene registrado. Tenga en cuenta lo siguiente:" },
    {
      type: "list",
      items: [
        "Tradovate nunca le pedirá su contraseña directamente, así que ignore a cualquiera que lo haga.",
        "Si el correo no llega en un par de minutos, revise sus carpetas de spam y correo no deseado.",
        "Los enlaces de restablecimiento caducan. Si solicitó más de uno, utilice el correo más reciente.",
      ],
    },
    { type: "heading",text: "¿Tiene una cuenta de prop firm o de evaluación?" },
    { type: "paragraph",html: "Los accesos de evaluación y de cuentas fondeadas los gestiona la firma, no Tradovate directamente. El restablecimiento de autoservicio normalmente no funciona con ellos, y las reglas de contraseña y acceso varían según la firma y el tamaño de la cuenta, así que consulte las reglas vigentes de su firma. Si necesita cambiar o restablecer la contraseña de un acceso de evaluación de Apex, Topstep o similar, póngase en contacto con el soporte de ese proveedor en lugar de con Tradovate." },
    { type: "heading",text: "Solución rápida de problemas" },
    { type: "table", headers: ["Problema","Qué probar"], rows: [
      ["La nueva contraseña es rechazada","Hágala más larga, añada números o símbolos y asegúrese de que sea distinta de la anterior."],
      ["«Current password is incorrect»","Es posible que esté introduciendo la contraseña de una prop firm en el acceso equivocado. Confirme la cuenta o restablezca la contraseña por correo electrónico."],
      ["Bloqueo tras varios intentos","Deje de reintentar y espere a que termine el bloqueo temporal antes de volver a intentarlo."],
      ["No encuentra la opción en el móvil","Realice el cambio en la Web App y luego vuelva a iniciar sesión en el móvil con la nueva contraseña."],
    ] },
    { type: "paragraph",html: "Un hábito más que vale la pena adoptar: justo después de cambiar la contraseña, inicie sesión de nuevo en cualquier dispositivo nuevo para resolver cuanto antes las solicitudes de aprobación de dispositivos. Si tiene activada la autenticación de dos factores, recibirá un paso de confirmación, de modo que un contratiempo en el enrutamiento no le sorprenda en plena sesión." },
  ], fr: [
    { type: "paragraph",html: "Votre mot de passe Tradovate protège l’acheminement de vos ordres, vos comptes financés et, au bout du compte, votre argent. Si vous l’avez réutilisé dans un endroit risqué, partagé avec un service auquel vous ne faites plus confiance, ou si vous changez simplement vos identifiants à intervalles réguliers, vous pouvez le remplacer vous-même en moins d’une minute. Aucun ticket de support n’est nécessaire. Tout se trouve dans les paramètres de votre profil, et voici le chemin exact." },
    { type: "quote",html: "Vous aurez besoin de votre <strong class='text-white'>mot de passe actuel</strong> pour le modifier depuis la plateforme. Si vous l’avez déjà oublié et ne pouvez plus vous connecter, passez directement à la méthode de réinitialisation par e-mail plus bas. Vous êtes en évaluation chez une prop firm ? Lisez d’abord la note vers la fin, car ces identifiants suivent leurs propres règles." },
    { type: "heading",text: "Modifiez votre mot de passe étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez Application Settings", html: "Connectez-vous à la Tradovate Web App comme d’habitude. Repérez le coin supérieur droit de l’écran et cliquez sur l’icône <strong class='text-white'>Application Settings</strong>. C’est le même menu qui regroupe les préférences de votre compte, vos paramètres de risque et les détails de votre profil." },
        { title: "Ouvrez l’onglet Your Profile", html: "Le menu des paramètres s’ouvre avec une liste de sections sur la gauche. Sélectionnez l’onglet <strong class='text-white'>Your Profile</strong>. C’est là que se trouvent les informations au niveau du compte, distinctes des préférences de trading et d’affichage." },
        { title: "Cliquez sur Change Password", html: "Dans Your Profile, faites défiler jusqu’au titre <strong class='text-white'>User Profile</strong>. Vous y verrez un bouton <strong class='text-white'>Change Password</strong>. Cliquez dessus et une petite fenêtre contextuelle s’ouvre pour effectuer la modification." },
        { title: "Saisissez et confirmez votre nouveau mot de passe", html: "La fenêtre contextuelle demande trois éléments : votre <strong class='text-white'>mot de passe actuel</strong>, votre <strong class='text-white'>nouveau mot de passe</strong> et une <strong class='text-white'>confirmation</strong> de ce dernier. Saisissez-les, puis enregistrez pour appliquer le changement. Tradovate impose ses propres exigences de longueur et de complexité minimales, et le formulaire signalera une saisie trop faible avant de vous laisser terminer ; choisissez donc un mot de passe long et unique que vous n’utilisez nulle part ailleurs. Une fois enregistré, le nouveau mot de passe est actif partout où vous vous connectez, y compris l’application de bureau, le mobile et toute connexion TradingView." },
      ],
    },
    { type: "heading",text: "Mot de passe oublié ? Réinitialisez-le par e-mail" },
    { type: "paragraph",html: "Si vous ne pouvez pas vous connecter, vous ne pouvez pas utiliser la méthode dans l’application, car elle exige votre mot de passe actuel. Réinitialisez-le plutôt par e-mail. Sur l’écran de connexion, cliquez sur <strong class='text-white'>Need Help?</strong>, puis choisissez <strong class='text-white'>Reset Password</strong>. Saisissez le nom d’utilisateur ou l’adresse e-mail associé à votre compte, et Tradovate envoie les instructions de réinitialisation à l’adresse e-mail qu’il a en dossier. Gardez ceci à l’esprit :" },
    {
      type: "list",
      items: [
        "Tradovate ne vous demandera jamais directement votre mot de passe ; ignorez donc quiconque le fait.",
        "Si l’e-mail n’arrive pas en quelques minutes, vérifiez vos dossiers de spam et de courrier indésirable.",
        "Les liens de réinitialisation expirent. Si vous en avez demandé plusieurs, utilisez l’e-mail le plus récent.",
      ],
    },
    { type: "heading",text: "Compte de prop firm ou d’évaluation ?" },
    { type: "paragraph",html: "Les identifiants d’évaluation et de comptes financés sont gérés par la firme, et non directement par Tradovate. La réinitialisation en libre-service ne fonctionne généralement pas pour eux, et les règles de mot de passe et d’accès varient selon la firme et la taille du compte ; vérifiez donc les règles en vigueur de votre firme. Si vous devez modifier ou réinitialiser le mot de passe d’un identifiant d’évaluation Apex, Topstep ou similaire, contactez le support de ce fournisseur plutôt que Tradovate." },
    { type: "heading",text: "Dépannage rapide" },
    { type: "table", headers: ["Problème","Ce qu’il faut essayer"], rows: [
      ["Le nouveau mot de passe est refusé","Allongez-le, ajoutez des chiffres ou des symboles et assurez-vous qu’il diffère de l’ancien."],
      ["« Current password is incorrect »","Vous saisissez peut-être le mot de passe d’une prop firm sur le mauvais identifiant. Vérifiez le compte ou réinitialisez par e-mail."],
      ["Verrouillé après plusieurs tentatives","Cessez de réessayer et attendez la fin du verrouillage temporaire avant de retenter."],
      ["Option introuvable sur mobile","Effectuez la modification dans la Web App, puis reconnectez-vous sur mobile avec le nouveau mot de passe."],
    ] },
    { type: "paragraph",html: "Une dernière habitude à prendre : juste après un changement de mot de passe, connectez-vous à nouveau sur chaque nouvel appareil afin de régler tôt les demandes d’approbation d’appareil. Si l’authentification à deux facteurs est activée, vous recevrez une étape de confirmation, de sorte qu’un incident d’acheminement ne vous surprenne pas en pleine séance." },
  ], it: [
    { type: "paragraph",html: "La Sua password Tradovate protegge l’instradamento dei Suoi ordini, i Suoi conti finanziati e, in ultima analisi, il Suo denaro. Se l’ha riutilizzata in un posto poco sicuro, l’ha condivisa con un servizio di cui non si fida più o semplicemente ruota le credenziali con regolarità, può cambiarla in autonomia in meno di un minuto. Nessun ticket di supporto necessario. Tutto si trova nelle impostazioni del Suo profilo, ed ecco il percorso esatto." },
    { type: "quote",html: "Per cambiarla dall’interno della piattaforma Le servirà la Sua <strong class='text-white'>password attuale</strong>. Se l’ha già dimenticata e non riesce ad accedere, passi direttamente al metodo di reimpostazione via e-mail più sotto. Opera con una valutazione di una prop firm? Legga prima la nota verso la fine, perché quegli accessi seguono regole proprie." },
    { type: "heading",text: "Cambi la Sua password passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Apra Application Settings", html: "Acceda alla Tradovate Web App come di consueto. Guardi l’angolo in alto a destra dello schermo e clicchi sull’icona <strong class='text-white'>Application Settings</strong>. È lo stesso menu in cui si trovano le preferenze del conto, le impostazioni di rischio e i dettagli del profilo." },
        { title: "Apra la scheda Your Profile", html: "Il menu delle impostazioni si apre con un elenco di sezioni sul lato sinistro. Selezioni la scheda <strong class='text-white'>Your Profile</strong>. Qui si trovano i dettagli a livello di conto, separati dalle preferenze di trading e di visualizzazione." },
        { title: "Clicchi su Change Password", html: "All’interno di Your Profile, scorra verso il basso fino all’intestazione <strong class='text-white'>User Profile</strong>. Vedrà un pulsante <strong class='text-white'>Change Password</strong>. Ci clicchi e si aprirà una piccola finestra pop-up per effettuare la modifica." },
