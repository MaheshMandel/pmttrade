---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-adjust-demo-balance";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Change Your Tradovate Demo Account Balance";
const META_DESCRIPTION =
  "Tradovate demo account balance running low? Top up or reset your simulated SIM funds from Application Settings and keep practice trading risk-free.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Kontostand Ihres Tradovate-Demokontos ändern", es: "Cómo cambiar el saldo de su cuenta demo de Tradovate", fr: "Modifier le solde de votre compte démo Tradovate", it: "Come modificare il saldo del conto demo Tradovate" },
  dek: { en: "Ran your practice account down to nothing, or want a clean round number to start from? Changing your Tradovate demo balance takes about thirty seconds once you know where the button lives.", de: "Ihr Übungskonto ist leer gelaufen oder Sie möchten mit einer glatten Zahl neu starten? Den Kontostand Ihres Tradovate-Demokontos zu ändern dauert etwa dreißig Sekunden, sobald Sie wissen, wo sich die Schaltfläche befindet.", es: "¿Ha agotado su cuenta de práctica o desea empezar desde una cifra redonda? Cambiar el saldo de su cuenta demo de Tradovate lleva unos treinta segundos una vez que sabe dónde está el botón.", fr: "Vous avez vidé votre compte d'entraînement ou vous voulez repartir d'un chiffre rond ? Modifier le solde de votre compte démo Tradovate prend une trentaine de secondes une fois que vous savez où se trouve le bouton.", it: "Ha esaurito il conto di pratica o vuole ripartire da una cifra tonda? Modificare il saldo del Suo conto demo Tradovate richiede circa trenta secondi, una volta che sa dove si trova il pulsante." },
  readTime: { en: "4 min read", de: "4 Min. Lesezeit", es: "Lectura de 4 min", fr: "Lecture : 4 min", it: "Lettura di 4 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Ran your practice account down to nothing? Want a clean round number to start from? Or maybe you're sizing a strategy to match a funded target before you risk real capital. Whatever the reason, changing your Tradovate demo balance takes about thirty seconds once you know where the button lives. Here's exactly how to do it." },
    { type: "heading", text: "What Is the Demo Account Balance?" },
    { type: "paragraph", html: "Your Tradovate demo (or \"SIM\") balance is the virtual cash and equity sitting in your simulated practice account. It's the money you trade with while you're learning the platform, testing an idea, or paper-trading a prop-firm-style size. Since none of it is real, Tradovate lets you set that number yourself. You can add funds after a rough session, wipe out a drawdown, or dial in a specific starting figure." },
    { type: "paragraph", html: "Just to be clear: this is not the same thing as <a href='https://pickmytrade.trade/how-to/tradovate-demo-account/'>starting or resetting the free demo trial</a>. Here you're only changing the balance. The trial window itself stays put." },
    { type: "heading", text: "Change Your Demo Balance in Tradovate: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open Application Settings", html: "Log in to the Tradovate web platform and click the <strong class='text-white'>Application Settings</strong> button in the upper-right corner of the screen. Make the change from the web app and it syncs everywhere else on its own.", image: { src: `${IMG}/tradovate-adjust-demo-balance-1.png`, alt: "Tradovate web platform showing the Application Settings button in the upper-right corner" } },
        { title: "Open the Accounts Tab and Find Your Demo Account", html: "Inside Application Settings, click the <strong class='text-white'>Accounts</strong> tab. Find your Demo / SIM account in the list. That's the simulated account tied to your practice session.", image: { src: `${IMG}/tradovate-adjust-demo-balance-2.png`, alt: "Tradovate Application Settings Accounts tab showing the demo SIM account" } },
      ],
    },
    { type: "paragraph", html: "One limit worth knowing: Tradovate caps demo balances at <strong class='text-white'>$50,000</strong> unless your live account holds that much or more. That ceiling can change, so if you're counting on a higher number, confirm the current rule in Tradovate's help center first." },
    { type: "heading", text: "Why You'd Need This" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Restart after a drawdown</strong>, reset your SIM equity to a fresh starting figure and keep practicing.",
        "<strong class='text-white'>Mirror a funded-account size</strong>, set the balance to match a prop-firm evaluation or a target account you plan to trade.",
        "<strong class='text-white'>Stress-test position sizing</strong>, push the balance up or down to see how your risk math holds up at different account sizes.",
        "<strong class='text-white'>Clean up a messy practice run</strong>, clear out inflated or negative simulated equity so your reports actually read straight.",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Once your practice account is set up the way you want, <strong class='text-white'>PickMyTrade wires your TradingView alerts straight into Tradovate</strong> so your strategy fires on its own, no manual clicks, on demo or live. Run the exact same automation on your SIM account first, then flip it over to your funded account once you trust it." },
  ], de: [
    { type: "paragraph",html: "Ihr Übungskonto ist auf null geschrumpft? Sie möchten mit einer glatten Zahl neu starten? Oder Sie wollen eine Strategie auf ein Funded-Ziel abstimmen, bevor Sie echtes Kapital riskieren. Aus welchem Grund auch immer: Den Kontostand Ihres Tradovate-Demokontos zu ändern dauert etwa dreißig Sekunden, sobald Sie wissen, wo sich die Schaltfläche befindet. So gehen Sie genau vor." },
    { type: "heading",text: "Was ist der Demo-Kontostand?" },
    { type: "paragraph",html: "Ihr Tradovate-Demo-Kontostand (oder „SIM“-Kontostand) ist das virtuelle Guthaben samt Eigenkapital auf Ihrem simulierten Übungskonto. Damit handeln Sie, während Sie die Plattform kennenlernen, eine Idee testen oder eine Positionsgröße im Stil eines Prop-Firms im Papiertrading ausprobieren. Da nichts davon echtes Geld ist, können Sie diese Zahl bei Tradovate selbst festlegen. Sie können nach einer schwachen Session Guthaben aufstocken, einen Drawdown löschen oder einen bestimmten Startbetrag einstellen." },
    { type: "paragraph",html: "Zur Klarstellung: Das ist nicht dasselbe wie <a href='https://pickmytrade.trade/how-to/tradovate-demo-account/'>das Starten oder Zurücksetzen der kostenlosen Demo-Testphase</a>. Hier ändern Sie nur den Kontostand. Der Testzeitraum selbst bleibt unverändert." },
    { type: "heading",text: "Demo-Kontostand in Tradovate ändern: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Application Settings öffnen", html: "Melden Sie sich bei der Tradovate-Webplattform an und klicken Sie oben rechts auf dem Bildschirm auf die Schaltfläche <strong class='text-white'>Application Settings</strong>. Nehmen Sie die Änderung in der Web-App vor, wird sie automatisch überall sonst synchronisiert.", image: {"src":`${IMG}/tradovate-adjust-demo-balance-1.png`,"alt":"Tradovate-Webplattform mit der Schaltfläche Application Settings in der oberen rechten Ecke"} },
        { title: "Den Reiter Accounts öffnen und Ihr Demokonto finden", html: "Klicken Sie in den Application Settings auf den Reiter <strong class='text-white'>Accounts</strong>. Suchen Sie in der Liste Ihr Demo-/SIM-Konto. Das ist das simulierte Konto, das zu Ihrer Übungssitzung gehört.", image: {"src":`${IMG}/tradovate-adjust-demo-balance-2.png`,"alt":"Reiter Accounts in den Tradovate Application Settings mit dem SIM-Demokonto"} },
      ],
    },
    { type: "paragraph",html: "Eine Grenze sollten Sie kennen: Tradovate begrenzt Demo-Kontostände auf <strong class='text-white'>50.000 $</strong>, es sei denn, Ihr Live-Konto weist diesen Betrag oder mehr auf. Diese Obergrenze kann sich ändern. Wenn Sie also auf einen höheren Betrag angewiesen sind, prüfen Sie zuerst die aktuelle Regel im Tradovate-Hilfecenter." },
    { type: "heading",text: "Wozu Sie das brauchen" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Neustart nach einem Drawdown</strong>: Setzen Sie Ihr SIM-Eigenkapital auf einen frischen Startbetrag zurück und üben Sie weiter.",
        "<strong class='text-white'>Funded-Kontogröße nachbilden</strong>: Stellen Sie den Kontostand passend zu einer Prop-Firm-Evaluierung oder einem Zielkonto ein, das Sie handeln möchten.",
        "<strong class='text-white'>Positionsgrößen einem Stresstest unterziehen</strong>: Erhöhen oder senken Sie den Kontostand, um zu sehen, wie Ihre Risikorechnung bei unterschiedlichen Kontogrößen standhält.",
        "<strong class='text-white'>Ein chaotisches Übungsergebnis bereinigen</strong>: Entfernen Sie aufgeblähtes oder negatives simuliertes Eigenkapital, damit Ihre Berichte wieder sauber aussehen.",
      ],
    },
    { type: "heading",text: "Automatisieren mit PickMyTrade" },
    { type: "paragraph",html: "Sobald Ihr Übungskonto so eingerichtet ist, wie Sie es möchten, <strong class='text-white'>leitet PickMyTrade Ihre TradingView-Alerts direkt an Tradovate weiter</strong>, sodass Ihre Strategie von selbst auslöst, ganz ohne manuelle Klicks, ob auf Demo oder Live. Lassen Sie dieselbe Automatisierung zunächst auf Ihrem SIM-Konto laufen und wechseln Sie dann zu Ihrem Funded-Konto, sobald Sie ihr vertrauen." },
  ], es: [
    { type: "paragraph",html: "¿Ha agotado su cuenta de práctica? ¿Quiere empezar desde una cifra redonda? O quizá esté dimensionando una estrategia para igualar un objetivo de cuenta fondeada antes de arriesgar capital real. Sea cual sea el motivo, cambiar el saldo de su cuenta demo de Tradovate lleva unos treinta segundos una vez que sabe dónde está el botón. Así se hace exactamente." },
    { type: "heading",text: "¿Qué es el saldo de la cuenta demo?" },
    { type: "paragraph",html: "El saldo de su cuenta demo (o «SIM») de Tradovate es el efectivo y el capital virtuales de su cuenta de práctica simulada. Es el dinero con el que opera mientras aprende la plataforma, prueba una idea o practica con un tamaño al estilo de una prop firm. Como nada de ello es real, Tradovate le permite fijar esa cifra usted mismo. Puede añadir fondos tras una sesión mala, borrar un drawdown o ajustar una cifra inicial concreta." },
    { type: "paragraph",html: "Para que quede claro: esto no es lo mismo que <a href='https://pickmytrade.trade/how-to/tradovate-demo-account/'>iniciar o reiniciar la prueba demo gratuita</a>. Aquí solo cambia el saldo. El periodo de prueba en sí permanece igual." },
    { type: "heading",text: "Cambiar el saldo demo en Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra Application Settings", html: "Inicie sesión en la plataforma web de Tradovate y haga clic en el botón <strong class='text-white'>Application Settings</strong> situado en la esquina superior derecha de la pantalla. Si realiza el cambio desde la aplicación web, se sincroniza solo en todas partes.", image: {"src":`${IMG}/tradovate-adjust-demo-balance-1.png`,"alt":"Plataforma web de Tradovate con el botón Application Settings en la esquina superior derecha"} },
        { title: "Abra la pestaña Accounts y localice su cuenta demo", html: "Dentro de Application Settings, haga clic en la pestaña <strong class='text-white'>Accounts</strong>. Localice su cuenta Demo / SIM en la lista. Es la cuenta simulada asociada a su sesión de práctica.", image: {"src":`${IMG}/tradovate-adjust-demo-balance-2.png`,"alt":"Pestaña Accounts de Application Settings de Tradovate con la cuenta demo SIM"} },
      ],
    },
    { type: "paragraph",html: "Un límite que conviene conocer: Tradovate limita los saldos demo a <strong class='text-white'>50.000 $</strong>, salvo que su cuenta real tenga esa cantidad o más. Ese tope puede cambiar, así que si cuenta con una cifra mayor, confirme primero la norma vigente en el centro de ayuda de Tradovate." },
    { type: "heading",text: "Por qué lo necesitaría" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Reiniciar tras un drawdown</strong>: restablezca el capital de su SIM a una cifra inicial nueva y siga practicando.",
        "<strong class='text-white'>Reproducir el tamaño de una cuenta fondeada</strong>: ajuste el saldo para igualar una evaluación de prop firm o una cuenta objetivo con la que piensa operar.",
        "<strong class='text-white'>Someter a prueba el tamaño de posición</strong>: suba o baje el saldo para ver cómo se sostiene su cálculo de riesgo con distintos tamaños de cuenta.",
        "<strong class='text-white'>Limpiar una práctica desordenada</strong>: elimine el capital simulado inflado o negativo para que sus informes se lean con claridad.",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Una vez que su cuenta de práctica esté configurada como desea, <strong class='text-white'>PickMyTrade conecta sus alertas de TradingView directamente con Tradovate</strong> para que su estrategia se ejecute sola, sin clics manuales, tanto en demo como en real. Ejecute primero exactamente la misma automatización en su cuenta SIM y luego páselo a su cuenta fondeada cuando confíe en ella." },
  ], fr: [
    { type: "paragraph",html: "Vous avez vidé votre compte d'entraînement ? Vous voulez repartir d'un chiffre rond ? Ou peut-être dimensionnez-vous une stratégie pour correspondre à un objectif de compte financé avant de risquer du capital réel. Quelle que soit la raison, modifier le solde de votre compte démo Tradovate prend une trentaine de secondes une fois que vous savez où se trouve le bouton. Voici comment procéder." },
    { type: "heading",text: "Qu'est-ce que le solde du compte démo ?" },
    { type: "paragraph",html: "Le solde de votre compte démo (ou « SIM ») Tradovate correspond aux liquidités et aux fonds propres virtuels de votre compte d'entraînement simulé. C'est l'argent avec lequel vous tradez pendant que vous apprenez la plateforme, testez une idée ou vous entraînez à une taille de type prop firm. Rien de tout cela n'étant réel, Tradovate vous laisse fixer ce chiffre vous-même. Vous pouvez ajouter des fonds après une mauvaise session, effacer un drawdown ou régler un montant de départ précis." },
    { type: "paragraph",html: "Précisons-le : ce n'est pas la même chose que <a href='https://pickmytrade.trade/how-to/tradovate-demo-account/'>démarrer ou réinitialiser l'essai démo gratuit</a>. Ici, vous ne changez que le solde. La période d'essai elle-même ne bouge pas." },
    { type: "heading",text: "Modifier le solde démo dans Tradovate : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir Application Settings", html: "Connectez-vous à la plateforme web Tradovate et cliquez sur le bouton <strong class='text-white'>Application Settings</strong> dans le coin supérieur droit de l'écran. Si vous effectuez la modification depuis l'application web, elle se synchronise automatiquement partout ailleurs.", image: {"src":`${IMG}/tradovate-adjust-demo-balance-1.png`,"alt":"Plateforme web Tradovate affichant le bouton Application Settings dans le coin supérieur droit"} },
        { title: "Ouvrir l'onglet Accounts et repérer votre compte démo", html: "Dans Application Settings, cliquez sur l'onglet <strong class='text-white'>Accounts</strong>. Repérez votre compte Demo / SIM dans la liste. C'est le compte simulé lié à votre session d'entraînement.", image: {"src":`${IMG}/tradovate-adjust-demo-balance-2.png`,"alt":"Onglet Accounts des Application Settings de Tradovate affichant le compte démo SIM"} },
      ],
    },
    { type: "paragraph",html: "Une limite à connaître : Tradovate plafonne les soldes démo à <strong class='text-white'>50 000 $</strong>, sauf si votre compte réel détient ce montant ou davantage. Ce plafond peut changer ; si vous comptez sur un chiffre plus élevé, vérifiez d'abord la règle en vigueur dans le centre d'aide Tradovate." },
    { type: "heading",text: "Pourquoi en auriez-vous besoin" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Repartir après un drawdown</strong> : remettez vos fonds propres SIM à un montant de départ neuf et continuez de vous entraîner.",
        "<strong class='text-white'>Reproduire la taille d'un compte financé</strong> : réglez le solde pour qu'il corresponde à une évaluation de prop firm ou à un compte cible que vous prévoyez de trader.",
        "<strong class='text-white'>Tester la taille de position sous contrainte</strong> : augmentez ou diminuez le solde pour voir comment votre calcul de risque tient selon la taille du compte.",
        "<strong class='text-white'>Nettoyer une session d'entraînement désordonnée</strong> : supprimez des fonds propres simulés gonflés ou négatifs pour que vos rapports soient réellement lisibles.",
      ],
    },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Une fois votre compte d'entraînement configuré comme vous le souhaitez, <strong class='text-white'>PickMyTrade relie directement vos alertes TradingView à Tradovate</strong> afin que votre stratégie s'exécute toute seule, sans clic manuel, en démo comme en réel. Exécutez d'abord exactement la même automatisation sur votre compte SIM, puis basculez sur votre compte financé quand vous lui faites confiance." },
  ], it: [
    { type: "paragraph",html: "Ha esaurito il conto di pratica? Vuole ripartire da una cifra tonda? Oppure sta dimensionando una strategia per adeguarla a un obiettivo di conto finanziato prima di rischiare capitale reale. Qualunque sia il motivo, modificare il saldo del Suo conto demo Tradovate richiede circa trenta secondi, una volta che sa dove si trova il pulsante. Ecco come fare, passo per passo." },
    { type: "heading",text: "Che cos'è il saldo del conto demo?" },
    { type: "paragraph",html: "Il saldo del Suo conto demo (o «SIM») Tradovate è la liquidità e il capitale virtuali presenti nel Suo conto di pratica simulato. È il denaro con cui opera mentre impara la piattaforma, mette alla prova un'idea o si esercita con dimensioni in stile prop firm. Poiché nulla di tutto ciò è reale, Tradovate Le consente di impostare questa cifra da solo. Può aggiungere fondi dopo una sessione difficile, azzerare un drawdown o stabilire un importo iniziale preciso." },
    { type: "paragraph",html: "Per essere chiari: questo non equivale a <a href='https://pickmytrade.trade/how-to/tradovate-demo-account/'>avviare o reimpostare la prova demo gratuita</a>. Qui modifica soltanto il saldo. Il periodo di prova rimane invariato." },
    { type: "heading",text: "Modificare il saldo demo in Tradovate: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Apra Application Settings", html: "Acceda alla piattaforma web di Tradovate e faccia clic sul pulsante <strong class='text-white'>Application Settings</strong> nell'angolo in alto a destra dello schermo. Se effettua la modifica dall'app web, questa si sincronizza automaticamente ovunque.", image: {"src":`${IMG}/tradovate-adjust-demo-balance-1.png`,"alt":"Piattaforma web di Tradovate con il pulsante Application Settings nell'angolo in alto a destra"} },
        { title: "Apra la scheda Accounts e trovi il Suo conto demo", html: "In Application Settings, faccia clic sulla scheda <strong class='text-white'>Accounts</strong>. Trovi nell'elenco il Suo conto Demo / SIM. È il conto simulato associato alla Sua sessione di pratica.", image: {"src":`${IMG}/tradovate-adjust-demo-balance-2.png`,"alt":"Scheda Accounts delle Application Settings di Tradovate con il conto demo SIM"} },
      ],
    },
    { type: "paragraph",html: "Un limite da conoscere: Tradovate fissa un tetto di <strong class='text-white'>50.000 $</strong> ai saldi demo, a meno che il Suo conto live non detenga tale importo o più. Questo limite può cambiare, quindi se conta su una cifra superiore, verifichi prima la regola attuale nel centro assistenza di Tradovate." },
    { type: "heading",text: "Perché potrebbe servirLe" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Ripartire dopo un drawdown</strong>: riporti il capitale del Suo SIM a un importo iniziale nuovo e continui a fare pratica.",
        "<strong class='text-white'>Replicare la dimensione di un conto finanziato</strong>: imposti il saldo in modo che corrisponda a una valutazione di una prop firm o a un conto obiettivo che intende operare.",
        "<strong class='text-white'>Mettere sotto stress il position sizing</strong>: aumenti o riduca il saldo per vedere come regge il Suo calcolo del rischio con dimensioni di conto diverse.",
        "<strong class='text-white'>Ripulire una sessione di pratica disordinata</strong>: elimini il capitale simulato gonfiato o negativo, così i Suoi report risultano finalmente chiari.",
      ],
    },
    { type: "heading",text: "Automatizzi tutto con PickMyTrade" },
    { type: "paragraph",html: "Una volta configurato il conto di pratica come desidera, <strong class='text-white'>PickMyTrade collega direttamente i Suoi alert di TradingView a Tradovate</strong> in modo che la Sua strategia si attivi da sola, senza clic manuali, sia su demo sia su live. Esegua prima la stessa identica automazione sul Suo conto SIM, poi la passi al Suo conto finanziato quando si fida." },
  ] },
  ctaHeading: { en: "Automate Your Tradovate Trades", de: "Automatisieren Sie Ihre Tradovate-Trades", es: "Automatice sus operaciones en Tradovate", fr: "Automatisez vos trades sur Tradovate", it: "Automatizzi i Suoi trade su Tradovate" },
  ctaText: { en: "Run the same automation on your SIM account first, then flip it to live once you trust it. PickMyTrade wires your TradingView alerts straight into Tradovate.", de: "Lassen Sie dieselbe Automatisierung zunächst auf Ihrem SIM-Konto laufen und schalten Sie sie auf Live um, sobald Sie ihr vertrauen. PickMyTrade leitet Ihre TradingView-Alerts direkt an Tradovate weiter.", es: "Ejecute primero la misma automatización en su cuenta SIM y pásela a real cuando confíe en ella. PickMyTrade conecta sus alertas de TradingView directamente con Tradovate.", fr: "Exécutez d'abord la même automatisation sur votre compte SIM, puis passez en réel quand vous lui faites confiance. PickMyTrade relie directement vos alertes TradingView à Tradovate.", it: "Esegua prima la stessa automazione sul Suo conto SIM, poi la passi al live quando si fida. PickMyTrade collega direttamente i Suoi alert di TradingView a Tradovate." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la Sua prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Can I set my Tradovate demo balance above $50,000?", a: "Usually not. Tradovate limits demo balances to $50,000 or less unless your live account holds that amount or more. A rule like this can change, so check Tradovate's current help-center guidance if you need a higher figure." },
    { q: "Will the new balance show on desktop and mobile too?", a: "Yes. Balance changes you make in the web app's Application Settings sync across all Tradovate platforms, Web, Desktop, and Mobile." },
    { q: "Is adjusting the balance the same as resetting my demo trial?", a: "No. You can change the balance anytime, but the free simulated trial itself runs for a limited window and can't be extended once it expires." },
