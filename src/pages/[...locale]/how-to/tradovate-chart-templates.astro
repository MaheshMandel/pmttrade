---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-chart-templates";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Save & Load Chart Templates in Tradovate";
const META_DESCRIPTION =
  "Save your indicator setup and chart layout as a reusable Tradovate template, then load it onto any chart in seconds. A clear step-by-step guide.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Chart-Vorlagen in Tradovate speichern und laden", es: "Guardar y cargar plantillas de gráficos en Tradovate", fr: "Enregistrer et charger des modèles de graphiques Tradovate", it: "Salva e carica i modelli di grafico in Tradovate" },
  dek: { en: "Rebuilding your indicator and appearance setup on every new chart gets old fast. Tradovate's chart templates fix it: save your setup once, then drop it onto any chart in a couple of clicks.", de: "Ihre Indikator- und Erscheinungsbild-Einrichtung bei jedem neuen Chart wieder aufzubauen, wird schnell lästig. Die Chart-Vorlagen von Tradovate lösen das: Speichern Sie Ihre Einrichtung einmal und wenden Sie sie dann mit wenigen Klicks auf jeden beliebigen Chart an.", es: "Reconstruir la configuración de indicadores y apariencia en cada nuevo gráfico se vuelve tedioso rápidamente. Las plantillas de gráficos de Tradovate solucionan esto: guarde su configuración una vez y luego aplíquela a cualquier gráfico en un par de clics.", fr: "Reconstruire votre configuration d'indicateurs et d'apparence sur chaque nouveau graphique devient vite lassant. Les modèles de graphique de Tradovate résolvent ce problème : enregistrez votre configuration une seule fois, puis appliquez-la à n'importe quel graphique en quelques clics.", it: "Ricostruire la configurazione di indicatori e aspetto su ogni nuovo grafico diventa presto stancante. I modelli di grafico di Tradovate risolvono il problema: salvi la configurazione una sola volta, poi la applichi a qualsiasi grafico in un paio di clic." },
  readTime: { en: "6 min read", de: "6 Minuten Lesezeit", es: "Lectura de 6 minutos", fr: "Lecture de 6 minutes", it: "Lettura di 6 minuti" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You dial in the perfect chart once, your moving averages, VWAP, the colors you actually like, and then you open a fresh symbol and it's a blank candlestick chart again. Rebuilding that setup every time gets old fast. Tradovate's chart templates fix it: save your indicator and appearance setup once, then drop it onto any chart in a couple of clicks. Here's how to save one, load it, and make it your default." },
    { type: "heading", text: "What a Chart Template Actually Saves" },
    { type: "paragraph", html: "A chart template stores the stuff that lives <em>on the chart itself</em>, your indicators and their settings, plus the chart style and appearance. What it doesn't save is just as important: it won't remember your DOM, your window arrangement, or the trendlines and zones you drew. Those hand-drawn markups and your overall screen layout belong to a <strong class='text-white'>workspace</strong>, not a template. So think of a template as \"how a single chart looks and reads,\" and a workspace as \"my whole trading screen.\" Keep that split straight and you'll never wonder why a saved template shows up clean but without your support-and-resistance lines." },
    { type: "heading", text: "How to Save a Chart Template" },
    {
      type: "steps",
      items: [
        { title: "Set Up the Chart First", html: "Before you save anything, get the chart exactly how you want it. Add your indicators, tune each one's settings, and set your chart style and colors. Whatever's on the chart when you save is what the template captures, so a messy chart makes a messy template." },
        { title: "Open the Chart Menu and Choose Templates", html: "Hover over the chart so the toolbar appears, then open the chart's menu button in the top toolbar. In that menu you'll find <strong class='text-white'>Templates</strong>, that's where both the save and load options live." },
        { title: "Save the Template and Name It", html: "Click <strong class='text-white'>Save Template</strong> and give it a name you'll actually recognize later, something like <code>ES-scalp</code> or <code>clean-chart</code> beats \"Template 1.\" Confirm, and Tradovate stores your indicators and appearance under that name. Save a few of these for different setups: one stripped-down chart for scalping, a busier one for swing context." },
        { title: "Load a Template Onto Any Chart", html: "Open any chart, a new symbol, a second window, whatever, and go back to the chart menu, then <strong class='text-white'>Templates</strong>. Click the saved template's name and it applies right there, swapping in your indicators and appearance instantly. That's the whole payoff: one click instead of rebuilding a dozen indicator settings by hand." },
        { title: "Make New Charts Open With Your Setup (Optional)", html: "If you always trade off the same look, you don't have to reload the template by hand every time. A saved template stays in the Templates menu for any chart, and Tradovate can apply it automatically so a fresh chart opens with your indicators already on it instead of a bare candlestick chart. Look for the default or auto-apply option in the Templates menu, the exact wording can shift between platform updates, so confirm it in your version." },
      ],
    },
    { type: "heading", text: "Templates vs. Workspaces at a Glance" },
    {
      type: "table",
      headers: ["What you want to keep", "Save a template", "Save a workspace"],
      rows: [
        ["Indicators and their settings", "Yes", "Yes"],
        ["Chart style and colors", "Yes", "Yes"],
        ["Trendlines, zones, drawings", "No", "Yes"],
        ["DOM and window layout", "No", "Yes"],
      ],
    },
    { type: "paragraph", html: "Bottom line: use a template when you just want the same chart look across symbols, and save a workspace when you want your entire screen, charts, DOM, and drawings, to come back exactly as you left it." },
    { type: "heading", text: "Automate the Setups You Build" },
    { type: "paragraph", html: "A clean, repeatable chart is only half the job. The other half is acting on what it shows you before the move gets away. <strong class='text-white'>PickMyTrade takes the alerts you fire from your TradingView charts and routes them straight into your Tradovate account as live orders</strong>, no scramble, no manual clicking. Build the chart, define the signal, and let the execution run itself." },
  ], de: [
    { type: "paragraph", html: "Sie richten den perfekten Chart einmal ein, Ihre gleitenden Durchschnitte, VWAP, die Farben, die Ihnen wirklich gefallen, und dann öffnen Sie ein neues Symbol und stehen wieder vor einem leeren Candlestick-Chart. Diese Einrichtung jedes Mal neu aufzubauen, wird schnell lästig. Die Chart-Vorlagen von Tradovate lösen das Problem: Speichern Sie Ihre Indikator- und Erscheinungsbild-Einrichtung einmal, und wenden Sie sie dann mit wenigen Klicks auf jeden beliebigen Chart an. So speichern und laden Sie eine Vorlage und legen sie als Standard fest." },
    { type: "heading", text: "Was eine Chart-Vorlage tatsächlich speichert" },
    { type: "paragraph", html: "Eine Chart-Vorlage speichert das, was <em>auf dem Chart selbst</em> vorhanden ist, also Ihre Indikatoren und deren Einstellungen sowie den Chart-Stil und das Erscheinungsbild. Was sie nicht speichert, ist genauso wichtig: Sie merkt sich weder Ihr DOM noch Ihre Fensteranordnung oder die von Ihnen gezeichneten Trendlinien und Zonen. Diese handgezeichneten Markierungen und Ihr gesamtes Bildschirmlayout gehören zu einem <strong class='text-white'>Workspace</strong>, nicht zu einer Vorlage. Betrachten Sie eine Vorlage also als \"wie ein einzelner Chart aussieht und sich liest\", und einen Workspace als \"meinen gesamten Trading-Bildschirm\". Behalten Sie diese Trennung im Kopf, dann werden Sie sich nie fragen, warum eine gespeicherte Vorlage sauber erscheint, aber ohne Ihre Unterstützungs- und Widerstandslinien." },
    { type: "heading", text: "Wie Sie eine Chart-Vorlage speichern" },
    {
      type: "steps",
      items: [
        { title: "Richten Sie zuerst den Chart ein", html: "Bevor Sie irgendetwas speichern, bringen Sie den Chart genau in die gewünschte Form. Fügen Sie Ihre Indikatoren hinzu, passen Sie die Einstellungen jedes einzelnen an, und legen Sie Chart-Stil und Farben fest. Was auch immer sich beim Speichern auf dem Chart befindet, wird von der Vorlage erfasst, ein unordentlicher Chart ergibt also eine unordentliche Vorlage." },
        { title: "Öffnen Sie das Chart-Menü und wählen Sie Templates", html: "Bewegen Sie den Mauszeiger über den Chart, damit die Symbolleiste erscheint, und öffnen Sie dann die Menüschaltfläche des Charts in der oberen Symbolleiste. In diesem Menü finden Sie <strong class='text-white'>Templates</strong>, dort befinden sich sowohl die Speicher- als auch die Ladeoptionen." },
        { title: "Speichern Sie die Vorlage und benennen Sie sie", html: "Klicken Sie auf <strong class='text-white'>Save Template</strong> und geben Sie ihr einen Namen, den Sie später auch wirklich wiedererkennen, etwas wie <code>ES-scalp</code> oder <code>clean-chart</code> ist besser als \"Template 1.\" Bestätigen Sie, und Tradovate speichert Ihre Indikatoren und Ihr Erscheinungsbild unter diesem Namen. Speichern Sie mehrere davon für unterschiedliche Setups: einen reduzierten Chart fürs Scalping, einen umfangreicheren für den Swing-Kontext." },
        { title: "Laden Sie eine Vorlage auf einen beliebigen Chart", html: "Öffnen Sie einen beliebigen Chart, ein neues Symbol, ein zweites Fenster, was auch immer, und gehen Sie zurück zum Chart-Menü, dann zu <strong class='text-white'>Templates</strong>. Klicken Sie auf den Namen der gespeicherten Vorlage, und sie wird sofort angewendet, wobei Ihre Indikatoren und Ihr Erscheinungsbild augenblicklich übernommen werden. Das ist der eigentliche Gewinn: ein Klick, statt ein Dutzend Indikatoreinstellungen von Hand neu aufzubauen." },
        { title: "Lassen Sie neue Charts mit Ihrer Einrichtung öffnen (optional)", html: "Wenn Sie immer mit demselben Erscheinungsbild handeln, müssen Sie die Vorlage nicht jedes Mal von Hand neu laden. Eine gespeicherte Vorlage bleibt für jeden Chart im Templates-Menü erhalten, und Tradovate kann sie automatisch anwenden, sodass ein neuer Chart bereits mit Ihren Indikatoren geöffnet wird, statt mit einem leeren Candlestick-Chart. Achten Sie im Templates-Menü auf die Standard- oder Auto-Apply-Option, der genaue Wortlaut kann sich zwischen Plattform-Updates ändern, prüfen Sie ihn also in Ihrer Version." },
      ],
    },
    { type: "heading", text: "Templates vs. Workspaces im Überblick" },
    {
      type: "table",
      headers: ["Was Sie behalten möchten", "Vorlage speichern", "Workspace speichern"],
      rows: [
        ["Indikatoren und ihre Einstellungen", "Ja", "Ja"],
        ["Chart-Stil und Farben", "Ja", "Ja"],
        ["Trendlinien, Zonen, Zeichnungen", "Nein", "Ja"],
        ["DOM und Fensteranordnung", "Nein", "Ja"],
      ],
    },
    { type: "paragraph", html: "Kurz gesagt: Verwenden Sie eine Vorlage, wenn Sie einfach nur denselben Chart-Look über verschiedene Symbole hinweg möchten, und speichern Sie einen Workspace, wenn Sie möchten, dass Ihr gesamter Bildschirm, Charts, DOM und Zeichnungen, genau so zurückkehrt, wie Sie ihn verlassen haben." },
    { type: "heading", text: "Automatisieren Sie die Setups, die Sie erstellen" },
    { type: "paragraph", html: "Ein sauberer, wiederholbarer Chart ist nur die halbe Arbeit. Die andere Hälfte besteht darin, zu handeln, bevor Ihnen die Bewegung entgeht. <strong class='text-white'>PickMyTrade nimmt die Alerts, die Sie von Ihren TradingView-Charts auslösen, und leitet sie direkt als Live-Orders in Ihr Tradovate-Konto weiter</strong>, ohne Hektik, ohne manuelles Klicken. Bauen Sie den Chart auf, definieren Sie das Signal, und lassen Sie die Ausführung von selbst laufen." },
  ], es: [
    { type: "paragraph", html: "Configura el gráfico perfecto una sola vez, sus medias móviles, el VWAP, los colores que realmente le gustan, y luego abre un símbolo nuevo y vuelve a ser un gráfico de velas en blanco. Reconstruir esa configuración cada vez se vuelve tedioso rápidamente. Las plantillas de gráficos de Tradovate solucionan esto: guarde su configuración de indicadores y apariencia una sola vez, y luego aplíquela a cualquier gráfico en un par de clics. A continuación le mostramos cómo guardar una, cargarla y convertirla en su configuración predeterminada." },
    { type: "heading", text: "Qué guarda realmente una plantilla de gráfico" },
    { type: "paragraph", html: "Una plantilla de gráfico almacena lo que existe <em>en el propio gráfico</em>, sus indicadores y su configuración, además del estilo y la apariencia del gráfico. Lo que no guarda es igual de importante: no recordará su DOM, la disposición de sus ventanas, ni las líneas de tendencia y zonas que haya dibujado. Esas anotaciones dibujadas a mano y la disposición general de su pantalla pertenecen a un <strong class='text-white'>workspace</strong>, no a una plantilla. Así que piense en una plantilla como &ldquo;cómo se ve y se lee un solo gráfico&rdquo;, y en un workspace como &ldquo;toda mi pantalla de trading&rdquo;. Mantenga esa distinción clara y nunca se preguntará por qué una plantilla guardada aparece limpia pero sin sus líneas de soporte y resistencia." },
    { type: "heading", text: "Cómo guardar una plantilla de gráfico" },
    {
      type: "steps",
      items: [
        { title: "Configure primero el gráfico", html: "Antes de guardar nada, deje el gráfico exactamente como lo desea. Añada sus indicadores, ajuste la configuración de cada uno y defina el estilo y los colores del gráfico. Lo que esté en el gráfico cuando lo guarde es lo que la plantilla captura, así que un gráfico desordenado produce una plantilla desordenada." },
        { title: "Abra el menú del gráfico y elija Templates", html: "Coloque el cursor sobre el gráfico para que aparezca la barra de herramientas, y luego abra el botón de menú del gráfico en la barra de herramientas superior. En ese menú encontrará <strong class='text-white'>Templates</strong>, ahí es donde se encuentran tanto las opciones de guardar como de cargar." },
        { title: "Guarde la plantilla y asígnele un nombre", html: "Haga clic en <strong class='text-white'>Save Template</strong> y asígnele un nombre que reconocerá fácilmente más adelante, algo como <code>ES-scalp</code> o <code>clean-chart</code> es mejor que \"Template 1\". Confirme, y Tradovate almacenará sus indicadores y apariencia bajo ese nombre. Guarde varias de estas para distintas configuraciones: un gráfico minimalista para el scalping, uno más cargado para el contexto swing." },
        { title: "Cargue una plantilla en cualquier gráfico", html: "Abra cualquier gráfico, un símbolo nuevo, una segunda ventana, lo que sea, y vuelva al menú del gráfico, luego a <strong class='text-white'>Templates</strong>. Haga clic en el nombre de la plantilla guardada y se aplica de inmediato, sustituyendo sus indicadores y apariencia al instante. Ese es todo el beneficio: un clic en lugar de reconstruir a mano una decena de configuraciones de indicadores." },
        { title: "Haga que los gráficos nuevos se abran con su configuración (opcional)", html: "Si siempre opera con el mismo aspecto, no tiene que recargar la plantilla manualmente cada vez. Una plantilla guardada permanece en el menú Templates para cualquier gráfico, y Tradovate puede aplicarla automáticamente para que un gráfico nuevo se abra ya con sus indicadores en lugar de un simple gráfico de velas en blanco. Busque la opción predeterminada o de aplicación automática en el menú Templates; el texto exacto puede variar entre actualizaciones de la plataforma, así que confírmelo en su versión." },
      ],
    },
    { type: "heading", text: "Plantillas frente a workspaces de un vistazo" },
    {
      type: "table",
      headers: ["Lo que quiere conservar", "Guardar una plantilla", "Guardar un workspace"],
      rows: [
        ["Indicadores y su configuración", "Sí", "Sí"],
        ["Estilo y colores del gráfico", "Sí", "Sí"],
        ["Líneas de tendencia, zonas, dibujos", "No", "Sí"],
        ["DOM y disposición de ventanas", "No", "Sí"],
      ],
    },
    { type: "paragraph", html: "En resumen: use una plantilla cuando simplemente quiera el mismo aspecto de gráfico en distintos símbolos, y guarde un workspace cuando quiera que toda su pantalla, gráficos, DOM y dibujos, vuelva exactamente como la dejó." },
    { type: "heading", text: "Automatice las configuraciones que crea" },
    { type: "paragraph", html: "Un gráfico limpio y repetible es solo la mitad del trabajo. La otra mitad consiste en actuar sobre lo que le muestra antes de que el movimiento se le escape. <strong class='text-white'>PickMyTrade toma las alertas que dispara desde sus gráficos de TradingView y las dirige directamente a su cuenta de Tradovate como órdenes en vivo</strong>, sin apuros, sin clics manuales. Construya el gráfico, defina la señal y deje que la ejecución se realice sola." },
  ], fr: [
    { type: "paragraph", html: "Vous réglez le graphique parfait une seule fois, vos moyennes mobiles, le VWAP, les couleurs que vous aimez vraiment, puis vous ouvrez un nouveau symbole et c'est de nouveau un graphique en chandeliers vierge. Reconstruire cette configuration à chaque fois devient vite lassant. Les modèles de graphique de Tradovate résolvent ce problème : enregistrez votre configuration d'indicateurs et d'apparence une seule fois, puis appliquez-la à n'importe quel graphique en quelques clics. Voici comment en enregistrer un, le charger, et en faire votre configuration par défaut." },
    { type: "heading", text: "Ce qu'un modèle de graphique enregistre réellement" },
    { type: "paragraph", html: "Un modèle de graphique enregistre ce qui se trouve <em>sur le graphique lui-même</em>, vos indicateurs et leurs paramètres, ainsi que le style et l'apparence du graphique. Ce qu'il n'enregistre pas est tout aussi important : il ne mémorise pas votre DOM, la disposition de vos fenêtres, ni les lignes de tendance et zones que vous avez tracées. Ces annotations dessinées à la main et la disposition globale de votre écran appartiennent à un <strong class='text-white'>workspace</strong>, pas à un modèle. Pensez donc à un modèle comme &ldquo;l'apparence et la lecture d'un seul graphique&rdquo;, et à un workspace comme &ldquo;tout mon écran de trading&rdquo;. Gardez cette distinction claire et vous ne vous demanderez jamais pourquoi un modèle enregistré apparaît propre mais sans vos lignes de support et de résistance." },
    { type: "heading", text: "Comment enregistrer un modèle de graphique" },
    {
      type: "steps",
      items: [
        { title: "Configurez d'abord le graphique", html: "Avant d'enregistrer quoi que ce soit, configurez le graphique exactement comme vous le souhaitez. Ajoutez vos indicateurs, ajustez les paramètres de chacun, et définissez le style et les couleurs du graphique. Tout ce qui se trouve sur le graphique au moment de l'enregistrement est ce que le modèle capture, donc un graphique désordonné donne un modèle désordonné." },
        { title: "Ouvrez le menu du graphique et choisissez Templates", html: "Survolez le graphique pour faire apparaître la barre d'outils, puis ouvrez le bouton de menu du graphique dans la barre d'outils supérieure. Dans ce menu, vous trouverez <strong class='text-white'>Templates</strong>, c'est là que se trouvent les options d'enregistrement et de chargement." },
        { title: "Enregistrez le modèle et nommez-le", html: "Cliquez sur <strong class='text-white'>Save Template</strong> et donnez-lui un nom que vous reconnaîtrez vraiment plus tard, quelque chose comme <code>ES-scalp</code> ou <code>clean-chart</code> vaut mieux que &ldquo;Template 1&rdquo;. Confirmez, et Tradovate enregistre vos indicateurs et votre apparence sous ce nom. Enregistrez-en plusieurs pour différentes configurations : un graphique épuré pour le scalping, un autre plus chargé pour le contexte swing." },
        { title: "Chargez un modèle sur n'importe quel graphique", html: "Ouvrez n'importe quel graphique, un nouveau symbole, une deuxième fenêtre, peu importe, et retournez dans le menu du graphique, puis <strong class='text-white'>Templates</strong>. Cliquez sur le nom du modèle enregistré et il s'applique immédiatement, remplaçant vos indicateurs et votre apparence instantanément. C'est tout l'intérêt : un clic au lieu de reconstruire une dizaine de réglages d'indicateurs à la main." },
        { title: "Faites en sorte que les nouveaux graphiques s'ouvrent avec votre configuration (facultatif)", html: "Si vous tradez toujours avec la même configuration, vous n'avez pas besoin de recharger le modèle manuellement à chaque fois. Un modèle enregistré reste dans le menu Templates pour n'importe quel graphique, et Tradovate peut l'appliquer automatiquement afin qu'un nouveau graphique s'ouvre déjà avec vos indicateurs au lieu d'un simple graphique en chandeliers vierge. Recherchez l'option par défaut ou d'application automatique dans le menu Templates, le libellé exact peut varier selon les mises à jour de la plateforme, donc vérifiez-le dans votre version." },
      ],
    },
    { type: "heading", text: "Templates et workspaces en un coup d'œil" },
    {
      type: "table",
      headers: ["Ce que vous voulez conserver", "Enregistrer un modèle", "Enregistrer un workspace"],
      rows: [
        ["Indicateurs et leurs paramètres", "Oui", "Oui"],
        ["Style et couleurs du graphique", "Oui", "Oui"],
        ["Lignes de tendance, zones, dessins", "Non", "Oui"],
        ["DOM et disposition des fenêtres", "Non", "Oui"],
      ],
    },
    { type: "paragraph", html: "En résumé : utilisez un modèle lorsque vous voulez simplement conserver la même apparence de graphique sur différents symboles, et enregistrez un workspace lorsque vous voulez que tout votre écran, graphiques, DOM et dessins, revienne exactement comme vous l'avez laissé." },
    { type: "heading", text: "Automatisez les configurations que vous créez" },
    { type: "paragraph", html: "Un graphique propre et reproductible n'est que la moitié du travail. L'autre moitié consiste à agir sur ce qu'il vous montre avant que le mouvement ne vous échappe. <strong class='text-white'>PickMyTrade récupère les alertes que vous déclenchez depuis vos graphiques TradingView et les achemine directement vers votre compte Tradovate sous forme d'ordres en direct</strong>, sans précipitation, sans clic manuel. Construisez le graphique, définissez le signal, et laissez l'exécution se faire toute seule." },
  ], it: [
    { type: "paragraph", html: "Si configura il grafico perfetto una volta sola, le medie mobili, il VWAP, i colori che si preferiscono davvero, e poi si apre un nuovo simbolo e ci si ritrova di nuovo con un grafico a candele vuoto. Ricostruire quella configurazione ogni volta diventa presto stancante. I modelli di grafico di Tradovate risolvono il problema: si salva la configurazione di indicatori e aspetto una sola volta, poi la si applica a qualsiasi grafico in un paio di clic. Ecco come salvarne uno, caricarlo e renderlo predefinito." },
    { type: "heading", text: "Cosa salva davvero un modello di grafico" },
    { type: "paragraph", html: "Un modello di grafico salva ciò che vive <em>sul grafico stesso</em>, gli indicatori e le relative impostazioni, oltre allo stile e all'aspetto del grafico. Ciò che non salva è altrettanto importante: non ricorda il DOM, la disposizione delle finestre né le trendline e le zone disegnate. Quei tracciati manuali e la disposizione generale dello schermo appartengono a un <strong class='text-white'>workspace</strong>, non a un modello. Quindi pensi a un modello come a &ldquo;come appare e si legge un singolo grafico&rdquo;, e a un workspace come a &ldquo;l'intera schermata di trading&rdquo;. Tenga questa distinzione chiara e non si chiederà mai perché un modello salvato appare pulito ma senza le linee di supporto e resistenza." },
    { type: "heading", text: "Come salvare un modello di grafico" },
    {
      type: "steps",
      items: [
        { title: "Configuri prima il grafico", html: "Prima di salvare qualsiasi cosa, porti il grafico esattamente come lo desidera. Aggiunga i suoi indicatori, regoli le impostazioni di ciascuno e imposti lo stile e i colori del grafico. Tutto ciò che si trova sul grafico al momento del salvataggio è ciò che il modello acquisisce, quindi un grafico disordinato produce un modello disordinato." },
        { title: "Apra il menu del grafico e selezioni Templates", html: "Passi con il mouse sul grafico in modo che compaia la barra degli strumenti, quindi apra il pulsante del menu del grafico nella barra degli strumenti superiore. In quel menu troverà <strong class='text-white'>Templates</strong>, è lì che si trovano sia le opzioni di salvataggio che di caricamento." },
        { title: "Salvi il modello e gli assegni un nome", html: "Clicchi su <strong class='text-white'>Save Template</strong> e gli assegni un nome che riconoscerà facilmente in seguito, qualcosa come <code>ES-scalp</code> o <code>clean-chart</code> è meglio di &ldquo;Template 1&rdquo;. Confermi, e Tradovate memorizza i suoi indicatori e il suo aspetto sotto quel nome. Ne salvi alcuni per configurazioni diverse: un grafico essenziale per lo scalping, uno più ricco per il contesto di swing." },
        { title: "Carichi un modello su qualsiasi grafico", html: "Apra un grafico qualsiasi, un nuovo simbolo, una seconda finestra, quello che vuole, e torni al menu del grafico, poi su <strong class='text-white'>Templates</strong>. Clicchi sul nome del modello salvato e viene applicato immediatamente, sostituendo all'istante i suoi indicatori e il suo aspetto. Questo è il vero vantaggio: un solo clic invece di ricostruire a mano una dozzina di impostazioni degli indicatori." },
        { title: "Faccia aprire i nuovi grafici già con la sua configurazione (opzionale)", html: "Se fa sempre trading con lo stesso aspetto, non deve ricaricare il modello a mano ogni volta. Un modello salvato resta nel menu Templates per qualsiasi grafico, e Tradovate può applicarlo automaticamente in modo che un nuovo grafico si apra già con i suoi indicatori invece che con un semplice grafico a candele vuoto. Cerchi l'opzione predefinita o di applicazione automatica nel menu Templates, la formulazione esatta può cambiare tra un aggiornamento e l'altro della piattaforma, quindi la verifichi nella sua versione." },
      ],
    },
    { type: "heading", text: "Templates e Workspace a colpo d'occhio" },
    {
      type: "table",
      headers: ["Cosa si vuole conservare", "Salvare un modello", "Salvare un workspace"],
      rows: [
        ["Indicatori e relative impostazioni", "Sì", "Sì"],
        ["Stile e colori del grafico", "Sì", "Sì"],
        ["Trendline, zone, disegni", "No", "Sì"],
        ["DOM e disposizione delle finestre", "No", "Sì"],
      ],
    },
    { type: "paragraph", html: "In sintesi: usi un modello quando vuole semplicemente lo stesso aspetto del grafico su più simboli, e salvi un workspace quando vuole che l'intera schermata, grafici, DOM e disegni, torni esattamente come l'ha lasciata." },
    { type: "heading", text: "Automatizzi le configurazioni che crea" },
    { type: "paragraph", html: "Un grafico pulito e ripetibile è solo metà del lavoro. L'altra metà consiste nell'agire su ciò che mostra prima che il movimento sfugga. <strong class='text-white'>PickMyTrade prende gli alert generati dai suoi grafici TradingView e li instrada direttamente nel suo account Tradovate come ordini live</strong>, senza fretta, senza clic manuali. Costruisca il grafico, definisca il segnale e lasci che l'esecuzione avvenga da sola." },
  ] },
  ctaHeading: { en: "Automate the Setups You Build", de: "Automatisieren Sie die Setups, die Sie erstellen", es: "Automatice las configuraciones que crea", fr: "Automatisez les configurations que vous créez", it: "Automatizzi le configurazioni che crea" },
  ctaText: { en: "A clean, repeatable chart is only half the job. Let PickMyTrade route your TradingView alerts straight into your Tradovate account as live orders.", de: "Ein sauberer, wiederholbarer Chart ist nur die halbe Arbeit. Lassen Sie PickMyTrade Ihre TradingView-Alerts direkt als Live-Orders in Ihr Tradovate-Konto weiterleiten.", es: "Un gráfico limpio y repetible es solo la mitad del trabajo. Deje que PickMyTrade dirija sus alertas de TradingView directamente a su cuenta de Tradovate como órdenes en vivo.", fr: "Un graphique propre et reproductible n'est que la moitié du travail. Laissez PickMyTrade acheminer vos alertes TradingView directement vers votre compte Tradovate sous forme d'ordres en direct.", it: "Un grafico pulito e ripetibile è solo metà del lavoro. Lasci che PickMyTrade instradi i suoi alert TradingView direttamente nel suo account Tradovate come ordini live." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 5-Tage-Testversion", es: "Comience su prueba gratuita de 5 días", fr: "Démarrez votre essai gratuit de 5 jours", it: "Inizi la Prova Gratuita di 5 Giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande Frequenti" },
  faqs: { en: [
    { q: "Why isn't my template saving my trendlines?", a: "Because drawings aren't part of a template, they're tied to the workspace. If you need your zones and support-and-resistance lines to come back, save a workspace instead of (or in addition to) the template." },
    { q: "Can I use a template on a different symbol?", a: "Yes. That's the point. A template stores the indicators and appearance, not the symbol, so you can load the same setup onto ES, NQ, CL, or anything else and keep a consistent read across markets." },
    { q: "Do templates carry over to the mobile app?", a: "Don't assume they do. Chart templates are tied to where you build them, and the exact syncing behavior can change between platform updates, so confirm the current behavior in the Tradovate app before you rely on a web template showing up on mobile." },
  ], de: [
    { q: "Warum speichert meine Vorlage meine Trendlinien nicht?", a: "Weil Zeichnungen nicht Teil einer Vorlage sind, sie sind an den Workspace gebunden. Wenn Ihre Zonen und Unterstützungs-/Widerstandslinien wiederkehren sollen, speichern Sie stattdessen (oder zusätzlich) einen Workspace." },
    { q: "Kann ich eine Vorlage auf ein anderes Symbol anwenden?", a: "Ja. Genau das ist der Sinn der Sache. Eine Vorlage speichert die Indikatoren und das Erscheinungsbild, nicht das Symbol, sodass Sie dieselbe Einrichtung auf ES, NQ, CL oder alles andere laden und über verschiedene Märkte hinweg ein konsistentes Bild behalten können." },
    { q: "Werden Vorlagen in die mobile App übernommen?", a: "Gehen Sie nicht einfach davon aus. Chart-Vorlagen sind an den Ort gebunden, an dem Sie sie erstellen, und das genaue Synchronisierungsverhalten kann sich zwischen Plattform-Updates ändern. Prüfen Sie daher das aktuelle Verhalten in der Tradovate-App, bevor Sie sich darauf verlassen, dass eine Web-Vorlage auch auf Mobilgeräten erscheint." },
  ], es: [
    { q: "¿Por qué mi plantilla no guarda mis líneas de tendencia?", a: "Porque los dibujos no forman parte de una plantilla, están vinculados al workspace. Si necesita que sus zonas y líneas de soporte y resistencia vuelvan a aparecer, guarde un workspace en lugar de (o además de) la plantilla." },
    { q: "¿Puedo usar una plantilla en un símbolo distinto?", a: "Sí. Ese es precisamente el objetivo. Una plantilla almacena los indicadores y la apariencia, no el símbolo, así que puede cargar la misma configuración en ES, NQ, CL o cualquier otro y mantener una lectura coherente entre mercados." },
    { q: "¿Las plantillas se trasladan a la aplicación móvil?", a: "No dé eso por sentado. Las plantillas de gráficos están vinculadas al lugar donde las crea, y el comportamiento exacto de sincronización puede cambiar entre actualizaciones de la plataforma, así que confirme el comportamiento actual en la aplicación de Tradovate antes de confiar en que una plantilla web aparezca en el móvil." },
  ], fr: [
    { q: "Pourquoi mon modèle n'enregistre-t-il pas mes lignes de tendance ?", a: "Parce que les dessins ne font pas partie d'un modèle ; ils sont liés au workspace. Si vous avez besoin de retrouver vos zones et vos lignes de support et de résistance, enregistrez un workspace au lieu du modèle (ou en plus de celui-ci)." },
    { q: "Puis-je utiliser un modèle sur un autre symbole ?", a: "Oui. C'est justement l'intérêt. Un modèle enregistre les indicateurs et l'apparence, pas le symbole, vous pouvez donc charger la même configuration sur ES, NQ, CL ou tout autre instrument et conserver une lecture cohérente sur tous les marchés." },
    { q: "Les modèles se retrouvent-ils dans l'application mobile ?", a: "Ne présumez pas que c'est le cas. Les modèles de graphique sont liés à l'endroit où vous les créez, et le comportement exact de synchronisation peut changer selon les mises à jour de la plateforme ; vérifiez donc le comportement actuel dans l'application Tradovate avant de compter sur l'apparition d'un modèle web sur mobile." },
  ], it: [
    { q: "Perché il mio modello non salva le trendline?", a: "Perché i disegni non fanno parte di un modello, sono legati al workspace. Se ha bisogno che le sue zone e linee di supporto e resistenza tornino, salvi un workspace invece del (o in aggiunta al) modello." },
    { q: "Posso usare un modello su un simbolo diverso?", a: "Sì. È proprio questo il punto. Un modello memorizza gli indicatori e l'aspetto, non il simbolo, quindi può caricare la stessa configurazione su ES, NQ, CL o qualsiasi altro strumento e mantenere una lettura coerente tra i mercati." },
    { q: "I modelli vengono trasferiti nell'app mobile?", a: "Non lo dia per scontato. I modelli di grafico sono legati al luogo in cui vengono creati, e il comportamento esatto di sincronizzazione può cambiare tra un aggiornamento e l'altro della piattaforma, quindi verifichi il comportamento attuale nell'app Tradovate prima di fare affidamento sul fatto che un modello web compaia anche su mobile." },
  ] },
  relatedHeading: { en: "Related Guides", de: "Verwandte Anleitungen", es: "Guías relacionadas", fr: "Guides connexes", it: "Guide Correlate" },
  disclosureText: { en: `This guide is for educational and informational purposes only and is not financial, investment, or trading advice. Trading futures and other leveraged products carries a substantial risk of loss and is not suitable for every investor. PickMyTrade is an independent third-party automation platform and is not affiliated with, endorsed by, or sponsored by Tradovate, Inc. "Tradovate" and all related names, logos, and trademarks are the property of their respective owners. Platform features and steps change over time, so always confirm the current process in the official Tradovate platform and documentation before acting.`, de: `Dieser Leitfaden dient ausschließlich Bildungs- und Informationszwecken und stellt keine Finanz-, Anlage- oder Handelsberatung dar. Der Handel mit Futures und anderen gehebelten Produkten birgt ein erhebliches Verlustrisiko und ist nicht für jeden Anleger geeignet. PickMyTrade ist eine unabhängige Automatisierungsplattform eines Drittanbieters und steht in keiner Verbindung zu Tradovate, Inc. und wird von diesem Unternehmen weder unterstützt noch gesponsert. "Tradovate" und alle zugehörigen Namen, Logos und Marken sind Eigentum ihrer jeweiligen Inhaber. Funktionen und Abläufe der Plattform ändern sich im Laufe der Zeit, bestätigen Sie daher vor dem Handeln stets den aktuellen Prozess auf der offiziellen Tradovate-Plattform und in der Dokumentation.`, es: `Esta guía tiene fines educativos e informativos únicamente y no constituye asesoramiento financiero, de inversión o de trading. Operar futuros y otros productos apalancados conlleva un riesgo sustancial de pérdida y no es adecuado para todos los inversores. PickMyTrade es una plataforma de automatización independiente de terceros y no está afiliada, avalada ni patrocinada por Tradovate, Inc. "Tradovate" y todos los nombres, logotipos y marcas relacionados son propiedad de sus respectivos dueños. Las funciones y los pasos de la plataforma cambian con el tiempo, así que confirme siempre el proceso actual en la plataforma y la documentación oficiales de Tradovate antes de actuar.`, fr: `Ce guide est fourni à titre éducatif et informatif uniquement et ne constitue pas un conseil financier, d'investissement ou de trading. Le trading de contrats à terme et d'autres produits à effet de levier comporte un risque de perte substantiel et ne convient pas à tous les investisseurs. PickMyTrade est une plateforme d'automatisation tierce indépendante et n'est affiliée à, approuvée par, ni sponsorisée par Tradovate, Inc. "Tradovate" ainsi que tous les noms, logos et marques associés sont la propriété de leurs détenteurs respectifs. Les fonctionnalités et étapes de la plateforme évoluent avec le temps ; vérifiez donc toujours le processus actuel dans la plateforme et la documentation officielles de Tradovate avant d'agir.`, it: `Questa guida è fornita esclusivamente a scopo educativo e informativo e non costituisce consulenza finanziaria, di investimento o di trading. Il trading di futures e altri prodotti a leva comporta un rischio sostanziale di perdita e non è adatto a tutti gli investitori. PickMyTrade è una piattaforma di automazione indipendente di terze parti e non è affiliata, approvata o sponsorizzata da Tradovate, Inc. "Tradovate" e tutti i nomi, loghi e marchi correlati sono di proprietà dei rispettivi titolari. Le funzionalità e i passaggi della piattaforma cambiano nel tempo, quindi verifichi sempre la procedura attuale sulla piattaforma e nella documentazione ufficiale di Tradovate prima di agire.` },
};
const data: GuideArticleData = resolveGuideContent(content, locale, related);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: data.faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}${withSlash(localizedPath(locale))}` },
    { "@type": "ListItem", position: 2, name: "How-To", item: `${SITE_URL}${withSlash(localizedPath(locale, "how-to"))}` },
    { "@type": "ListItem", position: 3, name: content.h1[locale], item: `${SITE_URL}${withSlash(localizedPath(locale, `how-to/${SLUG}`))}` },
  ],
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: content.h1[locale],
  description: content.dek[locale],
  image: `${SITE_URL}/assets/og-default.webp`,
  publisher: { "@type": "Organization", name: "PickMyTrade", logo: { "@type": "ImageObject", url: `${SITE_URL}/assets/logo.png` } },
  datePublished: "2026-07-08",
  dateModified: "2026-07-08",
  mainEntityOfPage: { "@type": "WebPage", "@id": `${SITE_URL}${withSlash(localizedPath(locale, `how-to/${SLUG}`))}` },
};
---

<BaseLayout
  locale={locale}
