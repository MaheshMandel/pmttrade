---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-performance-center";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Read the Tradovate Performance Center Module";
const META_DESCRIPTION =
  "See your Performance Center session P&L, filter stats by contract, toggle widgets, and open the full performance report for historical trade results.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Das Tradovate-Modul Performance Center lesen", es: "Cómo leer el módulo Performance Center de Tradovate", fr: "Lire le module Performance Center de Tradovate", it: "Leggere il modulo Performance Center di Tradovate" },
  dek: { en: "The Performance Center is Tradovate's live scoreboard. It sits in your workspace and tallies how the current session is going, running P&L, contract by contract, before and after commissions.", de: "Das Performance Center ist die Live-Anzeigetafel von Tradovate. Es sitzt in Ihrem Workspace und fasst zusammen, wie die aktuelle Sitzung läuft: laufender P&L, Kontrakt für Kontrakt, vor und nach Provisionen.", es: "El Performance Center es el marcador en vivo de Tradovate. Se sitúa en su espacio de trabajo y contabiliza cómo va la sesión actual: P&L acumulado, contrato por contrato, antes y después de comisiones.", fr: "Le Performance Center est le tableau d’affichage en direct de Tradovate. Il se place dans votre espace de travail et totalise le déroulement de la séance en cours : P&L cumulé, contrat par contrat, avant et après commissions.", it: "Il Performance Center è il tabellone in tempo reale di Tradovate. Si trova nel Suo workspace e riepiloga l’andamento della sessione corrente: P&L progressivo, contratto per contratto, prima e dopo le commissioni." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "The Performance Center is Tradovate's live scoreboard. It sits in your workspace and tallies how the current session is going, running P&amp;L, contract by contract, before and after commissions. Keep it open next to your DOM and you always know where you stand before you take the next trade." },
    { type: "paragraph", html: "One thing to get straight up front: this module tracks the <strong class='text-white'>current session only</strong>. It resets when the session rolls over. For anything older, last week, last month, a full statement, you jump to the Performance Report, and there's a link right inside the module that takes you there. Here's how to set it up and read it." },
    { type: "heading", text: "What the Performance Center Shows" },
    { type: "paragraph", html: "Once it's open, you're looking at session-level stats for the account you've selected:" },
    {
      type: "list",
      items: [
        "Running <strong class='text-white'>realized and open P&amp;L</strong> for the session, per account and per contract.",
        "The same figures <strong class='text-white'>with and without commissions and fees</strong>, so you can see your trading cost at a glance.",
        "A <strong class='text-white'>chronological P&amp;L history</strong> that shows how the number moved as the session played out.",
      ],
    },
    { type: "paragraph", html: "The widgets are configurable, so your layout may show more or fewer panels than the next trader's. That's expected, you decide what stays on screen." },
    { type: "heading", text: "Set It Up in Five Steps" },
    {
      type: "steps",
      items: [
        { title: "Add the Performance Center to Your Workspace", html: "Open the Workspace Manager and add the Performance Center module, drag it in, or pick it from the module list. It docks like any other panel, so park it beside your chart or DOM where you'll actually glance at it.", image: { src: `${IMG}/tradovate-performance-center-1.png`, alt: "Adding the Performance Center module from the Tradovate Workspace Manager" } },
        { title: "Filter by Account or a Single Contract", html: "Click the module's tab and type a contract symbol, say ES or NQ, to narrow the stats to that instrument. Clear the symbol and you're back to every contract on the account. Trading more than one account? Use color linking to tie the module to the account (or Quote Board) you want it to follow.", image: { src: `${IMG}/tradovate-performance-center-2.png`, alt: "Filtering Performance Center stats by typing a contract symbol in the module tab" } },
        { title: "Choose Which Widgets You See", html: "Hit the gear in the module's top-right corner to open its View Settings. Toggle panels on or off, the P&amp;L history, the totals, the commission-adjusted figures, until the layout shows only what you watch during a session. Less clutter, faster reads.", image: { src: `${IMG}/tradovate-performance-center-3.png`, alt: "Toggling Performance Center widgets on and off in the View Settings gear menu" } },
        { title: "Read the Session P&L", html: "Now read the numbers. You get two versions of P&amp;L: gross (before costs) and net (after commissions and fees). The gap between them is your cost of doing business for the session, worth a look if you're scalping size. The chronological view tells the story behind the total: whether you gave back an early gain or ground it out late.", image: { src: `${IMG}/tradovate-performance-center-4.png`, alt: "Reading gross and net session P&L figures in the Tradovate Performance Center" } },
        { title: "Open the Full Performance Report for History", html: "Because the module is session-only, older data lives elsewhere. Click the report link inside the Performance Center to open the Performance Report in the Account Reports area. Pick a range, Today, This Week, This Month, or a custom From/To, click Go, and you'll see overall P&amp;L, trade count, win rate, drawdown and run-up for that window. Export it to CSV or PDF for your journal or your accountant.", image: { src: `${IMG}/tradovate-performance-center-5.png`, alt: "Opening the Performance Report from the Performance Center to view historical stats" } },
      ],
    },
    { type: "heading", text: "Session Stats vs. the Full Report" },
    {
      type: "table",
      headers: ["", "Performance Center", "Performance Report"],
      rows: [
        ["Time span", "Current session only", "Any date range you pick"],
        ["Best for", "Live, in-the-moment tracking", "Review, journaling, taxes"],
        ["Where it lives", "Docked in your workspace", "Account Reports area"],
        ["Export", "On-screen only", "CSV / PDF download"],
      ],
    },
    { type: "paragraph", html: "Trading a prop or evaluation account? Some stats and data feeds are switched on by your firm, not by you, and the limits behind them vary by firm and account size. If a figure looks off or a panel is empty, check your firm's current rules before assuming it's a platform bug." },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "If you're firing entries and exits from TradingView, keeping the Performance Center open is the fastest way to confirm your automation's fills match your plan. <strong class='text-white'>PickMyTrade automates your Tradovate trading</strong> so you can spend that screen time reviewing results instead of clicking orders." },
  ], de: [
    { type: "paragraph",html: "Das Performance Center ist die Live-Anzeigetafel von Tradovate. Es sitzt in Ihrem Workspace und fasst zusammen, wie die aktuelle Sitzung läuft: laufender P&amp;L, Kontrakt für Kontrakt, vor und nach Provisionen. Halten Sie es neben Ihrem DOM geöffnet, und Sie wissen immer, wo Sie stehen, bevor Sie den nächsten Trade eingehen." },
    { type: "paragraph",html: "Eines vorab: Dieses Modul erfasst <strong class='text-white'>nur die aktuelle Sitzung</strong>. Es wird zurückgesetzt, wenn die Sitzung wechselt. Für ältere Daten, etwa die letzte Woche, den letzten Monat oder einen vollständigen Kontoauszug, wechseln Sie zum Performance Report; ein Link direkt im Modul führt Sie dorthin. So richten Sie es ein und lesen es." },
    { type: "heading",text: "Was das Performance Center anzeigt" },
    { type: "paragraph",html: "Sobald es geöffnet ist, sehen Sie Statistiken auf Sitzungsebene für das ausgewählte Konto:" },
    {
      type: "list",
      items: [
        "Laufender <strong class='text-white'>realisierter und offener P&amp;L</strong> der Sitzung, pro Konto und pro Kontrakt.",
        "Dieselben Zahlen <strong class='text-white'>mit und ohne Provisionen und Gebühren</strong>, sodass Sie Ihre Handelskosten auf einen Blick sehen.",
        "Eine <strong class='text-white'>chronologische P&amp;L-Historie</strong>, die zeigt, wie sich die Zahl im Laufe der Sitzung entwickelt hat.",
      ],
    },
    { type: "paragraph",html: "Die Widgets sind konfigurierbar, daher kann Ihr Layout mehr oder weniger Panels zeigen als das eines anderen Traders. Das ist so vorgesehen: Sie entscheiden, was auf dem Bildschirm bleibt." },
    { type: "heading",text: "In fünf Schritten einrichten" },
    {
      type: "steps",
      items: [
        { title: "Performance Center zu Ihrem Workspace hinzufügen", html: "Öffnen Sie den Workspace Manager und fügen Sie das Modul Performance Center hinzu, ziehen Sie es hinein oder wählen Sie es aus der Modulliste. Es dockt wie jedes andere Panel an, platzieren Sie es also neben Ihrem Chart oder DOM, wo Sie tatsächlich hinsehen.", image: {"src":`${IMG}/tradovate-performance-center-1.png`,"alt":"Hinzufügen des Moduls Performance Center über den Tradovate Workspace Manager"} },
        { title: "Nach Konto oder einzelnem Kontrakt filtern", html: "Klicken Sie auf den Tab des Moduls und geben Sie ein Kontraktsymbol ein, etwa ES oder NQ, um die Statistiken auf dieses Instrument einzugrenzen. Löschen Sie das Symbol, sehen Sie wieder alle Kontrakte des Kontos. Handeln Sie mit mehr als einem Konto? Nutzen Sie die Farbverknüpfung, um das Modul an das Konto (oder das Quote Board) zu binden, dem es folgen soll.", image: {"src":`${IMG}/tradovate-performance-center-2.png`,"alt":"Filtern der Performance-Center-Statistiken durch Eingabe eines Kontraktsymbols im Modul-Tab"} },
        { title: "Auswählen, welche Widgets Sie sehen", html: "Klicken Sie auf das Zahnrad oben rechts im Modul, um die View Settings zu öffnen. Schalten Sie Panels ein oder aus, etwa die P&amp;L-Historie, die Summen oder die um Provisionen bereinigten Zahlen, bis das Layout nur das zeigt, was Sie während einer Sitzung beobachten. Weniger Unordnung, schnelleres Ablesen.", image: {"src":`${IMG}/tradovate-performance-center-3.png`,"alt":"Ein- und Ausschalten von Performance-Center-Widgets im Zahnradmenü der View Settings"} },
        { title: "Den Sitzungs-P&L lesen", html: "Jetzt lesen Sie die Zahlen. Sie erhalten zwei Versionen des P&amp;L: brutto (vor Kosten) und netto (nach Provisionen und Gebühren). Die Differenz ist Ihr Kostenaufwand für die Sitzung, was einen Blick wert ist, wenn Sie große Größen scalpen. Die chronologische Ansicht erzählt die Geschichte hinter der Summe: ob Sie einen frühen Gewinn wieder abgegeben oder ihn spät erarbeitet haben.", image: {"src":`${IMG}/tradovate-performance-center-4.png`,"alt":"Ablesen von Brutto- und Netto-Sitzungs-P&L im Tradovate Performance Center"} },
        { title: "Den vollständigen Performance Report für die Historie öffnen", html: "Da das Modul nur die Sitzung erfasst, liegen ältere Daten woanders. Klicken Sie auf den Report-Link im Performance Center, um den Performance Report im Bereich Account Reports zu öffnen. Wählen Sie einen Zeitraum, Today, This Week, This Month oder ein benutzerdefiniertes From/To, klicken Sie auf Go, und Sie sehen den Gesamt-P&amp;L, die Anzahl der Trades, die Trefferquote, den Drawdown und den Run-up für diesen Zeitraum. Exportieren Sie ihn als CSV oder PDF für Ihr Journal oder Ihren Steuerberater.", image: {"src":`${IMG}/tradovate-performance-center-5.png`,"alt":"Öffnen des Performance Report aus dem Performance Center, um historische Statistiken anzuzeigen"} },
      ],
    },
    { type: "heading",text: "Sitzungsstatistiken im Vergleich zum vollständigen Report" },
    { type: "table", headers: ["","Performance Center","Performance Report"], rows: [
      ["Zeitspanne","Nur aktuelle Sitzung","Jeder von Ihnen gewählte Zeitraum"],
      ["Am besten für","Live-Verfolgung im Moment","Auswertung, Journal, Steuern"],
      ["Wo es sich befindet","In Ihrem Workspace angedockt","Bereich Account Reports"],
      ["Export","Nur auf dem Bildschirm","CSV-/PDF-Download"],
    ] },
    { type: "paragraph",html: "Handeln Sie ein Prop- oder Evaluierungskonto? Einige Statistiken und Datenfeeds werden von Ihrer Firma aktiviert, nicht von Ihnen, und die dahinterstehenden Limits variieren je nach Firma und Kontogröße. Wenn eine Zahl seltsam aussieht oder ein Panel leer ist, prüfen Sie die aktuellen Regeln Ihrer Firma, bevor Sie einen Plattformfehler vermuten." },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "Wenn Sie Ein- und Ausstiege aus TradingView auslösen, ist ein geöffnetes Performance Center der schnellste Weg, um zu bestätigen, dass die Ausführungen Ihrer Automatisierung zu Ihrem Plan passen. <strong class='text-white'>PickMyTrade automatisiert Ihren Tradovate-Handel</strong>, sodass Sie diese Bildschirmzeit für die Auswertung Ihrer Ergebnisse nutzen können, statt Orders zu klicken." },
  ], es: [
    { type: "paragraph",html: "El Performance Center es el marcador en vivo de Tradovate. Se sitúa en su espacio de trabajo y contabiliza cómo va la sesión actual: P&amp;L acumulado, contrato por contrato, antes y después de comisiones. Manténgalo abierto junto a su DOM y siempre sabrá dónde está antes de realizar la siguiente operación." },
    { type: "paragraph",html: "Una cosa que conviene aclarar desde el principio: este módulo registra <strong class='text-white'>solo la sesión actual</strong>. Se reinicia cuando cambia la sesión. Para cualquier dato anterior, la semana pasada, el mes pasado o un extracto completo, debe ir al Performance Report, y dentro del módulo hay un enlace que le lleva allí. Así se configura y se lee." },
    { type: "heading",text: "Qué muestra el Performance Center" },
    { type: "paragraph",html: "Una vez abierto, verá estadísticas a nivel de sesión de la cuenta que haya seleccionado:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>P&amp;L realizado y abierto</strong> acumulado de la sesión, por cuenta y por contrato.",
        "Las mismas cifras <strong class='text-white'>con y sin comisiones y tarifas</strong>, para que vea de un vistazo su coste de operar.",
        "Un <strong class='text-white'>historial cronológico de P&amp;L</strong> que muestra cómo se movió la cifra a lo largo de la sesión.",
      ],
    },
    { type: "paragraph",html: "Los widgets son configurables, así que su diseño puede mostrar más o menos paneles que el de otro trader. Es lo esperado: usted decide qué permanece en pantalla." },
    { type: "heading",text: "Configúrelo en cinco pasos" },
    {
      type: "steps",
      items: [
        { title: "Añada el Performance Center a su espacio de trabajo", html: "Abra el Workspace Manager y añada el módulo Performance Center: arrástrelo o elíjalo en la lista de módulos. Se acopla como cualquier otro panel, así que colóquelo junto a su gráfico o DOM, donde realmente vaya a mirarlo.", image: {"src":`${IMG}/tradovate-performance-center-1.png`,"alt":"Añadir el módulo Performance Center desde el Workspace Manager de Tradovate"} },
        { title: "Filtre por cuenta o por un solo contrato", html: "Haga clic en la pestaña del módulo y escriba un símbolo de contrato, por ejemplo ES o NQ, para limitar las estadísticas a ese instrumento. Borre el símbolo y volverá a ver todos los contratos de la cuenta. ¿Opera con más de una cuenta? Utilice el enlace por color para vincular el módulo a la cuenta (o al Quote Board) que quiera que siga.", image: {"src":`${IMG}/tradovate-performance-center-2.png`,"alt":"Filtrado de las estadísticas del Performance Center escribiendo un símbolo de contrato en la pestaña del módulo"} },
        { title: "Elija qué widgets ver", html: "Pulse el engranaje en la esquina superior derecha del módulo para abrir sus View Settings. Active o desactive paneles, el historial de P&amp;L, los totales, las cifras ajustadas por comisiones, hasta que el diseño muestre solo lo que usted vigila durante una sesión. Menos desorden, lecturas más rápidas.", image: {"src":`${IMG}/tradovate-performance-center-3.png`,"alt":"Activación y desactivación de widgets del Performance Center en el menú de engranaje de View Settings"} },
        { title: "Lea el P&L de la sesión", html: "Ahora lea las cifras. Obtiene dos versiones del P&amp;L: bruto (antes de costes) y neto (después de comisiones y tarifas). La diferencia es su coste de operar en la sesión, algo que conviene mirar si hace scalping con tamaño. La vista cronológica cuenta la historia detrás del total: si devolvió una ganancia temprana o la fue sacando poco a poco al final.", image: {"src":`${IMG}/tradovate-performance-center-4.png`,"alt":"Lectura de las cifras de P&L bruto y neto de la sesión en el Performance Center de Tradovate"} },
        { title: "Abra el Performance Report completo para el historial", html: "Como el módulo solo abarca la sesión, los datos anteriores están en otro sitio. Haga clic en el enlace del informe dentro del Performance Center para abrir el Performance Report en el área Account Reports. Elija un rango, Today, This Week, This Month o un From/To personalizado, haga clic en Go y verá el P&amp;L total, el número de operaciones, el porcentaje de acierto, el drawdown y el run-up de ese periodo. Expórtelo a CSV o PDF para su diario o para su asesor fiscal.", image: {"src":`${IMG}/tradovate-performance-center-5.png`,"alt":"Apertura del Performance Report desde el Performance Center para ver estadísticas históricas"} },
      ],
    },
    { type: "heading",text: "Estadísticas de sesión frente al informe completo" },
    { type: "table", headers: ["","Performance Center","Performance Report"], rows: [
      ["Periodo","Solo la sesión actual","Cualquier rango de fechas que elija"],
      ["Ideal para","Seguimiento en vivo, en el momento","Revisión, diario, impuestos"],
      ["Dónde se encuentra","Acoplado en su espacio de trabajo","Área Account Reports"],
      ["Exportación","Solo en pantalla","Descarga en CSV / PDF"],
    ] },
    { type: "paragraph",html: "¿Opera una cuenta prop o de evaluación? Algunas estadísticas y feeds de datos los activa su firma, no usted, y los límites que hay detrás varían según la firma y el tamaño de la cuenta. Si una cifra parece rara o un panel está vacío, consulte las reglas vigentes de su firma antes de suponer que es un fallo de la plataforma." },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Si lanza entradas y salidas desde TradingView, mantener abierto el Performance Center es la forma más rápida de confirmar que las ejecuciones de su automatización coinciden con su plan. <strong class='text-white'>PickMyTrade automatiza su trading en Tradovate</strong> para que usted dedique ese tiempo de pantalla a revisar resultados en lugar de hacer clic en órdenes." },
  ], fr: [
    { type: "paragraph",html: "Le Performance Center est le tableau d’affichage en direct de Tradovate. Il se place dans votre espace de travail et totalise le déroulement de la séance en cours : P&amp;L cumulé, contrat par contrat, avant et après commissions. Gardez-le ouvert à côté de votre DOM et vous savez toujours où vous en êtes avant de prendre la prochaine position." },
    { type: "paragraph",html: "Un point à clarifier dès le départ : ce module suit <strong class='text-white'>uniquement la séance en cours</strong>. Il est réinitialisé au changement de séance. Pour toute donnée plus ancienne, la semaine dernière, le mois dernier ou un relevé complet, vous passez par le Performance Report, et un lien directement dans le module vous y conduit. Voici comment le configurer et le lire." },
    { type: "heading",text: "Ce qu’affiche le Performance Center" },
    { type: "paragraph",html: "Une fois ouvert, vous voyez des statistiques au niveau de la séance pour le compte sélectionné :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>P&amp;L réalisé et ouvert</strong> cumulé de la séance, par compte et par contrat.",
        "Les mêmes chiffres <strong class='text-white'>avec et sans commissions et frais</strong>, pour voir votre coût de trading d’un coup d’œil.",
        "Un <strong class='text-white'>historique chronologique du P&amp;L</strong> qui montre comment le chiffre a évolué au fil de la séance.",
      ],
    },
    { type: "paragraph",html: "Les widgets sont configurables, votre disposition peut donc afficher plus ou moins de panneaux que celle d’un autre trader. C’est normal : vous décidez de ce qui reste à l’écran." },
    { type: "heading",text: "Configurez-le en cinq étapes" },
    {
      type: "steps",
      items: [
        { title: "Ajoutez le Performance Center à votre espace de travail", html: "Ouvrez le Workspace Manager et ajoutez le module Performance Center : faites-le glisser ou choisissez-le dans la liste des modules. Il s’ancre comme n’importe quel autre panneau ; placez-le donc à côté de votre graphique ou de votre DOM, là où vous le regarderez vraiment.", image: {"src":`${IMG}/tradovate-performance-center-1.png`,"alt":"Ajout du module Performance Center depuis le Workspace Manager de Tradovate"} },
        { title: "Filtrez par compte ou par contrat unique", html: "Cliquez sur l’onglet du module et saisissez un symbole de contrat, par exemple ES ou NQ, pour limiter les statistiques à cet instrument. Effacez le symbole et vous retrouvez tous les contrats du compte. Vous négociez sur plusieurs comptes ? Utilisez la liaison par couleur pour relier le module au compte (ou au Quote Board) que vous voulez suivre.", image: {"src":`${IMG}/tradovate-performance-center-2.png`,"alt":"Filtrage des statistiques du Performance Center en saisissant un symbole de contrat dans l’onglet du module"} },
        { title: "Choisissez les widgets à afficher", html: "Cliquez sur l’engrenage en haut à droite du module pour ouvrir ses View Settings. Activez ou désactivez les panneaux, l’historique du P&amp;L, les totaux, les chiffres après commissions, jusqu’à ce que la disposition n’affiche que ce que vous surveillez pendant une séance. Moins d’encombrement, des lectures plus rapides.", image: {"src":`${IMG}/tradovate-performance-center-3.png`,"alt":"Activation et désactivation des widgets du Performance Center dans le menu à engrenage View Settings"} },
        { title: "Lisez le P&L de la séance", html: "Lisez maintenant les chiffres. Vous obtenez deux versions du P&amp;L : brut (avant frais) et net (après commissions et frais). L’écart entre les deux est le coût de votre activité pour la séance, à examiner si vous faites du scalping en taille. La vue chronologique raconte l’histoire derrière le total : avez-vous rendu un gain précoce, ou l’avez-vous construit tard dans la séance.", image: {"src":`${IMG}/tradovate-performance-center-4.png`,"alt":"Lecture des chiffres de P&L brut et net de la séance dans le Performance Center de Tradovate"} },
        { title: "Ouvrez le Performance Report complet pour l’historique", html: "Comme le module ne couvre que la séance, les données plus anciennes se trouvent ailleurs. Cliquez sur le lien du rapport dans le Performance Center pour ouvrir le Performance Report dans la zone Account Reports. Choisissez une période, Today, This Week, This Month ou un From/To personnalisé, cliquez sur Go, et vous verrez le P&amp;L global, le nombre de trades, le taux de réussite, le drawdown et le run-up pour cette fenêtre. Exportez-le en CSV ou en PDF pour votre journal ou votre comptable.", image: {"src":`${IMG}/tradovate-performance-center-5.png`,"alt":"Ouverture du Performance Report depuis le Performance Center pour consulter les statistiques historiques"} },
      ],
    },
    { type: "heading",text: "Statistiques de séance et rapport complet" },
    { type: "table", headers: ["","Performance Center","Performance Report"], rows: [
      ["Période","Séance en cours uniquement","Toute plage de dates de votre choix"],
      ["Idéal pour","Suivi en direct, sur le moment","Analyse, journal, fiscalité"],
      ["Où le trouver","Ancré dans votre espace de travail","Zone Account Reports"],
      ["Export","À l’écran uniquement","Téléchargement CSV / PDF"],
    ] },
    { type: "paragraph",html: "Vous négociez sur un compte prop ou d’évaluation ? Certaines statistiques et certains flux de données sont activés par votre société, pas par vous, et les limites correspondantes varient selon la société et la taille du compte. Si un chiffre semble anormal ou si un panneau est vide, vérifiez les règles en vigueur de votre société avant de supposer un bug de la plateforme." },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Si vous déclenchez vos entrées et sorties depuis TradingView, garder le Performance Center ouvert est le moyen le plus rapide de confirmer que les exécutions de votre automatisation correspondent à votre plan. <strong class='text-white'>PickMyTrade automatise votre trading sur Tradovate</strong> afin que vous consacriez ce temps d’écran à examiner vos résultats plutôt qu’à cliquer sur des ordres." },
  ], it: [
