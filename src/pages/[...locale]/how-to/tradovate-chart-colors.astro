---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-chart-colors";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Customize Chart Colors & Candle Styles in Tradovate";
const META_DESCRIPTION =
  "Change candle body, border, and wick colors, set the chart background, and save reusable named color schemes on your Tradovate futures charts.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Diagrammfarben und Kerzenstile in Tradovate anpassen", es: "Personalice los colores del gráfico y los estilos de vela en Tradovate", fr: "Personnalisez les couleurs du graphique et les styles de bougies dans Tradovate", it: "Personalizzi i colori del grafico e gli stili delle candele in Tradovate" },
  dek: { en: "A default Tradovate chart is fine until you're staring at it for six hours straight. Here's how to change your candle style, recolor the candles and background, and save the look as a named color scheme.", de: "Ein Standard-Chart von Tradovate ist in Ordnung, bis Sie sechs Stunden am Stück darauf schauen. So ändern Sie Ihren Kerzenstil, färben Kerzen und Hintergrund um und speichern das Aussehen als benanntes Farbschema.", es: "Un gráfico predeterminado de Tradovate está bien hasta que lo mira durante seis horas seguidas. Así puede cambiar el estilo de vela, recolorear las velas y el fondo, y guardar el aspecto como un esquema de color con nombre.", fr: "Un graphique Tradovate par défaut convient jusqu’au moment où vous le fixez six heures d’affilée. Voici comment changer votre style de bougies, recolorer les bougies et l’arrière-plan, et enregistrer l’ensemble sous forme de jeu de couleurs nommé.", it: "Un grafico Tradovate predefinito va bene finché non lo fissa per sei ore di fila. Ecco come cambiare lo stile delle candele, ricolorare candele e sfondo e salvare l’aspetto come schema di colori con un nome." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-10",
  blocks: { en: [
    { type: "paragraph", html: "A default Tradovate chart is fine until you're staring at it for six hours straight. The right colors cut eye strain, make direction obvious at a glance, and stop you from misreading a red candle as green during a fast move. Here's how to change your candle style, recolor the candles and background, and save the whole look as a named color scheme you can reuse." },
    { type: "heading", text: "What You Can Actually Change" },
    { type: "paragraph", html: "Three separate things, and it helps to know which control does which:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Chart style</strong>, the shape of the bars themselves (candlestick, bar, line, and so on).",
        "<strong class='text-white'>Element colors</strong>, candle bodies, borders, wicks, and your Buy/Sell/Profit/Loss order lines.",
        "<strong class='text-white'>Color scheme</strong>, the background plus a saved, named theme you can flip between and tie to Light or Dark mode.",
      ],
    },
    { type: "heading", text: "Customize Your Tradovate Chart: Step by Step" },
    {
      type: "steps",
      items: [
        { title: "Choose Your Chart Style", html: "Charts open as candlesticks by default. To switch, hover your cursor over the Chart module and click the <strong class='text-white'>Chart Style</strong> button that appears near the top. Tradovate ships eight built-in styles, so you'll find the usual options here: candlestick, bar, line, area, and Heikin Ashi among them. Pick whichever matches how you read price. Candlesticks stay the most popular for a reason, but a clean line chart is hard to beat for spotting the broader trend." },
        { title: "Open the Chart's Color Settings", html: "Hover over the chart and click the gear icon, labeled <strong class='text-white'>Configure Chart Elements</strong>. In the <strong class='text-white'>Elements</strong> tab, click the futures symbol you're charting. That opens the <strong class='text-white'>Chart Editor</strong> pop-up, where every color picker lives. Label wording shifts a little between platform builds, so if you don't see \"Configure Chart Elements\" by name, look for the gear or settings icon on the chart itself." },
        { title: "Recolor Candle Bodies, Borders, and Wicks", html: "Inside the Chart Editor you can set colors independently for the candle <strong class='text-white'>bodies</strong>, <strong class='text-white'>borders</strong>, and <strong class='text-white'>wicks</strong>, with a separate pair for up candles and down candles. Keep the up/down contrast strong. If your green and red are too close in brightness, they blur together on a busy one-minute chart. Set your colors, then save your changes." },
        { title: "Set the Background and Name a Color Scheme", html: "The background lives in its own place. Open the chart <strong class='text-white'>Settings</strong> menu and choose <strong class='text-white'>Color Scheme</strong>. From there you can copy an existing scheme as a starting point, give it a name, and edit the background along with the other chart elements. You can build more than one scheme and assign them to <strong class='text-white'>Light Mode</strong> or <strong class='text-white'>Dark Mode</strong>, so the chart follows whatever theme your platform is set to. Dark background with a bright candle pair is the classic low-strain setup for long sessions." },
        { title: "Color Your Order Lines and Save to a Template", html: "Back in the Chart Editor, set the colors for your <strong class='text-white'>Buy</strong>, <strong class='text-white'>Sell</strong>, <strong class='text-white'>Profit</strong>, and <strong class='text-white'>Loss</strong> lines. These are the levels that show up when you trade from the chart, so pick colors that stand apart from the candles. The important part: color schemes are saved with your <strong class='text-white'>Chart Template</strong>. Save the template once you're happy, and the look carries across sessions and onto any new chart you apply the template to. Skip this save and your tweaks can reset the next time you log in." },
      ],
    },
    { type: "heading", text: "A Few Things Worth Knowing" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Schemes are per chart.</strong> A color scheme applies on a chart-by-chart basis, so set it once, save it to a template, and reuse that template instead of recoloring every window.",
        "<strong class='text-white'>Light and Dark can differ.</strong> You can point a bright scheme at Light Mode and a dark one at Dark Mode, and Tradovate swaps automatically with the platform theme.",
        "<strong class='text-white'>Labels move around.</strong> Tradovate updates its interface over time. If a menu name here doesn't match your screen, hunt for the equivalent gear, Settings, or Color Scheme control before assuming it's gone.",
      ],
    },
    { type: "heading", text: "Automate the Trading, Keep Your Clean Charts" },
    { type: "paragraph", html: "Once your charts read the way you like, the last thing you want is to be glued to them placing every order by hand. <strong class='text-white'>PickMyTrade routes your TradingView alerts straight into your Tradovate account</strong>, so entries and exits fire automatically while you keep watching the chart you just dialed in." },
  ], de: [
    { type: "paragraph",html: "Ein Standard-Chart von Tradovate ist in Ordnung, bis Sie sechs Stunden am Stück darauf schauen. Die richtigen Farben verringern die Augenbelastung, machen die Richtung auf einen Blick erkennbar und verhindern, dass Sie bei einer schnellen Bewegung eine rote Kerze für eine grüne halten. So ändern Sie Ihren Kerzenstil, färben Kerzen und Hintergrund um und speichern das gesamte Erscheinungsbild als benanntes Farbschema, das Sie wiederverwenden können." },
    { type: "heading",text: "Was Sie tatsächlich ändern können" },
    { type: "paragraph",html: "Drei getrennte Dinge, und es hilft zu wissen, welche Einstellung was bewirkt:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Chart-Stil</strong>: die Form der Balken selbst (Kerzen, Balken, Linie und so weiter).",
        "<strong class='text-white'>Elementfarben</strong>: Kerzenkörper, Ränder, Dochte sowie Ihre Order-Linien für Buy, Sell, Profit und Loss.",
        "<strong class='text-white'>Farbschema</strong>: der Hintergrund plus ein gespeichertes, benanntes Design, zwischen dem Sie wechseln und das Sie dem Light- oder Dark-Modus zuordnen können.",
      ],
    },
    { type: "heading",text: "Ihren Tradovate-Chart anpassen: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Chart-Stil wählen", html: "Charts öffnen standardmäßig als Kerzen. Zum Wechseln bewegen Sie den Mauszeiger über das Chart-Modul und klicken auf die Schaltfläche <strong class='text-white'>Chart Style</strong>, die oben erscheint. Tradovate bringt acht integrierte Stile mit, darunter die üblichen Optionen: Kerzen, Balken, Linie, Fläche und Heikin Ashi. Wählen Sie den, der zu Ihrer Art passt, Kurse zu lesen. Kerzen bleiben nicht ohne Grund am beliebtesten, doch für das Erkennen des übergeordneten Trends ist ein sauberes Liniendiagramm kaum zu schlagen." },
        { title: "Die Farbeinstellungen des Charts öffnen", html: "Bewegen Sie den Mauszeiger über den Chart und klicken Sie auf das Zahnradsymbol <strong class='text-white'>Configure Chart Elements</strong>. Klicken Sie im Tab <strong class='text-white'>Elements</strong> auf das Futures-Symbol, das Sie darstellen. Dadurch öffnet sich das Pop-up <strong class='text-white'>Chart Editor</strong>, in dem sich alle Farbwähler befinden. Die Bezeichnungen unterscheiden sich leicht zwischen Plattformversionen. Wenn Sie „Configure Chart Elements“ nicht unter diesem Namen finden, suchen Sie das Zahnrad- oder Einstellungssymbol am Chart selbst." },
        { title: "Kerzenkörper, Ränder und Dochte umfärben", html: "Im Chart Editor können Sie die Farben für <strong class='text-white'>Körper</strong>, <strong class='text-white'>Ränder</strong> und <strong class='text-white'>Dochte</strong> der Kerzen unabhängig voneinander festlegen, mit einem separaten Paar für steigende und fallende Kerzen. Halten Sie den Auf-/Ab-Kontrast hoch. Wenn Ihr Grün und Rot in der Helligkeit zu nah beieinander liegen, verschwimmen sie in einem hektischen Ein-Minuten-Chart. Legen Sie Ihre Farben fest und speichern Sie die Änderungen." },
        { title: "Hintergrund festlegen und ein Farbschema benennen", html: "Der Hintergrund hat seinen eigenen Platz. Öffnen Sie das Menü <strong class='text-white'>Settings</strong> des Charts und wählen Sie <strong class='text-white'>Color Scheme</strong>. Dort können Sie ein vorhandenes Schema als Ausgangspunkt kopieren, ihm einen Namen geben und den Hintergrund zusammen mit den anderen Chart-Elementen bearbeiten. Sie können mehrere Schemata erstellen und sie dem <strong class='text-white'>Light Mode</strong> oder <strong class='text-white'>Dark Mode</strong> zuweisen, sodass der Chart dem Design folgt, auf das Ihre Plattform eingestellt ist. Ein dunkler Hintergrund mit einem hellen Kerzenpaar ist die klassische augenschonende Einstellung für lange Sitzungen." },
        { title: "Order-Linien einfärben und in einer Vorlage speichern", html: "Legen Sie im Chart Editor die Farben für Ihre Linien <strong class='text-white'>Buy</strong>, <strong class='text-white'>Sell</strong>, <strong class='text-white'>Profit</strong> und <strong class='text-white'>Loss</strong> fest. Das sind die Niveaus, die erscheinen, wenn Sie direkt aus dem Chart handeln. Wählen Sie also Farben, die sich von den Kerzen abheben. Das Wichtigste: Farbschemata werden mit Ihrem <strong class='text-white'>Chart Template</strong> gespeichert. Speichern Sie die Vorlage, sobald Sie zufrieden sind, und das Aussehen bleibt über Sitzungen hinweg erhalten und gilt für jeden neuen Chart, auf den Sie die Vorlage anwenden. Ohne dieses Speichern können Ihre Anpassungen bei der nächsten Anmeldung zurückgesetzt sein." },
      ],
    },
    { type: "heading",text: "Gut zu wissen" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Schemata gelten pro Chart.</strong> Ein Farbschema gilt chartweise. Richten Sie es einmal ein, speichern Sie es in einer Vorlage und verwenden Sie diese wieder, statt jedes Fenster neu einzufärben.",
        "<strong class='text-white'>Light und Dark können sich unterscheiden.</strong> Sie können ein helles Schema dem Light Mode und ein dunkles dem Dark Mode zuweisen, und Tradovate wechselt automatisch mit dem Plattform-Design.",
        "<strong class='text-white'>Bezeichnungen ändern sich.</strong> Tradovate aktualisiert seine Oberfläche mit der Zeit. Wenn ein hier genannter Menüname nicht zu Ihrem Bildschirm passt, suchen Sie das entsprechende Zahnrad, Settings oder Color Scheme, bevor Sie annehmen, dass es verschwunden ist.",
      ],
    },
    { type: "heading",text: "Den Handel automatisieren, saubere Charts behalten" },
    { type: "paragraph",html: "Sobald Ihre Charts so aussehen, wie Sie es mögen, wollen Sie am wenigsten daran gefesselt sein, jede Order von Hand zu platzieren. <strong class='text-white'>PickMyTrade leitet Ihre TradingView-Alerts direkt an Ihr Tradovate-Konto weiter</strong>, sodass Ein- und Ausstiege automatisch ausgelöst werden, während Sie weiter den Chart beobachten, den Sie gerade eingerichtet haben." },
  ], es: [
    { type: "paragraph",html: "Un gráfico predeterminado de Tradovate está bien hasta que lo mira durante seis horas seguidas. Los colores adecuados reducen la fatiga visual, hacen evidente la dirección de un vistazo y evitan que confunda una vela roja con una verde durante un movimiento rápido. Así puede cambiar el estilo de vela, recolorear las velas y el fondo, y guardar todo el aspecto como un esquema de color con nombre que podrá reutilizar." },
    { type: "heading",text: "Qué puede cambiar realmente" },
    { type: "paragraph",html: "Tres cosas distintas, y conviene saber qué control hace cada una:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Estilo de gráfico</strong>: la forma de las propias barras (velas japonesas, barras, línea, etc.).",
        "<strong class='text-white'>Colores de los elementos</strong>: cuerpos de vela, bordes, mechas y sus líneas de órdenes Buy/Sell/Profit/Loss.",
        "<strong class='text-white'>Esquema de color</strong>: el fondo más un tema guardado y con nombre que puede alternar y vincular al modo Light o Dark.",
      ],
    },
    { type: "heading",text: "Personalice su gráfico de Tradovate paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Elija el estilo de gráfico", html: "Los gráficos se abren como velas japonesas de forma predeterminada. Para cambiarlo, pase el cursor sobre el módulo de gráfico y haga clic en el botón <strong class='text-white'>Chart Style</strong> que aparece cerca de la parte superior. Tradovate incluye ocho estilos integrados, así que encontrará las opciones habituales: velas japonesas, barras, línea, área y Heikin Ashi, entre otras. Elija la que se ajuste a su forma de leer el precio. Las velas siguen siendo las más populares por algo, pero un gráfico de línea limpio es difícil de superar para detectar la tendencia general." },
        { title: "Abra la configuración de color del gráfico", html: "Pase el cursor sobre el gráfico y haga clic en el icono de engranaje, llamado <strong class='text-white'>Configure Chart Elements</strong>. En la pestaña <strong class='text-white'>Elements</strong>, haga clic en el símbolo de futuros que está graficando. Se abrirá la ventana emergente <strong class='text-white'>Chart Editor</strong>, donde se encuentran todos los selectores de color. La redacción de las etiquetas varía un poco entre versiones de la plataforma, así que si no ve «Configure Chart Elements» con ese nombre, busque el icono de engranaje o de configuración en el propio gráfico." },
        { title: "Recolore cuerpos, bordes y mechas de las velas", html: "En el Chart Editor puede establecer colores de forma independiente para los <strong class='text-white'>cuerpos</strong>, <strong class='text-white'>bordes</strong> y <strong class='text-white'>mechas</strong> de las velas, con un par separado para las velas alcistas y las bajistas. Mantenga un fuerte contraste entre alcistas y bajistas. Si su verde y su rojo tienen un brillo demasiado parecido, se confunden en un gráfico de un minuto muy cargado. Establezca sus colores y guarde los cambios." },
        { title: "Defina el fondo y dé nombre a un esquema de color", html: "El fondo tiene su propio lugar. Abra el menú <strong class='text-white'>Settings</strong> del gráfico y elija <strong class='text-white'>Color Scheme</strong>. Desde ahí puede copiar un esquema existente como punto de partida, darle un nombre y editar el fondo junto con los demás elementos del gráfico. Puede crear más de un esquema y asignarlos al <strong class='text-white'>Light Mode</strong> o al <strong class='text-white'>Dark Mode</strong>, de modo que el gráfico siga el tema configurado en su plataforma. Un fondo oscuro con un par de velas brillantes es la configuración clásica de bajo cansancio para sesiones largas." },
        { title: "Coloree sus líneas de órdenes y guarde en una plantilla", html: "De vuelta en el Chart Editor, establezca los colores de sus líneas <strong class='text-white'>Buy</strong>, <strong class='text-white'>Sell</strong>, <strong class='text-white'>Profit</strong> y <strong class='text-white'>Loss</strong>. Son los niveles que aparecen cuando opera desde el gráfico, así que elija colores que destaquen frente a las velas. Lo importante: los esquemas de color se guardan con su <strong class='text-white'>Chart Template</strong>. Guarde la plantilla cuando esté conforme, y el aspecto se mantendrá entre sesiones y en cualquier gráfico nuevo al que aplique la plantilla. Si omite este guardado, sus ajustes pueden restablecerse la próxima vez que inicie sesión." },
      ],
    },
    { type: "heading",text: "Algunas cosas que conviene saber" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Los esquemas son por gráfico.</strong> Un esquema de color se aplica gráfico por gráfico, así que configúrelo una vez, guárdelo en una plantilla y reutilice esa plantilla en lugar de recolorear cada ventana.",
        "<strong class='text-white'>Light y Dark pueden ser distintos.</strong> Puede asignar un esquema claro al Light Mode y uno oscuro al Dark Mode, y Tradovate cambia automáticamente con el tema de la plataforma.",
        "<strong class='text-white'>Las etiquetas cambian de sitio.</strong> Tradovate actualiza su interfaz con el tiempo. Si el nombre de un menú de esta guía no coincide con su pantalla, busque el engranaje, Settings o el control de Color Scheme equivalente antes de asumir que ha desaparecido.",
      ],
    },
    { type: "heading",text: "Automatice las operaciones y conserve sus gráficos limpios" },
    { type: "paragraph",html: "Una vez que sus gráficos se vean como a usted le gusta, lo último que quiere es estar pegado a ellos colocando cada orden a mano. <strong class='text-white'>PickMyTrade envía sus alertas de TradingView directamente a su cuenta de Tradovate</strong>, de modo que las entradas y salidas se ejecutan automáticamente mientras usted sigue observando el gráfico que acaba de dejar a su gusto." },
  ], fr: [
    { type: "paragraph",html: "Un graphique Tradovate par défaut convient jusqu’au moment où vous le fixez six heures d’affilée. Les bonnes couleurs réduisent la fatigue visuelle, rendent la direction évidente d’un coup d’œil et vous évitent de prendre une bougie rouge pour une verte lors d’un mouvement rapide. Voici comment changer votre style de bougies, recolorer les bougies et l’arrière-plan, et enregistrer l’ensemble sous forme de jeu de couleurs nommé que vous pourrez réutiliser." },
    { type: "heading",text: "Ce que vous pouvez réellement modifier" },
    { type: "paragraph",html: "Trois éléments distincts, et il est utile de savoir quel contrôle fait quoi :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Style de graphique</strong> : la forme des barres elles-mêmes (chandeliers, barres, ligne, etc.).",
        "<strong class='text-white'>Couleurs des éléments</strong> : corps des bougies, bordures, mèches et vos lignes d’ordres Buy/Sell/Profit/Loss.",
        "<strong class='text-white'>Jeu de couleurs</strong> : l’arrière-plan ainsi qu’un thème nommé et enregistré, entre lesquels vous pouvez basculer et que vous pouvez associer au mode Light ou Dark.",
      ],
    },
    { type: "heading",text: "Personnalisez votre graphique Tradovate : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Choisissez votre style de graphique", html: "Les graphiques s’ouvrent par défaut en chandeliers japonais. Pour changer, passez le curseur sur le module Chart et cliquez sur le bouton <strong class='text-white'>Chart Style</strong> qui apparaît en haut. Tradovate propose huit styles intégrés, vous y trouverez donc les options habituelles : chandeliers, barres, ligne, aire et Heikin Ashi, entre autres. Choisissez celui qui correspond à votre façon de lire le prix. Les chandeliers restent les plus populaires pour de bonnes raisons, mais un graphique en ligne épuré est difficile à battre pour repérer la tendance générale." },
        { title: "Ouvrez les paramètres de couleur du graphique", html: "Passez le curseur sur le graphique et cliquez sur l’icône d’engrenage, intitulée <strong class='text-white'>Configure Chart Elements</strong>. Dans l’onglet <strong class='text-white'>Elements</strong>, cliquez sur le symbole du contrat à terme que vous affichez. La fenêtre contextuelle <strong class='text-white'>Chart Editor</strong> s’ouvre, où se trouvent tous les sélecteurs de couleur. Le libellé varie légèrement d’une version de la plateforme à l’autre ; si vous ne voyez pas « Configure Chart Elements » sous ce nom, cherchez l’icône d’engrenage ou de paramètres sur le graphique lui-même." },
        { title: "Recolorez les corps, bordures et mèches des bougies", html: "Dans le Chart Editor, vous pouvez définir indépendamment les couleurs des <strong class='text-white'>corps</strong>, des <strong class='text-white'>bordures</strong> et des <strong class='text-white'>mèches</strong> des bougies, avec une paire distincte pour les bougies haussières et baissières. Conservez un fort contraste entre hausse et baisse. Si votre vert et votre rouge ont une luminosité trop proche, ils se confondent sur un graphique à une minute chargé. Définissez vos couleurs, puis enregistrez vos modifications." },
        { title: "Définissez l’arrière-plan et nommez un jeu de couleurs", html: "L’arrière-plan a son propre emplacement. Ouvrez le menu <strong class='text-white'>Settings</strong> du graphique et choisissez <strong class='text-white'>Color Scheme</strong>. De là, vous pouvez copier un jeu de couleurs existant comme point de départ, lui donner un nom et modifier l’arrière-plan ainsi que les autres éléments du graphique. Vous pouvez créer plusieurs jeux de couleurs et les affecter au <strong class='text-white'>Light Mode</strong> ou au <strong class='text-white'>Dark Mode</strong>, de sorte que le graphique suive le thème défini dans votre plateforme. Un fond sombre avec une paire de bougies éclatantes est la configuration classique, peu fatigante, pour les longues séances." },
        { title: "Colorez vos lignes d’ordres et enregistrez dans un modèle", html: "De retour dans le Chart Editor, définissez les couleurs de vos lignes <strong class='text-white'>Buy</strong>, <strong class='text-white'>Sell</strong>, <strong class='text-white'>Profit</strong> et <strong class='text-white'>Loss</strong>. Ce sont les niveaux qui s’affichent lorsque vous tradez depuis le graphique ; choisissez donc des couleurs qui se distinguent des bougies. Le point important : les jeux de couleurs sont enregistrés avec votre <strong class='text-white'>Chart Template</strong>. Enregistrez le modèle une fois satisfait, et l’aspect se conserve d’une session à l’autre ainsi que sur tout nouveau graphique auquel vous appliquez le modèle. Sans cet enregistrement, vos réglages peuvent être réinitialisés à la prochaine connexion." },
      ],
    },
    { type: "heading",text: "Quelques points à connaître" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Les jeux de couleurs sont propres à chaque graphique.</strong> Un jeu de couleurs s’applique graphique par graphique ; définissez-le une fois, enregistrez-le dans un modèle et réutilisez ce modèle au lieu de recolorer chaque fenêtre.",
        "<strong class='text-white'>Light et Dark peuvent différer.</strong> Vous pouvez associer un jeu clair au Light Mode et un jeu sombre au Dark Mode, et Tradovate bascule automatiquement avec le thème de la plateforme.",
        "<strong class='text-white'>Les libellés changent de place.</strong> Tradovate met à jour son interface au fil du temps. Si un nom de menu cité ici ne correspond pas à votre écran, cherchez l’engrenage, Settings ou le contrôle Color Scheme équivalent avant de supposer qu’il a disparu.",
      ],
    },
    { type: "heading",text: "Automatisez le trading, gardez des graphiques propres" },
    { type: "paragraph",html: "Une fois vos graphiques réglés comme vous l’aimez, la dernière chose que vous souhaitez est d’y être rivé à passer chaque ordre à la main. <strong class='text-white'>PickMyTrade achemine vos alertes TradingView directement vers votre compte Tradovate</strong>, de sorte que les entrées et sorties s’exécutent automatiquement pendant que vous continuez à suivre le graphique que vous venez de peaufiner." },
  ], it: [
    { type: "paragraph",html: "Un grafico Tradovate predefinito va bene finché non lo fissa per sei ore di fila. I colori giusti riducono l’affaticamento visivo, rendono la direzione evidente a colpo d’occhio e Le evitano di scambiare una candela rossa per una verde durante un movimento rapido. Ecco come cambiare lo stile delle candele, ricolorare candele e sfondo e salvare l’intero aspetto come schema di colori con un nome che potrà riutilizzare." },
    { type: "heading",text: "Cosa può davvero cambiare" },
    { type: "paragraph",html: "Tre cose distinte, ed è utile sapere quale controllo fa cosa:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Stile del grafico</strong>: la forma delle barre stesse (candele giapponesi, barre, linea e così via).",
        "<strong class='text-white'>Colori degli elementi</strong>: corpi delle candele, bordi, ombre e le Sue linee degli ordini Buy/Sell/Profit/Loss.",
