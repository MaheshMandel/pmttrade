---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-backup-2fa";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Set Up Backup 2FA to Avoid Tradovate Lockout";
const META_DESCRIPTION =
  "Set up backup 2FA methods and trusted devices so a lost phone can't lock you out of your futures account. Step-by-step account security guide.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Backup-2FA einrichten, um eine Sperre bei Tradovate zu vermeiden", es: "Configure un 2FA de respaldo para evitar el bloqueo en Tradovate", fr: "Configurez une 2FA de secours pour éviter le verrouillage de Tradovate", it: "Configuri un 2FA di backup per evitare il blocco di Tradovate" },
  dek: { en: "Two-factor authentication is the single best thing you can do to keep someone else out of your Tradovate account, but a single method can lock you out too. Here's how to stack a backup method and extra devices in five minutes.", de: "Die Zwei-Faktor-Authentifizierung ist das Beste, was Sie tun können, um Dritte aus Ihrem Tradovate-Konto fernzuhalten, doch eine einzelne Methode kann auch Sie aussperren. So richten Sie in fünf Minuten eine Backup-Methode und zusätzliche Geräte ein.", es: "La autenticación en dos pasos es lo mejor que puede hacer para mantener a otros fuera de su cuenta de Tradovate, pero un único método también puede dejarle fuera a usted. Así se añade un método de respaldo y dispositivos adicionales en cinco minutos.", fr: "L'authentification à deux facteurs est la meilleure chose que vous puissiez faire pour tenir les autres à l'écart de votre compte Tradovate, mais une seule méthode peut aussi vous en bloquer l'accès. Voici comment ajouter une méthode de secours et des appareils supplémentaires en cinq minutes.", it: "L'autenticazione a due fattori è la cosa migliore che possa fare per tenere gli altri fuori dal suo account Tradovate, ma un solo metodo può bloccare anche Lei. Ecco come aggiungere un metodo di backup e dispositivi extra in cinque minuti." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-10",
  blocks: { en: [
    { type: "paragraph", html: "Two-factor authentication is the single best thing you can do to keep someone else out of your Tradovate account. But there's a catch nobody thinks about until it bites them: if your only second factor lives on one phone, and that phone dies, gets stolen, or gets wiped, you can lock yourself out of your own account right when you need to flatten a position." },
    { type: "paragraph", html: "The fix takes five minutes. Set up more than one verification method, and register more than one device, before you ever need them. Here's exactly how." },
    { type: "heading", text: "Why One Method Isn't Enough" },
    { type: "paragraph", html: "When 2FA is on, Tradovate asks you to verify any login from a machine it doesn't recognize. If your single method is unreachable, dead battery, lost SIM, an authenticator app you reinstalled without a backup, you're stuck waiting on support while the market moves against an open trade. A second method turns that lockout into a five-second inconvenience. Tradovate leans into this: the moment you add a stronger method, it prompts you to pick a backup, and it recommends setting up multiple devices in case one goes missing." },
    { type: "heading", text: "The Methods You Can Stack" },
    {
      type: "table",
      headers: ["Method", "How it verifies you", "Best used as"],
      rows: [
        ["Email device approval", "An Approve / Deny link sent to your email on each new-device login", "Baseline (default)"],
        ["Authenticator app (TOTP)", "A six-digit code from Google Authenticator, Authy, and similar apps", "Primary"],
        ["SMS code", "A code texted to your phone number", "Backup"],
        ["Security key", "A physical hardware key you plug in or tap", "Strong primary"],
        ["Trusted device", "A device you've already approved skips re-verification", "Convenience"],
      ],
    },
    { type: "heading", text: "Set Up Backup 2FA, Step by Step" },
    {
      type: "steps",
      items: [
        { title: "Open the Security Page", html: "Sign in to the Tradovate web platform, open your <strong class='text-white'>Application Settings</strong> (the settings menu, usually a gear icon), and go to the <strong class='text-white'>Security</strong> page. Everything to do with 2FA and your devices lives in this one spot." },
        { title: "Turn On 2FA for Your Baseline", html: "Flip the <strong class='text-white'>2FA</strong> toggle on. With just this enabled, Tradovate emails you an <strong class='text-white'>Approve</strong> or <strong class='text-white'>Deny</strong> link every time you sign in from a new machine. That email approval is your baseline second factor, fine on its own, but tied to your inbox, so don't stop here." },
        { title: "Add an Authenticator App as Your Primary", html: "Scroll below the 2FA toggle and pick the <strong class='text-white'>Authenticator App</strong> option. Scan the QR code with a TOTP app, Google Authenticator, Authy, or whatever you already use, then type the six-digit code it shows to confirm. A code that rotates every 30 seconds is far harder to intercept than an email link, which makes it a better everyday primary." },
        { title: "Pick a Backup Method When Prompted", html: "The second you add a method, Tradovate asks you to choose a <strong class='text-white'>backup</strong>, usually SMS or a second method. Don't skip this screen. It's the whole point of the guide: if your authenticator app is gone, the SMS code (or your other method) is what gets you back in. Two methods, minimum. Three if you trade real money." },
        { title: "Register Your Extra Devices", html: "Log in and approve the prompt on every device you actually trade from, desktop, laptop, phone. Each approved device becomes a <strong class='text-white'>trusted device</strong>, so you're not re-verifying constantly, and you're never leaning on a single piece of hardware to reach your account. If your main machine dies mid-session, you just open the backup and keep going." },
        { title: "Review My Devices and Test It", html: "Open the <strong class='text-white'>My Devices</strong> list on the Security page. You'll see each device with its IP address, last location, and last login time, plus a <strong class='text-white'>Manage</strong> option to remove anything you don't recognize, do that right away if something looks off. Then sign out, sign back in once using your backup method, and confirm it actually works. Far better to catch a problem now than at 9:29 on a Monday morning." },
      ],
    },
    { type: "heading", text: "A Note for Prop and Evaluation Accounts" },
    { type: "paragraph", html: "Device management and the full set of security options are generally available to live-account holders. If you trade a prop-firm evaluation, some of these controls are handled by the firm, and exactly what you can toggle varies by firm and account size, check your firm's current rules before you change anything." },
    { type: "quote", html: "The cleanest way to avoid a login scramble in a fast market is to not need one. PickMyTrade routes your TradingView signals straight to Tradovate, so entries, exits, and brackets fire on their own while your security settings stay entirely in your hands." },
  ], de: [
    { type: "paragraph",html: "Die Zwei-Faktor-Authentifizierung ist das Beste, was Sie tun können, um andere aus Ihrem Tradovate-Konto fernzuhalten. Doch es gibt einen Haken, an den niemand denkt, bis es zu spät ist: Befindet sich Ihr einziger zweiter Faktor auf einem Telefon, und dieses Telefon fällt aus, wird gestohlen oder zurückgesetzt, können Sie sich aus Ihrem eigenen Konto aussperren, genau dann, wenn Sie eine Position glattstellen müssen." },
    { type: "paragraph",html: "Die Lösung dauert fünf Minuten. Richten Sie mehr als eine Verifizierungsmethode ein und registrieren Sie mehr als ein Gerät, bevor Sie sie brauchen. So geht es genau." },
    { type: "heading",text: "Warum eine Methode nicht genügt" },
    { type: "paragraph",html: "Ist 2FA aktiviert, verlangt Tradovate eine Verifizierung für jede Anmeldung von einem unbekannten Rechner. Ist Ihre einzige Methode nicht erreichbar, etwa wegen leeren Akkus, verlorener SIM-Karte oder einer neu installierten Authenticator-App ohne Sicherung, warten Sie auf den Support, während sich der Markt gegen eine offene Position bewegt. Eine zweite Methode macht aus der Sperre eine Unannehmlichkeit von fünf Sekunden. Tradovate unterstützt das: Sobald Sie eine stärkere Methode hinzufügen, fordert es Sie auf, ein Backup auszuwählen, und empfiehlt, mehrere Geräte einzurichten, falls eines verloren geht." },
    { type: "heading",text: "Die Methoden, die Sie kombinieren können" },
    { type: "table", headers: ["Methode","So verifiziert sie Sie","Am besten einsetzen als"], rows: [
      ["E-Mail-Geräte-Freigabe","Ein Approve- / Deny-Link, der bei jeder Anmeldung auf einem neuen Gerät an Ihre E-Mail gesendet wird","Basis (Standard)"],
      ["Authenticator-App (TOTP)","Ein sechsstelliger Code aus Google Authenticator, Authy und ähnlichen Apps","Primär"],
      ["SMS-Code","Ein Code, der an Ihre Telefonnummer gesendet wird","Backup"],
      ["Sicherheitsschlüssel","Ein physischer Hardware-Schlüssel, den Sie einstecken oder antippen","Starke Primärmethode"],
      ["Vertrauenswürdiges Gerät","Ein bereits freigegebenes Gerät überspringt die erneute Verifizierung","Komfort"],
    ] },
    { type: "heading",text: "Backup-2FA einrichten, Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Die Sicherheitsseite öffnen", html: "Melden Sie sich bei der Tradovate-Webplattform an, öffnen Sie Ihre <strong class='text-white'>Application Settings</strong> (das Einstellungsmenü, meist ein Zahnradsymbol) und gehen Sie zur Seite <strong class='text-white'>Security</strong>. Alles rund um 2FA und Ihre Geräte befindet sich an dieser einen Stelle." },
        { title: "2FA als Basis aktivieren", html: "Schalten Sie den <strong class='text-white'>2FA</strong>-Schalter ein. Allein damit sendet Tradovate Ihnen bei jeder Anmeldung von einem neuen Rechner einen <strong class='text-white'>Approve</strong>- oder <strong class='text-white'>Deny</strong>-Link per E-Mail. Diese E-Mail-Freigabe ist Ihr zweiter Basisfaktor, für sich genommen in Ordnung, aber an Ihr Postfach gebunden, hören Sie also hier nicht auf." },
        { title: "Eine Authenticator-App als Primärmethode hinzufügen", html: "Scrollen Sie unter den 2FA-Schalter und wählen Sie die Option <strong class='text-white'>Authenticator App</strong>. Scannen Sie den QR-Code mit einer TOTP-App, Google Authenticator, Authy oder einer, die Sie bereits nutzen, und geben Sie zur Bestätigung den angezeigten sechsstelligen Code ein. Ein Code, der sich alle 30 Sekunden ändert, ist deutlich schwerer abzufangen als ein E-Mail-Link und daher die bessere Alltagsmethode." },
        { title: "Bei Aufforderung eine Backup-Methode wählen", html: "Sobald Sie eine Methode hinzufügen, fordert Tradovate Sie auf, ein <strong class='text-white'>backup</strong> zu wählen, meist SMS oder eine zweite Methode. Überspringen Sie diesen Bildschirm nicht. Er ist der ganze Sinn dieser Anleitung: Ist Ihre Authenticator-App weg, bringt Sie der SMS-Code (oder Ihre andere Methode) wieder hinein. Mindestens zwei Methoden. Drei, wenn Sie mit echtem Geld handeln." },
        { title: "Ihre zusätzlichen Geräte registrieren", html: "Melden Sie sich an und bestätigen Sie die Aufforderung auf jedem Gerät, von dem aus Sie tatsächlich handeln, Desktop, Laptop, Telefon. Jedes freigegebene Gerät wird zu einem <strong class='text-white'>trusted device</strong>, sodass Sie nicht ständig neu verifizieren müssen und nie von einem einzigen Gerät abhängen, um an Ihr Konto zu kommen. Fällt Ihr Hauptrechner mitten in der Sitzung aus, öffnen Sie einfach das Backup und machen weiter." },
        { title: "My Devices prüfen und testen", html: "Öffnen Sie die Liste <strong class='text-white'>My Devices</strong> auf der Security-Seite. Sie sehen jedes Gerät mit seiner IP-Adresse, dem letzten Standort und der letzten Anmeldezeit sowie die Option <strong class='text-white'>Manage</strong>, um alles zu entfernen, was Sie nicht erkennen. Tun Sie das sofort, wenn etwas verdächtig aussieht. Melden Sie sich anschließend ab, einmal mit Ihrer Backup-Methode wieder an und prüfen Sie, ob sie wirklich funktioniert. Es ist weit besser, ein Problem jetzt zu entdecken als um 9:29 Uhr an einem Montagmorgen." },
      ],
    },
    { type: "heading",text: "Ein Hinweis für Prop- und Evaluierungskonten" },
    { type: "paragraph",html: "Geräteverwaltung und der volle Umfang der Sicherheitsoptionen stehen in der Regel Inhabern von Live-Konten zur Verfügung. Wenn Sie eine Prop-Firm-Evaluierung handeln, werden manche dieser Kontrollen von der Firma verwaltet, und was genau Sie ändern können, hängt von Firma und Kontogröße ab. Prüfen Sie die aktuellen Regeln Ihrer Firma, bevor Sie etwas ändern." },
    { type: "quote",html: "Der sauberste Weg, in einem schnellen Markt ein Login-Chaos zu vermeiden, ist, es gar nicht erst zu brauchen. PickMyTrade leitet Ihre TradingView-Signale direkt an Tradovate weiter, sodass Einstiege, Ausstiege und Brackets von selbst ausgelöst werden, während Ihre Sicherheitseinstellungen vollständig in Ihrer Hand bleiben." },
  ], es: [
    { type: "paragraph",html: "La autenticación en dos pasos es lo mejor que puede hacer para mantener a otros fuera de su cuenta de Tradovate. Pero hay un inconveniente en el que nadie piensa hasta que le afecta: si su único segundo factor está en un solo teléfono, y ese teléfono se descompone, se lo roban o se borra, puede quedarse fuera de su propia cuenta justo cuando necesita cerrar una posición." },
    { type: "paragraph",html: "La solución lleva cinco minutos. Configure más de un método de verificación y registre más de un dispositivo antes de necesitarlos. Así se hace exactamente." },
    { type: "heading",text: "Por qué un solo método no es suficiente" },
    { type: "paragraph",html: "Con el 2FA activado, Tradovate le pide verificar cualquier inicio de sesión desde un equipo que no reconoce. Si su único método no está disponible, por batería agotada, SIM perdida o una aplicación de autenticación reinstalada sin copia de seguridad, se queda esperando al soporte mientras el mercado se mueve en contra de una operación abierta. Un segundo método convierte ese bloqueo en una molestia de cinco segundos. Tradovate lo promueve: en cuanto añade un método más fuerte, le pide elegir un respaldo y recomienda configurar varios dispositivos por si uno se pierde." },
    { type: "heading",text: "Los métodos que puede combinar" },
    { type: "table", headers: ["Método","Cómo le verifica","Mejor uso como"], rows: [
      ["Aprobación de dispositivo por correo","Un enlace Approve / Deny enviado a su correo en cada inicio de sesión desde un dispositivo nuevo","Base (predeterminado)"],
      ["Aplicación de autenticación (TOTP)","Un código de seis dígitos de Google Authenticator, Authy y aplicaciones similares","Principal"],
      ["Código SMS","Un código enviado por mensaje de texto a su número de teléfono","Respaldo"],
      ["Llave de seguridad","Una llave física de hardware que conecta o toca","Principal robusto"],
      ["Dispositivo de confianza","Un dispositivo que ya aprobó omite la reverificación","Comodidad"],
    ] },
    { type: "heading",text: "Configure un 2FA de respaldo, paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra la página de seguridad", html: "Inicie sesión en la plataforma web de Tradovate, abra su <strong class='text-white'>Application Settings</strong> (el menú de ajustes, normalmente un icono de engranaje) y vaya a la página <strong class='text-white'>Security</strong>. Todo lo relacionado con el 2FA y sus dispositivos está en este único lugar." },
        { title: "Active el 2FA como base", html: "Active el interruptor <strong class='text-white'>2FA</strong>. Solo con esto, Tradovate le envía por correo un enlace <strong class='text-white'>Approve</strong> o <strong class='text-white'>Deny</strong> cada vez que inicia sesión desde un equipo nuevo. Esa aprobación por correo es su segundo factor base, válido por sí solo, pero ligado a su bandeja de entrada, así que no se detenga aquí." },
        { title: "Añada una aplicación de autenticación como principal", html: "Desplácese debajo del interruptor del 2FA y elija la opción <strong class='text-white'>Authenticator App</strong>. Escanee el código QR con una aplicación TOTP, Google Authenticator, Authy o la que ya use, y luego escriba el código de seis dígitos que muestra para confirmar. Un código que cambia cada 30 segundos es mucho más difícil de interceptar que un enlace de correo, lo que lo convierte en un mejor método principal para el día a día." },
        { title: "Elija un método de respaldo cuando se le solicite", html: "En cuanto añade un método, Tradovate le pide elegir un <strong class='text-white'>backup</strong>, normalmente SMS u otro método. No omita esta pantalla. Es el objetivo de esta guía: si su aplicación de autenticación desaparece, el código SMS (o su otro método) es lo que le permite volver a entrar. Dos métodos, como mínimo. Tres si opera con dinero real." },
        { title: "Registre sus dispositivos adicionales", html: "Inicie sesión y apruebe la solicitud en cada dispositivo desde el que opere realmente: escritorio, portátil, teléfono. Cada dispositivo aprobado se convierte en un <strong class='text-white'>trusted device</strong>, de modo que no tiene que verificarse constantemente y nunca depende de un único equipo para acceder a su cuenta. Si su equipo principal falla en plena sesión, simplemente abre el de respaldo y continúa." },
        { title: "Revise My Devices y pruébelo", html: "Abra la lista <strong class='text-white'>My Devices</strong> en la página Security. Verá cada dispositivo con su dirección IP, última ubicación y hora del último inicio de sesión, además de una opción <strong class='text-white'>Manage</strong> para eliminar cualquier cosa que no reconozca; hágalo de inmediato si algo parece sospechoso. Después cierre sesión, vuelva a iniciarla una vez con su método de respaldo y confirme que realmente funciona. Es mucho mejor detectar un problema ahora que a las 9:29 de un lunes por la mañana." },
      ],
    },
    { type: "heading",text: "Una nota para cuentas prop y de evaluación" },
    { type: "paragraph",html: "La gestión de dispositivos y el conjunto completo de opciones de seguridad suelen estar disponibles para los titulares de cuentas reales. Si opera una evaluación de una firma prop, algunos de estos controles los gestiona la firma, y lo que exactamente puede modificar varía según la firma y el tamaño de la cuenta; consulte las reglas vigentes de su firma antes de cambiar nada." },
    { type: "quote",html: "La forma más limpia de evitar una carrera por iniciar sesión en un mercado rápido es no necesitarla. PickMyTrade envía sus señales de TradingView directamente a Tradovate, de modo que las entradas, las salidas y los brackets se ejecutan por sí solos mientras sus ajustes de seguridad permanecen totalmente en sus manos." },
  ], fr: [
    { type: "paragraph",html: "L'authentification à deux facteurs est la meilleure chose que vous puissiez faire pour tenir les autres à l'écart de votre compte Tradovate. Mais il y a un piège auquel personne ne pense avant d'en être victime : si votre unique second facteur se trouve sur un seul téléphone, et que ce téléphone tombe en panne, est volé ou réinitialisé, vous pouvez vous retrouver bloqué hors de votre propre compte, juste au moment où vous devez clôturer une position." },
    { type: "paragraph",html: "La solution prend cinq minutes. Configurez plus d'une méthode de vérification et enregistrez plus d'un appareil avant d'en avoir besoin. Voici exactement comment faire." },
    { type: "heading",text: "Pourquoi une seule méthode ne suffit pas" },
    { type: "paragraph",html: "Lorsque la 2FA est activée, Tradovate vous demande de vérifier toute connexion depuis une machine qu'il ne reconnaît pas. Si votre unique méthode est inaccessible (batterie vide, carte SIM perdue, application d'authentification réinstallée sans sauvegarde), vous attendez le support pendant que le marché évolue contre une position ouverte. Une seconde méthode transforme ce verrouillage en un désagrément de cinq secondes. Tradovate va dans ce sens : dès que vous ajoutez une méthode plus forte, il vous invite à choisir une méthode de secours et recommande de configurer plusieurs appareils au cas où l'un d'eux serait perdu." },
    { type: "heading",text: "Les méthodes que vous pouvez combiner" },
    { type: "table", headers: ["Méthode","Comment elle vous vérifie","Meilleur usage"], rows: [
      ["Approbation d'appareil par e-mail","Un lien Approve / Deny envoyé à votre e-mail à chaque connexion depuis un nouvel appareil","Base (par défaut)"],
      ["Application d'authentification (TOTP)","Un code à six chiffres généré par Google Authenticator, Authy et des applications similaires","Principale"],
      ["Code SMS","Un code envoyé par SMS à votre numéro de téléphone","Secours"],
      ["Clé de sécurité","Une clé matérielle physique que vous branchez ou effleurez","Principale robuste"],
      ["Appareil de confiance","Un appareil que vous avez déjà approuvé n'a pas à être revérifié","Confort"],
    ] },
    { type: "heading",text: "Configurer une 2FA de secours, étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez la page de sécurité", html: "Connectez-vous à la plateforme web Tradovate, ouvrez vos <strong class='text-white'>Application Settings</strong> (le menu des paramètres, généralement une icône d'engrenage) et accédez à la page <strong class='text-white'>Security</strong>. Tout ce qui concerne la 2FA et vos appareils se trouve à cet unique endroit." },
        { title: "Activez la 2FA comme base", html: "Activez l'interrupteur <strong class='text-white'>2FA</strong>. Avec cela seul, Tradovate vous envoie par e-mail un lien <strong class='text-white'>Approve</strong> ou <strong class='text-white'>Deny</strong> chaque fois que vous vous connectez depuis une nouvelle machine. Cette approbation par e-mail est votre second facteur de base : suffisant en soi, mais lié à votre boîte de réception, ne vous arrêtez donc pas là." },
        { title: "Ajoutez une application d'authentification comme méthode principale", html: "Faites défiler sous l'interrupteur 2FA et choisissez l'option <strong class='text-white'>Authenticator App</strong>. Scannez le code QR avec une application TOTP (Google Authenticator, Authy ou celle que vous utilisez déjà), puis saisissez le code à six chiffres affiché pour confirmer. Un code qui change toutes les 30 secondes est bien plus difficile à intercepter qu'un lien par e-mail, ce qui en fait une meilleure méthode principale au quotidien." },
        { title: "Choisissez une méthode de secours lorsque vous y êtes invité", html: "Dès que vous ajoutez une méthode, Tradovate vous demande de choisir un <strong class='text-white'>backup</strong>, généralement le SMS ou une seconde méthode. Ne sautez pas cet écran. C'est tout l'objet de ce guide : si votre application d'authentification disparaît, le code SMS (ou votre autre méthode) vous permet de revenir. Deux méthodes au minimum. Trois si vous tradez avec de l'argent réel." },
        { title: "Enregistrez vos appareils supplémentaires", html: "Connectez-vous et approuvez la demande sur chaque appareil depuis lequel vous tradez réellement : ordinateur de bureau, portable, téléphone. Chaque appareil approuvé devient un <strong class='text-white'>trusted device</strong>, de sorte que vous n'avez pas à vous revérifier constamment et que vous ne dépendez jamais d'un seul matériel pour accéder à votre compte. Si votre machine principale tombe en panne en pleine session, il vous suffit d'ouvrir l'autre et de continuer." },
        { title: "Examinez My Devices et testez", html: "Ouvrez la liste <strong class='text-white'>My Devices</strong> sur la page Security. Vous verrez chaque appareil avec son adresse IP, son dernier emplacement et l'heure de sa dernière connexion, ainsi qu'une option <strong class='text-white'>Manage</strong> pour supprimer tout ce que vous ne reconnaissez pas ; faites-le immédiatement si quelque chose paraît suspect. Déconnectez-vous ensuite, reconnectez-vous une fois avec votre méthode de secours et vérifiez qu'elle fonctionne réellement. Mieux vaut détecter un problème maintenant qu'à 9 h 29 un lundi matin." },
      ],
    },
    { type: "heading",text: "Une remarque pour les comptes prop et d'évaluation" },
    { type: "paragraph",html: "La gestion des appareils et l'ensemble des options de sécurité sont généralement disponibles pour les titulaires de comptes réels. Si vous tradez une évaluation d'une prop firm, certains de ces contrôles sont gérés par la firme, et ce que vous pouvez modifier exactement varie selon la firme et la taille du compte ; vérifiez les règles actuelles de votre firme avant de changer quoi que ce soit." },
    { type: "quote",html: "La façon la plus propre d'éviter la panique de connexion sur un marché rapide est de ne pas en avoir besoin. PickMyTrade achemine vos signaux TradingView directement vers Tradovate, de sorte que les entrées, les sorties et les brackets se déclenchent d'eux-mêmes pendant que vos paramètres de sécurité restent entièrement entre vos mains." },
  ], it: [
    { type: "paragraph",html: "L'autenticazione a due fattori è la cosa migliore che possa fare per tenere gli altri fuori dal suo account Tradovate. Ma c'è un inconveniente a cui nessuno pensa finché non lo colpisce: se il suo unico secondo fattore si trova su un solo telefono, e quel telefono si guasta, viene rubato o viene azzerato, può rimanere bloccato fuori dal suo stesso account proprio quando deve chiudere una posizione." },
    { type: "paragraph",html: "La soluzione richiede cinque minuti. Configuri più di un metodo di verifica e registri più di un dispositivo prima di averne bisogno. Ecco esattamente come fare." },
    { type: "heading",text: "Perché un solo metodo non basta" },
    { type: "paragraph",html: "Quando il 2FA è attivo, Tradovate Le chiede di verificare qualsiasi accesso da una macchina che non riconosce. Se il suo unico metodo non è raggiungibile (batteria scarica, SIM persa, un'app di autenticazione reinstallata senza backup), rimane in attesa del supporto mentre il mercato si muove contro una posizione aperta. Un secondo metodo trasforma quel blocco in un fastidio di cinque secondi. Tradovate lo incoraggia: appena aggiunge un metodo più forte, Le chiede di scegliere un backup e raccomanda di configurare più dispositivi nel caso in cui uno vada perso." },
    { type: "heading",text: "I metodi che può combinare" },
    { type: "table", headers: ["Metodo","Come La verifica","Uso consigliato come"], rows: [
      ["Approvazione del dispositivo via e-mail","Un link Approve / Deny inviato alla sua e-mail a ogni accesso da un nuovo dispositivo","Base (predefinito)"],
      ["App di autenticazione (TOTP)","Un codice a sei cifre di Google Authenticator, Authy e app simili","Principale"],
      ["Codice SMS","Un codice inviato via SMS al suo numero di telefono","Backup"],
      ["Chiave di sicurezza","Una chiave hardware fisica che inserisce o tocca","Principale robusto"],
      ["Dispositivo attendibile","Un dispositivo già approvato salta la riverifica","Comodità"],
    ] },
    { type: "heading",text: "Configuri il 2FA di backup, passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Apra la pagina della sicurezza", html: "Acceda alla piattaforma web di Tradovate, apra le sue <strong class='text-white'>Application Settings</strong> (il menu delle impostazioni, di solito un'icona a ingranaggio) e vada alla pagina <strong class='text-white'>Security</strong>. Tutto ciò che riguarda il 2FA e i suoi dispositivi si trova in questo unico punto." },
        { title: "Attivi il 2FA come base", html: "Attivi l'interruttore <strong class='text-white'>2FA</strong>. Con solo questo, Tradovate Le invia via e-mail un link <strong class='text-white'>Approve</strong> o <strong class='text-white'>Deny</strong> ogni volta che accede da una nuova macchina. Questa approvazione via e-mail è il suo secondo fattore di base: va bene da sola, ma è legata alla sua casella di posta, quindi non si fermi qui." },
        { title: "Aggiunga un'app di autenticazione come principale", html: "Scorra sotto l'interruttore 2FA e scelga l'opzione <strong class='text-white'>Authenticator App</strong>. Scansioni il codice QR con un'app TOTP, Google Authenticator, Authy o quella che già usa, quindi digiti il codice a sei cifre mostrato per confermare. Un codice che cambia ogni 30 secondi è molto più difficile da intercettare di un link e-mail, il che lo rende un metodo principale migliore per l'uso quotidiano." },
        { title: "Scelga un metodo di backup quando richiesto", html: "Nel momento in cui aggiunge un metodo, Tradovate Le chiede di scegliere un <strong class='text-white'>backup</strong>, di solito SMS o un secondo metodo. Non salti questa schermata. È il senso di tutta la guida: se la sua app di autenticazione non è più disponibile, il codice SMS (o l'altro metodo) è ciò che Le permette di rientrare. Due metodi, come minimo. Tre se opera con denaro reale." },
        { title: "Registri i suoi dispositivi extra", html: "Acceda e approvi la richiesta su ogni dispositivo da cui opera davvero: desktop, laptop, telefono. Ogni dispositivo approvato diventa un <strong class='text-white'>trusted device</strong>, quindi non deve riverificarsi di continuo e non dipende mai da un solo apparecchio per accedere al suo account. Se il suo computer principale si guasta durante la sessione, apre semplicemente il backup e prosegue." },
        { title: "Controlli My Devices e lo provi", html: "Apra l'elenco <strong class='text-white'>My Devices</strong> nella pagina Security. Vedrà ogni dispositivo con il suo indirizzo IP, l'ultima posizione e l'ora dell'ultimo accesso, oltre a un'opzione <strong class='text-white'>Manage</strong> per rimuovere tutto ciò che non riconosce; lo faccia subito se qualcosa sembra strano. Poi esca, riaccede una volta usando il metodo di backup e verifichi che funzioni davvero. È molto meglio scoprire un problema adesso che alle 9:29 di un lunedì mattina." },
      ],
    },
    { type: "heading",text: "Una nota per i conti prop e di valutazione" },
    { type: "paragraph",html: "La gestione dei dispositivi e l'insieme completo delle opzioni di sicurezza sono generalmente disponibili per i titolari di conti live. Se opera una valutazione di una prop firm, alcuni di questi controlli sono gestiti dalla società, e ciò che può modificare esattamente varia in base alla società e alla dimensione del conto; verifichi le regole attuali della sua società prima di cambiare qualsiasi cosa." },
    { type: "quote",html: "Il modo più pulito per evitare un affannoso accesso in un mercato veloce è non averne bisogno. PickMyTrade instrada i suoi segnali TradingView direttamente a Tradovate, così ingressi, uscite e bracket partono da soli mentre le sue impostazioni di sicurezza restano interamente nelle sue mani." },
  ] },
  ctaHeading: { en: "Automate Your Tradovate Trades", de: "Automatisieren Sie Ihre Tradovate-Trades", es: "Automatice sus operaciones en Tradovate", fr: "Automatisez vos trades Tradovate", it: "Automatizzi i suoi trade su Tradovate" },
  ctaText: { en: "The cleanest way to avoid a login scramble in a fast market is to not need one. Let PickMyTrade route your TradingView signals straight to Tradovate while your security settings stay entirely in your hands.", de: "Der sauberste Weg, in einem schnellen Markt ein Login-Chaos zu vermeiden, ist, es gar nicht erst zu brauchen. Lassen Sie PickMyTrade Ihre TradingView-Signale direkt an Tradovate weiterleiten, während Ihre Sicherheitseinstellungen vollständig in Ihrer Hand bleiben.", es: "La forma más limpia de evitar una carrera por iniciar sesión en un mercado rápido es no necesitarla. Deje que PickMyTrade envíe sus señales de TradingView directamente a Tradovate mientras sus ajustes de seguridad permanecen totalmente en sus manos.", fr: "La façon la plus propre d'éviter la panique de connexion sur un marché rapide est de ne pas en avoir besoin. Laissez PickMyTrade acheminer vos signaux TradingView directement vers Tradovate pendant que vos paramètres de sécurité restent entièrement entre vos mains.", it: "Il modo più pulito per evitare un affannoso accesso in un mercato veloce è non averne bisogno. Lasci che PickMyTrade instradi i suoi segnali TradingView direttamente a Tradovate, mentre le sue impostazioni di sicurezza restano interamente nelle sue mani." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [], de: [], es: [], fr: [], it: [] },
  relatedHeading: { en: "Related Guides", de: "Verwandte Anleitungen", es: "Guías relacionadas", fr: "Guides associés", it: "Guide correlate" },
  disclosureText: { en: `This guide is for educational and informational purposes only and is not financial, investment, or trading advice. Trading futures and other leveraged products carries a substantial risk of loss and is not suitable for every investor. PickMyTrade is an independent third-party automation platform and is not affiliated with, endorsed by, or sponsored by Tradovate, Inc. "Tradovate" and all related names, logos, and trademarks are the property of their respective owners. Platform features and steps change over time, so always confirm the current process in the official Tradovate platform and documentation before acting.`, de: "Dieser Leitfaden dient ausschließlich Bildungs- und Informationszwecken und stellt keine Finanz-, Anlage- oder Handelsberatung dar. Der Handel mit Futures und anderen gehebelten Produkten birgt ein erhebliches Verlustrisiko und ist nicht für jeden Anleger geeignet. PickMyTrade ist eine unabhängige Automatisierungsplattform eines Drittanbieters und steht in keiner Verbindung zu Tradovate, Inc., wird nicht von Tradovate, Inc. unterstützt oder gesponsert. „Tradovate“ sowie alle zugehörigen Namen, Logos und Marken sind Eigentum ihrer jeweiligen Inhaber. Plattformfunktionen und Schritte ändern sich im Laufe der Zeit. Prüfen Sie daher stets den aktuellen Ablauf in der offiziellen Tradovate-Plattform und -Dokumentation, bevor Sie handeln.", es: "Esta guía tiene fines exclusivamente educativos e informativos y no constituye asesoramiento financiero, de inversión ni de trading. Operar con futuros y otros productos apalancados conlleva un riesgo sustancial de pérdida y no es adecuado para todos los inversores. PickMyTrade es una plataforma de automatización independiente de terceros y no está afiliada, respaldada ni patrocinada por Tradovate, Inc. «Tradovate» y todos los nombres, logotipos y marcas relacionados son propiedad de sus respectivos titulares. Las funciones de la plataforma y los pasos cambian con el tiempo, por lo que siempre debe confirmar el proceso actual en la plataforma y la documentación oficiales de Tradovate antes de actuar.", fr: "Ce guide est fourni à des fins éducatives et informatives uniquement et ne constitue pas un conseil financier, d'investissement ou de trading. La négociation de contrats à terme et d'autres produits à effet de levier comporte un risque de perte important et ne convient pas à tous les investisseurs. PickMyTrade est une plateforme d'automatisation tierce indépendante, non affiliée à Tradovate, Inc., ni approuvée ou parrainée par celle-ci. « Tradovate » ainsi que tous les noms, logos et marques associés sont la propriété de leurs détenteurs respectifs. Les fonctionnalités et les étapes de la plateforme évoluent avec le temps ; vérifiez donc toujours la procédure en vigueur dans la plateforme et la documentation officielles de Tradovate avant d'agir.", it: "Questa guida ha esclusivamente scopo educativo e informativo e non costituisce consulenza finanziaria, di investimento o di trading. Il trading di futures e di altri prodotti a leva comporta un rischio sostanziale di perdita e non è adatto a ogni investitore. PickMyTrade è una piattaforma di automazione indipendente di terze parti e non è affiliata, approvata o sponsorizzata da Tradovate, Inc. «Tradovate» e tutti i nomi, loghi e marchi correlati sono di proprietà dei rispettivi titolari. Le funzionalità della piattaforma e le procedure cambiano nel tempo, quindi verifichi sempre la procedura attuale nella piattaforma e nella documentazione ufficiali di Tradovate prima di agire." },
};
const data: GuideArticleData = resolveGuideContent(content, locale, related);

