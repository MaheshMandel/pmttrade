---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-chart-styles";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Tradovate Chart Styles: Heikin Ashi, Renko & More";
const META_DESCRIPTION =
  "Switch between the eight built-in chart styles, candlestick, Heikin Ashi, Renko, OHLC, TPO and more, right from the Chart Style button.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate-Chart-Stile: Heikin Ashi, Renko & mehr", es: "Estilos de gráfico de Tradovate: Heikin Ashi, Renko y más", fr: "Styles de graphique Tradovate : Heikin Ashi, Renko et plus", it: "Stili di grafico di Tradovate: Heikin Ashi, Renko e altro" },
  dek: { en: "Tradovate opens every chart as candlesticks, but that's only one of eight styles baked into the web platform. Here's where the Chart Style button lives and how to flip between styles without losing your drawings.", de: "Tradovate öffnet jeden Chart als Kerzenchart, doch das ist nur einer von acht Stilen, die in die Web-Plattform integriert sind. Hier erfahren Sie, wo sich die Schaltfläche Chart Style befindet und wie Sie zwischen den Stilen wechseln, ohne Ihre Zeichnungen zu verlieren.", es: "Tradovate abre cada gráfico como velas japonesas, pero es solo uno de los ocho estilos integrados en la plataforma web. Aquí le explicamos dónde está el botón Chart Style y cómo alternar entre estilos sin perder sus dibujos.", fr: "Tradovate ouvre chaque graphique en chandeliers, mais ce n'est que l'un des huit styles intégrés à la plateforme web. Voici où se trouve le bouton Chart Style et comment passer d'un style à l'autre sans perdre vos dessins.", it: "Tradovate apre ogni grafico come candele giapponesi, ma è solo uno degli otto stili integrati nella piattaforma web. Ecco dove si trova il pulsante Chart Style e come passare da uno stile all'altro senza perdere i Suoi disegni." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Tradovate opens every chart as candlesticks, but that's only one of eight styles baked into the web platform. Want smoothed Heikin Ashi candles for cleaner trend reads, Renko bricks that strip out time, or a TPO profile to see where price camped all day? They're all one button away. Here's where that button lives and how to flip between them without losing your drawings." },
    { type: "heading", text: "The Eight Built-in Chart Styles" },
    { type: "paragraph", html: "Charts default to candlesticks, but the Chart Style menu holds eight options in total. Here's what each one gives you and when it earns its place on your screen." },
    {
      type: "table",
      headers: ["Style", "What it shows / when to use it"],
      rows: [
        ["Candlesticks (default)", "Standard open/high/low/close bars with a colored body and wicks. The all-purpose view most traders start on."],
        ["OHLC", "Traditional bar chart. The left tick marks the open, the right tick the close. Handy if you'd rather not stare at filled bodies."],
        ["Line on Close", "A single line joining closing prices. Uncluttered, good for a fast read on direction or higher timeframes."],
        ["Bid-Ask Volume", "Footprint-style bars showing how much traded at the bid versus the ask inside each bar. Order-flow detail baked into the candle."],
        ["Heiken-Ashi", "Averaged candles that smooth out noise and make a trend easier to sit through. (Tradovate spells it \"Heiken-Ashi\" in the menu.)"],
        ["Renko", "Bricks that print only when price moves a set amount. Time is ignored, so chop shrinks and trends stand out."],
        ["Point and Figure", "Columns of X's and O's that filter out small moves and time completely. A classic noise-cutter."],
        ["TPO (Market Profile)", "A letter-based profile showing how much time price spent at each level through the session."],
      ],
    },
    { type: "heading", text: "How to Switch Chart Styles" },
    {
      type: "steps",
      items: [
        { title: "Open a Chart", html: "In the Tradovate web app, open the Chart module and load the contract you want, say MNQ or ES. If you don't have a chart panel up yet, add one to your workspace first." },
        { title: "Reveal the Chart Style Button", html: "Move your cursor over the top of the chart. A row of controls fades in near the timeframe and indicators icons, look for the Chart Style button. Its exact spot can shift between platform releases, so if you don't spot it right away, hover across the top toolbar until a tooltip reads \"Chart Style.\"" },
        { title: "Pick a Style From the Dropdown", html: "Click Chart Style and the dropdown lists all eight options. Click the one you want and the chart redraws on the spot, no reload, and your drawings and indicators stay put. Switch back just as easily whenever you want candlesticks again." },
        { title: "Adjust Style-Specific Settings", html: "A few styles come with their own knobs. Renko asks for a brick size, Point and Figure uses a box size and reversal, and TPO has its own profile options. Set those to taste, smaller values print more detail, larger ones smooth things out. These are personal chart preferences, so they won't touch your account, data feed, or contract." },
      ],
    },
    { type: "heading", text: "A Couple of Things Worth Knowing" },
    { type: "paragraph", html: "Chart style is set per chart, so you can run candlesticks on one panel and Renko on another, side by side. When you save your workspace, each chart remembers its own style. And because the styles are built in, there's nothing to install or subscribe to, Renko, footprint, and TPO all sit in the same dropdown as plain candles." },
    { type: "quote", html: "Changing chart styles is cosmetic, your strategy still has to pull the trigger. If you'd rather have your TradingView signals fire Tradovate orders automatically while you watch whichever style you like, PickMyTrade automates the bridge from alert to filled order." },
  ], de: [
    { type: "paragraph",html: "Tradovate öffnet jeden Chart als Kerzenchart, doch das ist nur einer von acht Stilen, die in die Web-Plattform integriert sind. Sie möchten geglättete Heikin-Ashi-Kerzen für klarere Trendeinschätzungen, Renko-Bricks, die die Zeit ausblenden, oder ein TPO-Profil, um zu sehen, wo sich der Preis den ganzen Tag aufgehalten hat? Alles ist nur eine Schaltfläche entfernt. Hier erfahren Sie, wo sich diese Schaltfläche befindet und wie Sie zwischen den Stilen wechseln, ohne Ihre Zeichnungen zu verlieren." },
    { type: "heading",text: "Die acht integrierten Chart-Stile" },
    { type: "paragraph",html: "Charts verwenden standardmäßig Kerzen, aber das Menü Chart Style enthält insgesamt acht Optionen. Hier sehen Sie, was jede davon bietet und wann sie sich auf Ihrem Bildschirm lohnt." },
    { type: "table", headers: ["Stil","Was er zeigt / wann Sie ihn verwenden"], rows: [
      ["Candlesticks (default)","Standardmäßige Open/High/Low/Close-Balken mit farbigem Körper und Dochten. Die Allzweckansicht, mit der die meisten Trader beginnen."],
      ["OHLC","Klassischer Balkenchart. Der linke Strich markiert die Eröffnung, der rechte den Schlusskurs. Praktisch, wenn Sie lieber keine gefüllten Kerzenkörper ansehen möchten."],
      ["Line on Close","Eine einzelne Linie, die die Schlusskurse verbindet. Übersichtlich und gut für einen schnellen Blick auf die Richtung oder für höhere Zeitrahmen."],
      ["Bid-Ask Volume","Footprint-artige Balken, die zeigen, wie viel innerhalb jedes Balkens am Bid und wie viel am Ask gehandelt wurde. Orderflow-Details direkt in der Kerze."],
      ["Heiken-Ashi","Gemittelte Kerzen, die das Rauschen glätten und einen Trend leichter durchhalten lassen. (Tradovate schreibt es im Menü \"Heiken-Ashi\".)"],
      ["Renko","Bricks, die nur entstehen, wenn sich der Preis um einen festgelegten Betrag bewegt. Die Zeit wird ignoriert, sodass Seitwärtsphasen schrumpfen und Trends hervortreten."],
      ["Point and Figure","Spalten aus X und O, die kleine Bewegungen und die Zeit vollständig herausfiltern. Ein klassischer Rauschfilter."],
      ["TPO (Market Profile)","Ein buchstabenbasiertes Profil, das zeigt, wie viel Zeit der Preis während der Sitzung auf jedem Niveau verbracht hat."],
    ] },
    { type: "heading",text: "So wechseln Sie den Chart-Stil" },
    {
      type: "steps",
      items: [
        { title: "Einen Chart öffnen", html: "Öffnen Sie in der Tradovate-Web-App das Chart-Modul und laden Sie den gewünschten Kontrakt, etwa MNQ oder ES. Wenn noch kein Chart-Panel geöffnet ist, fügen Sie zuerst eines zu Ihrem Workspace hinzu." },
        { title: "Die Schaltfläche Chart Style einblenden", html: "Bewegen Sie den Cursor an den oberen Rand des Charts. In der Nähe der Symbole für Zeitrahmen und Indikatoren blendet sich eine Reihe von Steuerelementen ein; suchen Sie die Schaltfläche Chart Style. Ihre genaue Position kann sich zwischen Plattform-Releases verschieben. Wenn Sie sie nicht gleich finden, fahren Sie über die obere Symbolleiste, bis ein Tooltip \"Chart Style\" anzeigt." },
        { title: "Einen Stil aus dem Dropdown wählen", html: "Klicken Sie auf Chart Style, und das Dropdown listet alle acht Optionen auf. Klicken Sie auf den gewünschten Stil, und der Chart wird sofort neu gezeichnet, ohne Neuladen, und Ihre Zeichnungen und Indikatoren bleiben erhalten. Zurück zu Kerzen wechseln Sie genauso einfach, wann immer Sie möchten." },
        { title: "Stilspezifische Einstellungen anpassen", html: "Einige Stile haben eigene Einstellungen. Renko fragt nach einer Brick-Größe, Point and Figure verwendet eine Boxgröße und eine Umkehr, und TPO hat eigene Profiloptionen. Stellen Sie diese nach Ihrem Geschmack ein: kleinere Werte liefern mehr Detail, größere glätten das Bild. Das sind persönliche Chart-Einstellungen, sie wirken sich also nicht auf Ihr Konto, Ihren Datenfeed oder Ihren Kontrakt aus." },
      ],
    },
    { type: "heading",text: "Ein paar Dinge, die Sie wissen sollten" },
    { type: "paragraph",html: "Der Chart-Stil wird pro Chart festgelegt, sodass Sie in einem Panel Kerzen und in einem anderen Renko nebeneinander verwenden können. Wenn Sie Ihren Workspace speichern, merkt sich jeder Chart seinen eigenen Stil. Und da die Stile integriert sind, müssen Sie nichts installieren oder abonnieren: Renko, Footprint und TPO befinden sich im selben Dropdown wie einfache Kerzen." },
    { type: "quote",html: "Das Ändern des Chart-Stils ist rein kosmetisch, Ihre Strategie muss trotzdem den Abzug betätigen. Wenn Sie möchten, dass Ihre TradingView-Signale Tradovate-Orders automatisch auslösen, während Sie den Stil Ihrer Wahl beobachten, automatisiert PickMyTrade die Brücke vom Alert zur ausgeführten Order." },
  ], es: [
    { type: "paragraph",html: "Tradovate abre cada gráfico como velas japonesas, pero es solo uno de los ocho estilos integrados en la plataforma web. ¿Quiere velas Heikin Ashi suavizadas para leer mejor la tendencia, bloques Renko que eliminan el tiempo o un perfil TPO para ver dónde se quedó el precio durante todo el día? Todo está a un botón de distancia. Aquí le explicamos dónde está ese botón y cómo alternar entre ellos sin perder sus dibujos." },
    { type: "heading",text: "Los ocho estilos de gráfico integrados" },
    { type: "paragraph",html: "Los gráficos usan velas por defecto, pero el menú Chart Style contiene ocho opciones en total. Esto es lo que ofrece cada una y cuándo merece un lugar en su pantalla." },
    { type: "table", headers: ["Estilo","Qué muestra / cuándo usarlo"], rows: [
      ["Candlesticks (default)","Barras estándar de apertura/máximo/mínimo/cierre con cuerpo de color y mechas. La vista versátil con la que empiezan la mayoría de los traders."],
      ["OHLC","Gráfico de barras tradicional. La marca izquierda indica la apertura y la derecha el cierre. Útil si prefiere no mirar cuerpos rellenos."],
      ["Line on Close","Una sola línea que une los precios de cierre. Despejado, ideal para una lectura rápida de la dirección o de marcos temporales superiores."],
      ["Bid-Ask Volume","Barras al estilo footprint que muestran cuánto se negoció en el bid frente al ask dentro de cada barra. Detalle de flujo de órdenes integrado en la vela."],
      ["Heiken-Ashi","Velas promediadas que suavizan el ruido y hacen más fácil mantenerse en una tendencia. (Tradovate lo escribe \"Heiken-Ashi\" en el menú.)"],
      ["Renko","Bloques que solo se imprimen cuando el precio se mueve una cantidad determinada. El tiempo se ignora, de modo que los tramos laterales se reducen y las tendencias destacan."],
      ["Point and Figure","Columnas de X y O que filtran los movimientos pequeños y el tiempo por completo. Un clásico para reducir el ruido."],
      ["TPO (Market Profile)","Un perfil basado en letras que muestra cuánto tiempo pasó el precio en cada nivel durante la sesión."],
    ] },
    { type: "heading",text: "Cómo cambiar el estilo del gráfico" },
    {
      type: "steps",
      items: [
        { title: "Abra un gráfico", html: "En la aplicación web de Tradovate, abra el módulo Chart y cargue el contrato que desee, por ejemplo MNQ o ES. Si aún no tiene un panel de gráfico abierto, añada uno primero a su espacio de trabajo." },
        { title: "Muestre el botón Chart Style", html: "Mueva el cursor sobre la parte superior del gráfico. Una fila de controles aparece gradualmente cerca de los iconos de marco temporal e indicadores; busque el botón Chart Style. Su ubicación exacta puede cambiar entre versiones de la plataforma, así que si no lo encuentra de inmediato, pase el cursor por la barra de herramientas superior hasta que un tooltip indique \"Chart Style\"." },
        { title: "Elija un estilo en el menú desplegable", html: "Haga clic en Chart Style y el menú desplegable muestra las ocho opciones. Haga clic en la que desee y el gráfico se redibuja al instante, sin recargar, y sus dibujos e indicadores se mantienen. Vuelva a las velas con la misma facilidad cuando quiera." },
        { title: "Ajuste la configuración específica del estilo", html: "Algunos estilos tienen sus propios ajustes. Renko pide un tamaño de bloque, Point and Figure usa un tamaño de casilla y una reversión, y TPO tiene sus propias opciones de perfil. Configúrelos a su gusto: los valores más pequeños muestran más detalle y los más grandes suavizan el gráfico. Son preferencias personales del gráfico, por lo que no afectarán a su cuenta, feed de datos ni contrato." },
      ],
    },
    { type: "heading",text: "Un par de cosas que conviene saber" },
    { type: "paragraph",html: "El estilo de gráfico se define por gráfico, así que puede usar velas en un panel y Renko en otro, uno junto al otro. Cuando guarda su espacio de trabajo, cada gráfico recuerda su propio estilo. Y como los estilos están integrados, no hay nada que instalar ni a lo que suscribirse: Renko, footprint y TPO están en el mismo menú desplegable que las velas normales." },
    { type: "quote",html: "Cambiar el estilo del gráfico es solo estético; su estrategia aún tiene que apretar el gatillo. Si prefiere que sus señales de TradingView lancen órdenes de Tradovate automáticamente mientras usted observa el estilo que elija, PickMyTrade automatiza el puente entre la alerta y la orden ejecutada." },
  ], fr: [
    { type: "paragraph",html: "Tradovate ouvre chaque graphique en chandeliers, mais ce n'est que l'un des huit styles intégrés à la plateforme web. Vous voulez des chandeliers Heikin Ashi lissés pour mieux lire la tendance, des briques Renko qui font abstraction du temps, ou un profil TPO pour voir où le prix a séjourné toute la journée ? Tout est à un bouton de distance. Voici où se trouve ce bouton et comment passer de l'un à l'autre sans perdre vos dessins." },
    { type: "heading",text: "Les huit styles de graphique intégrés" },
    { type: "paragraph",html: "Les graphiques s'affichent par défaut en chandeliers, mais le menu Chart Style propose huit options au total. Voici ce que chacune apporte et quand elle mérite sa place à l'écran." },
    { type: "table", headers: ["Style","Ce qu'il affiche / quand l'utiliser"], rows: [
      ["Candlesticks (default)","Barres standard ouverture/plus haut/plus bas/clôture avec un corps coloré et des mèches. La vue polyvalente sur laquelle la plupart des traders commencent."],
      ["OHLC","Graphique en barres traditionnel. Le trait gauche marque l'ouverture, le trait droit la clôture. Pratique si vous préférez ne pas regarder des corps pleins."],
      ["Line on Close","Une seule ligne reliant les cours de clôture. Épuré, idéal pour lire rapidement la direction ou pour des unités de temps supérieures."],
      ["Bid-Ask Volume","Barres de type footprint montrant le volume échangé au bid par rapport à l'ask dans chaque barre. Le détail du flux d'ordres intégré à la bougie."],
      ["Heiken-Ashi","Chandeliers moyennés qui lissent le bruit et facilitent le maintien d'une tendance. (Tradovate l'écrit \"Heiken-Ashi\" dans le menu.)"],
      ["Renko","Briques qui ne se forment que lorsque le prix évolue d'un montant défini. Le temps est ignoré : les phases sans direction se réduisent et les tendances ressortent."],
      ["Point and Figure","Colonnes de X et de O qui filtrent complètement les petits mouvements et le temps. Un classique pour réduire le bruit."],
      ["TPO (Market Profile)","Un profil basé sur des lettres montrant le temps passé par le prix à chaque niveau durant la séance."],
    ] },
    { type: "heading",text: "Comment changer de style de graphique" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir un graphique", html: "Dans l'application web Tradovate, ouvrez le module Chart et chargez le contrat souhaité, par exemple MNQ ou ES. Si aucun panneau de graphique n'est encore ouvert, ajoutez-en un d'abord à votre espace de travail." },
        { title: "Afficher le bouton Chart Style", html: "Déplacez votre curseur sur le haut du graphique. Une rangée de contrôles apparaît en fondu près des icônes d'unité de temps et d'indicateurs ; repérez le bouton Chart Style. Son emplacement exact peut changer d'une version de la plateforme à l'autre ; si vous ne le voyez pas tout de suite, parcourez la barre d'outils supérieure jusqu'à ce qu'une infobulle indique \"Chart Style\"." },
        { title: "Choisir un style dans la liste déroulante", html: "Cliquez sur Chart Style et la liste déroulante affiche les huit options. Cliquez sur celle que vous souhaitez et le graphique se redessine sur-le-champ, sans rechargement, et vos dessins et indicateurs restent en place. Revenez aux chandeliers aussi facilement quand vous le voulez." },
        { title: "Ajuster les paramètres propres au style", html: "Certains styles ont leurs propres réglages. Renko demande une taille de brique, Point and Figure utilise une taille de case et un renversement, et TPO a ses propres options de profil. Réglez-les à votre convenance : des valeurs plus petites donnent plus de détails, des valeurs plus grandes lissent davantage. Ce sont des préférences personnelles du graphique ; elles n'affectent donc ni votre compte, ni votre flux de données, ni votre contrat." },
      ],
    },
    { type: "heading",text: "Quelques points utiles à savoir" },
    { type: "paragraph",html: "Le style de graphique est défini par graphique ; vous pouvez donc afficher des chandeliers dans un panneau et du Renko dans un autre, côte à côte. Lorsque vous enregistrez votre espace de travail, chaque graphique conserve son propre style. Et comme les styles sont intégrés, il n'y a rien à installer ni à souscrire : Renko, footprint et TPO se trouvent dans la même liste déroulante que les chandeliers classiques." },
    { type: "quote",html: "Changer le style du graphique est purement esthétique ; votre stratégie doit tout de même appuyer sur la gâchette. Si vous préférez que vos signaux TradingView déclenchent automatiquement des ordres Tradovate pendant que vous observez le style de votre choix, PickMyTrade automatise le pont entre l'alerte et l'ordre exécuté." },
  ], it: [
    { type: "paragraph",html: "Tradovate apre ogni grafico come candele giapponesi, ma è solo uno degli otto stili integrati nella piattaforma web. Desidera candele Heikin Ashi attenuate per leggere meglio il trend, mattoncini Renko che eliminano il tempo, o un profilo TPO per vedere dove il prezzo si è fermato per tutta la giornata? Tutto è a un pulsante di distanza. Ecco dove si trova quel pulsante e come passare da uno stile all'altro senza perdere i Suoi disegni." },
    { type: "heading",text: "Gli otto stili di grafico integrati" },
    { type: "paragraph",html: "I grafici usano le candele per impostazione predefinita, ma il menu Chart Style contiene otto opzioni in totale. Ecco che cosa offre ciascuna e quando merita un posto sul Suo schermo." },
    { type: "table", headers: ["Stile","Cosa mostra / quando usarlo"], rows: [
      ["Candlesticks (default)","Barre standard apertura/massimo/minimo/chiusura con corpo colorato e ombre. La vista universale da cui partono la maggior parte dei trader."],
      ["OHLC","Grafico a barre tradizionale. Il trattino a sinistra indica l'apertura, quello a destra la chiusura. Utile se preferisce non guardare corpi pieni."],
      ["Line on Close","Una singola linea che unisce i prezzi di chiusura. Pulito, ottimo per una lettura rapida della direzione o per timeframe più alti."],
      ["Bid-Ask Volume","Barre in stile footprint che mostrano quanto è stato scambiato al bid rispetto all'ask all'interno di ogni barra. Il dettaglio dell'order flow integrato nella candela."],
      ["Heiken-Ashi","Candele mediate che attenuano il rumore e rendono un trend più facile da seguire. (Tradovate lo scrive \"Heiken-Ashi\" nel menu.)"],
      ["Renko","Mattoncini che si formano solo quando il prezzo si muove di una quantità stabilita. Il tempo viene ignorato, quindi le fasi laterali si riducono e i trend risaltano."],
      ["Point and Figure","Colonne di X e O che filtrano completamente i piccoli movimenti e il tempo. Un classico per ridurre il rumore."],
      ["TPO (Market Profile)","Un profilo basato su lettere che mostra quanto tempo il prezzo ha trascorso a ogni livello durante la sessione."],
    ] },
    { type: "heading",text: "Come cambiare lo stile del grafico" },
    {
      type: "steps",
      items: [
        { title: "Aprire un grafico", html: "Nell'app web di Tradovate, apra il modulo Chart e carichi il contratto desiderato, ad esempio MNQ o ES. Se non ha ancora un pannello grafico aperto, ne aggiunga prima uno al Suo workspace." },
        { title: "Mostrare il pulsante Chart Style", html: "Muova il cursore sulla parte superiore del grafico. Una riga di controlli compare in dissolvenza vicino alle icone di timeframe e indicatori: cerchi il pulsante Chart Style. La sua posizione esatta può cambiare tra una versione della piattaforma e l'altra, quindi se non lo vede subito, scorra la barra degli strumenti superiore finché un tooltip non riporta \"Chart Style\"." },
        { title: "Scegliere uno stile dal menu a discesa", html: "Clicchi su Chart Style e il menu a discesa elenca tutte e otto le opzioni. Clicchi su quella che desidera e il grafico si ridisegna all'istante, senza ricaricare, mentre i Suoi disegni e indicatori restano al loro posto. Torni alle candele con la stessa facilità quando vuole." },
        { title: "Regolare le impostazioni specifiche dello stile", html: "Alcuni stili hanno impostazioni proprie. Renko richiede una dimensione del mattoncino, Point and Figure usa una dimensione del box e un'inversione, e TPO ha le proprie opzioni di profilo. Le imposti a piacere: valori più piccoli mostrano più dettaglio, valori più grandi attenuano il grafico. Sono preferenze personali del grafico, quindi non incidono sul Suo conto, sul feed dati o sul contratto." },
      ],
    },
    { type: "heading",text: "Un paio di cose utili da sapere" },
    { type: "paragraph",html: "Lo stile del grafico è impostato per singolo grafico, quindi può usare le candele in un pannello e Renko in un altro, affiancati. Quando salva il workspace, ogni grafico ricorda il proprio stile. E poiché gli stili sono integrati, non c'è nulla da installare o a cui abbonarsi: Renko, footprint e TPO si trovano nello stesso menu a discesa delle normali candele." },
    { type: "quote",html: "Cambiare lo stile del grafico è solo estetico: la Sua strategia deve comunque premere il grilletto. Se preferisce che i Suoi segnali di TradingView facciano partire automaticamente gli ordini Tradovate mentre osserva lo stile che preferisce, PickMyTrade automatizza il ponte tra alert e ordine eseguito." },
  ] },
