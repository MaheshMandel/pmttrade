---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-tick-size-value";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Tradovate Tick Size & Tick Value Reference";
const META_DESCRIPTION =
  "Look up per-contract tick size and tick value for any futures market, then turn ticks into dollars for precise stop and position sizing.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate Tick-Größe und Tick-Wert im Überblick", es: "Referencia del tamaño y valor del tick en Tradovate", fr: "Référence de la taille et de la valeur du tick sur Tradovate", it: "Riferimento su dimensione e valore del tick su Tradovate" },
  dek: { en: "Mix up tick size and tick value and a stop you thought risked $150 quietly risks $600. Here's where Tradovate lists both for any contract, and how to turn them into real dollar risk.", de: "Verwechseln Sie Tick-Größe und Tick-Wert, riskiert ein Stop, den Sie bei 150 $ wähnten, still und leise 600 $. Hier erfahren Sie, wo Tradovate beides für jeden Kontrakt auflistet und wie Sie daraus das echte Risiko in Dollar berechnen.", es: "Si confunde el tamaño del tick con su valor, un stop que creía que arriesgaba $150 arriesga en silencio $600. Aquí verá dónde enumera Tradovate ambos datos para cualquier contrato y cómo convertirlos en riesgo real en dólares.", fr: "Si vous confondez taille et valeur du tick, un stop que vous pensiez risquer 150 $ en risque discrètement 600 $. Voici où Tradovate indique les deux pour n'importe quel contrat, et comment les convertir en risque réel en dollars.", it: "Se confonde dimensione e valore del tick, uno stop che pensava rischiasse $150 ne rischia in silenzio $600. Ecco dove Tradovate riporta entrambi i dati per qualsiasi contratto e come trasformarli in rischio reale in dollari." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-10",
  blocks: { en: [
    { type: "paragraph", html: "Every futures contract moves in fixed price increments, and each increment is worth a set dollar amount. Mix those two numbers up and a stop you thought risked $150 quietly risks $600. This guide shows you where Tradovate lists the tick size and tick value for any contract, and how to turn them into real dollar risk before you click Buy or Sell." },
    { type: "heading", text: "Tick Size vs. Tick Value" },
    { type: "paragraph", html: "<strong class='text-white'>Tick size</strong> is the smallest price increment a contract is allowed to move. ES (the E-mini S&amp;P 500) ticks in 0.25-point steps, so a move from 5,510.00 to 5,510.25 is exactly one tick. <strong class='text-white'>Tick value</strong> is what that single tick is worth in your account. For ES, one tick equals $12.50." },
    { type: "paragraph", html: "Both numbers are fixed by the exchange that lists the contract (CME, NYMEX, COMEX, and so on), not by Tradovate and not by your broker or prop firm. That's why the tick size and tick value for a given symbol are identical everywhere it trades. You can look them up once and trust them." },
    { type: "heading", text: "The Formula Behind Tick Value" },
    { type: "paragraph", html: "Tick value comes from two things: the tick size and the contract's point value (its multiplier)." },
    { type: "quote", html: "Tick value = tick size &times; contract point value" },
    { type: "paragraph", html: "ES works out to 0.25 &times; $50 = $12.50. NQ uses a $20 multiplier, so 0.25 &times; $20 = $5.00. Micro contracts are usually one-tenth of the mini they track, and nanos one-tenth of the micro again. That's why MES is $1.25 a tick against ES's $12.50. Same market, smaller bite." },
    { type: "heading", text: "How to Look Up Tick Size and Tick Value in Tradovate" },
    {
      type: "steps",
      items: [
        { title: "Open the Contract's Details", html: "In the Tradovate web or desktop app, type the contract symbol into the <strong class='text-white'>instrument search</strong> and open its <strong class='text-white'>contract information</strong> panel. The platform lists the specs for the exact contract month you're about to trade, so you're reading the live front-month rather than a generic placeholder.", image: { src: `${IMG}/tradovate-tick-size-value-1.png`, alt: "Tradovate instrument search with a futures contract's information panel open showing its specifications" } },
        { title: "Or Check the Margins for Available Markets and Contracts Page", html: "Tradovate also publishes tick data outside the trading screen. Head to the <strong class='text-white'>Margins for Available Markets and Contracts</strong> reference page and search for your instrument. It's the fastest way to compare symbols side by side and see the tick size and tick value alongside each one's margin requirement.", image: { src: `${IMG}/tradovate-tick-size-value-2.png`, alt: "Tradovate Margins for Available Markets and Contracts page listing tick size, tick value, and margin for a searched instrument" } },
        { title: "Read the Tick Size and Tick Value", html: "Pull the two numbers off the page. The <strong class='text-white'>tick size</strong> tells you how far price moves per tick; the <strong class='text-white'>tick value</strong> tells you what that tick is worth in dollars. Once you know a single ES tick is $12.50, the math on every stop and target gets a lot faster.", image: { src: `${IMG}/tradovate-tick-size-value-3.png`, alt: "Close-up of a Tradovate contract spec showing the tick size and tick value fields highlighted" } },
        { title: "Convert Ticks Into Dollar Risk", html: "Now do the part that actually protects your account. Multiply your stop distance in ticks by the tick value, then by how many contracts you're carrying. Say you're short two NQ with a 40-tick stop: 40 &times; $5.00 &times; 2 = $400 at risk. Run the same math on your target and you've got your reward-to-risk before the order leaves the DOM.", image: { src: `${IMG}/tradovate-tick-size-value-4.png`, alt: "Worked example converting a stop distance in ticks into dollar risk using tick value and contract count" } },
      ],
    },
    { type: "quote", html: "Ticks of stop &times; tick value &times; contracts = dollar risk" },
    { type: "heading", text: "Common Tradovate Contracts: Tick Reference" },
    { type: "paragraph", html: "Here are the tick specs for some of the most-traded futures on Tradovate. Micros sit right beside the mini they track so you can see the ten-to-one relationship at a glance." },
    {
      type: "table",
      headers: ["Contract", "Symbol", "Tick size", "Tick value"],
      rows: [
        ["E-mini S&P 500", "ES", "0.25 points", "$12.50"],
        ["Micro E-mini S&P 500", "MES", "0.25 points", "$1.25"],
        ["E-mini Nasdaq-100", "NQ", "0.25 points", "$5.00"],
        ["Micro E-mini Nasdaq-100", "MNQ", "0.25 points", "$0.50"],
        ["Crude Oil", "CL", "$0.01", "$10.00"],
        ["Micro WTI Crude Oil", "MCL", "$0.01", "$1.00"],
        ["Gold", "GC", "$0.10", "$10.00"],
        ["Micro Gold", "MGC", "$0.10", "$1.00"],
      ],
    },
    { type: "paragraph", html: "Every other symbol follows the same lookup, so check a new market's specs first instead of assuming they match a contract you already trade." },
    { type: "heading", text: "Why Tick Value Drives Your Position Sizing" },
    { type: "paragraph", html: "Tick value is the number that connects your chart stop to your account balance. Decide the dollars you're willing to lose, divide by the tick value, and you've got your maximum stop in ticks. Fix the stop first instead, and tick value tells you how many contracts fit your risk budget." },
    { type: "paragraph", html: "This matters even more on a prop-firm evaluation, where the daily loss limit and trailing drawdown are hard walls. Those limits vary by firm and account size, so check your firm's current rules and size every position against the tick value, not a gut feel for how far price \"usually\" moves." },
    { type: "heading", text: "Automate the Sizing with PickMyTrade" },
    { type: "paragraph", html: "Once you know a contract's tick value, you can hand the execution off. PickMyTrade routes your TradingView alerts straight into Tradovate and places each entry with its stop and target attached, turning your risk-per-tick math into a real bracket the instant a signal fires." },
  ], de: [
    { type: "paragraph",html: "Jeder Futures-Kontrakt bewegt sich in festen Preisschritten, und jeder Schritt ist einen festgelegten Dollarbetrag wert. Verwechseln Sie diese beiden Zahlen, riskiert ein Stop, von dem Sie 150 $ erwartet haben, still und leise 600 $. Dieser Leitfaden zeigt Ihnen, wo Tradovate die Tick-Größe und den Tick-Wert für jeden Kontrakt auflistet und wie Sie daraus das echte Dollar-Risiko berechnen, bevor Sie auf Buy oder Sell klicken." },
    { type: "heading",text: "Tick-Größe vs. Tick-Wert" },
    { type: "paragraph",html: "Die <strong class='text-white'>Tick-Größe</strong> ist der kleinste Preisschritt, um den sich ein Kontrakt bewegen darf. ES (der E-mini S&amp;P 500) bewegt sich in Schritten von 0.25 Punkten, sodass ein Anstieg von 5,510.00 auf 5,510.25 genau einen Tick entspricht. Der <strong class='text-white'>Tick-Wert</strong> ist das, was dieser einzelne Tick auf Ihrem Konto wert ist. Bei ES entspricht ein Tick $12.50." },
    { type: "paragraph",html: "Beide Zahlen werden von der Börse festgelegt, an der der Kontrakt gelistet ist (CME, NYMEX, COMEX usw.), nicht von Tradovate, Ihrem Broker oder Ihrer Prop-Firma. Deshalb sind Tick-Größe und Tick-Wert eines Symbols überall identisch, wo es gehandelt wird. Sie können die Werte einmal nachschlagen und sich darauf verlassen." },
    { type: "heading",text: "Die Formel hinter dem Tick-Wert" },
    { type: "paragraph",html: "Der Tick-Wert ergibt sich aus zwei Größen: der Tick-Größe und dem Punktwert des Kontrakts (seinem Multiplikator)." },
    { type: "quote",html: "Tick-Wert = Tick-Größe &times; Punktwert des Kontrakts" },
    { type: "paragraph",html: "Bei ES ergibt das 0.25 &times; $50 = $12.50. NQ nutzt einen Multiplikator von $20, also 0.25 &times; $20 = $5.00. Micro-Kontrakte entsprechen in der Regel einem Zehntel des Mini, den sie abbilden, und Nano-Kontrakte wiederum einem Zehntel des Micro. Deshalb beträgt MES $1.25 pro Tick gegenüber $12.50 bei ES. Derselbe Markt, nur ein kleinerer Happen." },
    { type: "heading",text: "So finden Sie Tick-Größe und Tick-Wert in Tradovate" },
    {
      type: "steps",
      items: [
        { title: "Details des Kontrakts öffnen", html: "Geben Sie in der Tradovate-Web- oder Desktop-App das Kontraktsymbol in die <strong class='text-white'>Instrumentensuche</strong> ein und öffnen Sie das Fenster mit den <strong class='text-white'>Kontraktinformationen</strong>. Die Plattform listet die Spezifikationen für genau den Kontraktmonat auf, den Sie handeln möchten. Sie lesen also den aktuellen Frontmonat und keinen allgemeinen Platzhalter.", image: {"src":`${IMG}/tradovate-tick-size-value-1.png`,"alt":"Tradovate-Instrumentensuche mit geöffnetem Informationsfenster eines Futures-Kontrakts und seinen Spezifikationen"} },
        { title: "Oder die Seite „Margins for Available Markets and Contracts“ prüfen", html: "Tradovate veröffentlicht Tick-Daten auch außerhalb des Handelsbildschirms. Rufen Sie die Referenzseite <strong class='text-white'>Margins for Available Markets and Contracts</strong> auf und suchen Sie Ihr Instrument. So vergleichen Sie Symbole am schnellsten nebeneinander und sehen Tick-Größe und Tick-Wert zusammen mit der jeweiligen Margin-Anforderung.", image: {"src":`${IMG}/tradovate-tick-size-value-2.png`,"alt":"Tradovate-Seite Margins for Available Markets and Contracts mit Tick-Größe, Tick-Wert und Margin für ein gesuchtes Instrument"} },
        { title: "Tick-Größe und Tick-Wert ablesen", html: "Entnehmen Sie der Seite die beiden Zahlen. Die <strong class='text-white'>Tick-Größe</strong> sagt Ihnen, wie weit sich der Preis pro Tick bewegt; der <strong class='text-white'>Tick-Wert</strong> sagt Ihnen, was dieser Tick in Dollar wert ist. Wenn Sie wissen, dass ein ES-Tick $12.50 beträgt, geht die Rechnung für jeden Stop und jedes Ziel deutlich schneller.", image: {"src":`${IMG}/tradovate-tick-size-value-3.png`,"alt":"Nahaufnahme einer Tradovate-Kontraktspezifikation mit hervorgehobenen Feldern für Tick-Größe und Tick-Wert"} },
        { title: "Ticks in Dollar-Risiko umrechnen", html: "Jetzt folgt der Teil, der Ihr Konto tatsächlich schützt. Multiplizieren Sie den Stop-Abstand in Ticks mit dem Tick-Wert und dann mit der Anzahl Ihrer Kontrakte. Angenommen, Sie sind mit zwei NQ short und haben einen Stop von 40 Ticks: 40 &times; $5.00 &times; 2 = $400 Risiko. Rechnen Sie dasselbe für Ihr Ziel, und Sie kennen Ihr Chance-Risiko-Verhältnis, bevor die Order das DOM verlässt.", image: {"src":`${IMG}/tradovate-tick-size-value-4.png`,"alt":"Rechenbeispiel: Umrechnung eines Stop-Abstands in Ticks in Dollar-Risiko anhand von Tick-Wert und Kontraktanzahl"} },
      ],
    },
    { type: "quote",html: "Stop in Ticks &times; Tick-Wert &times; Kontrakte = Dollar-Risiko" },
    { type: "heading",text: "Gängige Tradovate-Kontrakte: Tick-Übersicht" },
    { type: "paragraph",html: "Hier finden Sie die Tick-Spezifikationen einiger der meistgehandelten Futures bei Tradovate. Die Micros stehen direkt neben dem Mini, den sie abbilden, sodass Sie das Zehn-zu-eins-Verhältnis auf einen Blick erkennen." },
    { type: "table", headers: ["Kontrakt","Symbol","Tick-Größe","Tick-Wert"], rows: [
      ["E-mini S&P 500","ES","0.25 Punkte","$12.50"],
      ["Micro E-mini S&P 500","MES","0.25 Punkte","$1.25"],
      ["E-mini Nasdaq-100","NQ","0.25 Punkte","$5.00"],
      ["Micro E-mini Nasdaq-100","MNQ","0.25 Punkte","$0.50"],
      ["Rohöl","CL","$0.01","$10.00"],
      ["Micro-WTI-Rohöl","MCL","$0.01","$1.00"],
      ["Gold","GC","$0.10","$10.00"],
      ["Micro-Gold","MGC","$0.10","$1.00"],
    ] },
    { type: "paragraph",html: "Jedes andere Symbol lässt sich auf dieselbe Weise nachschlagen. Prüfen Sie daher die Spezifikationen eines neuen Marktes zuerst, statt anzunehmen, sie stimmten mit einem Kontrakt überein, den Sie bereits handeln." },
    { type: "heading",text: "Warum der Tick-Wert Ihre Positionsgröße bestimmt" },
    { type: "paragraph",html: "Der Tick-Wert ist die Zahl, die Ihren Chart-Stop mit Ihrem Kontostand verbindet. Legen Sie fest, wie viele Dollar Sie bereit sind zu verlieren, teilen Sie durch den Tick-Wert, und Sie erhalten Ihren maximalen Stop in Ticks. Legen Sie stattdessen zuerst den Stop fest, zeigt Ihnen der Tick-Wert, wie viele Kontrakte in Ihr Risikobudget passen." },
    { type: "paragraph",html: "Das ist bei einer Prop-Firm-Evaluation noch wichtiger, denn das tägliche Verlustlimit und der Trailing Drawdown sind harte Grenzen. Diese Limits unterscheiden sich je nach Firma und Kontogröße. Prüfen Sie daher die aktuellen Regeln Ihrer Firma und bemessen Sie jede Position am Tick-Wert statt an einem Bauchgefühl dafür, wie weit sich der Preis „üblicherweise“ bewegt." },
    { type: "heading",text: "Positionsgrößen automatisieren mit PickMyTrade" },
    { type: "paragraph",html: "Sobald Sie den Tick-Wert eines Kontrakts kennen, können Sie die Ausführung abgeben. PickMyTrade leitet Ihre TradingView-Alarme direkt an Tradovate weiter und platziert jede Order mit angehängtem Stop und Ziel. So wird Ihre Risikorechnung pro Tick in dem Moment zu einem echten Bracket, in dem ein Signal ausgelöst wird." },
  ], es: [
    { type: "paragraph",html: "Todo contrato de futuros se mueve en incrementos de precio fijos, y cada incremento vale una cantidad determinada de dólares. Si confunde esas dos cifras, un stop que creía que arriesgaba $150 arriesga en silencio $600. Esta guía le muestra dónde enumera Tradovate el tamaño y el valor del tick de cualquier contrato, y cómo convertirlos en riesgo real en dólares antes de pulsar Buy o Sell." },
    { type: "heading",text: "Tamaño del tick frente a valor del tick" },
    { type: "paragraph",html: "El <strong class='text-white'>tamaño del tick</strong> es el incremento de precio más pequeño que puede recorrer un contrato. ES (el E-mini S&amp;P 500) se mueve en pasos de 0.25 puntos, de modo que pasar de 5,510.00 a 5,510.25 es exactamente un tick. El <strong class='text-white'>valor del tick</strong> es lo que vale ese único tick en su cuenta. En ES, un tick equivale a $12.50." },
    { type: "paragraph",html: "Ambas cifras las fija la bolsa que lista el contrato (CME, NYMEX, COMEX, etc.), no Tradovate, ni su bróker ni su prop firm. Por eso el tamaño y el valor del tick de un símbolo son idénticos en todos los lugares donde se negocia. Puede consultarlos una vez y fiarse de ellos." },
    { type: "heading",text: "La fórmula detrás del valor del tick" },
    { type: "paragraph",html: "El valor del tick surge de dos datos: el tamaño del tick y el valor por punto del contrato (su multiplicador)." },
    { type: "quote",html: "Valor del tick = tamaño del tick &times; valor por punto del contrato" },
    { type: "paragraph",html: "En ES resulta 0.25 &times; $50 = $12.50. NQ usa un multiplicador de $20, así que 0.25 &times; $20 = $5.00. Los contratos micro suelen ser una décima parte del mini que replican, y los nano, una décima parte del micro. Por eso MES vale $1.25 por tick frente a los $12.50 de ES. Mismo mercado, bocado más pequeño." },
    { type: "heading",text: "Cómo consultar el tamaño y el valor del tick en Tradovate" },
    {
      type: "steps",
      items: [
        { title: "Abra los detalles del contrato", html: "En la aplicación web o de escritorio de Tradovate, escriba el símbolo del contrato en la <strong class='text-white'>búsqueda de instrumentos</strong> y abra su panel de <strong class='text-white'>información del contrato</strong>. La plataforma muestra las especificaciones del mes de contrato exacto que va a operar, así que lee el contrato vigente y no un marcador genérico.", image: {"src":`${IMG}/tradovate-tick-size-value-1.png`,"alt":"Búsqueda de instrumentos de Tradovate con el panel de información de un contrato de futuros abierto y sus especificaciones"} },
        { title: "O consulte la página Margins for Available Markets and Contracts", html: "Tradovate también publica datos de ticks fuera de la pantalla de trading. Vaya a la página de referencia <strong class='text-white'>Margins for Available Markets and Contracts</strong> y busque su instrumento. Es la forma más rápida de comparar símbolos en paralelo y ver el tamaño y el valor del tick junto al requisito de margen de cada uno.", image: {"src":`${IMG}/tradovate-tick-size-value-2.png`,"alt":"Página Margins for Available Markets and Contracts de Tradovate con el tamaño del tick, el valor del tick y el margen de un instrumento buscado"} },
        { title: "Lea el tamaño y el valor del tick", html: "Tome las dos cifras de la página. El <strong class='text-white'>tamaño del tick</strong> le indica cuánto se mueve el precio por tick; el <strong class='text-white'>valor del tick</strong> le indica cuánto vale ese tick en dólares. Cuando sabe que un tick de ES vale $12.50, el cálculo de cada stop y cada objetivo resulta mucho más rápido.", image: {"src":`${IMG}/tradovate-tick-size-value-3.png`,"alt":"Primer plano de las especificaciones de un contrato de Tradovate con los campos de tamaño y valor del tick resaltados"} },
        { title: "Convierta los ticks en riesgo en dólares", html: "Ahora viene la parte que realmente protege su cuenta. Multiplique la distancia de su stop en ticks por el valor del tick y luego por el número de contratos que lleva. Supongamos que está en corto con dos NQ y un stop de 40 ticks: 40 &times; $5.00 &times; 2 = $400 en riesgo. Haga el mismo cálculo con su objetivo y tendrá su relación recompensa-riesgo antes de que la orden salga del DOM.", image: {"src":`${IMG}/tradovate-tick-size-value-4.png`,"alt":"Ejemplo práctico de conversión de la distancia de un stop en ticks a riesgo en dólares usando el valor del tick y el número de contratos"} },
      ],
    },
    { type: "quote",html: "Ticks de stop &times; valor del tick &times; contratos = riesgo en dólares" },
    { type: "heading",text: "Contratos habituales de Tradovate: referencia de ticks" },
    { type: "paragraph",html: "Estas son las especificaciones de tick de algunos de los futuros más negociados en Tradovate. Los micros aparecen junto al mini que replican para que vea de un vistazo la relación de diez a uno." },
    { type: "table", headers: ["Contrato","Símbolo","Tamaño del tick","Valor del tick"], rows: [
      ["E-mini S&P 500","ES","0.25 puntos","$12.50"],
      ["Micro E-mini S&P 500","MES","0.25 puntos","$1.25"],
      ["E-mini Nasdaq-100","NQ","0.25 puntos","$5.00"],
      ["Micro E-mini Nasdaq-100","MNQ","0.25 puntos","$0.50"],
      ["Petróleo crudo","CL","$0.01","$10.00"],
      ["Micro petróleo crudo WTI","MCL","$0.01","$1.00"],
      ["Oro","GC","$0.10","$10.00"],
      ["Micro oro","MGC","$0.10","$1.00"],
    ] },
    { type: "paragraph",html: "Cualquier otro símbolo se consulta de la misma manera, así que revise primero las especificaciones de un mercado nuevo en lugar de suponer que coinciden con las de un contrato que ya opera." },
    { type: "heading",text: "Por qué el valor del tick determina el tamaño de su posición" },
    { type: "paragraph",html: "El valor del tick es la cifra que conecta el stop de su gráfico con el saldo de su cuenta. Decida los dólares que está dispuesto a perder, divídalos entre el valor del tick y obtendrá su stop máximo en ticks. Si fija primero el stop, el valor del tick le indica cuántos contratos caben en su presupuesto de riesgo." },
    { type: "paragraph",html: "Esto importa aún más en una evaluación de prop firm, donde el límite de pérdida diaria y el drawdown trailing son muros infranqueables. Esos límites varían según la firma y el tamaño de la cuenta, así que revise las reglas vigentes de su firma y dimensione cada posición según el valor del tick, no según una intuición de cuánto \"suele\" moverse el precio." },
    { type: "heading",text: "Automatice el dimensionamiento con PickMyTrade" },
    { type: "paragraph",html: "Cuando conozca el valor del tick de un contrato, puede delegar la ejecución. PickMyTrade envía sus alertas de TradingView directamente a Tradovate y coloca cada entrada con su stop y su objetivo adjuntos, convirtiendo su cálculo de riesgo por tick en un bracket real en el instante en que salta una señal." },
  ], fr: [
    { type: "paragraph",html: "Chaque contrat à terme évolue par incréments de prix fixes, et chaque incrément vaut un montant précis en dollars. Confondez ces deux chiffres et un stop que vous pensiez risquer 150 $ en risque discrètement 600 $. Ce guide vous montre où Tradovate indique la taille et la valeur du tick de n'importe quel contrat, et comment les convertir en risque réel en dollars avant de cliquer sur Buy ou Sell." },
    { type: "heading",text: "Taille du tick et valeur du tick" },
    { type: "paragraph",html: "La <strong class='text-white'>taille du tick</strong> est le plus petit incrément de prix qu'un contrat peut parcourir. L'ES (l'E-mini S&amp;P 500) évolue par pas de 0.25 point ; passer de 5,510.00 à 5,510.25 représente donc exactement un tick. La <strong class='text-white'>valeur du tick</strong> est ce que vaut ce tick unique sur votre compte. Pour l'ES, un tick équivaut à $12.50." },
    { type: "paragraph",html: "Ces deux chiffres sont fixés par la bourse qui cote le contrat (CME, NYMEX, COMEX, etc.), et non par Tradovate, ni par votre courtier ou votre prop firm. C'est pourquoi la taille et la valeur du tick d'un symbole sont identiques partout où il se négocie. Vous pouvez les consulter une fois et vous y fier." },
    { type: "heading",text: "La formule derrière la valeur du tick" },
    { type: "paragraph",html: "La valeur du tick découle de deux éléments : la taille du tick et la valeur du point du contrat (son multiplicateur)." },
    { type: "quote",html: "Valeur du tick = taille du tick &times; valeur du point du contrat" },
    { type: "paragraph",html: "Pour l'ES, cela donne 0.25 &times; $50 = $12.50. Le NQ utilise un multiplicateur de $20, soit 0.25 &times; $20 = $5.00. Les contrats micro valent généralement un dixième du mini qu'ils suivent, et les nano un dixième du micro. C'est pourquoi le MES vaut $1.25 par tick contre $12.50 pour l'ES. Même marché, simplement une plus petite bouchée." },
    { type: "heading",text: "Comment consulter la taille et la valeur du tick dans Tradovate" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez les détails du contrat", html: "Dans l'application web ou de bureau Tradovate, saisissez le symbole du contrat dans la <strong class='text-white'>recherche d'instruments</strong> et ouvrez son panneau d'<strong class='text-white'>informations sur le contrat</strong>. La plateforme affiche les spécifications du mois de contrat exact que vous vous apprêtez à négocier ; vous lisez donc le contrat en cours et non un espace réservé générique.", image: {"src":`${IMG}/tradovate-tick-size-value-1.png`,"alt":"Recherche d'instruments Tradovate avec le panneau d'informations d'un contrat à terme ouvert, affichant ses spécifications"} },
        { title: "Ou consultez la page Margins for Available Markets and Contracts", html: "Tradovate publie aussi des données de ticks en dehors de l'écran de trading. Rendez-vous sur la page de référence <strong class='text-white'>Margins for Available Markets and Contracts</strong> et recherchez votre instrument. C'est le moyen le plus rapide de comparer des symboles côte à côte et de voir la taille et la valeur du tick à côté de l'exigence de marge de chacun.", image: {"src":`${IMG}/tradovate-tick-size-value-2.png`,"alt":"Page Margins for Available Markets and Contracts de Tradovate indiquant la taille du tick, la valeur du tick et la marge d'un instrument recherché"} },
        { title: "Lisez la taille et la valeur du tick", html: "Relevez les deux chiffres sur la page. La <strong class='text-white'>taille du tick</strong> vous indique de combien le prix bouge par tick ; la <strong class='text-white'>valeur du tick</strong> vous indique ce que vaut ce tick en dollars. Une fois que vous savez qu'un tick d'ES vaut $12.50, le calcul de chaque stop et de chaque objectif devient bien plus rapide.", image: {"src":`${IMG}/tradovate-tick-size-value-3.png`,"alt":"Gros plan sur les spécifications d'un contrat Tradovate avec les champs taille du tick et valeur du tick mis en évidence"} },
        { title: "Convertissez les ticks en risque en dollars", html: "Passons maintenant à l'étape qui protège réellement votre compte. Multipliez la distance de votre stop en ticks par la valeur du tick, puis par le nombre de contrats détenus. Supposons que vous soyez vendeur de deux NQ avec un stop de 40 ticks : 40 &times; $5.00 &times; 2 = $400 de risque. Faites le même calcul pour votre objectif et vous obtenez votre ratio rendement/risque avant que l'ordre ne quitte le DOM.", image: {"src":`${IMG}/tradovate-tick-size-value-4.png`,"alt":"Exemple chiffré de conversion d'une distance de stop en ticks en risque en dollars à partir de la valeur du tick et du nombre de contrats"} },
      ],
    },
    { type: "quote",html: "Ticks de stop &times; valeur du tick &times; contrats = risque en dollars" },
    { type: "heading",text: "Contrats Tradovate courants : référence des ticks" },
    { type: "paragraph",html: "Voici les spécifications de tick de certains des contrats à terme les plus négociés sur Tradovate. Les micros figurent juste à côté du mini qu'ils suivent afin que vous voyiez d'un coup d'œil le rapport de dix pour un." },
    { type: "table", headers: ["Contrat","Symbole","Taille du tick","Valeur du tick"], rows: [
      ["E-mini S&P 500","ES","0.25 point","$12.50"],
      ["Micro E-mini S&P 500","MES","0.25 point","$1.25"],
      ["E-mini Nasdaq-100","NQ","0.25 point","$5.00"],
      ["Micro E-mini Nasdaq-100","MNQ","0.25 point","$0.50"],
      ["Pétrole brut","CL","$0.01","$10.00"],
      ["Micro pétrole brut WTI","MCL","$0.01","$1.00"],
      ["Or","GC","$0.10","$10.00"],
      ["Micro or","MGC","$0.10","$1.00"],
    ] },
    { type: "paragraph",html: "Tout autre symbole se consulte de la même façon ; vérifiez donc d'abord les spécifications d'un nouveau marché au lieu de supposer qu'elles correspondent à celles d'un contrat que vous négociez déjà." },
    { type: "heading",text: "Pourquoi la valeur du tick détermine la taille de vos positions" },
    { type: "paragraph",html: "La valeur du tick est le chiffre qui relie le stop de votre graphique au solde de votre compte. Fixez le montant en dollars que vous acceptez de perdre, divisez-le par la valeur du tick, et vous obtenez votre stop maximal en ticks. Si vous fixez d'abord le stop, la valeur du tick vous indique combien de contrats tiennent dans votre budget de risque." },
    { type: "paragraph",html: "Cela compte encore davantage lors d'une évaluation prop firm, où la limite de perte quotidienne et le drawdown suiveur sont des murs infranchissables. Ces limites varient selon la firme et la taille du compte ; vérifiez donc les règles actuelles de votre firme et dimensionnez chaque position d'après la valeur du tick, et non d'après une intuition de la distance que le prix parcourt « habituellement »." },
    { type: "heading",text: "Automatisez le dimensionnement avec PickMyTrade" },
    { type: "paragraph",html: "Une fois la valeur du tick d'un contrat connue, vous pouvez déléguer l'exécution. PickMyTrade achemine vos alertes TradingView directement vers Tradovate et place chaque entrée avec son stop et son objectif associés, transformant votre calcul de risque par tick en un véritable bracket dès qu'un signal se déclenche." },
  ], it: [
    { type: "paragraph",html: "Ogni contratto future si muove per incrementi di prezzo fissi, e ogni incremento vale un importo preciso in dollari. Se confonde questi due numeri, uno stop che pensava rischiasse $150 ne rischia in silenzio $600. Questa guida le mostra dove Tradovate riporta dimensione e valore del tick di qualsiasi contratto e come trasformarli in rischio reale in dollari prima di cliccare su Buy o Sell." },
    { type: "heading",text: "Dimensione del tick e valore del tick" },
    { type: "paragraph",html: "La <strong class='text-white'>dimensione del tick</strong> è il più piccolo incremento di prezzo che un contratto può compiere. ES (l'E-mini S&amp;P 500) si muove a passi di 0.25 punti, quindi passare da 5,510.00 a 5,510.25 equivale esattamente a un tick. Il <strong class='text-white'>valore del tick</strong> è quanto vale quel singolo tick sul suo conto. Per ES, un tick equivale a $12.50." },
    { type: "paragraph",html: "Entrambi i numeri sono fissati dalla borsa che quota il contratto (CME, NYMEX, COMEX e così via), non da Tradovate, né dal suo broker o dalla sua prop firm. Per questo dimensione e valore del tick di un dato simbolo sono identici ovunque venga negoziato. Può consultarli una volta sola e fidarsene." },
    { type: "heading",text: "La formula alla base del valore del tick" },
    { type: "paragraph",html: "Il valore del tick deriva da due elementi: la dimensione del tick e il valore del punto del contratto (il suo moltiplicatore)." },
    { type: "quote",html: "Valore del tick = dimensione del tick &times; valore del punto del contratto" },
    { type: "paragraph",html: "Per ES il risultato è 0.25 &times; $50 = $12.50. NQ usa un moltiplicatore di $20, quindi 0.25 &times; $20 = $5.00. I contratti micro valgono di solito un decimo del mini che replicano, e i nano un decimo del micro. Per questo MES vale $1.25 a tick contro i $12.50 di ES. Stesso mercato, boccone più piccolo." },
    { type: "heading",text: "Come trovare dimensione e valore del tick in Tradovate" },
    {
      type: "steps",
      items: [
        { title: "Apra i dettagli del contratto", html: "Nell'app web o desktop di Tradovate, digiti il simbolo del contratto nella <strong class='text-white'>ricerca strumenti</strong> e apra il suo pannello <strong class='text-white'>informazioni sul contratto</strong>. La piattaforma riporta le specifiche del mese di contratto esatto che sta per negoziare, quindi legge il contratto front-month in corso e non un segnaposto generico.", image: {"src":`${IMG}/tradovate-tick-size-value-1.png`,"alt":"Ricerca strumenti di Tradovate con il pannello informativo di un contratto future aperto e le relative specifiche"} },
        { title: "Oppure consulti la pagina Margins for Available Markets and Contracts", html: "Tradovate pubblica i dati sui tick anche al di fuori della schermata di trading. Vada alla pagina di riferimento <strong class='text-white'>Margins for Available Markets and Contracts</strong> e cerchi il suo strumento. È il modo più rapido per confrontare i simboli affiancati e vedere dimensione e valore del tick accanto al requisito di margine di ciascuno.", image: {"src":`${IMG}/tradovate-tick-size-value-2.png`,"alt":"Pagina Margins for Available Markets and Contracts di Tradovate con dimensione del tick, valore del tick e margine di uno strumento cercato"} },
        { title: "Legga dimensione e valore del tick", html: "Prenda i due numeri dalla pagina. La <strong class='text-white'>dimensione del tick</strong> le dice di quanto si muove il prezzo per tick; il <strong class='text-white'>valore del tick</strong> le dice quanto vale quel tick in dollari. Una volta che sa che un tick di ES vale $12.50, il calcolo di ogni stop e di ogni target diventa molto più rapido.", image: {"src":`${IMG}/tradovate-tick-size-value-3.png`,"alt":"Primo piano delle specifiche di un contratto Tradovate con i campi dimensione e valore del tick evidenziati"} },
        { title: "Converta i tick in rischio in dollari", html: "Ora viene la parte che protegge davvero il suo conto. Moltiplichi la distanza del suo stop in tick per il valore del tick, poi per il numero di contratti che detiene. Supponga di essere short su due NQ con uno stop di 40 tick: 40 &times; $5.00 &times; 2 = $400 a rischio. Faccia lo stesso calcolo sul target e avrà il suo rapporto rendimento/rischio prima che l'ordine lasci il DOM.", image: {"src":`${IMG}/tradovate-tick-size-value-4.png`,"alt":"Esempio pratico di conversione della distanza di uno stop in tick in rischio in dollari usando valore del tick e numero di contratti"} },
      ],
    },
    { type: "quote",html: "Tick di stop &times; valore del tick &times; contratti = rischio in dollari" },
    { type: "heading",text: "Contratti Tradovate più comuni: riferimento sui tick" },
    { type: "paragraph",html: "Ecco le specifiche dei tick di alcuni dei futures più negoziati su Tradovate. I micro sono posizionati accanto al mini che replicano, così può vedere a colpo d'occhio il rapporto di dieci a uno." },
    { type: "table", headers: ["Contratto","Simbolo","Dimensione del tick","Valore del tick"], rows: [
      ["E-mini S&P 500","ES","0.25 punti","$12.50"],
      ["Micro E-mini S&P 500","MES","0.25 punti","$1.25"],
      ["E-mini Nasdaq-100","NQ","0.25 punti","$5.00"],
      ["Micro E-mini Nasdaq-100","MNQ","0.25 punti","$0.50"],
      ["Petrolio greggio","CL","$0.01","$10.00"],
      ["Micro petrolio greggio WTI","MCL","$0.01","$1.00"],
      ["Oro","GC","$0.10","$10.00"],
      ["Micro oro","MGC","$0.10","$1.00"],
    ] },
    { type: "paragraph",html: "Ogni altro simbolo segue la stessa ricerca, quindi controlli prima le specifiche di un nuovo mercato invece di dare per scontato che coincidano con quelle di un contratto che già negozia." },
    { type: "heading",text: "Perché il valore del tick determina la dimensione delle posizioni" },
    { type: "paragraph",html: "Il valore del tick è il numero che collega lo stop sul grafico al saldo del suo conto. Stabilisca i dollari che è disposto a perdere, li divida per il valore del tick e otterrà lo stop massimo in tick. Se invece fissa prima lo stop, il valore del tick le dice quanti contratti rientrano nel suo budget di rischio." },
    { type: "paragraph",html: "Questo conta ancora di più in una valutazione con prop firm, dove il limite di perdita giornaliera e il trailing drawdown sono muri invalicabili. Questi limiti variano in base alla firm e alla dimensione del conto, quindi verifichi le regole attuali della sua firm e dimensioni ogni posizione in base al valore del tick, non a un'intuizione su quanto il prezzo \"di solito\" si muove." },
    { type: "heading",text: "Automatizzi il dimensionamento con PickMyTrade" },
    { type: "paragraph",html: "Una volta noto il valore del tick di un contratto, può delegare l'esecuzione. PickMyTrade instrada i suoi alert di TradingView direttamente verso Tradovate e inserisce ogni ingresso con stop e target collegati, trasformando il suo calcolo del rischio per tick in un vero bracket nell'istante in cui scatta un segnale." },
  ] },
  ctaHeading: { en: "Turn Your Risk Math Into a Real Bracket", de: "Machen Sie aus Ihrer Risikorechnung ein echtes Bracket", es: "Convierta su cálculo de riesgo en un bracket real", fr: "Transformez votre calcul de risque en un vrai bracket", it: "Trasformi il suo calcolo del rischio in un vero bracket" },
  ctaText: { en: "Once you know a contract's tick value, let PickMyTrade route your TradingView alerts into Tradovate and place each entry with its stop and target already attached.", de: "Sobald Sie den Tick-Wert eines Kontrakts kennen, lassen Sie PickMyTrade Ihre TradingView-Alarme an Tradovate weiterleiten und jede Order mit angehängtem Stop und Ziel platzieren.", es: "Cuando conozca el valor del tick de un contrato, deje que PickMyTrade envíe sus alertas de TradingView a Tradovate y coloque cada entrada con su stop y su objetivo ya adjuntos.", fr: "Une fois la valeur du tick d'un contrat connue, laissez PickMyTrade acheminer vos alertes TradingView vers Tradovate et placer chaque entrée avec son stop et son objectif déjà associés.", it: "Una volta noto il valore del tick di un contratto, lasci che PickMyTrade instradi i suoi alert di TradingView verso Tradovate e inserisca ogni ingresso con stop e target già collegati." },
  ctaButtonText: { en: "Try It Free", de: "Kostenlos testen", es: "Pruébelo gratis", fr: "Essayez gratuitement", it: "Provi gratis" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Does Tradovate set the tick size, or does the exchange?", a: "The exchange sets it. Tick size and tick value are fixed by the exchange that lists the contract, so they're the same on Tradovate as anywhere else the symbol trades." },
    { q: "Why is a micro's tick worth so much less than the mini?", a: "A micro is a smaller version of the mini, usually one-tenth the value. That's why MES is $1.25 a tick while ES is $12.50, even though both move in 0.25-point steps." },
    { q: "How do I turn a stop in ticks into a dollar figure?", a: "Multiply the ticks in your stop by the tick value, then by the number of contracts. Forty ES ticks on one contract is 40 x $12.50 = $500." },
  ], de: [
    { q: "Legt Tradovate die Tick-Größe fest oder die Börse?", a: "Die Börse legt sie fest. Tick-Größe und Tick-Wert werden von der Börse bestimmt, an der der Kontrakt gelistet ist. Bei Tradovate gelten also dieselben Werte wie überall sonst, wo das Symbol gehandelt wird." },
    { q: "Warum ist der Tick eines Micro-Kontrakts so viel weniger wert als beim Mini?", a: "Ein Micro ist eine kleinere Version des Mini, in der Regel mit einem Zehntel des Werts. Deshalb beträgt ein Tick bei MES 1,25 $, bei ES dagegen 12,50 $, obwohl sich beide in Schritten von 0.25 Punkten bewegen." },
    { q: "Wie rechne ich einen Stop in Ticks in einen Dollarbetrag um?", a: "Multiplizieren Sie die Ticks Ihres Stops mit dem Tick-Wert und anschließend mit der Anzahl der Kontrakte. Vierzig ES-Ticks bei einem Kontrakt ergeben 40 x $12.50 = $500." },
  ], es: [
    { q: "¿Tradovate fija el tamaño del tick o lo hace el mercado?", a: "Lo fija el mercado. El tamaño y el valor del tick los determina la bolsa que lista el contrato, así que son los mismos en Tradovate que en cualquier otro lugar donde se negocie el símbolo." },
    { q: "¿Por qué el tick de un micro vale mucho menos que el del mini?", a: "Un micro es una versión más pequeña del mini, normalmente una décima parte de su valor. Por eso MES vale $1.25 por tick mientras que ES vale $12.50, aunque ambos se muevan en pasos de 0.25 puntos." },
    { q: "¿Cómo convierto un stop en ticks en una cifra en dólares?", a: "Multiplique los ticks de su stop por el valor del tick y luego por el número de contratos. Cuarenta ticks de ES con un contrato son 40 x $12.50 = $500." },
  ], fr: [
    { q: "Est-ce Tradovate qui fixe la taille du tick, ou la bourse ?", a: "C'est la bourse. La taille et la valeur du tick sont fixées par la bourse qui cote le contrat ; elles sont donc les mêmes sur Tradovate que partout ailleurs où le symbole se négocie." },
    { q: "Pourquoi le tick d'un micro vaut-il bien moins que celui du mini ?", a: "Un micro est une version réduite du mini, généralement au dixième de sa valeur. C'est pourquoi le MES vaut $1.25 par tick alors que l'ES vaut $12.50, même si les deux évoluent par pas de 0.25 point." },
    { q: "Comment convertir un stop en ticks en montant en dollars ?", a: "Multipliez le nombre de ticks de votre stop par la valeur du tick, puis par le nombre de contrats. Quarante ticks d'ES sur un contrat font 40 x $12.50 = $500." },
  ], it: [
    { q: "La dimensione del tick la stabilisce Tradovate o la borsa?", a: "La stabilisce la borsa. Dimensione e valore del tick sono fissati dalla borsa che quota il contratto, quindi su Tradovate sono gli stessi di qualsiasi altro luogo in cui il simbolo viene negoziato." },
    { q: "Perché il tick di un micro vale molto meno di quello del mini?", a: "Un micro è una versione ridotta del mini, di solito pari a un decimo del suo valore. Per questo MES vale $1.25 a tick mentre ES vale $12.50, anche se entrambi si muovono a passi di 0.25 punti." },
    { q: "Come converto uno stop espresso in tick in una cifra in dollari?", a: "Moltiplichi i tick del suo stop per il valore del tick e poi per il numero di contratti. Quaranta tick di ES su un contratto sono 40 x $12.50 = $500." },
  ] },
  relatedHeading: { en: "Related Guides", de: "Ähnliche Leitfäden", es: "Guías relacionadas", fr: "Guides associés", it: "Guide correlate" },
  disclosureText: { en: `This guide is for educational and informational purposes only and is not financial, investment, or trading advice. Trading futures and other leveraged products carries a substantial risk of loss and is not suitable for every investor. PickMyTrade is an independent third-party automation platform and is not affiliated with, endorsed by, or sponsored by Tradovate, Inc. "Tradovate" and all related names, logos, and trademarks are the property of their respective owners. Platform features and steps change over time, so always confirm the current process in the official Tradovate platform and documentation before acting.`, de: "Dieser Leitfaden dient ausschließlich Bildungs- und Informationszwecken und stellt keine Finanz-, Anlage- oder Handelsberatung dar. Der Handel mit Futures und anderen gehebelten Produkten birgt ein erhebliches Verlustrisiko und ist nicht für jeden Anleger geeignet. PickMyTrade ist eine unabhängige Automatisierungsplattform eines Drittanbieters und steht in keiner Verbindung zu Tradovate, Inc., wird weder von dieser unterstützt noch gesponsert. „Tradovate“ und alle zugehörigen Namen, Logos und Marken sind Eigentum ihrer jeweiligen Inhaber. Funktionen und Schritte der Plattform ändern sich im Laufe der Zeit. Bestätigen Sie daher stets den aktuellen Ablauf in der offiziellen Tradovate-Plattform und -Dokumentation, bevor Sie handeln.", es: "Esta guía tiene fines exclusivamente educativos e informativos y no constituye asesoramiento financiero, de inversión ni de trading. Operar con futuros y otros productos apalancados conlleva un riesgo sustancial de pérdida y no es adecuado para todos los inversores. PickMyTrade es una plataforma de automatización independiente de terceros y no está afiliada, respaldada ni patrocinada por Tradovate, Inc. «Tradovate» y todos los nombres, logotipos y marcas relacionados son propiedad de sus respectivos titulares. Las funciones y los pasos de la plataforma cambian con el tiempo, por lo que debe confirmar siempre el proceso vigente en la plataforma y la documentación oficiales de Tradovate antes de actuar.", fr: "Ce guide est fourni à titre éducatif et informatif uniquement et ne constitue ni un conseil financier, ni un conseil en investissement, ni un conseil de trading. Le trading de contrats à terme et d'autres produits à effet de levier comporte un risque de perte important et ne convient pas à tous les investisseurs. PickMyTrade est une plateforme d'automatisation tierce indépendante, non affiliée à Tradovate, Inc., ni approuvée ou parrainée par celle-ci. « Tradovate » ainsi que tous les noms, logos et marques associés sont la propriété de leurs détenteurs respectifs. Les fonctionnalités et les étapes de la plateforme évoluent avec le temps : vérifiez toujours la procédure en vigueur sur la plateforme et dans la documentation officielles de Tradovate avant d'agir.", it: "Questa guida ha esclusivamente scopo educativo e informativo e non costituisce consulenza finanziaria, di investimento o di trading. Il trading di futures e di altri prodotti a leva comporta un rischio sostanziale di perdita e non è adatto a tutti gli investitori. PickMyTrade è una piattaforma di automazione indipendente di terze parti e non è affiliata, approvata né sponsorizzata da Tradovate, Inc. «Tradovate» e tutti i nomi, loghi e marchi correlati sono di proprietà dei rispettivi titolari. Le funzionalità e i passaggi della piattaforma cambiano nel tempo, quindi confermi sempre la procedura attuale nella piattaforma e nella documentazione ufficiali di Tradovate prima di agire." },
};
