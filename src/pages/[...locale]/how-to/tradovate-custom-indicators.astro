---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-custom-indicators";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Build a Custom Indicator in Tradovate (JavaScript)";
const META_DESCRIPTION =
  "Code your own custom chart indicators in JavaScript with the built-in Code Explorer, build a simple offset line, then an EMA, and add it to a chart.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Einen benutzerdefinierten Indikator in Tradovate erstellen (JavaScript)", es: "Cree un indicador personalizado en Tradovate (JavaScript)", fr: "Créer un indicateur personnalisé dans Tradovate (JavaScript)", it: "Creare un indicatore personalizzato in Tradovate (JavaScript)" },
  dek: { en: "None of Tradovate's built-in studies draw quite what you want? Here's how to code your own indicator in JavaScript with the Code Explorer, from a two-line offset to a real moving average.", de: "Keine der integrierten Studien von Tradovate zeichnet genau das, was Sie wollen? So programmieren Sie mit dem Code Explorer Ihren eigenen Indikator in JavaScript, vom Zwei-Zeilen-Offset bis zum echten gleitenden Durchschnitt.", es: "¿Ningún estudio integrado de Tradovate dibuja exactamente lo que necesita? Le mostramos cómo programar su propio indicador en JavaScript con el Code Explorer, desde un desplazamiento de dos líneas hasta una media móvil real.", fr: "Aucune des études intégrées de Tradovate ne trace exactement ce que vous voulez ? Voici comment coder votre propre indicateur en JavaScript avec le Code Explorer, d'un simple décalage en deux lignes jusqu'à une véritable moyenne mobile.", it: "Nessuno degli studi integrati di Tradovate disegna esattamente ciò che desidera? Ecco come programmare il Suo indicatore in JavaScript con il Code Explorer, da un semplice offset di due righe a una vera media mobile." },
  readTime: { en: "7 min read", de: "7 Min. Lesezeit", es: "Lectura de 7 min", fr: "Lecture : 7 min", it: "Lettura di 7 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You've clicked through Tradovate's built-in studies and none of them draws quite what you want. Good news, you can write your own. The whole platform runs on JavaScript, charts included, and it hands you an open editor called the Code Explorer where you code an indicator, save it, and drop it on a chart like any built-in study. This walks you through it, from a two-line offset to a real moving average." },
    { type: "heading", text: "What Are Tradovate Custom Indicators?" },
    { type: "paragraph", html: "Tradovate Trader runs the same JavaScript across web, desktop, and mobile, so the charting engine and every built-in study are JavaScript under the hood. Custom indicators just expose that same API to you. An indicator is a small module that exports two things: a <strong class='text-white'>name</strong> that identifies it, and a <strong class='text-white'>calculator</strong> class with a <code>map()</code> method. <code>map()</code> takes each bar in the series and returns a number, and the chart plots it. Start from scratch, copy a built-in and tweak it, or install one someone else uploaded, and the values can run on a chart or show on the DOM." },
    { type: "heading", text: "Build a Custom Indicator: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open the Code Explorer Module", html: "The editor lives inside the platform as its own panel. Add the <strong class='text-white'>Code Explorer</strong> module to your workspace, the same way you'd add a chart or a DOM, drag it in from the module list. Once it's docked, you've got a file tree of Tradovate's own indicator source on one side and an editor on the other. That built-in source is your best cheat sheet: open a study you like and read how it's put together." },
        { title: "Start a New Indicator File", html: "With the Code Explorer focused, open <strong class='text-white'>File &rarr; New</strong> from the top bar. That gives you a blank editor to type into. Nothing's wired up yet, an empty file won't show anywhere until you export a proper definition, which is the next step." },
        { title: "Write the Calculator", html: "Here's the smallest indicator that actually does something, a line offset a fixed amount below price. Say you want a rough stop-loss reference sitting two points under each bar, see the code example below. Two moving parts: the <code>module.exports</code> block registers the indicator, <code>name</code> is a machine ID (keep it plain), and <code>calculator</code> points at your class. The class needs at least a <code>map()</code> method. Tradovate calls it once per bar, walking the whole series; <code>d.value()</code> gives you that bar's input value, and whatever you return gets plotted. Save the file and it shows up in the chart's indicator list as <strong class='text-white'>EXAMPLEOFFSET</strong>, the name in uppercase, drawing a plain line below price." },
        { title: "Add Inputs and Reuse Built-in Tools", html: "A fixed number is limiting. Real indicators take user inputs, and you rarely need to write the math by hand. Tradovate bundles a <code>tools</code> folder full of ready-made algorithms you pull in with <code>require</code>. Here's a complete exponential moving average built on the included EMA helper, with an adjustable period, see the code example below. A few new pieces: <code>require</code> pulls in <code>predef</code>, Tradovate's shared parameter and style presets, plus the <code>EMA</code> algorithm from the tools folder, the same source you can open in the Code Explorer. <code>init()</code> runs once before the loop to build the EMA calculator at your chosen period; <code>map()</code> then feeds each bar's value into it. The <code>params</code> line adds an adjustable <strong class='text-white'>period</strong> field defaulting to 10, <code>schemeStyles</code> paints the line red, and <code>tags</code> files it under \"My Indicators\" in the menu." },
        { title: "Save It and Add It to Your Chart", html: "Save the file and switch to a chart. Open the <strong class='text-white'>Indicators</strong> list, find your indicator by its uppercase name, and add it like any built-in study. If it took a <code>period</code>, you'll see that field in its settings, ready to change per chart. Prefer not to code at all? Tradovate also lets you <strong class='text-white'>Explore Community Indicators</strong>, browse studies other traders have shared, check the details and download count, and install one straight into your indicator menu in a couple of clicks." },
      ],
    },
    { type: "quote", html: "<code>class offset {<br>&nbsp;&nbsp;&nbsp;&nbsp;map(d) {<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;return d.value() - 2.0;<br>&nbsp;&nbsp;&nbsp;&nbsp;}<br>}<br><br>module.exports = {<br>&nbsp;&nbsp;&nbsp;&nbsp;name: \"exampleOffset\",<br>&nbsp;&nbsp;&nbsp;&nbsp;calculator: offset<br>};</code>" },
    { type: "quote", html: "<code>const predef = require(\"./tools/predef\");<br>const EMA = require(\"./tools/EMA\");<br><br>class ema {<br>&nbsp;&nbsp;&nbsp;&nbsp;init() {<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;this.emaAlgo = EMA(this.props.period);<br>&nbsp;&nbsp;&nbsp;&nbsp;}<br><br>&nbsp;&nbsp;&nbsp;&nbsp;map(d) {<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;return this.emaAlgo(d.value());<br>&nbsp;&nbsp;&nbsp;&nbsp;}<br>}<br><br>module.exports = {<br>&nbsp;&nbsp;&nbsp;&nbsp;name: \"exampleEma\",<br>&nbsp;&nbsp;&nbsp;&nbsp;description: \"My EMA\",<br>&nbsp;&nbsp;&nbsp;&nbsp;calculator: ema,<br>&nbsp;&nbsp;&nbsp;&nbsp;params: {<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;period: predef.paramSpecs.period(10)<br>&nbsp;&nbsp;&nbsp;&nbsp;},<br>&nbsp;&nbsp;&nbsp;&nbsp;tags: [\"My Indicators\"],<br>&nbsp;&nbsp;&nbsp;&nbsp;schemeStyles: predef.styles.solidLine(\"red\")<br>};</code>" },
    { type: "heading", text: "Prefer Signals Over Syntax?" },
    { type: "paragraph", html: "Coding an indicator gives you a custom <em>view</em> of the market, but an indicator only draws. It can't pull the trigger. If your goal is to act on a signal the moment it fires, that's a different job: <strong class='text-white'>PickMyTrade routes your TradingView alerts straight to Tradovate as live orders</strong>, so your strategy trades itself." },
  ], de: [
    { type: "paragraph",html: "Sie haben sich durch die integrierten Studien von Tradovate geklickt, und keine zeichnet genau das, was Sie wollen. Gute Nachricht: Sie können Ihre eigene schreiben. Die gesamte Plattform läuft auf JavaScript, die Charts eingeschlossen, und stellt Ihnen einen offenen Editor namens Code Explorer zur Verfügung, in dem Sie einen Indikator programmieren, speichern und wie jede integrierte Studie auf einen Chart legen. Diese Anleitung führt Sie durch den Prozess, vom Zwei-Zeilen-Offset bis zum echten gleitenden Durchschnitt." },
    { type: "heading",text: "Was sind benutzerdefinierte Indikatoren in Tradovate?" },
    { type: "paragraph",html: "Tradovate Trader führt in Web, Desktop und Mobil dasselbe JavaScript aus, daher bestehen die Charting-Engine und jede integrierte Studie im Kern aus JavaScript. Benutzerdefinierte Indikatoren stellen Ihnen lediglich dieselbe API zur Verfügung. Ein Indikator ist ein kleines Modul, das zwei Dinge exportiert: einen <strong class='text-white'>name</strong>, der ihn identifiziert, und eine <strong class='text-white'>calculator</strong>-Klasse mit einer <code>map()</code>-Methode. <code>map()</code> nimmt jede Bar der Serie entgegen und gibt eine Zahl zurück, die der Chart zeichnet. Beginnen Sie bei null, kopieren Sie eine integrierte Studie und passen Sie sie an oder installieren Sie eine von jemand anderem hochgeladene, und die Werte können in einem Chart laufen oder im DOM erscheinen." },
    { type: "heading",text: "Einen benutzerdefinierten Indikator erstellen: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Das Code-Explorer-Modul öffnen", html: "Der Editor befindet sich als eigenes Panel in der Plattform. Fügen Sie das Modul <strong class='text-white'>Code Explorer</strong> Ihrem Workspace hinzu, genau wie einen Chart oder ein DOM, indem Sie es aus der Modulliste hineinziehen. Sobald es angedockt ist, sehen Sie auf der einen Seite einen Dateibaum mit dem Quellcode der Indikatoren von Tradovate und auf der anderen einen Editor. Dieser integrierte Quellcode ist Ihr bester Spickzettel: Öffnen Sie eine Studie, die Ihnen gefällt, und lesen Sie, wie sie aufgebaut ist." },
        { title: "Eine neue Indikatordatei beginnen", html: "Öffnen Sie bei fokussiertem Code Explorer in der oberen Leiste <strong class='text-white'>File &rarr; New</strong>. Damit erhalten Sie einen leeren Editor zum Tippen. Noch ist nichts verdrahtet: Eine leere Datei erscheint nirgends, bis Sie eine korrekte Definition exportieren, was der nächste Schritt ist." },
        { title: "Den Calculator schreiben", html: "Hier ist der kleinste Indikator, der tatsächlich etwas tut: eine Linie mit festem Abstand unterhalb des Kurses. Angenommen, Sie möchten eine grobe Stop-Loss-Referenz zwei Punkte unter jeder Bar, siehe das Codebeispiel unten. Zwei bewegliche Teile: Der Block <code>module.exports</code> registriert den Indikator, <code>name</code> ist eine maschinenlesbare ID (halten Sie sie schlicht), und <code>calculator</code> verweist auf Ihre Klasse. Die Klasse braucht mindestens eine <code>map()</code>-Methode. Tradovate ruft sie einmal pro Bar auf und durchläuft die gesamte Serie; <code>d.value()</code> liefert den Eingabewert dieser Bar, und was Sie zurückgeben, wird gezeichnet. Speichern Sie die Datei, und sie erscheint in der Indikatorliste des Charts als <strong class='text-white'>EXAMPLEOFFSET</strong>, der Name in Großbuchstaben, und zeichnet eine einfache Linie unter dem Kurs." },
        { title: "Eingaben hinzufügen und integrierte Werkzeuge wiederverwenden", html: "Eine feste Zahl ist begrenzt. Echte Indikatoren nehmen Benutzereingaben entgegen, und die Mathematik müssen Sie selten von Hand schreiben. Tradovate liefert einen <code>tools</code>-Ordner voller fertiger Algorithmen mit, die Sie per <code>require</code> einbinden. Hier ist ein vollständiger exponentieller gleitender Durchschnitt auf Basis des mitgelieferten EMA-Helpers mit einstellbarer Periode, siehe das Codebeispiel unten. Ein paar neue Elemente: <code>require</code> bindet <code>predef</code> ein, die gemeinsamen Parameter- und Stilvorgaben von Tradovate, sowie den <code>EMA</code>-Algorithmus aus dem tools-Ordner, denselben Quellcode, den Sie im Code Explorer öffnen können. <code>init()</code> läuft einmal vor der Schleife, um den EMA-Calculator mit Ihrer gewählten Periode aufzubauen; <code>map()</code> füttert ihn dann mit dem Wert jeder Bar. Die Zeile <code>params</code> fügt ein einstellbares Feld <strong class='text-white'>period</strong> mit dem Standardwert 10 hinzu, <code>schemeStyles</code> färbt die Linie rot, und <code>tags</code> ordnet sie im Menü unter \"My Indicators\" ein." },
        { title: "Speichern und zum Chart hinzufügen", html: "Speichern Sie die Datei und wechseln Sie zu einem Chart. Öffnen Sie die Liste <strong class='text-white'>Indicators</strong>, finden Sie Ihren Indikator anhand seines Namens in Großbuchstaben und fügen Sie ihn wie jede integrierte Studie hinzu. Wenn er eine <code>period</code> akzeptiert, sehen Sie dieses Feld in seinen Einstellungen, pro Chart änderbar. Möchten Sie gar nicht programmieren? Tradovate lässt Sie auch <strong class='text-white'>Explore Community Indicators</strong> nutzen: Stöbern Sie in Studien, die andere Trader geteilt haben, prüfen Sie Details und Download-Anzahl und installieren Sie eine mit ein paar Klicks direkt in Ihr Indikatormenü." },
      ],
    },
    { type: "quote",html: "<code>class offset {<br>&nbsp;&nbsp;&nbsp;&nbsp;map(d) {<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;return d.value() - 2.0;<br>&nbsp;&nbsp;&nbsp;&nbsp;}<br>}<br><br>module.exports = {<br>&nbsp;&nbsp;&nbsp;&nbsp;name: \"exampleOffset\",<br>&nbsp;&nbsp;&nbsp;&nbsp;calculator: offset<br>};</code>" },
    { type: "quote",html: "<code>const predef = require(\"./tools/predef\");<br>const EMA = require(\"./tools/EMA\");<br><br>class ema {<br>&nbsp;&nbsp;&nbsp;&nbsp;init() {<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;this.emaAlgo = EMA(this.props.period);<br>&nbsp;&nbsp;&nbsp;&nbsp;}<br><br>&nbsp;&nbsp;&nbsp;&nbsp;map(d) {<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;return this.emaAlgo(d.value());<br>&nbsp;&nbsp;&nbsp;&nbsp;}<br>}<br><br>module.exports = {<br>&nbsp;&nbsp;&nbsp;&nbsp;name: \"exampleEma\",<br>&nbsp;&nbsp;&nbsp;&nbsp;description: \"My EMA\",<br>&nbsp;&nbsp;&nbsp;&nbsp;calculator: ema,<br>&nbsp;&nbsp;&nbsp;&nbsp;params: {<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;period: predef.paramSpecs.period(10)<br>&nbsp;&nbsp;&nbsp;&nbsp;},<br>&nbsp;&nbsp;&nbsp;&nbsp;tags: [\"My Indicators\"],<br>&nbsp;&nbsp;&nbsp;&nbsp;schemeStyles: predef.styles.solidLine(\"red\")<br>};</code>" },
    { type: "heading",text: "Lieber Signale statt Syntax?" },
    { type: "paragraph",html: "Einen Indikator zu programmieren gibt Ihnen eine eigene <em>Sicht</em> auf den Markt, aber ein Indikator zeichnet nur. Er kann nicht abdrücken. Wenn Ihr Ziel ist, im Moment des Signals zu handeln, ist das eine andere Aufgabe: <strong class='text-white'>PickMyTrade leitet Ihre TradingView-Alerts direkt als Live-Orders an Tradovate weiter</strong>, sodass Ihre Strategie von selbst handelt." },
  ], es: [
    { type: "paragraph",html: "Ha recorrido los estudios integrados de Tradovate y ninguno dibuja exactamente lo que quiere. Buenas noticias: puede escribir el suyo. Toda la plataforma funciona con JavaScript, gráficos incluidos, y le ofrece un editor abierto llamado Code Explorer donde programa un indicador, lo guarda y lo coloca en un gráfico como cualquier estudio integrado. Esta guía le acompaña en el proceso, desde un desplazamiento de dos líneas hasta una media móvil real." },
    { type: "heading",text: "¿Qué son los indicadores personalizados de Tradovate?" },
    { type: "paragraph",html: "Tradovate Trader ejecuta el mismo JavaScript en web, escritorio y móvil, por lo que el motor de gráficos y todos los estudios integrados son JavaScript en el fondo. Los indicadores personalizados simplemente le exponen esa misma API. Un indicador es un pequeño módulo que exporta dos cosas: un <strong class='text-white'>name</strong> que lo identifica y una clase <strong class='text-white'>calculator</strong> con un método <code>map()</code>. <code>map()</code> recibe cada barra de la serie y devuelve un número, y el gráfico lo dibuja. Puede empezar desde cero, copiar uno integrado y ajustarlo, o instalar uno que haya subido otra persona, y los valores pueden ejecutarse en un gráfico o mostrarse en el DOM." },
    { type: "heading",text: "Cree un indicador personalizado: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra el módulo Code Explorer", html: "El editor vive dentro de la plataforma como su propio panel. Añada el módulo <strong class='text-white'>Code Explorer</strong> a su espacio de trabajo, igual que añadiría un gráfico o un DOM, arrastrándolo desde la lista de módulos. Una vez acoplado, tendrá a un lado un árbol de archivos con el código fuente de los indicadores de Tradovate y al otro un editor. Ese código fuente integrado es su mejor chuleta: abra un estudio que le guste y lea cómo está construido." },
        { title: "Inicie un nuevo archivo de indicador", html: "Con el Code Explorer enfocado, abra <strong class='text-white'>File &rarr; New</strong> en la barra superior. Obtendrá un editor en blanco donde escribir. Todavía no hay nada conectado: un archivo vacío no aparecerá en ningún sitio hasta que exporte una definición adecuada, que es el siguiente paso." },
        { title: "Escriba el calculator", html: "Este es el indicador más pequeño que realmente hace algo: una línea desplazada una cantidad fija por debajo del precio. Digamos que quiere una referencia aproximada de stop loss situada dos puntos por debajo de cada barra; vea el ejemplo de código más abajo. Hay dos piezas móviles: el bloque <code>module.exports</code> registra el indicador, <code>name</code> es un ID para la máquina (manténgalo sencillo) y <code>calculator</code> apunta a su clase. La clase necesita al menos un método <code>map()</code>. Tradovate lo llama una vez por barra, recorriendo toda la serie; <code>d.value()</code> le da el valor de entrada de esa barra, y lo que devuelva se dibuja. Guarde el archivo y aparecerá en la lista de indicadores del gráfico como <strong class='text-white'>EXAMPLEOFFSET</strong>, el nombre en mayúsculas, dibujando una línea simple por debajo del precio." },
        { title: "Añada entradas y reutilice las herramientas integradas", html: "Un número fijo es limitante. Los indicadores reales aceptan entradas del usuario y rara vez hace falta escribir las matemáticas a mano. Tradovate incluye una carpeta <code>tools</code> llena de algoritmos ya hechos que se incorporan con <code>require</code>. Aquí tiene una media móvil exponencial completa basada en el asistente EMA incluido, con un periodo ajustable; vea el ejemplo de código más abajo. Hay algunas piezas nuevas: <code>require</code> incorpora <code>predef</code>, los preajustes compartidos de parámetros y estilos de Tradovate, además del algoritmo <code>EMA</code> de la carpeta tools, el mismo código que puede abrir en el Code Explorer. <code>init()</code> se ejecuta una vez antes del bucle para construir el calculador EMA con el periodo elegido; después <code>map()</code> le pasa el valor de cada barra. La línea <code>params</code> añade un campo ajustable <strong class='text-white'>period</strong> con valor predeterminado 10, <code>schemeStyles</code> pinta la línea de rojo y <code>tags</code> la archiva en el menú bajo \"My Indicators\"." },
        { title: "Guárdelo y añádalo a su gráfico", html: "Guarde el archivo y cambie a un gráfico. Abra la lista <strong class='text-white'>Indicators</strong>, encuentre su indicador por su nombre en mayúsculas y añádalo como cualquier estudio integrado. Si admitía un <code>period</code>, verá ese campo en sus ajustes, listo para cambiarlo en cada gráfico. ¿Prefiere no programar en absoluto? Tradovate también le permite <strong class='text-white'>Explore Community Indicators</strong>: explore estudios compartidos por otros traders, consulte los detalles y el número de descargas e instale uno directamente en su menú de indicadores con un par de clics." },
      ],
    },
    { type: "quote",html: "<code>class offset {<br>&nbsp;&nbsp;&nbsp;&nbsp;map(d) {<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;return d.value() - 2.0;<br>&nbsp;&nbsp;&nbsp;&nbsp;}<br>}<br><br>module.exports = {<br>&nbsp;&nbsp;&nbsp;&nbsp;name: \"exampleOffset\",<br>&nbsp;&nbsp;&nbsp;&nbsp;calculator: offset<br>};</code>" },
    { type: "quote",html: "<code>const predef = require(\"./tools/predef\");<br>const EMA = require(\"./tools/EMA\");<br><br>class ema {<br>&nbsp;&nbsp;&nbsp;&nbsp;init() {<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;this.emaAlgo = EMA(this.props.period);<br>&nbsp;&nbsp;&nbsp;&nbsp;}<br><br>&nbsp;&nbsp;&nbsp;&nbsp;map(d) {<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;return this.emaAlgo(d.value());<br>&nbsp;&nbsp;&nbsp;&nbsp;}<br>}<br><br>module.exports = {<br>&nbsp;&nbsp;&nbsp;&nbsp;name: \"exampleEma\",<br>&nbsp;&nbsp;&nbsp;&nbsp;description: \"My EMA\",<br>&nbsp;&nbsp;&nbsp;&nbsp;calculator: ema,<br>&nbsp;&nbsp;&nbsp;&nbsp;params: {<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;period: predef.paramSpecs.period(10)<br>&nbsp;&nbsp;&nbsp;&nbsp;},<br>&nbsp;&nbsp;&nbsp;&nbsp;tags: [\"My Indicators\"],<br>&nbsp;&nbsp;&nbsp;&nbsp;schemeStyles: predef.styles.solidLine(\"red\")<br>};</code>" },
    { type: "heading",text: "¿Prefiere señales a sintaxis?" },
    { type: "paragraph",html: "Programar un indicador le da una <em>vista</em> personalizada del mercado, pero un indicador solo dibuja. No puede apretar el gatillo. Si su objetivo es actuar sobre una señal en el momento en que se dispara, es otro trabajo: <strong class='text-white'>PickMyTrade envía sus alertas de TradingView directamente a Tradovate como órdenes reales</strong>, para que su estrategia opere sola." },
  ], fr: [
    { type: "paragraph",html: "Vous avez parcouru les études intégrées de Tradovate et aucune ne trace exactement ce que vous voulez. Bonne nouvelle : vous pouvez écrire la vôtre. Toute la plateforme repose sur JavaScript, graphiques compris, et vous donne un éditeur ouvert appelé Code Explorer où vous codez un indicateur, l'enregistrez et le placez sur un graphique comme n'importe quelle étude intégrée. Ce guide vous accompagne, d'un simple décalage en deux lignes jusqu'à une véritable moyenne mobile." },
    { type: "heading",text: "Que sont les indicateurs personnalisés Tradovate ?" },
    { type: "paragraph",html: "Tradovate Trader exécute le même JavaScript sur le web, le bureau et le mobile ; le moteur graphique et chaque étude intégrée sont donc du JavaScript en coulisses. Les indicateurs personnalisés vous exposent simplement cette même API. Un indicateur est un petit module qui exporte deux choses : un <strong class='text-white'>name</strong> qui l'identifie et une classe <strong class='text-white'>calculator</strong> dotée d'une méthode <code>map()</code>. <code>map()</code> prend chaque barre de la série et renvoie un nombre, que le graphique trace. Partez de zéro, copiez une étude intégrée et modifiez-la, ou installez-en une mise en ligne par quelqu'un d'autre ; les valeurs peuvent s'afficher sur un graphique ou sur le DOM." },
    { type: "heading",text: "Créer un indicateur personnalisé : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez le module Code Explorer", html: "L'éditeur est intégré à la plateforme dans son propre panneau. Ajoutez le module <strong class='text-white'>Code Explorer</strong> à votre espace de travail, comme vous ajouteriez un graphique ou un DOM, en le faisant glisser depuis la liste des modules. Une fois ancré, vous disposez d'une arborescence de fichiers avec le code source des indicateurs propres à Tradovate d'un côté et d'un éditeur de l'autre. Ce code source intégré est votre meilleur aide-mémoire : ouvrez une étude qui vous plaît et lisez comment elle est construite." },
        { title: "Démarrez un nouveau fichier d'indicateur", html: "Le Code Explorer étant actif, ouvrez <strong class='text-white'>File &rarr; New</strong> dans la barre supérieure. Vous obtenez un éditeur vide dans lequel saisir votre code. Rien n'est encore relié : un fichier vide n'apparaîtra nulle part tant que vous n'aurez pas exporté une définition correcte, ce qui est l'étape suivante." },
        { title: "Écrivez le calculator", html: "Voici le plus petit indicateur qui fasse réellement quelque chose : une ligne décalée d'une valeur fixe sous le prix. Imaginons que vous souhaitiez une référence approximative de stop loss placée deux points sous chaque barre ; voir l'exemple de code ci-dessous. Deux éléments : le bloc <code>module.exports</code> enregistre l'indicateur, <code>name</code> est un identifiant machine (restez simple) et <code>calculator</code> pointe vers votre classe. La classe doit comporter au moins une méthode <code>map()</code>. Tradovate l'appelle une fois par barre, en parcourant toute la série ; <code>d.value()</code> vous donne la valeur d'entrée de cette barre, et ce que vous renvoyez est tracé. Enregistrez le fichier et il apparaît dans la liste des indicateurs du graphique sous le nom <strong class='text-white'>EXAMPLEOFFSET</strong>, le nom en majuscules, en traçant une simple ligne sous le prix." },
        { title: "Ajoutez des entrées et réutilisez les outils intégrés", html: "Une valeur fixe est limitante. Les vrais indicateurs acceptent des entrées utilisateur, et vous avez rarement besoin d'écrire les calculs à la main. Tradovate fournit un dossier <code>tools</code> rempli d'algorithmes prêts à l'emploi que vous importez avec <code>require</code>. Voici une moyenne mobile exponentielle complète, bâtie sur l'assistant EMA fourni, avec une période ajustable ; voir l'exemple de code ci-dessous. Quelques éléments nouveaux : <code>require</code> importe <code>predef</code>, les préréglages partagés de paramètres et de styles de Tradovate, ainsi que l'algorithme <code>EMA</code> du dossier tools, la même source que vous pouvez ouvrir dans le Code Explorer. <code>init()</code> s'exécute une fois avant la boucle pour construire le calculateur EMA à la période choisie ; <code>map()</code> lui transmet ensuite la valeur de chaque barre. La ligne <code>params</code> ajoute un champ ajustable <strong class='text-white'>period</strong> valant 10 par défaut, <code>schemeStyles</code> colore la ligne en rouge et <code>tags</code> la classe sous \"My Indicators\" dans le menu." },
        { title: "Enregistrez-le et ajoutez-le à votre graphique", html: "Enregistrez le fichier et passez à un graphique. Ouvrez la liste <strong class='text-white'>Indicators</strong>, repérez votre indicateur grâce à son nom en majuscules et ajoutez-le comme n'importe quelle étude intégrée. S'il acceptait un <code>period</code>, vous verrez ce champ dans ses paramètres, modifiable pour chaque graphique. Vous préférez ne pas coder du tout ? Tradovate vous permet aussi de recourir à <strong class='text-white'>Explore Community Indicators</strong> : parcourez les études partagées par d'autres traders, consultez les détails et le nombre de téléchargements, puis installez-en une directement dans votre menu d'indicateurs en quelques clics." },
      ],
    },
    { type: "quote",html: "<code>class offset {<br>&nbsp;&nbsp;&nbsp;&nbsp;map(d) {<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;return d.value() - 2.0;<br>&nbsp;&nbsp;&nbsp;&nbsp;}<br>}<br><br>module.exports = {<br>&nbsp;&nbsp;&nbsp;&nbsp;name: \"exampleOffset\",<br>&nbsp;&nbsp;&nbsp;&nbsp;calculator: offset<br>};</code>" },
    { type: "quote",html: "<code>const predef = require(\"./tools/predef\");<br>const EMA = require(\"./tools/EMA\");<br><br>class ema {<br>&nbsp;&nbsp;&nbsp;&nbsp;init() {<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;this.emaAlgo = EMA(this.props.period);<br>&nbsp;&nbsp;&nbsp;&nbsp;}<br><br>&nbsp;&nbsp;&nbsp;&nbsp;map(d) {<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;return this.emaAlgo(d.value());<br>&nbsp;&nbsp;&nbsp;&nbsp;}<br>}<br><br>module.exports = {<br>&nbsp;&nbsp;&nbsp;&nbsp;name: \"exampleEma\",<br>&nbsp;&nbsp;&nbsp;&nbsp;description: \"My EMA\",<br>&nbsp;&nbsp;&nbsp;&nbsp;calculator: ema,<br>&nbsp;&nbsp;&nbsp;&nbsp;params: {<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;period: predef.paramSpecs.period(10)<br>&nbsp;&nbsp;&nbsp;&nbsp;},<br>&nbsp;&nbsp;&nbsp;&nbsp;tags: [\"My Indicators\"],<br>&nbsp;&nbsp;&nbsp;&nbsp;schemeStyles: predef.styles.solidLine(\"red\")<br>};</code>" },
    { type: "heading",text: "Vous préférez les signaux à la syntaxe ?" },
    { type: "paragraph",html: "Coder un indicateur vous donne une <em>vue</em> personnalisée du marché, mais un indicateur ne fait que tracer. Il ne peut pas appuyer sur la détente. Si votre objectif est d'agir sur un signal à l'instant où il se déclenche, c'est un autre travail : <strong class='text-white'>PickMyTrade achemine vos alertes TradingView directement vers Tradovate sous forme d'ordres réels</strong>, pour que votre stratégie trade toute seule." },
  ], it: [
    { type: "paragraph",html: "Ha scorso gli studi integrati di Tradovate e nessuno disegna esattamente ciò che vuole. Buone notizie: può scrivere il Suo. L'intera piattaforma funziona con JavaScript, grafici compresi, e Le mette a disposizione un editor aperto chiamato Code Explorer dove programmare un indicatore, salvarlo e applicarlo a un grafico come qualsiasi studio integrato. Questa guida La accompagna passo dopo passo, da un offset di due righe a una vera media mobile." },
    { type: "heading",text: "Che cosa sono gli indicatori personalizzati di Tradovate?" },
    { type: "paragraph",html: "Tradovate Trader esegue lo stesso JavaScript su web, desktop e mobile, quindi il motore grafico e ogni studio integrato sono JavaScript sotto il cofano. Gli indicatori personalizzati Le espongono semplicemente la stessa API. Un indicatore è un piccolo modulo che esporta due cose: un <strong class='text-white'>name</strong> che lo identifica e una classe <strong class='text-white'>calculator</strong> con un metodo <code>map()</code>. <code>map()</code> riceve ogni barra della serie e restituisce un numero, che il grafico traccia. Può partire da zero, copiare uno studio integrato e modificarlo oppure installarne uno caricato da qualcun altro, e i valori possono girare su un grafico o comparire sul DOM." },
    { type: "heading",text: "Creare un indicatore personalizzato: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Apra il modulo Code Explorer", html: "L'editor vive all'interno della piattaforma come pannello a sé. Aggiunga il modulo <strong class='text-white'>Code Explorer</strong> al Suo workspace, come aggiungerebbe un grafico o un DOM, trascinandolo dall'elenco dei moduli. Una volta ancorato, avrà da un lato un albero di file con il codice sorgente degli indicatori di Tradovate e dall'altro un editor. Quel codice sorgente integrato è il Suo miglior promemoria: apra uno studio che Le piace e legga come è costruito." },
        { title: "Avvii un nuovo file indicatore", html: "Con il Code Explorer in primo piano, apra <strong class='text-white'>File &rarr; New</strong> dalla barra superiore. Otterrà un editor vuoto in cui scrivere. Nulla è ancora collegato: un file vuoto non comparirà da nessuna parte finché non esporterà una definizione corretta, che è il passo successivo." },
        { title: "Scriva il calculator", html: "Ecco il più piccolo indicatore che faccia davvero qualcosa: una linea con un offset fisso sotto il prezzo. Supponga di volere un riferimento approssimativo di stop loss collocato due punti sotto ogni barra; veda l'esempio di codice qui sotto. Ci sono due elementi: il blocco <code>module.exports</code> registra l'indicatore, <code>name</code> è un ID per la macchina (lo mantenga semplice) e <code>calculator</code> punta alla Sua classe. La classe richiede almeno un metodo <code>map()</code>. Tradovate lo richiama una volta per barra, scorrendo l'intera serie; <code>d.value()</code> Le fornisce il valore di input di quella barra, e ciò che restituisce viene tracciato. Salvi il file e comparirà nell'elenco degli indicatori del grafico come <strong class='text-white'>EXAMPLEOFFSET</strong>, il nome in maiuscolo, disegnando una semplice linea sotto il prezzo." },
        { title: "Aggiunga input e riutilizzi gli strumenti integrati", html: "Un numero fisso è limitante. Gli indicatori veri accettano input dell'utente e raramente serve scrivere la matematica a mano. Tradovate include una cartella <code>tools</code> piena di algoritmi già pronti che si importano con <code>require</code>. Ecco una media mobile esponenziale completa costruita sull'helper EMA incluso, con un periodo regolabile; veda l'esempio di codice qui sotto. Alcuni elementi nuovi: <code>require</code> importa <code>predef</code>, i preset condivisi di parametri e stili di Tradovate, oltre all'algoritmo <code>EMA</code> della cartella tools, la stessa sorgente che può aprire nel Code Explorer. <code>init()</code> viene eseguito una volta prima del ciclo per costruire il calcolatore EMA al periodo scelto; <code>map()</code> gli passa poi il valore di ogni barra. La riga <code>params</code> aggiunge un campo regolabile <strong class='text-white'>period</strong> con valore predefinito 10, <code>schemeStyles</code> colora la linea di rosso e <code>tags</code> la classifica sotto \"My Indicators\" nel menu." },
        { title: "Salvi e aggiunga al grafico", html: "Salvi il file e passi a un grafico. Apra l'elenco <strong class='text-white'>Indicators</strong>, trovi il Suo indicatore dal nome in maiuscolo e lo aggiunga come qualsiasi studio integrato. Se accettava un <code>period</code>, vedrà quel campo nelle impostazioni, pronto da modificare per ciascun grafico. Preferisce non programmare affatto? Tradovate Le permette anche di usare <strong class='text-white'>Explore Community Indicators</strong>: sfogli gli studi condivisi da altri trader, controlli i dettagli e il numero di download e ne installi uno direttamente nel Suo menu degli indicatori con un paio di clic." },
      ],
    },
    { type: "quote",html: "<code>class offset {<br>&nbsp;&nbsp;&nbsp;&nbsp;map(d) {<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;return d.value() - 2.0;<br>&nbsp;&nbsp;&nbsp;&nbsp;}<br>}<br><br>module.exports = {<br>&nbsp;&nbsp;&nbsp;&nbsp;name: \"exampleOffset\",<br>&nbsp;&nbsp;&nbsp;&nbsp;calculator: offset<br>};</code>" },
    { type: "quote",html: "<code>const predef = require(\"./tools/predef\");<br>const EMA = require(\"./tools/EMA\");<br><br>class ema {<br>&nbsp;&nbsp;&nbsp;&nbsp;init() {<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;this.emaAlgo = EMA(this.props.period);<br>&nbsp;&nbsp;&nbsp;&nbsp;}<br><br>&nbsp;&nbsp;&nbsp;&nbsp;map(d) {<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;return this.emaAlgo(d.value());<br>&nbsp;&nbsp;&nbsp;&nbsp;}<br>}<br><br>module.exports = {<br>&nbsp;&nbsp;&nbsp;&nbsp;name: \"exampleEma\",<br>&nbsp;&nbsp;&nbsp;&nbsp;description: \"My EMA\",<br>&nbsp;&nbsp;&nbsp;&nbsp;calculator: ema,<br>&nbsp;&nbsp;&nbsp;&nbsp;params: {<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;period: predef.paramSpecs.period(10)<br>&nbsp;&nbsp;&nbsp;&nbsp;},<br>&nbsp;&nbsp;&nbsp;&nbsp;tags: [\"My Indicators\"],<br>&nbsp;&nbsp;&nbsp;&nbsp;schemeStyles: predef.styles.solidLine(\"red\")<br>};</code>" },
    { type: "heading",text: "Preferisce i segnali alla sintassi?" },
    { type: "paragraph",html: "Programmare un indicatore Le offre una <em>vista</em> personalizzata del mercato, ma un indicatore si limita a disegnare. Non può premere il grilletto. Se il Suo obiettivo è agire su un segnale nell'istante in cui scatta, è un altro lavoro: <strong class='text-white'>PickMyTrade instrada i Suoi alert di TradingView direttamente a Tradovate come ordini reali</strong>, così la Sua strategia opera da sola." },
  ] },
  ctaHeading: { en: "Automate Your Tradovate Entries", de: "Automatisieren Sie Ihre Tradovate-Einstiege", es: "Automatice sus entradas en Tradovate", fr: "Automatisez vos entrées sur Tradovate", it: "Automatizzi le Sue entrate su Tradovate" },
  ctaText: { en: "An indicator only draws, it can't pull the trigger. PickMyTrade routes your TradingView alerts straight to Tradovate as live orders, so your strategy trades itself.", de: "Ein Indikator zeichnet nur, er kann nicht abdrücken. PickMyTrade leitet Ihre TradingView-Alerts direkt als Live-Orders an Tradovate weiter, sodass Ihre Strategie von selbst handelt.", es: "Un indicador solo dibuja, no puede apretar el gatillo. PickMyTrade envía sus alertas de TradingView directamente a Tradovate como órdenes reales, para que su estrategia opere sola.", fr: "Un indicateur ne fait que tracer, il ne peut pas appuyer sur la détente. PickMyTrade achemine vos alertes TradingView directement vers Tradovate sous forme d'ordres réels, pour que votre stratégie trade toute seule.", it: "Un indicatore si limita a disegnare, non può premere il grilletto. PickMyTrade instrada i Suoi alert di TradingView direttamente a Tradovate come ordini reali, così la Sua strategia opera da sola." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Do I need to know JavaScript to build a Tradovate indicator?", a: "A little helps, but you don't have to start from a blank page. The Code Explorer ships with the source for Tradovate's own studies, so the easiest path is to open one that's close to what you want, copy it, and change the parts you understand. The two examples above, an offset line and a moving average, are about as simple as it gets." },
    { q: "Can my custom indicator place trades?", a: "No. A custom indicator only calculates values and plots them on the chart or DOM. It can't send orders on its own. To act on a signal automatically you need a separate automation layer that watches for the condition and routes the order." },
  ], de: [
    { q: "Muss ich JavaScript können, um einen Tradovate-Indikator zu erstellen?", a: "Ein wenig hilft, aber Sie müssen nicht bei null anfangen. Der Code Explorer enthält den Quellcode der eigenen Studien von Tradovate. Am einfachsten öffnen Sie also eine, die Ihrem Ziel nahekommt, kopieren sie und ändern die Teile, die Sie verstehen. Die beiden Beispiele oben, eine Offset-Linie und ein gleitender Durchschnitt, sind so einfach, wie es nur geht." },
    { q: "Kann mein benutzerdefinierter Indikator Trades platzieren?", a: "Nein. Ein benutzerdefinierter Indikator berechnet nur Werte und stellt sie im Chart oder im DOM dar. Er kann nicht von sich aus Orders senden. Um automatisch auf ein Signal zu reagieren, benötigen Sie eine separate Automatisierungsebene, die auf die Bedingung achtet und die Order weiterleitet." },
  ], es: [
    { q: "¿Necesito saber JavaScript para crear un indicador de Tradovate?", a: "Ayuda un poco, pero no tiene que empezar desde cero. El Code Explorer incluye el código fuente de los estudios propios de Tradovate, así que lo más sencillo es abrir uno parecido a lo que quiere, copiarlo y cambiar las partes que entienda. Los dos ejemplos anteriores, una línea desplazada y una media móvil, son de lo más simple que hay." },
    { q: "¿Puede mi indicador personalizado colocar operaciones?", a: "No. Un indicador personalizado solo calcula valores y los dibuja en el gráfico o en el DOM. No puede enviar órdenes por sí mismo. Para actuar automáticamente ante una señal necesita una capa de automatización aparte que vigile la condición y enrute la orden." },
  ], fr: [
    { q: "Dois-je connaître JavaScript pour créer un indicateur Tradovate ?", a: "Un peu de connaissance aide, mais vous n'avez pas à partir d'une page blanche. Le Code Explorer fournit le code source des études propres à Tradovate ; le plus simple est donc d'en ouvrir une proche de ce que vous voulez, de la copier et de modifier les parties que vous comprenez. Les deux exemples ci-dessus, une ligne décalée et une moyenne mobile, sont à peu près ce qu'il y a de plus simple." },
    { q: "Mon indicateur personnalisé peut-il passer des trades ?", a: "Non. Un indicateur personnalisé ne fait que calculer des valeurs et les tracer sur le graphique ou le DOM. Il ne peut pas envoyer d'ordres de lui-même. Pour agir automatiquement sur un signal, il vous faut une couche d'automatisation distincte qui surveille la condition et achemine l'ordre." },
  ], it: [
    { q: "Devo conoscere JavaScript per creare un indicatore Tradovate?", a: "Un po' aiuta, ma non deve partire da una pagina bianca. Il Code Explorer include il codice sorgente degli studi di Tradovate, quindi la via più semplice è aprirne uno vicino a ciò che vuole, copiarlo e modificare le parti che comprende. I due esempi qui sopra, una linea con offset e una media mobile, sono tra i più semplici possibili." },
    { q: "Il mio indicatore personalizzato può eseguire dei trade?", a: "No. Un indicatore personalizzato si limita a calcolare valori e a tracciarli sul grafico o sul DOM. Non può inviare ordini da solo. Per agire automaticamente su un segnale serve un livello di automazione separato che osservi la condizione e instradi l'ordine." },
  ] },
  relatedHeading: { en: "Related Guides", de: "Verwandte Anleitungen", es: "Guías relacionadas", fr: "Guides associés", it: "Guide correlate" },
  disclosureText: { en: `This guide is for educational and informational purposes only and is not financial, investment, or trading advice. Trading futures and other leveraged products carries a substantial risk of loss and is not suitable for every investor. PickMyTrade is an independent third-party automation platform and is not affiliated with, endorsed by, or sponsored by Tradovate, Inc. "Tradovate" and all related names, logos, and trademarks are the property of their respective owners. Platform features and steps change over time, so always confirm the current process in the official Tradovate platform and documentation before acting.`, de: "Dieser Leitfaden dient ausschließlich Bildungs- und Informationszwecken und stellt keine Finanz-, Anlage- oder Handelsberatung dar. Der Handel mit Futures und anderen gehebelten Produkten birgt ein erhebliches Verlustrisiko und ist nicht für jeden Anleger geeignet. PickMyTrade ist eine unabhängige Automatisierungsplattform eines Drittanbieters und steht in keiner Verbindung zu Tradovate, Inc., wird weder von dieser unterstützt noch gesponsert. \"Tradovate\" sowie alle zugehörigen Namen, Logos und Marken sind Eigentum ihrer jeweiligen Inhaber. Funktionen und Schritte der Plattform ändern sich im Laufe der Zeit. Bestätigen Sie daher stets den aktuellen Ablauf in der offiziellen Tradovate-Plattform und -Dokumentation, bevor Sie handeln.", es: "Esta guía tiene fines exclusivamente educativos e informativos y no constituye asesoramiento financiero, de inversión ni de trading. Operar con futuros y otros productos apalancados conlleva un riesgo sustancial de pérdida y no es adecuado para todos los inversores. PickMyTrade es una plataforma de automatización independiente de terceros y no está afiliada, respaldada ni patrocinada por Tradovate, Inc. \"Tradovate\" y todos los nombres, logotipos y marcas relacionados son propiedad de sus respectivos titulares. Las funciones y los pasos de la plataforma cambian con el tiempo, por lo que debe confirmar siempre el proceso vigente en la plataforma y la documentación oficiales de Tradovate antes de actuar.", fr: "Ce guide est fourni à des fins exclusivement pédagogiques et informatives et ne constitue ni un conseil financier, ni un conseil en investissement, ni un conseil de trading. Le trading de contrats à terme et d'autres produits à effet de levier comporte un risque de perte important et ne convient pas à tous les investisseurs. PickMyTrade est une plateforme d'automatisation tierce indépendante et n'est ni affiliée à Tradovate, Inc., ni approuvée, ni parrainée par cette dernière. « Tradovate » ainsi que tous les noms, logos et marques associés sont la propriété de leurs détenteurs respectifs. Les fonctionnalités et les étapes de la plateforme évoluent avec le temps ; vérifiez donc toujours la procédure en vigueur dans la plateforme et la documentation officielles de Tradovate avant d'agir.", it: "Questa guida ha esclusivamente scopo didattico e informativo e non costituisce consulenza finanziaria, di investimento o di trading. Il trading di futures e di altri prodotti a leva comporta un rischio di perdita sostanziale e non è adatto a tutti gli investitori. PickMyTrade è una piattaforma di automazione indipendente di terze parti e non è affiliata, approvata né sponsorizzata da Tradovate, Inc. \"Tradovate\" e tutti i nomi, loghi e marchi correlati sono di proprietà dei rispettivi titolari. Le funzionalità e i passaggi della piattaforma cambiano nel tempo, perciò confermi sempre la procedura attuale nella piattaforma e nella documentazione ufficiali di Tradovate prima di agire." },
