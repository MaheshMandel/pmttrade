---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-link-bank-ach";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Link a Bank Account for ACH Deposits in Tradovate";
const META_DESCRIPTION =
  "Connect your bank for ACH deposits in minutes, link instantly through Plaid or add your routing and account numbers manually, step by step.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Bankkonto für ACH-Einzahlungen in Tradovate verknüpfen", es: "Cómo vincular una cuenta bancaria para depósitos ACH en Tradovate", fr: "Lier un compte bancaire pour les dépôts ACH sur Tradovate", it: "Collegare un conto bancario per i depositi ACH su Tradovate" },
  dek: { en: "ACH is the cheapest way to move money into a self-funded Tradovate account. Here's how to link your bank once, either instantly through Plaid or by entering your routing and account numbers by hand.", de: "ACH ist der günstigste Weg, Geld auf ein selbst finanziertes Tradovate-Konto zu überweisen. So verknüpfen Sie Ihre Bank einmalig, entweder sofort über Plaid oder durch manuelle Eingabe von Routing- und Kontonummer.", es: "ACH es la forma más económica de mover dinero a una cuenta de Tradovate financiada por usted mismo. Aquí le explicamos cómo vincular su banco una sola vez, de forma instantánea con Plaid o introduciendo a mano sus números de ruta y de cuenta.", fr: "L’ACH est le moyen le moins coûteux d’alimenter un compte Tradovate autofinancé. Voici comment lier votre banque une seule fois, instantanément via Plaid ou en saisissant à la main vos numéros d’acheminement et de compte.", it: "L’ACH è il modo più economico per spostare denaro su un conto Tradovate autofinanziato. Ecco come collegare la Sua banca una sola volta, istantaneamente tramite Plaid oppure inserendo a mano i numeri di instradamento e di conto." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "ACH is the cheapest way to move money into a self-funded Tradovate account. No wire fee, no card surcharge, just a bank-to-bank pull that usually clears in a day or two. But before you can send a single dollar, you have to link your bank once. There are two ways to do it: let Plaid log you in and connect the account instantly, or type your routing and account numbers in by hand. Both end in the same place. Here's how each one works." },
    { type: "quote", html: "<strong>Before you start:</strong> ACH only works with a US-based bank account, and the name on that bank account has to match the name on your Tradovate account exactly. You can keep one ACH-linked bank at a time. And if you're trading a prop-firm evaluation or funded account, skip this entirely, those are funded by the firm, so you won't link a personal bank to them." },
    { type: "heading", text: "Link Your Bank, Step by Step" },
    {
      type: "steps",
      items: [
        { title: "Open the Bank-Account Settings", html: "Log in to Tradovate, then open <strong class='text-white'>Application Settings</strong> from the top-right corner. Go to the <strong class='text-white'>Accounts</strong> section and look for the ACH or Bank Accounts setup. Depending on which build you're on, the entry point may read \"Setup ACH\" or live under a \"Transfers &amp; Payments\" area instead, either one lands you in the same funding screen." },
        { title: "Click Add ACH Account", html: "Scroll down to the <strong class='text-white'>Bank Accounts</strong> section and click <strong class='text-white'>Add ACH Account</strong>. This opens the linking flow, which is powered by Plaid, a third-party service that most US banks and brokers use to connect accounts securely. You'll be asked to accept Plaid's terms before it does anything with your bank." },
        { title: "Choose Automatic or Manual", html: "Once you're past the terms, you pick how to link. Choosing to <strong class='text-white'>set up ACH automatically</strong> launches Plaid's wizard and logs you straight into your bank. Choosing <strong class='text-white'>Manual</strong> lets you type your numbers in without handing over your online-banking password. If you bank with a big national institution, automatic is faster. If your bank isn't supported or you'd rather not log in through Plaid, go manual." },
        { title: "Automatic: Log In Through Plaid", html: "If you picked automatic, Plaid's Instant Verification kicks in. Search for your bank, sign in with your normal online-banking credentials, and choose which account you want to connect. Plaid confirms the account and routing details behind the scenes, so there's nothing to type. For most people this is done in a couple of minutes." },
        { title: "Manual: Enter Your Routing and Account Numbers", html: "Going manual? After you select <strong class='text-white'>Manual</strong> and click <strong class='text-white'>Continue</strong>, Plaid walks you through entering your bank's <strong class='text-white'>Routing Number</strong> and your <strong class='text-white'>Account Number</strong>. To prove the account is yours, Plaid sends a tiny deposit, one cent, that shows up with a three-letter authorization code in your bank's transaction description. Grab that code, come back, and enter it to verify. You may then get an email asking you to upload a document, usually a recent bank statement. That upload request can take a business day or two to arrive, so don't panic if it isn't instant." },
        { title: "Wait for Verification, Then Deposit", html: "After you finish either path, the link goes into review. Give it up to about 15 minutes on a business day, link on a weekend or holiday and it may sit in \"Under Review\" until the next business day. Once it's approved, head to the <strong class='text-white'>Transfers &amp; Payments</strong> page and you can request a deposit (or a withdrawal) straight to your linked bank." },
      ],
    },
    { type: "heading", text: "Automatic vs. Manual, Which to Use" },
    {
      type: "table",
      headers: ["", "Automatic (Plaid)", "Manual entry"],
      rows: [
        ["What you provide", "Your online-banking login", "Routing number + account number"],
        ["Speed", "Usually a few minutes", "Longer, waits on the one-cent code and any document upload"],
        ["Best for", "Major banks Plaid supports", "Banks Plaid can't log into, or if you'd rather not share a password"],
        ["Verification", "Handled instantly by Plaid", "Three-letter code from a $0.01 deposit, plus a possible statement upload"],
      ],
    },
    { type: "heading", text: "A Few Things Worth Knowing" },
    { type: "paragraph", html: "Money you push in by ACH generally has to come back out by ACH too, and there's a holding period before an ACH deposit is available to withdraw, plan around it if you're moving funds in and out. Deposits also have a per-window limit and an early-afternoon Central Time cutoff for same-day processing. Those exact figures shift over time and can differ by account and firm, so check the current numbers in the platform before you count on a same-day transfer. If a fresh deposit shows as locked for a few days, that's the standard clearing hold." },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Once your account is funded, the next step is putting your strategy on autopilot. <strong class='text-white'>PickMyTrade turns your TradingView alerts into live Tradovate orders</strong>, no manual clicking, no missed entries." },
  ], de: [
    { type: "paragraph",html: "ACH ist der günstigste Weg, Geld auf ein selbst finanziertes Tradovate-Konto zu überweisen. Keine Überweisungsgebühr, kein Kartenaufschlag, nur ein Bank-zu-Bank-Einzug, der in der Regel nach ein bis zwei Tagen abgeschlossen ist. Doch bevor Sie auch nur einen Dollar senden können, müssen Sie Ihre Bank einmalig verknüpfen. Dafür gibt es zwei Wege: Sie lassen sich per Plaid anmelden und verbinden das Konto sofort, oder Sie geben Ihre Routing- und Kontonummer von Hand ein. Beide Wege führen zum gleichen Ergebnis. So funktioniert jeder von ihnen." },
    { type: "quote",html: "<strong>Bevor Sie beginnen:</strong> ACH funktioniert nur mit einem Bankkonto in den USA, und der Name auf dem Bankkonto muss exakt mit dem Namen auf Ihrem Tradovate-Konto übereinstimmen. Sie können jeweils eine ACH-verknüpfte Bank hinterlegen. Und wenn Sie eine Prop-Firm-Evaluierung oder ein finanziertes Konto handeln, überspringen Sie das Ganze, denn diese werden von der Firma finanziert, Sie verknüpfen dafür also keine private Bank." },
    { type: "heading",text: "Bank verknüpfen, Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Die Bankkonto-Einstellungen öffnen", html: "Melden Sie sich bei Tradovate an und öffnen Sie dann <strong class='text-white'>Application Settings</strong> in der oberen rechten Ecke. Wechseln Sie zum Bereich <strong class='text-white'>Accounts</strong> und suchen Sie die ACH- bzw. Bankkonten-Einrichtung. Je nach Build kann der Einstiegspunkt „Setup ACH“ heißen oder stattdessen unter einem Bereich „Transfers &amp; Payments“ liegen. Beides führt Sie zum selben Einzahlungsbildschirm." },
        { title: "Auf „Add ACH Account“ klicken", html: "Scrollen Sie nach unten zum Abschnitt <strong class='text-white'>Bank Accounts</strong> und klicken Sie auf <strong class='text-white'>Add ACH Account</strong>. Damit öffnet sich der Verknüpfungsablauf, der von Plaid betrieben wird, einem Drittanbieter-Dienst, den die meisten US-Banken und Broker zur sicheren Kontoverbindung nutzen. Sie müssen die Bedingungen von Plaid akzeptieren, bevor etwas mit Ihrer Bank geschieht." },
        { title: "Automatisch oder manuell wählen", html: "Nach den Bedingungen wählen Sie die Art der Verknüpfung. Wenn Sie <strong class='text-white'>set up ACH automatically</strong> wählen, startet der Assistent von Plaid und meldet Sie direkt bei Ihrer Bank an. Mit <strong class='text-white'>Manual</strong> tragen Sie Ihre Nummern ein, ohne Ihr Online-Banking-Passwort preiszugeben. Bei einer großen nationalen Bank geht es automatisch schneller. Wird Ihre Bank nicht unterstützt oder möchten Sie sich nicht über Plaid anmelden, wählen Sie manuell." },
        { title: "Automatisch: Anmeldung über Plaid", html: "Wenn Sie automatisch gewählt haben, startet die Sofortverifizierung von Plaid. Suchen Sie Ihre Bank, melden Sie sich mit Ihren üblichen Online-Banking-Zugangsdaten an und wählen Sie das Konto, das Sie verbinden möchten. Plaid bestätigt Konto- und Routing-Daten im Hintergrund, Sie müssen also nichts eintippen. Für die meisten ist das in wenigen Minuten erledigt." },
        { title: "Manuell: Routing- und Kontonummer eingeben", html: "Manuell? Nachdem Sie <strong class='text-white'>Manual</strong> gewählt und auf <strong class='text-white'>Continue</strong> geklickt haben, führt Plaid Sie durch die Eingabe der <strong class='text-white'>Routing Number</strong> und der <strong class='text-white'>Account Number</strong> Ihrer Bank. Um zu belegen, dass das Konto Ihnen gehört, sendet Plaid eine winzige Einzahlung von einem Cent, die in der Transaktionsbeschreibung Ihrer Bank mit einem dreistelligen Autorisierungscode erscheint. Notieren Sie diesen Code, kehren Sie zurück und geben Sie ihn zur Verifizierung ein. Anschließend erhalten Sie eventuell eine E-Mail mit der Aufforderung, ein Dokument hochzuladen, meist einen aktuellen Kontoauszug. Diese Aufforderung kann ein bis zwei Werktage auf sich warten lassen, also keine Sorge, wenn sie nicht sofort kommt." },
        { title: "Auf die Verifizierung warten, dann einzahlen", html: "Nach Abschluss eines der beiden Wege geht die Verknüpfung in die Prüfung. Rechnen Sie an einem Werktag mit bis zu etwa 15 Minuten. Verknüpfen Sie an einem Wochenende oder Feiertag, kann sie bis zum nächsten Werktag auf „Under Review“ stehen. Sobald sie genehmigt ist, öffnen Sie die Seite <strong class='text-white'>Transfers &amp; Payments</strong>, und Sie können eine Einzahlung (oder Auszahlung) direkt an Ihre verknüpfte Bank anfordern." },
      ],
    },
    { type: "heading",text: "Automatisch vs. manuell: Was ist die richtige Wahl?" },
    { type: "table", headers: ["","Automatisch (Plaid)","Manuelle Eingabe"], rows: [
      ["Was Sie angeben","Ihre Online-Banking-Zugangsdaten","Routing-Nummer + Kontonummer"],
      ["Geschwindigkeit","In der Regel wenige Minuten","Länger, wartet auf den Ein-Cent-Code und einen möglichen Dokument-Upload"],
      ["Am besten für","Große Banken, die Plaid unterstützt","Banken, bei denen sich Plaid nicht anmelden kann, oder wenn Sie kein Passwort teilen möchten"],
      ["Verifizierung","Sofort durch Plaid erledigt","Dreistelliger Code aus einer Einzahlung von $0.01, plus möglicher Kontoauszug-Upload"],
    ] },
    { type: "heading",text: "Einige wissenswerte Punkte" },
    { type: "paragraph",html: "Geld, das Sie per ACH einzahlen, muss in der Regel auch per ACH wieder abfließen, und vor der Verfügbarkeit zur Auszahlung gilt eine Haltefrist für ACH-Einzahlungen. Planen Sie das ein, wenn Sie Gelder hin- und herbewegen. Einzahlungen haben außerdem ein Limit pro Zeitfenster und einen Annahmeschluss am frühen Nachmittag (Central Time) für die Bearbeitung am selben Tag. Diese genauen Werte ändern sich im Laufe der Zeit und können je nach Konto und Firma abweichen. Prüfen Sie daher die aktuellen Zahlen in der Plattform, bevor Sie sich auf eine Überweisung am selben Tag verlassen. Wenn eine frische Einzahlung einige Tage lang als gesperrt angezeigt wird, ist das die übliche Clearing-Haltefrist." },
    { type: "heading",text: "Automatisieren Sie das mit PickMyTrade" },
    { type: "paragraph",html: "Sobald Ihr Konto finanziert ist, folgt der nächste Schritt: Ihre Strategie auf Autopilot zu schalten. <strong class='text-white'>PickMyTrade wandelt Ihre TradingView-Alarme in echte Tradovate-Orders um</strong>, ohne manuelles Klicken und ohne verpasste Einstiege." },
  ], es: [
    { type: "paragraph",html: "ACH es la forma más económica de mover dinero a una cuenta de Tradovate financiada por usted mismo. Sin comisión de transferencia, sin recargo por tarjeta, solo un cobro de banco a banco que normalmente se completa en uno o dos días. Pero antes de poder enviar un solo dólar, debe vincular su banco una vez. Hay dos maneras de hacerlo: dejar que Plaid inicie sesión y conecte la cuenta al instante, o escribir a mano sus números de ruta y de cuenta. Ambas llegan al mismo resultado. Así funciona cada una." },
    { type: "quote",html: "<strong>Antes de empezar:</strong> ACH solo funciona con una cuenta bancaria con sede en EE. UU., y el nombre de la cuenta bancaria debe coincidir exactamente con el nombre de su cuenta de Tradovate. Puede mantener un solo banco vinculado por ACH a la vez. Y si opera una evaluación o una cuenta fondeada de una prop firm, sáltese todo esto: esas cuentas las financia la firma, así que no vinculará un banco personal." },
    { type: "heading",text: "Vincule su banco, paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra la configuración de cuentas bancarias", html: "Inicie sesión en Tradovate y abra <strong class='text-white'>Application Settings</strong> desde la esquina superior derecha. Vaya a la sección <strong class='text-white'>Accounts</strong> y busque la configuración de ACH o de cuentas bancarias. Según la compilación que use, el punto de entrada puede aparecer como «Setup ACH» o estar en un área de «Transfers &amp; Payments»; en ambos casos llega a la misma pantalla de fondeo." },
        { title: "Haga clic en Add ACH Account", html: "Desplácese hasta la sección <strong class='text-white'>Bank Accounts</strong> y haga clic en <strong class='text-white'>Add ACH Account</strong>. Se abre el flujo de vinculación, impulsado por Plaid, un servicio de terceros que la mayoría de los bancos y brokers de EE. UU. usan para conectar cuentas de forma segura. Se le pedirá que acepte los términos de Plaid antes de que haga nada con su banco." },
        { title: "Elija automático o manual", html: "Una vez aceptados los términos, elige cómo vincular. Si elige <strong class='text-white'>set up ACH automatically</strong>, se inicia el asistente de Plaid y accede directamente a su banco. Si elige <strong class='text-white'>Manual</strong>, introduce sus números sin entregar la contraseña de su banca en línea. Si su banco es una gran entidad nacional, lo automático es más rápido. Si su banco no es compatible o prefiere no iniciar sesión a través de Plaid, elija manual." },
        { title: "Automático: inicie sesión a través de Plaid", html: "Si eligió automático, entra en acción la verificación instantánea de Plaid. Busque su banco, inicie sesión con sus credenciales habituales de banca en línea y elija la cuenta que desea conectar. Plaid confirma los datos de cuenta y de ruta en segundo plano, así que no hay nada que escribir. Para la mayoría de las personas, queda listo en un par de minutos." },
        { title: "Manual: introduzca sus números de ruta y de cuenta", html: "¿Prefiere el modo manual? Después de seleccionar <strong class='text-white'>Manual</strong> y hacer clic en <strong class='text-white'>Continue</strong>, Plaid le guía para introducir el <strong class='text-white'>Routing Number</strong> y el <strong class='text-white'>Account Number</strong> de su banco. Para demostrar que la cuenta es suya, Plaid envía un depósito diminuto, de un centavo, que aparece con un código de autorización de tres letras en la descripción de la transacción de su banco. Anote ese código, vuelva e introdúzcalo para verificar. Después puede que reciba un correo pidiéndole subir un documento, normalmente un extracto bancario reciente. Esa solicitud puede tardar uno o dos días hábiles en llegar, así que no se alarme si no es inmediata." },
        { title: "Espere la verificación y luego deposite", html: "Tras completar cualquiera de los dos caminos, la vinculación pasa a revisión. Cuente con hasta unos 15 minutos en un día hábil; si vincula en fin de semana o festivo, puede permanecer en «Under Review» hasta el siguiente día hábil. Una vez aprobada, vaya a la página <strong class='text-white'>Transfers &amp; Payments</strong> y podrá solicitar un depósito (o un retiro) directamente a su banco vinculado." },
      ],
    },
    { type: "heading",text: "Automático frente a manual: cuál usar" },
    { type: "table", headers: ["","Automático (Plaid)","Introducción manual"], rows: [
      ["Lo que usted aporta","Sus credenciales de banca en línea","Número de ruta + número de cuenta"],
      ["Rapidez","Normalmente unos minutos","Más lento: espera el código del centavo y una posible carga de documento"],
      ["Ideal para","Grandes bancos compatibles con Plaid","Bancos a los que Plaid no puede acceder, o si prefiere no compartir una contraseña"],
      ["Verificación","La gestiona Plaid al instante","Código de tres letras de un depósito de $0.01, más una posible carga de extracto"],
    ] },
    { type: "heading",text: "Algunas cosas que conviene saber" },
    { type: "paragraph",html: "El dinero que ingresa por ACH generalmente debe salir también por ACH, y existe un período de retención antes de que un depósito ACH esté disponible para retirar; téngalo en cuenta si mueve fondos de entrada y salida. Los depósitos también tienen un límite por ventana y una hora de corte a primera hora de la tarde (hora central) para el procesamiento el mismo día. Estas cifras exactas cambian con el tiempo y pueden variar según la cuenta y la firma, así que consulte los números vigentes en la plataforma antes de contar con una transferencia el mismo día. Si un depósito reciente aparece bloqueado durante unos días, es la retención estándar de compensación." },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Una vez financiada su cuenta, el siguiente paso es poner su estrategia en piloto automático. <strong class='text-white'>PickMyTrade convierte sus alertas de TradingView en órdenes reales de Tradovate</strong>, sin clics manuales ni entradas perdidas." },
  ], fr: [
    { type: "paragraph",html: "L’ACH est le moyen le moins coûteux d’alimenter un compte Tradovate autofinancé. Pas de frais de virement, pas de surcharge de carte, simplement un prélèvement de banque à banque qui est généralement réglé en un jour ou deux. Mais avant de pouvoir envoyer le moindre dollar, vous devez lier votre banque une fois. Il y a deux façons de le faire : laisser Plaid vous connecter et relier le compte instantanément, ou saisir à la main vos numéros d’acheminement et de compte. Les deux aboutissent au même résultat. Voici comment chacune fonctionne." },
    { type: "quote",html: "<strong>Avant de commencer :</strong> l’ACH ne fonctionne qu’avec un compte bancaire basé aux États-Unis, et le nom sur le compte bancaire doit correspondre exactement au nom de votre compte Tradovate. Vous ne pouvez avoir qu’une seule banque liée par ACH à la fois. Et si vous tradez une évaluation ou un compte financé d’une prop firm, ignorez tout ceci : ces comptes sont financés par la société, vous ne lierez donc pas de banque personnelle." },
    { type: "heading",text: "Liez votre banque, étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir les paramètres du compte bancaire", html: "Connectez-vous à Tradovate, puis ouvrez <strong class='text-white'>Application Settings</strong> dans le coin supérieur droit. Allez dans la section <strong class='text-white'>Accounts</strong> et cherchez la configuration ACH ou des comptes bancaires. Selon votre version, le point d’entrée peut s’intituler « Setup ACH » ou se trouver plutôt dans une zone « Transfers &amp; Payments » ; dans les deux cas, vous arrivez au même écran de financement." },
        { title: "Cliquer sur Add ACH Account", html: "Faites défiler jusqu’à la section <strong class='text-white'>Bank Accounts</strong> et cliquez sur <strong class='text-white'>Add ACH Account</strong>. Cela ouvre le parcours de liaison, propulsé par Plaid, un service tiers que la plupart des banques et courtiers américains utilisent pour connecter les comptes en toute sécurité. Il vous sera demandé d’accepter les conditions de Plaid avant qu’il ne fasse quoi que ce soit avec votre banque." },
        { title: "Choisir automatique ou manuel", html: "Une fois les conditions acceptées, vous choisissez le mode de liaison. Choisir <strong class='text-white'>set up ACH automatically</strong> lance l’assistant de Plaid et vous connecte directement à votre banque. Choisir <strong class='text-white'>Manual</strong> vous permet de saisir vos numéros sans communiquer votre mot de passe de banque en ligne. Si vous êtes client d’un grand établissement national, l’automatique est plus rapide. Si votre banque n’est pas prise en charge ou si vous préférez ne pas vous connecter via Plaid, choisissez le manuel." },
        { title: "Automatique : connexion via Plaid", html: "Si vous avez choisi l’automatique, la vérification instantanée de Plaid se met en route. Recherchez votre banque, connectez-vous avec vos identifiants habituels de banque en ligne et choisissez le compte que vous souhaitez relier. Plaid confirme les informations de compte et d’acheminement en arrière-plan, il n’y a donc rien à saisir. Pour la plupart des gens, c’est fait en quelques minutes." },
        { title: "Manuel : saisir vos numéros d’acheminement et de compte", html: "Vous préférez le manuel ? Après avoir sélectionné <strong class='text-white'>Manual</strong> et cliqué sur <strong class='text-white'>Continue</strong>, Plaid vous guide pour saisir le <strong class='text-white'>Routing Number</strong> et l’<strong class='text-white'>Account Number</strong> de votre banque. Pour prouver que le compte est le vôtre, Plaid envoie un minuscule dépôt, d’un centime, qui apparaît avec un code d’autorisation de trois lettres dans la description de la transaction de votre banque. Notez ce code, revenez et saisissez-le pour vérifier. Vous pouvez ensuite recevoir un e-mail vous demandant de téléverser un document, généralement un relevé bancaire récent. Cette demande peut mettre un ou deux jours ouvrés à arriver, ne paniquez donc pas si elle n’est pas immédiate." },
        { title: "Attendre la vérification, puis déposer", html: "Une fois l’un ou l’autre parcours terminé, la liaison passe en examen. Comptez jusqu’à environ 15 minutes un jour ouvré ; si vous liez le compte un week-end ou un jour férié, il peut rester en « Under Review » jusqu’au jour ouvré suivant. Une fois approuvé, rendez-vous sur la page <strong class='text-white'>Transfers &amp; Payments</strong> et vous pourrez demander un dépôt (ou un retrait) directement vers votre banque liée." },
      ],
    },
    { type: "heading",text: "Automatique ou manuel : lequel choisir" },
    { type: "table", headers: ["","Automatique (Plaid)","Saisie manuelle"], rows: [
      ["Ce que vous fournissez","Vos identifiants de banque en ligne","Numéro d’acheminement + numéro de compte"],
      ["Rapidité","Généralement quelques minutes","Plus long : attente du code d’un centime et d’un éventuel téléversement de document"],
      ["Idéal pour","Les grandes banques prises en charge par Plaid","Les banques auxquelles Plaid ne peut pas se connecter, ou si vous préférez ne pas partager de mot de passe"],
