---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-trusted-devices";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Manage Trusted Devices in Tradovate";
const META_DESCRIPTION =
  "Approve, review, and remove trusted devices on the Tradovate Security page so only machines you recognize can log in and place orders.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Vertrauenswürdige Geräte in Tradovate verwalten", es: "Gestione los dispositivos de confianza en Tradovate", fr: "Gérer les appareils de confiance dans Tradovate", it: "Gestire i dispositivi attendibili in Tradovate" },
  dek: { en: "Once you turn on two-factor authentication, Tradovate keeps a running list of the machines you've approved to sign in. Here's how to approve the devices you trust and clear out the ones you don't.", de: "Sobald Sie die Zwei-Faktor-Authentifizierung aktivieren, führt Tradovate eine laufende Liste der Rechner, die Sie für die Anmeldung freigegeben haben. So geben Sie Geräte frei, denen Sie vertrauen, und entfernen die übrigen.", es: "Una vez que activa la autenticación de dos factores, Tradovate mantiene una lista de los equipos que ha aprobado para iniciar sesión. Así se aprueban los dispositivos de confianza y se eliminan los demás.", fr: "Dès que vous activez l'authentification à deux facteurs, Tradovate tient à jour la liste des machines que vous avez approuvées pour vous connecter. Voici comment approuver les appareils de confiance et supprimer les autres.", it: "Una volta attivata l'autenticazione a due fattori, Tradovate mantiene un elenco delle macchine che ha approvato per l'accesso. Ecco come approvare i dispositivi di cui si fida e rimuovere gli altri." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Once you turn on two-factor authentication, Tradovate keeps a running list of the machines you've approved to sign in. That list is your trusted devices. It's worth checking every so often, because a browser you no longer use, or one you don't recognize at all, has no business holding a key to an account that can place live orders. Here's how to approve the devices you trust and clear out the ones you don't." },
    { type: "heading", text: "What a Trusted Device Actually Is" },
    { type: "paragraph", html: "With 2FA switched on, every new browser or app that tries to log in has to be approved before it gets through. Approve one and Tradovate remembers it, so you're not re-verifying every single session. The tradeoff is simple: an approved device stays approved until you remove it by hand. That's exactly why the device list is worth your attention." },
    { type: "heading", text: "Before You Start" },
    { type: "paragraph", html: "Two things need to be in place:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>2FA has to be on.</strong> Trusted devices sit on top of two-factor authentication. If 2FA is off, there's nothing to manage yet.",
        "<strong class='text-white'>You need the email tied to your account.</strong> Approvals and one-time codes land in that inbox, so keep it handy.",
      ],
    },
    { type: "paragraph", html: "One caveat if you're on a prop-firm or evaluation account: some security options are controlled by the firm, not by you. If a toggle is greyed out, that's usually why. Rules vary by firm and account type, so check your firm's current policy before assuming something is broken." },
    { type: "heading", text: "Approve and Manage Trusted Devices, Step by Step" },
    {
      type: "steps",
      items: [
        { title: "Open Application Settings and Go to the Security Tab", html: "Open the Tradovate web or desktop platform and head into Application Settings. Look for the Security tab (some builds label it \"Security &amp; Privacy\"). This single page holds every account-security control you'll touch, from the 2FA switch down to the full device list.", image: { src: `${IMG}/tradovate-trusted-devices-1.png`, alt: "Tradovate Application Settings menu with the Security tab highlighted" } },
        { title: "Turn on Two-Factor Authentication", html: "If you haven't already, click the control to enable 2-Factor Authentication. A box pops up asking for your Tradovate password. Enter it to confirm the change. From that point on, you'll get an email any time a new device or browser tries to log in to your account.", image: { src: `${IMG}/tradovate-trusted-devices-2.png`, alt: "Tradovate Security page showing the 2-Factor Authentication control and password confirmation prompt" } },
        { title: "Enable \"Sign In On A Trusted Device\"", html: "Scroll down below the 2FA control and turn on Sign In On A Trusted Device. Now log in from the machine you actually want to trust. Tradovate emails you a code; type that code into the prompt on the device and it gets added to your trusted list. Do this once per device you use regularly.", image: { src: `${IMG}/tradovate-trusted-devices-3.png`, alt: "Tradovate Sign In On A Trusted Device toggle below the 2FA control" } },
        { title: "Approve or Deny a New Device From the Email", html: "Any time a new machine attempts a login, check your inbox. The email gives you two buttons: Approve or Deny. Approve the devices you recognize. If a login you didn't start shows up, hit Deny and change your password right away. This is the moment that stops an unfamiliar device before it ever reaches your orders." },
        { title: "Review and Clean Up the Device List", html: "Back on the Security page, scroll to the bottom to see every device tied to your account. A device you approved shows a <strong class='text-white'>Remove Access</strong> option; use it to revoke anything you no longer use, like an old laptop or a shared machine. A device still waiting shows as <strong class='text-white'>Pending</strong> with a <strong class='text-white'>Forget</strong> option, which wipes it and forces a fresh Approve/Deny email if it ever tries again. Make a habit of trimming this list, especially after you log in from a friend's computer or a public one." },
      ],
    },
    { type: "heading", text: "What Each Device Status Means" },
    {
      type: "table",
      headers: ["Status", "What it means", "Your options"],
      rows: [
        ["Pending", "A device attempted a login but hasn't been approved yet", "Forget: clears it, and the next login attempt triggers a new Approve/Deny email"],
        ["Approved", "You confirmed this device through the email link", "Remove Access: revokes the device immediately"],
      ],
    },
    { type: "paragraph", html: "Beyond trusted devices, Tradovate's Security page also lets you layer on stronger 2FA methods when you want them, including a security key, an authenticator app, or SMS codes. They all follow the same idea: verify a new login before it's allowed to stick." },
    { type: "heading", text: "If a Device Won't Approve" },
    { type: "paragraph", html: "A few things trip people up. The approval email can take a minute to arrive, and it sometimes lands in spam, so check there before you retry. If you keep getting bounced into a new-device approval loop every session, your device ID may be resetting behind the scenes. And if you're signed in across several places at once, web, desktop, mobile, and TradingView, the two-session limit can shuffle you around and muddy the device picture. Sorting that out usually clears the confusion too." },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Tired of babysitting logins and manual approvals just to keep your strategy running? PickMyTrade automates your Tradovate order flow from TradingView alerts, so your setup keeps executing while you handle the security side once and move on." },
  ], de: [
    { type: "paragraph",html: "Sobald Sie die Zwei-Faktor-Authentifizierung aktivieren, führt Tradovate eine laufende Liste der Rechner, die Sie für die Anmeldung freigegeben haben. Diese Liste sind Ihre vertrauenswürdigen Geräte. Es lohnt sich, sie hin und wieder zu prüfen, denn ein Browser, den Sie nicht mehr nutzen oder den Sie gar nicht erkennen, hat keinen Anspruch auf einen Schlüssel zu einem Konto, über das Live-Orders platziert werden können. So geben Sie Geräte frei, denen Sie vertrauen, und entfernen die übrigen." },
    { type: "heading",text: "Was ein vertrauenswürdiges Gerät tatsächlich ist" },
    { type: "paragraph",html: "Ist 2FA aktiviert, muss jeder neue Browser und jede neue App, die sich anmelden will, zuerst freigegeben werden, bevor sie durchgelassen wird. Geben Sie ein Gerät frei, merkt sich Tradovate es, sodass Sie nicht in jeder Sitzung erneut verifizieren müssen. Der Kompromiss ist einfach: Ein freigegebenes Gerät bleibt freigegeben, bis Sie es von Hand entfernen. Genau deshalb verdient die Geräteliste Ihre Aufmerksamkeit." },
    { type: "heading",text: "Bevor Sie beginnen" },
    { type: "paragraph",html: "Zwei Dinge müssen vorhanden sein:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>2FA muss aktiviert sein.</strong> Vertrauenswürdige Geräte bauen auf der Zwei-Faktor-Authentifizierung auf. Ist 2FA deaktiviert, gibt es noch nichts zu verwalten.",
        "<strong class='text-white'>Sie benötigen die mit Ihrem Konto verknüpfte E-Mail-Adresse.</strong> Freigaben und Einmalcodes landen in diesem Posteingang, halten Sie ihn also griffbereit.",
      ],
    },
    { type: "paragraph",html: "Ein Hinweis, falls Sie ein Prop-Firm- oder Evaluierungskonto nutzen: Einige Sicherheitsoptionen werden von der Firma kontrolliert, nicht von Ihnen. Ist ein Schalter ausgegraut, liegt es meist daran. Die Regeln unterscheiden sich je nach Firma und Kontotyp. Prüfen Sie daher die aktuellen Richtlinien Ihrer Firma, bevor Sie annehmen, dass etwas defekt ist." },
    { type: "heading",text: "Vertrauenswürdige Geräte freigeben und verwalten, Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Application Settings öffnen und zum Tab Security wechseln", html: "Öffnen Sie die Tradovate-Web- oder Desktop-Plattform und gehen Sie zu Application Settings. Suchen Sie den Tab Security (manche Versionen bezeichnen ihn als „Security &amp; Privacy“). Diese eine Seite enthält alle Kontosicherheits-Einstellungen, mit denen Sie zu tun haben werden, vom 2FA-Schalter bis zur vollständigen Geräteliste.", image: {"src":`${IMG}/tradovate-trusted-devices-1.png`,"alt":"Tradovate-Menü Application Settings mit hervorgehobenem Tab Security"} },
        { title: "Zwei-Faktor-Authentifizierung aktivieren", html: "Falls noch nicht geschehen, klicken Sie auf das Steuerelement, um 2-Factor Authentication zu aktivieren. Es erscheint ein Fenster, das Ihr Tradovate-Passwort verlangt. Geben Sie es ein, um die Änderung zu bestätigen. Ab diesem Moment erhalten Sie jedes Mal eine E-Mail, wenn ein neues Gerät oder ein neuer Browser versucht, sich bei Ihrem Konto anzumelden.", image: {"src":`${IMG}/tradovate-trusted-devices-2.png`,"alt":"Tradovate-Sicherheitsseite mit dem Steuerelement für 2-Factor Authentication und der Passwortabfrage"} },
        { title: "„Sign In On A Trusted Device“ aktivieren", html: "Scrollen Sie unter das 2FA-Steuerelement und aktivieren Sie Sign In On A Trusted Device. Melden Sie sich nun an dem Rechner an, dem Sie tatsächlich vertrauen möchten. Tradovate sendet Ihnen einen Code per E-Mail; geben Sie diesen Code in die Eingabeaufforderung auf dem Gerät ein, und es wird Ihrer Liste vertrauenswürdiger Geräte hinzugefügt. Tun Sie das einmal für jedes Gerät, das Sie regelmäßig verwenden.", image: {"src":`${IMG}/tradovate-trusted-devices-3.png`,"alt":"Tradovate-Schalter Sign In On A Trusted Device unterhalb des 2FA-Steuerelements"} },
        { title: "Neues Gerät per E-Mail freigeben oder ablehnen", html: "Prüfen Sie Ihren Posteingang jedes Mal, wenn ein neuer Rechner einen Anmeldeversuch unternimmt. Die E-Mail enthält zwei Schaltflächen: Approve oder Deny. Geben Sie die Geräte frei, die Sie erkennen. Taucht ein Anmeldeversuch auf, den Sie nicht ausgelöst haben, klicken Sie auf Deny und ändern Sie sofort Ihr Passwort. Das ist der Moment, in dem ein unbekanntes Gerät gestoppt wird, bevor es Ihre Orders erreicht." },
        { title: "Geräteliste prüfen und bereinigen", html: "Scrollen Sie auf der Security-Seite ganz nach unten, um alle mit Ihrem Konto verknüpften Geräte zu sehen. Ein von Ihnen freigegebenes Gerät zeigt die Option <strong class='text-white'>Remove Access</strong>; nutzen Sie sie, um alles zu widerrufen, was Sie nicht mehr verwenden, etwa einen alten Laptop oder einen gemeinsam genutzten Rechner. Ein noch wartendes Gerät erscheint als <strong class='text-white'>Pending</strong> mit der Option <strong class='text-white'>Forget</strong>, die es löscht und bei einem erneuten Versuch eine neue Approve/Deny-E-Mail erzwingt. Machen Sie es sich zur Gewohnheit, diese Liste auszudünnen, besonders nachdem Sie sich am Computer eines Freundes oder an einem öffentlichen Rechner angemeldet haben." },
      ],
    },
    { type: "heading",text: "Was die einzelnen Gerätestatus bedeuten" },
    { type: "table", headers: ["Status","Bedeutung","Ihre Optionen"], rows: [
      ["Pending","Ein Gerät hat einen Anmeldeversuch unternommen, wurde aber noch nicht freigegeben","Forget: löscht es, und der nächste Anmeldeversuch löst eine neue Approve/Deny-E-Mail aus"],
      ["Approved","Sie haben dieses Gerät über den Link in der E-Mail bestätigt","Remove Access: widerruft das Gerät sofort"],
    ] },
    { type: "paragraph",html: "Über vertrauenswürdige Geräte hinaus können Sie auf der Sicherheitsseite von Tradovate bei Bedarf auch stärkere 2FA-Methoden hinzufügen, darunter einen Sicherheitsschlüssel, eine Authenticator-App oder SMS-Codes. Sie alle folgen demselben Prinzip: Eine neue Anmeldung wird verifiziert, bevor sie dauerhaft gelten darf." },
    { type: "heading",text: "Wenn sich ein Gerät nicht freigeben lässt" },
    { type: "paragraph",html: "Ein paar Dinge bringen viele Nutzer ins Stolpern. Die Freigabe-E-Mail kann eine Minute brauchen und landet manchmal im Spam, prüfen Sie dort also nach, bevor Sie es erneut versuchen. Wenn Sie in jeder Sitzung in eine Schleife der Neugeräte-Freigabe geraten, wird Ihre Geräte-ID womöglich im Hintergrund zurückgesetzt. Und wenn Sie an mehreren Orten gleichzeitig angemeldet sind, Web, Desktop, Mobil und TradingView, kann das Limit von zwei Sitzungen Sie hin- und herschieben und das Geräte-Bild trüben. Wenn Sie das klären, löst sich die Verwirrung meist ebenfalls auf." },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "Haben Sie genug davon, Anmeldungen und manuelle Freigaben zu beaufsichtigen, nur damit Ihre Strategie läuft? PickMyTrade automatisiert Ihren Tradovate-Orderfluss aus TradingView-Alerts, sodass Ihr Setup weiter ausführt, während Sie die Sicherheit einmal erledigen und weitermachen." },
  ], es: [
    { type: "paragraph",html: "Una vez que activa la autenticación de dos factores, Tradovate mantiene una lista de los equipos que ha aprobado para iniciar sesión. Esa lista son sus dispositivos de confianza. Conviene revisarla de vez en cuando, porque un navegador que ya no usa, o uno que no reconoce en absoluto, no debería tener la llave de una cuenta capaz de enviar órdenes en vivo. Así se aprueban los dispositivos de confianza y se eliminan los demás." },
    { type: "heading",text: "Qué es realmente un dispositivo de confianza" },
    { type: "paragraph",html: "Con 2FA activada, cada navegador o aplicación nuevos que intentan iniciar sesión deben ser aprobados antes de poder entrar. Si aprueba uno, Tradovate lo recuerda, de modo que no tiene que volver a verificar en cada sesión. La contrapartida es simple: un dispositivo aprobado sigue aprobado hasta que usted lo elimine manualmente. Por eso mismo la lista de dispositivos merece su atención." },
    { type: "heading",text: "Antes de empezar" },
    { type: "paragraph",html: "Hay dos cosas que deben estar listas:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>2FA debe estar activada.</strong> Los dispositivos de confianza se apoyan en la autenticación de dos factores. Si 2FA está desactivada, aún no hay nada que gestionar.",
        "<strong class='text-white'>Necesita el correo electrónico asociado a su cuenta.</strong> Las aprobaciones y los códigos de un solo uso llegan a esa bandeja de entrada, así que téngala a mano.",
      ],
    },
    { type: "paragraph",html: "Una advertencia si utiliza una cuenta de prop firm o de evaluación: algunas opciones de seguridad las controla la empresa, no usted. Si un interruptor aparece atenuado, normalmente es por eso. Las reglas varían según la empresa y el tipo de cuenta, así que consulte la política vigente de su empresa antes de suponer que algo está roto." },
    { type: "heading",text: "Apruebe y gestione dispositivos de confianza, paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra Application Settings y vaya a la pestaña Security", html: "Abra la plataforma web o de escritorio de Tradovate y entre en Application Settings. Busque la pestaña Security (algunas versiones la llaman «Security &amp; Privacy»). Esta única página reúne todos los controles de seguridad de la cuenta que va a necesitar, desde el interruptor de 2FA hasta la lista completa de dispositivos.", image: {"src":`${IMG}/tradovate-trusted-devices-1.png`,"alt":"Menú Application Settings de Tradovate con la pestaña Security resaltada"} },
        { title: "Active la autenticación de dos factores", html: "Si aún no lo ha hecho, haga clic en el control para activar 2-Factor Authentication. Aparecerá un cuadro que le pide su contraseña de Tradovate. Introdúzcala para confirmar el cambio. A partir de ese momento recibirá un correo cada vez que un dispositivo o navegador nuevo intente iniciar sesión en su cuenta.", image: {"src":`${IMG}/tradovate-trusted-devices-2.png`,"alt":"Página Security de Tradovate con el control de 2-Factor Authentication y el aviso de confirmación de contraseña"} },
        { title: "Active «Sign In On A Trusted Device»", html: "Desplácese hacia abajo, por debajo del control de 2FA, y active Sign In On A Trusted Device. Ahora inicie sesión desde el equipo en el que realmente quiere confiar. Tradovate le envía un código por correo; escríbalo en el aviso del dispositivo y este se añadirá a su lista de dispositivos de confianza. Haga esto una vez por cada dispositivo que use con regularidad.", image: {"src":`${IMG}/tradovate-trusted-devices-3.png`,"alt":"Interruptor Sign In On A Trusted Device de Tradovate debajo del control de 2FA"} },
        { title: "Apruebe o rechace un dispositivo nuevo desde el correo", html: "Cada vez que un equipo nuevo intente iniciar sesión, revise su bandeja de entrada. El correo le ofrece dos botones: Approve o Deny. Apruebe los dispositivos que reconozca. Si aparece un inicio de sesión que usted no inició, pulse Deny y cambie su contraseña de inmediato. Es el momento que frena a un dispositivo desconocido antes de que llegue a sus órdenes." },
        { title: "Revise y depure la lista de dispositivos", html: "De vuelta en la página Security, desplácese hasta el final para ver todos los dispositivos asociados a su cuenta. Un dispositivo aprobado muestra la opción <strong class='text-white'>Remove Access</strong>; úsela para revocar todo lo que ya no utilice, como un portátil antiguo o un equipo compartido. Un dispositivo que aún espera aparece como <strong class='text-white'>Pending</strong> con la opción <strong class='text-white'>Forget</strong>, que lo borra y obliga a enviar un nuevo correo Approve/Deny si vuelve a intentarlo. Adquiera el hábito de depurar esta lista, sobre todo después de iniciar sesión en el ordenador de un amigo o en uno público." },
      ],
    },
    { type: "heading",text: "Qué significa cada estado de dispositivo" },
    { type: "table", headers: ["Estado","Qué significa","Sus opciones"], rows: [
      ["Pending","Un dispositivo intentó iniciar sesión, pero aún no ha sido aprobado","Forget: lo borra, y el siguiente intento de inicio de sesión genera un nuevo correo Approve/Deny"],
      ["Approved","Usted confirmó este dispositivo mediante el enlace del correo","Remove Access: revoca el dispositivo de inmediato"],
    ] },
    { type: "paragraph",html: "Además de los dispositivos de confianza, la página de seguridad de Tradovate también le permite añadir métodos de 2FA más fuertes cuando lo desee, como una llave de seguridad, una aplicación de autenticación o códigos por SMS. Todos siguen la misma idea: verificar un inicio de sesión nuevo antes de permitir que se mantenga." },
    { type: "heading",text: "Si un dispositivo no se aprueba" },
    { type: "paragraph",html: "Algunas cosas suelen causar problemas. El correo de aprobación puede tardar un minuto en llegar y a veces cae en spam, así que revise allí antes de reintentar. Si cada sesión le devuelve a un bucle de aprobación de dispositivo nuevo, es posible que el identificador de su dispositivo se esté restableciendo en segundo plano. Y si tiene la sesión abierta en varios lugares a la vez, web, escritorio, móvil y TradingView, el límite de dos sesiones puede moverle de un sitio a otro y enturbiar el panorama de dispositivos. Resolver eso suele aclarar también la confusión." },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "¿Cansado de vigilar inicios de sesión y aprobaciones manuales solo para que su estrategia siga funcionando? PickMyTrade automatiza su flujo de órdenes de Tradovate a partir de las alertas de TradingView, para que su configuración siga ejecutándose mientras usted resuelve la seguridad una sola vez y sigue adelante." },
  ], fr: [
    { type: "paragraph",html: "Dès que vous activez l'authentification à deux facteurs, Tradovate tient à jour la liste des machines que vous avez approuvées pour vous connecter. Cette liste constitue vos appareils de confiance. Il vaut la peine de la vérifier de temps en temps, car un navigateur que vous n'utilisez plus, ou que vous ne reconnaissez pas du tout, n'a aucune raison de détenir une clé d'un compte capable de passer des ordres réels. Voici comment approuver les appareils de confiance et supprimer les autres." },
    { type: "heading",text: "Ce qu'est réellement un appareil de confiance" },
    { type: "paragraph",html: "Lorsque la 2FA est activée, chaque nouveau navigateur ou application qui tente de se connecter doit être approuvé avant de passer. Si vous en approuvez un, Tradovate s'en souvient, et vous n'avez donc pas à vous vérifier de nouveau à chaque session. Le compromis est simple : un appareil approuvé le reste jusqu'à ce que vous le supprimiez manuellement. C'est précisément pourquoi la liste des appareils mérite votre attention." },
    { type: "heading",text: "Avant de commencer" },
    { type: "paragraph",html: "Deux éléments doivent être en place :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>La 2FA doit être activée.</strong> Les appareils de confiance reposent sur l'authentification à deux facteurs. Si la 2FA est désactivée, il n'y a encore rien à gérer.",
        "<strong class='text-white'>Vous avez besoin de l'adresse e-mail associée à votre compte.</strong> Les approbations et les codes à usage unique arrivent dans cette boîte de réception ; gardez-la à portée de main.",
      ],
    },
    { type: "paragraph",html: "Une réserve si vous utilisez un compte de prop firm ou d'évaluation : certaines options de sécurité sont contrôlées par la société, pas par vous. Si un interrupteur est grisé, c'est généralement la raison. Les règles varient selon la société et le type de compte ; vérifiez donc la politique actuelle de votre société avant de supposer qu'il y a une panne." },
    { type: "heading",text: "Approuver et gérer les appareils de confiance, étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez Application Settings et allez dans l'onglet Security", html: "Ouvrez la plateforme Tradovate web ou de bureau et accédez à Application Settings. Cherchez l'onglet Security (certaines versions l'intitulent « Security &amp; Privacy »). Cette unique page regroupe tous les contrôles de sécurité du compte dont vous aurez besoin, de l'interrupteur de la 2FA jusqu'à la liste complète des appareils.", image: {"src":`${IMG}/tradovate-trusted-devices-1.png`,"alt":"Menu Application Settings de Tradovate avec l'onglet Security mis en évidence"} },
        { title: "Activez l'authentification à deux facteurs", html: "Si ce n'est pas déjà fait, cliquez sur le contrôle pour activer 2-Factor Authentication. Une fenêtre s'affiche et demande votre mot de passe Tradovate. Saisissez-le pour confirmer la modification. À partir de là, vous recevrez un e-mail chaque fois qu'un nouvel appareil ou navigateur tentera de se connecter à votre compte.", image: {"src":`${IMG}/tradovate-trusted-devices-2.png`,"alt":"Page Security de Tradovate affichant le contrôle 2-Factor Authentication et l'invite de confirmation du mot de passe"} },
        { title: "Activez « Sign In On A Trusted Device »", html: "Faites défiler vers le bas, sous le contrôle de la 2FA, et activez Sign In On A Trusted Device. Connectez-vous ensuite depuis la machine à laquelle vous souhaitez réellement faire confiance. Tradovate vous envoie un code par e-mail ; saisissez-le dans l'invite affichée sur l'appareil et celui-ci est ajouté à votre liste d'appareils de confiance. Faites-le une fois pour chaque appareil que vous utilisez régulièrement.", image: {"src":`${IMG}/tradovate-trusted-devices-3.png`,"alt":"Interrupteur Sign In On A Trusted Device de Tradovate sous le contrôle de la 2FA"} },
        { title: "Approuvez ou refusez un nouvel appareil depuis l'e-mail", html: "Chaque fois qu'une nouvelle machine tente de se connecter, consultez votre boîte de réception. L'e-mail propose deux boutons : Approve ou Deny. Approuvez les appareils que vous reconnaissez. Si une connexion que vous n'avez pas initiée apparaît, cliquez sur Deny et changez immédiatement votre mot de passe. C'est ce moment qui arrête un appareil inconnu avant qu'il n'atteigne vos ordres." },
        { title: "Passez en revue et nettoyez la liste des appareils", html: "De retour sur la page Security, faites défiler jusqu'en bas pour voir chaque appareil lié à votre compte. Un appareil approuvé affiche une option <strong class='text-white'>Remove Access</strong> ; utilisez-la pour révoquer tout ce que vous n'utilisez plus, comme un ancien ordinateur portable ou une machine partagée. Un appareil encore en attente apparaît comme <strong class='text-white'>Pending</strong> avec une option <strong class='text-white'>Forget</strong>, qui l'efface et impose un nouvel e-mail Approve/Deny s'il retente une connexion. Prenez l'habitude d'élaguer cette liste, surtout après vous être connecté depuis l'ordinateur d'un ami ou un ordinateur public." },
      ],
    },
    { type: "heading",text: "Ce que signifie chaque statut d'appareil" },
    { type: "table", headers: ["Statut","Signification","Vos options"], rows: [
      ["Pending","Un appareil a tenté de se connecter mais n'a pas encore été approuvé","Forget : l'efface, et la prochaine tentative de connexion déclenche un nouvel e-mail Approve/Deny"],
      ["Approved","Vous avez confirmé cet appareil via le lien de l'e-mail","Remove Access : révoque l'appareil immédiatement"],
    ] },
    { type: "paragraph",html: "Au-delà des appareils de confiance, la page Security de Tradovate vous permet aussi d'ajouter des méthodes de 2FA plus robustes si vous le souhaitez, notamment une clé de sécurité, une application d'authentification ou des codes par SMS. Elles reposent toutes sur la même idée : vérifier une nouvelle connexion avant de la laisser s'installer." },
    { type: "heading",text: "Si un appareil ne s'approuve pas" },
    { type: "paragraph",html: "Quelques éléments font trébucher les utilisateurs. L'e-mail d'approbation peut mettre une minute à arriver et atterrit parfois dans les courriers indésirables ; vérifiez-y avant de réessayer. Si vous êtes renvoyé à chaque session dans une boucle d'approbation de nouvel appareil, l'identifiant de votre appareil est peut-être réinitialisé en arrière-plan. Et si vous êtes connecté à plusieurs endroits à la fois, web, bureau, mobile et TradingView, la limite de deux sessions peut vous faire passer de l'un à l'autre et brouiller la situation des appareils. En régler la cause dissipe généralement aussi la confusion." },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Vous en avez assez de surveiller les connexions et les approbations manuelles juste pour que votre stratégie tourne ? PickMyTrade automatise votre flux d'ordres Tradovate à partir des alertes TradingView, afin que votre configuration continue de s'exécuter pendant que vous réglez la sécurité une fois pour toutes." },
  ], it: [
    { type: "paragraph",html: "Una volta attivata l'autenticazione a due fattori, Tradovate mantiene un elenco delle macchine che ha approvato per l'accesso. Quell'elenco è costituito dai Suoi dispositivi attendibili. Vale la pena controllarlo ogni tanto, perché un browser che non usa più, o che non riconosce affatto, non ha alcun diritto di detenere una chiave di un conto in grado di inviare ordini reali. Ecco come approvare i dispositivi di cui si fida e rimuovere gli altri." },
    { type: "heading",text: "Che cos'è davvero un dispositivo attendibile" },
    { type: "paragraph",html: "Con la 2FA attiva, ogni nuovo browser o app che tenta di accedere deve essere approvato prima di passare. Se ne approva uno, Tradovate lo ricorda, quindi non deve verificare di nuovo a ogni sessione. Il compromesso è semplice: un dispositivo approvato resta approvato finché non lo rimuove manualmente. È proprio per questo che l'elenco dei dispositivi merita la Sua attenzione." },
    { type: "heading",text: "Prima di iniziare" },
    { type: "paragraph",html: "Due cose devono essere a posto:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>La 2FA deve essere attiva.</strong> I dispositivi attendibili si basano sull'autenticazione a due fattori. Se la 2FA è disattivata, non c'è ancora nulla da gestire.",
        "<strong class='text-white'>Le serve l'e-mail collegata al Suo account.</strong> Le approvazioni e i codici monouso arrivano in quella casella, quindi la tenga a portata di mano.",
      ],
    },
    { type: "paragraph",html: "Un'avvertenza se utilizza un conto di una prop firm o di valutazione: alcune opzioni di sicurezza sono controllate dalla società, non da Lei. Se un interruttore è disattivato, di solito è per questo. Le regole variano in base alla società e al tipo di conto, quindi verifichi la politica attuale della Sua società prima di presumere che qualcosa non funzioni." },
    { type: "heading",text: "Approvare e gestire i dispositivi attendibili, passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Apra Application Settings e vada alla scheda Security", html: "Apra la piattaforma Tradovate web o desktop e acceda ad Application Settings. Cerchi la scheda Security (alcune versioni la chiamano «Security &amp; Privacy»). Questa singola pagina contiene tutti i controlli di sicurezza dell'account che Le serviranno, dall'interruttore della 2FA fino all'elenco completo dei dispositivi.", image: {"src":`${IMG}/tradovate-trusted-devices-1.png`,"alt":"Menu Application Settings di Tradovate con la scheda Security evidenziata"} },
        { title: "Attivi l'autenticazione a due fattori", html: "Se non l'ha ancora fatto, clicchi sul controllo per attivare 2-Factor Authentication. Compare una finestra che richiede la Sua password di Tradovate. La inserisca per confermare la modifica. Da quel momento riceverà un'e-mail ogni volta che un nuovo dispositivo o browser tenterà di accedere al Suo account.", image: {"src":`${IMG}/tradovate-trusted-devices-2.png`,"alt":"Pagina Security di Tradovate con il controllo 2-Factor Authentication e la richiesta di conferma della password"} },
        { title: "Attivi «Sign In On A Trusted Device»", html: "Scorra verso il basso, sotto il controllo della 2FA, e attivi Sign In On A Trusted Device. Ora acceda dalla macchina di cui vuole davvero fidarsi. Tradovate Le invia un codice via e-mail; lo digiti nella richiesta sul dispositivo e questo verrà aggiunto al Suo elenco di dispositivi attendibili. Lo faccia una volta per ogni dispositivo che usa regolarmente.", image: {"src":`${IMG}/tradovate-trusted-devices-3.png`,"alt":"Interruttore Sign In On A Trusted Device di Tradovate sotto il controllo della 2FA"} },
        { title: "Approvi o neghi un nuovo dispositivo dall'e-mail", html: "Ogni volta che una nuova macchina tenta di accedere, controlli la Sua casella di posta. L'e-mail Le offre due pulsanti: Approve o Deny. Approvi i dispositivi che riconosce. Se compare un accesso che non ha avviato Lei, prema Deny e cambi subito la password. È il momento che ferma un dispositivo sconosciuto prima che raggiunga i Suoi ordini." },
        { title: "Riveda e ripulisca l'elenco dei dispositivi", html: "Tornato nella pagina Security, scorra fino in fondo per vedere ogni dispositivo collegato al Suo account. Un dispositivo approvato mostra l'opzione <strong class='text-white'>Remove Access</strong>; la usi per revocare tutto ciò che non utilizza più, come un vecchio portatile o una macchina condivisa. Un dispositivo ancora in attesa compare come <strong class='text-white'>Pending</strong> con l'opzione <strong class='text-white'>Forget</strong>, che lo cancella e impone una nuova e-mail Approve/Deny se tenterà di nuovo l'accesso. Prenda l'abitudine di sfoltire questo elenco, soprattutto dopo aver effettuato l'accesso dal computer di un amico o da uno pubblico." },
      ],
    },
    { type: "heading",text: "Che cosa significa ciascuno stato del dispositivo" },
    { type: "table", headers: ["Stato","Che cosa significa","Le Sue opzioni"], rows: [
      ["Pending","Un dispositivo ha tentato di accedere ma non è ancora stato approvato","Forget: lo cancella, e il successivo tentativo di accesso genera una nuova e-mail Approve/Deny"],
      ["Approved","Ha confermato questo dispositivo tramite il link dell'e-mail","Remove Access: revoca subito il dispositivo"],
    ] },
    { type: "paragraph",html: "Oltre ai dispositivi attendibili, la pagina Security di Tradovate Le consente anche di aggiungere metodi 2FA più forti quando lo desidera, tra cui una chiave di sicurezza, un'app di autenticazione o codici via SMS. Tutti seguono la stessa idea: verificare un nuovo accesso prima di permettergli di restare." },
    { type: "heading",text: "Se un dispositivo non si approva" },
    { type: "paragraph",html: "Alcune cose mettono in difficoltà molti utenti. L'e-mail di approvazione può impiegare un minuto ad arrivare e a volte finisce nello spam, quindi controlli lì prima di riprovare. Se a ogni sessione viene rimandato in un ciclo di approvazione di un nuovo dispositivo, l'ID del Suo dispositivo potrebbe essere reimpostato in background. E se è connesso in più posti contemporaneamente, web, desktop, mobile e TradingView, il limite di due sessioni può spostarLa da una parte all'altra e confondere il quadro dei dispositivi. Risolvere questo aspetto di solito chiarisce anche la confusione." },
    { type: "heading",text: "Automatizzi tutto questo con PickMyTrade" },
    { type: "paragraph",html: "Stanco di sorvegliare accessi e approvazioni manuali solo per far andare la Sua strategia? PickMyTrade automatizza il flusso di ordini di Tradovate dagli alert di TradingView, così la Sua configurazione continua a eseguire mentre Lei sistema la sicurezza una volta sola e va avanti." },
  ] },
  ctaHeading: { en: "Keep Your Strategy Running, Hands-Off", de: "Lassen Sie Ihre Strategie freihändig weiterlaufen", es: "Mantenga su estrategia en marcha, sin intervención", fr: "Gardez votre stratégie en marche, sans y toucher", it: "Mantenga la Sua strategia in funzione, senza interventi" },
