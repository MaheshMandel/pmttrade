---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-vendor-vs-api-fee";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Skip the Tradovate API Fee via a Vendor";
const META_DESCRIPTION =
  "Skip Tradovate's personal API subscription fee when automating futures: route orders through an authorized vendor connection instead. Here's how it works.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Die Tradovate-API-Gebühr über einen Anbieter umgehen", es: "Evite la tarifa de API de Tradovate mediante un proveedor", fr: "Éviter les frais d'API de Tradovate grâce à un fournisseur", it: "Evitare la tariffa API di Tradovate tramite un fornitore" },
  dek: { en: "You don't have to pay Tradovate's personal API subscription just to automate. Route your orders through an authorized vendor and that vendor's authorization covers your connection.", de: "Sie müssen Tradovates persönliches API-Abonnement nicht bezahlen, nur um zu automatisieren. Leiten Sie Ihre Orders über einen autorisierten Anbieter, und dessen Autorisierung deckt Ihre Verbindung ab.", es: "No tiene que pagar la suscripción personal a la API de Tradovate solo para automatizar. Enrute sus órdenes a través de un proveedor autorizado y la autorización de ese proveedor cubre su conexión.", fr: "Vous n'avez pas à payer l'abonnement API personnel de Tradovate uniquement pour automatiser. Faites passer vos ordres par un fournisseur autorisé, et l'autorisation de ce fournisseur couvre votre connexion.", it: "Non deve pagare l'abbonamento API personale di Tradovate solo per automatizzare. Instradi i Suoi ordini tramite un fornitore autorizzato e l'autorizzazione di quel fornitore copre la Sua connessione." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Here's the short version: you don't have to pay Tradovate's personal API subscription just to automate. Route your orders through an authorized vendor, a platform that already holds an integration agreement with Tradovate, and that vendor's authorization covers your connection. The separate API add-on never enters the picture." },
    { type: "heading", text: "What the \"API Fee\" Actually Covers" },
    { type: "paragraph", html: "People lump two very different charges together when they say \"the Tradovate API fee.\" Keep them apart." },
    { type: "paragraph", html: "The <strong class='text-white'>API Access add-on</strong> is what lets <em>you</em> generate your own API key and secret for direct calls. It runs around $25 a month (some listings show closer to $30) and needs a funded live account above Tradovate's minimum before you can generate a key. <strong class='text-white'>CME market-data licensing</strong> is separate: if your automation pulls real-time exchange prices through the API, CME's sub-vendor license stacks on top, roughly $290 a month and up by tier. That's the number most people fear." },
    {
      type: "table",
      headers: ["Charge", "Roughly", "What it's for"],
      rows: [
        ["API Access add-on", "~$25/mo", "Generating your own key and secret for direct API calls"],
        ["CME data license", "~$290/mo and up", "Streaming real-time exchange data through the API"],
      ],
    },
    { type: "paragraph", html: "One nuance worth remembering: sending orders alone doesn't trigger the CME license. That fee is for <em>receiving</em> live prices through the API, not for routing trades, so an order-only path stays clear of the big number. Prices and minimums move, so confirm the current figures with Tradovate first." },
    { type: "heading", text: "Why a Vendor Connection Skips the Add-On" },
    { type: "paragraph", html: "The add-on exists to authorize <em>you</em> to hit Tradovate's API with your own credentials. An authorized vendor already did that. The platform holds its own integration agreement, so when you link your account you lean on that authorization instead of buying your own, no key to generate, no add-on to activate." },
    { type: "paragraph", html: "Webhook and no-code tools run on this model: your alert hits the vendor, the vendor talks to Tradovate under its agreement, and the order lands in your account. Most vendors connect over an authorization handshake and store a refresh token rather than your password; some older setups still ask for your login directly. Either way, the personal subscription stays off your bill." },
    { type: "heading", text: "Skip the Fee via a Vendor: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Create an Account With an Authorized Vendor", html: "Pick an automation platform that's an authorized Tradovate integration, one that connects your account and routes orders for you. Sign up and log in. This account carries the integration agreement, so you're not paying Tradovate for API access on top.", image: { src: `${IMG}/tradovate-vendor-vs-api-fee-1.png`, alt: "Automation vendor dashboard after signing in, ready to add a broker connection" } },
        { title: "Open Broker Connections and Choose Tradovate", html: "In the vendor dashboard, open the brokers or connections section and pick <strong class='text-white'>Tradovate</strong> from the supported list. This tells the platform which broker your automated orders should hit.", image: { src: `${IMG}/tradovate-vendor-vs-api-fee-2.png`, alt: "Broker connection list in the vendor dashboard with Tradovate selected" } },
        { title: "Authorize Your Tradovate Account", html: "Now grant permission to trade on your behalf. Depending on the vendor, you're either redirected to Tradovate's own sign-in and authorization screen or asked for your Tradovate username and password. Approve the connection. With the redirect route, the platform ends up holding a refresh token, not your password.", image: { src: `${IMG}/tradovate-vendor-vs-api-fee-3.png`, alt: "Tradovate authorization prompt granting a third-party vendor access to the account" } },
        { title: "Select the Account to Trade", html: "Choose which Tradovate account the vendor routes to. If you run both a personal live account and a prop or evaluation account, point automation at the right one so trades don't land in the wrong place.", image: { src: `${IMG}/tradovate-vendor-vs-api-fee-4.png`, alt: "Account selection screen showing the linked Tradovate accounts available for routing" } },
        { title: "Send a Test Order", html: "Don't wait for a live signal to test it. Fire a small test alert or webhook and watch for the order in Tradovate's Orders panel. Once it hits, your connection works, and you got there without the add-on.", image: { src: `${IMG}/tradovate-vendor-vs-api-fee-5.png`, alt: "Tradovate Orders panel showing a test order that arrived through the vendor connection" } },
      ],
    },
    { type: "heading", text: "When You Still Need the Add-On or the CME License" },
    { type: "paragraph", html: "A vendor sidesteps the add-on for order routing, but it's not a cure-all. Write your own code against Tradovate's API and you'll still need the add-on and your own key. If your bot pulls real-time exchange data through the API, budget for the CME license too. Match the route to what you actually need." },
    { type: "heading", text: "Automate This With PickMyTrade" },
    { type: "paragraph", html: "PickMyTrade is an authorized Tradovate integration: connect your account, point your TradingView alerts at it, and let orders route, no API key, no add-on, no CME data license just to place trades. Your signals become live orders automatically." },
  ], de: [
    { type: "paragraph",html: "Die Kurzfassung: Sie müssen Tradovates persönliches API-Abonnement nicht bezahlen, nur um zu automatisieren. Leiten Sie Ihre Orders über einen autorisierten Anbieter, also eine Plattform, die bereits eine Integrationsvereinbarung mit Tradovate besitzt, und dessen Autorisierung deckt Ihre Verbindung ab. Die separate API-Zusatzoption kommt gar nicht ins Spiel." },
    { type: "heading",text: "Was die „API-Gebühr“ tatsächlich abdeckt" },
    { type: "paragraph",html: "Viele werfen zwei sehr unterschiedliche Kosten zusammen, wenn sie von „der Tradovate-API-Gebühr“ sprechen. Halten Sie sie auseinander." },
    { type: "paragraph",html: "Die <strong class='text-white'>API-Access-Zusatzoption</strong> ermöglicht es <em>Ihnen</em>, Ihren eigenen API-Schlüssel und Ihr Secret für direkte Aufrufe zu erzeugen. Sie kostet rund $25 im Monat (manche Angebote nennen eher $30) und setzt ein finanziertes Live-Konto oberhalb des Tradovate-Minimums voraus, bevor Sie einen Schlüssel erzeugen können. Die <strong class='text-white'>CME-Marktdatenlizenz</strong> ist davon getrennt: Wenn Ihre Automatisierung Echtzeit-Börsenkurse über die API abruft, kommt die Sub-Vendor-Lizenz der CME obendrauf, etwa $290 im Monat und aufwärts je nach Stufe. Das ist die Zahl, vor der sich die meisten fürchten." },
    { type: "table", headers: ["Kostenpunkt","Ungefähr","Wofür"], rows: [
      ["API-Access-Zusatzoption","~$25/Monat","Erzeugen Ihres eigenen Schlüssels und Secrets für direkte API-Aufrufe"],
      ["CME-Datenlizenz","~$290/Monat und mehr","Streaming von Echtzeit-Börsendaten über die API"],
    ] },
    { type: "paragraph",html: "Eine Nuance, die man sich merken sollte: Das bloße Senden von Orders löst die CME-Lizenz nicht aus. Diese Gebühr gilt für das <em>Empfangen</em> von Live-Kursen über die API, nicht für das Weiterleiten von Trades, sodass ein reiner Order-Weg der großen Zahl aus dem Weg geht. Preise und Mindestbeträge ändern sich, bestätigen Sie die aktuellen Werte daher zuerst bei Tradovate." },
    { type: "heading",text: "Warum eine Anbieterverbindung die Zusatzoption umgeht" },
    { type: "paragraph",html: "Die Zusatzoption existiert, um <em>Sie</em> dazu zu autorisieren, die API von Tradovate mit Ihren eigenen Zugangsdaten anzusprechen. Ein autorisierter Anbieter hat das bereits erledigt. Die Plattform besitzt ihre eigene Integrationsvereinbarung. Wenn Sie Ihr Konto verknüpfen, stützen Sie sich also auf diese Autorisierung, statt eine eigene zu kaufen: kein Schlüssel zu erzeugen, keine Zusatzoption zu aktivieren." },
    { type: "paragraph",html: "Webhook- und No-Code-Tools funktionieren nach diesem Modell: Ihr Alert erreicht den Anbieter, der Anbieter spricht im Rahmen seiner Vereinbarung mit Tradovate, und die Order landet in Ihrem Konto. Die meisten Anbieter verbinden sich über einen Autorisierungs-Handshake und speichern ein Refresh-Token statt Ihres Passworts; manche älteren Setups verlangen Ihre Zugangsdaten weiterhin direkt. In beiden Fällen bleibt das persönliche Abonnement von Ihrer Rechnung fern." },
    { type: "heading",text: "Die Gebühr über einen Anbieter umgehen: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Ein Konto bei einem autorisierten Anbieter erstellen", html: "Wählen Sie eine Automatisierungsplattform, die eine autorisierte Tradovate-Integration ist, also eine, die Ihr Konto verbindet und Orders für Sie weiterleitet. Registrieren Sie sich und melden Sie sich an. Dieses Konto trägt die Integrationsvereinbarung, sodass Sie Tradovate nicht zusätzlich für den API-Zugang bezahlen.", image: {"src":`${IMG}/tradovate-vendor-vs-api-fee-1.png`,"alt":"Dashboard des Automatisierungsanbieters nach der Anmeldung, bereit zum Hinzufügen einer Broker-Verbindung"} },
        { title: "Broker-Verbindungen öffnen und Tradovate auswählen", html: "Öffnen Sie im Dashboard des Anbieters den Bereich Broker bzw. Verbindungen und wählen Sie <strong class='text-white'>Tradovate</strong> aus der Liste der unterstützten Broker. So weiß die Plattform, an welchen Broker Ihre automatisierten Orders gehen sollen.", image: {"src":`${IMG}/tradovate-vendor-vs-api-fee-2.png`,"alt":"Broker-Verbindungsliste im Anbieter-Dashboard mit ausgewähltem Tradovate"} },
        { title: "Ihr Tradovate-Konto autorisieren", html: "Erteilen Sie nun die Erlaubnis, in Ihrem Namen zu handeln. Je nach Anbieter werden Sie entweder auf den Tradovate-eigenen Anmelde- und Autorisierungsbildschirm weitergeleitet oder nach Ihrem Tradovate-Benutzernamen und Passwort gefragt. Genehmigen Sie die Verbindung. Bei der Weiterleitungsvariante hält die Plattform am Ende ein Refresh-Token, nicht Ihr Passwort.", image: {"src":`${IMG}/tradovate-vendor-vs-api-fee-3.png`,"alt":"Tradovate-Autorisierungsabfrage, die einem Drittanbieter Zugriff auf das Konto gewährt"} },
        { title: "Das Konto zum Handeln auswählen", html: "Wählen Sie, an welches Tradovate-Konto der Anbieter Orders weiterleitet. Wenn Sie sowohl ein persönliches Live-Konto als auch ein Prop- oder Evaluierungskonto führen, richten Sie die Automatisierung auf das richtige, damit Trades nicht am falschen Ort landen.", image: {"src":`${IMG}/tradovate-vendor-vs-api-fee-4.png`,"alt":"Kontoauswahlbildschirm mit den verknüpften Tradovate-Konten, die für die Weiterleitung zur Verfügung stehen"} },
        { title: "Eine Testorder senden", html: "Warten Sie nicht auf ein Live-Signal, um es zu testen. Lösen Sie einen kleinen Test-Alert oder Webhook aus und beobachten Sie, ob die Order im Orders-Bereich von Tradovate erscheint. Sobald sie ankommt, funktioniert Ihre Verbindung, und Sie sind ohne die Zusatzoption dorthin gekommen.", image: {"src":`${IMG}/tradovate-vendor-vs-api-fee-5.png`,"alt":"Tradovate-Orders-Bereich mit einer Testorder, die über die Anbieterverbindung eingegangen ist"} },
      ],
    },
    { type: "heading",text: "Wann Sie die Zusatzoption oder die CME-Lizenz trotzdem brauchen" },
    { type: "paragraph",html: "Ein Anbieter umgeht die Zusatzoption für die Order-Weiterleitung, ist aber kein Allheilmittel. Wenn Sie eigenen Code gegen die API von Tradovate schreiben, benötigen Sie weiterhin die Zusatzoption und Ihren eigenen Schlüssel. Wenn Ihr Bot Echtzeit-Börsendaten über die API abruft, müssen Sie auch die CME-Lizenz einplanen. Wählen Sie den Weg, der zu dem passt, was Sie tatsächlich brauchen." },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "PickMyTrade ist eine autorisierte Tradovate-Integration: Verbinden Sie Ihr Konto, richten Sie Ihre TradingView-Alerts darauf aus, und lassen Sie Orders weiterleiten, ohne API-Schlüssel, ohne Zusatzoption, ohne CME-Datenlizenz, nur um Trades zu platzieren. Ihre Signale werden automatisch zu Live-Orders." },
  ], es: [
    { type: "paragraph",html: "La versión corta: no tiene que pagar la suscripción personal a la API de Tradovate solo para automatizar. Enrute sus órdenes a través de un proveedor autorizado, una plataforma que ya tiene un acuerdo de integración con Tradovate, y la autorización de ese proveedor cubre su conexión. El complemento de API independiente nunca entra en escena." },
    { type: "heading",text: "Qué cubre realmente la «tarifa de API»" },
    { type: "paragraph",html: "Muchas personas mezclan dos cargos muy distintos cuando hablan de «la tarifa de API de Tradovate». Manténgalos separados." },
    { type: "paragraph",html: "El <strong class='text-white'>complemento API Access</strong> es lo que <em>le</em> permite generar su propia clave y secreto de API para llamadas directas. Cuesta alrededor de $25 al mes (algunos listados muestran más cerca de $30) y requiere una cuenta real financiada por encima del mínimo de Tradovate antes de poder generar una clave. La <strong class='text-white'>licencia de datos de mercado de CME</strong> es aparte: si su automatización obtiene precios de bolsa en tiempo real a través de la API, la licencia de subproveedor de CME se suma, aproximadamente $290 al mes en adelante según el nivel. Esa es la cifra que la mayoría teme." },
    { type: "table", headers: ["Cargo","Aproximadamente","Para qué sirve"], rows: [
      ["Complemento API Access","~$25/mes","Generar su propia clave y secreto para llamadas directas a la API"],
      ["Licencia de datos de CME","~$290/mes y más","Recibir datos de bolsa en tiempo real a través de la API"],
    ] },
    { type: "paragraph",html: "Un matiz que conviene recordar: enviar órdenes por sí solo no activa la licencia de CME. Esa tarifa es por <em>recibir</em> precios en vivo a través de la API, no por enrutar operaciones, de modo que una vía solo de órdenes queda fuera de la cifra grande. Los precios y los mínimos cambian, así que confirme primero las cifras actuales con Tradovate." },
    { type: "heading",text: "Por qué una conexión con un proveedor evita el complemento" },
    { type: "paragraph",html: "El complemento existe para autorizar a <em>usted</em> a acceder a la API de Tradovate con sus propias credenciales. Un proveedor autorizado ya lo hizo. La plataforma tiene su propio acuerdo de integración, así que al vincular su cuenta usted se apoya en esa autorización en lugar de comprar la suya: ninguna clave que generar, ningún complemento que activar." },
    { type: "paragraph",html: "Las herramientas de webhook y sin código funcionan con este modelo: su alerta llega al proveedor, el proveedor habla con Tradovate bajo su acuerdo y la orden aterriza en su cuenta. La mayoría de los proveedores se conectan mediante un protocolo de autorización y almacenan un token de actualización en lugar de su contraseña; algunas configuraciones más antiguas aún piden directamente sus datos de acceso. En cualquier caso, la suscripción personal queda fuera de su factura." },
    { type: "heading",text: "Evite la tarifa mediante un proveedor: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Cree una cuenta con un proveedor autorizado", html: "Elija una plataforma de automatización que sea una integración autorizada de Tradovate, una que conecte su cuenta y enrute las órdenes por usted. Regístrese e inicie sesión. Esta cuenta lleva el acuerdo de integración, por lo que no paga además a Tradovate por el acceso a la API.", image: {"src":`${IMG}/tradovate-vendor-vs-api-fee-1.png`,"alt":"Panel del proveedor de automatización tras iniciar sesión, listo para añadir una conexión con un bróker"} },
        { title: "Abra las conexiones de brókeres y elija Tradovate", html: "En el panel del proveedor, abra la sección de brókeres o conexiones y elija <strong class='text-white'>Tradovate</strong> de la lista de compatibles. Esto indica a la plataforma a qué bróker deben dirigirse sus órdenes automatizadas.", image: {"src":`${IMG}/tradovate-vendor-vs-api-fee-2.png`,"alt":"Lista de conexiones de brókeres en el panel del proveedor con Tradovate seleccionado"} },
        { title: "Autorice su cuenta de Tradovate", html: "Ahora conceda permiso para operar en su nombre. Según el proveedor, o bien se le redirige a la pantalla de inicio de sesión y autorización del propio Tradovate, o bien se le pide su nombre de usuario y contraseña de Tradovate. Apruebe la conexión. Con la vía de redirección, la plataforma acaba conservando un token de actualización, no su contraseña.", image: {"src":`${IMG}/tradovate-vendor-vs-api-fee-3.png`,"alt":"Aviso de autorización de Tradovate que concede a un proveedor externo acceso a la cuenta"} },
        { title: "Seleccione la cuenta con la que operar", html: "Elija a qué cuenta de Tradovate enruta el proveedor. Si tiene tanto una cuenta real personal como una cuenta de prop firm o de evaluación, dirija la automatización a la correcta para que las operaciones no aterricen en el lugar equivocado.", image: {"src":`${IMG}/tradovate-vendor-vs-api-fee-4.png`,"alt":"Pantalla de selección de cuenta con las cuentas de Tradovate vinculadas disponibles para el enrutamiento"} },
        { title: "Envíe una orden de prueba", html: "No espere a una señal real para probarlo. Lance una pequeña alerta o webhook de prueba y observe la orden en el panel Orders de Tradovate. En cuanto llegue, su conexión funciona, y lo logró sin el complemento.", image: {"src":`${IMG}/tradovate-vendor-vs-api-fee-5.png`,"alt":"Panel Orders de Tradovate mostrando una orden de prueba que llegó a través de la conexión con el proveedor"} },
      ],
    },
    { type: "heading",text: "Cuándo sigue necesitando el complemento o la licencia de CME" },
    { type: "paragraph",html: "Un proveedor evita el complemento para el enrutamiento de órdenes, pero no es una solución universal. Si escribe su propio código contra la API de Tradovate, seguirá necesitando el complemento y su propia clave. Si su bot obtiene datos de bolsa en tiempo real a través de la API, también deberá presupuestar la licencia de CME. Elija la vía que se ajuste a lo que realmente necesita." },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "PickMyTrade es una integración autorizada de Tradovate: conecte su cuenta, dirija sus alertas de TradingView hacia ella y deje que las órdenes se enruten, sin clave de API, sin complemento, sin licencia de datos de CME solo para ejecutar operaciones. Sus señales se convierten en órdenes reales de forma automática." },
  ], fr: [
    { type: "paragraph",html: "La version courte : vous n'avez pas à payer l'abonnement API personnel de Tradovate uniquement pour automatiser. Faites passer vos ordres par un fournisseur autorisé, une plateforme qui détient déjà un accord d'intégration avec Tradovate, et l'autorisation de ce fournisseur couvre votre connexion. L'option API distincte n'entre jamais en jeu." },
    { type: "heading",text: "Ce que couvrent réellement les « frais d'API »" },
    { type: "paragraph",html: "Beaucoup de gens confondent deux frais très différents lorsqu'ils parlent des « frais d'API de Tradovate ». Gardez-les distincts." },
    { type: "paragraph",html: "L'<strong class='text-white'>option API Access</strong> est ce qui <em>vous</em> permet de générer votre propre clé et votre secret d'API pour des appels directs. Elle coûte environ $25 par mois (certaines offres affichent plutôt $30) et nécessite un compte réel approvisionné au-dessus du minimum de Tradovate avant de pouvoir générer une clé. La <strong class='text-white'>licence de données de marché CME</strong> est distincte : si votre automatisation récupère des cours boursiers en temps réel via l'API, la licence de sous-fournisseur de CME s'ajoute, environ $290 par mois et plus selon le palier. C'est le chiffre que la plupart redoutent." },
    { type: "table", headers: ["Frais","Environ","À quoi cela sert"], rows: [
      ["Option API Access","~$25/mois","Générer votre propre clé et votre secret pour des appels directs à l'API"],
      ["Licence de données CME","~$290/mois et plus","Recevoir des données boursières en temps réel via l'API"],
    ] },
    { type: "paragraph",html: "Une nuance à retenir : l'envoi d'ordres seul ne déclenche pas la licence CME. Ces frais concernent la <em>réception</em> de cours en direct via l'API, pas l'acheminement d'ordres ; un parcours limité aux ordres reste donc à l'écart du gros chiffre. Les prix et les minimums évoluent, confirmez donc d'abord les montants actuels auprès de Tradovate." },
    { type: "heading",text: "Pourquoi une connexion via un fournisseur évite l'option" },
    { type: "paragraph",html: "L'option existe pour <em>vous</em> autoriser à solliciter l'API de Tradovate avec vos propres identifiants. Un fournisseur autorisé l'a déjà fait. La plateforme détient son propre accord d'intégration ; lorsque vous liez votre compte, vous vous appuyez donc sur cette autorisation au lieu d'acheter la vôtre : aucune clé à générer, aucune option à activer." },
    { type: "paragraph",html: "Les outils de webhook et sans code fonctionnent selon ce modèle : votre alerte atteint le fournisseur, le fournisseur dialogue avec Tradovate dans le cadre de son accord, et l'ordre arrive dans votre compte. La plupart des fournisseurs se connectent via un protocole d'autorisation et stockent un jeton d'actualisation plutôt que votre mot de passe ; certaines configurations plus anciennes demandent encore directement vos identifiants. Dans les deux cas, l'abonnement personnel reste hors de votre facture." },
    { type: "heading",text: "Éviter les frais via un fournisseur : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Créez un compte chez un fournisseur autorisé", html: "Choisissez une plateforme d'automatisation qui est une intégration Tradovate autorisée, c'est-à-dire qui connecte votre compte et achemine les ordres pour vous. Inscrivez-vous et connectez-vous. Ce compte porte l'accord d'intégration ; vous ne payez donc pas Tradovate en plus pour l'accès à l'API.", image: {"src":`${IMG}/tradovate-vendor-vs-api-fee-1.png`,"alt":"Tableau de bord du fournisseur d'automatisation après connexion, prêt à ajouter une connexion de courtier"} },
        { title: "Ouvrez les connexions de courtiers et choisissez Tradovate", html: "Dans le tableau de bord du fournisseur, ouvrez la section des courtiers ou des connexions et sélectionnez <strong class='text-white'>Tradovate</strong> dans la liste des courtiers pris en charge. Cela indique à la plateforme vers quel courtier vos ordres automatisés doivent être envoyés.", image: {"src":`${IMG}/tradovate-vendor-vs-api-fee-2.png`,"alt":"Liste des connexions de courtiers dans le tableau de bord du fournisseur avec Tradovate sélectionné"} },
        { title: "Autorisez votre compte Tradovate", html: "Accordez maintenant l'autorisation de trader en votre nom. Selon le fournisseur, vous êtes soit redirigé vers l'écran de connexion et d'autorisation de Tradovate, soit invité à saisir votre nom d'utilisateur et votre mot de passe Tradovate. Approuvez la connexion. Avec la redirection, la plateforme finit par détenir un jeton d'actualisation, pas votre mot de passe.", image: {"src":`${IMG}/tradovate-vendor-vs-api-fee-3.png`,"alt":"Invite d'autorisation Tradovate accordant à un fournisseur tiers l'accès au compte"} },
        { title: "Sélectionnez le compte à trader", html: "Choisissez vers quel compte Tradovate le fournisseur achemine les ordres. Si vous disposez à la fois d'un compte réel personnel et d'un compte de prop firm ou d'évaluation, orientez l'automatisation vers le bon afin que les trades n'atterrissent pas au mauvais endroit.", image: {"src":`${IMG}/tradovate-vendor-vs-api-fee-4.png`,"alt":"Écran de sélection du compte affichant les comptes Tradovate liés disponibles pour l'acheminement"} },
        { title: "Envoyez un ordre de test", html: "N'attendez pas un signal réel pour tester. Déclenchez une petite alerte ou un webhook de test et guettez l'ordre dans le panneau Orders de Tradovate. Dès qu'il arrive, votre connexion fonctionne, et vous y êtes parvenu sans l'option.", image: {"src":`${IMG}/tradovate-vendor-vs-api-fee-5.png`,"alt":"Panneau Orders de Tradovate affichant un ordre de test arrivé via la connexion du fournisseur"} },
      ],
    },
    { type: "heading",text: "Quand vous avez encore besoin de l'option ou de la licence CME" },
    { type: "paragraph",html: "Un fournisseur contourne l'option pour l'acheminement d'ordres, mais ce n'est pas une panacée. Si vous écrivez votre propre code contre l'API de Tradovate, vous aurez toujours besoin de l'option et de votre propre clé. Si votre bot récupère des données boursières en temps réel via l'API, prévoyez aussi la licence CME. Choisissez la voie qui correspond à ce dont vous avez réellement besoin." },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "PickMyTrade est une intégration Tradovate autorisée : connectez votre compte, dirigez vos alertes TradingView vers elle et laissez les ordres être acheminés, sans clé d'API, sans option, sans licence de données CME juste pour passer des ordres. Vos signaux deviennent automatiquement des ordres réels." },
  ], it: [
    { type: "paragraph",html: "La versione breve: non deve pagare l'abbonamento API personale di Tradovate solo per automatizzare. Instradi i Suoi ordini tramite un fornitore autorizzato, una piattaforma che ha già un accordo di integrazione con Tradovate, e l'autorizzazione di quel fornitore copre la Sua connessione. Il componente aggiuntivo API separato non entra mai in gioco." },
    { type: "heading",text: "Che cosa copre davvero la «tariffa API»" },
    { type: "paragraph",html: "Molte persone mettono insieme due costi molto diversi quando parlano della «tariffa API di Tradovate». Li tenga distinti." },
    { type: "paragraph",html: "Il <strong class='text-white'>componente aggiuntivo API Access</strong> è ciò che consente a <em>Lei</em> di generare la propria chiave e il proprio secret API per chiamate dirette. Costa circa $25 al mese (alcuni elenchi mostrano più vicino a $30) e richiede un conto live finanziato al di sopra del minimo di Tradovate prima di poter generare una chiave. La <strong class='text-white'>licenza dati di mercato CME</strong> è separata: se la Sua automazione riceve prezzi di borsa in tempo reale tramite l'API, la licenza sub-vendor di CME si aggiunge, circa $290 al mese e oltre a seconda del livello. È la cifra che la maggior parte teme." },
    { type: "table", headers: ["Costo","Circa","A che cosa serve"], rows: [
      ["Componente aggiuntivo API Access","~$25/mese","Generare la propria chiave e il proprio secret per chiamate API dirette"],
      ["Licenza dati CME","~$290/mese e oltre","Ricevere dati di borsa in tempo reale tramite l'API"],
    ] },
    { type: "paragraph",html: "Una sfumatura da ricordare: l'invio dei soli ordini non attiva la licenza CME. Quella tariffa riguarda la <em>ricezione</em> di prezzi in tempo reale tramite l'API, non l'instradamento delle operazioni, quindi un percorso solo ordini resta lontano dalla cifra più alta. Prezzi e minimi cambiano, perciò confermi prima le cifre attuali con Tradovate." },
    { type: "heading",text: "Perché una connessione tramite fornitore evita il componente aggiuntivo" },
    { type: "paragraph",html: "Il componente aggiuntivo esiste per autorizzare <em>Lei</em> a interrogare l'API di Tradovate con le Sue credenziali. Un fornitore autorizzato l'ha già fatto. La piattaforma ha un proprio accordo di integrazione, quindi quando collega il Suo conto si appoggia a quell'autorizzazione invece di acquistarne una propria: nessuna chiave da generare, nessun componente aggiuntivo da attivare." },
    { type: "paragraph",html: "Gli strumenti webhook e no-code funzionano con questo modello: il Suo alert raggiunge il fornitore, il fornitore dialoga con Tradovate nell'ambito del proprio accordo e l'ordine arriva nel Suo conto. La maggior parte dei fornitori si connette tramite un handshake di autorizzazione e memorizza un refresh token anziché la Sua password; alcune configurazioni più datate chiedono ancora direttamente le Sue credenziali. In entrambi i casi, l'abbonamento personale resta fuori dalla Sua fattura." },
    { type: "heading",text: "Evitare la tariffa tramite un fornitore: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Crei un account presso un fornitore autorizzato", html: "Scelga una piattaforma di automazione che sia un'integrazione Tradovate autorizzata, ovvero una che colleghi il Suo conto e instradi gli ordini per Lei. Si registri e acceda. Questo account porta con sé l'accordo di integrazione, quindi non paga Tradovate in aggiunta per l'accesso all'API.", image: {"src":`${IMG}/tradovate-vendor-vs-api-fee-1.png`,"alt":"Dashboard del fornitore di automazione dopo l'accesso, pronta per aggiungere una connessione al broker"} },
        { title: "Apra le connessioni ai broker e scelga Tradovate", html: "Nella dashboard del fornitore, apra la sezione dei broker o delle connessioni e scelga <strong class='text-white'>Tradovate</strong> dall'elenco dei broker supportati. Questo indica alla piattaforma a quale broker devono essere inviati i Suoi ordini automatizzati.", image: {"src":`${IMG}/tradovate-vendor-vs-api-fee-2.png`,"alt":"Elenco delle connessioni ai broker nella dashboard del fornitore con Tradovate selezionato"} },
        { title: "Autorizzi il Suo conto Tradovate", html: "Ora conceda il permesso di operare per Suo conto. A seconda del fornitore, viene reindirizzato alla schermata di accesso e autorizzazione di Tradovate oppure Le vengono chiesti nome utente e password di Tradovate. Approvi la connessione. Con il percorso di reindirizzamento, la piattaforma finisce per conservare un refresh token, non la Sua password.", image: {"src":`${IMG}/tradovate-vendor-vs-api-fee-3.png`,"alt":"Richiesta di autorizzazione di Tradovate che concede a un fornitore terzo l'accesso al conto"} },
        { title: "Selezioni il conto su cui operare", html: "Scelga verso quale conto Tradovate il fornitore instrada gli ordini. Se gestisce sia un conto live personale sia un conto prop o di valutazione, indirizzi l'automazione su quello giusto in modo che le operazioni non finiscano nel posto sbagliato.", image: {"src":`${IMG}/tradovate-vendor-vs-api-fee-4.png`,"alt":"Schermata di selezione del conto con i conti Tradovate collegati disponibili per l'instradamento"} },
        { title: "Invii un ordine di prova", html: "Non aspetti un segnale reale per provare. Faccia partire un piccolo alert o webhook di prova e controlli l'ordine nel pannello Orders di Tradovate. Non appena arriva, la Sua connessione funziona, e ci è arrivato senza il componente aggiuntivo.", image: {"src":`${IMG}/tradovate-vendor-vs-api-fee-5.png`,"alt":"Pannello Orders di Tradovate che mostra un ordine di prova arrivato tramite la connessione del fornitore"} },
      ],
    },
    { type: "heading",text: "Quando Le servono ancora il componente aggiuntivo o la licenza CME" },
    { type: "paragraph",html: "Un fornitore evita il componente aggiuntivo per l'instradamento degli ordini, ma non è una soluzione per tutto. Se scrive codice proprio contro l'API di Tradovate, Le serviranno comunque il componente aggiuntivo e una chiave personale. Se il Suo bot riceve dati di borsa in tempo reale tramite l'API, preveda anche la licenza CME. Scelga il percorso che corrisponde a ciò di cui ha davvero bisogno." },
    { type: "heading",text: "Automatizzi tutto questo con PickMyTrade" },
    { type: "paragraph",html: "PickMyTrade è un'integrazione Tradovate autorizzata: colleghi il Suo conto, indirizzi i Suoi alert di TradingView verso di essa e lasci che gli ordini vengano instradati, senza chiave API, senza componente aggiuntivo, senza licenza dati CME solo per eseguire operazioni. I Suoi segnali diventano ordini reali in automatico." },
  ] },
  ctaHeading: { en: "Automate Without the API Add-On", de: "Automatisieren ohne API-Zusatzoption", es: "Automatice sin el complemento de API", fr: "Automatisez sans l'option API", it: "Automatizzi senza il componente aggiuntivo API" },
  ctaText: { en: "PickMyTrade is an authorized Tradovate integration: connect your account, point your TradingView alerts at it, and let orders route automatically.", de: "PickMyTrade ist eine autorisierte Tradovate-Integration: Verbinden Sie Ihr Konto, richten Sie Ihre TradingView-Alerts darauf aus, und lassen Sie Orders automatisch weiterleiten.", es: "PickMyTrade es una integración autorizada de Tradovate: conecte su cuenta, dirija sus alertas de TradingView hacia ella y deje que las órdenes se enruten automáticamente.", fr: "PickMyTrade est une intégration Tradovate autorisée : connectez votre compte, dirigez vos alertes TradingView vers elle et laissez les ordres être acheminés automatiquement.", it: "PickMyTrade è un'integrazione Tradovate autorizzata: colleghi il Suo conto, indirizzi i Suoi alert di TradingView verso di essa e lasci che gli ordini vengano instradati automaticamente." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Do I have to pay Tradovate's API fee to automate my trading?", a: "Not if you connect through an authorized vendor. The add-on only applies to direct API calls with your own credentials. Route orders through a platform that already holds a Tradovate integration agreement and its authorization covers you, so you skip the personal subscription." },
    { q: "Does routing orders through a vendor require the CME data license?", a: "No. The CME license is for streaming real-time exchange data through the API, not for sending trades. An order-only path doesn't trigger it, you'd only need it if your setup pulls live prices through the API itself." },
    { q: "Is a vendor connection safe compared with sharing my API key?", a: "Most vendors use an authorization handshake and store a refresh token rather than your password, and you can revoke access anytime. Confirm how a platform stores your connection before you link it, and use only genuinely authorized integrations." },
  ], de: [
    { q: "Muss ich die API-Gebühr von Tradovate bezahlen, um meinen Handel zu automatisieren?", a: "Nicht, wenn Sie sich über einen autorisierten Anbieter verbinden. Die Zusatzoption gilt nur für direkte API-Aufrufe mit Ihren eigenen Zugangsdaten. Leiten Sie Orders über eine Plattform, die bereits eine Integrationsvereinbarung mit Tradovate besitzt, deckt deren Autorisierung Sie ab, und Sie sparen sich das persönliche Abonnement." },
    { q: "Erfordert das Weiterleiten von Orders über einen Anbieter die CME-Datenlizenz?", a: "Nein. Die CME-Lizenz gilt für das Streaming von Echtzeit-Börsendaten über die API, nicht für das Senden von Trades. Ein reiner Order-Weg löst sie nicht aus. Sie benötigen sie nur, wenn Ihr Setup Live-Kurse über die API selbst abruft." },
    { q: "Ist eine Anbieterverbindung sicher im Vergleich dazu, meinen API-Schlüssel weiterzugeben?", a: "Die meisten Anbieter nutzen einen Autorisierungs-Handshake und speichern ein Refresh-Token statt Ihres Passworts, und Sie können den Zugriff jederzeit widerrufen. Prüfen Sie, wie eine Plattform Ihre Verbindung speichert, bevor Sie sie verknüpfen, und nutzen Sie ausschließlich tatsächlich autorisierte Integrationen." },
  ], es: [
    { q: "¿Tengo que pagar la tarifa de API de Tradovate para automatizar mi trading?", a: "No, si se conecta a través de un proveedor autorizado. El complemento solo se aplica a las llamadas directas a la API con sus propias credenciales. Si enruta las órdenes a través de una plataforma que ya tiene un acuerdo de integración con Tradovate, su autorización le cubre y usted se ahorra la suscripción personal." },
    { q: "¿Enrutar órdenes a través de un proveedor requiere la licencia de datos de CME?", a: "No. La licencia de CME es para recibir datos de mercado en tiempo real a través de la API, no para enviar operaciones. Una vía solo de órdenes no la activa; únicamente la necesitaría si su configuración obtiene precios en vivo mediante la propia API." },
    { q: "¿Es segura una conexión con un proveedor en comparación con compartir mi clave de API?", a: "La mayoría de los proveedores usan un protocolo de autorización y almacenan un token de actualización en lugar de su contraseña, y usted puede revocar el acceso en cualquier momento. Confirme cómo almacena una plataforma su conexión antes de vincularla y use únicamente integraciones realmente autorizadas." },
  ], fr: [
    { q: "Dois-je payer les frais d'API de Tradovate pour automatiser mon trading ?", a: "Pas si vous vous connectez via un fournisseur autorisé. L'option ne s'applique qu'aux appels directs à l'API avec vos propres identifiants. Si vous acheminez vos ordres via une plateforme qui détient déjà un accord d'intégration avec Tradovate, son autorisation vous couvre et vous évitez l'abonnement personnel." },
    { q: "Acheminer des ordres via un fournisseur nécessite-t-il la licence de données CME ?", a: "Non. La licence CME concerne la réception de données boursières en temps réel via l'API, pas l'envoi d'ordres. Un parcours limité aux ordres ne la déclenche pas ; vous n'en auriez besoin que si votre configuration récupère des cours en direct via l'API elle-même." },
    { q: "Une connexion via un fournisseur est-elle sûre par rapport au partage de ma clé d'API ?", a: "La plupart des fournisseurs utilisent un protocole d'autorisation et stockent un jeton d'actualisation plutôt que votre mot de passe, et vous pouvez révoquer l'accès à tout moment. Vérifiez comment une plateforme stocke votre connexion avant de la lier, et n'utilisez que des intégrations réellement autorisées." },
  ], it: [
    { q: "Devo pagare la tariffa API di Tradovate per automatizzare il mio trading?", a: "No, se si collega tramite un fornitore autorizzato. Il componente aggiuntivo si applica solo alle chiamate API dirette con le Sue credenziali. Se instrada gli ordini tramite una piattaforma che ha già un accordo di integrazione con Tradovate, la sua autorizzazione La copre e Lei evita l'abbonamento personale." },
    { q: "Instradare gli ordini tramite un fornitore richiede la licenza dati CME?", a: "No. La licenza CME serve per ricevere dati di borsa in tempo reale tramite l'API, non per inviare operazioni. Un percorso solo ordini non la attiva; Le servirebbe soltanto se la Sua configurazione ricevesse prezzi in tempo reale tramite l'API stessa." },
    { q: "Una connessione tramite fornitore è sicura rispetto alla condivisione della mia chiave API?", a: "La maggior parte dei fornitori utilizza un handshake di autorizzazione e memorizza un refresh token anziché la Sua password, e Lei può revocare l'accesso in qualsiasi momento. Verifichi come una piattaforma memorizza la Sua connessione prima di collegarla e utilizzi solo integrazioni realmente autorizzate." },
  ] },
  relatedHeading: { en: "Related Guides", de: "Weiterführende Leitfäden", es: "Guías relacionadas", fr: "Guides associés", it: "Guide correlate" },
  disclosureText: { en: `This guide is for educational and informational purposes only and is not financial, investment, or trading advice. Trading futures and other leveraged products carries a substantial risk of loss and is not suitable for every investor. PickMyTrade is an independent third-party automation platform and is not affiliated with, endorsed by, or sponsored by Tradovate, Inc. "Tradovate" and all related names, logos, and trademarks are the property of their respective owners. Platform features and steps change over time, so always confirm the current process in the official Tradovate platform and documentation before acting.`, de: "Dieser Leitfaden dient ausschließlich Bildungs- und Informationszwecken und stellt keine Finanz-, Anlage- oder Handelsberatung dar. Der Handel mit Futures und anderen gehebelten Produkten birgt ein erhebliches Verlustrisiko und ist nicht für jeden Anleger geeignet. PickMyTrade ist eine unabhängige Automatisierungsplattform eines Drittanbieters und steht in keiner Verbindung zu Tradovate, Inc., wird von dieser weder unterstützt noch gesponsert. „Tradovate“ sowie alle zugehörigen Namen, Logos und Marken sind Eigentum ihrer jeweiligen Inhaber. Funktionen und Schritte der Plattform ändern sich im Laufe der Zeit. Bestätigen Sie daher stets den aktuellen Ablauf in der offiziellen Tradovate-Plattform und -Dokumentation, bevor Sie handeln.", es: "Esta guía tiene fines exclusivamente educativos e informativos y no constituye asesoramiento financiero, de inversión ni de trading. Operar con futuros y otros productos apalancados conlleva un riesgo sustancial de pérdida y no es adecuado para todos los inversores. PickMyTrade es una plataforma de automatización independiente de terceros y no está afiliada, respaldada ni patrocinada por Tradovate, Inc. «Tradovate» y todos los nombres, logotipos y marcas relacionados son propiedad de sus respectivos titulares. Las funciones y los pasos de la plataforma cambian con el tiempo, por lo que debe confirmar siempre el proceso vigente en la plataforma y la documentación oficiales de Tradovate antes de actuar.", fr: "Ce guide est fourni à des fins strictement éducatives et informatives et ne constitue pas un conseil financier, d'investissement ou de trading. Le trading de contrats à terme et d'autres produits à effet de levier comporte un risque de perte important et ne convient pas à tous les investisseurs. PickMyTrade est une plateforme d'automatisation tierce indépendante et n'est ni affiliée à Tradovate, Inc., ni approuvée ou parrainée par cette dernière. « Tradovate » ainsi que tous les noms, logos et marques associés sont la propriété de leurs détenteurs respectifs. Les fonctionnalités et les étapes de la plateforme évoluent avec le temps ; vérifiez donc toujours la procédure en vigueur sur la plateforme et dans la documentation officielles de Tradovate avant d'agir.", it: "Questa guida ha esclusivamente scopo educativo e informativo e non costituisce consulenza finanziaria, di investimento o di trading. Il trading di futures e di altri prodotti a leva comporta un rischio di perdita sostanziale e non è adatto a tutti gli investitori. PickMyTrade è una piattaforma di automazione indipendente di terze parti e non è affiliata, approvata né sponsorizzata da Tradovate, Inc. «Tradovate» e tutti i nomi, loghi e marchi correlati sono di proprietà dei rispettivi titolari. Le funzionalità e i passaggi della piattaforma cambiano nel tempo, pertanto confermi sempre la procedura attuale nella piattaforma e nella documentazione ufficiali di Tradovate prima di agire." },
