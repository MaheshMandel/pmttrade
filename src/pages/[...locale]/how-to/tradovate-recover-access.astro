---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-recover-access";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Reset 2FA & Recover a Locked Tradovate Account";
const META_DESCRIPTION =
  "Locked out of Tradovate or lost your 2FA device? Verify your identity with support to reset two-factor access and get back into your account fast.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "2FA zurücksetzen und ein gesperrtes Tradovate-Konto wiederherstellen", es: "Restablezca la 2FA y recupere una cuenta bloqueada de Tradovate", fr: "Réinitialiser la 2FA et récupérer un compte Tradovate verrouillé", it: "Reimpostare la 2FA e recuperare un account Tradovate bloccato" },
  dek: { en: "Locked out of your Tradovate account? Here's how to reset your two-factor authentication and get back in, without guessing.", de: "Aus Ihrem Tradovate-Konto ausgesperrt? So setzen Sie Ihre Zwei-Faktor-Authentifizierung zurück und kommen wieder hinein, ohne zu raten.", es: "¿Bloqueado fuera de su cuenta de Tradovate? Así se restablece la autenticación de dos factores y se vuelve a entrar, sin adivinar.", fr: "Verrouillé hors de votre compte Tradovate ? Voici comment réinitialiser votre authentification à deux facteurs et y retourner, sans tâtonner.", it: "Bloccato fuori dal suo account Tradovate? Ecco come reimpostare l'autenticazione a due fattori e rientrare, senza andare a tentativi." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-10",
  blocks: { en: [
    { type: "paragraph", html: "Locked out of your Tradovate account? Maybe you wiped the phone that held your authenticator app, the new-device approval email never showed up, or too many wrong password tries tripped a lock. Whatever put you on the wrong side of the login screen, here's how to reset your two-factor authentication and get back in, without guessing." },
    { type: "heading", text: "What's Actually Locking You Out?" },
    { type: "paragraph", html: "Recovery is faster once you know which wall you've hit. Four situations cover almost every locked-out trader: a new-device login where you never confirmed the 2FA email, a lost or reset phone that held your authenticator with no backup saved, a temporary lock after several failed password attempts, or a prop-firm account whose login your firm controls. The first three you can often clear yourself or with one support contact; the last routes entirely through your firm." },
    { type: "heading", text: "Recover Your Tradovate Access: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Pin Down Why You're Locked Out", html: "Look at what the screen is actually telling you. A prompt asking you to approve a new machine means 2FA is working and just waiting on you. A rejected code means your authenticator or SMS isn't lining up. A \"too many attempts\" style message points to a temporary lock that eases on its own. Matching the symptom to the right cause saves you from calling support for something a two-minute fix would solve." },
        { title: "Try the Fast Self-Serve Fixes First", html: "Before you contact anyone, rule out the quick wins. Check your email, inbox and spam, for Tradovate's device-approval message and confirm it to finish a new-device login. If you set a <strong class='text-white'>backup 2FA method</strong> when you turned two-factor on, switch to the one you can still reach. And if the password itself is the problem, use the <strong class='text-white'>Forgot Password</strong> link on the login page to reset it. Many \"locked out\" moments clear right here." },
        { title: "Contact Tradovate Support to Reset 2FA", html: "Lost the device entirely with no backup method saved? That's when support steps in, there's no self-serve button to wipe your own 2FA once you can't receive any code. Reach Tradovate through the <strong class='text-white'>Contact Support</strong> page via whichever channel is fastest: email <strong class='text-white'>support@tradovate.com</strong>, phone <strong class='text-white'>1-844-283-3100</strong>, or live chat. Account help runs on trading-day business hours (roughly 7 AM to 4 PM Central), and email is monitored around the clock on trading days, confirm the current hours on the support page. Tell them plainly that you've lost your 2FA method and need it reset." },
        { title: "Verify Your Identity, Then Re-Enroll 2FA", html: "Support won't strip security off an account without confirming you own it, so have your details ready: the email and username on file, plus whatever identifying information they ask for. Once you're verified, they'll reset or disable your 2FA so you can log in again. Then head to the <strong class='text-white'>Security</strong> page in Application Settings, turn 2FA back on, and this time add a <strong class='text-white'>backup method</strong>, an authenticator app and SMS together, so a lost phone never locks you out again." },
        { title: "Prop-Firm Accounts, Recover Through Your Firm", html: "If your Tradovate login came from a prop firm's evaluation or funded program, the recovery path is different. Those credentials are issued and system-generated by the firm and managed from the firm's own dashboard, so password resets, login trouble, and 2FA issues go through your firm's support, not Tradovate's. Contacting Tradovate directly for a firm-issued account usually just sends you back to the firm, so start there." },
      ],
    },
    { type: "heading", text: "Why You'd Need This" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Lost 2FA device</strong>, a wiped, lost, or replaced phone with no backup method saved.",
        "<strong class='text-white'>Approval email never arrives</strong>, a new-device login stuck with no code in your inbox.",
        "<strong class='text-white'>Failed-login lock</strong>, too many wrong password attempts that temporarily froze access.",
        "<strong class='text-white'>Switching machines</strong>, getting back in cleanly on a fresh computer.",
        "<strong class='text-white'>Funded accounts</strong>, knowing when to call Tradovate versus your prop firm.",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Once you're back in and your security is locked down, <strong class='text-white'>PickMyTrade wires your TradingView alerts straight to your Tradovate account</strong> so entries, exits, and brackets fire on their own, no manual clicks, no watching the screen. Your login and 2FA settings stay in your hands while the strategy runs hands-free." },
  ], de: [
    { type: "paragraph",html: "Aus Ihrem Tradovate-Konto ausgesperrt? Vielleicht haben Sie das Handy mit Ihrer Authenticator-App zurückgesetzt, die E-Mail zur Geräte-Freigabe kam nie an, oder zu viele falsche Passwortversuche haben eine Sperre ausgelöst. Was auch immer Sie auf die falsche Seite des Login-Bildschirms gebracht hat: So setzen Sie Ihre Zwei-Faktor-Authentifizierung zurück und kommen wieder hinein, ohne zu raten." },
    { type: "heading",text: "Was sperrt Sie tatsächlich aus?" },
    { type: "paragraph",html: "Die Wiederherstellung geht schneller, wenn Sie wissen, auf welche Hürde Sie gestoßen sind. Vier Situationen decken fast jeden ausgesperrten Trader ab: eine Anmeldung auf einem neuen Gerät, bei der Sie die 2FA-E-Mail nie bestätigt haben, ein verlorenes oder zurückgesetztes Handy mit Ihrem Authenticator ohne gespeichertes Backup, eine vorübergehende Sperre nach mehreren fehlgeschlagenen Passwortversuchen oder ein Prop-Firm-Konto, dessen Login Ihre Firma kontrolliert. Die ersten drei können Sie oft selbst oder mit einem einzigen Support-Kontakt beheben; der letzte läuft vollständig über Ihre Firma." },
    { type: "heading",text: "Zugriff auf Tradovate wiederherstellen: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Herausfinden, warum Sie ausgesperrt sind", html: "Sehen Sie sich an, was der Bildschirm Ihnen tatsächlich mitteilt. Eine Aufforderung, einen neuen Rechner freizugeben, bedeutet, dass die 2FA funktioniert und nur auf Sie wartet. Ein abgelehnter Code bedeutet, dass Ihr Authenticator oder die SMS nicht übereinstimmt. Eine Meldung im Stil von „zu viele Versuche“ weist auf eine vorübergehende Sperre hin, die von selbst nachlässt. Wenn Sie das Symptom der richtigen Ursache zuordnen, ersparen Sie sich einen Anruf beim Support wegen etwas, das eine Zwei-Minuten-Lösung beheben würde." },
        { title: "Zuerst die schnellen Selbsthilfe-Lösungen versuchen", html: "Bevor Sie jemanden kontaktieren, schließen Sie die einfachen Fälle aus. Prüfen Sie Ihre E-Mails, Posteingang und Spam, auf die Geräte-Freigabenachricht von Tradovate und bestätigen Sie sie, um die Anmeldung auf dem neuen Gerät abzuschließen. Wenn Sie beim Aktivieren der Zwei-Faktor-Authentifizierung eine <strong class='text-white'>Backup-2FA-Methode</strong> eingerichtet haben, wechseln Sie zu der, die Sie noch erreichen können. Und wenn das Passwort selbst das Problem ist, nutzen Sie den Link <strong class='text-white'>Forgot Password</strong> auf der Login-Seite, um es zurückzusetzen. Viele „Ausgesperrt“-Momente erledigen sich genau hier." },
        { title: "Tradovate-Support kontaktieren, um die 2FA zurückzusetzen", html: "Gerät komplett verloren und keine Backup-Methode gespeichert? Dann kommt der Support ins Spiel: Es gibt keine Selbstbedienungs-Schaltfläche, um die eigene 2FA zu löschen, sobald Sie keinen Code mehr empfangen können. Erreichen Sie Tradovate über die Seite <strong class='text-white'>Contact Support</strong> über den schnellsten Kanal: E-Mail <strong class='text-white'>support@tradovate.com</strong>, Telefon <strong class='text-white'>1-844-283-3100</strong> oder Live-Chat. Die Kontohilfe arbeitet zu den Geschäftszeiten an Handelstagen (etwa 7 bis 16 Uhr Central), und E-Mails werden an Handelstagen rund um die Uhr überwacht; bestätigen Sie die aktuellen Zeiten auf der Support-Seite. Sagen Sie klar, dass Sie Ihre 2FA-Methode verloren haben und sie zurückgesetzt werden muss." },
        { title: "Identität bestätigen, dann 2FA neu einrichten", html: "Der Support entfernt die Sicherheit eines Kontos nicht, ohne zu bestätigen, dass es Ihnen gehört. Halten Sie daher Ihre Angaben bereit: die hinterlegte E-Mail-Adresse und den Benutzernamen sowie alle weiteren Identifikationsangaben, nach denen gefragt wird. Nach der Verifizierung setzen sie Ihre 2FA zurück oder deaktivieren sie, damit Sie sich wieder anmelden können. Gehen Sie dann zur Seite <strong class='text-white'>Security</strong> in den Application Settings, aktivieren Sie die 2FA erneut und fügen Sie diesmal eine <strong class='text-white'>Backup-Methode</strong> hinzu, eine Authenticator-App und SMS zusammen, damit ein verlorenes Handy Sie nie wieder aussperrt." },
        { title: "Prop-Firm-Konten: Wiederherstellung über Ihre Firma", html: "Stammt Ihr Tradovate-Login aus dem Evaluierungs- oder Funded-Programm einer Prop Firm, ist der Wiederherstellungsweg ein anderer. Diese Zugangsdaten werden von der Firma ausgestellt, systemseitig erzeugt und über das eigene Dashboard der Firma verwaltet. Passwort-Resets, Login-Probleme und 2FA-Fragen laufen daher über den Support Ihrer Firma, nicht über den von Tradovate. Wenn Sie Tradovate direkt wegen eines von der Firma ausgestellten Kontos kontaktieren, werden Sie meist nur an die Firma zurückverwiesen, beginnen Sie also dort." },
      ],
    },
    { type: "heading",text: "Warum Sie das brauchen" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Verlorenes 2FA-Gerät</strong>, ein zurückgesetztes, verlorenes oder ersetztes Handy ohne gespeicherte Backup-Methode.",
        "<strong class='text-white'>Freigabe-E-Mail kommt nie an</strong>, eine Anmeldung auf einem neuen Gerät hängt fest, und kein Code erscheint in Ihrem Posteingang.",
        "<strong class='text-white'>Sperre nach fehlgeschlagenen Logins</strong>, zu viele falsche Passwortversuche, die den Zugriff vorübergehend eingefroren haben.",
        "<strong class='text-white'>Rechnerwechsel</strong>, sauber wieder hineinkommen auf einem neuen Computer.",
        "<strong class='text-white'>Funded-Konten</strong>, wissen, wann Sie Tradovate anrufen und wann Ihre Prop Firm.",
      ],
    },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "Sobald Sie wieder drin sind und Ihre Sicherheit steht, <strong class='text-white'>verbindet PickMyTrade Ihre TradingView-Alerts direkt mit Ihrem Tradovate-Konto</strong>, sodass Einstiege, Ausstiege und Brackets von selbst ausgelöst werden, ohne manuelle Klicks und ohne den Bildschirm zu beobachten. Ihr Login und Ihre 2FA-Einstellungen bleiben in Ihrer Hand, während die Strategie freihändig läuft." },
  ], es: [
    { type: "paragraph",html: "¿Bloqueado fuera de su cuenta de Tradovate? Quizá borró el teléfono que tenía su app de autenticación, el correo de aprobación del nuevo dispositivo nunca llegó, o demasiados intentos fallidos de contraseña activaron un bloqueo. Sea lo que sea lo que le dejó al otro lado de la pantalla de inicio de sesión, así se restablece la autenticación de dos factores y se vuelve a entrar, sin adivinar." },
    { type: "heading",text: "¿Qué es lo que realmente le bloquea?" },
    { type: "paragraph",html: "La recuperación es más rápida cuando sabe con qué obstáculo se ha encontrado. Cuatro situaciones cubren casi a todos los traders bloqueados: un inicio de sesión desde un dispositivo nuevo en el que nunca confirmó el correo de 2FA, un teléfono perdido o restablecido que contenía su autenticador sin respaldo guardado, un bloqueo temporal tras varios intentos fallidos de contraseña, o una cuenta de prop firm cuyo inicio de sesión controla su firma. Las tres primeras a menudo puede resolverlas usted mismo o con un solo contacto con soporte; la última pasa íntegramente por su firma." },
    { type: "heading",text: "Recupere su acceso a Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Identifique por qué está bloqueado", html: "Observe lo que realmente le dice la pantalla. Un aviso que le pide aprobar un equipo nuevo significa que la 2FA funciona y solo espera su acción. Un código rechazado significa que su autenticador o SMS no coincide. Un mensaje del tipo \"demasiados intentos\" apunta a un bloqueo temporal que se levanta solo. Asociar el síntoma con la causa correcta le evita llamar a soporte por algo que se resolvería en dos minutos." },
        { title: "Pruebe primero las soluciones rápidas por su cuenta", html: "Antes de contactar con nadie, descarte las soluciones rápidas. Revise su correo, bandeja de entrada y spam, en busca del mensaje de aprobación de dispositivo de Tradovate y confírmelo para completar el inicio de sesión en el dispositivo nuevo. Si configuró un <strong class='text-white'>método de 2FA de respaldo</strong> al activar la verificación en dos pasos, cambie al que todavía pueda usar. Y si el problema es la propia contraseña, use el enlace <strong class='text-white'>Forgot Password</strong> de la página de inicio de sesión para restablecerla. Muchos momentos de \"bloqueado\" se resuelven justo aquí." },
        { title: "Contacte con el soporte de Tradovate para restablecer la 2FA", html: "¿Perdió el dispositivo por completo y no guardó ningún método de respaldo? Entonces entra en juego el soporte: no existe un botón de autoservicio para borrar su propia 2FA cuando ya no puede recibir ningún código. Contacte con Tradovate a través de la página <strong class='text-white'>Contact Support</strong> por el canal más rápido: correo <strong class='text-white'>support@tradovate.com</strong>, teléfono <strong class='text-white'>1-844-283-3100</strong> o chat en vivo. La ayuda de cuentas funciona en horario laboral de días de mercado (aproximadamente de 7 AM a 4 PM hora Central), y el correo se supervisa las 24 horas en días de mercado; confirme los horarios actuales en la página de soporte. Diga con claridad que ha perdido su método de 2FA y necesita que lo restablezcan." },
        { title: "Verifique su identidad y vuelva a registrar la 2FA", html: "El soporte no retirará la seguridad de una cuenta sin confirmar que es suya, así que tenga sus datos a mano: el correo y el nombre de usuario registrados, además de cualquier información identificativa que le soliciten. Una vez verificado, restablecerán o desactivarán su 2FA para que pueda iniciar sesión de nuevo. Después vaya a la página <strong class='text-white'>Security</strong> en Application Settings, vuelva a activar la 2FA y esta vez añada un <strong class='text-white'>método de respaldo</strong>, una app de autenticación y SMS a la vez, para que un teléfono perdido no vuelva a dejarle fuera." },
        { title: "Cuentas de prop firm: recupere a través de su firma", html: "Si su acceso a Tradovate proviene del programa de evaluación o fondeado de una prop firm, la vía de recuperación es distinta. Esas credenciales las emite y genera el sistema de la firma y se gestionan desde su propio panel, por lo que los restablecimientos de contraseña, los problemas de inicio de sesión y los de 2FA pasan por el soporte de su firma, no por el de Tradovate. Contactar directamente con Tradovate por una cuenta emitida por una firma normalmente solo le devuelve a la firma, así que empiece por ahí." },
      ],
    },
    { type: "heading",text: "Por qué lo necesitaría" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Dispositivo de 2FA perdido</strong>, un teléfono borrado, perdido o sustituido sin método de respaldo guardado.",
        "<strong class='text-white'>El correo de aprobación no llega</strong>, un inicio de sesión desde un dispositivo nuevo atascado sin código en su bandeja de entrada.",
        "<strong class='text-white'>Bloqueo por inicios de sesión fallidos</strong>, demasiados intentos de contraseña incorrectos que congelaron el acceso temporalmente.",
        "<strong class='text-white'>Cambio de equipo</strong>, volver a entrar sin problemas en un ordenador nuevo.",
        "<strong class='text-white'>Cuentas fondeadas</strong>, saber cuándo llamar a Tradovate y cuándo a su prop firm.",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Una vez que haya vuelto a entrar y su seguridad esté reforzada, <strong class='text-white'>PickMyTrade conecta sus alertas de TradingView directamente con su cuenta de Tradovate</strong> para que las entradas, salidas y brackets se ejecuten solos, sin clics manuales ni vigilar la pantalla. Su inicio de sesión y sus ajustes de 2FA siguen en sus manos mientras la estrategia funciona sin intervención." },
  ], fr: [
    { type: "paragraph",html: "Verrouillé hors de votre compte Tradovate ? Peut-être avez-vous effacé le téléphone qui contenait votre application d'authentification, l'e-mail d'approbation du nouvel appareil n'est jamais arrivé, ou trop de tentatives de mot de passe erronées ont déclenché un verrouillage. Quelle que soit la raison qui vous a placé du mauvais côté de l'écran de connexion, voici comment réinitialiser votre authentification à deux facteurs et y retourner, sans tâtonner." },
    { type: "heading",text: "Qu'est-ce qui vous bloque réellement ?" },
    { type: "paragraph",html: "La récupération est plus rapide quand vous savez sur quel obstacle vous butez. Quatre situations couvrent presque tous les traders verrouillés : une connexion depuis un nouvel appareil où vous n'avez jamais confirmé l'e-mail 2FA, un téléphone perdu ou réinitialisé qui contenait votre authentificateur sans sauvegarde enregistrée, un verrouillage temporaire après plusieurs échecs de mot de passe, ou un compte de prop firm dont la connexion est contrôlée par votre firme. Les trois premières, vous pouvez souvent les régler vous-même ou avec un seul contact avec le support ; la dernière passe entièrement par votre firme." },
    { type: "heading",text: "Récupérer votre accès à Tradovate : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Identifier pourquoi vous êtes verrouillé", html: "Regardez ce que l'écran vous dit réellement. Une invite vous demandant d'approuver une nouvelle machine signifie que la 2FA fonctionne et attend simplement votre action. Un code rejeté signifie que votre authentificateur ou votre SMS ne correspond pas. Un message du type « trop de tentatives » indique un verrouillage temporaire qui se lève de lui-même. Associer le symptôme à la bonne cause vous évite d'appeler le support pour quelque chose qu'une correction de deux minutes réglerait." },
        { title: "Essayer d'abord les solutions rapides en autonomie", html: "Avant de contacter quiconque, écartez les solutions rapides. Vérifiez votre e-mail, boîte de réception et spam, pour le message d'approbation d'appareil de Tradovate et confirmez-le afin de terminer la connexion sur le nouvel appareil. Si vous avez défini une <strong class='text-white'>méthode de 2FA de secours</strong> lors de l'activation de l'authentification à deux facteurs, passez à celle que vous pouvez encore utiliser. Et si le problème vient du mot de passe lui-même, utilisez le lien <strong class='text-white'>Forgot Password</strong> de la page de connexion pour le réinitialiser. Beaucoup de situations de « verrouillage » se règlent ici." },
        { title: "Contacter le support Tradovate pour réinitialiser la 2FA", html: "Appareil totalement perdu et aucune méthode de secours enregistrée ? C'est là que le support intervient : il n'existe pas de bouton en libre-service pour effacer votre propre 2FA une fois que vous ne pouvez plus recevoir de code. Contactez Tradovate via la page <strong class='text-white'>Contact Support</strong> par le canal le plus rapide : e-mail <strong class='text-white'>support@tradovate.com</strong>, téléphone <strong class='text-white'>1-844-283-3100</strong> ou chat en direct. L'assistance des comptes fonctionne aux heures ouvrables des jours de bourse (environ 7 h à 16 h, heure du Centre), et l'e-mail est surveillé en continu les jours de bourse ; vérifiez les horaires actuels sur la page du support. Dites clairement que vous avez perdu votre méthode de 2FA et qu'elle doit être réinitialisée." },
        { title: "Vérifier votre identité, puis reconfigurer la 2FA", html: "Le support ne retirera pas la sécurité d'un compte sans confirmer que vous en êtes le titulaire ; préparez donc vos informations : l'e-mail et le nom d'utilisateur enregistrés, ainsi que toute information d'identification demandée. Une fois vérifié, il réinitialise ou désactive votre 2FA afin que vous puissiez vous reconnecter. Rendez-vous ensuite sur la page <strong class='text-white'>Security</strong> dans Application Settings, réactivez la 2FA et, cette fois, ajoutez une <strong class='text-white'>méthode de secours</strong>, une application d'authentification et un SMS ensemble, afin qu'un téléphone perdu ne vous verrouille plus jamais." },
        { title: "Comptes de prop firm : récupération via votre firme", html: "Si votre connexion Tradovate provient du programme d'évaluation ou de compte financé d'une prop firm, la voie de récupération est différente. Ces identifiants sont émis et générés par le système de la firme et gérés depuis son propre tableau de bord ; les réinitialisations de mot de passe, les problèmes de connexion et ceux de 2FA passent donc par le support de votre firme, pas par celui de Tradovate. Contacter directement Tradovate pour un compte fourni par une firme ne fait généralement que vous renvoyer vers la firme ; commencez donc par là." },
      ],
    },
    { type: "heading",text: "Pourquoi vous en auriez besoin" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Appareil 2FA perdu</strong>, un téléphone effacé, perdu ou remplacé sans méthode de secours enregistrée.",
        "<strong class='text-white'>L'e-mail d'approbation n'arrive jamais</strong>, une connexion sur un nouvel appareil bloquée sans code dans votre boîte de réception.",
        "<strong class='text-white'>Verrouillage après échecs de connexion</strong>, trop de mots de passe erronés ayant gelé temporairement l'accès.",
        "<strong class='text-white'>Changement de machine</strong>, retrouver proprement l'accès sur un nouvel ordinateur.",
        "<strong class='text-white'>Comptes financés</strong>, savoir quand appeler Tradovate et quand contacter votre prop firm.",
      ],
    },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Une fois de retour et votre sécurité renforcée, <strong class='text-white'>PickMyTrade relie vos alertes TradingView directement à votre compte Tradovate</strong> afin que les entrées, sorties et brackets se déclenchent d'eux-mêmes, sans clics manuels ni surveillance de l'écran. Votre connexion et vos paramètres de 2FA restent entre vos mains pendant que la stratégie tourne en mains libres." },
  ], it: [
    { type: "paragraph",html: "Bloccato fuori dal suo account Tradovate? Forse ha cancellato il telefono che conteneva la sua app di autenticazione, l'email di approvazione del nuovo dispositivo non è mai arrivata, oppure troppi tentativi errati di password hanno fatto scattare un blocco. Qualunque cosa l'abbia messa dal lato sbagliato della schermata di login, ecco come reimpostare l'autenticazione a due fattori e rientrare, senza andare a tentativi." },
    { type: "heading",text: "Che cosa La sta davvero bloccando?" },
    { type: "paragraph",html: "Il recupero è più rapido quando sa su quale ostacolo si è fermato. Quattro situazioni coprono quasi ogni trader bloccato: un accesso da un nuovo dispositivo in cui non ha mai confermato l'email 2FA, un telefono perso o reimpostato che conteneva l'autenticatore senza un backup salvato, un blocco temporaneo dopo diversi tentativi di password falliti, oppure un account di prop firm il cui login è controllato dalla sua società. I primi tre può spesso risolverli da solo o con un unico contatto con il supporto; l'ultimo passa interamente dalla sua società." },
    { type: "heading",text: "Recuperare l'accesso a Tradovate: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Capire perché è bloccato", html: "Guardi che cosa Le sta realmente dicendo la schermata. Una richiesta di approvare una nuova macchina significa che la 2FA funziona e attende solo Lei. Un codice rifiutato significa che l'autenticatore o l'SMS non coincide. Un messaggio del tipo \"troppi tentativi\" indica un blocco temporaneo che si risolve da solo. Associare il sintomo alla causa giusta Le evita di chiamare il supporto per qualcosa che si risolverebbe in due minuti." },
        { title: "Provare prima le soluzioni rapide in autonomia", html: "Prima di contattare qualcuno, escluda le soluzioni rapide. Controlli la sua email, posta in arrivo e spam, per il messaggio di approvazione del dispositivo di Tradovate e lo confermi per completare l'accesso dal nuovo dispositivo. Se ha impostato un <strong class='text-white'>metodo 2FA di backup</strong> quando ha attivato l'autenticazione a due fattori, passi a quello che può ancora raggiungere. E se il problema è la password stessa, usi il link <strong class='text-white'>Forgot Password</strong> nella pagina di login per reimpostarla. Molti momenti di \"blocco\" si risolvono proprio qui." },
        { title: "Contattare il supporto Tradovate per reimpostare la 2FA", html: "Ha perso del tutto il dispositivo e non ha salvato alcun metodo di backup? È qui che interviene il supporto: non esiste un pulsante self-service per cancellare la propria 2FA una volta che non può più ricevere alcun codice. Contatti Tradovate tramite la pagina <strong class='text-white'>Contact Support</strong> con il canale più rapido: email <strong class='text-white'>support@tradovate.com</strong>, telefono <strong class='text-white'>1-844-283-3100</strong> o chat dal vivo. L'assistenza account funziona nei normali orari di lavoro dei giorni di negoziazione (circa dalle 7 alle 16, ora Central), e l'email viene monitorata 24 ore su 24 nei giorni di negoziazione; confermi gli orari attuali sulla pagina del supporto. Dica chiaramente che ha perso il suo metodo 2FA e che deve essere reimpostato." },
        { title: "Verificare l'identità, poi registrare di nuovo la 2FA", html: "Il supporto non rimuoverà la sicurezza da un account senza confermare che sia Suo, quindi tenga pronti i suoi dati: l'email e il nome utente registrati, più qualsiasi informazione identificativa richiesta. Una volta verificato, reimposteranno o disattiveranno la sua 2FA così potrà accedere di nuovo. Poi vada alla pagina <strong class='text-white'>Security</strong> in Application Settings, riattivi la 2FA e questa volta aggiunga un <strong class='text-white'>metodo di backup</strong>, un'app di autenticazione e SMS insieme, così un telefono perso non La bloccherà mai più." },
        { title: "Account di prop firm: recupero tramite la sua società", html: "Se il suo login Tradovate proviene dal programma di valutazione o di account finanziato di una prop firm, il percorso di recupero è diverso. Quelle credenziali sono emesse e generate dal sistema della società e gestite dalla sua dashboard, quindi reimpostazioni di password, problemi di login e problemi di 2FA passano dal supporto della sua società, non da quello di Tradovate. Contattare direttamente Tradovate per un account emesso da una società di solito La rimanda semplicemente alla società, quindi parta da lì." },
      ],
    },
    { type: "heading",text: "Perché Le servirebbe" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Dispositivo 2FA perso</strong>, un telefono cancellato, perso o sostituito senza un metodo di backup salvato.",
        "<strong class='text-white'>L'email di approvazione non arriva</strong>, un accesso da un nuovo dispositivo bloccato senza alcun codice nella posta in arrivo.",
        "<strong class='text-white'>Blocco per login falliti</strong>, troppi tentativi errati di password che hanno congelato temporaneamente l'accesso.",
        "<strong class='text-white'>Cambio di macchina</strong>, rientrare senza problemi su un nuovo computer.",
        "<strong class='text-white'>Account finanziati</strong>, sapere quando chiamare Tradovate e quando la sua prop firm.",
      ],
