  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Foire aux questions", it: "Domande frequenti" },
  faqs: { en: [
    { q: "How often does Tradovate need a WebSocket heartbeat?", a: "Every 2.5 seconds. Send a frame whose text is [] on that cadence and the server keeps the connection open; let the gap grow and it closes the socket." },
    { q: "What does the [] heartbeat frame actually contain?", a: "Nothing but an empty JSON array as text. It carries no data, its only job is to tell the server your client is still alive." },
    { q: "Why does my WebSocket drop when I switch browser tabs?", a: "Browsers throttle setInterval and setTimeout in background tabs, so your heartbeat falls behind and the server times you out. Run the timer in a Web Worker or a Node.js process to avoid it." },
