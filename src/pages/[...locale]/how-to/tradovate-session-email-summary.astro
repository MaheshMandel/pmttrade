---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-session-email-summary";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);

const META_TITLE = "Get an End-of-Session Email Summary in Tradovate";
const META_DESCRIPTION =
  "Enable Tradovate's end-of-session summary email to get your open positions and working orders emailed after each Live session closes.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "E-Mail-Zusammenfassung zum Sitzungsende in Tradovate erhalten", es: "Reciba un resumen por correo al final de la sesión en Tradovate", fr: "Recevoir un récapitulatif par e-mail en fin de session dans Tradovate", it: "Ricevere un riepilogo via e-mail a fine sessione in Tradovate" },
  dek: { en: "Forget a resting order after the close? Here's how to switch on Tradovate's end-of-session summary email and set when it lands in your inbox.", de: "Eine ausstehende Order nach dem Handelsschluss vergessen? So aktivieren Sie die E-Mail mit der Zusammenfassung zum Sitzungsende bei Tradovate und legen fest, wann sie in Ihrem Posteingang ankommt.", es: "¿Olvidó una orden pendiente tras el cierre? Así se activa el correo de resumen de fin de sesión de Tradovate y se configura cuándo llega a su bandeja de entrada.", fr: "Vous avez oublié un ordre en attente après la clôture ? Voici comment activer l'e-mail de récapitulatif de fin de session de Tradovate et choisir le moment où il arrive dans votre boîte de réception.", it: "Ha dimenticato un ordine pendente dopo la chiusura? Ecco come attivare l'e-mail di riepilogo di fine sessione di Tradovate e impostare quando arriva nella Sua casella di posta." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-10",
  blocks: { en: [
    { type: "paragraph", html: "Step away before the session fully closes and it's easy to forget a resting limit order or a position you meant to flatten. Tradovate can email you a clean recap once your last Live session shuts down, so you know exactly what's still working and what's still open, without logging back in. Here's how to switch it on and set when it lands in your inbox." },
    { type: "quote", html: "This is a Live-account feature. Simulated accounts don't generate the summary email, and prop or evaluation accounts depend on what your firm turns on, so check your firm's current rules if you don't see the option." },
    { type: "heading", text: "What the Summary Email Includes" },
    { type: "paragraph", html: "Once the option is on, Tradovate sends a single email after your last Live session of the day closes. It covers the essentials you'd otherwise have to log in to check:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Working orders:</strong> any resting orders still active when the session closed, like limits and stops you left in place.",
        "<strong class='text-white'>Open positions:</strong> a positions summary for anything carried past the close.",
        "<strong class='text-white'>Session details:</strong> enough context to know which close the recap covers.",
      ],
    },
    { type: "paragraph", html: "It's a quick end-of-day sanity check. If you expected to be flat and the email shows an open position, you'll catch it before the next session opens." },
    { type: "heading", text: "Before You Start" },
    {
      type: "list",
      items: [
        "A funded <strong class='text-white'>Live</strong> Tradovate account, since the option only appears for Live accounts, not simulated ones.",
        "A working email address on your account so the recap can actually reach you.",
        "About two minutes in Application Settings.",
      ],
    },
    { type: "heading", text: "Turn On the Account Summary Email: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open Application Settings", html: "Log in to your Live account on web or desktop. Open <strong class='text-white'>Application Settings</strong> from the settings icon in the platform. That's where every account-level preference lives, notifications included." },
        { title: "Open the Notifications Section", html: "Inside Application Settings, select <strong class='text-white'>Notifications</strong>. This section handles what Tradovate tells you and how it reaches you, from on-screen order status messages to email alerts." },
        { title: "Turn on Send Account Summary Email", html: "Scroll to the bottom of the Notifications page and switch on <strong class='text-white'>Send Account Summary Email</strong>. Don't see it? That almost always means you're on a simulated account. Sign back in on your Live account and the option shows up." },
        { title: "Set When the Email Arrives", html: "With the toggle on, tell Tradovate when to send the recap. You've got two ways to time it: a set number of <strong class='text-white'>minutes after your last Live session closes</strong>, or at a <strong class='text-white'>fixed time of day in Central Time (CST)</strong>. Pick whatever fits your routine: a short delay right after the close, or a set hour so it's waiting for you before the next session." },
        { title: "Save and Check Your Inbox", html: "Save your settings. After the next Live session closes, the summary should land in your inbox at the time you chose. If nothing arrives, run through the quick checks below." },
      ],
    },
    { type: "heading", text: "Not Getting the Email? Quick Checks" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Confirm it's a Live account.</strong> Simulated sessions don't trigger the summary at all.",
        "<strong class='text-white'>Check spam and promotions.</strong> Automated account emails often get filtered there, so mark it as safe once you find it.",
        "<strong class='text-white'>Verify your email address.</strong> If the address on your account is wrong or unconfirmed, the recap has nowhere to go.",
        "<strong class='text-white'>Remember the timing.</strong> It fires after your <em>last</em> Live session closes, on the delay or CST time you set, not the moment you close the platform.",
        "<strong class='text-white'>Prop and evaluation accounts.</strong> Your firm controls which notifications are available, so ask them if the option is missing or the email never shows.",
      ],
    },
    { type: "heading", text: "Want More Than a Daily Recap?" },
    { type: "paragraph", html: "The summary email is great for a once-a-day check, but it won't manage positions for you. <strong class='text-white'>PickMyTrade wires your TradingView alerts straight into Tradovate</strong>, so entries, exits, and stops fire automatically instead of sitting as forgotten resting orders at the close." },
  ], de: [
    { type: "paragraph",html: "Wenn Sie vor dem vollständigen Ende der Sitzung weggehen, vergisst man leicht eine ausstehende Limit-Order oder eine Position, die man schließen wollte. Tradovate kann Ihnen eine übersichtliche Zusammenfassung per E-Mail senden, sobald Ihre letzte Live-Sitzung endet, sodass Sie genau wissen, was noch aktiv und was noch offen ist, ohne sich erneut anzumelden. So aktivieren Sie sie und legen fest, wann sie in Ihrem Posteingang landet." },
    { type: "quote",html: "Dies ist eine Funktion für Live-Konten. Simulierte Konten erzeugen die Zusammenfassungs-E-Mail nicht, und bei Prop- oder Evaluierungskonten hängt es davon ab, was Ihre Firma aktiviert. Prüfen Sie daher die aktuellen Regeln Ihrer Firma, falls Sie die Option nicht sehen." },
    { type: "heading",text: "Was die Zusammenfassungs-E-Mail enthält" },
    { type: "paragraph",html: "Sobald die Option aktiviert ist, sendet Tradovate eine einzelne E-Mail, nachdem Ihre letzte Live-Sitzung des Tages geendet hat. Sie enthält das Wesentliche, wofür Sie sich sonst anmelden müssten:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Working Orders:</strong> alle ausstehenden Orders, die bei Sitzungsende noch aktiv waren, etwa von Ihnen stehen gelassene Limit- und Stop-Orders.",
        "<strong class='text-white'>Offene Positionen:</strong> eine Positionsübersicht für alles, was über den Handelsschluss hinaus gehalten wird.",
        "<strong class='text-white'>Sitzungsdetails:</strong> genug Kontext, um zu wissen, auf welchen Handelsschluss sich die Zusammenfassung bezieht.",
      ],
    },
    { type: "paragraph",html: "Es ist ein schneller Plausibilitätscheck zum Tagesende. Wenn Sie erwartet haben, flat zu sein, und die E-Mail eine offene Position zeigt, bemerken Sie das, bevor die nächste Sitzung beginnt." },
    { type: "heading",text: "Bevor Sie beginnen" },
    {
      type: "list",
      items: [
        "Ein finanziertes <strong class='text-white'>Live</strong>-Konto bei Tradovate, da die Option nur für Live-Konten und nicht für simulierte erscheint.",
        "Eine funktionierende E-Mail-Adresse in Ihrem Konto, damit die Zusammenfassung Sie auch erreicht.",
        "Etwa zwei Minuten in den Application Settings.",
      ],
    },
    { type: "heading",text: "E-Mail mit Kontozusammenfassung aktivieren: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Application Settings öffnen", html: "Melden Sie sich im Web oder auf dem Desktop bei Ihrem Live-Konto an. Öffnen Sie die <strong class='text-white'>Application Settings</strong> über das Einstellungssymbol in der Plattform. Dort befinden sich alle Präferenzen auf Kontoebene, einschließlich der Benachrichtigungen." },
        { title: "Den Bereich Notifications öffnen", html: "Wählen Sie in den Application Settings <strong class='text-white'>Notifications</strong> aus. Dieser Bereich steuert, was Tradovate Ihnen mitteilt und wie es Sie erreicht, von Statusmeldungen zu Orders auf dem Bildschirm bis zu E-Mail-Benachrichtigungen." },
        { title: "Send Account Summary Email einschalten", html: "Scrollen Sie ans Ende der Seite Notifications und schalten Sie <strong class='text-white'>Send Account Summary Email</strong> ein. Sehen Sie die Option nicht? Das bedeutet fast immer, dass Sie ein simuliertes Konto verwenden. Melden Sie sich wieder mit Ihrem Live-Konto an, dann erscheint die Option." },
        { title: "Festlegen, wann die E-Mail ankommt", html: "Sobald der Schalter aktiviert ist, legen Sie fest, wann Tradovate die Zusammenfassung senden soll. Es gibt zwei Möglichkeiten: eine bestimmte Anzahl von <strong class='text-white'>Minuten nach dem Ende Ihrer letzten Live-Sitzung</strong> oder eine <strong class='text-white'>feste Tageszeit in Central Time (CST)</strong>. Wählen Sie, was zu Ihrem Ablauf passt: eine kurze Verzögerung direkt nach Handelsschluss oder eine feste Uhrzeit, sodass sie vor der nächsten Sitzung für Sie bereitliegt." },
        { title: "Speichern und Posteingang prüfen", html: "Speichern Sie Ihre Einstellungen. Nachdem die nächste Live-Sitzung geendet hat, sollte die Zusammenfassung zur gewählten Zeit in Ihrem Posteingang ankommen. Wenn nichts eintrifft, gehen Sie die folgenden kurzen Prüfungen durch." },
      ],
    },
    { type: "heading",text: "Keine E-Mail erhalten? Kurze Prüfungen" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Prüfen Sie, ob es ein Live-Konto ist.</strong> Simulierte Sitzungen lösen die Zusammenfassung überhaupt nicht aus.",
        "<strong class='text-white'>Spam und Werbung prüfen.</strong> Automatische Konto-E-Mails werden dort oft herausgefiltert. Markieren Sie die E-Mail als sicher, sobald Sie sie gefunden haben.",
        "<strong class='text-white'>E-Mail-Adresse verifizieren.</strong> Ist die Adresse in Ihrem Konto falsch oder unbestätigt, kann die Zusammenfassung nirgendwohin zugestellt werden.",
        "<strong class='text-white'>Den Zeitpunkt beachten.</strong> Sie wird nach dem Ende Ihrer <em>letzten</em> Live-Sitzung gesendet, mit der von Ihnen gewählten Verzögerung oder CST-Zeit, und nicht in dem Moment, in dem Sie die Plattform schließen.",
        "<strong class='text-white'>Prop- und Evaluierungskonten.</strong> Ihre Firma steuert, welche Benachrichtigungen verfügbar sind. Fragen Sie dort nach, wenn die Option fehlt oder die E-Mail nie ankommt.",
      ],
    },
    { type: "heading",text: "Mehr als eine tägliche Zusammenfassung?" },
    { type: "paragraph",html: "Die Zusammenfassungs-E-Mail eignet sich hervorragend für eine tägliche Kontrolle, verwaltet aber keine Positionen für Sie. <strong class='text-white'>PickMyTrade verbindet Ihre TradingView-Alerts direkt mit Tradovate</strong>, sodass Einstiege, Ausstiege und Stops automatisch ausgelöst werden, statt als vergessene ausstehende Orders bei Handelsschluss stehen zu bleiben." },
  ], es: [
    { type: "paragraph",html: "Si se aleja antes de que la sesión termine por completo, es fácil olvidar una orden límite pendiente o una posición que pensaba cerrar. Tradovate puede enviarle por correo un resumen claro cuando se apague su última sesión en vivo, para que sepa exactamente qué sigue activo y qué sigue abierto, sin tener que volver a iniciar sesión. Así se activa y se configura cuándo llega a su bandeja de entrada." },
    { type: "quote",html: "Esta es una función de cuentas reales. Las cuentas simuladas no generan el correo de resumen, y en las cuentas prop o de evaluación depende de lo que active su firma, así que consulte las normas vigentes de su firma si no ve la opción." },
    { type: "heading",text: "Qué incluye el correo de resumen" },
    { type: "paragraph",html: "Una vez activada la opción, Tradovate envía un único correo después de que cierre su última sesión en vivo del día. Cubre lo esencial que de otro modo tendría que iniciar sesión para comprobar:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Órdenes de trabajo:</strong> cualquier orden pendiente que siguiera activa al cerrar la sesión, como límites y stops que dejó colocados.",
        "<strong class='text-white'>Posiciones abiertas:</strong> un resumen de posiciones de todo lo que se mantiene tras el cierre.",
        "<strong class='text-white'>Detalles de la sesión:</strong> contexto suficiente para saber a qué cierre corresponde el resumen.",
      ],
    },
    { type: "paragraph",html: "Es una comprobación rápida de cordura al final del día. Si esperaba estar en flat y el correo muestra una posición abierta, lo detectará antes de que abra la siguiente sesión." },
    { type: "heading",text: "Antes de empezar" },
    {
      type: "list",
      items: [
        "Una cuenta de Tradovate <strong class='text-white'>real</strong> fondeada, ya que la opción solo aparece en cuentas reales, no en simuladas.",
        "Una dirección de correo electrónico válida en su cuenta para que el resumen pueda llegarle.",
        "Unos dos minutos en Application Settings.",
      ],
    },
    { type: "heading",text: "Active el correo de resumen de la cuenta: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra Application Settings", html: "Inicie sesión en su cuenta real en la web o en el escritorio. Abra <strong class='text-white'>Application Settings</strong> desde el icono de ajustes de la plataforma. Ahí residen todas las preferencias a nivel de cuenta, incluidas las notificaciones." },
        { title: "Abra la sección Notifications", html: "Dentro de Application Settings, seleccione <strong class='text-white'>Notifications</strong>. Esta sección controla qué le comunica Tradovate y cómo le llega, desde los mensajes de estado de órdenes en pantalla hasta las alertas por correo." },
        { title: "Active Send Account Summary Email", html: "Desplácese al final de la página de Notifications y active <strong class='text-white'>Send Account Summary Email</strong>. ¿No la ve? Casi siempre significa que está en una cuenta simulada. Vuelva a iniciar sesión en su cuenta real y la opción aparecerá." },
        { title: "Defina cuándo llega el correo", html: "Con el interruptor activado, indique a Tradovate cuándo enviar el resumen. Tiene dos formas de programarlo: un número determinado de <strong class='text-white'>minutos después de que cierre su última sesión en vivo</strong>, o a una <strong class='text-white'>hora fija del día en hora central (CST)</strong>. Elija lo que encaje con su rutina: un breve retraso justo después del cierre, o una hora fija para que lo tenga esperando antes de la siguiente sesión." },
        { title: "Guarde y revise su bandeja de entrada", html: "Guarde sus ajustes. Después de que cierre la siguiente sesión en vivo, el resumen debería llegar a su bandeja de entrada a la hora elegida. Si no llega nada, repase las comprobaciones rápidas siguientes." },
      ],
    },
    { type: "heading",text: "¿No recibe el correo? Comprobaciones rápidas" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Confirme que es una cuenta real.</strong> Las sesiones simuladas no activan el resumen en absoluto.",
        "<strong class='text-white'>Revise spam y promociones.</strong> Los correos automáticos de cuenta suelen filtrarse allí; márquelo como seguro cuando lo encuentre.",
        "<strong class='text-white'>Verifique su dirección de correo.</strong> Si la dirección de su cuenta es incorrecta o no está confirmada, el resumen no tiene adónde ir.",
        "<strong class='text-white'>Recuerde el horario.</strong> Se envía después del cierre de su <em>última</em> sesión en vivo, con el retraso o la hora CST que haya definido, no en el momento en que cierra la plataforma.",
        "<strong class='text-white'>Cuentas prop y de evaluación.</strong> Su firma controla qué notificaciones están disponibles, así que pregúntele si falta la opción o el correo nunca llega.",
      ],
    },
    { type: "heading",text: "¿Quiere algo más que un resumen diario?" },
    { type: "paragraph",html: "El correo de resumen es ideal para una revisión diaria, pero no gestionará posiciones por usted. <strong class='text-white'>PickMyTrade conecta sus alertas de TradingView directamente con Tradovate</strong>, de modo que las entradas, las salidas y los stops se ejecutan automáticamente en lugar de quedar como órdenes pendientes olvidadas al cierre." },
  ], fr: [
    { type: "paragraph",html: "Si vous vous éloignez avant la fin complète de la session, il est facile d'oublier un ordre limite en attente ou une position que vous comptiez clôturer. Tradovate peut vous envoyer par e-mail un récapitulatif clair une fois votre dernière session réelle terminée, afin que vous sachiez exactement ce qui est encore actif et ce qui est encore ouvert, sans vous reconnecter. Voici comment l'activer et choisir le moment où il arrive dans votre boîte de réception." },
    { type: "quote",html: "Il s'agit d'une fonctionnalité réservée aux comptes réels. Les comptes simulés ne génèrent pas l'e-mail de récapitulatif, et les comptes prop ou d'évaluation dépendent de ce que votre firme active ; vérifiez donc les règles en vigueur de votre firme si vous ne voyez pas l'option." },
    { type: "heading",text: "Ce que contient l'e-mail de récapitulatif" },
    { type: "paragraph",html: "Une fois l'option activée, Tradovate envoie un seul e-mail après la fermeture de votre dernière session réelle de la journée. Il couvre l'essentiel que vous devriez sinon vous connecter pour vérifier :" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Ordres de travail :</strong> tout ordre en attente encore actif à la fermeture de la session, comme les ordres limites et les stops que vous avez laissés en place.",
        "<strong class='text-white'>Positions ouvertes :</strong> un récapitulatif des positions pour tout ce qui est conservé après la clôture.",
        "<strong class='text-white'>Détails de la session :</strong> suffisamment de contexte pour savoir à quelle clôture se rapporte le récapitulatif.",
      ],
    },
    { type: "paragraph",html: "C'est un contrôle de cohérence rapide en fin de journée. Si vous pensiez être à plat et que l'e-mail montre une position ouverte, vous le saurez avant l'ouverture de la session suivante." },
    { type: "heading",text: "Avant de commencer" },
    {
      type: "list",
      items: [
        "Un compte Tradovate <strong class='text-white'>réel</strong> financé, car l'option n'apparaît que pour les comptes réels, pas pour les comptes simulés.",
        "Une adresse e-mail valide sur votre compte pour que le récapitulatif puisse vous parvenir.",
        "Environ deux minutes dans Application Settings.",
      ],
    },
    { type: "heading",text: "Activer l'e-mail de récapitulatif de compte : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir Application Settings", html: "Connectez-vous à votre compte réel sur le web ou le bureau. Ouvrez <strong class='text-white'>Application Settings</strong> depuis l'icône de paramètres de la plateforme. C'est là que se trouvent toutes les préférences au niveau du compte, notifications comprises." },
        { title: "Ouvrir la section Notifications", html: "Dans Application Settings, sélectionnez <strong class='text-white'>Notifications</strong>. Cette section gère ce que Tradovate vous signale et la façon dont cela vous parvient, des messages d'état des ordres à l'écran aux alertes par e-mail." },
        { title: "Activer Send Account Summary Email", html: "Faites défiler jusqu'en bas de la page Notifications et activez <strong class='text-white'>Send Account Summary Email</strong>. Vous ne la voyez pas ? Cela signifie presque toujours que vous êtes sur un compte simulé. Reconnectez-vous à votre compte réel et l'option apparaîtra." },
        { title: "Définir le moment d'arrivée de l'e-mail", html: "Une fois l'interrupteur activé, indiquez à Tradovate quand envoyer le récapitulatif. Vous avez deux façons de le programmer : un certain nombre de <strong class='text-white'>minutes après la fermeture de votre dernière session réelle</strong>, ou à une <strong class='text-white'>heure fixe de la journée en heure centrale (CST)</strong>. Choisissez ce qui convient à votre routine : un court délai juste après la clôture, ou une heure précise pour qu'il vous attende avant la session suivante." },
        { title: "Enregistrer et vérifier votre boîte de réception", html: "Enregistrez vos paramètres. Après la fermeture de la prochaine session réelle, le récapitulatif devrait arriver dans votre boîte de réception à l'heure choisie. Si rien n'arrive, passez en revue les vérifications rapides ci-dessous." },
      ],
    },
    { type: "heading",text: "Vous ne recevez pas l'e-mail ? Vérifications rapides" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Vérifiez qu'il s'agit d'un compte réel.</strong> Les sessions simulées ne déclenchent pas du tout le récapitulatif.",
        "<strong class='text-white'>Consultez les spams et les promotions.</strong> Les e-mails automatiques de compte y sont souvent filtrés : marquez-le comme sûr une fois que vous l'avez trouvé.",
        "<strong class='text-white'>Vérifiez votre adresse e-mail.</strong> Si l'adresse de votre compte est erronée ou non confirmée, le récapitulatif n'a nulle part où aller.",
        "<strong class='text-white'>Rappelez-vous le timing.</strong> Il est envoyé après la fermeture de votre <em>dernière</em> session réelle, selon le délai ou l'heure CST que vous avez définis, et non au moment où vous fermez la plateforme.",
        "<strong class='text-white'>Comptes prop et d'évaluation.</strong> Votre firme contrôle les notifications disponibles ; interrogez-la si l'option est absente ou si l'e-mail n'arrive jamais.",
      ],
    },
    { type: "heading",text: "Envie de plus qu'un récapitulatif quotidien ?" },
    { type: "paragraph",html: "L'e-mail de récapitulatif est parfait pour un contrôle quotidien, mais il ne gérera pas vos positions à votre place. <strong class='text-white'>PickMyTrade relie vos alertes TradingView directement à Tradovate</strong>, de sorte que les entrées, les sorties et les stops se déclenchent automatiquement au lieu de rester des ordres en attente oubliés à la clôture." },
  ], it: [
    { type: "paragraph",html: "Se si allontana prima che la sessione si chiuda del tutto, è facile dimenticare un ordine limite pendente o una posizione che intendeva chiudere. Tradovate può inviarLe via e-mail un riepilogo chiaro non appena termina la Sua ultima sessione live, così sa esattamente cosa è ancora in lavorazione e cosa è ancora aperto, senza dover riaccedere. Ecco come attivarla e impostare quando arriva nella Sua casella di posta." },
    { type: "quote",html: "Questa è una funzione dei conti live. I conti simulati non generano l'e-mail di riepilogo e i conti prop o di valutazione dipendono da ciò che attiva la Sua società, quindi verifichi le regole attuali della Sua società se non vede l'opzione." },
    { type: "heading",text: "Cosa include l'e-mail di riepilogo" },
