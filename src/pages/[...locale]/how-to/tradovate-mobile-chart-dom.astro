---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-mobile-chart-dom";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Load Charts & SuperDOM on Tradovate Mobile";
const META_DESCRIPTION =
  "Open the Chart and SuperDOM on your futures phone app: tap Markets, pick a contract, expand full screen, then drag the divider to switch views.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Charts und SuperDOM in Tradovate Mobile laden", es: "Cargar gráficos y SuperDOM en Tradovate móvil", fr: "Charger les graphiques et le SuperDOM sur Tradovate mobile", it: "Caricare grafici e SuperDOM su Tradovate mobile" },
  dek: { en: "The Chart and the SuperDOM don't live in two separate windows on Tradovate mobile. They share one expandable view, and you slide between them with a single divider. Here's the full walkthrough.", de: "Chart und SuperDOM liegen in Tradovate Mobile nicht in zwei getrennten Fenstern. Sie teilen sich eine erweiterbare Ansicht, und mit einem einzigen Trenner wechseln Sie zwischen beiden. Hier ist die vollständige Anleitung.", es: "El gráfico y el SuperDOM no viven en dos ventanas separadas en Tradovate móvil. Comparten una vista expandible y se alterna entre ellos con un único divisor. Aquí tiene la guía completa.", fr: "Sur Tradovate mobile, le graphique et le SuperDOM ne se trouvent pas dans deux fenêtres distinctes. Ils partagent une seule vue extensible, et vous passez de l’un à l’autre avec un simple séparateur. Voici le guide complet.", it: "Su Tradovate mobile il grafico e il SuperDOM non stanno in due finestre separate. Condividono un’unica vista espandibile e si passa dall’uno all’altro con un solo divisore. Ecco la guida completa." },
  readTime: { en: "4 min read", de: "4 Min. Lesezeit", es: "Lectura de 4 min", fr: "Lecture : 4 min", it: "Lettura di 4 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "The Tradovate mobile app squeezes the same price chart and order ladder you use on desktop into a phone screen. The part that trips most people up is that the Chart and the SuperDOM don't live in two separate windows here. They share one expandable view, and you slide between them with a single divider. Once you know that, loading both for any contract takes well under a minute." },
    { type: "paragraph", html: "Here's the full walkthrough, from the menu tap to the finished side-by-side layout." },
    { type: "quote", html: "<strong class='text-white'>Before you start:</strong> Install the app from the App Store or Google Play and sign in. Charts and the ladder both need you logged in with market data flowing." },
    { type: "heading", text: "Load Charts and SuperDOM on Tradovate Mobile: Step by Step" },
    {
      type: "steps",
      items: [
        { title: "Open the Menu", html: "Tap the three-bar hamburger icon in the top-left corner. That opens the Options menu, your jumping-off point for everything on mobile, from account switching to the market list.", image: { src: `${IMG}/tradovate-mobile-chart-dom-1.jpg`, alt: "Tradovate mobile app with the three-bar hamburger menu icon highlighted in the top-left corner" } },
        { title: "Open Markets and Pick a Contract", html: "Tap <strong class='text-white'>Markets</strong>. You'll get the full list of futures contracts grouped by category, so equity index, energy, metals, and the rest each sit in their own section. Scroll to the product you trade, then tap the specific contract, say the front-month ES or NQ, to load it. Trading a prop or evaluation account? Which contracts you can pull up and whether the data is live or delayed depends on your firm and plan, so check your firm's current rules if a symbol looks locked or the quotes look stale.", image: { src: `${IMG}/tradovate-mobile-chart-dom-2.jpg`, alt: "Tradovate mobile Markets screen listing futures contracts sorted by category" } },
        { title: "Expand to Full Screen", html: "With the contract open, tap the <strong class='text-white'>expand</strong> icon, the one that looks like four arrows pointing outward toward the corners. That blows the view up to fill the screen. Turn your phone sideways into landscape while you're here. The chart and ladder both get a lot more breathing room in that orientation, which matters when you're eyeing price levels on a small display.", image: { src: `${IMG}/tradovate-mobile-chart-dom-3.jpg`, alt: "Tradovate mobile expanded full-screen view with the four-arrow expand icon highlighted" } },
        { title: "Slide Between Chart and SuperDOM", html: "Look for the thin vertical line running down the expanded screen. That's your divider between the Chart on one side and the SuperDOM on the other. Press and hold the small <strong class='text-white'>notch</strong> near the top of that line, then drag it left or right. Drag one way and the chart fills more of the screen; drag the other and the SuperDOM ladder takes over. Park it in the middle and you get both side by side, which is what most people want for reading the tape while watching the chart.", image: { src: `${IMG}/tradovate-mobile-chart-dom-4.jpg`, alt: "Tradovate mobile expanded view showing the vertical divider notch between the Chart and SuperDOM" } },
      ],
    },
    { type: "heading", text: "Working in the Side-by-Side View" },
    { type: "paragraph", html: "Once both are loaded, the mobile app behaves a lot like the desktop. You can place and manage orders and brackets straight from the ladder or the chart, and the mobile charts carry the same library of 40-plus built-in indicators." },
    { type: "paragraph", html: "If a chart loads blank or the quotes freeze, back out to the Markets list and reopen the contract, or close and relaunch the app. That usually forces the data feed to reconnect. Persistent blackouts point to a data-subscription or connection issue rather than the app itself." },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Tired of tapping through your phone to fire every trade? <strong class='text-white'>PickMyTrade automates your Tradovate orders</strong> so your TradingView signals route straight to your account, hands-free." },
    { type: "paragraph", html: "That's the whole flow. Menu, Markets, pick a contract, expand, then drag the notch. The one mental shift is treating the Chart and SuperDOM as two halves of a single screen you slide between, not two windows you juggle. Labels and icons do shift between app updates, so if something's moved, look for the same function rather than the exact wording described here." },
  ], de: [
    { type: "paragraph",html: "Die Tradovate-Mobile-App bringt denselben Preischart und dieselbe Orderleiter, die Sie vom Desktop kennen, auf einen Smartphone-Bildschirm. Die meisten stolpern darüber, dass Chart und SuperDOM hier nicht in zwei getrennten Fenstern liegen. Sie teilen sich eine erweiterbare Ansicht, und mit einem einzigen Trenner wechseln Sie zwischen beiden. Sobald Sie das wissen, dauert es für jeden Kontrakt deutlich weniger als eine Minute, beide zu laden." },
    { type: "paragraph",html: "Hier ist die vollständige Anleitung, vom Tippen auf das Menü bis zum fertigen Side-by-Side-Layout." },
    { type: "quote",html: "<strong class='text-white'>Bevor Sie beginnen:</strong> Installieren Sie die App aus dem App Store oder von Google Play und melden Sie sich an. Chart und Orderleiter setzen beide voraus, dass Sie angemeldet sind und Marktdaten eintreffen." },
    { type: "heading",text: "Charts und SuperDOM in Tradovate Mobile laden: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Das Menü öffnen", html: "Tippen Sie oben links auf das Hamburger-Symbol mit den drei Balken. Das öffnet das Optionsmenü, Ihren Ausgangspunkt für alles in der mobilen App, vom Kontowechsel bis zur Marktliste.", image: {"src":`${IMG}/tradovate-mobile-chart-dom-1.jpg`,"alt":"Tradovate-Mobile-App mit hervorgehobenem Hamburger-Menüsymbol (drei Balken) oben links"} },
        { title: "Markets öffnen und einen Kontrakt wählen", html: "Tippen Sie auf <strong class='text-white'>Markets</strong>. Sie erhalten die vollständige Liste der Futures-Kontrakte nach Kategorien gruppiert, sodass Aktienindizes, Energie, Metalle und der Rest jeweils in einem eigenen Abschnitt stehen. Scrollen Sie zu Ihrem Produkt und tippen Sie auf den konkreten Kontrakt, etwa den Frontmonat von ES oder NQ, um ihn zu laden. Handeln Sie ein Prop- oder Evaluierungskonto? Welche Kontrakte Sie aufrufen können und ob die Daten live oder verzögert sind, hängt von Ihrer Firma und Ihrem Plan ab. Prüfen Sie daher die aktuellen Regeln Ihrer Firma, falls ein Symbol gesperrt wirkt oder die Kurse veraltet aussehen.", image: {"src":`${IMG}/tradovate-mobile-chart-dom-2.jpg`,"alt":"Tradovate-Mobile-Bildschirm Markets mit einer nach Kategorien sortierten Liste von Futures-Kontrakten"} },
        { title: "Auf Vollbild erweitern", html: "Tippen Sie bei geöffnetem Kontrakt auf das <strong class='text-white'>Erweitern</strong>-Symbol, das wie vier nach außen in die Ecken zeigende Pfeile aussieht. Damit füllt die Ansicht den gesamten Bildschirm. Drehen Sie Ihr Smartphone jetzt ins Querformat. Chart und Orderleiter bekommen in dieser Ausrichtung deutlich mehr Platz, was bei Preisniveaus auf einem kleinen Display wichtig ist.", image: {"src":`${IMG}/tradovate-mobile-chart-dom-3.jpg`,"alt":"Tradovate-Mobile-Vollbildansicht mit hervorgehobenem Erweitern-Symbol aus vier Pfeilen"} },
        { title: "Zwischen Chart und SuperDOM wechseln", html: "Suchen Sie die dünne senkrechte Linie, die über den erweiterten Bildschirm verläuft. Sie ist der Trenner zwischen dem Chart auf der einen und dem SuperDOM auf der anderen Seite. Halten Sie die kleine <strong class='text-white'>Kerbe</strong> nahe dem oberen Ende dieser Linie gedrückt und ziehen Sie sie nach links oder rechts. In die eine Richtung füllt der Chart mehr vom Bildschirm, in die andere übernimmt die SuperDOM-Orderleiter. Stellen Sie sie in die Mitte, sehen Sie beides nebeneinander, was die meisten wollen, um das Tape zu lesen und dabei den Chart im Blick zu behalten.", image: {"src":`${IMG}/tradovate-mobile-chart-dom-4.jpg`,"alt":"Tradovate-Mobile-Vollansicht mit der senkrechten Trennerkerbe zwischen Chart und SuperDOM"} },
      ],
    },
    { type: "heading",text: "Arbeiten in der Side-by-Side-Ansicht" },
    { type: "paragraph",html: "Sobald beide geladen sind, verhält sich die mobile App weitgehend wie der Desktop. Sie können Orders und Brackets direkt von der Orderleiter oder vom Chart aus platzieren und verwalten, und die mobilen Charts bieten dieselbe Bibliothek mit über 40 integrierten Indikatoren." },
    { type: "paragraph",html: "Wenn ein Chart leer lädt oder die Kurse einfrieren, gehen Sie zurück zur Markets-Liste und öffnen den Kontrakt erneut oder schließen und starten die App neu. Das erzwingt in der Regel eine Neuverbindung des Datenfeeds. Anhaltende Ausfälle deuten auf ein Problem mit dem Daten-Abonnement oder der Verbindung hin, nicht auf die App selbst." },
    { type: "heading",text: "Automatisieren Sie das mit PickMyTrade" },
    { type: "paragraph",html: "Haben Sie genug davon, jeden Trade per Fingertipp auf dem Smartphone auszulösen? <strong class='text-white'>PickMyTrade automatisiert Ihre Tradovate-Orders</strong>, sodass Ihre TradingView-Signale freihändig direkt an Ihr Konto weitergeleitet werden." },
    { type: "paragraph",html: "Das ist der gesamte Ablauf. Menü, Markets, Kontrakt wählen, erweitern und dann die Kerbe ziehen. Die einzige gedankliche Umstellung: Betrachten Sie Chart und SuperDOM als zwei Hälften eines einzigen Bildschirms, zwischen denen Sie gleiten, und nicht als zwei Fenster, die Sie jonglieren. Bezeichnungen und Symbole ändern sich zwischen App-Updates. Wenn also etwas verschoben wurde, suchen Sie nach derselben Funktion statt nach der hier beschriebenen genauen Wortwahl." },
  ], es: [
    { type: "paragraph",html: "La app móvil de Tradovate comprime en la pantalla de un teléfono el mismo gráfico de precios y la misma escalera de órdenes que usa en el escritorio. Lo que más confunde a la mayoría es que el gráfico y el SuperDOM no viven aquí en dos ventanas separadas. Comparten una vista expandible y se alterna entre ellos con un único divisor. Cuando lo sabe, cargar ambos para cualquier contrato lleva bastante menos de un minuto." },
    { type: "paragraph",html: "Aquí tiene la guía completa, desde tocar el menú hasta tener el diseño lado a lado terminado." },
    { type: "quote",html: "<strong class='text-white'>Antes de empezar:</strong> Instale la app desde la App Store o Google Play e inicie sesión. Tanto los gráficos como la escalera requieren que haya iniciado sesión y que lleguen datos de mercado." },
    { type: "heading",text: "Cargar gráficos y SuperDOM en Tradovate móvil: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra el menú", html: "Toque el icono de hamburguesa de tres barras en la esquina superior izquierda. Eso abre el menú de Opciones, su punto de partida para todo en el móvil, desde cambiar de cuenta hasta la lista de mercados.", image: {"src":`${IMG}/tradovate-mobile-chart-dom-1.jpg`,"alt":"App móvil de Tradovate con el icono de menú de hamburguesa de tres barras resaltado en la esquina superior izquierda"} },
        { title: "Abra Markets y elija un contrato", html: "Toque <strong class='text-white'>Markets</strong>. Obtendrá la lista completa de contratos de futuros agrupados por categoría, de modo que índices bursátiles, energía, metales y el resto aparecen cada uno en su propia sección. Desplácese hasta el producto que opera y toque el contrato concreto, por ejemplo el ES o el NQ del mes frontal, para cargarlo. ¿Opera una cuenta de prop firm o de evaluación? Los contratos a los que puede acceder y si los datos son en vivo o con retraso dependen de su firma y de su plan, así que consulte las reglas vigentes de su firma si un símbolo aparece bloqueado o las cotizaciones parecen desactualizadas.", image: {"src":`${IMG}/tradovate-mobile-chart-dom-2.jpg`,"alt":"Pantalla Markets de Tradovate móvil con la lista de contratos de futuros ordenada por categoría"} },
        { title: "Expanda a pantalla completa", html: "Con el contrato abierto, toque el icono <strong class='text-white'>expandir</strong>, el que parece cuatro flechas apuntando hacia las esquinas. Eso agranda la vista hasta ocupar toda la pantalla. Gire el teléfono a horizontal mientras está aquí. El gráfico y la escalera ganan mucho espacio en esa orientación, lo que importa cuando observa niveles de precio en una pantalla pequeña.", image: {"src":`${IMG}/tradovate-mobile-chart-dom-3.jpg`,"alt":"Vista expandida a pantalla completa de Tradovate móvil con el icono de expandir de cuatro flechas resaltado"} },
        { title: "Deslice entre el gráfico y el SuperDOM", html: "Busque la fina línea vertical que recorre la pantalla expandida. Es el divisor entre el gráfico a un lado y el SuperDOM al otro. Mantenga pulsada la pequeña <strong class='text-white'>muesca</strong> cerca de la parte superior de esa línea y arrástrela a izquierda o derecha. Si la arrastra en un sentido, el gráfico ocupa más pantalla; en el otro, la escalera del SuperDOM toma el control. Déjela en el centro y tendrá ambos lado a lado, que es lo que la mayoría quiere para leer la cinta mientras vigila el gráfico.", image: {"src":`${IMG}/tradovate-mobile-chart-dom-4.jpg`,"alt":"Vista expandida de Tradovate móvil con la muesca del divisor vertical entre el gráfico y el SuperDOM"} },
      ],
    },
    { type: "heading",text: "Trabajar en la vista lado a lado" },
    { type: "paragraph",html: "Una vez cargados ambos, la app móvil se comporta de forma muy parecida al escritorio. Puede colocar y gestionar órdenes y brackets directamente desde la escalera o el gráfico, y los gráficos móviles incluyen la misma biblioteca de más de 40 indicadores integrados." },
    { type: "paragraph",html: "Si un gráfico carga en blanco o las cotizaciones se congelan, vuelva a la lista de Markets y reabra el contrato, o cierre y reinicie la app. Eso suele forzar la reconexión del flujo de datos. Los cortes persistentes apuntan a un problema de suscripción de datos o de conexión, no de la app en sí." },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "¿Cansado de tocar el teléfono para lanzar cada operación? <strong class='text-white'>PickMyTrade automatiza sus órdenes de Tradovate</strong> para que sus señales de TradingView lleguen directamente a su cuenta, sin intervención manual." },
    { type: "paragraph",html: "Ese es todo el flujo. Menú, Markets, elegir un contrato, expandir y luego arrastrar la muesca. El único cambio mental es tratar el gráfico y el SuperDOM como dos mitades de una sola pantalla entre las que se desliza, no como dos ventanas que hay que manejar. Las etiquetas y los iconos cambian entre actualizaciones de la app, así que, si algo se ha movido, busque la misma función en lugar de la redacción exacta descrita aquí." },
  ], fr: [
    { type: "paragraph",html: "L’application mobile Tradovate condense sur l’écran d’un téléphone le même graphique de prix et la même échelle d’ordres que sur ordinateur. Ce qui déroute la plupart des gens, c’est que le graphique et le SuperDOM ne se trouvent pas ici dans deux fenêtres distinctes. Ils partagent une seule vue extensible, et vous passez de l’un à l’autre avec un simple séparateur. Une fois que vous le savez, charger les deux pour n’importe quel contrat prend bien moins d’une minute." },
    { type: "paragraph",html: "Voici le guide complet, du toucher sur le menu jusqu’à l’affichage côte à côte terminé." },
    { type: "quote",html: "<strong class='text-white'>Avant de commencer :</strong> installez l’application depuis l’App Store ou Google Play et connectez-vous. Le graphique comme l’échelle nécessitent que vous soyez connecté et que les données de marché arrivent." },
    { type: "heading",text: "Charger les graphiques et le SuperDOM sur Tradovate mobile : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez le menu", html: "Touchez l’icône hamburger à trois barres dans le coin supérieur gauche. Cela ouvre le menu Options, votre point de départ pour tout sur mobile, du changement de compte à la liste des marchés.", image: {"src":`${IMG}/tradovate-mobile-chart-dom-1.jpg`,"alt":"Application mobile Tradovate avec l’icône de menu hamburger à trois barres mise en évidence dans le coin supérieur gauche"} },
        { title: "Ouvrez Markets et choisissez un contrat", html: "Touchez <strong class='text-white'>Markets</strong>. Vous obtenez la liste complète des contrats à terme regroupés par catégorie : indices actions, énergie, métaux et le reste ont chacun leur propre section. Faites défiler jusqu’au produit que vous tradez, puis touchez le contrat précis, par exemple l’ES ou le NQ du mois en cours, pour le charger. Vous tradez un compte prop ou d’évaluation ? Les contrats accessibles et le caractère temps réel ou différé des données dépendent de votre firme et de votre formule ; vérifiez donc les règles actuelles de votre firme si un symbole semble verrouillé ou si les cotations paraissent périmées.", image: {"src":`${IMG}/tradovate-mobile-chart-dom-2.jpg`,"alt":"Écran Markets de Tradovate mobile listant les contrats à terme classés par catégorie"} },
        { title: "Passez en plein écran", html: "Une fois le contrat ouvert, touchez l’icône <strong class='text-white'>agrandir</strong>, celle qui ressemble à quatre flèches pointant vers les coins. La vue s’étend alors à tout l’écran. Faites pivoter votre téléphone en mode paysage à ce moment-là. Le graphique et l’échelle y gagnent beaucoup d’espace, ce qui compte lorsque vous surveillez des niveaux de prix sur un petit écran.", image: {"src":`${IMG}/tradovate-mobile-chart-dom-3.jpg`,"alt":"Vue Tradovate mobile en plein écran avec l’icône d’agrandissement à quatre flèches mise en évidence"} },
        { title: "Faites glisser entre le graphique et le SuperDOM", html: "Repérez la fine ligne verticale qui traverse l’écran agrandi. C’est votre séparateur entre le graphique d’un côté et le SuperDOM de l’autre. Maintenez appuyée la petite <strong class='text-white'>encoche</strong> près du haut de cette ligne, puis faites-la glisser vers la gauche ou la droite. Dans un sens, le graphique occupe davantage d’écran ; dans l’autre, c’est l’échelle du SuperDOM qui prend le dessus. Placez-la au milieu et vous obtenez les deux côte à côte, ce que la plupart des gens recherchent pour lire le tape tout en surveillant le graphique.", image: {"src":`${IMG}/tradovate-mobile-chart-dom-4.jpg`,"alt":"Vue agrandie de Tradovate mobile montrant l’encoche du séparateur vertical entre le graphique et le SuperDOM"} },
      ],
    },
    { type: "heading",text: "Travailler en affichage côte à côte" },
    { type: "paragraph",html: "Une fois les deux chargés, l’application mobile se comporte à peu près comme la version ordinateur. Vous pouvez passer et gérer des ordres et des brackets directement depuis l’échelle ou le graphique, et les graphiques mobiles offrent la même bibliothèque de plus de 40 indicateurs intégrés." },
    { type: "paragraph",html: "Si un graphique se charge à vide ou si les cotations se figent, revenez à la liste Markets et rouvrez le contrat, ou fermez puis relancez l’application. Cela force généralement la reconnexion du flux de données. Des coupures persistantes indiquent un problème d’abonnement aux données ou de connexion plutôt qu’un problème de l’application elle-même." },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Vous en avez assez de taper sur votre téléphone pour déclencher chaque trade ? <strong class='text-white'>PickMyTrade automatise vos ordres Tradovate</strong> afin que vos signaux TradingView soient acheminés directement vers votre compte, sans intervention manuelle." },
    { type: "paragraph",html: "Voilà tout le déroulé. Menu, Markets, choisir un contrat, agrandir, puis faire glisser l’encoche. Le seul changement d’état d’esprit consiste à considérer le graphique et le SuperDOM comme les deux moitiés d’un même écran entre lesquelles vous glissez, et non comme deux fenêtres à jongler. Les libellés et les icônes changent d’une mise à jour à l’autre ; si quelque chose a bougé, cherchez la même fonction plutôt que la formulation exacte décrite ici." },
  ], it: [
    { type: "paragraph",html: "L’app mobile di Tradovate racchiude nello schermo di un telefono lo stesso grafico dei prezzi e la stessa scaletta degli ordini che usa sul desktop. Ciò che confonde la maggior parte delle persone è che il grafico e il SuperDOM qui non stanno in due finestre separate. Condividono un’unica vista espandibile e si passa dall’uno all’altro con un solo divisore. Una volta capito questo, caricare entrambi per qualsiasi contratto richiede ben meno di un minuto." },
    { type: "paragraph",html: "Ecco la guida completa, dal tocco sul menu fino al layout affiancato finito." },
    { type: "quote",html: "<strong class='text-white'>Prima di iniziare:</strong> installi l’app dall’App Store o da Google Play e acceda. Sia i grafici sia la scaletta richiedono che lei sia connesso e che i dati di mercato arrivino." },
    { type: "heading",text: "Caricare grafici e SuperDOM su Tradovate mobile: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Apra il menu", html: "Tocchi l’icona hamburger a tre barre nell’angolo in alto a sinistra. Si apre il menu Opzioni, il suo punto di partenza per tutto sul mobile, dal cambio di conto alla lista dei mercati.", image: {"src":`${IMG}/tradovate-mobile-chart-dom-1.jpg`,"alt":"App mobile di Tradovate con l’icona del menu hamburger a tre barre evidenziata nell’angolo in alto a sinistra"} },
        { title: "Apra Markets e scelga un contratto", html: "Tocchi <strong class='text-white'>Markets</strong>. Otterrà l’elenco completo dei contratti futures raggruppati per categoria, così indici azionari, energia, metalli e il resto stanno ciascuno nella propria sezione. Scorra fino al prodotto che negozia e tocchi il contratto specifico, ad esempio l’ES o l’NQ del mese front, per caricarlo. Opera su un conto prop o di valutazione? I contratti a cui può accedere e il fatto che i dati siano in tempo reale o ritardati dipendono dalla sua società e dal suo piano, quindi controlli le regole attuali della sua società se un simbolo appare bloccato o le quotazioni sembrano obsolete.", image: {"src":`${IMG}/tradovate-mobile-chart-dom-2.jpg`,"alt":"Schermata Markets di Tradovate mobile con l’elenco dei contratti futures ordinati per categoria"} },
        { title: "Espanda a schermo intero", html: "Con il contratto aperto, tocchi l’icona <strong class='text-white'>espandi</strong>, quella che sembra quattro frecce rivolte verso gli angoli. La vista si ingrandisce fino a riempire lo schermo. Ruoti il telefono in orizzontale mentre è qui. Grafico e scaletta hanno molto più spazio in quell’orientamento, e questo conta quando osserva i livelli di prezzo su uno schermo piccolo.", image: {"src":`${IMG}/tradovate-mobile-chart-dom-3.jpg`,"alt":"Vista a schermo intero di Tradovate mobile con l’icona espandi a quattro frecce evidenziata"} },
        { title: "Scorra tra grafico e SuperDOM", html: "Cerchi la sottile linea verticale che attraversa lo schermo espanso. È il divisore tra il grafico da un lato e il SuperDOM dall’altro. Tenga premuta la piccola <strong class='text-white'>tacca</strong> vicino alla parte superiore di quella linea e la trascini a sinistra o a destra. Trascinando in un senso il grafico occupa più schermo; nell’altro prende il sopravvento la scaletta del SuperDOM. La lasci al centro e avrà entrambi affiancati, che è ciò che la maggior parte delle persone desidera per leggere il tape tenendo d’occhio il grafico.", image: {"src":`${IMG}/tradovate-mobile-chart-dom-4.jpg`,"alt":"Vista espansa di Tradovate mobile con la tacca del divisore verticale tra il grafico e il SuperDOM"} },
      ],
    },
    { type: "heading",text: "Lavorare nella vista affiancata" },
    { type: "paragraph",html: "Una volta caricati entrambi, l’app mobile si comporta in modo molto simile al desktop. Può inserire e gestire ordini e bracket direttamente dalla scaletta o dal grafico, e i grafici mobili offrono la stessa libreria di oltre 40 indicatori integrati." },
    { type: "paragraph",html: "Se un grafico si carica vuoto o le quotazioni si bloccano, torni alla lista Markets e riapra il contratto, oppure chiuda e riavvii l’app. Di solito questo forza la riconnessione del flusso di dati. Interruzioni persistenti indicano un problema di abbonamento ai dati o di connessione, non dell’app in sé." },
    { type: "heading",text: "Automatizzi tutto questo con PickMyTrade" },
    { type: "paragraph",html: "Stanco di toccare il telefono per eseguire ogni trade? <strong class='text-white'>PickMyTrade automatizza i suoi ordini Tradovate</strong> così i suoi segnali di TradingView vengono instradati direttamente al suo conto, senza interventi manuali." },
    { type: "paragraph",html: "Questo è l’intero flusso. Menu, Markets, scegliere un contratto, espandere, poi trascinare la tacca. L’unico cambio di mentalità è considerare grafico e SuperDOM come due metà di un’unica schermata tra cui si scorre, non come due finestre da gestire. Etichette e icone cambiano tra un aggiornamento dell’app e l’altro, quindi se qualcosa si è spostato, cerchi la stessa funzione anziché la formulazione esatta descritta qui." },
  ] },
  ctaHeading: { en: "Read the Tape, Automate the Trade", de: "Lesen Sie das Tape, automatisieren Sie den Trade", es: "Lea la cinta, automatice la operación", fr: "Lisez le tape, automatisez le trade", it: "Legga il tape, automatizzi il trade" },
