---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-change-plan";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Upgrade or Change Your Tradovate Account Plan";
const META_DESCRIPTION =
  "Upgrade or change your Tradovate account plan in the Web Trader to cut per-contract commissions, and learn how to downgrade or cancel a plan.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Upgraden oder ändern Sie Ihren Tradovate-Kontoplan", es: "Actualice o cambie el plan de su cuenta de Tradovate", fr: "Passez à un autre plan ou modifiez votre plan de compte Tradovate", it: "Passi a un piano superiore o cambi il piano del Suo conto Tradovate" },
  dek: { en: "If you're trading Tradovate more than you used to, your account plan is probably costing you money in commissions you don't need to pay. Here's exactly where to click, how to pay, and how to change your mind later.", de: "Wenn Sie häufiger über Tradovate handeln als früher, zahlen Sie mit Ihrem Kontoplan wahrscheinlich Provisionen, die Sie gar nicht zahlen müssten. Hier erfahren Sie genau, wo Sie klicken, wie Sie bezahlen und wie Sie später wieder wechseln.", es: "Si opera en Tradovate más que antes, es probable que el plan de su cuenta le esté costando dinero en comisiones que no necesita pagar. Aquí le explicamos exactamente dónde hacer clic, cómo pagar y cómo cambiar de opinión más adelante.", fr: "Si vous tradez sur Tradovate plus qu’auparavant, votre plan de compte vous coûte probablement des commissions que vous n’avez pas besoin de payer. Voici exactement où cliquer, comment payer et comment changer d’avis plus tard.", it: "Se opera su Tradovate più di prima, il piano del Suo conto probabilmente Le costa commissioni che non ha bisogno di pagare. Ecco esattamente dove cliccare, come pagare e come ripensarci in seguito." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "If you're trading Tradovate more than you used to, your account plan is probably costing you money in commissions you don't need to pay. Moving up a tier drops your per-contract rate, and the whole thing takes about two minutes inside the Web Trader. Here's exactly where to click, how to pay, and how to change your mind later if a paid plan stops earning its keep." },
    { type: "heading", text: "What Changing Your Plan Actually Does" },
    { type: "paragraph", html: "Your Tradovate account plan sets the commission you pay per side on every futures contract. Every account starts on the Free plan. Step up to <strong class='text-white'>Monthly</strong> or <strong class='text-white'>Lifetime</strong> and that per-side rate drops, Lifetime the furthest. You're not changing your login, your positions, or your data; you're just swapping which commission schedule applies. Here's the quick shape of it (prices shift, so confirm the live numbers before you pay):" },
    {
      type: "table",
      headers: ["Plan", "Cost", "Commissions"],
      rows: [
        ["Free", "$0 / month", "Highest per-side rate"],
        ["Monthly", "$99 / month", "Lower per-side rate"],
        ["Lifetime", "$1,499 one-time (or 4 × $499)", "Lowest per-side rate"],
      ],
    },
    { type: "heading", text: "Before You Start" },
    { type: "paragraph", html: "One thing trips people up: you can't change plans without a live Tradovate brokerage account. A simulated or demo-only login won't show the upgrade option, and neither will a prop-firm evaluation account, those run under the firm's own arrangement, so plan changes don't apply there. If you're on a personal live account that's open and funded, you're good to go." },
    { type: "heading", text: "How to Change Your Plan, Step by Step" },
    {
      type: "steps",
      items: [
        { title: "Confirm You Have a Live, Funded Account", html: "Log in and check that you're on your live account, not the demo. The Free plan can trade live perfectly well, so being on Free is fine, you just need a real brokerage account behind it for the upgrade screen to appear." },
        { title: "Open Application Settings › Subscriptions", html: "In the Tradovate Web Trader, click the <strong class='text-white'>Application Settings</strong> button in the top-right corner. When the settings page opens, select the <strong class='text-white'>Subscriptions</strong> tab along the top, depending on your build it may read <strong class='text-white'>Plans</strong>. That's where your current membership lives." },
        { title: "Click Upgrade and Choose Your Plan", html: "Find the <strong class='text-white'>Membership</strong> section and click <strong class='text-white'>Upgrade</strong>. Pick the plan you want, Monthly or Lifetime. Going Lifetime but want to spread the cost? Toggle the <strong class='text-white'>4 Payments</strong> option on <em>before</em> you continue, and you'll be billed in four installments instead of one lump sum." },
        { title: "Confirm and Pay", html: "Click <strong class='text-white'>Upgrade</strong> at the bottom of the screen to confirm. You can pay from your current account balance or with a credit or debit card. Once the payment clears, the new plan is active on your account." },
        { title: "Log Out and Back In to Confirm", html: "Log out of the Web Trader and sign back in. Head to <strong class='text-white'>Settings › Plans</strong> and you should see your new tier listed. If it still shows the old plan, give it a minute and refresh, the switch only reflects after a fresh login." },
      ],
    },
    { type: "heading", text: "How to Downgrade or Cancel a Paid Plan" },
    { type: "paragraph", html: "Trading dried up for a while? You're not locked in. To drop a Monthly plan, cancel the renewal from the <strong class='text-white'>Settings › Plans</strong> page in your account dashboard. It isn't instant, you keep the paid rate through the billing period you've already paid for, then the account rolls back to Free and stops charging you. Lifetime is a one-time purchase, so there's nothing to cancel. One catch on the way down: back on Free, an inactivity fee can apply if you go too long without a live trade." },
    { type: "heading", text: "Why Bother Changing Plans" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Lower your commissions</strong>, as your volume climbs, a paid tier's cheaper per-side rate can more than cover its fixed fee.",
        "<strong class='text-white'>Match the cost to your trading</strong>, quiet month? Free avoids a subscription you're not using. Busy month? Monthly or Lifetime pays off.",
        "<strong class='text-white'>Lock in the floor</strong>, Lifetime fixes the lowest rate once, which suits high-frequency and automated traders.",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Whatever plan you land on, the commissions only matter if your trades actually fire. <strong class='text-white'>PickMyTrade routes your TradingView alerts straight to Tradovate and executes them for you</strong>, no manual clicks, no missed entries, so your strategy runs the same way on every tier." },
  ], de: [
    { type: "paragraph",html: "Wenn Sie häufiger über Tradovate handeln als früher, zahlen Sie mit Ihrem Kontoplan wahrscheinlich Provisionen, die Sie gar nicht zahlen müssten. Mit einer höheren Stufe sinkt Ihr Satz pro Kontrakt, und das Ganze dauert im Web Trader etwa zwei Minuten. Hier erfahren Sie genau, wo Sie klicken, wie Sie bezahlen und wie Sie später wieder zurückwechseln, falls sich ein kostenpflichtiger Plan nicht mehr lohnt." },
    { type: "heading",text: "Was eine Planänderung tatsächlich bewirkt" },
    { type: "paragraph",html: "Ihr Tradovate-Kontoplan legt die Provision fest, die Sie pro Seite für jeden Futures-Kontrakt zahlen. Jedes Konto startet im Plan Free. Wechseln Sie zu <strong class='text-white'>Monthly</strong> oder <strong class='text-white'>Lifetime</strong>, sinkt dieser Satz pro Seite, bei Lifetime am stärksten. Ihr Login, Ihre Positionen und Ihre Daten ändern sich nicht; Sie tauschen lediglich aus, welcher Provisionsplan gilt. Hier ein kurzer Überblick (Preise ändern sich, prüfen Sie die aktuellen Zahlen vor der Zahlung):" },
    { type: "table", headers: ["Plan","Kosten","Provisionen"], rows: [
      ["Free","$0 / Monat","Höchster Satz pro Seite"],
      ["Monthly","$99 / Monat","Niedrigerer Satz pro Seite"],
      ["Lifetime","$1,499 einmalig (oder 4 × $499)","Niedrigster Satz pro Seite"],
    ] },
    { type: "heading",text: "Bevor Sie beginnen" },
    { type: "paragraph",html: "Eines bringt viele ins Stolpern: Ohne ein echtes Tradovate-Brokerage-Konto können Sie den Plan nicht ändern. Ein simulierter oder reiner Demo-Login zeigt die Upgrade-Option nicht an, ebenso wenig ein Prop-Firm-Evaluation-Konto. Diese laufen unter der Vereinbarung der jeweiligen Firma, sodass Planänderungen dort nicht gelten. Wenn Sie ein offenes, finanziertes persönliches Live-Konto haben, kann es losgehen." },
    { type: "heading",text: "So ändern Sie Ihren Plan, Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Live-Konto mit Guthaben bestätigen", html: "Melden Sie sich an und prüfen Sie, dass Sie sich in Ihrem Live-Konto befinden, nicht im Demo-Konto. Der Plan Free kann problemlos live handeln, Free ist also völlig in Ordnung. Damit der Upgrade-Bildschirm erscheint, benötigen Sie jedoch ein echtes Brokerage-Konto dahinter." },
        { title: "Application Settings › Subscriptions öffnen", html: "Klicken Sie im Tradovate Web Trader oben rechts auf die Schaltfläche <strong class='text-white'>Application Settings</strong>. Wenn die Einstellungsseite erscheint, wählen Sie oben den Tab <strong class='text-white'>Subscriptions</strong>; je nach Version heißt er möglicherweise <strong class='text-white'>Plans</strong>. Dort befindet sich Ihre aktuelle Mitgliedschaft." },
        { title: "Auf Upgrade klicken und Plan wählen", html: "Suchen Sie den Bereich <strong class='text-white'>Membership</strong> und klicken Sie auf <strong class='text-white'>Upgrade</strong>. Wählen Sie den gewünschten Plan, Monthly oder Lifetime. Möchten Sie Lifetime wählen, die Kosten aber verteilen? Aktivieren Sie die Option <strong class='text-white'>4 Payments</strong>, <em>bevor</em> Sie fortfahren, und Ihnen werden vier Raten statt einer Einmalzahlung berechnet." },
        { title: "Bestätigen und bezahlen", html: "Klicken Sie unten auf dem Bildschirm auf <strong class='text-white'>Upgrade</strong>, um zu bestätigen. Sie können vom aktuellen Guthaben Ihres Kontos oder per Kredit- oder Debitkarte zahlen. Sobald die Zahlung durchgeführt ist, ist der neue Plan für Ihr Konto aktiv." },
        { title: "Ab- und wieder anmelden zur Kontrolle", html: "Melden Sie sich vom Web Trader ab und wieder an. Öffnen Sie <strong class='text-white'>Settings › Plans</strong>, und Ihre neue Stufe sollte dort aufgeführt sein. Falls noch der alte Plan angezeigt wird, warten Sie eine Minute und aktualisieren Sie die Seite. Der Wechsel wird erst nach einer erneuten Anmeldung angezeigt." },
      ],
    },
    { type: "heading",text: "Downgrade oder Kündigung eines kostenpflichtigen Plans" },
    { type: "paragraph",html: "Der Handel ruhte eine Weile? Sie sind nicht gebunden. Um einen Monthly-Plan zu beenden, kündigen Sie die Verlängerung auf der Seite <strong class='text-white'>Settings › Plans</strong> in Ihrem Konto-Dashboard. Das geschieht nicht sofort: Sie behalten den bezahlten Satz für den bereits bezahlten Abrechnungszeitraum, danach fällt das Konto auf Free zurück und es wird nichts mehr berechnet. Lifetime ist ein einmaliger Kauf, daher gibt es nichts zu kündigen. Ein Haken beim Zurückstufen: Bei Free kann eine Inaktivitätsgebühr anfallen, wenn Sie zu lange keinen Live-Trade ausführen." },
    { type: "heading",text: "Warum ein Planwechsel sinnvoll ist" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Provisionen senken</strong>: Mit steigendem Volumen kann der günstigere Satz pro Seite einer kostenpflichtigen Stufe deren feste Gebühr mehr als ausgleichen.",
        "<strong class='text-white'>Kosten an Ihren Handel anpassen</strong>: Ruhiger Monat? Mit Free vermeiden Sie ein Abonnement, das Sie nicht nutzen. Reger Monat? Monthly oder Lifetime zahlt sich aus.",
        "<strong class='text-white'>Die Untergrenze sichern</strong>: Lifetime fixiert den niedrigsten Satz einmalig, was zu Hochfrequenz- und automatisierten Tradern passt.",
      ],
    },
    { type: "heading",text: "Mit PickMyTrade automatisieren" },
    { type: "paragraph",html: "Für welchen Plan Sie sich auch entscheiden: Die Provisionen zählen nur, wenn Ihre Trades tatsächlich ausgeführt werden. <strong class='text-white'>PickMyTrade leitet Ihre TradingView-Alerts direkt an Tradovate weiter und führt sie für Sie aus</strong>, ohne manuelle Klicks und ohne verpasste Einstiege, sodass Ihre Strategie auf jeder Stufe gleich läuft." },
  ], es: [
    { type: "paragraph",html: "Si opera en Tradovate más que antes, es probable que el plan de su cuenta le esté costando dinero en comisiones que no necesita pagar. Subir de nivel reduce su tarifa por contrato, y todo el proceso lleva unos dos minutos en el Web Trader. Aquí le explicamos exactamente dónde hacer clic, cómo pagar y cómo volver atrás más adelante si un plan de pago deja de compensarle." },
    { type: "heading",text: "Qué hace realmente el cambio de plan" },
    { type: "paragraph",html: "El plan de su cuenta de Tradovate fija la comisión que paga por lado en cada contrato de futuros. Todas las cuentas empiezan en el plan Free. Si pasa a <strong class='text-white'>Monthly</strong> o <strong class='text-white'>Lifetime</strong>, esa tarifa por lado baja, y Lifetime es la más baja. No cambia su acceso, sus posiciones ni sus datos; solo cambia qué esquema de comisiones se aplica. Este es el resumen (los precios varían, así que confirme las cifras actuales antes de pagar):" },
    { type: "table", headers: ["Plan","Costo","Comisiones"], rows: [
      ["Free","$0 / mes","Tarifa por lado más alta"],
      ["Monthly","$99 / mes","Tarifa por lado más baja"],
      ["Lifetime","$1,499 pago único (o 4 × $499)","Tarifa por lado más baja de todas"],
    ] },
    { type: "heading",text: "Antes de empezar" },
    { type: "paragraph",html: "Hay algo que confunde a mucha gente: no puede cambiar de plan sin una cuenta de corretaje real de Tradovate. Un acceso simulado o solo de demo no mostrará la opción de actualización, y tampoco una cuenta de evaluación de una prop firm, que funciona bajo el acuerdo propio de la firma, por lo que los cambios de plan no se aplican ahí. Si tiene una cuenta personal real abierta y fondeada, puede continuar." },
    { type: "heading",text: "Cómo cambiar su plan, paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Confirme que tiene una cuenta real fondeada", html: "Inicie sesión y compruebe que está en su cuenta real, no en la demo. El plan Free puede operar en real perfectamente, así que estar en Free no es problema; solo necesita una cuenta de corretaje real detrás para que aparezca la pantalla de actualización." },
        { title: "Abra Application Settings › Subscriptions", html: "En el Tradovate Web Trader, haga clic en el botón <strong class='text-white'>Application Settings</strong> de la esquina superior derecha. Cuando se abra la página de configuración, seleccione la pestaña <strong class='text-white'>Subscriptions</strong> en la parte superior; según su versión, puede llamarse <strong class='text-white'>Plans</strong>. Ahí se encuentra su membresía actual." },
        { title: "Haga clic en Upgrade y elija su plan", html: "Busque la sección <strong class='text-white'>Membership</strong> y haga clic en <strong class='text-white'>Upgrade</strong>. Elija el plan que desea, Monthly o Lifetime. ¿Quiere Lifetime pero repartir el costo? Active la opción <strong class='text-white'>4 Payments</strong> <em>antes</em> de continuar y se le facturará en cuatro cuotas en lugar de un único pago." },
        { title: "Confirme y pague", html: "Haga clic en <strong class='text-white'>Upgrade</strong> en la parte inferior de la pantalla para confirmar. Puede pagar con el saldo actual de su cuenta o con una tarjeta de crédito o débito. Una vez procesado el pago, el nuevo plan queda activo en su cuenta." },
        { title: "Cierre sesión y vuelva a entrar para confirmar", html: "Cierre sesión en el Web Trader y vuelva a iniciarla. Vaya a <strong class='text-white'>Settings › Plans</strong> y debería ver su nuevo nivel en la lista. Si todavía muestra el plan anterior, espere un minuto y actualice; el cambio solo se refleja tras iniciar sesión de nuevo." },
      ],
    },
    { type: "heading",text: "Cómo bajar de plan o cancelar un plan de pago" },
    { type: "paragraph",html: "¿Se redujo su actividad durante un tiempo? No está atado. Para dar de baja un plan Monthly, cancele la renovación desde la página <strong class='text-white'>Settings › Plans</strong> del panel de su cuenta. No es instantáneo: conserva la tarifa pagada durante el período de facturación que ya abonó, y después la cuenta vuelve a Free y deja de cobrársele. Lifetime es una compra única, por lo que no hay nada que cancelar. Un detalle al bajar de plan: de vuelta en Free, puede aplicarse una comisión por inactividad si pasa demasiado tiempo sin realizar una operación real." },
    { type: "heading",text: "Por qué vale la pena cambiar de plan" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Reducir sus comisiones</strong>: a medida que aumenta su volumen, la tarifa por lado más baja de un nivel de pago puede compensar con creces su cuota fija.",
        "<strong class='text-white'>Ajustar el costo a su trading</strong>: ¿un mes tranquilo? Con Free evita una suscripción que no usa. ¿Un mes intenso? Monthly o Lifetime compensan.",
        "<strong class='text-white'>Fijar el mínimo</strong>: Lifetime fija la tarifa más baja de una vez, lo que conviene a traders de alta frecuencia y automatizados.",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Sea cual sea el plan que elija, las comisiones solo importan si sus operaciones realmente se ejecutan. <strong class='text-white'>PickMyTrade envía sus alertas de TradingView directamente a Tradovate y las ejecuta por usted</strong>, sin clics manuales ni entradas perdidas, para que su estrategia funcione igual en cualquier nivel." },
  ], fr: [
    { type: "paragraph",html: "Si vous tradez sur Tradovate plus qu’auparavant, votre plan de compte vous coûte probablement des commissions que vous n’avez pas besoin de payer. Passer au palier supérieur réduit votre tarif par contrat, et l’opération prend environ deux minutes dans le Web Trader. Voici exactement où cliquer, comment payer et comment revenir en arrière plus tard si un plan payant ne justifie plus son coût." },
    { type: "heading",text: "Ce que change réellement un changement de plan" },
    { type: "paragraph",html: "Votre plan de compte Tradovate détermine la commission que vous payez par côté sur chaque contrat à terme. Tous les comptes démarrent sur le plan Free. Passez à <strong class='text-white'>Monthly</strong> ou <strong class='text-white'>Lifetime</strong> et ce tarif par côté baisse, Lifetime étant le plus bas. Vous ne modifiez ni votre identifiant, ni vos positions, ni vos données ; vous changez seulement le barème de commissions appliqué. Voici l’aperçu (les prix évoluent, confirmez donc les montants en vigueur avant de payer) :" },
    { type: "table", headers: ["Plan","Coût","Commissions"], rows: [
      ["Free","$0 / mois","Tarif par côté le plus élevé"],
      ["Monthly","$99 / mois","Tarif par côté plus bas"],
      ["Lifetime","$1,499 en une fois (ou 4 × $499)","Tarif par côté le plus bas"],
    ] },
    { type: "heading",text: "Avant de commencer" },
    { type: "paragraph",html: "Un point piège de nombreux traders : vous ne pouvez pas changer de plan sans un compte de courtage Tradovate réel. Un accès simulé ou uniquement démo n’affichera pas l’option de mise à niveau, pas plus qu’un compte d’évaluation de prop firm, qui fonctionne selon l’arrangement propre à la firme ; les changements de plan ne s’y appliquent donc pas. Si vous disposez d’un compte personnel réel, ouvert et approvisionné, vous êtes prêt." },
    { type: "heading",text: "Comment changer de plan, étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Vérifiez que vous avez un compte réel approvisionné", html: "Connectez-vous et vérifiez que vous êtes sur votre compte réel, et non sur la démo. Le plan Free permet très bien de trader en réel ; être sur Free n’est donc pas un problème, il faut simplement un vrai compte de courtage derrière pour que l’écran de mise à niveau apparaisse." },
        { title: "Ouvrez Application Settings › Subscriptions", html: "Dans le Tradovate Web Trader, cliquez sur le bouton <strong class='text-white'>Application Settings</strong> en haut à droite. Lorsque la page des paramètres s’ouvre, sélectionnez l’onglet <strong class='text-white'>Subscriptions</strong> en haut ; selon votre version, il peut s’intituler <strong class='text-white'>Plans</strong>. C’est là que se trouve votre abonnement actuel." },
        { title: "Cliquez sur Upgrade et choisissez votre plan", html: "Repérez la section <strong class='text-white'>Membership</strong> et cliquez sur <strong class='text-white'>Upgrade</strong>. Choisissez le plan souhaité, Monthly ou Lifetime. Vous voulez Lifetime mais répartir le coût ? Activez l’option <strong class='text-white'>4 Payments</strong> <em>avant</em> de continuer, et vous serez facturé en quatre versements au lieu d’une somme unique." },
        { title: "Confirmez et payez", html: "Cliquez sur <strong class='text-white'>Upgrade</strong> en bas de l’écran pour confirmer. Vous pouvez payer depuis le solde actuel de votre compte ou par carte de crédit ou de débit. Une fois le paiement validé, le nouveau plan est actif sur votre compte." },
        { title: "Déconnectez-vous et reconnectez-vous pour confirmer", html: "Déconnectez-vous du Web Trader, puis reconnectez-vous. Rendez-vous dans <strong class='text-white'>Settings › Plans</strong> et vous devriez voir votre nouveau palier. S’il affiche toujours l’ancien plan, patientez une minute et actualisez ; le changement ne se reflète qu’après une nouvelle connexion." },
      ],
    },
    { type: "heading",text: "Comment rétrograder ou annuler un plan payant" },
    { type: "paragraph",html: "Votre activité de trading a ralenti ? Vous n’êtes pas engagé. Pour abandonner un plan Monthly, annulez le renouvellement depuis la page <strong class='text-white'>Settings › Plans</strong> du tableau de bord de votre compte. Ce n’est pas immédiat : vous conservez le tarif payé jusqu’à la fin de la période de facturation déjà réglée, puis le compte repasse à Free et ne vous est plus facturé. Lifetime est un achat unique ; il n’y a donc rien à annuler. Un bémol en redescendant : de retour sur Free, des frais d’inactivité peuvent s’appliquer si vous restez trop longtemps sans trade réel." },
    { type: "heading",text: "Pourquoi changer de plan" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Réduire vos commissions</strong> : à mesure que votre volume augmente, le tarif par côté plus bas d’un palier payant peut largement compenser ses frais fixes.",
        "<strong class='text-white'>Adapter le coût à votre trading</strong> : un mois calme ? Free évite un abonnement que vous n’utilisez pas. Un mois chargé ? Monthly ou Lifetime est rentable.",
        "<strong class='text-white'>Verrouiller le plancher</strong> : Lifetime fixe le tarif le plus bas une fois pour toutes, ce qui convient aux traders haute fréquence et automatisés.",
      ],
    },
    { type: "heading",text: "Automatisez avec PickMyTrade" },
    { type: "paragraph",html: "Quel que soit le plan que vous choisissez, les commissions n’ont d’importance que si vos trades sont réellement exécutés. <strong class='text-white'>PickMyTrade achemine vos alertes TradingView directement vers Tradovate et les exécute pour vous</strong>, sans clic manuel ni entrée manquée, de sorte que votre stratégie fonctionne de la même manière à chaque palier." },
  ], it: [
    { type: "paragraph",html: "Se opera su Tradovate più di prima, il piano del Suo conto probabilmente Le costa commissioni che non ha bisogno di pagare. Passare a un livello superiore riduce la Sua tariffa per contratto, e l’intera operazione richiede circa due minuti nel Web Trader. Ecco esattamente dove cliccare, come pagare e come tornare indietro in seguito se un piano a pagamento smette di valere la spesa." },
    { type: "heading",text: "Cosa fa davvero il cambio di piano" },
    { type: "paragraph",html: "Il piano del Suo conto Tradovate stabilisce la commissione che paga per lato su ogni contratto future. Ogni conto parte dal piano Free. Passando a <strong class='text-white'>Monthly</strong> o <strong class='text-white'>Lifetime</strong>, quella tariffa per lato scende, con Lifetime che arriva più in basso. Non cambia il Suo accesso, le Sue posizioni né i Suoi dati; si sostituisce soltanto il tariffario di commissioni applicato. Ecco il quadro sintetico (i prezzi cambiano, quindi verifichi le cifre attuali prima di pagare):" },
    { type: "table", headers: ["Piano","Costo","Commissioni"], rows: [
      ["Free","$0 / mese","Tariffa per lato più alta"],
      ["Monthly","$99 / mese","Tariffa per lato inferiore"],
      ["Lifetime","$1,499 una tantum (o 4 × $499)","Tariffa per lato più bassa"],
    ] },
    { type: "heading",text: "Prima di iniziare" },
    { type: "paragraph",html: "C’è una cosa che trae spesso in inganno: non può cambiare piano senza un conto di intermediazione Tradovate reale. Un accesso simulato o solo demo non mostrerà l’opzione di upgrade, e nemmeno un conto di valutazione di una prop firm, che opera secondo l’accordo proprio della firm, per cui i cambi di piano non si applicano. Se ha un conto personale reale, aperto e finanziato, è tutto a posto." },
    { type: "heading",text: "Come cambiare piano, passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Verifichi di avere un conto reale finanziato", html: "Acceda e controlli di essere sul Suo conto reale, non sulla demo. Il piano Free può operare in reale senza problemi, quindi essere su Free va benissimo; Le serve solo un vero conto di intermediazione alle spalle perché compaia la schermata di upgrade." },
        { title: "Apra Application Settings › Subscriptions", html: "Nel Tradovate Web Trader, clicchi sul pulsante <strong class='text-white'>Application Settings</strong> nell’angolo in alto a destra. Quando si apre la pagina delle impostazioni, selezioni la scheda <strong class='text-white'>Subscriptions</strong> in alto; a seconda della versione potrebbe chiamarsi <strong class='text-white'>Plans</strong>. Qui si trova il Suo abbonamento attuale." },
        { title: "Clicchi su Upgrade e scelga il piano", html: "Trovi la sezione <strong class='text-white'>Membership</strong> e clicchi su <strong class='text-white'>Upgrade</strong>. Scelga il piano desiderato, Monthly o Lifetime. Vuole Lifetime ma preferisce dilazionare il costo? Attivi l’opzione <strong class='text-white'>4 Payments</strong> <em>prima</em> di continuare e Le verranno addebitate quattro rate anziché un’unica somma." },
        { title: "Confermi e paghi", html: "Clicchi su <strong class='text-white'>Upgrade</strong> in fondo alla schermata per confermare. Può pagare con il saldo attuale del conto o con carta di credito o di debito. Una volta completato il pagamento, il nuovo piano è attivo sul Suo conto." },
        { title: "Esca e riaccede per confermare", html: "Esca dal Web Trader e acceda di nuovo. Vada in <strong class='text-white'>Settings › Plans</strong> e dovrebbe vedere elencato il Suo nuovo livello. Se mostra ancora il vecchio piano, attenda un minuto e aggiorni; il passaggio si riflette solo dopo un nuovo accesso." },
      ],
    },
    { type: "heading",text: "Come effettuare il downgrade o annullare un piano a pagamento" },
    { type: "paragraph",html: "L’attività di trading si è ridotta per un periodo? Non è vincolato. Per abbandonare un piano Monthly, annulli il rinnovo dalla pagina <strong class='text-white'>Settings › Plans</strong> nella dashboard del Suo conto. Non è immediato: mantiene la tariffa pagata per il periodo di fatturazione già saldato, poi il conto torna a Free e non Le viene più addebitato nulla. Lifetime è un acquisto una tantum, quindi non c’è nulla da annullare. Un’avvertenza in discesa: tornando a Free, può essere applicata una commissione di inattività se resta troppo a lungo senza un trade reale." },
    { type: "heading",text: "Perché vale la pena cambiare piano" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Ridurre le commissioni</strong>: man mano che il volume cresce, la tariffa per lato inferiore di un livello a pagamento può più che compensarne la quota fissa.",
        "<strong class='text-white'>Adeguare il costo al Suo trading</strong>: mese tranquillo? Free evita un abbonamento che non usa. Mese intenso? Monthly o Lifetime ripagano.",
        "<strong class='text-white'>Bloccare il minimo</strong>: Lifetime fissa la tariffa più bassa una volta per tutte, ideale per trader ad alta frequenza e automatizzati.",
      ],
    },
    { type: "heading",text: "Automatizzi tutto con PickMyTrade" },
    { type: "paragraph",html: "Qualunque piano scelga, le commissioni contano solo se i Suoi trade vengono davvero eseguiti. <strong class='text-white'>PickMyTrade instrada i Suoi alert di TradingView direttamente a Tradovate e li esegue per Lei</strong>, senza clic manuali né ingressi persi, così la Sua strategia funziona allo stesso modo a ogni livello." },
  ] },
  ctaHeading: { en: "Automate Your Tradovate Trades", de: "Automatisieren Sie Ihre Tradovate-Trades", es: "Automatice sus operaciones en Tradovate", fr: "Automatisez vos trades Tradovate", it: "Automatizzi i Suoi trade su Tradovate" },
  ctaText: { en: "Whatever plan you land on, let PickMyTrade route your TradingView alerts straight to Tradovate and execute them for you, no manual clicks.", de: "Für welchen Plan Sie sich auch entscheiden: Lassen Sie PickMyTrade Ihre TradingView-Alerts direkt an Tradovate weiterleiten und für Sie ausführen, ganz ohne manuelle Klicks.", es: "Sea cual sea el plan que elija, deje que PickMyTrade envíe sus alertas de TradingView directamente a Tradovate y las ejecute por usted, sin clics manuales.", fr: "Quel que soit le plan que vous choisissez, laissez PickMyTrade acheminer vos alertes TradingView directement vers Tradovate et les exécuter pour vous, sans clic manuel.", it: "Qualunque piano scelga, lasci che PickMyTrade instradi i Suoi alert di TradingView direttamente a Tradovate e li esegua per Lei, senza clic manuali." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Can I change my Tradovate plan without a live account?", a: "No. The upgrade option only appears on a live, funded Tradovate brokerage account. Demo-only logins and prop-firm evaluation accounts don't show it." },
    { q: "How do I pay for the new plan?", a: "At the confirmation step you can pay from your current Tradovate account balance or with a credit or debit card. Lifetime can be split into four installments if you toggle the 4 Payments option before confirming." },
    { q: "When does a downgrade take effect?", a: "When you cancel a Monthly plan, you keep the paid commission rate until the end of the current billing period. After that the account reverts to Free and you're no longer charged the monthly fee." },
    { q: "Why isn't my new plan showing up?", a: "The change only appears after a fresh login. Log out of the Web Trader, sign back in, and check the Settings › Plans page again." },
  ], de: [
    { q: "Kann ich meinen Tradovate-Plan ohne Live-Konto ändern?", a: "Nein. Die Upgrade-Option erscheint nur bei einem echten, finanzierten Tradovate-Brokerage-Konto. Reine Demo-Logins und Prop-Firm-Evaluation-Konten zeigen sie nicht an." },
    { q: "Wie bezahle ich den neuen Plan?", a: "Im Bestätigungsschritt können Sie vom aktuellen Guthaben Ihres Tradovate-Kontos oder per Kredit- oder Debitkarte zahlen. Lifetime lässt sich in vier Raten aufteilen, wenn Sie vor der Bestätigung die Option 4 Payments aktivieren." },
    { q: "Wann wird ein Downgrade wirksam?", a: "Wenn Sie einen Monthly-Plan kündigen, behalten Sie den bezahlten Provisionssatz bis zum Ende des laufenden Abrechnungszeitraums. Danach wechselt das Konto zurück zu Free, und die monatliche Gebühr wird nicht mehr berechnet." },
    { q: "Warum wird mein neuer Plan nicht angezeigt?", a: "Die Änderung erscheint erst nach einer erneuten Anmeldung. Melden Sie sich vom Web Trader ab, wieder an und prüfen Sie die Seite Settings › Plans noch einmal." },
  ], es: [
    { q: "¿Puedo cambiar mi plan de Tradovate sin una cuenta real?", a: "No. La opción de actualización solo aparece en una cuenta de corretaje de Tradovate real y fondeada. Los accesos solo de demo y las cuentas de evaluación de prop firms no la muestran." },
    { q: "¿Cómo pago el nuevo plan?", a: "En el paso de confirmación puede pagar con el saldo actual de su cuenta de Tradovate o con una tarjeta de crédito o débito. Lifetime puede dividirse en cuatro cuotas si activa la opción 4 Payments antes de confirmar." },
    { q: "¿Cuándo se aplica una rebaja de plan?", a: "Cuando cancela un plan Monthly, conserva la tarifa de comisión pagada hasta el final del período de facturación actual. Después, la cuenta vuelve a Free y ya no se le cobra la cuota mensual." },
    { q: "¿Por qué no aparece mi nuevo plan?", a: "El cambio solo aparece después de iniciar sesión de nuevo. Cierre sesión en el Web Trader, vuelva a iniciarla y revise de nuevo la página Settings › Plans." },
  ], fr: [
    { q: "Puis-je changer mon plan Tradovate sans compte réel ?", a: "Non. L’option de mise à niveau n’apparaît que sur un compte de courtage Tradovate réel et approvisionné. Les accès uniquement démo et les comptes d’évaluation de prop firms ne l’affichent pas." },
    { q: "Comment payer le nouveau plan ?", a: "À l’étape de confirmation, vous pouvez payer depuis le solde actuel de votre compte Tradovate ou par carte de crédit ou de débit. Lifetime peut être réglé en quatre versements si vous activez l’option 4 Payments avant de confirmer." },
    { q: "Quand une rétrogradation prend-elle effet ?", a: "Lorsque vous annulez un plan Monthly, vous conservez le taux de commission payé jusqu’à la fin de la période de facturation en cours. Ensuite, le compte revient à Free et les frais mensuels ne vous sont plus facturés." },
    { q: "Pourquoi mon nouveau plan n’apparaît-il pas ?", a: "Le changement n’apparaît qu’après une nouvelle connexion. Déconnectez-vous du Web Trader, reconnectez-vous et consultez de nouveau la page Settings › Plans." },
  ], it: [
    { q: "Posso cambiare il mio piano Tradovate senza un conto reale?", a: "No. L’opzione di upgrade compare solo su un conto di intermediazione Tradovate reale e finanziato. Gli accessi solo demo e i conti di valutazione delle prop firm non la mostrano." },
    { q: "Come pago il nuovo piano?", a: "Nel passaggio di conferma può pagare con il saldo attuale del Suo conto Tradovate o con carta di credito o di debito. Lifetime può essere suddiviso in quattro rate se attiva l’opzione 4 Payments prima di confermare." },
    { q: "Quando diventa effettivo un downgrade?", a: "Quando annulla un piano Monthly, mantiene la tariffa di commissione pagata fino alla fine del periodo di fatturazione in corso. Dopodiché il conto torna a Free e non Le viene più addebitata la quota mensile." },
    { q: "Perché il mio nuovo piano non compare?", a: "La modifica compare solo dopo un nuovo accesso. Esca dal Web Trader, acceda di nuovo e controlli ancora la pagina Settings › Plans." },
  ] },
  relatedHeading: { en: "Related Guides", de: "Verwandte Leitfäden", es: "Guías relacionadas", fr: "Guides associés", it: "Guide correlate" },
  disclosureText: { en: `This guide is for educational and informational purposes only and is not financial, investment, or trading advice. Trading futures and other leveraged products carries a substantial risk of loss and is not suitable for every investor. PickMyTrade is an independent third-party automation platform and is not affiliated with, endorsed by, or sponsored by Tradovate, Inc. "Tradovate" and all related names, logos, and trademarks are the property of their respective owners. Platform features and steps change over time, so always confirm the current process in the official Tradovate platform and documentation before acting.`, de: "Dieser Leitfaden dient ausschließlich Bildungs- und Informationszwecken und stellt keine Finanz-, Anlage- oder Handelsberatung dar. Der Handel mit Futures und anderen gehebelten Produkten birgt ein erhebliches Verlustrisiko und ist nicht für jeden Anleger geeignet. PickMyTrade ist eine unabhängige Automatisierungsplattform eines Drittanbieters und steht in keiner Verbindung zu Tradovate, Inc., wird weder von Tradovate, Inc. unterstützt noch gesponsert. „Tradovate“ und alle zugehörigen Namen, Logos und Marken sind Eigentum ihrer jeweiligen Inhaber. Plattformfunktionen und Schritte ändern sich im Laufe der Zeit. Prüfen Sie daher stets den aktuellen Ablauf in der offiziellen Tradovate-Plattform und -Dokumentation, bevor Sie handeln.", es: "Esta guía tiene fines exclusivamente educativos e informativos y no constituye asesoramiento financiero, de inversión ni de trading. Operar con futuros y otros productos apalancados conlleva un riesgo sustancial de pérdida y no es adecuado para todos los inversores. PickMyTrade es una plataforma de automatización independiente de terceros y no está afiliada, respaldada ni patrocinada por Tradovate, Inc. «Tradovate» y todos los nombres, logotipos y marcas relacionados son propiedad de sus respectivos titulares. Las funciones de la plataforma y los pasos cambian con el tiempo, por lo que siempre debe confirmar el proceso vigente en la plataforma y la documentación oficiales de Tradovate antes de actuar.", fr: "Ce guide est fourni à des fins exclusivement éducatives et informatives et ne constitue ni un conseil financier, ni un conseil en investissement, ni un conseil de trading. La négociation de contrats à terme et d’autres produits à effet de levier comporte un risque de perte important et ne convient pas à tous les investisseurs. PickMyTrade est une plateforme d’automatisation tierce indépendante et n’est ni affiliée à Tradovate, Inc., ni approuvée, ni parrainée par celle-ci. « Tradovate » et tous les noms, logos et marques associés sont la propriété de leurs détenteurs respectifs. Les fonctionnalités de la plateforme et les étapes évoluent avec le temps ; vérifiez donc toujours la procédure en vigueur dans la plateforme et la documentation officielles de Tradovate avant d’agir.", it: "Questa guida ha esclusivamente finalità educative e informative e non costituisce consulenza finanziaria, di investimento o di trading. Il trading di futures e di altri prodotti a leva comporta un rischio sostanziale di perdita e non è adatto a tutti gli investitori. PickMyTrade è una piattaforma di automazione indipendente di terze parti e non è affiliata, approvata né sponsorizzata da Tradovate, Inc. «Tradovate» e tutti i nomi, loghi e marchi correlati sono di proprietà dei rispettivi titolari. Le funzionalità della piattaforma e i passaggi cambiano nel tempo, pertanto verifichi sempre la procedura attuale nella piattaforma e nella documentazione ufficiali di Tradovate prima di agire." },
};
const data: GuideArticleData = resolveGuideContent(content, locale, related);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: data.faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}${withSlash(localizedPath(locale))}` },
    { "@type": "ListItem", position: 2, name: "How-To", item: `${SITE_URL}${withSlash(localizedPath(locale, "how-to"))}` },
    { "@type": "ListItem", position: 3, name: content.h1[locale], item: `${SITE_URL}${withSlash(localizedPath(locale, `how-to/${SLUG}`))}` },
  ],
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: content.h1[locale],
  description: content.dek[locale],
  image: `${SITE_URL}/assets/og-default.webp`,
  publisher: { "@type": "Organization", name: "PickMyTrade", logo: { "@type": "ImageObject", url: `${SITE_URL}/assets/logo.png` } },
  datePublished: "2026-07-08",
  dateModified: "2026-07-08",
  mainEntityOfPage: { "@type": "WebPage", "@id": `${SITE_URL}${withSlash(localizedPath(locale, `how-to/${SLUG}`))}` },
};
---

<BaseLayout
  locale={locale}
