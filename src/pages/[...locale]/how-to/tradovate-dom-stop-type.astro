---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-dom-stop-type";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Change the Default DOM Stop Type in Tradovate";
const META_DESCRIPTION =
  "Change your SuperDOM's default stop order type so every stop you place defaults to stop-market or stop-limit, using the ladder's gear menu.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Standard-Stopp-Typ im Tradovate-DOM ändern", es: "Cambiar el tipo de stop predeterminado del DOM en Tradovate", fr: "Modifier le type de stop par défaut du DOM dans Tradovate", it: "Modificare il tipo di stop predefinito del DOM in Tradovate" },
  dek: { en: "Need every stop you place on the SuperDOM to default to stop-market or stop-limit? Here's how to change the ladder's default stop type from the gear menu, plus which one to pick and why.", de: "Sollen alle Stopps, die Sie im SuperDOM platzieren, standardmäßig als Stop-Market oder Stop-Limit angelegt werden? So ändern Sie den Standard-Stopp-Typ der Leiter über das Zahnradmenü – und welcher Typ wann sinnvoll ist.", es: "¿Desea que todos los stops que coloca en el SuperDOM sean por defecto stop de mercado o stop limitado? Así se cambia el tipo de stop predeterminado de la escalera desde el menú del engranaje, y cuál elegir y por qué.", fr: "Vous souhaitez que chaque stop placé sur le SuperDOM soit par défaut un stop au marché ou un stop limite ? Voici comment modifier le type de stop par défaut de l'échelle depuis le menu en forme d'engrenage, et lequel choisir selon votre situation.", it: "Desidera che ogni stop che inserisce sul SuperDOM sia per impostazione predefinita uno stop di mercato o uno stop limite? Ecco come cambiare il tipo di stop predefinito della scala dal menu a ingranaggio, e quale scegliere e perché." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-10",
  blocks: { en: [
    { type: "paragraph", html: "When you drop a stop on the SuperDOM ladder, Tradovate uses a default stop order type, out of the box, a stop-market. That's the right pick for most people, but if you scalp thin contracts or you'd rather cap slippage than guarantee a fill, you'll want your stops going in as stop-limits instead. Rather than switch the type on every order, set the ladder's default once from the gear menu. Here's how, plus a quick rundown of what each type does so you pick the right one." },
    { type: "heading", text: "Stop-Market vs. Stop-Limit: What You're Choosing Between" },
    { type: "paragraph", html: "A stop order sits dormant until price touches your trigger, then it fires. The stop <em>type</em> decides what it fires <strong class='text-white'>into</strong>. That single choice is the difference between always getting out and getting a better price, so it's worth understanding before you set it as your default." },
    {
      type: "table",
      headers: ["Stop type", "What it triggers", "Trade-off"],
      rows: [
        ["Stop Market", "A market order the instant your trigger price is hit.", "Virtually guaranteed to fill, but in a fast spike you take whatever price liquidity gives you."],
        ["Stop Limit", "A limit order at a second price you set once the trigger is hit.", "Caps your worst fill, but price can run past your limit and leave the order unfilled."],
        ["Trailing Stop", "A stop that follows price in your favor, then fires a market order when it reverses.", "Locks in gains hands-free, with the same fill-guaranteed, slippage-exposed behavior as a stop-market."],
        ["Trailing Stop Limit", "The same trailing behavior, but it fires a limit order instead of a market order.", "Follows price and caps slippage, but carries the same no-fill risk as any stop-limit."],
      ],
    },
    { type: "paragraph", html: "Short version: a stop-market prioritizes <em>getting out</em>, a stop-limit prioritizes <em>price</em>. If your stop is there to protect the account, most traders leave the default on stop-market so a violent move can't strand them in a losing position." },
    { type: "heading", text: "How to Change the Default Stop Type: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open the SuperDOM for Your Contract", html: "Open the <strong class='text-white'>SuperDOM</strong> module and load the contract you actually trade, ES, NQ, CL, whatever you're on. The price ladder needs to be on screen, because the stop-type default lives in that ladder's own settings, not in a global preferences panel." },
        { title: "Open the SuperDOM Settings from the Gear Icon", html: "Look to the <strong class='text-white'>top-right corner of the SuperDOM</strong> and click the <strong class='text-white'>gear icon</strong>. That opens the settings menu for that specific ladder, where the order-entry defaults, quantity, stop type, and the rest, are configured. If you have several DOMs open, each one carries its own settings, so make sure you're on the ladder you mean to change." },
        { title: "Choose Your Default Stop Type", html: "In the settings menu, find <strong class='text-white'>Stop Type</strong> and open it. You'll get the four options from the table above: <strong class='text-white'>Stop Market</strong>, <strong class='text-white'>Stop Limit</strong>, <strong class='text-white'>Trailing Stop</strong>, and <strong class='text-white'>Trailing Stop Limit</strong>. Pick the one you want as your default and it sticks, from now on, stops you place on this ladder go in as that type without you touching the order ticket each time. Wording shifts a little between platform updates, so if you don't see \"Stop Type\" spelled out exactly, look for the stop or order-type setting in the same menu." },
        { title: "Test It on the Ladder", html: "Don't take it on faith, prove it. Stage a stop on the ladder (use the sim account if you're mid-session on a live one) and check the order ticket. It should read your chosen type. One caveat: a fresh DOM you open later may not inherit this setting, so glance at the stop type on any new ladder before you trade it. Two seconds of checking beats finding a stop-limit sat unfilled while price ran away." },
      ],
    },
    { type: "heading", text: "Which Default Should You Use?" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Trading liquid index futures (ES, NQ) for protection?</strong> Stop-market is the safe default, you'll always be out.",
        "<strong class='text-white'>Scalping thinner or more volatile contracts?</strong> A stop-limit keeps a bad tick from filling you at a runaway price, as long as you accept the occasional missed fill.",
        "<strong class='text-white'>Want the exit to move with the trade?</strong> Set a trailing type so profit locks in without you dragging the line yourself.",
        "<strong class='text-white'>On a prop-firm evaluation?</strong> Firms differ on which order types and stop distances they allow, check your firm's current rules before you make stop-limit your default, since a no-fill can blow a drawdown limit.",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Picking a default is great until a signal fires while you're away from the desk. <strong class='text-white'>PickMyTrade routes your TradingView alerts straight into Tradovate and attaches the stop type, distance, and target you've defined</strong>, every entry lands with a stop already in place, no ladder clicks required." },
  ], de: [
    { type: "paragraph",html: "Wenn Sie im SuperDOM-Leiter einen Stopp setzen, verwendet Tradovate einen Standard-Stopp-Ordertyp – ab Werk einen Stop-Market. Für die meisten ist das die richtige Wahl. Wenn Sie jedoch dünne Kontrakte scalpen oder lieber die Slippage begrenzen, als einen Fill zu garantieren, sollten Ihre Stopps als Stop-Limits angelegt werden. Statt den Typ bei jeder Order umzustellen, legen Sie den Standard der Leiter einmalig im Zahnradmenü fest. So geht's – plus ein kurzer Überblick, was jeder Typ bewirkt, damit Sie den passenden wählen." },
    { type: "heading",text: "Stop-Market vs. Stop-Limit: Zwischen diesen Optionen wählen Sie" },
    { type: "paragraph",html: "Eine Stop-Order bleibt inaktiv, bis der Kurs Ihren Trigger berührt, und wird dann ausgelöst. Der Stopp-<em>Typ</em> bestimmt, <strong class='text-white'>was</strong> dabei ausgelöst wird. Diese eine Entscheidung macht den Unterschied zwischen „immer raus“ und „besserer Preis“, daher lohnt es sich, sie zu verstehen, bevor Sie sie als Standard festlegen." },
    { type: "table", headers: ["Stopp-Typ","Was ausgelöst wird","Abwägung"], rows: [
      ["Stop Market","Eine Market-Order in dem Moment, in dem Ihr Trigger-Preis erreicht wird.","Praktisch garantiert ausgeführt, aber bei einer schnellen Spitze erhalten Sie den Preis, den die Liquidität gerade hergibt."],
      ["Stop Limit","Eine Limit-Order zu einem zweiten Preis, den Sie festlegen, sobald der Trigger erreicht ist.","Begrenzt Ihren schlechtesten Fill, aber der Kurs kann über Ihr Limit hinauslaufen und die Order unausgeführt lassen."],
      ["Trailing Stop","Ein Stopp, der dem Kurs zu Ihren Gunsten folgt und bei einer Umkehr eine Market-Order auslöst.","Sichert Gewinne automatisch, mit demselben garantierten Fill und derselben Slippage-Anfälligkeit wie ein Stop-Market."],
      ["Trailing Stop Limit","Dasselbe Trailing-Verhalten, löst aber eine Limit-Order statt einer Market-Order aus.","Folgt dem Kurs und begrenzt die Slippage, birgt aber dasselbe Risiko eines ausbleibenden Fills wie jedes Stop-Limit."],
    ] },
    { type: "paragraph",html: "Kurzfassung: Ein Stop-Market priorisiert das <em>Herauskommen</em>, ein Stop-Limit den <em>Preis</em>. Wenn Ihr Stopp das Konto schützen soll, belassen die meisten Trader den Standard bei Stop-Market, damit eine heftige Bewegung sie nicht in einer Verlustposition festhält." },
    { type: "heading",text: "So ändern Sie den Standard-Stopp-Typ: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Öffnen Sie das SuperDOM für Ihren Kontrakt", html: "Öffnen Sie das Modul <strong class='text-white'>SuperDOM</strong> und laden Sie den Kontrakt, den Sie tatsächlich handeln – ES, NQ, CL, was auch immer. Die Preisleiter muss auf dem Bildschirm sein, denn der Standard für den Stopp-Typ befindet sich in den eigenen Einstellungen dieser Leiter, nicht in einem globalen Einstellungsfenster." },
        { title: "Öffnen Sie die SuperDOM-Einstellungen über das Zahnradsymbol", html: "Suchen Sie die <strong class='text-white'>obere rechte Ecke des SuperDOM</strong> und klicken Sie auf das <strong class='text-white'>Zahnradsymbol</strong>. Damit öffnet sich das Einstellungsmenü genau dieser Leiter, in dem die Standardwerte für die Ordereingabe – Menge, Stopp-Typ und mehr – konfiguriert werden. Wenn mehrere DOMs geöffnet sind, hat jedes seine eigenen Einstellungen. Achten Sie also darauf, dass Sie sich auf der richtigen Leiter befinden." },
        { title: "Wählen Sie Ihren Standard-Stopp-Typ", html: "Suchen Sie im Einstellungsmenü <strong class='text-white'>Stop Type</strong> und öffnen Sie es. Sie sehen die vier Optionen aus der Tabelle oben: <strong class='text-white'>Stop Market</strong>, <strong class='text-white'>Stop Limit</strong>, <strong class='text-white'>Trailing Stop</strong> und <strong class='text-white'>Trailing Stop Limit</strong>. Wählen Sie Ihren Standard aus, und er bleibt erhalten: Ab jetzt werden Stopps, die Sie auf dieser Leiter platzieren, in diesem Typ angelegt, ohne dass Sie jedes Mal das Order-Ticket anfassen müssen. Die Bezeichnungen ändern sich zwischen Plattform-Updates leicht. Wenn Sie „Stop Type“ also nicht exakt so sehen, suchen Sie im selben Menü nach der Stopp- oder Ordertyp-Einstellung." },
        { title: "Testen Sie es auf der Leiter", html: "Verlassen Sie sich nicht blind darauf, sondern prüfen Sie es. Legen Sie einen Stopp auf der Leiter an (nutzen Sie das Sim-Konto, wenn Sie mitten in einer Live-Sitzung sind) und kontrollieren Sie das Order-Ticket. Es sollte Ihren gewählten Typ anzeigen. Eine Einschränkung: Ein später geöffnetes neues DOM übernimmt diese Einstellung möglicherweise nicht. Werfen Sie daher bei jeder neuen Leiter einen Blick auf den Stopp-Typ, bevor Sie handeln. Zwei Sekunden Kontrolle sind besser, als ein unausgeführtes Stop-Limit zu entdecken, während der Kurs davonläuft." },
      ],
    },
    { type: "heading",text: "Welchen Standard sollten Sie verwenden?" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Sie handeln liquide Index-Futures (ES, NQ) zum Schutz?</strong> Stop-Market ist der sichere Standard – Sie sind immer draußen.",
        "<strong class='text-white'>Sie scalpen dünnere oder volatilere Kontrakte?</strong> Ein Stop-Limit verhindert, dass ein schlechter Tick Sie zu einem davongelaufenen Preis ausführt – solange Sie gelegentlich einen verpassten Fill akzeptieren.",
        "<strong class='text-white'>Soll der Ausstieg mit dem Trade mitwandern?</strong> Setzen Sie einen Trailing-Typ, damit Gewinn gesichert wird, ohne dass Sie die Linie selbst nachziehen müssen.",
        "<strong class='text-white'>In einer Prop-Firm-Evaluation?</strong> Die Firmen unterscheiden sich darin, welche Ordertypen und Stopp-Abstände sie erlauben. Prüfen Sie die aktuellen Regeln Ihrer Firma, bevor Sie Stop-Limit zum Standard machen, denn ein ausbleibender Fill kann ein Drawdown-Limit sprengen.",
      ],
    },
    { type: "heading",text: "Automatisieren mit PickMyTrade" },
    { type: "paragraph",html: "Einen Standard zu wählen ist großartig – bis ein Signal ausgelöst wird, während Sie nicht am Schreibtisch sind. <strong class='text-white'>PickMyTrade leitet Ihre TradingView-Alerts direkt an Tradovate weiter und hängt den von Ihnen definierten Stopp-Typ, Abstand und das Ziel an</strong>: Jeder Einstieg landet mit bereits gesetztem Stopp, ganz ohne Klicks auf der Leiter." },
  ], es: [
    { type: "paragraph",html: "Cuando coloca un stop en la escalera del SuperDOM, Tradovate usa un tipo de orden stop predeterminado: de fábrica, un stop de mercado. Es la opción adecuada para la mayoría, pero si hace scalping en contratos con poca liquidez o prefiere limitar el deslizamiento antes que garantizar la ejecución, le conviene que sus stops entren como stops limitados. En lugar de cambiar el tipo en cada orden, establezca el valor predeterminado de la escalera una sola vez desde el menú del engranaje. Aquí le explicamos cómo, además de un repaso rápido de lo que hace cada tipo para que elija el adecuado." },
    { type: "heading",text: "Stop de mercado frente a stop limitado: lo que está eligiendo" },
    { type: "paragraph",html: "Una orden stop permanece inactiva hasta que el precio toca su disparador y entonces se activa. El <em>tipo</em> de stop decide <strong class='text-white'>en qué</strong> se convierte. Esa única decisión marca la diferencia entre salir siempre y obtener un mejor precio, así que conviene entenderla antes de fijarla como predeterminada." },
    { type: "table", headers: ["Tipo de stop","Qué activa","Compromiso"], rows: [
      ["Stop Market","Una orden de mercado en el instante en que se alcanza su precio de disparo.","Prácticamente garantizada su ejecución, pero en un pico rápido obtiene el precio que le dé la liquidez."],
      ["Stop Limit","Una orden limitada a un segundo precio que usted fija una vez alcanzado el disparador.","Limita su peor ejecución, pero el precio puede superar su límite y dejar la orden sin ejecutar."],
      ["Trailing Stop","Un stop que sigue al precio a su favor y lanza una orden de mercado cuando este se revierte.","Asegura beneficios sin intervención, con la misma ejecución garantizada y exposición al deslizamiento que un stop de mercado."],
      ["Trailing Stop Limit","El mismo comportamiento de seguimiento, pero lanza una orden limitada en lugar de una orden de mercado.","Sigue al precio y limita el deslizamiento, pero conlleva el mismo riesgo de no ejecución que cualquier stop limitado."],
    ] },
    { type: "paragraph",html: "En resumen: un stop de mercado prioriza <em>salir</em>, un stop limitado prioriza el <em>precio</em>. Si su stop está ahí para proteger la cuenta, la mayoría de los traders dejan el stop de mercado como predeterminado para que un movimiento violento no los deje atrapados en una posición perdedora." },
    { type: "heading",text: "Cómo cambiar el tipo de stop predeterminado: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra el SuperDOM de su contrato", html: "Abra el módulo <strong class='text-white'>SuperDOM</strong> y cargue el contrato que realmente opera: ES, NQ, CL, el que sea. La escalera de precios debe estar en pantalla, porque el valor predeterminado del tipo de stop reside en los ajustes propios de esa escalera, no en un panel de preferencias global." },
        { title: "Abra los ajustes del SuperDOM desde el icono del engranaje", html: "Busque la <strong class='text-white'>esquina superior derecha del SuperDOM</strong> y haga clic en el <strong class='text-white'>icono del engranaje</strong>. Se abre el menú de ajustes de esa escalera en concreto, donde se configuran los valores predeterminados de la entrada de órdenes: cantidad, tipo de stop y demás. Si tiene varios DOM abiertos, cada uno tiene sus propios ajustes, así que asegúrese de estar en la escalera que desea cambiar." },
        { title: "Elija su tipo de stop predeterminado", html: "En el menú de ajustes, busque <strong class='text-white'>Stop Type</strong> y ábralo. Verá las cuatro opciones de la tabla anterior: <strong class='text-white'>Stop Market</strong>, <strong class='text-white'>Stop Limit</strong>, <strong class='text-white'>Trailing Stop</strong> y <strong class='text-white'>Trailing Stop Limit</strong>. Elija la que desee como predeterminada y se mantiene: a partir de ahora, los stops que coloque en esta escalera entrarán con ese tipo sin que tenga que tocar el ticket de la orden cada vez. La redacción varía un poco entre actualizaciones de la plataforma, así que si no ve \"Stop Type\" escrito exactamente así, busque el ajuste de stop o de tipo de orden en el mismo menú." },
        { title: "Pruébelo en la escalera", html: "No lo dé por hecho, compruébelo. Prepare un stop en la escalera (use la cuenta de simulación si está en plena sesión en una cuenta real) y revise el ticket de la orden. Debe mostrar el tipo que eligió. Una salvedad: un DOM nuevo que abra más adelante puede no heredar este ajuste, así que eche un vistazo al tipo de stop en cualquier escalera nueva antes de operar. Dos segundos de comprobación valen más que descubrir un stop limitado sin ejecutar mientras el precio se aleja." },
      ],
    },
    { type: "heading",text: "¿Qué valor predeterminado debería usar?" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>¿Opera futuros de índices líquidos (ES, NQ) para protegerse?</strong> El stop de mercado es el valor predeterminado seguro: siempre estará fuera.",
        "<strong class='text-white'>¿Hace scalping en contratos menos líquidos o más volátiles?</strong> Un stop limitado evita que un tick malo le ejecute a un precio desbocado, siempre que acepte alguna ejecución perdida ocasional.",
        "<strong class='text-white'>¿Quiere que la salida se mueva con la operación?</strong> Establezca un tipo trailing para que el beneficio se asegure sin que tenga que arrastrar usted mismo la línea.",
        "<strong class='text-white'>¿En una evaluación de una prop firm?</strong> Las firmas difieren en los tipos de orden y las distancias de stop que permiten. Compruebe las reglas vigentes de su firma antes de fijar el stop limitado como predeterminado, ya que una no ejecución puede romper un límite de drawdown.",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Elegir un valor predeterminado está muy bien hasta que salta una señal cuando usted no está frente al ordenador. <strong class='text-white'>PickMyTrade envía sus alertas de TradingView directamente a Tradovate y adjunta el tipo de stop, la distancia y el objetivo que haya definido</strong>: cada entrada llega con un stop ya colocado, sin clics en la escalera." },
  ], fr: [
    { type: "paragraph",html: "Lorsque vous placez un stop sur l'échelle du SuperDOM, Tradovate utilise un type d'ordre stop par défaut : par défaut, un stop au marché. C'est le bon choix pour la plupart des traders, mais si vous faites du scalping sur des contrats peu liquides ou que vous préférez plafonner le slippage plutôt que garantir l'exécution, vous voudrez que vos stops soient envoyés comme stops limites. Plutôt que de changer le type à chaque ordre, définissez une seule fois la valeur par défaut de l'échelle depuis le menu en forme d'engrenage. Voici comment faire, avec un bref rappel de ce que fait chaque type pour choisir le bon." },
    { type: "heading",text: "Stop au marché ou stop limite : ce que vous choisissez" },
    { type: "paragraph",html: "Un ordre stop reste dormant jusqu'à ce que le prix touche votre seuil, puis il se déclenche. Le <em>type</em> de stop détermine <strong class='text-white'>en quoi</strong> il se déclenche. Ce seul choix fait la différence entre toujours sortir et obtenir un meilleur prix ; mieux vaut donc le comprendre avant d'en faire votre valeur par défaut." },
    { type: "table", headers: ["Type de stop","Ce qu'il déclenche","Compromis"], rows: [
      ["Stop Market","Un ordre au marché dès que votre prix de déclenchement est atteint.","Exécution pratiquement garantie, mais lors d'un pic rapide vous obtenez le prix que la liquidité vous offre."],
      ["Stop Limit","Un ordre à cours limité à un second prix que vous fixez, une fois le seuil atteint.","Plafonne votre pire exécution, mais le prix peut dépasser votre limite et laisser l'ordre non exécuté."],
      ["Trailing Stop","Un stop qui suit le prix en votre faveur, puis déclenche un ordre au marché lorsqu'il s'inverse.","Verrouille les gains sans intervention, avec la même exécution garantie et la même exposition au slippage qu'un stop au marché."],
      ["Trailing Stop Limit","Le même comportement de suivi, mais il déclenche un ordre à cours limité au lieu d'un ordre au marché.","Suit le prix et plafonne le slippage, mais comporte le même risque de non-exécution que tout stop limite."],
    ] },
    { type: "paragraph",html: "En résumé : un stop au marché privilégie la <em>sortie</em>, un stop limite privilégie le <em>prix</em>. Si votre stop est là pour protéger le compte, la plupart des traders laissent le stop au marché par défaut afin qu'un mouvement violent ne les piège pas dans une position perdante." },
    { type: "heading",text: "Comment modifier le type de stop par défaut : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez le SuperDOM de votre contrat", html: "Ouvrez le module <strong class='text-white'>SuperDOM</strong> et chargez le contrat que vous tradez réellement : ES, NQ, CL, peu importe. L'échelle de prix doit être affichée à l'écran, car la valeur par défaut du type de stop se trouve dans les paramètres propres à cette échelle, et non dans un panneau de préférences global." },
        { title: "Ouvrez les paramètres du SuperDOM via l'icône en forme d'engrenage", html: "Repérez le <strong class='text-white'>coin supérieur droit du SuperDOM</strong> et cliquez sur l'<strong class='text-white'>icône en forme d'engrenage</strong>. Cela ouvre le menu de paramètres de cette échelle précise, où sont configurés les paramètres par défaut de saisie d'ordres : quantité, type de stop, etc. Si plusieurs DOM sont ouverts, chacun a ses propres paramètres ; assurez-vous donc d'être sur l'échelle que vous souhaitez modifier." },
        { title: "Choisissez votre type de stop par défaut", html: "Dans le menu des paramètres, repérez <strong class='text-white'>Stop Type</strong> et ouvrez-le. Vous verrez les quatre options du tableau ci-dessus : <strong class='text-white'>Stop Market</strong>, <strong class='text-white'>Stop Limit</strong>, <strong class='text-white'>Trailing Stop</strong> et <strong class='text-white'>Trailing Stop Limit</strong>. Choisissez celle que vous voulez par défaut et elle est conservée : désormais, les stops que vous placez sur cette échelle seront envoyés avec ce type sans que vous ayez à toucher au ticket d'ordre à chaque fois. Le libellé varie légèrement d'une mise à jour de la plateforme à l'autre ; si vous ne voyez pas « Stop Type » écrit exactement ainsi, cherchez le paramètre de stop ou de type d'ordre dans le même menu." },
        { title: "Testez-le sur l'échelle", html: "Ne vous fiez pas aux apparences, vérifiez. Préparez un stop sur l'échelle (utilisez le compte de simulation si vous êtes en pleine séance sur un compte réel) et vérifiez le ticket d'ordre. Il doit afficher le type que vous avez choisi. Une réserve : un nouveau DOM ouvert plus tard peut ne pas hériter de ce paramètre ; jetez donc un œil au type de stop sur toute nouvelle échelle avant de trader. Deux secondes de vérification valent mieux que de découvrir un stop limite non exécuté pendant que le prix s'envole." },
      ],
    },
    { type: "heading",text: "Quelle valeur par défaut choisir ?" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Vous tradez des futures indiciels liquides (ES, NQ) pour vous protéger ?</strong> Le stop au marché est la valeur par défaut la plus sûre : vous sortirez toujours.",
