  ctaHeading: { en: "Turn Your Charting Platform Into Automation", de: "Machen Sie Ihre Charting-Plattform zur Automatisierung", es: "Convierta su plataforma de gráficos en automatización", fr: "Transformez votre plateforme de graphiques en automatisation", it: "Trasformi la Sua piattaforma di grafici in automazione" },
  ctaText: { en: "Connecting a charting platform still leaves you clicking every entry by hand. PickMyTrade takes your TradingView alerts and fires them straight into Tradovate, so your strategy trades itself.", de: "Eine angebundene Charting-Plattform lässt Sie weiterhin jeden Einstieg von Hand klicken. PickMyTrade nimmt Ihre TradingView-Alerts und schickt sie direkt an Tradovate, sodass Ihre Strategie von selbst handelt.", es: "Conectar una plataforma de gráficos le sigue dejando haciendo clic en cada entrada a mano. PickMyTrade toma sus alertas de TradingView y las envía directamente a Tradovate, para que su estrategia opere sola.", fr: "Connecter une plateforme de graphiques vous laisse encore cliquer chaque entrée à la main. PickMyTrade prend vos alertes TradingView et les envoie directement dans Tradovate, pour que votre stratégie trade toute seule.", it: "Collegare una piattaforma di grafici Le lascia comunque da cliccare ogni ingresso a mano. PickMyTrade prende i Suoi alert di TradingView e li invia direttamente a Tradovate, così la Sua strategia opera da sola." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Foire aux questions", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Does Tradovate Connect cost extra?", a: "Premium partner integrations don't add order-routing fees. A direct API connection needs Tradovate's API Access add-on, which carries a monthly fee plus a funded-account requirement, check the current numbers in your account settings before you sign up." },
    { q: "Can I connect Sierra Chart to Tradovate?", a: "Sierra Chart doesn't offer a simple native Tradovate broker connection the way NinjaTrader does. Whether you can route it comes down to what your specific account or prop firm supports, so check their current connection options before you rely on it." },
