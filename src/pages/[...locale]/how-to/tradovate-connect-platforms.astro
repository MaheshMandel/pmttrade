---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-connect-platforms";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Route Tradovate to NinjaTrader, Sierra & More";
const META_DESCRIPTION =
  "Connect Tradovate to NinjaTrader, Bookmap, Quantower and more charting platforms, see which route orders directly and how to switch on API access.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate mit NinjaTrader, Sierra & mehr verbinden", es: "Conecte Tradovate con NinjaTrader, Sierra y más", fr: "Routez Tradovate vers NinjaTrader, Sierra et plus", it: "Instradi Tradovate verso NinjaTrader, Sierra e altro" },
  dek: { en: "Prefer to chart in NinjaTrader, Bookmap, or Quantower but keep executing through Tradovate? Here's how Tradovate Connect wires the two together, step by step.", de: "Sie charten lieber in NinjaTrader, Bookmap oder Quantower, möchten aber weiter über Tradovate ausführen? So verbindet Tradovate Connect beides, Schritt für Schritt.", es: "¿Prefiere hacer gráficos en NinjaTrader, Bookmap o Quantower pero seguir ejecutando a través de Tradovate? Así las une Tradovate Connect, paso a paso.", fr: "Vous préférez faire vos graphiques dans NinjaTrader, Bookmap ou Quantower tout en exécutant via Tradovate ? Voici comment Tradovate Connect relie les deux, étape par étape.", it: "Preferisce fare i grafici in NinjaTrader, Bookmap o Quantower ma continuare a eseguire tramite Tradovate? Ecco come Tradovate Connect collega le due cose, passo dopo passo." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Prefer to chart in NinjaTrader, Bookmap, or Quantower but keep executing through your Tradovate account? Tradovate Connect is how you wire the two together, analysis and clicks happen in your front-end of choice, and the fill lands on the Tradovate side." },
    { type: "heading", text: "What Is Tradovate Connect?" },
    { type: "paragraph", html: "Tradovate Connect is the connection layer that lets outside charting and execution software route live orders through your Tradovate brokerage account. You do your analysis and click your entries in the other platform, and the order is filled and cleared on the Tradovate side. Put simply, Tradovate becomes the execution engine sitting behind whatever front-end you're fastest in." },
    { type: "heading", text: "Routing Tradovate to Other Platforms: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Check How Your Platform Connects", html: "Not every platform reaches Tradovate the same way, and getting this wrong is where most people stall. NinjaTrader, Bookmap, Quantower, and MotiveWave plug into Tradovate's API directly, you sign in with your Tradovate credentials. TradingView, Jigsaw, and Collective2 are premium partners you switch on from inside your account. Sierra Chart is the awkward one: there's no one-click native Tradovate connection for it, so whether and how you can route it depends on what your account or prop firm supports. Confirm that before you count on it." },
        { title: "Turn the Connection On in Your Tradovate Account", html: "Open your Tradovate account settings and find the add-ons and integrations area. Premium partners flip on with a single toggle and add no order-routing fees. For a direct API link, you'll buy the API Access add-on and then generate an API key, that path needs a funded live account and carries a monthly fee, so check the current price and the minimum balance before you commit. On a prop or evaluation account, your firm decides which platforms and whether API automation is allowed, so confirm your firm's current rules first." },
        { title: "Log In from Your Charting Platform", html: "Back in your charting software, open its connection or data-provider settings and pick Tradovate. Enter your Tradovate username and password, then choose the right environment, simulated for practice or an eval, live for a funded account. In NinjaTrader that means switching on Multi-Provider mode and adding a Tradovate connection; Bookmap and Quantower use a similar connect dialog. If NinjaTrader's setup looks different from an older guide you've seen, that's expected, its Tradovate hookup has changed, so follow the current connection method and run a recent build." },
        { title: "Send a Test Order and Confirm the Fill", html: "Before you trust it with real size, send one small order, a single ES or MNQ contract, from the charting platform and watch where it lands. The position, working orders, and P&amp;L should show up in your Tradovate account within a second or two. When the fill appears on both sides, your route is live and you can scale up. Keep this test on a simulated account so a mis-click can't cost you." },
      ],
    },
    { type: "table", headers: ["Platform", "How it reaches Tradovate"], rows: [
      ["NinjaTrader", "Direct Tradovate API (Multi-Provider mode)"],
      ["Bookmap / Quantower / MotiveWave", "Tradovate Connect (API)"],
      ["TradingView / Jigsaw / Collective2", "Premium partner, activate in your account"],
      ["Sierra Chart", "No native one-click link, confirm your account/firm's supported method"],
    ] },
    { type: "heading", text: "Why You'd Need This" },
    {
      type: "list",
      items: [
        "Chart with tools Tradovate doesn't ship, order-flow heatmaps, footprint charts, custom bar types.",
        "Keep one execution account behind several front-ends instead of juggling separate logins.",
        "Run a dedicated DOM or ladder in one app while you chart in another.",
        "Trade a funded or prop account through the platform your hands already know.",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Connecting a charting platform still leaves you clicking every entry by hand. <strong class='text-white'>PickMyTrade closes that gap</strong>, it takes your TradingView alerts and fires them straight into Tradovate, so your strategy trades itself while you watch the chart. No manual order tickets, no missed fills when you step away." },
  ], de: [
    { type: "paragraph",html: "Sie charten lieber in NinjaTrader, Bookmap oder Quantower, möchten aber weiter über Ihr Tradovate-Konto ausführen? Mit Tradovate Connect verbinden Sie beides: Analyse und Klicks passieren in Ihrem bevorzugten Frontend, und der Fill landet auf der Tradovate-Seite." },
    { type: "heading",text: "Was ist Tradovate Connect?" },
    { type: "paragraph",html: "Tradovate Connect ist die Verbindungsschicht, über die externe Charting- und Ausführungssoftware Live-Orders über Ihr Tradovate-Brokerage-Konto routen kann. Sie analysieren und klicken Ihre Einstiege in der anderen Plattform, und die Order wird auf der Tradovate-Seite ausgeführt und abgerechnet. Kurz gesagt: Tradovate wird zur Ausführungs-Engine hinter dem Frontend, mit dem Sie am schnellsten arbeiten." },
    { type: "heading",text: "Tradovate mit anderen Plattformen verbinden: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Prüfen, wie sich Ihre Plattform verbindet", html: "Nicht jede Plattform erreicht Tradovate auf demselben Weg, und hier bleiben die meisten hängen. NinjaTrader, Bookmap, Quantower und MotiveWave docken direkt an die API von Tradovate an, Sie melden sich mit Ihren Tradovate-Zugangsdaten an. TradingView, Jigsaw und Collective2 sind Premium-Partner, die Sie in Ihrem Konto aktivieren. Sierra Chart ist der Sonderfall: Es gibt keine native Tradovate-Verbindung auf Knopfdruck, ob und wie Sie es routen können, hängt also davon ab, was Ihr Konto oder Ihre Prop Firm unterstützt. Klären Sie das, bevor Sie damit rechnen." },
        { title: "Die Verbindung in Ihrem Tradovate-Konto aktivieren", html: "Öffnen Sie Ihre Tradovate-Kontoeinstellungen und suchen Sie den Bereich für Add-ons und Integrationen. Premium-Partner aktivieren Sie mit einem einzigen Schalter, und sie verursachen keine Order-Routing-Gebühren. Für eine direkte API-Anbindung kaufen Sie das Add-on API Access und erzeugen anschließend einen API-Schlüssel. Dieser Weg erfordert ein finanziertes Live-Konto und kostet eine monatliche Gebühr, prüfen Sie also den aktuellen Preis und das Mindestguthaben, bevor Sie sich festlegen. Bei einem Prop- oder Evaluierungskonto entscheidet Ihre Firma, welche Plattformen und ob API-Automatisierung erlaubt ist, klären Sie daher zuerst die aktuellen Regeln Ihrer Firma." },
        { title: "Aus Ihrer Charting-Plattform anmelden", html: "Öffnen Sie in Ihrer Charting-Software die Verbindungs- oder Datenanbieter-Einstellungen und wählen Sie Tradovate. Geben Sie Ihren Tradovate-Benutzernamen und Ihr Passwort ein und wählen Sie die richtige Umgebung: Simulation für Übungskonto oder Evaluierung, Live für ein Funded-Konto. In NinjaTrader bedeutet das, den Multi-Provider-Modus zu aktivieren und eine Tradovate-Verbindung hinzuzufügen. Bookmap und Quantower nutzen einen ähnlichen Verbindungsdialog. Sieht die Einrichtung in NinjaTrader anders aus als in einer älteren Anleitung, ist das normal: Die Tradovate-Anbindung hat sich geändert, folgen Sie also der aktuellen Verbindungsmethode und verwenden Sie einen aktuellen Build." },
        { title: "Eine Testorder senden und den Fill bestätigen", html: "Bevor Sie dem Setup echte Größe anvertrauen, senden Sie aus der Charting-Plattform eine kleine Order, einen einzelnen ES- oder MNQ-Kontrakt, und beobachten Sie, wo sie landet. Position, Working Orders und P&amp;L sollten innerhalb von ein bis zwei Sekunden in Ihrem Tradovate-Konto erscheinen. Wenn der Fill auf beiden Seiten auftaucht, ist Ihre Route live, und Sie können hochskalieren. Führen Sie diesen Test auf einem Simulationskonto durch, damit ein Fehlklick nichts kosten kann." },
      ],
    },
    { type: "table", headers: ["Plattform","So erreicht sie Tradovate"], rows: [
      ["NinjaTrader","Direkte Tradovate-API (Multi-Provider-Modus)"],
      ["Bookmap / Quantower / MotiveWave","Tradovate Connect (API)"],
      ["TradingView / Jigsaw / Collective2","Premium-Partner, in Ihrem Konto aktivieren"],
      ["Sierra Chart","Keine native Ein-Klick-Verbindung, klären Sie die unterstützte Methode Ihres Kontos bzw. Ihrer Firma"],
    ] },
    { type: "heading",text: "Warum Sie das brauchen" },
    {
      type: "list",
      items: [
        "Charten Sie mit Werkzeugen, die Tradovate nicht mitbringt: Order-Flow-Heatmaps, Footprint-Charts, benutzerdefinierte Bartypen.",
        "Betreiben Sie ein Ausführungskonto hinter mehreren Frontends, statt mit getrennten Logins zu jonglieren.",
        "Nutzen Sie in einer App ein dediziertes DOM oder eine Leiter, während Sie in einer anderen charten.",
        "Handeln Sie ein Funded- oder Prop-Konto über die Plattform, die Ihre Hände bereits kennen.",
      ],
    },
    { type: "heading",text: "Automatisieren Sie das mit PickMyTrade" },
    { type: "paragraph",html: "Eine angebundene Charting-Plattform lässt Sie weiterhin jeden Einstieg von Hand klicken. <strong class='text-white'>PickMyTrade schließt diese Lücke</strong>: Es nimmt Ihre TradingView-Alerts und schickt sie direkt an Tradovate, sodass Ihre Strategie von selbst handelt, während Sie den Chart beobachten. Keine manuellen Order-Tickets, keine verpassten Fills, wenn Sie sich entfernen." },
  ], es: [
    { type: "paragraph",html: "¿Prefiere hacer gráficos en NinjaTrader, Bookmap o Quantower pero seguir ejecutando a través de su cuenta de Tradovate? Tradovate Connect es la forma de unir ambas cosas: el análisis y los clics ocurren en el front-end que prefiera, y la ejecución se completa en el lado de Tradovate." },
    { type: "heading",text: "¿Qué es Tradovate Connect?" },
    { type: "paragraph",html: "Tradovate Connect es la capa de conexión que permite que software externo de gráficos y ejecución enrute órdenes en vivo a través de su cuenta de corretaje de Tradovate. Usted hace el análisis y hace clic en sus entradas en la otra plataforma, y la orden se ejecuta y compensa en el lado de Tradovate. En pocas palabras, Tradovate se convierte en el motor de ejecución detrás del front-end con el que usted sea más rápido." },
    { type: "heading",text: "Enrutar Tradovate a otras plataformas: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Compruebe cómo se conecta su plataforma", html: "No todas las plataformas llegan a Tradovate de la misma manera, y aquí es donde la mayoría se atasca. NinjaTrader, Bookmap, Quantower y MotiveWave se conectan directamente a la API de Tradovate: inicia sesión con sus credenciales de Tradovate. TradingView, Jigsaw y Collective2 son socios premium que se activan desde su cuenta. Sierra Chart es el caso incómodo: no hay una conexión nativa de Tradovate con un clic, así que que pueda enrutarlo y cómo depende de lo que admita su cuenta o su prop firm. Confírmelo antes de contar con ello." },
        { title: "Active la conexión en su cuenta de Tradovate", html: "Abra los ajustes de su cuenta de Tradovate y busque el área de complementos e integraciones. Los socios premium se activan con un solo interruptor y no añaden comisiones de enrutamiento de órdenes. Para un enlace directo por API, comprará el complemento API Access y luego generará una clave de API; esa vía requiere una cuenta real financiada y tiene una cuota mensual, así que consulte el precio actual y el saldo mínimo antes de comprometerse. En una cuenta de prop o de evaluación, su firma decide qué plataformas y si se permite la automatización por API, así que confirme primero las reglas vigentes de su firma." },
        { title: "Inicie sesión desde su plataforma de gráficos", html: "De vuelta en su software de gráficos, abra los ajustes de conexión o de proveedor de datos y elija Tradovate. Introduzca su usuario y contraseña de Tradovate y elija el entorno correcto: simulado para practicar o para una evaluación, real para una cuenta financiada. En NinjaTrader eso significa activar el modo Multi-Provider y añadir una conexión de Tradovate; Bookmap y Quantower usan un cuadro de conexión similar. Si la configuración de NinjaTrader se ve distinta a la de una guía antigua que haya visto, es normal: su conexión con Tradovate ha cambiado, así que siga el método de conexión actual y use una versión reciente." },
        { title: "Envíe una orden de prueba y confirme la ejecución", html: "Antes de confiarle tamaño real, envíe una orden pequeña, un solo contrato de ES o MNQ, desde la plataforma de gráficos y observe dónde aterriza. La posición, las órdenes pendientes y el P&amp;L deberían aparecer en su cuenta de Tradovate en un segundo o dos. Cuando la ejecución aparezca en ambos lados, su ruta está activa y puede aumentar el tamaño. Haga esta prueba en una cuenta simulada para que un clic erróneo no pueda costarle nada." },
      ],
    },
    { type: "table", headers: ["Plataforma","Cómo llega a Tradovate"], rows: [
      ["NinjaTrader","API directa de Tradovate (modo Multi-Provider)"],
      ["Bookmap / Quantower / MotiveWave","Tradovate Connect (API)"],
      ["TradingView / Jigsaw / Collective2","Socio premium, se activa en su cuenta"],
      ["Sierra Chart","Sin enlace nativo de un clic; confirme el método admitido por su cuenta o su firma"],
    ] },
    { type: "heading",text: "Por qué lo necesitaría" },
    {
      type: "list",
      items: [
        "Hacer gráficos con herramientas que Tradovate no incluye: mapas de calor de order flow, gráficos footprint, tipos de barra personalizados.",
        "Mantener una cuenta de ejecución detrás de varios front-ends en lugar de manejar inicios de sesión separados.",
        "Usar un DOM o escalera dedicado en una aplicación mientras hace gráficos en otra.",
        "Operar una cuenta financiada o de prop con la plataforma que sus manos ya conocen.",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Conectar una plataforma de gráficos le sigue dejando haciendo clic en cada entrada a mano. <strong class='text-white'>PickMyTrade cierra esa brecha</strong>: toma sus alertas de TradingView y las envía directamente a Tradovate, para que su estrategia opere sola mientras usted observa el gráfico. Sin tickets de orden manuales y sin ejecuciones perdidas cuando se aleja." },
  ], fr: [
    { type: "paragraph",html: "Vous préférez faire vos graphiques dans NinjaTrader, Bookmap ou Quantower tout en continuant d'exécuter via votre compte Tradovate ? Tradovate Connect est le moyen de relier les deux : l'analyse et les clics se font dans le front-end de votre choix, et l'exécution se réalise côté Tradovate." },
    { type: "heading",text: "Qu'est-ce que Tradovate Connect ?" },
    { type: "paragraph",html: "Tradovate Connect est la couche de connexion qui permet à des logiciels externes de graphiques et d'exécution de router des ordres en direct via votre compte de courtage Tradovate. Vous faites votre analyse et cliquez vos entrées dans l'autre plateforme, et l'ordre est exécuté et compensé côté Tradovate. En clair, Tradovate devient le moteur d'exécution derrière le front-end dans lequel vous êtes le plus rapide." },
    { type: "heading",text: "Router Tradovate vers d'autres plateformes : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Vérifiez comment votre plateforme se connecte", html: "Toutes les plateformes n'atteignent pas Tradovate de la même manière, et c'est là que la plupart des gens bloquent. NinjaTrader, Bookmap, Quantower et MotiveWave se branchent directement sur l'API de Tradovate : vous vous connectez avec vos identifiants Tradovate. TradingView, Jigsaw et Collective2 sont des partenaires premium que vous activez depuis votre compte. Sierra Chart est le cas délicat : il n'existe pas de connexion Tradovate native en un clic, donc la possibilité et la manière de le router dépendent de ce que prend en charge votre compte ou votre prop firm. Confirmez-le avant de compter dessus." },
        { title: "Activez la connexion dans votre compte Tradovate", html: "Ouvrez les paramètres de votre compte Tradovate et trouvez la zone des modules complémentaires et des intégrations. Les partenaires premium s'activent d'un simple interrupteur et n'ajoutent aucuns frais de routage d'ordres. Pour une liaison API directe, vous achèterez le module API Access puis générerez une clé API ; cette voie nécessite un compte réel financé et entraîne des frais mensuels, vérifiez donc le prix actuel et le solde minimum avant de vous engager. Sur un compte de prop ou d'évaluation, c'est votre firme qui décide des plateformes autorisées et si l'automatisation par API est permise ; confirmez donc d'abord les règles en vigueur de votre firme." },
        { title: "Connectez-vous depuis votre plateforme de graphiques", html: "De retour dans votre logiciel de graphiques, ouvrez ses paramètres de connexion ou de fournisseur de données et choisissez Tradovate. Saisissez votre nom d'utilisateur et votre mot de passe Tradovate, puis choisissez le bon environnement : simulé pour s'exercer ou pour une évaluation, réel pour un compte financé. Dans NinjaTrader, cela signifie activer le mode Multi-Provider et ajouter une connexion Tradovate ; Bookmap et Quantower utilisent une boîte de connexion similaire. Si la configuration de NinjaTrader diffère d'un ancien guide que vous avez vu, c'est normal : sa liaison avec Tradovate a changé, suivez donc la méthode de connexion actuelle et utilisez une version récente." },
        { title: "Envoyez un ordre de test et confirmez l'exécution", html: "Avant de lui confier une taille réelle, envoyez un petit ordre, un seul contrat ES ou MNQ, depuis la plateforme de graphiques et observez où il atterrit. La position, les ordres en attente et le P&amp;L doivent apparaître dans votre compte Tradovate en une seconde ou deux. Lorsque l'exécution apparaît des deux côtés, votre route est active et vous pouvez augmenter la taille. Faites ce test sur un compte simulé pour qu'un clic malheureux ne puisse rien vous coûter." },
      ],
    },
    { type: "table", headers: ["Plateforme","Comment elle atteint Tradovate"], rows: [
      ["NinjaTrader","API Tradovate directe (mode Multi-Provider)"],
      ["Bookmap / Quantower / MotiveWave","Tradovate Connect (API)"],
      ["TradingView / Jigsaw / Collective2","Partenaire premium, à activer dans votre compte"],
      ["Sierra Chart","Pas de liaison native en un clic ; confirmez la méthode prise en charge par votre compte ou votre firme"],
    ] },
    { type: "heading",text: "Pourquoi vous en avez besoin" },
    {
      type: "list",
      items: [
        "Faire vos graphiques avec des outils que Tradovate ne fournit pas : cartes thermiques d'order flow, graphiques footprint, types de barres personnalisés.",
        "Garder un seul compte d'exécution derrière plusieurs front-ends plutôt que de jongler avec des identifiants séparés.",
        "Utiliser un DOM ou une échelle dédiés dans une application pendant que vous faites vos graphiques dans une autre.",
        "Trader un compte financé ou de prop via la plateforme que vos mains connaissent déjà.",
      ],
    },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Connecter une plateforme de graphiques vous laisse encore cliquer chaque entrée à la main. <strong class='text-white'>PickMyTrade comble cet écart</strong> : il prend vos alertes TradingView et les envoie directement dans Tradovate, pour que votre stratégie trade toute seule pendant que vous regardez le graphique. Pas de tickets d'ordre manuels, pas d'exécutions manquées quand vous vous éloignez." },
  ], it: [
    { type: "paragraph",html: "Preferisce fare i grafici in NinjaTrader, Bookmap o Quantower ma continuare a eseguire tramite il Suo account Tradovate? Tradovate Connect è il modo per collegare le due cose: l'analisi e i clic avvengono nel front-end che preferisce, e l'esecuzione si realizza sul lato Tradovate." },
    { type: "heading",text: "Che cos'è Tradovate Connect?" },
    { type: "paragraph",html: "Tradovate Connect è il livello di connessione che consente a software esterni di grafici ed esecuzione di instradare ordini live attraverso il Suo conto di brokeraggio Tradovate. Lei fa l'analisi e clicca i Suoi ingressi nell'altra piattaforma, e l'ordine viene eseguito e compensato sul lato Tradovate. In parole semplici, Tradovate diventa il motore di esecuzione dietro qualunque front-end in cui Lei sia più veloce." },
    { type: "heading",text: "Instradare Tradovate verso altre piattaforme: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Verifichi come si connette la Sua piattaforma", html: "Non tutte le piattaforme raggiungono Tradovate nello stesso modo, ed è qui che la maggior parte delle persone si blocca. NinjaTrader, Bookmap, Quantower e MotiveWave si collegano direttamente all'API di Tradovate: accede con le Sue credenziali Tradovate. TradingView, Jigsaw e Collective2 sono partner premium che attiva dall'interno del Suo account. Sierra Chart è il caso scomodo: non esiste una connessione Tradovate nativa con un clic, quindi se e come può instradarlo dipende da ciò che supporta il Suo account o la Sua prop firm. Lo confermi prima di farci affidamento." },
        { title: "Attivi la connessione nel Suo account Tradovate", html: "Apra le impostazioni del Suo account Tradovate e trovi l'area di add-on e integrazioni. I partner premium si attivano con un singolo interruttore e non aggiungono commissioni di instradamento degli ordini. Per un collegamento API diretto, acquisterà l'add-on API Access e poi genererà una chiave API; questa strada richiede un account live finanziato e comporta un canone mensile, quindi controlli il prezzo attuale e il saldo minimo prima di impegnarsi. Su un account prop o di valutazione, è la Sua firm a decidere quali piattaforme e se l'automazione tramite API è consentita, quindi confermi prima le regole correnti della Sua firm." },
        { title: "Acceda dalla Sua piattaforma di grafici", html: "Tornato nel Suo software di grafici, apra le impostazioni di connessione o del fornitore di dati e scelga Tradovate. Inserisca il Suo nome utente e la Sua password Tradovate, poi scelga l'ambiente corretto: simulato per esercitarsi o per una valutazione, live per un account finanziato. In NinjaTrader significa attivare la modalità Multi-Provider e aggiungere una connessione Tradovate; Bookmap e Quantower usano una finestra di connessione simile. Se la configurazione di NinjaTrader appare diversa da una vecchia guida che ha visto, è normale: il suo collegamento a Tradovate è cambiato, quindi segua il metodo di connessione attuale e usi una build recente." },
        { title: "Invii un ordine di prova e confermi l'esecuzione", html: "Prima di affidargli dimensioni reali, invii un piccolo ordine, un solo contratto ES o MNQ, dalla piattaforma di grafici e osservi dove arriva. La posizione, gli ordini in lavorazione e il P&amp;L dovrebbero comparire nel Suo account Tradovate entro un secondo o due. Quando l'esecuzione compare su entrambi i lati, il Suo instradamento è attivo e può aumentare le dimensioni. Faccia questo test su un account simulato, così un clic sbagliato non potrà costarLe nulla." },
      ],
    },
    { type: "table", headers: ["Piattaforma","Come raggiunge Tradovate"], rows: [
      ["NinjaTrader","API Tradovate diretta (modalità Multi-Provider)"],
      ["Bookmap / Quantower / MotiveWave","Tradovate Connect (API)"],
