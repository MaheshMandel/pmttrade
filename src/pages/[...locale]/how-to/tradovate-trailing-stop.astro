---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-trailing-stop";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Set a Trailing Stop Order in Tradovate";
const META_DESCRIPTION =
  "Tradovate trailing stop orders made simple: pick trailing stop or stop-limit, set the trail distance, and lock in futures profits as price runs.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Eine Trailing-Stop-Order in Tradovate setzen", es: "Cómo colocar una orden Trailing Stop en Tradovate", fr: "Placer un ordre Trailing Stop dans Tradovate", it: "Impostare un ordine Trailing Stop in Tradovate" },
  dek: { en: "Want your winners to keep running while your risk moves up behind them, without babysitting the chart? Here's how to place a trailing stop or trailing stop-limit order in Tradovate and dial in the trail distance, step by step.", de: "Sie möchten, dass Ihre Gewinner weiterlaufen, während Ihr Risiko hinter ihnen nachrückt, ohne den Chart zu hüten? So platzieren Sie in Tradovate eine Trailing-Stop- oder Trailing-Stop-Limit-Order und stellen den Trailing-Abstand ein, Schritt für Schritt.", es: "¿Quiere que sus ganadoras sigan corriendo mientras su riesgo sube detrás de ellas, sin vigilar el gráfico? Aquí le explicamos cómo colocar una orden trailing stop o trailing stop-limit en Tradovate y ajustar la distancia del trail, paso a paso.", fr: "Vous voulez que vos gagnants continuent de courir pendant que votre risque monte derrière eux, sans surveiller le graphique ? Voici comment placer un ordre trailing stop ou trailing stop-limit dans Tradovate et régler la distance du trail, pas à pas.", it: "Vuole che i suoi trade vincenti continuino a correre mentre il suo rischio sale dietro di loro, senza dover sorvegliare il grafico? Ecco come inserire un ordine trailing stop o trailing stop-limit in Tradovate e regolare la distanza del trail, passo dopo passo." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Want your winners to keep running while your risk moves up behind them, all without babysitting the chart? That's exactly what a trailing stop does. Below, I'll walk you through placing a trailing stop or trailing stop-limit order in Tradovate and dialing in the trail distance, step by step." },
    { type: "heading", text: "What Is a Trailing Stop Order?" },
    { type: "paragraph", html: "A trailing stop is a stop order whose trigger price chases the market as it moves in your favor, then locks in place the moment the market turns against you. Tradovate gives you two flavors: a <strong class='text-white'>Trailing Stop</strong>, which fires a stop-market order when triggered, and a <strong class='text-white'>Trailing Stop Limit</strong>, which fires a stop-limit order instead. Once you submit it, the order follows price tick-for-tick while the trend runs your way and holds its level when price reverses. The payoff is simple, you keep more of an open gain without watching every single tick." },
    { type: "heading", text: "Place a Trailing Stop in Tradovate: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open the Order Ticket for Your Contract", html: "Log in to the Tradovate web app, pick the futures contract you want to trade, and open the order-entry ticket. Double-check two things before you go further: you're on the right trading account, and you've got the active front-month contract selected. Get those wrong and everything downstream is wrong too.", image: { src: `${IMG}/tradovate-trailing-stop-1.png`, alt: "Tradovate web order ticket open with an active front-month futures contract and account selected" } },
        { title: "Choose Trailing Stop or Trailing Stop Limit", html: "In the order ticket's order-type selector, switch the type from Market/Limit to <strong class='text-white'>Trailing Stop</strong> or <strong class='text-white'>Trailing Stop Limit</strong>. A trailing stop that isn't tied to an ATM strategy gets submitted straight from this ticket, so you can pick either variant before you send it. Go with Trailing Stop when you want a guaranteed exit at market once it triggers. Go with Trailing Stop Limit when you want price protection and can live with the risk of not getting filled in a fast move.", image: { src: `${IMG}/tradovate-trailing-stop-2.png`, alt: "Tradovate order ticket order-type selector showing the Trailing Stop and Trailing Stop Limit options" } },
        { title: "Set Your Trail Distance", html: "Now tell Tradovate how far behind the market you want the stop to trail, measured in ticks, say, 10 ticks. That's the gap the stop keeps as price moves your way. If you picked Trailing Stop Limit, you'll also set a limit offset, which decides how far past the trigger your limit price sits. Here's the trade-off worth thinking about: a tighter trail locks in profit sooner but is more likely to get tagged on ordinary noise, while a wider trail gives the trade more room to breathe.", image: { src: `${IMG}/tradovate-trailing-stop-3.png`, alt: "Tradovate trailing stop order ticket with the trail distance entered in ticks" } },
        { title: "Set Side and Quantity, Then Submit", html: "Pick the side that closes or protects your position, Sell to trail a long, Buy to trail a short, confirm the quantity, and submit the order to your account. From there, Tradovate handles the trail automatically. You don't touch it again unless you want to.", image: { src: `${IMG}/tradovate-trailing-stop-4.png`, alt: "Tradovate order ticket with side and quantity set, ready to submit a trailing stop" } },
        { title: "Watch the Working Order Trail the Market", html: "Open the Orders panel and confirm the trailing stop is actually working. As price moves in your favor, the trigger ratchets along tick-for-tick. When price pulls back, that trigger stays put, it doesn't give ground, until it either gets hit or you cancel it yourself.", image: { src: `${IMG}/tradovate-trailing-stop-5.png`, alt: "Tradovate Orders panel showing a working trailing stop order following the market" } },
      ],
    },
    { type: "heading", text: "Why You'd Need This" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Ride winners hands-free</strong>, let a trend run while the stop follows price for you.",
        "<strong class='text-white'>Protect open profit</strong>, the trigger never gives ground once price reverses.",
        "<strong class='text-white'>Reduce screen time</strong>, no dragging a manual stop up bar by bar.",
        "<strong class='text-white'>Enforce discipline</strong>, a pre-set trail takes the emotion out of your exits.",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Rather have your exits fire from a strategy than from manual clicks? <strong class='text-white'>PickMyTrade links your TradingView alerts straight to your Tradovate account</strong>, so a trailing-stop or exit signal from your chart routes to the broker automatically, no switching windows in the middle of a trade." },
  ], de: [
    { type: "paragraph",html: "Sie möchten, dass Ihre Gewinner weiterlaufen, während Ihr Risiko hinter ihnen nachrückt, ohne den Chart zu hüten? Genau das leistet ein Trailing Stop. Im Folgenden führe ich Sie Schritt für Schritt durch das Platzieren einer Trailing-Stop- oder Trailing-Stop-Limit-Order in Tradovate und das Einstellen des Trailing-Abstands." },
    { type: "heading",text: "Was ist eine Trailing-Stop-Order?" },
    { type: "paragraph",html: "Ein Trailing Stop ist eine Stop-Order, deren Auslösepreis dem Markt folgt, solange er sich zu Ihren Gunsten bewegt, und dann an Ort und Stelle einrastet, sobald der Markt sich gegen Sie dreht. Tradovate bietet zwei Varianten: einen <strong class='text-white'>Trailing Stop</strong>, der bei Auslösung eine Stop-Market-Order sendet, und einen <strong class='text-white'>Trailing Stop Limit</strong>, der stattdessen eine Stop-Limit-Order sendet. Sobald Sie ihn abschicken, folgt die Order dem Preis Tick für Tick, solange der Trend in Ihre Richtung läuft, und hält ihr Niveau, wenn der Preis dreht. Der Nutzen ist einfach: Sie behalten mehr von einem offenen Gewinn, ohne jeden einzelnen Tick zu beobachten." },
    { type: "heading",text: "Einen Trailing Stop in Tradovate platzieren: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Das Order-Ticket für Ihren Kontrakt öffnen", html: "Melden Sie sich in der Tradovate-Web-App an, wählen Sie den Futures-Kontrakt aus, den Sie handeln möchten, und öffnen Sie das Order-Ticket. Prüfen Sie zwei Dinge, bevor Sie weitermachen: dass Sie das richtige Handelskonto verwenden und dass der aktive Front-Month-Kontrakt ausgewählt ist. Stimmt das nicht, ist alles Weitere ebenfalls falsch.", image: {"src":`${IMG}/tradovate-trailing-stop-1.png`,"alt":"Tradovate-Web-Order-Ticket mit geöffnetem aktivem Front-Month-Futures-Kontrakt und ausgewähltem Konto"} },
        { title: "Trailing Stop oder Trailing Stop Limit wählen", html: "Stellen Sie in der Ordertyp-Auswahl des Order-Tickets den Typ von Market/Limit auf <strong class='text-white'>Trailing Stop</strong> oder <strong class='text-white'>Trailing Stop Limit</strong> um. Ein Trailing Stop, der nicht an eine ATM-Strategie gebunden ist, wird direkt aus diesem Ticket abgeschickt, sodass Sie vor dem Senden beide Varianten wählen können. Entscheiden Sie sich für Trailing Stop, wenn Sie nach der Auslösung einen garantierten Ausstieg zum Marktpreis wollen. Entscheiden Sie sich für Trailing Stop Limit, wenn Sie Preisschutz wünschen und das Risiko einer ausbleibenden Ausführung bei schneller Bewegung in Kauf nehmen können.", image: {"src":`${IMG}/tradovate-trailing-stop-2.png`,"alt":"Ordertyp-Auswahl im Tradovate-Order-Ticket mit den Optionen Trailing Stop und Trailing Stop Limit"} },
        { title: "Ihren Trailing-Abstand festlegen", html: "Teilen Sie Tradovate nun mit, wie weit hinter dem Markt der Stop nachlaufen soll, gemessen in Ticks, zum Beispiel 10 Ticks. Das ist der Abstand, den der Stop hält, während der Preis in Ihre Richtung läuft. Haben Sie Trailing Stop Limit gewählt, legen Sie zusätzlich einen Limit-Offset fest, der bestimmt, wie weit hinter dem Auslöser Ihr Limitpreis liegt. Der Zielkonflikt ist bedenkenswert: Ein engerer Trail sichert Gewinn früher, wird aber eher vom gewöhnlichen Rauschen getroffen, während ein weiterer Trail dem Trade mehr Luft zum Atmen gibt.", image: {"src":`${IMG}/tradovate-trailing-stop-3.png`,"alt":"Tradovate-Trailing-Stop-Order-Ticket mit dem in Ticks eingegebenen Trailing-Abstand"} },
        { title: "Seite und Menge festlegen, dann abschicken", html: "Wählen Sie die Seite, die Ihre Position schließt oder absichert, Sell, um eine Long-Position zu trailen, Buy, um eine Short-Position zu trailen, bestätigen Sie die Menge und schicken Sie die Order an Ihr Konto. Von da an übernimmt Tradovate das Nachziehen automatisch. Sie müssen nichts mehr anfassen, es sei denn, Sie möchten es.", image: {"src":`${IMG}/tradovate-trailing-stop-4.png`,"alt":"Tradovate-Order-Ticket mit festgelegter Seite und Menge, bereit zum Abschicken eines Trailing Stops"} },
        { title: "Beobachten, wie die aktive Order dem Markt folgt", html: "Öffnen Sie das Orders-Panel und bestätigen Sie, dass der Trailing Stop tatsächlich aktiv ist. Bewegt sich der Preis zu Ihren Gunsten, rastet der Auslöser Tick für Tick mit. Zieht sich der Preis zurück, bleibt der Auslöser stehen und gibt kein Terrain ab, bis er entweder getroffen wird oder Sie die Order selbst stornieren.", image: {"src":`${IMG}/tradovate-trailing-stop-5.png`,"alt":"Tradovate-Orders-Panel mit einer aktiven Trailing-Stop-Order, die dem Markt folgt"} },
      ],
    },
    { type: "heading",text: "Warum Sie das brauchen" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Gewinner freihändig laufen lassen</strong>, ein Trend läuft, während der Stop dem Preis für Sie folgt.",
        "<strong class='text-white'>Offenen Gewinn schützen</strong>, der Auslöser gibt kein Terrain mehr ab, sobald der Preis dreht.",
        "<strong class='text-white'>Bildschirmzeit reduzieren</strong>, kein manuelles Nachziehen des Stops Kerze für Kerze.",
        "<strong class='text-white'>Disziplin durchsetzen</strong>, ein vorab festgelegter Trail nimmt die Emotion aus Ihren Ausstiegen.",
      ],
    },
    { type: "heading",text: "Automatisieren Sie das mit PickMyTrade" },
    { type: "paragraph",html: "Möchten Sie lieber, dass Ihre Ausstiege von einer Strategie statt von manuellen Klicks ausgelöst werden? <strong class='text-white'>PickMyTrade verbindet Ihre TradingView-Alerts direkt mit Ihrem Tradovate-Konto</strong>, sodass ein Trailing-Stop- oder Ausstiegssignal aus Ihrem Chart automatisch an den Broker weitergeleitet wird, ohne mitten im Trade das Fenster zu wechseln." },
  ], es: [
    { type: "paragraph",html: "¿Quiere que sus ganadoras sigan corriendo mientras su riesgo sube detrás de ellas, sin vigilar el gráfico? Eso es exactamente lo que hace un trailing stop. A continuación, le guiaré paso a paso para colocar una orden trailing stop o trailing stop-limit en Tradovate y ajustar la distancia del trail." },
    { type: "heading",text: "¿Qué es una orden Trailing Stop?" },
    { type: "paragraph",html: "Un trailing stop es una orden stop cuyo precio de activación persigue al mercado mientras se mueve a su favor y se bloquea en su sitio en cuanto el mercado gira en su contra. Tradovate ofrece dos variantes: un <strong class='text-white'>Trailing Stop</strong>, que lanza una orden stop de mercado al activarse, y un <strong class='text-white'>Trailing Stop Limit</strong>, que lanza en su lugar una orden stop-limit. Una vez enviada, la orden sigue al precio tick a tick mientras la tendencia corre a su favor y mantiene su nivel cuando el precio se revierte. La ventaja es simple: conserva más de una ganancia abierta sin vigilar cada tick." },
    { type: "heading",text: "Coloque un Trailing Stop en Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra el ticket de órdenes de su contrato", html: "Inicie sesión en la aplicación web de Tradovate, elija el contrato de futuros que quiere operar y abra el ticket de entrada de órdenes. Compruebe dos cosas antes de continuar: que está en la cuenta de trading correcta y que tiene seleccionado el contrato activo del mes más próximo. Si se equivoca en eso, todo lo que venga después también estará mal.", image: {"src":`${IMG}/tradovate-trailing-stop-1.png`,"alt":"Ticket de órdenes web de Tradovate abierto con un contrato de futuros activo del mes más próximo y una cuenta seleccionada"} },
        { title: "Elija Trailing Stop o Trailing Stop Limit", html: "En el selector de tipo de orden del ticket, cambie el tipo de Market/Limit a <strong class='text-white'>Trailing Stop</strong> o <strong class='text-white'>Trailing Stop Limit</strong>. Un trailing stop que no esté vinculado a una estrategia ATM se envía directamente desde este ticket, de modo que puede elegir cualquiera de las dos variantes antes de enviarlo. Elija Trailing Stop cuando quiera una salida garantizada a mercado una vez activado. Elija Trailing Stop Limit cuando quiera protección de precio y pueda asumir el riesgo de no ejecutarse en un movimiento rápido.", image: {"src":`${IMG}/tradovate-trailing-stop-2.png`,"alt":"Selector de tipo de orden del ticket de Tradovate mostrando las opciones Trailing Stop y Trailing Stop Limit"} },
        { title: "Establezca la distancia del trail", html: "Ahora indique a Tradovate a qué distancia del mercado quiere que el stop lo siga, medida en ticks, por ejemplo, 10 ticks. Es la separación que el stop mantiene a medida que el precio se mueve a su favor. Si eligió Trailing Stop Limit, también establecerá un desfase de límite, que decide a qué distancia del disparador queda su precio límite. Este es el equilibrio que conviene sopesar: un trail más corto bloquea el beneficio antes pero es más probable que lo toque el ruido normal, mientras que un trail más amplio da más espacio a la operación para respirar.", image: {"src":`${IMG}/tradovate-trailing-stop-3.png`,"alt":"Ticket de orden trailing stop de Tradovate con la distancia del trail introducida en ticks"} },
        { title: "Establezca el lado y la cantidad, y envíe", html: "Elija el lado que cierra o protege su posición, Sell para seguir una posición larga, Buy para seguir una corta, confirme la cantidad y envíe la orden a su cuenta. A partir de ahí, Tradovate gestiona el trail automáticamente. No tiene que tocarlo de nuevo a menos que quiera.", image: {"src":`${IMG}/tradovate-trailing-stop-4.png`,"alt":"Ticket de órdenes de Tradovate con el lado y la cantidad establecidos, listo para enviar un trailing stop"} },
        { title: "Observe cómo la orden activa sigue al mercado", html: "Abra el panel Orders y confirme que el trailing stop está realmente activo. A medida que el precio se mueve a su favor, el disparador avanza tick a tick. Cuando el precio retrocede, ese disparador se queda donde está, no cede terreno, hasta que lo alcanzan o usted lo cancela.", image: {"src":`${IMG}/tradovate-trailing-stop-5.png`,"alt":"Panel Orders de Tradovate mostrando una orden trailing stop activa siguiendo al mercado"} },
      ],
    },
    { type: "heading",text: "Por qué lo necesitaría" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Deje correr las ganadoras sin intervenir</strong>, deje que una tendencia avance mientras el stop sigue al precio por usted.",
        "<strong class='text-white'>Proteja el beneficio abierto</strong>, el disparador nunca cede terreno una vez que el precio se revierte.",
        "<strong class='text-white'>Reduzca el tiempo frente a la pantalla</strong>, sin arrastrar un stop manual vela a vela.",
        "<strong class='text-white'>Imponga disciplina</strong>, un trail predefinido quita la emoción de sus salidas.",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "¿Prefiere que sus salidas las dispare una estrategia y no clics manuales? <strong class='text-white'>PickMyTrade conecta sus alertas de TradingView directamente con su cuenta de Tradovate</strong>, de modo que una señal de trailing stop o de salida desde su gráfico se enruta automáticamente al bróker, sin cambiar de ventana en mitad de una operación." },
  ], fr: [
    { type: "paragraph",html: "Vous voulez que vos gagnants continuent de courir pendant que votre risque monte derrière eux, sans surveiller le graphique ? C’est exactement ce que fait un trailing stop. Ci-dessous, je vous guide pas à pas pour placer un ordre trailing stop ou trailing stop-limit dans Tradovate et régler la distance du trail." },
    { type: "heading",text: "Qu’est-ce qu’un ordre Trailing Stop ?" },
    { type: "paragraph",html: "Un trailing stop est un ordre stop dont le prix de déclenchement poursuit le marché tant qu’il évolue en votre faveur, puis se fige dès que le marché se retourne contre vous. Tradovate propose deux variantes : un <strong class='text-white'>Trailing Stop</strong>, qui envoie un ordre stop au marché lorsqu’il est déclenché, et un <strong class='text-white'>Trailing Stop Limit</strong>, qui envoie à la place un ordre stop-limit. Une fois soumis, l’ordre suit le prix tick par tick tant que la tendance va dans votre sens et conserve son niveau lorsque le prix s’inverse. L’avantage est simple : vous conservez une plus grande part d’un gain ouvert sans surveiller chaque tick." },
    { type: "heading",text: "Placer un Trailing Stop dans Tradovate : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez le ticket d’ordre de votre contrat", html: "Connectez-vous à l’application web Tradovate, choisissez le contrat à terme que vous souhaitez trader et ouvrez le ticket de saisie d’ordre. Vérifiez deux choses avant d’aller plus loin : que vous êtes sur le bon compte de trading et que le contrat actif du mois le plus proche est sélectionné. Si ce n’est pas le cas, tout ce qui suit sera faux également.", image: {"src":`${IMG}/tradovate-trailing-stop-1.png`,"alt":"Ticket d’ordre web de Tradovate ouvert avec un contrat à terme actif du mois le plus proche et un compte sélectionné"} },
        { title: "Choisissez Trailing Stop ou Trailing Stop Limit", html: "Dans le sélecteur de type d’ordre du ticket, faites passer le type de Market/Limit à <strong class='text-white'>Trailing Stop</strong> ou <strong class='text-white'>Trailing Stop Limit</strong>. Un trailing stop qui n’est pas lié à une stratégie ATM est soumis directement depuis ce ticket ; vous pouvez donc choisir l’une ou l’autre variante avant de l’envoyer. Optez pour Trailing Stop si vous voulez une sortie garantie au marché une fois déclenché. Optez pour Trailing Stop Limit si vous voulez une protection de prix et pouvez accepter le risque de ne pas être exécuté lors d’un mouvement rapide.", image: {"src":`${IMG}/tradovate-trailing-stop-2.png`,"alt":"Sélecteur de type d’ordre du ticket Tradovate affichant les options Trailing Stop et Trailing Stop Limit"} },
        { title: "Définissez votre distance de trail", html: "Indiquez maintenant à Tradovate à quelle distance du marché le stop doit suivre, mesurée en ticks, par exemple 10 ticks. C’est l’écart que le stop conserve à mesure que le prix évolue en votre faveur. Si vous avez choisi Trailing Stop Limit, vous définirez aussi un décalage de limite, qui détermine à quelle distance du déclencheur se situe votre prix limite. Voici le compromis à garder en tête : un trail plus serré sécurise le profit plus tôt mais risque davantage d’être touché par le bruit ordinaire, tandis qu’un trail plus large laisse plus de place au trade pour respirer.", image: {"src":`${IMG}/tradovate-trailing-stop-3.png`,"alt":"Ticket d’ordre trailing stop de Tradovate avec la distance de trail saisie en ticks"} },
        { title: "Définissez le sens et la quantité, puis soumettez", html: "Choisissez le sens qui clôture ou protège votre position, Sell pour suivre une position longue, Buy pour suivre une position courte, confirmez la quantité et soumettez l’ordre à votre compte. Ensuite, Tradovate gère le trail automatiquement. Vous n’avez plus à y toucher, sauf si vous le souhaitez.", image: {"src":`${IMG}/tradovate-trailing-stop-4.png`,"alt":"Ticket d’ordre Tradovate avec le sens et la quantité définis, prêt à soumettre un trailing stop"} },
        { title: "Regardez l’ordre actif suivre le marché", html: "Ouvrez le panneau Orders et vérifiez que le trailing stop est bien actif. À mesure que le prix évolue en votre faveur, le déclencheur avance tick par tick. Lorsque le prix recule, ce déclencheur reste en place, il ne cède pas de terrain, jusqu’à ce qu’il soit touché ou que vous l’annuliez vous-même.", image: {"src":`${IMG}/tradovate-trailing-stop-5.png`,"alt":"Panneau Orders de Tradovate affichant un ordre trailing stop actif qui suit le marché"} },
      ],
    },
    { type: "heading",text: "Pourquoi en avez-vous besoin" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Laissez courir vos gagnants sans intervenir</strong>, laissez une tendance se dérouler pendant que le stop suit le prix pour vous.",
        "<strong class='text-white'>Protégez le profit ouvert</strong>, le déclencheur ne cède jamais de terrain une fois que le prix s’inverse.",
        "<strong class='text-white'>Réduisez le temps d’écran</strong>, plus besoin de remonter un stop manuel bougie par bougie.",
        "<strong class='text-white'>Imposez la discipline</strong>, un trail préréglé retire l’émotion de vos sorties.",
      ],
    },
    { type: "heading",text: "Automatisez tout cela avec PickMyTrade" },
    { type: "paragraph",html: "Vous préférez que vos sorties soient déclenchées par une stratégie plutôt que par des clics manuels ? <strong class='text-white'>PickMyTrade relie vos alertes TradingView directement à votre compte Tradovate</strong>, de sorte qu’un signal de trailing stop ou de sortie issu de votre graphique est acheminé automatiquement vers le courtier, sans changer de fenêtre en plein trade." },
  ], it: [
    { type: "paragraph",html: "Vuole che i suoi trade vincenti continuino a correre mentre il suo rischio sale dietro di loro, senza dover sorvegliare il grafico? È esattamente ciò che fa un trailing stop. Di seguito la guido passo dopo passo nell’inserimento di un ordine trailing stop o trailing stop-limit in Tradovate e nella regolazione della distanza del trail." },
    { type: "heading",text: "Che cos’è un ordine Trailing Stop?" },
    { type: "paragraph",html: "Un trailing stop è un ordine stop il cui prezzo di attivazione insegue il mercato finché si muove a suo favore, per poi bloccarsi sul posto nel momento in cui il mercato si gira contro di lei. Tradovate offre due varianti: un <strong class='text-white'>Trailing Stop</strong>, che invia un ordine stop a mercato quando viene attivato, e un <strong class='text-white'>Trailing Stop Limit</strong>, che invia invece un ordine stop-limit. Una volta inviato, l’ordine segue il prezzo tick per tick finché il trend corre a suo favore e mantiene il livello quando il prezzo inverte. Il vantaggio è semplice: conserva una quota maggiore di un guadagno aperto senza osservare ogni singolo tick." },
    { type: "heading",text: "Inserire un Trailing Stop in Tradovate: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Apra il ticket dell’ordine per il suo contratto", html: "Acceda all’app web di Tradovate, scelga il contratto future che desidera operare e apra il ticket di inserimento ordini. Controlli due cose prima di procedere: di essere sul conto di trading corretto e di aver selezionato il contratto attivo del mese più vicino. Se sbaglia questi due punti, tutto ciò che segue sarà sbagliato.", image: {"src":`${IMG}/tradovate-trailing-stop-1.png`,"alt":"Ticket ordini web di Tradovate aperto con un contratto future attivo del mese più vicino e un conto selezionato"} },
        { title: "Scelga Trailing Stop o Trailing Stop Limit", html: "Nel selettore del tipo di ordine del ticket, cambi il tipo da Market/Limit a <strong class='text-white'>Trailing Stop</strong> o <strong class='text-white'>Trailing Stop Limit</strong>. Un trailing stop non collegato a una strategia ATM viene inviato direttamente da questo ticket, quindi può scegliere l’una o l’altra variante prima di inviarlo. Scelga Trailing Stop quando vuole un’uscita garantita a mercato una volta attivato. Scelga Trailing Stop Limit quando vuole protezione sul prezzo e può accettare il rischio di non essere eseguito in un movimento veloce.", image: {"src":`${IMG}/tradovate-trailing-stop-2.png`,"alt":"Selettore del tipo di ordine nel ticket Tradovate con le opzioni Trailing Stop e Trailing Stop Limit"} },
        { title: "Imposti la distanza del trail", html: "Ora indichi a Tradovate a che distanza dal mercato vuole che lo stop lo segua, misurata in tick, ad esempio 10 tick. È il divario che lo stop mantiene mentre il prezzo si muove a suo favore. Se ha scelto Trailing Stop Limit, imposterà anche un offset del limite, che stabilisce a che distanza dal trigger si trova il suo prezzo limite. Ecco il compromesso su cui riflettere: un trail più stretto blocca il profitto prima ma è più probabile che venga colpito dal normale rumore, mentre un trail più ampio concede al trade più spazio per respirare.", image: {"src":`${IMG}/tradovate-trailing-stop-3.png`,"alt":"Ticket di un ordine trailing stop di Tradovate con la distanza del trail inserita in tick"} },
        { title: "Imposti lato e quantità, poi invii", html: "Scelga il lato che chiude o protegge la sua posizione, Sell per seguire una long, Buy per seguire una short, confermi la quantità e invii l’ordine al suo conto. Da lì in poi Tradovate gestisce il trail automaticamente. Non deve più toccarlo, a meno che non lo desideri.", image: {"src":`${IMG}/tradovate-trailing-stop-4.png`,"alt":"Ticket ordini di Tradovate con lato e quantità impostati, pronto per inviare un trailing stop"} },
        { title: "Osservi l’ordine attivo seguire il mercato", html: "Apra il pannello Orders e confermi che il trailing stop sia effettivamente attivo. Mentre il prezzo si muove a suo favore, il trigger avanza tick per tick. Quando il prezzo ritraccia, quel trigger resta fermo, non cede terreno, finché non viene colpito o finché non lo annulla lei stessa.", image: {"src":`${IMG}/tradovate-trailing-stop-5.png`,"alt":"Pannello Orders di Tradovate che mostra un ordine trailing stop attivo che segue il mercato"} },
      ],
    },
    { type: "heading",text: "Perché le serve" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Lasci correre i trade vincenti senza intervenire</strong>, lasci che un trend proceda mentre lo stop segue il prezzo al suo posto.",
        "<strong class='text-white'>Protegga il profitto aperto</strong>, il trigger non cede mai terreno una volta che il prezzo inverte.",
        "<strong class='text-white'>Riduca il tempo davanti allo schermo</strong>, niente più stop manuale trascinato candela dopo candela.",
        "<strong class='text-white'>Faccia rispettare la disciplina</strong>, un trail preimpostato toglie l’emozione dalle sue uscite.",
      ],
    },
    { type: "heading",text: "Automatizzi tutto questo con PickMyTrade" },
    { type: "paragraph",html: "Preferisce che le sue uscite partano da una strategia anziché da clic manuali? <strong class='text-white'>PickMyTrade collega i suoi alert di TradingView direttamente al suo conto Tradovate</strong>, così un segnale di trailing stop o di uscita dal suo grafico viene instradato automaticamente al broker, senza cambiare finestra nel mezzo di un trade." },
  ] },
  ctaHeading: { en: "Automate Your Tradovate Exits", de: "Automatisieren Sie Ihre Tradovate-Ausstiege", es: "Automatice sus salidas en Tradovate", fr: "Automatisez vos sorties Tradovate", it: "Automatizzi le sue uscite su Tradovate" },
  ctaText: { en: "Let your strategy pull the trigger. PickMyTrade routes trailing-stop and exit signals from TradingView straight to your Tradovate account.", de: "Lassen Sie Ihre Strategie abdrücken. PickMyTrade leitet Trailing-Stop- und Ausstiegssignale von TradingView direkt an Ihr Tradovate-Konto weiter.", es: "Deje que su estrategia apriete el gatillo. PickMyTrade enruta las señales de trailing stop y de salida desde TradingView directamente a su cuenta de Tradovate.", fr: "Laissez votre stratégie appuyer sur la gâchette. PickMyTrade achemine les signaux de trailing stop et de sortie depuis TradingView directement vers votre compte Tradovate.", it: "Lasci che sia la sua strategia a premere il grilletto. PickMyTrade instrada i segnali di trailing stop e di uscita da TradingView direttamente al suo conto Tradovate." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "What's the difference between a Trailing Stop and a Trailing Stop Limit in Tradovate?", a: "A Trailing Stop triggers a market order when the trailing price is hit, so it prioritizes getting you out. A Trailing Stop Limit triggers a stop-limit order at a limit offset you set, which gives you price protection but risks not filling in a fast-moving market." },
    { q: "Is a Trailing Stop order the same as Auto Trail?", a: "No. The Trailing Stop order type follows price tick-for-tick from the moment it's working. Auto Trail is a separate ATM-strategy feature that only starts trailing after a profit trigger is reached, and it adjusts at a set frequency. Pick whichever one matches your exit plan." },
