---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-auto-trading-bot";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Build a Tradovate Auto-Trading Bot With the API";
const META_DESCRIPTION =
  "Build an end-to-end automated futures trading bot with the Tradovate API: authenticate, stream live market data, and place orders from your own code.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Einen Tradovate-Auto-Trading-Bot mit der API bauen", es: "Cree un bot de auto-trading de Tradovate con la API", fr: "Créer un bot de trading automatique Tradovate avec l’API", it: "Creare un bot di auto-trading Tradovate con l’API" },
  dek: { en: "A trading bot sounds complicated until you break it into parts. Here's how the pieces fit together end to end, from authenticating and streaming market data to placing orders, and the one flag that gets a lot of first bots rejected.", de: "Ein Trading-Bot klingt kompliziert, bis man ihn in seine Teile zerlegt. So greifen die Bausteine von Anfang bis Ende ineinander, von der Authentifizierung über das Streamen von Marktdaten bis zum Platzieren von Orders, samt dem einen Flag, an dem viele erste Bots scheitern.", es: "Un bot de trading parece complicado hasta que lo divide en partes. Así encajan las piezas de principio a fin, desde autenticarse y transmitir datos de mercado hasta colocar órdenes, y el único flag que hace que rechacen muchos primeros bots.", fr: "Un bot de trading semble compliqué jusqu’à ce qu’on le découpe en éléments. Voici comment les pièces s’assemblent de bout en bout, de l’authentification au streaming des données de marché puis au placement des ordres, ainsi que le seul flag qui fait rejeter beaucoup de premiers bots.", it: "Un bot di trading sembra complicato finché non lo si scompone in parti. Ecco come si incastrano i pezzi dall’inizio alla fine, dall’autenticazione allo streaming dei dati di mercato fino all’invio degli ordini, insieme al flag che fa rifiutare molti primi bot." },
  readTime: { en: "7 min read", de: "7 Min. Lesezeit", es: "Lectura de 7 min", fr: "Lecture : 7 min", it: "Lettura di 7 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "A trading bot sounds complicated until you break it into parts. Underneath, it's a loop: log in, watch prices, decide, send an order, repeat. Tradovate's official JavaScript examples lay out exactly that path, and you can follow the same shape in Python, C#, or whatever you're comfortable with. Here's how the pieces fit together end to end, and the one flag that gets a lot of first bots rejected." },
    { type: "heading", text: "What Does a Tradovate Trading Bot Actually Do?" },
    { type: "paragraph", html: "At its core, a Tradovate bot authenticates once for an access token, holds a live connection to market data, runs your logic on every price update, and calls the order endpoint when your rules say to. The official <code>example-api-js</code> repo splits this into an Access track (REST auth and orders) and a WebSockets track (real-time data and trading). The AutoTrade example ties them into an event-driven engine where a strategy reacts to quotes, DOM, and chart events as they stream in." },
    { type: "heading", text: "Building the Bot Step by Step" },
    {
      type: "steps",
      items: [
        { title: "Turn On API Access and Grab Your App Credentials", html: "First you need the keys. Enable the <strong class='text-white'>API Access</strong> add-on on your account, then note the three values your code will authenticate with: <code>appId</code> (a name for your app), <code>cid</code> (client id), and <code>sec</code> (client secret). You'll pair those with your normal Tradovate username and password. Heads up: some prop firms restrict or ban direct API bots on their accounts, so confirm your firm allows it before you build against a funded account, rules vary by firm, so check your current agreement." },
        { title: "Authenticate and Get an Access Token", html: "Nothing else works without a token. POST a credentials body to <code>/auth/accessTokenRequest</code> with your name, password, appId, appVersion, cid, sec, and a deviceId. The response hands back an <code>accessToken</code> you attach as <code>Authorization: Bearer</code> on every call after this. Tokens live about 90 minutes, so don't wait for a 401, call <code>/auth/renewAccessToken</code> roughly 15 minutes before expiry to keep the session warm. Include a stable <code>deviceId</code>; live trading enforces device approval more strictly than demo does." },
        { title: "Stream Live Market Data Over WebSocket", html: "REST is fine for one-off calls, but a bot needs a constant feed, and that's what the WebSocket is for. Open a socket to the market-data host (<code>md.tradovateapi.com</code>), send your access token to authorize, then subscribe to what you care about, <code>md/subscribeQuote</code> for prices, or DOM and chart subscriptions for depth and bars. From here your code receives an event every time the market moves. Keep the heartbeat alive so the connection doesn't drop mid-session." },
        { title: "Turn Your Signal Into Orders With placeOrder", html: "This is the brain. In the AutoTrade pattern, your strategy extends a base class and implements a <code>next()</code> function that works like a reducer: it takes the current state plus the incoming market event and returns updated state. That's where your indicator math and entry rules live. When the state says \"go,\" build the order payload and send it to <code>/order/placeOrder</code>. That <code>isAutomated</code> field matters more than it looks. It must be <code>true</code> for any order a bot or algorithm fires, it's a CME compliance requirement, not a suggestion. Leave it off and you're inviting rejections. Pull <code>accountId</code> and <code>accountSpec</code> from <code>/account/list</code>, and always use the current front-month contract symbol." },
        { title: "Test on Demo, Then Handle Tokens and Rate Limits", html: "Run the whole loop against the demo host (<code>demo.tradovateapi.com/v1</code>) until it behaves, wrong logic on the live host (<code>live.tradovateapi.com/v1</code>) costs real money. A few things trip up new bots: you're capped at 2 concurrent sessions, so a stray login knocks the first offline; hammering REST endpoints trips rate limits and a <code>p-ticket</code> time penalty you must wait out; and a lapsed token silently breaks everything. Log every response and only flip to live once demo runs clean for a full session." },
      ],
    },
    {
      type: "quote",
      html: "<code>{</code><br><code>&nbsp;&nbsp;\"name\": \"your_username\",</code><br><code>&nbsp;&nbsp;\"password\": \"your_password\",</code><br><code>&nbsp;&nbsp;\"appId\": \"MyTradingBot\",</code><br><code>&nbsp;&nbsp;\"appVersion\": \"1.0\",</code><br><code>&nbsp;&nbsp;\"cid\": 1234,</code><br><code>&nbsp;&nbsp;\"sec\": \"YOUR_CLIENT_SECRET\",</code><br><code>&nbsp;&nbsp;\"deviceId\": \"a-stable-uuid\"</code><br><code>}</code>",
    },
    {
      type: "quote",
      html: "<code>{</code><br><code>&nbsp;&nbsp;\"accountSpec\": \"YOUR_ACCOUNT_NAME\",</code><br><code>&nbsp;&nbsp;\"accountId\": 123456,</code><br><code>&nbsp;&nbsp;\"action\": \"Buy\",</code><br><code>&nbsp;&nbsp;\"symbol\": \"MESU6\",</code><br><code>&nbsp;&nbsp;\"orderQty\": 1,</code><br><code>&nbsp;&nbsp;\"orderType\": \"Market\",</code><br><code>&nbsp;&nbsp;\"isAutomated\": true</code><br><code>}</code>",
    },
    { type: "heading", text: "Skip the Plumbing With PickMyTrade" },
    { type: "paragraph", html: "Building the whole stack yourself, token renewal, WebSocket heartbeats, the <code>isAutomated</code> flag, rate-limit backoff, is real work before you've placed a single strategic trade. If your signal already lives in TradingView, <strong class='text-white'>PickMyTrade routes those alerts straight into your Tradovate account</strong> with the orders formatted and compliance-flagged for you, no API code required." },
  ], de: [
    { type: "paragraph",html: "Ein Trading-Bot klingt kompliziert, bis man ihn in seine Teile zerlegt. Im Kern ist er eine Schleife: anmelden, Preise beobachten, entscheiden, Order senden, wiederholen. Die offiziellen JavaScript-Beispiele von Tradovate zeigen genau diesen Weg, und dieselbe Struktur lässt sich in Python, C# oder einer Sprache Ihrer Wahl nachbauen. So greifen die Bausteine von Anfang bis Ende ineinander, samt dem einen Flag, an dem viele erste Bots scheitern." },
    { type: "heading",text: "Was macht ein Tradovate-Trading-Bot eigentlich?" },
    { type: "paragraph",html: "Im Kern authentifiziert sich ein Tradovate-Bot einmal für ein Access-Token, hält eine Live-Verbindung zu den Marktdaten, führt Ihre Logik bei jedem Preis-Update aus und ruft den Order-Endpunkt auf, wenn Ihre Regeln es verlangen. Das offizielle Repo <code>example-api-js</code> teilt dies in einen Access-Track (REST-Auth und Orders) und einen WebSockets-Track (Echtzeitdaten und Handel). Das AutoTrade-Beispiel verbindet beide zu einer ereignisgesteuerten Engine, in der eine Strategie auf Quotes-, DOM- und Chart-Ereignisse reagiert, sobald sie eintreffen." },
    { type: "heading",text: "Den Bot Schritt für Schritt bauen" },
    {
      type: "steps",
      items: [
        { title: "API-Zugang aktivieren und App-Zugangsdaten holen", html: "Zuerst brauchen Sie die Schlüssel. Aktivieren Sie das Add-on <strong class='text-white'>API Access</strong> für Ihr Konto und notieren Sie dann die drei Werte, mit denen sich Ihr Code authentifiziert: <code>appId</code> (ein Name für Ihre App), <code>cid</code> (Client-ID) und <code>sec</code> (Client-Secret). Diese kombinieren Sie mit Ihrem normalen Tradovate-Benutzernamen und Passwort. Hinweis: Manche Prop-Firmen schränken direkte API-Bots auf ihren Konten ein oder verbieten sie. Prüfen Sie daher, ob Ihre Firma es erlaubt, bevor Sie gegen ein finanziertes Konto bauen. Die Regeln unterscheiden sich je nach Firma, also lesen Sie Ihre aktuelle Vereinbarung." },
        { title: "Authentifizieren und ein Access-Token erhalten", html: "Ohne Token funktioniert nichts anderes. Senden Sie per POST einen Credentials-Body an <code>/auth/accessTokenRequest</code> mit name, password, appId, appVersion, cid, sec und einer deviceId. Die Antwort liefert ein <code>accessToken</code>, das Sie danach bei jedem Aufruf als <code>Authorization: Bearer</code> anhängen. Token leben etwa 90 Minuten, warten Sie also nicht auf ein 401, sondern rufen Sie <code>/auth/renewAccessToken</code> etwa 15 Minuten vor Ablauf auf, um die Sitzung am Leben zu halten. Verwenden Sie eine stabile <code>deviceId</code>; im Live-Handel wird die Geräte-Freigabe strenger durchgesetzt als in der Demo." },
        { title: "Live-Marktdaten über WebSocket streamen", html: "REST eignet sich für einzelne Aufrufe, aber ein Bot braucht einen konstanten Feed, und dafür ist der WebSocket da. Öffnen Sie einen Socket zum Marktdaten-Host (<code>md.tradovateapi.com</code>), senden Sie Ihr Access-Token zur Autorisierung und abonnieren Sie dann, was Sie brauchen: <code>md/subscribeQuote</code> für Preise oder DOM- und Chart-Abonnements für Tiefe und Balken. Ab da erhält Ihr Code bei jeder Marktbewegung ein Ereignis. Halten Sie den Heartbeat aktiv, damit die Verbindung mitten in der Sitzung nicht abreißt." },
        { title: "Ihr Signal mit placeOrder in Orders umsetzen", html: "Das ist das Gehirn. Im AutoTrade-Muster erweitert Ihre Strategie eine Basisklasse und implementiert eine <code>next()</code>-Funktion, die wie ein Reducer arbeitet: Sie nimmt den aktuellen Zustand plus das eingehende Marktereignis und gibt den aktualisierten Zustand zurück. Dort liegen Ihre Indikatorberechnungen und Einstiegsregeln. Sagt der Zustand „los“, bauen Sie die Order-Payload und senden sie an <code>/order/placeOrder</code>. Das Feld <code>isAutomated</code> ist wichtiger, als es aussieht. Es muss für jede von einem Bot oder Algorithmus ausgelöste Order <code>true</code> sein; das ist eine CME-Compliance-Anforderung und keine Empfehlung. Lassen Sie es weg, laden Sie Ablehnungen ein. Holen Sie <code>accountId</code> und <code>accountSpec</code> aus <code>/account/list</code> und verwenden Sie stets das Symbol des aktuellen Front-Month-Kontrakts." },
        { title: "Auf Demo testen, dann Token und Rate Limits meistern", html: "Lassen Sie den gesamten Ablauf gegen den Demo-Host (<code>demo.tradovateapi.com/v1</code>) laufen, bis er sich korrekt verhält, denn falsche Logik auf dem Live-Host (<code>live.tradovateapi.com/v1</code>) kostet echtes Geld. Neue Bots stolpern über einiges: Sie sind auf 2 gleichzeitige Sitzungen begrenzt, ein verirrter Login wirft also die erste offline; wer REST-Endpunkte bombardiert, löst Rate Limits und eine <code>p-ticket</code>-Zeitstrafe aus, die Sie abwarten müssen; und ein abgelaufenes Token bricht stillschweigend alles. Protokollieren Sie jede Antwort und wechseln Sie erst auf Live, wenn die Demo eine volle Sitzung lang sauber läuft." },
      ],
    },
    { type: "quote",html: "<code>{</code><br><code>&nbsp;&nbsp;\"name\": \"your_username\",</code><br><code>&nbsp;&nbsp;\"password\": \"your_password\",</code><br><code>&nbsp;&nbsp;\"appId\": \"MyTradingBot\",</code><br><code>&nbsp;&nbsp;\"appVersion\": \"1.0\",</code><br><code>&nbsp;&nbsp;\"cid\": 1234,</code><br><code>&nbsp;&nbsp;\"sec\": \"YOUR_CLIENT_SECRET\",</code><br><code>&nbsp;&nbsp;\"deviceId\": \"a-stable-uuid\"</code><br><code>}</code>" },
    { type: "quote",html: "<code>{</code><br><code>&nbsp;&nbsp;\"accountSpec\": \"YOUR_ACCOUNT_NAME\",</code><br><code>&nbsp;&nbsp;\"accountId\": 123456,</code><br><code>&nbsp;&nbsp;\"action\": \"Buy\",</code><br><code>&nbsp;&nbsp;\"symbol\": \"MESU6\",</code><br><code>&nbsp;&nbsp;\"orderQty\": 1,</code><br><code>&nbsp;&nbsp;\"orderType\": \"Market\",</code><br><code>&nbsp;&nbsp;\"isAutomated\": true</code><br><code>}</code>" },
    { type: "heading",text: "Sparen Sie sich die Installation mit PickMyTrade" },
    { type: "paragraph",html: "Den gesamten Stack selbst zu bauen, mit Token-Erneuerung, WebSocket-Heartbeats, dem <code>isAutomated</code>-Flag und Rate-Limit-Backoff, ist echte Arbeit, bevor Sie einen einzigen strategischen Trade platziert haben. Wenn Ihr Signal bereits in TradingView liegt, <strong class='text-white'>leitet PickMyTrade diese Alerts direkt in Ihr Tradovate-Konto weiter</strong>, mit korrekt formatierten und compliance-konform markierten Orders, ganz ohne API-Code." },
  ], es: [
    { type: "paragraph",html: "Un bot de trading parece complicado hasta que lo divide en partes. En el fondo es un bucle: iniciar sesión, observar precios, decidir, enviar una orden, repetir. Los ejemplos oficiales de JavaScript de Tradovate muestran exactamente ese camino, y puede seguir la misma estructura en Python, C# o el lenguaje con el que se sienta cómodo. Así encajan las piezas de principio a fin, y el único flag que hace que rechacen muchos primeros bots." },
    { type: "heading",text: "¿Qué hace realmente un bot de trading de Tradovate?" },
    { type: "paragraph",html: "En esencia, un bot de Tradovate se autentica una vez para obtener un token de acceso, mantiene una conexión en vivo con los datos de mercado, ejecuta su lógica en cada actualización de precio y llama al endpoint de órdenes cuando sus reglas lo indican. El repositorio oficial <code>example-api-js</code> lo divide en una pista Access (autenticación REST y órdenes) y una pista WebSockets (datos en tiempo real y trading). El ejemplo AutoTrade los une en un motor orientado a eventos donde una estrategia reacciona a eventos de cotizaciones, DOM y gráficos a medida que llegan." },
    { type: "heading",text: "Cómo construir el bot paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Active el acceso a la API y obtenga las credenciales de su app", html: "Primero necesita las claves. Active el complemento <strong class='text-white'>API Access</strong> en su cuenta y anote los tres valores con los que se autenticará su código: <code>appId</code> (un nombre para su app), <code>cid</code> (id de cliente) y <code>sec</code> (secreto de cliente). Los combinará con su nombre de usuario y contraseña normales de Tradovate. Aviso: algunas prop firms restringen o prohíben los bots directos por API en sus cuentas, así que confirme que su firma lo permite antes de construir sobre una cuenta fondeada; las reglas varían según la firma, por lo que debe consultar su acuerdo vigente." },
        { title: "Autentíquese y obtenga un token de acceso", html: "Nada más funciona sin un token. Envíe por POST un cuerpo de credenciales a <code>/auth/accessTokenRequest</code> con su name, password, appId, appVersion, cid, sec y un deviceId. La respuesta devuelve un <code>accessToken</code> que adjunta como <code>Authorization: Bearer</code> en cada llamada posterior. Los tokens duran unos 90 minutos, así que no espere a un 401: llame a <code>/auth/renewAccessToken</code> unos 15 minutos antes de que caduque para mantener la sesión activa. Incluya un <code>deviceId</code> estable; el trading en real aplica la aprobación de dispositivos con más rigor que la demo." },
        { title: "Transmita datos de mercado en vivo por WebSocket", html: "REST sirve para llamadas puntuales, pero un bot necesita un flujo constante, y para eso está el WebSocket. Abra un socket al host de datos de mercado (<code>md.tradovateapi.com</code>), envíe su token de acceso para autorizar y suscríbase a lo que le interese: <code>md/subscribeQuote</code> para precios, o suscripciones de DOM y gráficos para profundidad y barras. A partir de ahí, su código recibe un evento cada vez que el mercado se mueve. Mantenga activo el heartbeat para que la conexión no se caiga en mitad de la sesión." },
        { title: "Convierta su señal en órdenes con placeOrder", html: "Este es el cerebro. En el patrón AutoTrade, su estrategia extiende una clase base e implementa una función <code>next()</code> que funciona como un reducer: toma el estado actual más el evento de mercado entrante y devuelve el estado actualizado. Ahí viven los cálculos de sus indicadores y sus reglas de entrada. Cuando el estado dice «adelante», construya el payload de la orden y envíelo a <code>/order/placeOrder</code>. Ese campo <code>isAutomated</code> importa más de lo que parece. Debe ser <code>true</code> en cualquier orden que dispare un bot o un algoritmo; es un requisito de cumplimiento del CME, no una sugerencia. Si lo omite, está invitando a rechazos. Obtenga <code>accountId</code> y <code>accountSpec</code> de <code>/account/list</code> y use siempre el símbolo del contrato del mes frontal vigente." },
        { title: "Pruebe en demo y luego gestione tokens y límites de tasa", html: "Ejecute todo el ciclo contra el host de demo (<code>demo.tradovateapi.com/v1</code>) hasta que se comporte bien, porque una lógica errónea en el host real (<code>live.tradovateapi.com/v1</code>) cuesta dinero de verdad. Varias cosas hacen tropezar a los bots nuevos: está limitado a 2 sesiones simultáneas, así que un inicio de sesión perdido desconecta el primero; bombardear los endpoints REST activa límites de tasa y una penalización de tiempo <code>p-ticket</code> que debe esperar; y un token caducado lo rompe todo en silencio. Registre cada respuesta y pase a real solo cuando la demo funcione sin errores durante una sesión completa." },
      ],
    },
    { type: "quote",html: "<code>{</code><br><code>&nbsp;&nbsp;\"name\": \"your_username\",</code><br><code>&nbsp;&nbsp;\"password\": \"your_password\",</code><br><code>&nbsp;&nbsp;\"appId\": \"MyTradingBot\",</code><br><code>&nbsp;&nbsp;\"appVersion\": \"1.0\",</code><br><code>&nbsp;&nbsp;\"cid\": 1234,</code><br><code>&nbsp;&nbsp;\"sec\": \"YOUR_CLIENT_SECRET\",</code><br><code>&nbsp;&nbsp;\"deviceId\": \"a-stable-uuid\"</code><br><code>}</code>" },
    { type: "quote",html: "<code>{</code><br><code>&nbsp;&nbsp;\"accountSpec\": \"YOUR_ACCOUNT_NAME\",</code><br><code>&nbsp;&nbsp;\"accountId\": 123456,</code><br><code>&nbsp;&nbsp;\"action\": \"Buy\",</code><br><code>&nbsp;&nbsp;\"symbol\": \"MESU6\",</code><br><code>&nbsp;&nbsp;\"orderQty\": 1,</code><br><code>&nbsp;&nbsp;\"orderType\": \"Market\",</code><br><code>&nbsp;&nbsp;\"isAutomated\": true</code><br><code>}</code>" },
    { type: "heading",text: "Olvídese de la fontanería con PickMyTrade" },
    { type: "paragraph",html: "Construir usted mismo toda la pila, con renovación de tokens, heartbeats de WebSocket, el flag <code>isAutomated</code> y backoff por límites de tasa, es mucho trabajo antes de haber colocado una sola operación estratégica. Si su señal ya vive en TradingView, <strong class='text-white'>PickMyTrade enruta esas alertas directamente a su cuenta de Tradovate</strong> con las órdenes formateadas y marcadas para cumplimiento por usted, sin código de API." },
  ], fr: [
    { type: "paragraph",html: "Un bot de trading semble compliqué jusqu’à ce qu’on le découpe en éléments. Au fond, c’est une boucle : se connecter, surveiller les prix, décider, envoyer un ordre, recommencer. Les exemples JavaScript officiels de Tradovate montrent exactement ce chemin, et vous pouvez suivre la même structure en Python, en C# ou dans le langage qui vous convient. Voici comment les pièces s’assemblent de bout en bout, ainsi que le seul flag qui fait rejeter beaucoup de premiers bots." },
    { type: "heading",text: "Que fait réellement un bot de trading Tradovate ?" },
    { type: "paragraph",html: "Au fond, un bot Tradovate s’authentifie une fois pour obtenir un jeton d’accès, maintient une connexion en direct aux données de marché, exécute votre logique à chaque mise à jour de prix et appelle le point de terminaison d’ordres lorsque vos règles l’exigent. Le dépôt officiel <code>example-api-js</code> le sépare en une piste Access (authentification REST et ordres) et une piste WebSockets (données en temps réel et trading). L’exemple AutoTrade les relie dans un moteur événementiel où une stratégie réagit aux événements de cotations, de DOM et de graphiques à mesure qu’ils arrivent." },
    { type: "heading",text: "Construire le bot pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Activer l’accès à l’API et récupérer les identifiants de votre application", html: "Il vous faut d’abord les clés. Activez le module complémentaire <strong class='text-white'>API Access</strong> sur votre compte, puis notez les trois valeurs avec lesquelles votre code s’authentifiera : <code>appId</code> (un nom pour votre application), <code>cid</code> (identifiant client) et <code>sec</code> (secret client). Vous les associerez à votre nom d’utilisateur et à votre mot de passe Tradovate habituels. Attention : certaines prop firms restreignent ou interdisent les bots API directs sur leurs comptes ; confirmez donc que votre firme l’autorise avant de construire sur un compte financé, les règles varient selon la firme, vérifiez votre contrat en vigueur." },
        { title: "S’authentifier et obtenir un jeton d’accès", html: "Rien d’autre ne fonctionne sans jeton. Envoyez en POST un corps d’identifiants à <code>/auth/accessTokenRequest</code> avec votre name, password, appId, appVersion, cid, sec et un deviceId. La réponse renvoie un <code>accessToken</code> que vous joignez en <code>Authorization: Bearer</code> à chaque appel suivant. Les jetons vivent environ 90 minutes ; n’attendez donc pas un 401 : appelez <code>/auth/renewAccessToken</code> environ 15 minutes avant l’expiration pour garder la session active. Incluez un <code>deviceId</code> stable ; le trading réel applique l’approbation des appareils plus strictement que la démo." },
        { title: "Diffuser les données de marché en direct via WebSocket", html: "REST convient aux appels ponctuels, mais un bot a besoin d’un flux constant, et c’est le rôle du WebSocket. Ouvrez un socket vers l’hôte de données de marché (<code>md.tradovateapi.com</code>), envoyez votre jeton d’accès pour vous autoriser, puis abonnez-vous à ce qui vous intéresse : <code>md/subscribeQuote</code> pour les prix, ou les abonnements DOM et graphiques pour la profondeur et les barres. À partir de là, votre code reçoit un événement chaque fois que le marché bouge. Maintenez le heartbeat actif pour que la connexion ne tombe pas en pleine séance." },
        { title: "Transformer votre signal en ordres avec placeOrder", html: "C’est le cerveau. Dans le modèle AutoTrade, votre stratégie étend une classe de base et implémente une fonction <code>next()</code> qui fonctionne comme un reducer : elle prend l’état courant plus l’événement de marché entrant et renvoie l’état mis à jour. C’est là que résident vos calculs d’indicateurs et vos règles d’entrée. Lorsque l’état dit « go », construisez la charge utile de l’ordre et envoyez-la à <code>/order/placeOrder</code>. Ce champ <code>isAutomated</code> compte plus qu’il n’y paraît. Il doit être <code>true</code> pour tout ordre déclenché par un bot ou un algorithme ; c’est une exigence de conformité du CME, pas une suggestion. Omettez-le et vous appelez les rejets. Récupérez <code>accountId</code> et <code>accountSpec</code> depuis <code>/account/list</code> et utilisez toujours le symbole du contrat du mois en cours." },
        { title: "Tester en démo, puis gérer jetons et limites de débit", html: "Exécutez toute la boucle sur l’hôte de démo (<code>demo.tradovateapi.com/v1</code>) jusqu’à ce qu’elle se comporte bien, car une logique erronée sur l’hôte réel (<code>live.tradovateapi.com/v1</code>) coûte de l’argent réel. Plusieurs choses piègent les nouveaux bots : vous êtes limité à 2 sessions simultanées, de sorte qu’une connexion parasite déconnecte la première ; marteler les points de terminaison REST déclenche des limites de débit et une pénalité de temps <code>p-ticket</code> que vous devez attendre ; et un jeton expiré casse tout silencieusement. Journalisez chaque réponse et ne passez en réel qu’une fois que la démo tourne proprement pendant une séance complète." },
      ],
    },
    { type: "quote",html: "<code>{</code><br><code>&nbsp;&nbsp;\"name\": \"your_username\",</code><br><code>&nbsp;&nbsp;\"password\": \"your_password\",</code><br><code>&nbsp;&nbsp;\"appId\": \"MyTradingBot\",</code><br><code>&nbsp;&nbsp;\"appVersion\": \"1.0\",</code><br><code>&nbsp;&nbsp;\"cid\": 1234,</code><br><code>&nbsp;&nbsp;\"sec\": \"YOUR_CLIENT_SECRET\",</code><br><code>&nbsp;&nbsp;\"deviceId\": \"a-stable-uuid\"</code><br><code>}</code>" },
    { type: "quote",html: "<code>{</code><br><code>&nbsp;&nbsp;\"accountSpec\": \"YOUR_ACCOUNT_NAME\",</code><br><code>&nbsp;&nbsp;\"accountId\": 123456,</code><br><code>&nbsp;&nbsp;\"action\": \"Buy\",</code><br><code>&nbsp;&nbsp;\"symbol\": \"MESU6\",</code><br><code>&nbsp;&nbsp;\"orderQty\": 1,</code><br><code>&nbsp;&nbsp;\"orderType\": \"Market\",</code><br><code>&nbsp;&nbsp;\"isAutomated\": true</code><br><code>}</code>" },
    { type: "heading",text: "Évitez la plomberie avec PickMyTrade" },
    { type: "paragraph",html: "Construire toute la pile vous-même, renouvellement des jetons, heartbeats WebSocket, flag <code>isAutomated</code>, backoff des limites de débit, représente un vrai travail avant même d’avoir passé un seul trade stratégique. Si votre signal se trouve déjà dans TradingView, <strong class='text-white'>PickMyTrade achemine ces alertes directement vers votre compte Tradovate</strong> avec des ordres formatés et marqués pour la conformité à votre place, sans aucun code d’API." },
  ], it: [
    { type: "paragraph",html: "Un bot di trading sembra complicato finché non lo si scompone in parti. Alla base è un ciclo: accedere, osservare i prezzi, decidere, inviare un ordine, ripetere. Gli esempi JavaScript ufficiali di Tradovate mostrano esattamente questo percorso, e può seguire la stessa struttura in Python, C# o nel linguaggio con cui si trova a proprio agio. Ecco come si incastrano i pezzi dall’inizio alla fine, insieme al flag che fa rifiutare molti primi bot." },
    { type: "heading",text: "Cosa fa davvero un bot di trading Tradovate?" },
    { type: "paragraph",html: "In sostanza, un bot Tradovate si autentica una volta per ottenere un token di accesso, mantiene una connessione live ai dati di mercato, esegue la Sua logica a ogni aggiornamento di prezzo e chiama l’endpoint degli ordini quando le Sue regole lo richiedono. Il repository ufficiale <code>example-api-js</code> lo divide in una traccia Access (autenticazione REST e ordini) e una traccia WebSockets (dati in tempo reale e trading). L’esempio AutoTrade li collega in un motore a eventi in cui una strategia reagisce agli eventi di quotazioni, DOM e grafici man mano che arrivano." },
    { type: "heading",text: "Costruire il bot passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Attivi l’accesso all’API e ottenga le credenziali dell’app", html: "Per prima cosa servono le chiavi. Attivi il componente aggiuntivo <strong class='text-white'>API Access</strong> sul Suo conto, quindi annoti i tre valori con cui il Suo codice si autenticherà: <code>appId</code> (un nome per la Sua app), <code>cid</code> (client id) e <code>sec</code> (client secret). Li abbinerà al Suo normale nome utente e password di Tradovate. Attenzione: alcune prop firm limitano o vietano i bot API diretti sui propri conti, quindi verifichi che la Sua società lo consenta prima di costruire su un conto finanziato; le regole variano da società a società, perciò controlli il Suo accordo attuale." },
        { title: "Si autentichi e ottenga un token di accesso", html: "Senza un token non funziona nient’altro. Invii in POST un corpo di credenziali a <code>/auth/accessTokenRequest</code> con name, password, appId, appVersion, cid, sec e un deviceId. La risposta restituisce un <code>accessToken</code> che allegherà come <code>Authorization: Bearer</code> a ogni chiamata successiva. I token durano circa 90 minuti, quindi non aspetti un 401: chiami <code>/auth/renewAccessToken</code> circa 15 minuti prima della scadenza per mantenere viva la sessione. Includa un <code>deviceId</code> stabile; il trading live applica l’approvazione dei dispositivi in modo più rigoroso della demo." },
        { title: "Trasmetta in streaming i dati di mercato live via WebSocket", html: "REST va bene per singole chiamate, ma un bot ha bisogno di un feed costante, ed è per questo che esiste il WebSocket. Apra un socket verso l’host dei dati di mercato (<code>md.tradovateapi.com</code>), invii il token di accesso per autorizzarsi e poi si iscriva a ciò che Le interessa: <code>md/subscribeQuote</code> per i prezzi, oppure le sottoscrizioni DOM e grafici per profondità e barre. Da qui in poi il Suo codice riceve un evento ogni volta che il mercato si muove. Mantenga attivo l’heartbeat in modo che la connessione non cada a metà sessione." },
        { title: "Trasformi il Suo segnale in ordini con placeOrder", html: "Questo è il cervello. Nel pattern AutoTrade, la Sua strategia estende una classe base e implementa una funzione <code>next()</code> che funziona come un reducer: prende lo stato corrente più l’evento di mercato in arrivo e restituisce lo stato aggiornato. Qui risiedono i calcoli degli indicatori e le regole di ingresso. Quando lo stato dice «vai», costruisca il payload dell’ordine e lo invii a <code>/order/placeOrder</code>. Quel campo <code>isAutomated</code> conta più di quanto sembri. Deve essere <code>true</code> per qualsiasi ordine inviato da un bot o da un algoritmo; è un requisito di conformità del CME, non un suggerimento. Se lo omette, invita i rifiuti. Prenda <code>accountId</code> e <code>accountSpec</code> da <code>/account/list</code> e usi sempre il simbolo del contratto front-month corrente." },
        { title: "Testi in demo, poi gestisca token e rate limit", html: "Esegua l’intero ciclo sull’host demo (<code>demo.tradovateapi.com/v1</code>) finché non si comporta bene, perché una logica sbagliata sull’host live (<code>live.tradovateapi.com/v1</code>) costa denaro vero. Diverse cose fanno inciampare i nuovi bot: è limitato a 2 sessioni simultanee, quindi un login accidentale scollega la prima; martellare gli endpoint REST fa scattare i rate limit e una penalità di tempo <code>p-ticket</code> che deve attendere; e un token scaduto rompe tutto in silenzio. Registri ogni risposta e passi al live solo quando la demo gira in modo pulito per un’intera sessione." },
      ],
    },
    { type: "quote",html: "<code>{</code><br><code>&nbsp;&nbsp;\"name\": \"your_username\",</code><br><code>&nbsp;&nbsp;\"password\": \"your_password\",</code><br><code>&nbsp;&nbsp;\"appId\": \"MyTradingBot\",</code><br><code>&nbsp;&nbsp;\"appVersion\": \"1.0\",</code><br><code>&nbsp;&nbsp;\"cid\": 1234,</code><br><code>&nbsp;&nbsp;\"sec\": \"YOUR_CLIENT_SECRET\",</code><br><code>&nbsp;&nbsp;\"deviceId\": \"a-stable-uuid\"</code><br><code>}</code>" },
    { type: "quote",html: "<code>{</code><br><code>&nbsp;&nbsp;\"accountSpec\": \"YOUR_ACCOUNT_NAME\",</code><br><code>&nbsp;&nbsp;\"accountId\": 123456,</code><br><code>&nbsp;&nbsp;\"action\": \"Buy\",</code><br><code>&nbsp;&nbsp;\"symbol\": \"MESU6\",</code><br><code>&nbsp;&nbsp;\"orderQty\": 1,</code><br><code>&nbsp;&nbsp;\"orderType\": \"Market\",</code><br><code>&nbsp;&nbsp;\"isAutomated\": true</code><br><code>}</code>" },
    { type: "heading",text: "Salti l’infrastruttura con PickMyTrade" },
    { type: "paragraph",html: "Costruire da sé l’intero stack, rinnovo dei token, heartbeat WebSocket, flag <code>isAutomated</code>, backoff dei rate limit, è lavoro vero prima ancora di aver eseguito un solo trade strategico. Se il Suo segnale vive già in TradingView, <strong class='text-white'>PickMyTrade instrada quegli alert direttamente nel Suo conto Tradovate</strong> con gli ordini formattati e contrassegnati per la conformità al posto Suo, senza alcun codice API." },
  ] },
  ctaHeading: { en: "Skip Building the Bot Yourself", de: "Sparen Sie sich den Bot-Eigenbau", es: "Ahórrese construir el bot usted mismo", fr: "Évitez de construire le bot vous-même", it: "Eviti di costruire il bot da sé" },
  ctaText: { en: "Token renewal, WebSocket heartbeats, and rate-limit backoff are real work. Let PickMyTrade route your TradingView alerts to Tradovate instead.", de: "Token-Erneuerung, WebSocket-Heartbeats und Rate-Limit-Backoff sind echte Arbeit. Lassen Sie stattdessen PickMyTrade Ihre TradingView-Alerts an Tradovate weiterleiten.", es: "La renovación de tokens, los heartbeats de WebSocket y el backoff por límites de tasa son trabajo de verdad. Deje que PickMyTrade enrute sus alertas de TradingView a Tradovate.", fr: "Le renouvellement des jetons, les heartbeats WebSocket et le backoff des limites de débit représentent un vrai travail. Laissez plutôt PickMyTrade acheminer vos alertes TradingView vers Tradovate.", it: "Rinnovo dei token, heartbeat WebSocket e backoff dei rate limit sono lavoro vero. Lasci che sia PickMyTrade a instradare i Suoi alert di TradingView verso Tradovate." },
