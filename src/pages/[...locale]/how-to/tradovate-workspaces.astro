---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-workspaces";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Save, Export & Import Tradovate Workspaces";
const META_DESCRIPTION =
  "Save your full Tradovate chart, DOM, and drawing layout as a named workspace, then export it to a file and import it on any device in seconds.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate-Arbeitsbereiche speichern, exportieren und importieren", es: "Guarde, exporte e importe espacios de trabajo de Tradovate", fr: "Enregistrer, exporter et importer des espaces de travail Tradovate", it: "Salvare, esportare e importare gli spazi di lavoro di Tradovate" },
  dek: { en: "Rebuilding your charts, DOMs, and drawn levels from scratch every time you refresh or switch machines gets old fast. Save your full Tradovate layout as a named workspace once, then export and import it anywhere in seconds.", de: "Charts, DOMs und eingezeichnete Level bei jedem Neuladen oder Rechnerwechsel von Grund auf neu aufzubauen, nervt schnell. Speichern Sie Ihr komplettes Tradovate-Layout einmal als benannten Arbeitsbereich und exportieren und importieren Sie es dann in Sekunden überall.", es: "Reconstruir desde cero sus gráficos, DOMs y niveles dibujados cada vez que actualiza la página o cambia de equipo acaba cansando. Guarde su diseño completo de Tradovate como un espacio de trabajo con nombre una sola vez y luego expórtelo e impórtelo en cualquier lugar en segundos.", fr: "Reconstruire vos graphiques, vos DOM et vos niveaux tracés de zéro à chaque actualisation ou changement de machine finit par lasser. Enregistrez une fois l'intégralité de votre disposition Tradovate comme espace de travail nommé, puis exportez-la et importez-la n'importe où en quelques secondes.", it: "Ricostruire da zero grafici, DOM e livelli tracciati a ogni aggiornamento o cambio di computer stanca presto. Salvi una volta sola l'intero layout di Tradovate come spazio di lavoro con nome, poi lo esporti e lo importi ovunque in pochi secondi." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-10",
  heroImage: { src: `${IMG}/tradovate-workspaces-1.png`, alt: { en: "Tradovate workspace menu open in the top-left corner showing saved layouts and create, export, and import options", de: "Tradovate workspace menu open in the top-left corner showing saved layouts and create, export, and import options", es: "Tradovate workspace menu open in the top-left corner showing saved layouts and create, export, and import options", fr: "Tradovate workspace menu open in the top-left corner showing saved layouts and create, export, and import options", it: "Tradovate workspace menu open in the top-left corner showing saved layouts and create, export, and import options" } },
  blocks: { en: [
    { type: "paragraph", html: "You've arranged your charts, stacked a couple of DOMs, loaded your watchlist, and marked up your key levels. Then you refresh the page, or open Tradovate on a different laptop, and it's all gone. Workspaces are the fix. <strong class='text-white'>A workspace is a named snapshot of your whole layout</strong>, and you can save it, reload it in one click, export it to a file, and pull it back in on any machine. Here's how to do all three." },
    { type: "heading", text: "What Are Tradovate Workspaces?" },
    { type: "paragraph", html: "A workspace stores where every module sits on your screen, which symbols are loaded, your chart timeframes and styles, and the trendlines, zones, and support/resistance lines you've drawn. Reload it and your desk comes back exactly how you left it." },
    { type: "paragraph", html: "One detail worth pinning down early, because it trips people up: <strong class='text-white'>your drawings save inside the workspace, not inside a chart template.</strong> A chart template only carries indicator settings and chart styling. So if you live and die by your marked-up levels, the workspace is what protects them, not the template." },
    {
      type: "table",
      headers: ["What it holds", "Workspace", "Chart template"],
      rows: [
        ["Module layout and window positions", "Yes", "No"],
        ["Loaded symbols and timeframes", "Yes", "No"],
        ["Indicators and chart styling", "Yes", "Yes"],
        ["Trendlines, zones, and S/R drawings", "Yes", "No"],
      ],
    },
    { type: "heading", text: "Save, Export & Import Tradovate Workspaces: Step-by-Step" },
    { type: "paragraph", html: "The workspace controls live in the menu at the top-left of the Tradovate web and desktop apps. Button names have shifted a little between platform versions, so if a label below doesn't match your screen exactly, look for the matching icon in that same top-left menu." },
    {
      type: "steps",
      items: [
        { title: "Open the Workspace Menu", html: "Head to the top-left corner of the app and open the workspace menu. You'll see the name of your current workspace plus any layouts you've already saved, with options to create a new one, load an existing one, export, and import. Everything in this guide starts from here." },
        { title: "Create and Name a New Workspace", html: "Set your charts, DOMs, and modules the way you want them, then choose the option to create a new workspace. Give it a clear name, something like <code>scalping-nq</code> or <code>swing-es</code>, and confirm. Descriptive names pay off fast once you're flipping between several setups mid-session instead of squinting at &ldquo;Workspace 3.&rdquo;" },
        { title: "Save Your Changes", html: "A workspace doesn't lock in every tweak the instant you make it, so once your layout looks right, save it. Any time you redraw levels, add an indicator, or move a panel, save again to fold those changes into the named workspace. If you're constantly re-marking zones, build the habit of saving often, it's the cheapest insurance there is against losing a morning's prep." },
        { title: "Export a Workspace to a File", html: "To back a workspace up or move it somewhere else, export it. Open the workspace menu, find the layout you want, and use the export control next to its name (an up-arrow icon). Tradovate downloads the workspace as a <code>.json</code> file to your computer. Keep that file somewhere safe, it's a full copy of your setup you can restore any time, and it costs nothing to make one before a big platform update." },
        { title: "Import a Workspace From a File", html: "On another machine, a different login, or after a trading partner sends you their layout, choose Import From File in the workspace menu and pick the <code>.json</code> you saved. Your imported workspace shows up in the list, ready to load. One limit to know up front: workspaces from the Tradovate web app aren't compatible with the NinjaTrader Desktop app, so you can't shuttle a layout between those two." },
      ],
    },
    { type: "image", src: `${IMG}/tradovate-workspaces-2.png`, alt: "Tradovate new workspace dialog with a name typed into the workspace name field" },
    { type: "image", src: `${IMG}/tradovate-workspaces-3.png`, alt: "Tradovate workspace menu with the Save option highlighted after a layout change" },
    { type: "image", src: `${IMG}/tradovate-workspaces-4.png`, alt: "Tradovate workspace menu showing the up-arrow export icon that downloads the layout as a JSON file" },
    { type: "image", src: `${IMG}/tradovate-workspaces-5.png`, alt: "Tradovate Import From File option in the workspace menu with a JSON workspace file selected" },
    { type: "heading", text: "Why You'd Need This" },
    {
      type: "list",
      items: [
        "Never lose your layout to a refresh, a crash, or a switch to a new device again.",
        "Keep separate workspaces for separate strategies and jump between them in one click.",
        "Back up your whole setup as a file before a platform update or a reinstall.",
        "Move your exact layout to a new laptop without rebuilding it from scratch.",
        "Hand a proven setup to a trading partner or mentor as a single file.",
      ],
    },
    { type: "heading", text: "Automate This With PickMyTrade" },
    { type: "paragraph", html: "A saved workspace keeps your charts and levels ready, but you're still the one placing every order. If you'd rather your entries, stops, and exits fire on their own, <strong class='text-white'>PickMyTrade wires your TradingView alerts straight to your Tradovate account</strong> so trades execute automatically while your layout stays exactly how you built it." },
  ], de: [
    { type: "paragraph",html: "Sie haben Ihre Charts angeordnet, ein paar DOMs gestapelt, Ihre Watchlist geladen und Ihre wichtigen Level eingezeichnet. Dann laden Sie die Seite neu oder öffnen Tradovate auf einem anderen Laptop, und alles ist weg. Arbeitsbereiche sind die Lösung. <strong class='text-white'>Ein Arbeitsbereich ist ein benannter Schnappschuss Ihres gesamten Layouts</strong>, den Sie speichern, mit einem Klick neu laden, in eine Datei exportieren und auf jedem Rechner wieder importieren können. So gehen Sie bei allen drei Schritten vor." },
    { type: "heading",text: "Was sind Tradovate-Arbeitsbereiche?" },
    { type: "paragraph",html: "Ein Arbeitsbereich speichert, wo jedes Modul auf Ihrem Bildschirm sitzt, welche Symbole geladen sind, Ihre Chart-Zeitrahmen und -Stile sowie die Trendlinien, Zonen und Unterstützungs-/Widerstandslinien, die Sie gezeichnet haben. Laden Sie ihn neu, und Ihr Schreibtisch kehrt genau so zurück, wie Sie ihn verlassen haben." },
    { type: "paragraph",html: "Ein Detail, das Sie früh festhalten sollten, weil es viele ins Stolpern bringt: <strong class='text-white'>Ihre Zeichnungen werden im Arbeitsbereich gespeichert, nicht in einer Chart-Vorlage.</strong> Eine Chart-Vorlage enthält nur Indikatoreinstellungen und das Chart-Styling. Wenn Sie also auf Ihre eingezeichneten Level angewiesen sind, schützt der Arbeitsbereich sie, nicht die Vorlage." },
    { type: "table", headers: ["Was gespeichert wird","Arbeitsbereich","Chart-Vorlage"], rows: [
      ["Modul-Layout und Fensterpositionen","Ja","Nein"],
      ["Geladene Symbole und Zeitrahmen","Ja","Nein"],
      ["Indikatoren und Chart-Styling","Ja","Ja"],
      ["Trendlinien, Zonen und S/R-Zeichnungen","Ja","Nein"],
    ] },
    { type: "heading",text: "Tradovate-Arbeitsbereiche speichern, exportieren und importieren: Schritt für Schritt" },
    { type: "paragraph",html: "Die Steuerelemente für Arbeitsbereiche befinden sich im Menü oben links in der Tradovate-Web- und -Desktop-App. Die Namen der Schaltflächen haben sich zwischen Plattformversionen etwas verschoben. Wenn eine Bezeichnung unten also nicht exakt zu Ihrem Bildschirm passt, suchen Sie im selben Menü oben links nach dem passenden Symbol." },
    {
      type: "steps",
      items: [
        { title: "Arbeitsbereich-Menü öffnen", html: "Gehen Sie in die obere linke Ecke der App und öffnen Sie das Arbeitsbereich-Menü. Sie sehen den Namen Ihres aktuellen Arbeitsbereichs sowie alle bereits gespeicherten Layouts, dazu Optionen zum Erstellen eines neuen, Laden eines vorhandenen, Exportieren und Importieren. Alles in dieser Anleitung beginnt hier." },
        { title: "Neuen Arbeitsbereich erstellen und benennen", html: "Richten Sie Ihre Charts, DOMs und Module so ein, wie Sie sie haben möchten, und wählen Sie dann die Option zum Erstellen eines neuen Arbeitsbereichs. Geben Sie ihm einen klaren Namen, etwa <code>scalping-nq</code> oder <code>swing-es</code>, und bestätigen Sie. Aussagekräftige Namen zahlen sich schnell aus, wenn Sie mitten in der Sitzung zwischen mehreren Setups wechseln, statt auf &ldquo;Workspace 3.&rdquo; zu starren." },
        { title: "Änderungen speichern", html: "Ein Arbeitsbereich übernimmt nicht jede Änderung in dem Moment, in dem Sie sie vornehmen. Sobald Ihr Layout stimmt, speichern Sie es also. Jedes Mal, wenn Sie Level neu einzeichnen, einen Indikator hinzufügen oder ein Fenster verschieben, speichern Sie erneut, um die Änderungen in den benannten Arbeitsbereich zu übernehmen. Wenn Sie ständig Zonen neu markieren, machen Sie häufiges Speichern zur Gewohnheit, es ist die günstigste Versicherung gegen den Verlust der Vorbereitung eines ganzen Vormittags." },
        { title: "Arbeitsbereich in eine Datei exportieren", html: "Um einen Arbeitsbereich zu sichern oder anderswohin zu verschieben, exportieren Sie ihn. Öffnen Sie das Arbeitsbereich-Menü, suchen Sie das gewünschte Layout und nutzen Sie das Export-Steuerelement neben seinem Namen (ein Pfeil-nach-oben-Symbol). Tradovate lädt den Arbeitsbereich als <code>.json</code>-Datei auf Ihren Computer herunter. Bewahren Sie diese Datei sicher auf, sie ist eine vollständige Kopie Ihres Setups, die Sie jederzeit wiederherstellen können, und es kostet nichts, vor einem großen Plattform-Update eine anzulegen." },
        { title: "Arbeitsbereich aus einer Datei importieren", html: "Auf einem anderen Rechner, mit einem anderen Login oder nachdem ein Trading-Partner Ihnen sein Layout geschickt hat, wählen Sie im Arbeitsbereich-Menü Import From File und wählen die gespeicherte <code>.json</code>-Datei aus. Ihr importierter Arbeitsbereich erscheint in der Liste und ist bereit zum Laden. Eine Einschränkung vorab: Arbeitsbereiche der Tradovate-Web-App sind nicht mit der NinjaTrader-Desktop-App kompatibel, Sie können also kein Layout zwischen diesen beiden hin- und herschieben." },
      ],
    },
    { type: "image",src: `${IMG}/tradovate-workspaces-2.png`,alt: "Tradovate-Dialog „Neuer Arbeitsbereich“ mit einem im Namensfeld eingegebenen Arbeitsbereich-Namen" },
    { type: "image",src: `${IMG}/tradovate-workspaces-3.png`,alt: "Tradovate-Arbeitsbereich-Menü mit hervorgehobener Option „Save“ nach einer Layout-Änderung" },
    { type: "image",src: `${IMG}/tradovate-workspaces-4.png`,alt: "Tradovate-Arbeitsbereich-Menü mit dem Pfeil-nach-oben-Export-Symbol, das das Layout als JSON-Datei herunterlädt" },
    { type: "image",src: `${IMG}/tradovate-workspaces-5.png`,alt: "Tradovate-Option „Import From File“ im Arbeitsbereich-Menü mit einer ausgewählten JSON-Arbeitsbereich-Datei" },
    { type: "heading",text: "Warum Sie das brauchen" },
    {
      type: "list",
      items: [
        "Verlieren Sie Ihr Layout nie wieder durch ein Neuladen, einen Absturz oder einen Gerätewechsel.",
        "Führen Sie getrennte Arbeitsbereiche für getrennte Strategien und wechseln Sie mit einem Klick zwischen ihnen.",
        "Sichern Sie Ihr gesamtes Setup als Datei vor einem Plattform-Update oder einer Neuinstallation.",
        "Übertragen Sie Ihr exaktes Layout auf einen neuen Laptop, ohne es von Grund auf neu aufzubauen.",
        "Geben Sie ein bewährtes Setup als einzelne Datei an einen Trading-Partner oder Mentor weiter.",
      ],
    },
    { type: "heading",text: "Automatisieren Sie das mit PickMyTrade" },
    { type: "paragraph",html: "Ein gespeicherter Arbeitsbereich hält Ihre Charts und Level bereit, aber Sie sind weiterhin derjenige, der jede Order platziert. Wenn Ihre Einstiege, Stopps und Ausstiege lieber von selbst ausgelöst werden sollen: <strong class='text-white'>PickMyTrade leitet Ihre TradingView-Alerts direkt an Ihr Tradovate-Konto weiter</strong>, sodass Trades automatisch ausgeführt werden, während Ihr Layout genau so bleibt, wie Sie es aufgebaut haben." },
  ], es: [
    { type: "paragraph",html: "Ha organizado sus gráficos, apilado un par de DOMs, cargado su lista de seguimiento y marcado sus niveles clave. Entonces actualiza la página, o abre Tradovate en otro portátil, y todo ha desaparecido. Los espacios de trabajo son la solución. <strong class='text-white'>Un espacio de trabajo es una instantánea con nombre de todo su diseño</strong>, y puede guardarlo, recargarlo con un clic, exportarlo a un archivo e importarlo de nuevo en cualquier equipo. Así se hacen las tres cosas." },
    { type: "heading",text: "¿Qué son los espacios de trabajo de Tradovate?" },
    { type: "paragraph",html: "Un espacio de trabajo almacena dónde está cada módulo en su pantalla, qué símbolos están cargados, los marcos temporales y estilos de sus gráficos, y las líneas de tendencia, zonas y líneas de soporte/resistencia que ha dibujado. Recárguelo y su escritorio vuelve exactamente como lo dejó." },
    { type: "paragraph",html: "Un detalle que conviene dejar claro desde el principio, porque confunde a muchos: <strong class='text-white'>sus dibujos se guardan dentro del espacio de trabajo, no dentro de una plantilla de gráfico.</strong> Una plantilla de gráfico solo contiene la configuración de indicadores y el estilo del gráfico. Así que, si vive y muere por sus niveles marcados, lo que los protege es el espacio de trabajo, no la plantilla." },
    { type: "table", headers: ["Qué contiene","Espacio de trabajo","Plantilla de gráfico"], rows: [
      ["Diseño de módulos y posiciones de ventanas","Sí","No"],
      ["Símbolos y marcos temporales cargados","Sí","No"],
      ["Indicadores y estilo del gráfico","Sí","Sí"],
      ["Líneas de tendencia, zonas y dibujos de S/R","Sí","No"],
    ] },
    { type: "heading",text: "Guardar, exportar e importar espacios de trabajo de Tradovate: paso a paso" },
    { type: "paragraph",html: "Los controles de espacios de trabajo están en el menú de la parte superior izquierda de las aplicaciones web y de escritorio de Tradovate. Los nombres de los botones han cambiado un poco entre versiones de la plataforma, así que, si una etiqueta de abajo no coincide exactamente con su pantalla, busque el icono equivalente en ese mismo menú superior izquierdo." },
    {
      type: "steps",
      items: [
        { title: "Abra el menú de espacios de trabajo", html: "Diríjase a la esquina superior izquierda de la aplicación y abra el menú de espacios de trabajo. Verá el nombre de su espacio de trabajo actual y los diseños que ya haya guardado, con opciones para crear uno nuevo, cargar uno existente, exportar e importar. Todo lo de esta guía empieza aquí." },
        { title: "Cree un espacio de trabajo nuevo y póngale nombre", html: "Disponga sus gráficos, DOMs y módulos como quiera y luego elija la opción de crear un espacio de trabajo nuevo. Dele un nombre claro, algo como <code>scalping-nq</code> o <code>swing-es</code>, y confirme. Los nombres descriptivos compensan enseguida cuando alterna entre varias configuraciones a mitad de sesión en lugar de entrecerrar los ojos ante &ldquo;Workspace 3.&rdquo;" },
        { title: "Guarde sus cambios", html: "Un espacio de trabajo no fija cada ajuste en el instante en que lo hace, así que, cuando su diseño esté como quiere, guárdelo. Cada vez que vuelva a dibujar niveles, añada un indicador o mueva un panel, guarde de nuevo para incorporar esos cambios al espacio de trabajo con nombre. Si está remarcando zonas constantemente, adquiera el hábito de guardar a menudo; es el seguro más barato contra perder la preparación de toda una mañana." },
        { title: "Exporte un espacio de trabajo a un archivo", html: "Para respaldar un espacio de trabajo o trasladarlo a otro sitio, expórtelo. Abra el menú de espacios de trabajo, localice el diseño que quiere y use el control de exportación junto a su nombre (un icono de flecha hacia arriba). Tradovate descarga el espacio de trabajo como un archivo <code>.json</code> en su ordenador. Guarde ese archivo en un lugar seguro: es una copia completa de su configuración que puede restaurar en cualquier momento, y no cuesta nada hacer una antes de una gran actualización de la plataforma." },
        { title: "Importe un espacio de trabajo desde un archivo", html: "En otro equipo, con otro inicio de sesión o cuando un compañero de trading le envíe su diseño, elija Import From File en el menú de espacios de trabajo y seleccione el <code>.json</code> que guardó. Su espacio de trabajo importado aparecerá en la lista, listo para cargarse. Una limitación que conviene conocer de antemano: los espacios de trabajo de la aplicación web de Tradovate no son compatibles con la aplicación NinjaTrader Desktop, por lo que no puede pasar un diseño de una a otra." },
      ],
    },
    { type: "image",src: `${IMG}/tradovate-workspaces-2.png`,alt: "Cuadro de diálogo de nuevo espacio de trabajo de Tradovate con un nombre escrito en el campo de nombre del espacio de trabajo" },
    { type: "image",src: `${IMG}/tradovate-workspaces-3.png`,alt: "Menú de espacios de trabajo de Tradovate con la opción Save resaltada tras un cambio de diseño" },
    { type: "image",src: `${IMG}/tradovate-workspaces-4.png`,alt: "Menú de espacios de trabajo de Tradovate con el icono de exportación de flecha hacia arriba que descarga el diseño como archivo JSON" },
    { type: "image",src: `${IMG}/tradovate-workspaces-5.png`,alt: "Opción Import From File de Tradovate en el menú de espacios de trabajo con un archivo de espacio de trabajo JSON seleccionado" },
    { type: "heading",text: "Por qué lo necesitaría" },
    {
      type: "list",
      items: [
        "No vuelva a perder su diseño por una actualización de página, un fallo o un cambio de dispositivo.",
        "Mantenga espacios de trabajo separados para estrategias distintas y salte de uno a otro con un solo clic.",
        "Haga una copia de seguridad de toda su configuración como archivo antes de una actualización de la plataforma o una reinstalación.",
        "Traslade su diseño exacto a un portátil nuevo sin reconstruirlo desde cero.",
        "Entregue una configuración probada a un compañero de trading o mentor en un único archivo.",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Un espacio de trabajo guardado mantiene listos sus gráficos y niveles, pero sigue siendo usted quien coloca cada orden. Si prefiere que sus entradas, stops y salidas se ejecuten solos, <strong class='text-white'>PickMyTrade conecta sus alertas de TradingView directamente con su cuenta de Tradovate</strong> para que las operaciones se ejecuten automáticamente mientras su diseño sigue exactamente como lo construyó." },
  ], fr: [
    { type: "paragraph",html: "Vous avez organisé vos graphiques, empilé quelques DOM, chargé votre liste de suivi et annoté vos niveaux clés. Puis vous actualisez la page, ou vous ouvrez Tradovate sur un autre ordinateur portable, et tout a disparu. Les espaces de travail sont la solution. <strong class='text-white'>Un espace de travail est un instantané nommé de toute votre disposition</strong>, que vous pouvez enregistrer, recharger en un clic, exporter vers un fichier et réimporter sur n'importe quelle machine. Voici comment faire les trois." },
    { type: "heading",text: "Que sont les espaces de travail Tradovate ?" },
    { type: "paragraph",html: "Un espace de travail mémorise l'emplacement de chaque module à l'écran, les symboles chargés, les unités de temps et les styles de vos graphiques, ainsi que les lignes de tendance, les zones et les lignes de support/résistance que vous avez tracées. Rechargez-le et votre poste de travail revient exactement comme vous l'aviez laissé." },
    { type: "paragraph",html: "Un détail à bien noter dès le départ, car il piège beaucoup de monde : <strong class='text-white'>vos dessins sont enregistrés dans l'espace de travail, et non dans un modèle de graphique.</strong> Un modèle de graphique ne contient que les réglages des indicateurs et le style du graphique. Si vous tenez à vos niveaux annotés, c'est donc l'espace de travail qui les protège, pas le modèle." },
    { type: "table", headers: ["Ce qu'il contient","Espace de travail","Modèle de graphique"], rows: [
      ["Disposition des modules et position des fenêtres","Oui","Non"],
      ["Symboles et unités de temps chargés","Oui","Non"],
      ["Indicateurs et style du graphique","Oui","Oui"],
      ["Lignes de tendance, zones et dessins S/R","Oui","Non"],
    ] },
    { type: "heading",text: "Enregistrer, exporter et importer des espaces de travail Tradovate : pas à pas" },
    { type: "paragraph",html: "Les commandes des espaces de travail se trouvent dans le menu en haut à gauche des applications web et de bureau Tradovate. Les noms des boutons ont un peu évolué d'une version de la plateforme à l'autre ; si un libellé ci-dessous ne correspond pas exactement à votre écran, cherchez l'icône équivalente dans ce même menu en haut à gauche." },
    {
      type: "steps",
      items: [
        { title: "Ouvrir le menu des espaces de travail", html: "Rendez-vous dans le coin supérieur gauche de l'application et ouvrez le menu des espaces de travail. Vous y verrez le nom de votre espace de travail actuel ainsi que les dispositions déjà enregistrées, avec des options pour en créer un nouveau, en charger un existant, exporter et importer. Tout ce guide commence ici." },
        { title: "Créer et nommer un nouvel espace de travail", html: "Disposez vos graphiques, vos DOM et vos modules comme vous le souhaitez, puis choisissez l'option de création d'un nouvel espace de travail. Donnez-lui un nom clair, par exemple <code>scalping-nq</code> ou <code>swing-es</code>, et confirmez. Les noms descriptifs se révèlent vite payants quand vous passez d'une configuration à l'autre en pleine séance au lieu de plisser les yeux devant &ldquo;Workspace 3.&rdquo;" },
        { title: "Enregistrer vos modifications", html: "Un espace de travail ne fige pas chaque ajustement à l'instant où vous le faites ; une fois votre disposition au point, enregistrez-la donc. Chaque fois que vous retracez des niveaux, ajoutez un indicateur ou déplacez un panneau, enregistrez à nouveau pour intégrer ces changements à l'espace de travail nommé. Si vous retracez constamment des zones, prenez l'habitude d'enregistrer souvent : c'est l'assurance la moins chère contre la perte de la préparation d'une matinée." },
        { title: "Exporter un espace de travail vers un fichier", html: "Pour sauvegarder un espace de travail ou le déplacer ailleurs, exportez-le. Ouvrez le menu des espaces de travail, trouvez la disposition voulue et utilisez la commande d'exportation à côté de son nom (une icône de flèche vers le haut). Tradovate télécharge l'espace de travail sous forme de fichier <code>.json</code> sur votre ordinateur. Conservez ce fichier en lieu sûr : c'est une copie complète de votre configuration que vous pouvez restaurer à tout moment, et en faire une avant une grosse mise à jour de la plateforme ne coûte rien." },
        { title: "Importer un espace de travail depuis un fichier", html: "Sur une autre machine, avec un autre identifiant, ou lorsqu'un partenaire de trading vous envoie sa disposition, choisissez Import From File dans le menu des espaces de travail et sélectionnez le <code>.json</code> enregistré. Votre espace de travail importé apparaît dans la liste, prêt à être chargé. Une limite à connaître d'emblée : les espaces de travail de l'application web Tradovate ne sont pas compatibles avec l'application NinjaTrader Desktop ; vous ne pouvez donc pas faire circuler une disposition entre les deux." },
      ],
    },
    { type: "image",src: `${IMG}/tradovate-workspaces-2.png`,alt: "Boîte de dialogue de nouvel espace de travail Tradovate avec un nom saisi dans le champ du nom de l'espace de travail" },
    { type: "image",src: `${IMG}/tradovate-workspaces-3.png`,alt: "Menu des espaces de travail Tradovate avec l'option Save en surbrillance après une modification de la disposition" },
    { type: "image",src: `${IMG}/tradovate-workspaces-4.png`,alt: "Menu des espaces de travail Tradovate montrant l'icône d'exportation en flèche vers le haut qui télécharge la disposition au format JSON" },
    { type: "image",src: `${IMG}/tradovate-workspaces-5.png`,alt: "Option Import From File de Tradovate dans le menu des espaces de travail avec un fichier d'espace de travail JSON sélectionné" },
    { type: "heading",text: "Pourquoi vous en auriez besoin" },
    {
      type: "list",
      items: [
        "Ne perdez plus jamais votre disposition à cause d'une actualisation, d'un plantage ou d'un changement d'appareil.",
