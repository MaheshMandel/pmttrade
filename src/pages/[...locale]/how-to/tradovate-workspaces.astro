  ctaHeading: { en: "Automate Your Tradovate Trades", de: "Automatisieren Sie Ihre Tradovate-Trades", es: "Automatice sus operaciones de Tradovate", fr: "Automatisez vos trades Tradovate", it: "Automatizzi i Suoi trade su Tradovate" },
  ctaText: { en: "Keep your charts, DOMs, and drawn levels exactly how you built them, and let PickMyTrade handle entries, stops, and exits automatically.", de: "Behalten Sie Ihre Charts, DOMs und eingezeichneten Level genau so, wie Sie sie aufgebaut haben, und überlassen Sie Einstiege, Stopps und Ausstiege automatisch PickMyTrade.", es: "Mantenga sus gráficos, DOMs y niveles dibujados exactamente como los construyó y deje que PickMyTrade gestione automáticamente entradas, stops y salidas.", fr: "Gardez vos graphiques, vos DOM et vos niveaux tracés exactement comme vous les avez construits, et laissez PickMyTrade gérer automatiquement les entrées, les stops et les sorties.", it: "Mantenga grafici, DOM e livelli tracciati esattamente come li ha costruiti e lasci che PickMyTrade gestisca automaticamente ingressi, stop e uscite." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Foire aux questions", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Where are my Tradovate workspaces stored?", a: "They're saved to your account, so they follow you when you log in on the web or desktop app. Export a workspace to a .json file when you want an offline backup or need to move a layout to a different login." },
    { q: "Do my chart drawings save with the workspace?", a: "Yes. Trendlines, zones, and support/resistance lines live inside the workspace, not the chart template. Save the workspace after you mark up your levels, or you risk losing them the next time the layout reloads." },
    { q: "Can I import a Tradovate workspace into NinjaTrader?", a: "No. Web-app workspaces and NinjaTrader Desktop workspaces aren't interchangeable. Export and import work between the Tradovate web and desktop apps, not across to NinjaTrader." },
  ], de: [
    { q: "Wo werden meine Tradovate-Arbeitsbereiche gespeichert?", a: "Sie werden in Ihrem Konto gespeichert und folgen Ihnen daher, wenn Sie sich in der Web- oder Desktop-App anmelden. Exportieren Sie einen Arbeitsbereich in eine .json-Datei, wenn Sie eine Offline-Sicherung möchten oder ein Layout auf ein anderes Login übertragen müssen." },
    { q: "Werden meine Chart-Zeichnungen mit dem Arbeitsbereich gespeichert?", a: "Ja. Trendlinien, Zonen sowie Unterstützungs- und Widerstandslinien liegen im Arbeitsbereich, nicht in der Chart-Vorlage. Speichern Sie den Arbeitsbereich, nachdem Sie Ihre Level eingezeichnet haben, sonst riskieren Sie, sie beim nächsten Neuladen des Layouts zu verlieren." },
    { q: "Kann ich einen Tradovate-Arbeitsbereich in NinjaTrader importieren?", a: "Nein. Arbeitsbereiche der Web-App und Arbeitsbereiche von NinjaTrader Desktop sind nicht austauschbar. Export und Import funktionieren zwischen der Tradovate-Web-App und der Desktop-App, nicht hinüber zu NinjaTrader." },
  ], es: [
    { q: "¿Dónde se almacenan mis espacios de trabajo de Tradovate?", a: "Se guardan en su cuenta, por lo que le acompañan cuando inicia sesión en la aplicación web o de escritorio. Exporte un espacio de trabajo a un archivo .json cuando quiera una copia de seguridad sin conexión o necesite trasladar un diseño a otro inicio de sesión." },
    { q: "¿Se guardan mis dibujos de gráfico con el espacio de trabajo?", a: "Sí. Las líneas de tendencia, las zonas y las líneas de soporte/resistencia viven dentro del espacio de trabajo, no de la plantilla de gráfico. Guarde el espacio de trabajo después de marcar sus niveles; de lo contrario, corre el riesgo de perderlos la próxima vez que se recargue el diseño." },
    { q: "¿Puedo importar un espacio de trabajo de Tradovate en NinjaTrader?", a: "No. Los espacios de trabajo de la aplicación web y los de NinjaTrader Desktop no son intercambiables. La exportación y la importación funcionan entre la aplicación web y la de escritorio de Tradovate, no hacia NinjaTrader." },
  ], fr: [
    { q: "Où sont stockés mes espaces de travail Tradovate ?", a: "Ils sont enregistrés sur votre compte et vous suivent donc lorsque vous vous connectez à l'application web ou de bureau. Exportez un espace de travail vers un fichier .json lorsque vous voulez une sauvegarde hors ligne ou que vous devez déplacer une disposition vers un autre identifiant." },
    { q: "Mes dessins de graphique sont-ils enregistrés avec l'espace de travail ?", a: "Oui. Les lignes de tendance, les zones et les lignes de support/résistance se trouvent dans l'espace de travail, et non dans le modèle de graphique. Enregistrez l'espace de travail après avoir annoté vos niveaux, sous peine de les perdre au prochain rechargement de la disposition." },
    { q: "Puis-je importer un espace de travail Tradovate dans NinjaTrader ?", a: "Non. Les espaces de travail de l'application web et ceux de NinjaTrader Desktop ne sont pas interchangeables. L'exportation et l'importation fonctionnent entre l'application web et l'application de bureau Tradovate, pas vers NinjaTrader." },
  ], it: [
    { q: "Dove vengono salvati i miei spazi di lavoro di Tradovate?", a: "Vengono salvati nel Suo account, quindi La seguono quando accede all'app web o desktop. Esporti uno spazio di lavoro in un file .json quando desidera un backup offline o deve spostare un layout su un altro login." },
    { q: "I miei disegni sul grafico vengono salvati con lo spazio di lavoro?", a: "Sì. Trendline, zone e linee di supporto/resistenza risiedono nello spazio di lavoro, non nel modello di grafico. Salvi lo spazio di lavoro dopo aver segnato i Suoi livelli, altrimenti rischia di perderli alla successiva ricarica del layout." },
    { q: "Posso importare uno spazio di lavoro di Tradovate in NinjaTrader?", a: "No. Gli spazi di lavoro dell'app web e quelli di NinjaTrader Desktop non sono intercambiabili. Esportazione e importazione funzionano tra l'app web e l'app desktop di Tradovate, non verso NinjaTrader." },
  ] },
  relatedHeading: { en: "Related Guides", de: "Verwandte Anleitungen", es: "Guías relacionadas", fr: "Guides connexes", it: "Guide correlate" },
  disclosureText: { en: "This guide is for educational and informational purposes only and is not financial, investment, or trading advice. Trading futures and other leveraged products carries a substantial risk of loss and is not suitable for every investor. PickMyTrade is an independent third-party automation platform and is not affiliated with, endorsed by, or sponsored by Tradovate, Inc. All related names, logos, and trademarks are the property of their respective owners. Platform features and steps change over time, so always confirm the current process in the official Tradovate platform and documentation before acting.", de: "Diese Anleitung dient ausschließlich Bildungs- und Informationszwecken und stellt keine Finanz-, Anlage- oder Handelsberatung dar. Der Handel mit Futures und anderen gehebelten Produkten birgt ein erhebliches Verlustrisiko und ist nicht für jeden Anleger geeignet. PickMyTrade ist eine unabhängige Automatisierungsplattform eines Drittanbieters und steht in keiner Verbindung zu Tradovate, Inc., wird weder von Tradovate, Inc. unterstützt noch gesponsert. Alle zugehörigen Namen, Logos und Marken sind Eigentum ihrer jeweiligen Inhaber. Funktionen und Schritte der Plattform ändern sich im Laufe der Zeit. Prüfen Sie daher stets den aktuellen Ablauf in der offiziellen Tradovate-Plattform und -Dokumentation, bevor Sie handeln.", es: "Esta guía tiene fines exclusivamente educativos e informativos y no constituye asesoramiento financiero, de inversión ni de trading. Operar con futuros y otros productos apalancados conlleva un riesgo sustancial de pérdida y no es adecuado para todos los inversores. PickMyTrade es una plataforma de automatización independiente de terceros y no está afiliada, respaldada ni patrocinada por Tradovate, Inc. Todos los nombres, logotipos y marcas relacionados son propiedad de sus respectivos titulares. Las funciones y los pasos de la plataforma cambian con el tiempo, así que confirme siempre el proceso actual en la plataforma y la documentación oficiales de Tradovate antes de actuar.", fr: "Ce guide est fourni à des fins éducatives et informatives uniquement et ne constitue ni un conseil financier, ni un conseil en investissement, ni un conseil de trading. Le trading de contrats à terme et d'autres produits à effet de levier comporte un risque de perte important et ne convient pas à tous les investisseurs. PickMyTrade est une plateforme d'automatisation tierce indépendante, non affiliée à Tradovate, Inc., ni approuvée ou parrainée par celle-ci. Tous les noms, logos et marques associés sont la propriété de leurs détenteurs respectifs. Les fonctionnalités et les étapes de la plateforme évoluent avec le temps ; vérifiez donc toujours la procédure en vigueur sur la plateforme et dans la documentation officielles de Tradovate avant d'agir.", it: "Questa guida ha esclusivamente scopo educativo e informativo e non costituisce consulenza finanziaria, d'investimento o di trading. Il trading di futures e di altri prodotti a leva comporta un rischio sostanziale di perdita e non è adatto a tutti gli investitori. PickMyTrade è una piattaforma di automazione indipendente di terze parti e non è affiliata, approvata né sponsorizzata da Tradovate, Inc. Tutti i nomi, i loghi e i marchi correlati sono di proprietà dei rispettivi titolari. Le funzionalità e i passaggi della piattaforma cambiano nel tempo, quindi verifichi sempre la procedura attuale nella piattaforma e nella documentazione ufficiali di Tradovate prima di agire." },
};
const data: GuideArticleData = resolveGuideContent(content, locale, related);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: data.faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}${withSlash(localizedPath(locale))}` },
    { "@type": "ListItem", position: 2, name: "How-To", item: `${SITE_URL}${withSlash(localizedPath(locale, "how-to"))}` },
    { "@type": "ListItem", position: 3, name: content.h1[locale], item: `${SITE_URL}${withSlash(localizedPath(locale, `how-to/${SLUG}`))}` },
  ],
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: content.h1[locale],
  description: content.dek[locale],
  image: `${SITE_URL}${IMG}/tradovate-workspaces-1.png`,
  publisher: { "@type": "Organization", name: "PickMyTrade", logo: { "@type": "ImageObject", url: `${SITE_URL}/assets/logo.png` } },
  datePublished: "2026-07-10",
  dateModified: "2026-07-10",
  mainEntityOfPage: { "@type": "WebPage", "@id": `${SITE_URL}${withSlash(localizedPath(locale, `how-to/${SLUG}`))}` },
};
---

<BaseLayout
  locale={locale}
  title={`${content.h1[locale]} | PickMyTrade`}
  description={content.dek[locale]}
  ogType="article"
  ogImage={`${IMG}/tradovate-workspaces-1.png`}
  ldJson={[breadcrumbSchema, faqSchema, articleSchema]}
>
  <GuideArticle locale={locale} data={data} sectionPath="how-to" />
</BaseLayout>
