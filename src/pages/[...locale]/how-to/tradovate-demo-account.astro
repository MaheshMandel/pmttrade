---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-demo-account";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Start a Free Tradovate Simulated Trading Account";
const META_DESCRIPTION =
  "Tradovate demo account: open a free 14-day simulated trading account with $50K practice funds and real-time futures data, no deposit or credit card needed.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Kostenloses Tradovate-Simulationskonto eröffnen", es: "Abra una cuenta de trading simulado gratuita en Tradovate", fr: "Ouvrir un compte de trading simulé Tradovate gratuit", it: "Apra un conto di trading simulato Tradovate gratuito" },
  dek: { en: "Want to practice futures trading without putting a single dollar at risk? A Tradovate demo account is the cleanest way to do it. Here's how to open one, step by step.", de: "Möchten Sie Futures-Handel üben, ohne einen einzigen Dollar zu riskieren? Ein Tradovate-Demokonto ist dafür der sauberste Weg. So eröffnen Sie eines, Schritt für Schritt.", es: "¿Quiere practicar el trading de futuros sin arriesgar ni un solo dólar? Una cuenta demo de Tradovate es la forma más limpia de hacerlo. Así se abre una, paso a paso.", fr: "Vous voulez vous entraîner au trading de contrats à terme sans risquer un seul dollar ? Un compte démo Tradovate est le moyen le plus propre d'y parvenir. Voici comment en ouvrir un, étape par étape.", it: "Vuole esercitarsi nel trading di futures senza rischiare un solo dollaro? Un conto demo Tradovate è il modo più pulito per farlo. Ecco come aprirne uno, passo dopo passo." },
  readTime: { en: "4 min read", de: "4 Min. Lesezeit", es: "Lectura de 4 min", fr: "Lecture : 4 min", it: "Lettura di 4 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Want to practice futures trading without putting a single dollar at risk? A Tradovate demo account is the cleanest way to do it. Whether you're learning the platform, pressure-testing a strategy, or wiring up automation like PickMyTrade, this guide walks you through opening one, step by step." },
    { type: "heading", text: "What Is a Tradovate Simulated Trading Account?" },
    { type: "paragraph", html: "A Tradovate simulated trading account (you'll also see it called the demo or free trial) is a risk-free copy of the live platform, funded with practice money instead of real cash. You get real-time futures data and the full trading interface for a limited trial window. That means you can fire off unlimited simulated orders and get comfortable with every tool before you ever fund a live account." },
    { type: "heading", text: "Start Your Free Tradovate Demo: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open the Tradovate Free-Trial Page", html: "Head to the Tradovate website and open the free trial / simulated trading page, then click the button that kicks off the free demo signup. Tradovate advertises this as a <strong class='text-white'>free 14-day</strong> futures trading account that comes with <strong class='text-white'>$50,000</strong> in practice funds and free real-time market data.", image: { src: `${IMG}/tradovate-demo-account-1.png`, alt: "Tradovate free-trial landing page showing the demo account signup button" } },
        { title: "Enter Your Details and Create the Account", html: "Fill in the registration form with your name and email, pick a password, and accept the terms of service. That's it. The demo asks only for basic contact details, so there's <strong class='text-white'>no credit card and no deposit</strong> needed to get started.", image: { src: `${IMG}/tradovate-demo-account-2.png`, alt: "Tradovate demo account registration form showing name, email, and password fields" } },
        { title: "Verify Your Email", html: "After you register, Tradovate emails you a confirmation. Open it and click the verification link to activate your simulated trading account. If it hasn't landed within a few minutes, check your spam or promotions folder before assuming something went wrong.", image: { src: `${IMG}/tradovate-demo-account-3.png`, alt: "Tradovate email verification message with the activation link for the demo account" } },
        { title: "Log In and Select Simulation Mode", html: "Sign in with your new credentials on the web, desktop, or mobile app. When you connect, choose the <strong class='text-white'>Simulation</strong> (demo) environment instead of Live. That's the switch that routes your orders to the practice engine rather than a real one, so double-check it before you place anything.", image: { src: `${IMG}/tradovate-demo-account-4.png`, alt: "Tradovate login screen with the Simulation demo environment selected" } },
        { title: "Start Placing Simulated Trades", html: "You've now got a funded practice account. Open a chart or the DOM, place buy and sell orders, and play with brackets, trailing stops, and Market Replay. Tradovate also lets you adjust the starting balance, so you can size the account to match how you actually plan to trade.", image: { src: `${IMG}/tradovate-demo-account-5.png`, alt: "Tradovate simulated trading account showing the $50,000 practice balance and DOM" } },
      ],
    },
    { type: "heading", text: "Why You'd Need This" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Learn the platform</strong>, get fluent with the DOM, charts, and order types before real money is on the line.",
        "<strong class='text-white'>Test a strategy</strong>, trade live-moving markets with practice funds and watch how an idea actually behaves.",
        "<strong class='text-white'>Trial automation</strong>, connect a webhook or bridge and confirm your alerts fire correctly in a safe environment.",
        "<strong class='text-white'>Evaluate the broker</strong>, decide whether Tradovate fits your workflow before you open and fund a live account.",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Once your demo is running, <strong class='text-white'>PickMyTrade links your TradingView alerts straight to your Tradovate account</strong>, so entries, exits, and brackets fire automatically with no manual clicks. It's the fastest way to find out whether an automated strategy holds up on simulated data before you take it live." },
  ], de: [
    { type: "paragraph",html: "Möchten Sie Futures-Handel üben, ohne einen einzigen Dollar zu riskieren? Ein Tradovate-Demokonto ist dafür der sauberste Weg. Ob Sie die Plattform kennenlernen, eine Strategie auf Herz und Nieren prüfen oder eine Automatisierung wie PickMyTrade einrichten: Diese Anleitung führt Sie Schritt für Schritt durch die Eröffnung." },
    { type: "heading",text: "Was ist ein Tradovate-Simulationskonto?" },
    { type: "paragraph",html: "Ein Tradovate-Simulationskonto (Sie finden es auch als Demo oder kostenlose Testphase) ist eine risikofreie Kopie der Live-Plattform, die mit Übungsgeld statt mit echtem Bargeld ausgestattet ist. Sie erhalten Echtzeit-Futures-Daten und die vollständige Handelsoberfläche für einen begrenzten Testzeitraum. So können Sie unbegrenzt simulierte Orders absetzen und sich mit jedem Werkzeug vertraut machen, bevor Sie überhaupt ein Live-Konto finanzieren." },
    { type: "heading",text: "Kostenlose Tradovate-Demo starten: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Die Tradovate-Seite für die kostenlose Testphase öffnen", html: "Rufen Sie die Tradovate-Website auf und öffnen Sie die Seite für die kostenlose Testphase bzw. den Simulationshandel. Klicken Sie dann auf die Schaltfläche, mit der die Anmeldung zur kostenlosen Demo beginnt. Tradovate bewirbt dies als ein <strong class='text-white'>kostenloses 14-Tage-</strong>Futures-Handelskonto mit <strong class='text-white'>50.000 $</strong> Übungsguthaben und kostenlosen Echtzeit-Marktdaten.", image: {"src":`${IMG}/tradovate-demo-account-1.png`,"alt":"Landingpage der kostenlosen Tradovate-Testphase mit der Schaltfläche zur Demokonto-Anmeldung"} },
        { title: "Ihre Daten eingeben und das Konto erstellen", html: "Füllen Sie das Registrierungsformular mit Ihrem Namen und Ihrer E-Mail-Adresse aus, wählen Sie ein Passwort und akzeptieren Sie die Nutzungsbedingungen. Das war es schon. Die Demo verlangt nur grundlegende Kontaktdaten, sodass <strong class='text-white'>keine Kreditkarte und keine Einzahlung</strong> nötig sind, um zu starten.", image: {"src":`${IMG}/tradovate-demo-account-2.png`,"alt":"Registrierungsformular für das Tradovate-Demokonto mit den Feldern Name, E-Mail und Passwort"} },
        { title: "E-Mail-Adresse bestätigen", html: "Nach der Registrierung sendet Tradovate Ihnen eine Bestätigungs-E-Mail. Öffnen Sie sie und klicken Sie auf den Bestätigungslink, um Ihr Simulationskonto zu aktivieren. Ist sie nach einigen Minuten nicht eingetroffen, prüfen Sie Ihren Spam- oder Werbung-Ordner, bevor Sie annehmen, dass etwas schiefgelaufen ist.", image: {"src":`${IMG}/tradovate-demo-account-3.png`,"alt":"Tradovate-E-Mail zur Bestätigung mit dem Aktivierungslink für das Demokonto"} },
        { title: "Anmelden und den Simulationsmodus wählen", html: "Melden Sie sich mit Ihren neuen Zugangsdaten im Web, auf dem Desktop oder in der mobilen App an. Wählen Sie beim Verbinden die Umgebung <strong class='text-white'>Simulation</strong> (Demo) statt Live. Mit diesem Schalter werden Ihre Orders an die Übungs-Engine statt an eine echte geleitet. Prüfen Sie ihn daher doppelt, bevor Sie etwas platzieren.", image: {"src":`${IMG}/tradovate-demo-account-4.png`,"alt":"Tradovate-Anmeldebildschirm mit ausgewählter Simulation-Demoumgebung"} },
        { title: "Simulierte Trades platzieren", html: "Jetzt haben Sie ein finanziertes Übungskonto. Öffnen Sie einen Chart oder das DOM, platzieren Sie Kauf- und Verkaufsorders und probieren Sie Brackets, Trailing-Stops und Market Replay aus. Tradovate erlaubt es außerdem, den Startkontostand anzupassen, sodass Sie das Konto so dimensionieren können, wie Sie tatsächlich handeln möchten.", image: {"src":`${IMG}/tradovate-demo-account-5.png`,"alt":"Tradovate-Simulationskonto mit dem Übungskontostand von 50.000 $ und dem DOM"} },
      ],
    },
    { type: "heading",text: "Wozu Sie das brauchen" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Die Plattform kennenlernen</strong>: Werden Sie sicher im Umgang mit DOM, Charts und Ordertypen, bevor echtes Geld im Spiel ist.",
        "<strong class='text-white'>Eine Strategie testen</strong>: Handeln Sie in laufenden Märkten mit Übungsguthaben und beobachten Sie, wie sich eine Idee tatsächlich verhält.",
        "<strong class='text-white'>Automatisierung erproben</strong>: Verbinden Sie einen Webhook oder eine Bridge und prüfen Sie in einer sicheren Umgebung, ob Ihre Alerts korrekt auslösen.",
        "<strong class='text-white'>Den Broker bewerten</strong>: Entscheiden Sie, ob Tradovate zu Ihrem Workflow passt, bevor Sie ein Live-Konto eröffnen und finanzieren.",
      ],
    },
    { type: "heading",text: "Automatisieren mit PickMyTrade" },
    { type: "paragraph",html: "Sobald Ihre Demo läuft, <strong class='text-white'>verbindet PickMyTrade Ihre TradingView-Alerts direkt mit Ihrem Tradovate-Konto</strong>, sodass Einstiege, Ausstiege und Brackets ohne manuelle Klicks automatisch ausgelöst werden. So finden Sie am schnellsten heraus, ob eine automatisierte Strategie mit simulierten Daten besteht, bevor Sie live gehen." },
  ], es: [
    { type: "paragraph",html: "¿Quiere practicar el trading de futuros sin arriesgar ni un solo dólar? Una cuenta demo de Tradovate es la forma más limpia de hacerlo. Ya sea que esté aprendiendo la plataforma, poniendo a prueba una estrategia o configurando una automatización como PickMyTrade, esta guía le explica paso a paso cómo abrir una." },
    { type: "heading",text: "¿Qué es una cuenta de trading simulado de Tradovate?" },
    { type: "paragraph",html: "Una cuenta de trading simulado de Tradovate (también la verá llamada demo o prueba gratuita) es una copia sin riesgo de la plataforma real, financiada con dinero de práctica en lugar de efectivo real. Obtiene datos de futuros en tiempo real y la interfaz de trading completa durante un periodo de prueba limitado. Eso significa que puede enviar órdenes simuladas ilimitadas y familiarizarse con cada herramienta antes de financiar una cuenta real." },
    { type: "heading",text: "Inicie su demo gratuita de Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra la página de prueba gratuita de Tradovate", html: "Vaya al sitio web de Tradovate, abra la página de prueba gratuita / trading simulado y haga clic en el botón que inicia el registro de la demo gratuita. Tradovate la presenta como una cuenta de trading de futuros <strong class='text-white'>gratuita de 14 días</strong> que incluye <strong class='text-white'>50.000 $</strong> en fondos de práctica y datos de mercado en tiempo real gratuitos.", image: {"src":`${IMG}/tradovate-demo-account-1.png`,"alt":"Página de destino de la prueba gratuita de Tradovate con el botón de registro de la cuenta demo"} },
        { title: "Introduzca sus datos y cree la cuenta", html: "Complete el formulario de registro con su nombre y correo electrónico, elija una contraseña y acepte los términos del servicio. Eso es todo. La demo solo pide datos de contacto básicos, así que <strong class='text-white'>no hace falta tarjeta de crédito ni depósito</strong> para empezar.", image: {"src":`${IMG}/tradovate-demo-account-2.png`,"alt":"Formulario de registro de la cuenta demo de Tradovate con los campos de nombre, correo electrónico y contraseña"} },
        { title: "Verifique su correo electrónico", html: "Después de registrarse, Tradovate le envía un correo de confirmación. Ábralo y haga clic en el enlace de verificación para activar su cuenta de trading simulado. Si no ha llegado al cabo de unos minutos, revise su carpeta de spam o de promociones antes de asumir que algo ha salido mal.", image: {"src":`${IMG}/tradovate-demo-account-3.png`,"alt":"Mensaje de verificación de correo de Tradovate con el enlace de activación de la cuenta demo"} },
        { title: "Inicie sesión y seleccione el modo Simulation", html: "Inicie sesión con sus nuevas credenciales en la web, el escritorio o la aplicación móvil. Al conectarse, elija el entorno <strong class='text-white'>Simulation</strong> (demo) en lugar de Live. Ese es el interruptor que dirige sus órdenes al motor de práctica y no a uno real, así que compruébelo dos veces antes de colocar nada.", image: {"src":`${IMG}/tradovate-demo-account-4.png`,"alt":"Pantalla de inicio de sesión de Tradovate con el entorno demo Simulation seleccionado"} },
        { title: "Empiece a colocar operaciones simuladas", html: "Ya tiene una cuenta de práctica con fondos. Abra un gráfico o el DOM, coloque órdenes de compra y venta y pruebe brackets, trailing stops y Market Replay. Tradovate también le permite ajustar el saldo inicial, de modo que puede dimensionar la cuenta según cómo piensa operar realmente.", image: {"src":`${IMG}/tradovate-demo-account-5.png`,"alt":"Cuenta de trading simulado de Tradovate con el saldo de práctica de 50.000 $ y el DOM"} },
      ],
    },
    { type: "heading",text: "Por qué lo necesitaría" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Aprender la plataforma</strong>: adquiera soltura con el DOM, los gráficos y los tipos de orden antes de arriesgar dinero real.",
        "<strong class='text-white'>Probar una estrategia</strong>: opere en mercados en movimiento con fondos de práctica y observe cómo se comporta realmente una idea.",
        "<strong class='text-white'>Probar la automatización</strong>: conecte un webhook o un bridge y confirme en un entorno seguro que sus alertas se ejecutan correctamente.",
        "<strong class='text-white'>Evaluar el bróker</strong>: decida si Tradovate encaja con su forma de trabajar antes de abrir y financiar una cuenta real.",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Cuando su demo esté en marcha, <strong class='text-white'>PickMyTrade conecta sus alertas de TradingView directamente con su cuenta de Tradovate</strong>, de modo que las entradas, las salidas y los brackets se ejecutan automáticamente sin clics manuales. Es la forma más rápida de comprobar si una estrategia automatizada se sostiene con datos simulados antes de pasar a real." },
  ], fr: [
    { type: "paragraph",html: "Vous voulez vous entraîner au trading de contrats à terme sans risquer un seul dollar ? Un compte démo Tradovate est le moyen le plus propre d'y parvenir. Que vous appreniez la plateforme, mettiez une stratégie à l'épreuve ou configuriez une automatisation comme PickMyTrade, ce guide vous explique pas à pas comment en ouvrir un." },
    { type: "heading",text: "Qu'est-ce qu'un compte de trading simulé Tradovate ?" },
    { type: "paragraph",html: "Un compte de trading simulé Tradovate (vous le verrez aussi appelé démo ou essai gratuit) est une copie sans risque de la plateforme réelle, alimentée par de l'argent d'entraînement plutôt que par des liquidités réelles. Vous bénéficiez de données de contrats à terme en temps réel et de l'interface de trading complète pendant une période d'essai limitée. Vous pouvez ainsi passer un nombre illimité d'ordres simulés et vous familiariser avec chaque outil avant même d'alimenter un compte réel." },
    { type: "heading",text: "Démarrer votre démo Tradovate gratuite : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir la page d'essai gratuit de Tradovate", html: "Rendez-vous sur le site web de Tradovate et ouvrez la page d'essai gratuit / trading simulé, puis cliquez sur le bouton qui lance l'inscription à la démo gratuite. Tradovate la présente comme un compte de trading de contrats à terme <strong class='text-white'>gratuit de 14 jours</strong> doté de <strong class='text-white'>50 000 $</strong> de fonds d'entraînement et de données de marché en temps réel gratuites.", image: {"src":`${IMG}/tradovate-demo-account-1.png`,"alt":"Page d'accueil de l'essai gratuit Tradovate affichant le bouton d'inscription au compte démo"} },
        { title: "Saisir vos informations et créer le compte", html: "Remplissez le formulaire d'inscription avec votre nom et votre adresse e-mail, choisissez un mot de passe et acceptez les conditions d'utilisation. C'est tout. La démo ne demande que des coordonnées de base ; <strong class='text-white'>aucune carte bancaire ni aucun dépôt</strong> n'est donc nécessaire pour commencer.", image: {"src":`${IMG}/tradovate-demo-account-2.png`,"alt":"Formulaire d'inscription au compte démo Tradovate avec les champs nom, e-mail et mot de passe"} },
        { title: "Vérifier votre adresse e-mail", html: "Après votre inscription, Tradovate vous envoie un e-mail de confirmation. Ouvrez-le et cliquez sur le lien de vérification pour activer votre compte de trading simulé. S'il n'est pas arrivé au bout de quelques minutes, vérifiez votre dossier de courrier indésirable ou de promotions avant de supposer qu'un problème est survenu.", image: {"src":`${IMG}/tradovate-demo-account-3.png`,"alt":"E-mail de vérification Tradovate avec le lien d'activation du compte démo"} },
        { title: "Se connecter et sélectionner le mode Simulation", html: "Connectez-vous avec vos nouveaux identifiants sur le web, le bureau ou l'application mobile. Lors de la connexion, choisissez l'environnement <strong class='text-white'>Simulation</strong> (démo) plutôt que Live. C'est ce commutateur qui dirige vos ordres vers le moteur d'entraînement et non vers un moteur réel ; vérifiez-le donc deux fois avant de passer quoi que ce soit.", image: {"src":`${IMG}/tradovate-demo-account-4.png`,"alt":"Écran de connexion Tradovate avec l'environnement démo Simulation sélectionné"} },
        { title: "Commencer à passer des trades simulés", html: "Vous disposez désormais d'un compte d'entraînement alimenté. Ouvrez un graphique ou le DOM, passez des ordres d'achat et de vente, et essayez les brackets, les trailing stops et Market Replay. Tradovate vous permet aussi d'ajuster le solde de départ, de sorte que vous pouvez dimensionner le compte selon la façon dont vous prévoyez réellement de trader.", image: {"src":`${IMG}/tradovate-demo-account-5.png`,"alt":"Compte de trading simulé Tradovate affichant le solde d'entraînement de 50 000 $ et le DOM"} },
      ],
    },
    { type: "heading",text: "Pourquoi en auriez-vous besoin" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Apprendre la plateforme</strong> : maîtrisez le DOM, les graphiques et les types d'ordres avant que de l'argent réel soit en jeu.",
        "<strong class='text-white'>Tester une stratégie</strong> : tradez des marchés en mouvement avec des fonds d'entraînement et observez comment une idée se comporte réellement.",
        "<strong class='text-white'>Essayer l'automatisation</strong> : connectez un webhook ou un bridge et vérifiez, dans un environnement sûr, que vos alertes se déclenchent correctement.",
        "<strong class='text-white'>Évaluer le courtier</strong> : décidez si Tradovate convient à votre façon de travailler avant d'ouvrir et d'alimenter un compte réel.",
      ],
    },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Une fois votre démo lancée, <strong class='text-white'>PickMyTrade relie vos alertes TradingView directement à votre compte Tradovate</strong>, de sorte que les entrées, les sorties et les brackets s'exécutent automatiquement, sans clic manuel. C'est le moyen le plus rapide de savoir si une stratégie automatisée tient la route sur des données simulées avant de passer en réel." },
  ], it: [
    { type: "paragraph",html: "Vuole esercitarsi nel trading di futures senza rischiare un solo dollaro? Un conto demo Tradovate è il modo più pulito per farlo. Che stia imparando la piattaforma, mettendo alla prova una strategia o configurando un'automazione come PickMyTrade, questa guida Le mostra come aprirne uno, passo dopo passo." },
    { type: "heading",text: "Che cos'è un conto di trading simulato Tradovate?" },
    { type: "paragraph",html: "Un conto di trading simulato Tradovate (lo troverà chiamato anche demo o prova gratuita) è una copia priva di rischi della piattaforma live, finanziata con denaro di pratica anziché con contanti reali. Ottiene dati di futures in tempo reale e l'interfaccia di trading completa per un periodo di prova limitato. Ciò significa che può inviare ordini simulati illimitati e familiarizzare con ogni strumento prima ancora di finanziare un conto live." },
    { type: "heading",text: "Avvii la Sua demo Tradovate gratuita: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Apra la pagina della prova gratuita di Tradovate", html: "Vada sul sito web di Tradovate e apra la pagina della prova gratuita / trading simulato, quindi faccia clic sul pulsante che avvia la registrazione alla demo gratuita. Tradovate la presenta come un conto di trading di futures <strong class='text-white'>gratuito di 14 giorni</strong> con <strong class='text-white'>50.000 $</strong> di fondi di pratica e dati di mercato in tempo reale gratuiti.", image: {"src":`${IMG}/tradovate-demo-account-1.png`,"alt":"Pagina di destinazione della prova gratuita di Tradovate con il pulsante di registrazione del conto demo"} },
        { title: "Inserisca i Suoi dati e crei il conto", html: "Compili il modulo di registrazione con nome ed e-mail, scelga una password e accetti i termini di servizio. Tutto qui. La demo richiede soltanto i dati di contatto essenziali, quindi per iniziare <strong class='text-white'>non servono né carta di credito né deposito</strong>.", image: {"src":`${IMG}/tradovate-demo-account-2.png`,"alt":"Modulo di registrazione del conto demo Tradovate con i campi nome, e-mail e password"} },
        { title: "Verifichi il Suo indirizzo e-mail", html: "Dopo la registrazione, Tradovate Le invia un'e-mail di conferma. La apra e faccia clic sul link di verifica per attivare il Suo conto di trading simulato. Se non è arrivata entro pochi minuti, controlli la cartella spam o promozioni prima di pensare che qualcosa sia andato storto.", image: {"src":`${IMG}/tradovate-demo-account-3.png`,"alt":"E-mail di verifica di Tradovate con il link di attivazione del conto demo"} },
