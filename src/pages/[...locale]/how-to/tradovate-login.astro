---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-login";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "How to Log In to Tradovate (Web & Mobile)";
const META_DESCRIPTION =
  "Tradovate login made easy: sign in on web or mobile, pick Simulation or Live, and select the right account so you're ready to trade in seconds.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "So melden Sie sich bei Tradovate an (Web & Mobil)", es: "Cómo iniciar sesión en Tradovate (web y móvil)", fr: "Comment se connecter à Tradovate (web et mobile)", it: "Come accedere a Tradovate (web e mobile)" },
  dek: { en: "Need to sign in to Tradovate on web or mobile? This guide walks you through logging in, accepting the required agreements, and loading the right account, one step at a time.", de: "Sie möchten sich bei Tradovate im Web oder mobil anmelden? Diese Anleitung führt Sie Schritt für Schritt durch die Anmeldung, die Annahme der erforderlichen Vereinbarungen und das Laden des richtigen Kontos.", es: "¿Necesita iniciar sesión en Tradovate en la web o en el móvil? Esta guía le explica paso a paso cómo iniciar sesión, aceptar los acuerdos requeridos y cargar la cuenta correcta.", fr: "Vous devez vous connecter à Tradovate sur le web ou sur mobile ? Ce guide vous accompagne pas à pas pour vous connecter, accepter les accords requis et charger le bon compte.", it: "Deve accedere a Tradovate dal web o da mobile? Questa guida La accompagna passo dopo passo nell’accesso, nell’accettazione degli accordi richiesti e nel caricamento del conto corretto." },
  readTime: { en: "4 min read", de: "4 Min. Lesezeit", es: "Lectura de 4 min", fr: "Lecture : 4 min", it: "Lettura di 4 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Need to sign in to Tradovate on web or mobile? Whether you're jumping into a simulated practice account, trading a funded evaluation, or wiring up automation with PickMyTrade, this guide walks you through logging in and loading the right account, one step at a time." },
    { type: "heading", text: "What Is a Tradovate Login?" },
    { type: "paragraph", html: "Your Tradovate login is the username and password that unlock the web trader, the desktop app, and the mobile app. The same credentials work across every device. Once you're signed in, you choose whether to enter the <strong class='text-white'>Simulation</strong> (demo) or <strong class='text-white'>Live</strong> environment, then pick which trading account to load. That last part matters if you hold more than one account." },
    { type: "heading", text: "Tradovate Login: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open the Tradovate Web Trader", html: "In your browser, head to the Tradovate web trader at <strong class='text-white'>trader.tradovate.com</strong>, or open the Tradovate desktop app. You can also start at <strong class='text-white'>tradovate.com</strong> and click <strong class='text-white'>Login</strong> in the top-right corner.", image: { src: `${IMG}/tradovate-login-1.png`, alt: "Tradovate web trader login screen showing the sign-in form" } },
        { title: "Enter Your Username and Password", html: "Type your Tradovate username and password, then click <strong class='text-white'>Login</strong>. If a prop firm issued your account, use the credentials from your firm's dashboard rather than a separate Tradovate signup. The same fields still apply either way.", image: { src: `${IMG}/tradovate-login-2.png`, alt: "Tradovate login form showing username and password fields and the Login button" } },
        { title: "Review and Sign the Required Agreements", html: "On your first login (and occasionally after that), Tradovate asks you to review and accept market-data and platform agreements. Fill out anything it requires and accept to continue. You won't reach the trading screen until these are signed.", image: { src: `${IMG}/tradovate-login-3.png`, alt: "Tradovate login showing the market-data agreement acceptance screen" } },
        { title: "Choose Your Environment and Select the Right Account", html: "Now pick your environment. Click the button to enter <strong class='text-white'>Simulation</strong> (demo) for practice, or switch to <strong class='text-white'>Live</strong> to trade real capital. If you hold several accounts, say, a handful of prop-firm evaluations, choose the correct one from the account list before you place a single order. Loading the wrong account is the most common login mistake, and it's an easy one to avoid.", image: { src: `${IMG}/tradovate-login-4.png`, alt: "Tradovate login showing the Simulation and Live environment options and account list" } },
        { title: "Log In on the Tradovate Mobile App", html: "On iOS or Android, open the Tradovate mobile app and tap <strong class='text-white'>Sign In</strong>. Enter the same username and password, tap <strong class='text-white'>Sign In</strong> again, then choose your environment (for practice, tap the option to enter simulated trading) and your account. When you want to sign out later, tap the menu (&#9776;) icon in the top-left corner and choose <strong class='text-white'>Logout</strong>." },
      ],
    },
    { type: "heading", text: "Why You'd Need This" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Getting started</strong>, first-time access to the web, desktop, or mobile platform.",
        "<strong class='text-white'>Prop-firm evaluations</strong>, signing in with firm-issued credentials and finding the right funded or evaluation account.",
        "<strong class='text-white'>Switching devices</strong>, logging in on a second computer or phone when you trade on the go.",
        "<strong class='text-white'>Practice vs. real money</strong>, making sure you're in Simulation before testing, and Live before you put capital to work.",
        "<strong class='text-white'>Connecting automation</strong>, confirming you can log in cleanly before linking TradingView or a tool like PickMyTrade.",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Once you can log in and select the right account, <strong class='text-white'>PickMyTrade links your TradingView alerts straight to that Tradovate account</strong>, so entries, exits, and brackets fire automatically. No manual clicks, no sitting there watching for a signal. It's a clean way to trade your strategy the moment you're signed in." },
  ], de: [
    { type: "paragraph",html: "Sie möchten sich bei Tradovate im Web oder mobil anmelden? Ob Sie in ein simuliertes Übungskonto einsteigen, eine finanzierte Evaluierung handeln oder die Automatisierung mit PickMyTrade einrichten: Diese Anleitung führt Sie Schritt für Schritt durch die Anmeldung und das Laden des richtigen Kontos." },
    { type: "heading",text: "Was ist ein Tradovate-Login?" },
    { type: "paragraph",html: "Ihr Tradovate-Login besteht aus dem Benutzernamen und dem Passwort, mit denen Sie den Web-Trader, die Desktop-App und die Mobil-App freischalten. Dieselben Zugangsdaten funktionieren auf allen Geräten. Nach der Anmeldung wählen Sie, ob Sie die Umgebung <strong class='text-white'>Simulation</strong> (Demo) oder <strong class='text-white'>Live</strong> betreten, und wählen dann, welches Handelskonto geladen werden soll. Das ist wichtig, wenn Sie mehr als ein Konto besitzen." },
    { type: "heading",text: "Tradovate-Login: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Öffnen Sie den Tradovate Web-Trader", html: "Rufen Sie in Ihrem Browser den Tradovate Web-Trader unter <strong class='text-white'>trader.tradovate.com</strong> auf oder öffnen Sie die Tradovate-Desktop-App. Sie können auch auf <strong class='text-white'>tradovate.com</strong> beginnen und oben rechts auf <strong class='text-white'>Login</strong> klicken.", image: {"src":`${IMG}/tradovate-login-1.png`,"alt":"Anmeldebildschirm des Tradovate Web-Traders mit dem Anmeldeformular"} },
        { title: "Geben Sie Ihren Benutzernamen und Ihr Passwort ein", html: "Geben Sie Ihren Tradovate-Benutzernamen und Ihr Passwort ein und klicken Sie dann auf <strong class='text-white'>Login</strong>. Wenn Ihr Konto von einer Prop Firm ausgestellt wurde, verwenden Sie die Zugangsdaten aus dem Dashboard Ihrer Firma statt einer separaten Tradovate-Registrierung. Die Felder sind in beiden Fällen dieselben.", image: {"src":`${IMG}/tradovate-login-2.png`,"alt":"Tradovate-Anmeldeformular mit den Feldern für Benutzername und Passwort sowie der Login-Schaltfläche"} },
        { title: "Prüfen und unterzeichnen Sie die erforderlichen Vereinbarungen", html: "Bei Ihrer ersten Anmeldung (und gelegentlich danach) fordert Tradovate Sie auf, Marktdaten- und Plattformvereinbarungen zu prüfen und zu akzeptieren. Füllen Sie alles Erforderliche aus und akzeptieren Sie, um fortzufahren. Sie gelangen erst zum Handelsbildschirm, wenn diese unterzeichnet sind.", image: {"src":`${IMG}/tradovate-login-3.png`,"alt":"Tradovate-Anmeldung mit dem Bildschirm zur Annahme der Marktdatenvereinbarung"} },
        { title: "Wählen Sie Ihre Umgebung und das richtige Konto aus", html: "Wählen Sie nun Ihre Umgebung. Klicken Sie auf die Schaltfläche, um zum Üben <strong class='text-white'>Simulation</strong> (Demo) zu betreten, oder wechseln Sie zu <strong class='text-white'>Live</strong>, um mit echtem Kapital zu handeln. Wenn Sie mehrere Konten besitzen, zum Beispiel eine Handvoll Prop-Firm-Evaluierungen, wählen Sie das richtige aus der Kontoliste, bevor Sie auch nur eine Order platzieren. Das falsche Konto zu laden ist der häufigste Anmeldefehler, und er lässt sich leicht vermeiden.", image: {"src":`${IMG}/tradovate-login-4.png`,"alt":"Tradovate-Anmeldung mit den Umgebungsoptionen Simulation und Live sowie der Kontoliste"} },
        { title: "Anmeldung in der Tradovate-Mobil-App", html: "Öffnen Sie unter iOS oder Android die Tradovate-Mobil-App und tippen Sie auf <strong class='text-white'>Sign In</strong>. Geben Sie denselben Benutzernamen und dasselbe Passwort ein, tippen Sie erneut auf <strong class='text-white'>Sign In</strong> und wählen Sie dann Ihre Umgebung (tippen Sie zum Üben auf die Option für den simulierten Handel) und Ihr Konto. Wenn Sie sich später abmelden möchten, tippen Sie oben links auf das Menüsymbol (&#9776;) und wählen Sie <strong class='text-white'>Logout</strong>." },
      ],
    },
    { type: "heading",text: "Warum Sie das brauchen" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Erste Schritte</strong>, erstmaliger Zugang zur Web-, Desktop- oder Mobil-Plattform.",
        "<strong class='text-white'>Prop-Firm-Evaluierungen</strong>, Anmeldung mit den von der Firma ausgestellten Zugangsdaten und Finden des richtigen finanzierten Kontos bzw. Evaluierungskontos.",
        "<strong class='text-white'>Gerätewechsel</strong>, Anmeldung auf einem zweiten Computer oder Smartphone, wenn Sie unterwegs handeln.",
        "<strong class='text-white'>Übung vs. echtes Geld</strong>, sicherstellen, dass Sie vor dem Testen in Simulation sind und vor dem Einsatz von Kapital in Live.",
        "<strong class='text-white'>Automatisierung verbinden</strong>, bestätigen, dass die Anmeldung sauber funktioniert, bevor Sie TradingView oder ein Tool wie PickMyTrade verknüpfen.",
      ],
    },
    { type: "heading",text: "Automatisieren Sie das mit PickMyTrade" },
    { type: "paragraph",html: "Sobald Sie sich anmelden und das richtige Konto auswählen können, <strong class='text-white'>verknüpft PickMyTrade Ihre TradingView-Alarme direkt mit diesem Tradovate-Konto</strong>, sodass Einstiege, Ausstiege und Brackets automatisch ausgelöst werden. Keine manuellen Klicks, kein Warten vor dem Bildschirm auf ein Signal. So handeln Sie Ihre Strategie sauber in dem Moment, in dem Sie angemeldet sind." },
  ], es: [
    { type: "paragraph",html: "¿Necesita iniciar sesión en Tradovate en la web o en el móvil? Ya sea que vaya a entrar en una cuenta de práctica simulada, operar una evaluación fondeada o conectar la automatización con PickMyTrade, esta guía le explica paso a paso cómo iniciar sesión y cargar la cuenta correcta." },
    { type: "heading",text: "¿Qué es un inicio de sesión en Tradovate?" },
    { type: "paragraph",html: "Su inicio de sesión en Tradovate es el nombre de usuario y la contraseña que desbloquean el web trader, la aplicación de escritorio y la aplicación móvil. Las mismas credenciales funcionan en todos los dispositivos. Una vez que ha iniciado sesión, elige si entra en el entorno <strong class='text-white'>Simulation</strong> (demo) o <strong class='text-white'>Live</strong>, y luego selecciona qué cuenta de trading cargar. Esto último es importante si tiene más de una cuenta." },
    { type: "heading",text: "Inicio de sesión en Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra el web trader de Tradovate", html: "En su navegador, vaya al web trader de Tradovate en <strong class='text-white'>trader.tradovate.com</strong> o abra la aplicación de escritorio de Tradovate. También puede empezar en <strong class='text-white'>tradovate.com</strong> y hacer clic en <strong class='text-white'>Login</strong> en la esquina superior derecha.", image: {"src":`${IMG}/tradovate-login-1.png`,"alt":"Pantalla de inicio de sesión del web trader de Tradovate con el formulario de acceso"} },
        { title: "Introduzca su nombre de usuario y contraseña", html: "Escriba su nombre de usuario y contraseña de Tradovate y luego haga clic en <strong class='text-white'>Login</strong>. Si su cuenta fue emitida por una empresa de fondeo (prop firm), utilice las credenciales del panel de su empresa en lugar de un registro aparte en Tradovate. Los campos son los mismos en ambos casos.", image: {"src":`${IMG}/tradovate-login-2.png`,"alt":"Formulario de inicio de sesión de Tradovate con los campos de nombre de usuario y contraseña y el botón Login"} },
        { title: "Revise y firme los acuerdos requeridos", html: "En su primer inicio de sesión (y ocasionalmente después), Tradovate le pide que revise y acepte los acuerdos de datos de mercado y de la plataforma. Complete lo que le solicite y acepte para continuar. No llegará a la pantalla de trading hasta que estén firmados.", image: {"src":`${IMG}/tradovate-login-3.png`,"alt":"Inicio de sesión de Tradovate mostrando la pantalla de aceptación del acuerdo de datos de mercado"} },
        { title: "Elija su entorno y seleccione la cuenta correcta", html: "Ahora elija su entorno. Haga clic en el botón para entrar en <strong class='text-white'>Simulation</strong> (demo) para practicar, o cambie a <strong class='text-white'>Live</strong> para operar con capital real. Si tiene varias cuentas, por ejemplo, un puñado de evaluaciones de empresas de fondeo, elija la correcta de la lista de cuentas antes de colocar una sola orden. Cargar la cuenta equivocada es el error de inicio de sesión más común y es fácil de evitar.", image: {"src":`${IMG}/tradovate-login-4.png`,"alt":"Inicio de sesión de Tradovate mostrando las opciones de entorno Simulation y Live y la lista de cuentas"} },
        { title: "Inicie sesión en la aplicación móvil de Tradovate", html: "En iOS o Android, abra la aplicación móvil de Tradovate y toque <strong class='text-white'>Sign In</strong>. Introduzca el mismo nombre de usuario y contraseña, toque <strong class='text-white'>Sign In</strong> de nuevo y luego elija su entorno (para practicar, toque la opción para entrar en el trading simulado) y su cuenta. Cuando quiera cerrar sesión más adelante, toque el icono de menú (&#9776;) en la esquina superior izquierda y elija <strong class='text-white'>Logout</strong>." },
      ],
    },
    { type: "heading",text: "Para qué lo necesitará" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Primeros pasos</strong>, primer acceso a la plataforma web, de escritorio o móvil.",
        "<strong class='text-white'>Evaluaciones de empresas de fondeo</strong>, iniciar sesión con las credenciales emitidas por la empresa y encontrar la cuenta fondeada o de evaluación correcta.",
        "<strong class='text-white'>Cambio de dispositivo</strong>, iniciar sesión en un segundo ordenador o teléfono cuando opera sobre la marcha.",
        "<strong class='text-white'>Práctica vs. dinero real</strong>, asegurarse de estar en Simulation antes de probar y en Live antes de poner capital en juego.",
        "<strong class='text-white'>Conectar la automatización</strong>, confirmar que puede iniciar sesión sin problemas antes de vincular TradingView o una herramienta como PickMyTrade.",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Una vez que pueda iniciar sesión y seleccionar la cuenta correcta, <strong class='text-white'>PickMyTrade vincula sus alertas de TradingView directamente con esa cuenta de Tradovate</strong>, de modo que las entradas, salidas y brackets se ejecutan automáticamente. Sin clics manuales, sin quedarse mirando a la espera de una señal. Es una forma limpia de operar su estrategia en cuanto inicia sesión." },
  ], fr: [
    { type: "paragraph",html: "Vous devez vous connecter à Tradovate sur le web ou sur mobile ? Que vous accédiez à un compte d’entraînement simulé, que vous tradiez une évaluation financée ou que vous mettiez en place l’automatisation avec PickMyTrade, ce guide vous explique pas à pas comment vous connecter et charger le bon compte." },
    { type: "heading",text: "Qu’est-ce qu’une connexion Tradovate ?" },
    { type: "paragraph",html: "Votre connexion Tradovate correspond au nom d’utilisateur et au mot de passe qui donnent accès au web trader, à l’application de bureau et à l’application mobile. Les mêmes identifiants fonctionnent sur tous les appareils. Une fois connecté, vous choisissez d’entrer dans l’environnement <strong class='text-white'>Simulation</strong> (démo) ou <strong class='text-white'>Live</strong>, puis vous sélectionnez le compte de trading à charger. Ce dernier point compte si vous possédez plusieurs comptes." },
    { type: "heading",text: "Connexion à Tradovate : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez le web trader Tradovate", html: "Dans votre navigateur, rendez-vous sur le web trader Tradovate à l’adresse <strong class='text-white'>trader.tradovate.com</strong>, ou ouvrez l’application de bureau Tradovate. Vous pouvez aussi commencer sur <strong class='text-white'>tradovate.com</strong> et cliquer sur <strong class='text-white'>Login</strong> en haut à droite.", image: {"src":`${IMG}/tradovate-login-1.png`,"alt":"Écran de connexion du web trader Tradovate affichant le formulaire d’identification"} },
        { title: "Saisissez votre nom d’utilisateur et votre mot de passe", html: "Saisissez votre nom d’utilisateur et votre mot de passe Tradovate, puis cliquez sur <strong class='text-white'>Login</strong>. Si votre compte a été fourni par une prop firm, utilisez les identifiants du tableau de bord de votre société plutôt qu’une inscription Tradovate distincte. Les champs sont les mêmes dans les deux cas.", image: {"src":`${IMG}/tradovate-login-2.png`,"alt":"Formulaire de connexion Tradovate avec les champs nom d’utilisateur et mot de passe et le bouton Login"} },
        { title: "Lisez et signez les accords requis", html: "Lors de votre première connexion (et ponctuellement ensuite), Tradovate vous demande de lire et d’accepter les accords relatifs aux données de marché et à la plateforme. Remplissez ce qui est demandé et acceptez pour continuer. Vous n’accéderez pas à l’écran de trading tant qu’ils ne seront pas signés.", image: {"src":`${IMG}/tradovate-login-3.png`,"alt":"Connexion Tradovate affichant l’écran d’acceptation de l’accord sur les données de marché"} },
        { title: "Choisissez votre environnement et sélectionnez le bon compte", html: "Choisissez maintenant votre environnement. Cliquez sur le bouton pour entrer en <strong class='text-white'>Simulation</strong> (démo) afin de vous entraîner, ou passez en <strong class='text-white'>Live</strong> pour trader avec du capital réel. Si vous possédez plusieurs comptes, par exemple une poignée d’évaluations de prop firm, choisissez le bon dans la liste des comptes avant de passer le moindre ordre. Charger le mauvais compte est l’erreur de connexion la plus fréquente, et elle est facile à éviter.", image: {"src":`${IMG}/tradovate-login-4.png`,"alt":"Connexion Tradovate affichant les options d’environnement Simulation et Live ainsi que la liste des comptes"} },
        { title: "Connectez-vous à l’application mobile Tradovate", html: "Sur iOS ou Android, ouvrez l’application mobile Tradovate et touchez <strong class='text-white'>Sign In</strong>. Saisissez le même nom d’utilisateur et le même mot de passe, touchez de nouveau <strong class='text-white'>Sign In</strong>, puis choisissez votre environnement (pour vous entraîner, touchez l’option permettant d’accéder au trading simulé) et votre compte. Lorsque vous souhaiterez vous déconnecter, touchez l’icône de menu (&#9776;) en haut à gauche et choisissez <strong class='text-white'>Logout</strong>." },
      ],
    },
    { type: "heading",text: "Pourquoi vous en aurez besoin" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Premiers pas</strong>, premier accès à la plateforme web, de bureau ou mobile.",
        "<strong class='text-white'>Évaluations de prop firm</strong>, connexion avec les identifiants fournis par la société et recherche du bon compte financé ou d’évaluation.",
        "<strong class='text-white'>Changement d’appareil</strong>, connexion sur un deuxième ordinateur ou téléphone lorsque vous tradez en déplacement.",
        "<strong class='text-white'>Entraînement ou argent réel</strong>, s’assurer d’être en Simulation avant de tester, et en Live avant d’engager du capital.",
        "<strong class='text-white'>Connecter l’automatisation</strong>, vérifier que vous pouvez vous connecter sans problème avant de lier TradingView ou un outil comme PickMyTrade.",
      ],
    },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Une fois que vous pouvez vous connecter et sélectionner le bon compte, <strong class='text-white'>PickMyTrade relie directement vos alertes TradingView à ce compte Tradovate</strong>, de sorte que les entrées, sorties et brackets se déclenchent automatiquement. Aucun clic manuel, pas besoin de rester à guetter un signal. C’est un moyen propre de trader votre stratégie dès que vous êtes connecté." },
  ], it: [
    { type: "paragraph",html: "Deve accedere a Tradovate dal web o da mobile? Che stia entrando in un conto di pratica simulato, operando su una valutazione finanziata o configurando l’automazione con PickMyTrade, questa guida La accompagna passo dopo passo nell’accesso e nel caricamento del conto corretto." },
    { type: "heading",text: "Che cos’è un accesso a Tradovate?" },
    { type: "paragraph",html: "Il Suo accesso a Tradovate è costituito dal nome utente e dalla password che sbloccano il web trader, l’app desktop e l’app mobile. Le stesse credenziali funzionano su tutti i dispositivi. Dopo l’accesso, sceglie se entrare nell’ambiente <strong class='text-white'>Simulation</strong> (demo) o <strong class='text-white'>Live</strong>, quindi seleziona quale conto di trading caricare. Quest’ultimo punto è importante se possiede più di un conto." },
    { type: "heading",text: "Accesso a Tradovate: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Apra il web trader di Tradovate", html: "Nel Suo browser, vada al web trader di Tradovate all’indirizzo <strong class='text-white'>trader.tradovate.com</strong> oppure apra l’app desktop di Tradovate. Può anche iniziare da <strong class='text-white'>tradovate.com</strong> e fare clic su <strong class='text-white'>Login</strong> nell’angolo in alto a destra.", image: {"src":`${IMG}/tradovate-login-1.png`,"alt":"Schermata di accesso del web trader di Tradovate con il modulo di login"} },
        { title: "Inserisca nome utente e password", html: "Digiti il Suo nome utente e la Sua password di Tradovate, quindi faccia clic su <strong class='text-white'>Login</strong>. Se il Suo conto è stato fornito da una prop firm, utilizzi le credenziali dalla dashboard della Sua società anziché una registrazione separata su Tradovate. I campi sono comunque gli stessi.", image: {"src":`${IMG}/tradovate-login-2.png`,"alt":"Modulo di accesso di Tradovate con i campi nome utente e password e il pulsante Login"} },
        { title: "Esamini e firmi gli accordi richiesti", html: "Al primo accesso (e occasionalmente in seguito), Tradovate Le chiede di esaminare e accettare gli accordi sui dati di mercato e sulla piattaforma. Compili quanto richiesto e accetti per continuare. Non raggiungerà la schermata di trading finché non saranno firmati.", image: {"src":`${IMG}/tradovate-login-3.png`,"alt":"Accesso a Tradovate con la schermata di accettazione dell’accordo sui dati di mercato"} },
