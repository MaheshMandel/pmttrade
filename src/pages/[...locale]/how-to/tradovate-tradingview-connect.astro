---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-tradingview-connect";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Connect Tradovate to TradingView (Add-On Setup)";
const META_DESCRIPTION =
  "Connect Tradovate to TradingView: enable the add-on, open the broker panel, and link your live or demo futures account to trade straight from charts.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate mit TradingView verbinden (Add-on-Einrichtung)", es: "Conecte Tradovate con TradingView (configuración del complemento)", fr: "Connecter Tradovate à TradingView (configuration du module complémentaire)", it: "Collegare Tradovate a TradingView (configurazione del componente aggiuntivo)" },
  dek: { en: "Want to trade Tradovate futures straight from your TradingView charts? Flip on the TradingView add-on inside Tradovate, then link the two accounts. Here's exactly how.", de: "Sie möchten Tradovate-Futures direkt aus Ihren TradingView-Charts handeln? Aktivieren Sie das TradingView-Add-on in Tradovate und verknüpfen Sie dann die beiden Konten. So gehen Sie genau vor.", es: "¿Quiere operar futuros de Tradovate directamente desde sus gráficos de TradingView? Active el complemento de TradingView dentro de Tradovate y luego vincule ambas cuentas. Aquí le explicamos exactamente cómo.", fr: "Vous souhaitez trader les contrats à terme Tradovate directement depuis vos graphiques TradingView ? Activez le module complémentaire TradingView dans Tradovate, puis reliez les deux comptes. Voici exactement comment faire.", it: "Vuole negoziare i futures Tradovate direttamente dai suoi grafici TradingView? Attivi il componente aggiuntivo TradingView all'interno di Tradovate, poi colleghi i due conti. Ecco esattamente come fare." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Want to trade Tradovate futures straight from your TradingView charts? Maybe you're after cleaner charting, you like tapping TradingView's shared trade ideas, or you're building toward full automation with PickMyTrade. Whatever the reason, the setup is the same: flip on the TradingView add-on inside Tradovate, then link the two accounts. Here's exactly how to do it, step by step." },
    { type: "heading", text: "What Is the Tradovate TradingView Add-On?" },
    { type: "paragraph", html: "The TradingView add-on is a Tradovate integration that lets you place and manage <strong class='text-white'>real orders in your Tradovate account directly from TradingView</strong>. Once it's switched on, TradingView lists Tradovate as a connectable broker, so your charts and your live or demo futures account talk to each other. Depending on your Tradovate plan, the add-on is either <strong class='text-white'>included or carries a small monthly fee</strong>, and on some plans the free access needs re-enabling each month, so check Tradovate's current add-on pricing for your account." },
    { type: "heading", text: "Connect Tradovate to TradingView: Step-by-Step" },
    { type: "paragraph", html: "Before you start, two things need to be true. You need an <strong class='text-white'>active, tradable Tradovate (or prop-firm) account</strong>, and you should log in to Tradovate at least once to accept any pending agreements. You'll also want a Tradovate market-data subscription to see live quotes and trade, data availability varies by account and prop firm, so confirm your firm's current rules." },
    {
      type: "steps",
      items: [
        { title: "Open Application Settings in Tradovate", html: "Log in to the <strong class='text-white'>Tradovate Web Trader</strong>, then open <strong class='text-white'>Application Settings</strong> from the settings icon in the top-right corner of the platform.", image: { src: `${IMG}/tradovate-tradingview-connect-1.png`, alt: "Tradovate Web Trader Application Settings menu opened from the top-right settings icon" } },
        { title: "Activate the TradingView Add-On", html: "Inside Application Settings, open the <strong class='text-white'>Add-ons</strong> (Add-On Tools) tab, find the <strong class='text-white'>TradingView add-on</strong>, and click <strong class='text-white'>Activate</strong>. If your plan includes it at no charge, keep in mind you may have to renew that free access every month to keep it live.", image: { src: `${IMG}/tradovate-tradingview-connect-2.png`, alt: "Tradovate Application Settings Add-ons tab showing the TradingView add-on with the Activate button" } },
        { title: "Refresh Your Tradovate Session", html: "Log out of Tradovate and log back in, or just refresh the platform, so the newly activated add-on actually takes effect. Do this before you try to connect from the TradingView side, otherwise Tradovate may not show up as an option yet.", image: { src: `${IMG}/tradovate-tradingview-connect-3.png`, alt: "Tradovate login screen shown after logging out to refresh the activated TradingView add-on" } },
        { title: "Open the Broker Panel in TradingView and Pick Tradovate", html: "Log in to <strong class='text-white'>TradingView</strong> and open the broker/trading panel, that's the <strong class='text-white'>Trading Panel</strong> tab at the bottom of the chart, or the <strong class='text-white'>Trade</strong> button. Open the broker list and select <strong class='text-white'>Tradovate</strong>.", image: { src: `${IMG}/tradovate-tradingview-connect-4.png`, alt: "TradingView trading panel showing Tradovate selected from the broker list" } },
        { title: "Choose Live or Demo and Sign In", html: "Pick whether you're connecting a <strong class='text-white'>Live</strong> brokerage account or a <strong class='text-white'>Demo</strong> (simulated) one, click <strong class='text-white'>Connect</strong>, then enter your Tradovate or prop-firm <strong class='text-white'>username and password</strong>. A connected (green) status confirms the link, and Tradovate now shows up as a tradable broker right on your charts.", image: { src: `${IMG}/tradovate-tradingview-connect-5.png`, alt: "TradingView Tradovate connection window showing Live and Demo options with the Connect button" } },
      ],
    },
    { type: "heading", text: "Why You'd Want This" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Trade Tradovate futures without leaving TradingView</strong>, charts, drawings, and order execution all live in one window.",
        "<strong class='text-white'>Blend indicators and ideas with real fills</strong>, act on your TradingView studies and setups directly, no copy-pasting between apps.",
        "<strong class='text-white'>Manage live or demo positions from one screen</strong>, whether you're practicing or trading real money.",
        "<strong class='text-white'>Lay the groundwork for automation</strong>, a working broker link is the first step toward alert-driven and webhook order routing.",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Once Tradovate and TradingView are linked, PickMyTrade takes it further. It turns your <strong class='text-white'>TradingView alerts into real Tradovate orders automatically</strong>, so entries, stops, and targets fire the moment your strategy triggers, no manual clicking, no staring at the screen waiting for a setup." },
  ], de: [
    { type: "paragraph",html: "Sie möchten Tradovate-Futures direkt aus Ihren TradingView-Charts handeln? Vielleicht wünschen Sie sich übersichtlichere Charts, nutzen gern die geteilten Trading-Ideen von TradingView oder arbeiten auf die vollständige Automatisierung mit PickMyTrade hin. Was auch immer der Grund ist, die Einrichtung ist dieselbe: Aktivieren Sie das TradingView-Add-on in Tradovate und verknüpfen Sie dann die beiden Konten. So gehen Sie genau vor, Schritt für Schritt." },
    { type: "heading",text: "Was ist das Tradovate-TradingView-Add-on?" },
    { type: "paragraph",html: "Das TradingView-Add-on ist eine Tradovate-Integration, mit der Sie <strong class='text-white'>echte Orders in Ihrem Tradovate-Konto direkt aus TradingView platzieren und verwalten</strong> können. Ist es aktiviert, listet TradingView Tradovate als verbindbaren Broker auf, sodass Ihre Charts und Ihr Live- oder Demo-Futures-Konto miteinander kommunizieren. Je nach Tradovate-Tarif ist das Add-on entweder <strong class='text-white'>enthalten oder mit einer geringen monatlichen Gebühr verbunden</strong>, und bei manchen Tarifen muss der kostenlose Zugang jeden Monat neu aktiviert werden. Prüfen Sie daher die aktuellen Add-on-Preise von Tradovate für Ihr Konto." },
    { type: "heading",text: "Tradovate mit TradingView verbinden: Schritt für Schritt" },
    { type: "paragraph",html: "Bevor Sie beginnen, müssen zwei Dinge erfüllt sein. Sie benötigen ein <strong class='text-white'>aktives, handelbares Tradovate-Konto (oder Prop-Firm-Konto)</strong>, und Sie sollten sich mindestens einmal bei Tradovate anmelden, um ausstehende Vereinbarungen zu akzeptieren. Außerdem brauchen Sie ein Tradovate-Marktdaten-Abonnement, um Live-Kurse zu sehen und zu handeln. Die Verfügbarkeit von Daten variiert je nach Konto und Prop-Firma, bestätigen Sie daher die aktuellen Regeln Ihrer Firma." },
    {
      type: "steps",
      items: [
        { title: "Application Settings in Tradovate öffnen", html: "Melden Sie sich beim <strong class='text-white'>Tradovate Web Trader</strong> an und öffnen Sie dann die <strong class='text-white'>Application Settings</strong> über das Einstellungssymbol oben rechts in der Plattform.", image: {"src":`${IMG}/tradovate-tradingview-connect-1.png`,"alt":"Menü Application Settings des Tradovate Web Trader, geöffnet über das Einstellungssymbol oben rechts"} },
        { title: "Das TradingView-Add-on aktivieren", html: "Öffnen Sie in den Application Settings den Tab <strong class='text-white'>Add-ons</strong> (Add-On Tools), suchen Sie das <strong class='text-white'>TradingView-Add-on</strong> und klicken Sie auf <strong class='text-white'>Activate</strong>. Falls Ihr Tarif es ohne Aufpreis enthält, denken Sie daran, dass Sie diesen kostenlosen Zugang möglicherweise jeden Monat erneuern müssen, damit er aktiv bleibt.", image: {"src":`${IMG}/tradovate-tradingview-connect-2.png`,"alt":"Tab Add-ons in den Tradovate Application Settings mit dem TradingView-Add-on und der Schaltfläche Activate"} },
        { title: "Ihre Tradovate-Sitzung aktualisieren", html: "Melden Sie sich bei Tradovate ab und wieder an oder aktualisieren Sie einfach die Plattform, damit das neu aktivierte Add-on tatsächlich wirksam wird. Tun Sie das, bevor Sie versuchen, sich von der TradingView-Seite aus zu verbinden, da Tradovate sonst möglicherweise noch nicht als Option erscheint.", image: {"src":`${IMG}/tradovate-tradingview-connect-3.png`,"alt":"Tradovate-Anmeldebildschirm nach dem Abmelden, um das aktivierte TradingView-Add-on zu aktualisieren"} },
        { title: "Das Broker-Panel in TradingView öffnen und Tradovate wählen", html: "Melden Sie sich bei <strong class='text-white'>TradingView</strong> an und öffnen Sie das Broker-/Trading-Panel. Das ist der Tab <strong class='text-white'>Trading Panel</strong> am unteren Chart-Rand oder die Schaltfläche <strong class='text-white'>Trade</strong>. Öffnen Sie die Broker-Liste und wählen Sie <strong class='text-white'>Tradovate</strong>.", image: {"src":`${IMG}/tradovate-tradingview-connect-4.png`,"alt":"TradingView-Trading-Panel mit aus der Broker-Liste ausgewähltem Tradovate"} },
        { title: "Live oder Demo wählen und anmelden", html: "Wählen Sie, ob Sie ein <strong class='text-white'>Live</strong>-Brokerkonto oder ein <strong class='text-white'>Demo</strong>-Konto (simuliert) verbinden, klicken Sie auf <strong class='text-white'>Connect</strong> und geben Sie dann Ihren Tradovate- oder Prop-Firm-<strong class='text-white'>Benutzernamen und Ihr Passwort</strong> ein. Ein verbundener (grüner) Status bestätigt die Verknüpfung, und Tradovate erscheint nun als handelbarer Broker direkt in Ihren Charts.", image: {"src":`${IMG}/tradovate-tradingview-connect-5.png`,"alt":"TradingView-Verbindungsfenster für Tradovate mit den Optionen Live und Demo und der Schaltfläche Connect"} },
      ],
    },
    { type: "heading",text: "Warum Sie das wollen sollten" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Handeln Sie Tradovate-Futures, ohne TradingView zu verlassen</strong>, Charts, Zeichnungen und Orderausführung befinden sich in einem Fenster.",
        "<strong class='text-white'>Verbinden Sie Indikatoren und Ideen mit echten Ausführungen</strong>, handeln Sie Ihre TradingView-Studien und Setups direkt, ohne Copy-and-paste zwischen Apps.",
        "<strong class='text-white'>Verwalten Sie Live- oder Demo-Positionen von einem Bildschirm aus</strong>, ob Sie üben oder mit echtem Geld handeln.",
        "<strong class='text-white'>Legen Sie die Grundlage für Automatisierung</strong>, eine funktionierende Broker-Verbindung ist der erste Schritt zu alarmgesteuertem und Webhook-basiertem Order-Routing.",
      ],
    },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "Sobald Tradovate und TradingView verknüpft sind, geht PickMyTrade noch einen Schritt weiter. Es verwandelt Ihre <strong class='text-white'>TradingView-Alarme automatisch in echte Tradovate-Orders</strong>, sodass Einstiege, Stops und Ziele in dem Moment ausgelöst werden, in dem Ihre Strategie anspringt, ohne manuelles Klicken und ohne Starren auf den Bildschirm, bis ein Setup erscheint." },
  ], es: [
    { type: "paragraph",html: "¿Quiere operar futuros de Tradovate directamente desde sus gráficos de TradingView? Quizá busque gráficos más claros, le guste aprovechar las ideas de trading compartidas de TradingView o esté avanzando hacia la automatización completa con PickMyTrade. Sea cual sea el motivo, la configuración es la misma: active el complemento de TradingView dentro de Tradovate y luego vincule las dos cuentas. Aquí le explicamos exactamente cómo hacerlo, paso a paso." },
    { type: "heading",text: "¿Qué es el complemento de TradingView de Tradovate?" },
    { type: "paragraph",html: "El complemento de TradingView es una integración de Tradovate que le permite <strong class='text-white'>colocar y gestionar órdenes reales en su cuenta de Tradovate directamente desde TradingView</strong>. Una vez activado, TradingView muestra a Tradovate como bróker conectable, de modo que sus gráficos y su cuenta de futuros real o demo se comunican entre sí. Según su plan de Tradovate, el complemento está <strong class='text-white'>incluido o tiene una pequeña cuota mensual</strong>, y en algunos planes el acceso gratuito debe volver a activarse cada mes, así que consulte los precios vigentes del complemento de Tradovate para su cuenta." },
    { type: "heading",text: "Conecte Tradovate con TradingView: paso a paso" },
    { type: "paragraph",html: "Antes de empezar, deben cumplirse dos condiciones. Necesita una <strong class='text-white'>cuenta de Tradovate (o de prop firm) activa y operable</strong>, y debería iniciar sesión en Tradovate al menos una vez para aceptar cualquier acuerdo pendiente. También le conviene tener una suscripción de datos de mercado de Tradovate para ver cotizaciones en vivo y operar; la disponibilidad de datos varía según la cuenta y la prop firm, así que confirme las reglas vigentes de su firma." },
    {
      type: "steps",
      items: [
        { title: "Abra Application Settings en Tradovate", html: "Inicie sesión en el <strong class='text-white'>Tradovate Web Trader</strong> y abra <strong class='text-white'>Application Settings</strong> desde el icono de ajustes situado en la esquina superior derecha de la plataforma.", image: {"src":`${IMG}/tradovate-tradingview-connect-1.png`,"alt":"Menú Application Settings del Tradovate Web Trader abierto desde el icono de ajustes de la esquina superior derecha"} },
        { title: "Active el complemento de TradingView", html: "Dentro de Application Settings, abra la pestaña <strong class='text-white'>Add-ons</strong> (Add-On Tools), busque el <strong class='text-white'>complemento de TradingView</strong> y haga clic en <strong class='text-white'>Activate</strong>. Si su plan lo incluye sin coste, tenga en cuenta que quizá deba renovar ese acceso gratuito cada mes para mantenerlo activo.", image: {"src":`${IMG}/tradovate-tradingview-connect-2.png`,"alt":"Pestaña Add-ons de Application Settings de Tradovate con el complemento de TradingView y el botón Activate"} },
        { title: "Actualice su sesión de Tradovate", html: "Cierre sesión en Tradovate y vuelva a iniciarla, o simplemente actualice la plataforma, para que el complemento recién activado surta efecto. Hágalo antes de intentar conectarse desde TradingView; de lo contrario, es posible que Tradovate aún no aparezca como opción.", image: {"src":`${IMG}/tradovate-tradingview-connect-3.png`,"alt":"Pantalla de inicio de sesión de Tradovate tras cerrar sesión para actualizar el complemento de TradingView activado"} },
        { title: "Abra el panel de brókeres en TradingView y elija Tradovate", html: "Inicie sesión en <strong class='text-white'>TradingView</strong> y abra el panel de bróker/trading: es la pestaña <strong class='text-white'>Trading Panel</strong> situada en la parte inferior del gráfico, o el botón <strong class='text-white'>Trade</strong>. Abra la lista de brókeres y seleccione <strong class='text-white'>Tradovate</strong>.", image: {"src":`${IMG}/tradovate-tradingview-connect-4.png`,"alt":"Panel de trading de TradingView con Tradovate seleccionado en la lista de brókeres"} },
        { title: "Elija Live o Demo e inicie sesión", html: "Elija si va a conectar una cuenta de bróker <strong class='text-white'>Live</strong> o una cuenta <strong class='text-white'>Demo</strong> (simulada), haga clic en <strong class='text-white'>Connect</strong> e introduzca su <strong class='text-white'>nombre de usuario y contraseña</strong> de Tradovate o de la prop firm. Un estado conectado (verde) confirma el enlace, y Tradovate aparece ya como bróker operable directamente en sus gráficos.", image: {"src":`${IMG}/tradovate-tradingview-connect-5.png`,"alt":"Ventana de conexión de TradingView con Tradovate mostrando las opciones Live y Demo y el botón Connect"} },
      ],
    },
    { type: "heading",text: "Por qué le conviene" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Opere futuros de Tradovate sin salir de TradingView</strong>, gráficos, dibujos y ejecución de órdenes conviven en una sola ventana.",
        "<strong class='text-white'>Combine indicadores e ideas con ejecuciones reales</strong>, actúe sobre sus estudios y configuraciones de TradingView directamente, sin copiar y pegar entre aplicaciones.",
        "<strong class='text-white'>Gestione posiciones reales o demo desde una sola pantalla</strong>, tanto si practica como si opera con dinero real.",
        "<strong class='text-white'>Siente las bases de la automatización</strong>, un enlace de bróker operativo es el primer paso hacia el enrutamiento de órdenes mediante alertas y webhooks.",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Una vez vinculados Tradovate y TradingView, PickMyTrade va más allá. Convierte sus <strong class='text-white'>alertas de TradingView en órdenes reales de Tradovate de forma automática</strong>, de modo que entradas, stops y objetivos se ejecutan en el instante en que se activa su estrategia, sin clics manuales y sin quedarse mirando la pantalla esperando una configuración." },
  ], fr: [
    { type: "paragraph",html: "Vous souhaitez trader les contrats à terme Tradovate directement depuis vos graphiques TradingView ? Peut-être recherchez-vous des graphiques plus clairs, aimez-vous puiser dans les idées de trading partagées de TradingView, ou préparez-vous une automatisation complète avec PickMyTrade. Quelle qu'en soit la raison, la configuration est la même : activez le module complémentaire TradingView dans Tradovate, puis reliez les deux comptes. Voici exactement comment procéder, étape par étape." },
    { type: "heading",text: "Qu'est-ce que le module complémentaire TradingView de Tradovate ?" },
    { type: "paragraph",html: "Le module complémentaire TradingView est une intégration Tradovate qui vous permet de <strong class='text-white'>passer et gérer de vrais ordres sur votre compte Tradovate directement depuis TradingView</strong>. Une fois activé, TradingView répertorie Tradovate comme courtier connectable, de sorte que vos graphiques et votre compte de contrats à terme réel ou démo communiquent entre eux. Selon votre formule Tradovate, le module est soit <strong class='text-white'>inclus, soit assorti d'un petit abonnement mensuel</strong>, et sur certaines formules l'accès gratuit doit être réactivé chaque mois ; consultez donc les tarifs actuels du module Tradovate pour votre compte." },
    { type: "heading",text: "Connecter Tradovate à TradingView : pas à pas" },
    { type: "paragraph",html: "Avant de commencer, deux conditions doivent être réunies. Vous avez besoin d'un <strong class='text-white'>compte Tradovate (ou de prop firm) actif et négociable</strong>, et vous devriez vous connecter à Tradovate au moins une fois pour accepter les éventuels accords en attente. Il vous faut aussi un abonnement aux données de marché Tradovate pour voir les cotations en direct et trader ; la disponibilité des données varie selon le compte et la prop firm, confirmez donc les règles actuelles de votre firme." },
    {
      type: "steps",
      items: [
        { title: "Ouvrez Application Settings dans Tradovate", html: "Connectez-vous au <strong class='text-white'>Tradovate Web Trader</strong>, puis ouvrez <strong class='text-white'>Application Settings</strong> depuis l'icône des paramètres située en haut à droite de la plateforme.", image: {"src":`${IMG}/tradovate-tradingview-connect-1.png`,"alt":"Menu Application Settings du Tradovate Web Trader ouvert depuis l'icône des paramètres en haut à droite"} },
        { title: "Activez le module complémentaire TradingView", html: "Dans Application Settings, ouvrez l'onglet <strong class='text-white'>Add-ons</strong> (Add-On Tools), repérez le <strong class='text-white'>module complémentaire TradingView</strong> et cliquez sur <strong class='text-white'>Activate</strong>. Si votre formule l'inclut gratuitement, gardez à l'esprit que vous devrez peut-être renouveler cet accès gratuit chaque mois pour le maintenir actif.", image: {"src":`${IMG}/tradovate-tradingview-connect-2.png`,"alt":"Onglet Add-ons des Application Settings de Tradovate affichant le module complémentaire TradingView avec le bouton Activate"} },
        { title: "Actualisez votre session Tradovate", html: "Déconnectez-vous de Tradovate puis reconnectez-vous, ou actualisez simplement la plateforme, afin que le module nouvellement activé prenne réellement effet. Faites-le avant d'essayer de vous connecter depuis TradingView, faute de quoi Tradovate risque de ne pas encore apparaître comme option.", image: {"src":`${IMG}/tradovate-tradingview-connect-3.png`,"alt":"Écran de connexion Tradovate affiché après la déconnexion pour actualiser le module complémentaire TradingView activé"} },
        { title: "Ouvrez le panneau des courtiers dans TradingView et choisissez Tradovate", html: "Connectez-vous à <strong class='text-white'>TradingView</strong> et ouvrez le panneau courtier/trading : c'est l'onglet <strong class='text-white'>Trading Panel</strong> en bas du graphique, ou le bouton <strong class='text-white'>Trade</strong>. Ouvrez la liste des courtiers et sélectionnez <strong class='text-white'>Tradovate</strong>.", image: {"src":`${IMG}/tradovate-tradingview-connect-4.png`,"alt":"Panneau de trading TradingView avec Tradovate sélectionné dans la liste des courtiers"} },
        { title: "Choisissez Live ou Demo et connectez-vous", html: "Indiquez si vous connectez un compte de courtage <strong class='text-white'>Live</strong> ou un compte <strong class='text-white'>Demo</strong> (simulé), cliquez sur <strong class='text-white'>Connect</strong>, puis saisissez votre <strong class='text-white'>nom d'utilisateur et mot de passe</strong> Tradovate ou de prop firm. Un statut connecté (vert) confirme la liaison, et Tradovate apparaît désormais comme courtier négociable directement sur vos graphiques.", image: {"src":`${IMG}/tradovate-tradingview-connect-5.png`,"alt":"Fenêtre de connexion TradingView à Tradovate affichant les options Live et Demo avec le bouton Connect"} },
      ],
    },
    { type: "heading",text: "Pourquoi vous voudrez le faire" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Tradez les contrats à terme Tradovate sans quitter TradingView</strong>, graphiques, tracés et exécution des ordres tiennent dans une seule fenêtre.",
        "<strong class='text-white'>Alliez indicateurs et idées à de vraies exécutions</strong>, agissez directement sur vos études et setups TradingView, sans copier-coller entre applications.",
        "<strong class='text-white'>Gérez vos positions réelles ou démo depuis un seul écran</strong>, que vous vous entraîniez ou que vous tradiez avec de l'argent réel.",
