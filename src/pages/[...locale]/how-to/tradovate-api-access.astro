---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-api-access";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Get Tradovate API Access & Generate a Key";
const META_DESCRIPTION =
  "Tradovate API access made simple: enable the API Access add-on, generate your API key, and copy your cid and secret to connect any trading bot.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate API", de: "Tradovate API", es: "Tradovate API", fr: "Tradovate API", it: "Tradovate API" },
  h1: { en: META_TITLE, de: "Tradovate-API-Zugang erhalten & Schlüssel generieren", es: "Obtenga acceso a la API de Tradovate y genere una clave", fr: "Obtenir l’accès à l’API Tradovate et générer une clé", it: "Ottenere l’accesso all’API di Tradovate e generare una chiave" },
  dek: { en: "Want to wire a bot or a third-party app into Tradovate? Here's exactly how to turn on API access and generate your key and secret, step by step.", de: "Möchten Sie einen Bot oder eine Drittanbieter-App mit Tradovate verbinden? So aktivieren Sie den API-Zugang und generieren Ihren Schlüssel samt Secret, Schritt für Schritt.", es: "¿Quiere conectar un bot o una aplicación de terceros a Tradovate? Así se activa el acceso a la API y se generan su clave y su secret, paso a paso.", fr: "Vous souhaitez connecter un bot ou une application tierce à Tradovate ? Voici comment activer l’accès à l’API et générer votre clé et votre secret, étape par étape.", it: "Vuole collegare un bot o un’app di terze parti a Tradovate? Ecco come attivare l’accesso all’API e generare la Sua chiave e il Suo secret, passo dopo passo." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Want to wire a bot or a third-party app into Tradovate? Maybe you're building your own strategy, hooking up a charting tool, or automating your entries with PickMyTrade. Either way, the first thing you need is API access and a set of credentials. Here's exactly how to turn it on and generate your key and secret, step by step." },
    { type: "heading", text: "What Is Tradovate API Access?" },
    { type: "paragraph", html: "Tradovate API access is a paid <strong class='text-white'>add-on</strong> that opens up programmatic access to your account. With it, outside software can pull data and place orders through Tradovate's REST and WebSocket APIs. Once you switch it on, you generate a pair of credentials, a <strong class='text-white'>cid</strong> (client ID) and a <strong class='text-white'>secret</strong>, that identify your application when it logs in. You'll reach for these any time you connect a custom script, a bridge service, or a trading bot straight to your Tradovate account." },
    { type: "heading", text: "Get Tradovate API Access: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Confirm You Have a Funded Live Account", html: "API access only lives on a <strong class='text-white'>live, funded Tradovate account</strong> that clears Tradovate's current minimum balance. Demo accounts and unfunded accounts simply can't generate keys, there's no workaround. The minimum can shift over time, so check Tradovate's current number before you start rather than trusting an old figure." },
        { title: "Open Application Settings", html: "Log in to the Tradovate web platform and open <strong class='text-white'>Application Settings</strong>, that's the settings/gear area, usually tucked into the top-right of the trading screen. This is where every account-level option lives, add-ons included." },
        { title: "Activate the API Access Add-On", html: "Inside Application Settings, head to the <strong class='text-white'>Add-Ons</strong> section, find <strong class='text-white'>API Access</strong>, and click <strong class='text-white'>Activate</strong>. This is a paid monthly subscription, and the price moves, so check the current fee before you commit. Once it's active, a new API Access option shows up in your settings." },
        { title: "Generate Your API Key", html: "Open the <strong class='text-white'>API Access</strong> tab and click <strong class='text-white'>Generate API Key</strong>. Give the key a clear nickname, something like \"PMT-Bot\" so you'll recognize it later, then work through the self-attestations that confirm you understand automated futures trading, sign the digital agreement, and pick the permissions the key should carry. If your app needs to place orders, give it full access. Then hit <strong class='text-white'>Generate</strong>." },
        { title: "Copy and Store Your cid and Secret", html: "Tradovate shows your new credentials, the <strong class='text-white'>cid</strong> and the <strong class='text-white'>secret</strong>, <strong class='text-white'>one time only</strong>. Copy both right away and stash them somewhere safe, like a password manager, not a public repo. Lose the secret and there's no recovery; you'll have to generate a fresh key and update your app. Don't share these values or commit them to a shared codebase." },
      ],
    },
    { type: "heading", text: "Why You'd Need This" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Run trading bots</strong> that place and manage orders programmatically.",
        "<strong class='text-white'>Connect third-party tools</strong>, charting, journaling, or risk apps, to your account.",
        "<strong class='text-white'>Build custom automation</strong> on top of Tradovate's REST and WebSocket APIs.",
        "<strong class='text-white'>Feed live data</strong> into your own dashboards and analytics.",
        "<strong class='text-white'>Bridge TradingView alerts</strong> to Tradovate through an automation service.",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Juggling your own API credentials, tokens, and device IDs is a lot of moving parts to keep straight. <strong class='text-white'>PickMyTrade wires your TradingView alerts directly to your Tradovate account</strong> and handles the connection for you, your signals turn into live orders automatically, with no custom code to babysit." },
  ], de: [
    { type: "paragraph",html: "Möchten Sie einen Bot oder eine Drittanbieter-App mit Tradovate verbinden? Vielleicht entwickeln Sie eine eigene Strategie, binden ein Charting-Tool an oder automatisieren Ihre Einstiege mit PickMyTrade. In jedem Fall brauchen Sie zuerst API-Zugang und ein Set an Zugangsdaten. So aktivieren Sie ihn und generieren Ihren Schlüssel samt Secret, Schritt für Schritt." },
    { type: "heading",text: "Was ist Tradovate-API-Zugang?" },
    { type: "paragraph",html: "Der Tradovate-API-Zugang ist ein kostenpflichtiges <strong class='text-white'>Add-on</strong>, das den programmatischen Zugriff auf Ihr Konto freischaltet. Damit kann externe Software über die REST- und WebSocket-APIs von Tradovate Daten abrufen und Orders platzieren. Sobald Sie ihn aktiviert haben, generieren Sie ein Paar Zugangsdaten, eine <strong class='text-white'>cid</strong> (Client-ID) und ein <strong class='text-white'>secret</strong>, die Ihre Anwendung beim Login identifizieren. Sie benötigen sie immer dann, wenn Sie ein eigenes Skript, einen Bridge-Dienst oder einen Trading-Bot direkt mit Ihrem Tradovate-Konto verbinden." },
    { type: "heading",text: "Tradovate-API-Zugang erhalten: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Bestätigen Sie, dass Sie ein Live-Konto mit Guthaben haben", html: "API-Zugang gibt es nur für ein <strong class='text-white'>Tradovate-Live-Konto mit Guthaben</strong>, das den aktuellen Mindestkontostand von Tradovate erfüllt. Demo-Konten und Konten ohne Guthaben können keine Schlüssel generieren, dafür gibt es keinen Workaround. Der Mindestbetrag kann sich im Laufe der Zeit ändern; prüfen Sie daher die aktuelle Zahl bei Tradovate, bevor Sie beginnen, anstatt sich auf einen alten Wert zu verlassen." },
        { title: "Öffnen Sie die Application Settings", html: "Melden Sie sich bei der Tradovate-Webplattform an und öffnen Sie die <strong class='text-white'>Application Settings</strong>, den Einstellungs-/Zahnradbereich, der meist oben rechts im Trading-Bildschirm zu finden ist. Hier befinden sich alle Optionen auf Kontoebene, einschließlich der Add-ons." },
        { title: "Aktivieren Sie das Add-on API Access", html: "Gehen Sie in den Application Settings zum Bereich <strong class='text-white'>Add-Ons</strong>, suchen Sie <strong class='text-white'>API Access</strong> und klicken Sie auf <strong class='text-white'>Activate</strong>. Dies ist ein kostenpflichtiges Monatsabonnement, und der Preis ändert sich, prüfen Sie daher die aktuelle Gebühr, bevor Sie sich verpflichten. Sobald es aktiv ist, erscheint in Ihren Einstellungen eine neue Option API Access." },
        { title: "Generieren Sie Ihren API-Schlüssel", html: "Öffnen Sie den Tab <strong class='text-white'>API Access</strong> und klicken Sie auf <strong class='text-white'>Generate API Key</strong>. Geben Sie dem Schlüssel einen eindeutigen Namen, etwa „PMT-Bot“, damit Sie ihn später wiedererkennen, und gehen Sie dann die Selbstbestätigungen durch, mit denen Sie bestätigen, dass Sie den automatisierten Futures-Handel verstehen, unterzeichnen Sie die digitale Vereinbarung und wählen Sie die Berechtigungen, die der Schlüssel erhalten soll. Wenn Ihre App Orders platzieren soll, vergeben Sie vollen Zugriff. Klicken Sie anschließend auf <strong class='text-white'>Generate</strong>." },
        { title: "Kopieren und speichern Sie Ihre cid und Ihr Secret", html: "Tradovate zeigt Ihre neuen Zugangsdaten, die <strong class='text-white'>cid</strong> und das <strong class='text-white'>secret</strong>, <strong class='text-white'>nur ein einziges Mal</strong> an. Kopieren Sie beide sofort und legen Sie sie sicher ab, etwa in einem Passwortmanager, nicht in einem öffentlichen Repository. Wenn Sie das Secret verlieren, gibt es keine Wiederherstellung; Sie müssen einen neuen Schlüssel generieren und Ihre App aktualisieren. Geben Sie diese Werte nicht weiter und committen Sie sie nicht in eine gemeinsam genutzte Codebasis." },
      ],
    },
    { type: "heading",text: "Wofür Sie das brauchen" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Trading-Bots betreiben</strong>, die Orders programmatisch platzieren und verwalten.",
        "<strong class='text-white'>Tools von Drittanbietern verbinden</strong>, Charting-, Journaling- oder Risiko-Apps, mit Ihrem Konto.",
        "<strong class='text-white'>Eigene Automatisierung entwickeln</strong> auf Basis der REST- und WebSocket-APIs von Tradovate.",
        "<strong class='text-white'>Live-Daten einspeisen</strong> in Ihre eigenen Dashboards und Analysen.",
        "<strong class='text-white'>TradingView-Alerts anbinden</strong> an Tradovate über einen Automatisierungsdienst.",
      ],
    },
    { type: "heading",text: "Automatisieren Sie das mit PickMyTrade" },
    { type: "paragraph",html: "Eigene API-Zugangsdaten, Tokens und Geräte-IDs zu verwalten, sind viele bewegliche Teile, die Sie im Blick behalten müssen. <strong class='text-white'>PickMyTrade verbindet Ihre TradingView-Alerts direkt mit Ihrem Tradovate-Konto</strong> und übernimmt die Anbindung für Sie, Ihre Signale werden automatisch zu Live-Orders, ohne eigenen Code, um den Sie sich kümmern müssten." },
  ], es: [
    { type: "paragraph",html: "¿Quiere conectar un bot o una aplicación de terceros a Tradovate? Quizá esté creando su propia estrategia, conectando una herramienta de gráficos o automatizando sus entradas con PickMyTrade. En cualquier caso, lo primero que necesita es acceso a la API y un conjunto de credenciales. Así se activa y se generan su clave y su secret, paso a paso." },
    { type: "heading",text: "¿Qué es el acceso a la API de Tradovate?" },
    { type: "paragraph",html: "El acceso a la API de Tradovate es un <strong class='text-white'>complemento</strong> de pago que abre el acceso programático a su cuenta. Con él, software externo puede extraer datos y colocar órdenes a través de las API REST y WebSocket de Tradovate. Una vez que lo activa, genera un par de credenciales, una <strong class='text-white'>cid</strong> (ID de cliente) y un <strong class='text-white'>secret</strong>, que identifican a su aplicación al iniciar sesión. Las necesitará siempre que conecte un script personalizado, un servicio puente o un bot de trading directamente a su cuenta de Tradovate." },
    { type: "heading",text: "Obtenga acceso a la API de Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Confirme que tiene una cuenta real con fondos", html: "El acceso a la API solo existe en una <strong class='text-white'>cuenta real de Tradovate con fondos</strong> que cumpla el saldo mínimo actual de Tradovate. Las cuentas demo y las cuentas sin fondos no pueden generar claves, y no hay forma de evitarlo. El mínimo puede cambiar con el tiempo, así que consulte la cifra vigente de Tradovate antes de empezar en lugar de fiarse de un dato antiguo." },
        { title: "Abra Application Settings", html: "Inicie sesión en la plataforma web de Tradovate y abra <strong class='text-white'>Application Settings</strong>, el área de ajustes/engranaje, normalmente situada en la parte superior derecha de la pantalla de trading. Aquí se encuentran todas las opciones a nivel de cuenta, incluidos los complementos." },
        { title: "Active el complemento API Access", html: "Dentro de Application Settings, vaya a la sección <strong class='text-white'>Add-Ons</strong>, busque <strong class='text-white'>API Access</strong> y haga clic en <strong class='text-white'>Activate</strong>. Es una suscripción mensual de pago y el precio cambia, así que consulte la tarifa vigente antes de comprometerse. Una vez activo, aparece una nueva opción API Access en sus ajustes." },
        { title: "Genere su clave de API", html: "Abra la pestaña <strong class='text-white'>API Access</strong> y haga clic en <strong class='text-white'>Generate API Key</strong>. Póngale a la clave un nombre claro, algo como «PMT-Bot», para reconocerla más adelante; después complete las autodeclaraciones que confirman que comprende el trading automatizado de futuros, firme el acuerdo digital y elija los permisos que debe tener la clave. Si su aplicación necesita colocar órdenes, concédale acceso completo. Después haga clic en <strong class='text-white'>Generate</strong>." },
        { title: "Copie y guarde su cid y su secret", html: "Tradovate muestra sus nuevas credenciales, la <strong class='text-white'>cid</strong> y el <strong class='text-white'>secret</strong>, <strong class='text-white'>una sola vez</strong>. Copie ambos de inmediato y guárdelos en un lugar seguro, como un gestor de contraseñas, no en un repositorio público. Si pierde el secret, no hay recuperación; tendrá que generar una clave nueva y actualizar su aplicación. No comparta estos valores ni los suba a una base de código compartida." },
      ],
    },
    { type: "heading",text: "Por qué lo necesitaría" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Ejecutar bots de trading</strong> que colocan y gestionan órdenes de forma programática.",
        "<strong class='text-white'>Conectar herramientas de terceros</strong>, aplicaciones de gráficos, diario o riesgo, a su cuenta.",
        "<strong class='text-white'>Crear automatización personalizada</strong> sobre las API REST y WebSocket de Tradovate.",
        "<strong class='text-white'>Alimentar con datos en vivo</strong> sus propios paneles y análisis.",
        "<strong class='text-white'>Conectar alertas de TradingView</strong> con Tradovate mediante un servicio de automatización.",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Gestionar sus propias credenciales de API, tokens e ID de dispositivo son muchas piezas móviles que mantener en orden. <strong class='text-white'>PickMyTrade conecta sus alertas de TradingView directamente con su cuenta de Tradovate</strong> y se encarga de la conexión por usted; sus señales se convierten en órdenes reales de forma automática, sin código personalizado del que ocuparse." },
  ], fr: [
    { type: "paragraph",html: "Vous souhaitez connecter un bot ou une application tierce à Tradovate ? Peut-être développez-vous votre propre stratégie, reliez-vous un outil de graphiques ou automatisez-vous vos entrées avec PickMyTrade. Dans tous les cas, la première chose dont vous avez besoin est l’accès à l’API et un jeu d’identifiants. Voici comment l’activer et générer votre clé et votre secret, étape par étape." },
    { type: "heading",text: "Qu’est-ce que l’accès à l’API Tradovate ?" },
    { type: "paragraph",html: "L’accès à l’API Tradovate est un <strong class='text-white'>module complémentaire</strong> payant qui ouvre l’accès programmatique à votre compte. Grâce à lui, un logiciel externe peut récupérer des données et passer des ordres via les API REST et WebSocket de Tradovate. Une fois activé, vous générez une paire d’identifiants, un <strong class='text-white'>cid</strong> (identifiant client) et un <strong class='text-white'>secret</strong>, qui identifient votre application lors de la connexion. Vous en aurez besoin chaque fois que vous connectez un script personnalisé, un service passerelle ou un bot de trading directement à votre compte Tradovate." },
    { type: "heading",text: "Obtenir l’accès à l’API Tradovate : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Vérifiez que vous disposez d’un compte réel approvisionné", html: "L’accès à l’API n’existe que sur un <strong class='text-white'>compte Tradovate réel et approvisionné</strong> qui respecte le solde minimum actuel de Tradovate. Les comptes démo et les comptes non approvisionnés ne peuvent tout simplement pas générer de clés, et il n’existe aucun contournement. Le minimum peut évoluer ; vérifiez donc le montant en vigueur chez Tradovate avant de commencer plutôt que de vous fier à un ancien chiffre." },
        { title: "Ouvrez les Application Settings", html: "Connectez-vous à la plateforme web Tradovate et ouvrez les <strong class='text-white'>Application Settings</strong>, la zone des paramètres (icône d’engrenage), généralement située en haut à droite de l’écran de trading. C’est là que se trouvent toutes les options au niveau du compte, y compris les modules complémentaires." },
        { title: "Activez le module complémentaire API Access", html: "Dans les Application Settings, rendez-vous dans la section <strong class='text-white'>Add-Ons</strong>, repérez <strong class='text-white'>API Access</strong> et cliquez sur <strong class='text-white'>Activate</strong>. Il s’agit d’un abonnement mensuel payant dont le prix évolue ; vérifiez donc le tarif en vigueur avant de vous engager. Une fois activé, une nouvelle option API Access apparaît dans vos paramètres." },
        { title: "Générez votre clé API", html: "Ouvrez l’onglet <strong class='text-white'>API Access</strong> et cliquez sur <strong class='text-white'>Generate API Key</strong>. Donnez à la clé un nom explicite, par exemple « PMT-Bot », afin de la reconnaître plus tard, puis remplissez les auto-attestations qui confirment que vous comprenez le trading automatisé de contrats à terme, signez l’accord numérique et choisissez les autorisations dont la clé doit disposer. Si votre application doit passer des ordres, accordez-lui un accès complet. Cliquez ensuite sur <strong class='text-white'>Generate</strong>." },
        { title: "Copiez et conservez votre cid et votre secret", html: "Tradovate affiche vos nouveaux identifiants, le <strong class='text-white'>cid</strong> et le <strong class='text-white'>secret</strong>, <strong class='text-white'>une seule fois</strong>. Copiez-les tous les deux immédiatement et rangez-les en lieu sûr, par exemple dans un gestionnaire de mots de passe, pas dans un dépôt public. Si vous perdez le secret, il n’existe aucune récupération ; vous devrez générer une nouvelle clé et mettre à jour votre application. Ne partagez pas ces valeurs et ne les versionnez pas dans une base de code partagée." },
      ],
    },
    { type: "heading",text: "Pourquoi vous en avez besoin" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Exécuter des bots de trading</strong> qui passent et gèrent des ordres par programmation.",
        "<strong class='text-white'>Connecter des outils tiers</strong>, graphiques, journal de trading ou gestion du risque, à votre compte.",
        "<strong class='text-white'>Créer une automatisation sur mesure</strong> au-dessus des API REST et WebSocket de Tradovate.",
        "<strong class='text-white'>Alimenter en données en direct</strong> vos propres tableaux de bord et analyses.",
        "<strong class='text-white'>Relier des alertes TradingView</strong> à Tradovate via un service d’automatisation.",
      ],
    },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Gérer vous-même vos identifiants d’API, vos tokens et vos identifiants d’appareil, cela fait beaucoup d’éléments à surveiller. <strong class='text-white'>PickMyTrade relie vos alertes TradingView directement à votre compte Tradovate</strong> et gère la connexion pour vous ; vos signaux deviennent automatiquement des ordres réels, sans code sur mesure à surveiller." },
  ], it: [
    { type: "paragraph",html: "Vuole collegare un bot o un’app di terze parti a Tradovate? Magari sta creando una Sua strategia, collegando uno strumento di grafica o automatizzando le Sue entrate con PickMyTrade. In ogni caso, la prima cosa di cui ha bisogno è l’accesso all’API e un set di credenziali. Ecco come attivarlo e generare la Sua chiave e il Suo secret, passo dopo passo." },
    { type: "heading",text: "Che cos’è l’accesso all’API di Tradovate?" },
    { type: "paragraph",html: "L’accesso all’API di Tradovate è un <strong class='text-white'>componente aggiuntivo</strong> a pagamento che apre l’accesso programmatico al Suo conto. Grazie ad esso, software esterni possono recuperare dati e inserire ordini tramite le API REST e WebSocket di Tradovate. Una volta attivato, genera una coppia di credenziali, un <strong class='text-white'>cid</strong> (ID client) e un <strong class='text-white'>secret</strong>, che identificano la Sua applicazione al momento dell’accesso. Le servirà ogni volta che collega uno script personalizzato, un servizio bridge o un bot di trading direttamente al Suo conto Tradovate." },
    { type: "heading",text: "Ottenere l’accesso all’API di Tradovate: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Verifichi di avere un conto live finanziato", html: "L’accesso all’API esiste solo su un <strong class='text-white'>conto Tradovate live e finanziato</strong> che rispetti il saldo minimo attuale di Tradovate. I conti demo e i conti non finanziati semplicemente non possono generare chiavi, e non esiste alcuna scorciatoia. Il minimo può cambiare nel tempo, quindi controlli la cifra attuale di Tradovate prima di iniziare anziché fidarsi di un dato vecchio." },
        { title: "Apra le Application Settings", html: "Acceda alla piattaforma web di Tradovate e apra le <strong class='text-white'>Application Settings</strong>, l’area delle impostazioni/ingranaggio, di solito in alto a destra nella schermata di trading. Qui si trovano tutte le opzioni a livello di conto, compresi i componenti aggiuntivi." },
        { title: "Attivi il componente aggiuntivo API Access", html: "Nelle Application Settings, vada alla sezione <strong class='text-white'>Add-Ons</strong>, trovi <strong class='text-white'>API Access</strong> e faccia clic su <strong class='text-white'>Activate</strong>. Si tratta di un abbonamento mensile a pagamento e il prezzo cambia, quindi controlli la tariffa attuale prima di impegnarsi. Una volta attivo, nelle Sue impostazioni compare una nuova opzione API Access." },
        { title: "Generi la Sua chiave API", html: "Apra la scheda <strong class='text-white'>API Access</strong> e faccia clic su <strong class='text-white'>Generate API Key</strong>. Assegni alla chiave un nome chiaro, per esempio «PMT-Bot», per riconoscerla in seguito, poi completi le autodichiarazioni che confermano che comprende il trading automatizzato di futures, firmi l’accordo digitale e scelga i permessi che la chiave deve avere. Se la Sua app deve inserire ordini, le conceda l’accesso completo. Quindi faccia clic su <strong class='text-white'>Generate</strong>." },
        { title: "Copi e conservi il Suo cid e il Suo secret", html: "Tradovate mostra le Sue nuove credenziali, il <strong class='text-white'>cid</strong> e il <strong class='text-white'>secret</strong>, <strong class='text-white'>una sola volta</strong>. Le copi entrambe subito e le conservi in un luogo sicuro, come un gestore di password, non in un repository pubblico. Se perde il secret, non c’è modo di recuperarlo; dovrà generare una nuova chiave e aggiornare la Sua app. Non condivida questi valori e non li inserisca in una codebase condivisa." },
