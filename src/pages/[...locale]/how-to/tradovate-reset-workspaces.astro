---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-reset-workspaces";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Reset Tradovate Workspaces to Default Layout";
const META_DESCRIPTION =
  "Reset your trading workspaces back to the clean default layout in a few clicks, and back up your current setup first so you never lose it.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate-Workspaces auf das Standard-Layout zurücksetzen", es: "Restablecer los workspaces de Tradovate al diseño predeterminado", fr: "Réinitialiser les workspaces Tradovate à la disposition par défaut", it: "Reimpostare i workspace di Tradovate al layout predefinito" },
  dek: { en: "Layout gone messy mid-session? Here's how to reset your Tradovate workspace to the clean default, and back up your current setup first so you never lose it.", de: "Layout mitten in der Session durcheinander? So setzen Sie Ihren Tradovate-Workspace auf den sauberen Standard zurück und sichern vorher Ihr aktuelles Setup, damit nichts verloren geht.", es: "¿El diseño se ha desordenado en plena sesión? Así restablece su workspace de Tradovate al diseño limpio predeterminado y guarda antes su configuración actual para no perderla nunca.", fr: "Votre disposition est devenue brouillonne en pleine session ? Voici comment réinitialiser votre workspace Tradovate à la disposition par défaut, tout en sauvegardant d'abord votre configuration actuelle pour ne jamais la perdre.", it: "Il layout è diventato disordinato a metà sessione? Ecco come reimpostare il workspace di Tradovate al layout predefinito pulito, salvando prima la configurazione attuale per non perderla mai." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "A trading layout gets messy fast. You drag a chart somewhere odd, an indicator stops loading where it should, a DOM ends up half off-screen, and suddenly the whole platform fights you in the middle of a live session. Resetting your workspace clears all of that and drops you back on the clean default layout that ships with the platform." },
    { type: "paragraph", html: "The reset itself takes about thirty seconds. The one thing you have to get right is backing up your current setup first, so a reset you don't love doesn't cost you a layout you spent hours building. Here's the whole process." },
    { type: "heading", text: "When You'd Want to Reset" },
    {
      type: "list",
      items: [
        "Charts, the DOM, or indicators won't render, or they sit in the wrong place no matter what you do.",
        "Your layout carried over clutter from an old template you no longer use.",
        "A saved workspace loads corrupted, blank, or half-empty.",
        "You just want a clean slate to rebuild from scratch.",
      ],
    },
    { type: "paragraph", html: "Resetting only touches the visual layout. It doesn't close your positions, cancel orders, or change your account or risk settings. If you're on a prop-firm evaluation account, the same workspace controls apply and nothing here affects your evaluation rules." },
    { type: "heading", text: "Reset Your Workspace to Default: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Back Up Your Current Workspace", html: "Before you reset anything, save what you've got. Click the <strong class='text-white'>+</strong> (New) sign in the upper-left corner of the platform, type a name you'll recognize later (something like \"backup-July\"), and click <strong class='text-white'>Save</strong>. Now that layout lives as its own named workspace, and you can reload it any time. Skip this step only if you genuinely don't care about your current arrangement.", image: { src: `${IMG}/tradovate-reset-workspaces-1.png`, alt: "Saving the current Tradovate layout as a named backup workspace from the plus New menu" } },
        { title: "Open the + (New) Menu", html: "Click the <strong class='text-white'>+</strong> sign in the upper-left corner again. This is the same menu where you create, save, load, import, and manage every workspace. From here you can see your saved workspaces and reach the default layout the platform ships with.", image: { src: `${IMG}/tradovate-reset-workspaces-2.png`, alt: "The Tradovate plus New workspace menu open in the top-left corner of the platform" } },
        { title: "Click Reset Default Workspace", html: "In that menu, choose <strong class='text-white'>Reset Default Workspace</strong>. This reverts the default layout to its original settings and discards any changes you'd made to it. The screen rebuilds itself to the stock arrangement of charts and modules. This is why Step 1 matters: the reset is what restores your own workspaces, not the reset.", image: { src: `${IMG}/tradovate-reset-workspaces-3.png`, alt: "Clicking Reset Default Workspace in the Tradovate workspace menu" } },
        { title: "Check the Layout, or Reload Your Own", html: "You should now be looking at the clean default arrangement. If that's all you wanted, you're done. If you only reset to fix a glitch and want your own setup back, open the <strong class='text-white'>+</strong> menu, find the backup you saved in Step 1, and click <strong class='text-white'>Load</strong>. Your layout comes back exactly as it was.", image: { src: `${IMG}/tradovate-reset-workspaces-4.png`, alt: "Tradovate showing the restored default layout with the option to reload a saved workspace" } },
      ],
    },
    { type: "heading", text: "What the Reset Changes, and What It Leaves Alone" },
    {
      type: "table",
      headers: ["Reset changes this", "Reset leaves this alone"],
      rows: [
        ["Position and size of charts, DOMs, and modules", "Open positions and working orders"],
        ["Indicators and drawings tied to the default layout", "Account balance, funds, and statements"],
        ["Any tweaks you made to the built-in default workspace", "Risk settings, loss limits, and max position size"],
        ["Timeframes and chart styles on default charts", "Your other named workspaces (unless you delete them)"],
      ],
    },
    { type: "paragraph", html: "Think of a workspace as a saved picture of your screen, nothing more. Your named workspaces stay put until you remove them yourself. To delete one, hover over its name in the <strong class='text-white'>+</strong> menu and click the trash-can icon, but know that a delete is permanent and can't be undone." },
    { type: "heading", text: "If the Reset Doesn't Stick" },
    { type: "paragraph", html: "A couple of things trip people up after a reset:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Save after every change.</strong> A layout you build but never save can revert on its own the next time you log in. Once your default looks right, click + and save it as a named workspace.",
        "<strong class='text-white'>Moving between machines?</strong> Use Import From File in the + menu to load a workspace <code>.json</code> you exported elsewhere, instead of rebuilding by hand.",
        "<strong class='text-white'>One chart or indicator still misbehaving?</strong> That can be a separate sync quirk rather than a bad layout. Reload the chart or scroll its history to force the data to redraw before you blame the workspace.",
      ],
    },
    { type: "paragraph", html: "Once your layout is stable, it's worth learning the tools that live on top of it. Set up your Tradovate hotkeys so you're not hunting for buttons, get comfortable with Tradovate charting basics, and add the chart indicators you actually trade with, then save the whole thing as a fresh workspace." },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Want your entries and exits to fire automatically once your layout is dialed in? <strong class='text-white'>See how PickMyTrade automates your Tradovate orders straight from TradingView.</strong>" },
  ], de: [
    { type: "paragraph",html: "Ein Trading-Layout gerät schnell durcheinander. Sie ziehen einen Chart an eine seltsame Stelle, ein Indikator wird nicht mehr dort geladen, wo er sollte, ein DOM landet halb außerhalb des Bildschirms, und plötzlich kämpft die ganze Plattform mitten in einer Live-Session gegen Sie. Ein Zurücksetzen des Workspaces beseitigt all das und bringt Sie zurück zum sauberen Standard-Layout, das mit der Plattform ausgeliefert wird." },
    { type: "paragraph",html: "Das Zurücksetzen selbst dauert etwa dreißig Sekunden. Entscheidend ist nur, dass Sie vorher Ihr aktuelles Setup sichern, damit ein Reset, der Ihnen nicht gefällt, Sie nicht ein Layout kostet, an dem Sie stundenlang gearbeitet haben. Hier der gesamte Ablauf." },
    { type: "heading",text: "Wann ein Zurücksetzen sinnvoll ist" },
    {
      type: "list",
      items: [
        "Charts, das DOM oder Indikatoren werden nicht dargestellt oder sitzen trotz aller Versuche an der falschen Stelle.",
        "Ihr Layout enthält Altlasten einer alten Vorlage, die Sie nicht mehr verwenden.",
        "Ein gespeicherter Workspace lädt fehlerhaft, leer oder nur halb gefüllt.",
        "Sie möchten einfach bei null anfangen und von Grund auf neu aufbauen.",
      ],
    },
    { type: "paragraph",html: "Das Zurücksetzen betrifft nur das visuelle Layout. Es schließt keine Positionen, storniert keine Orders und ändert weder Ihr Konto noch Ihre Risikoeinstellungen. Wenn Sie ein Prop-Firm-Evaluierungskonto nutzen, gelten dieselben Workspace-Steuerungen, und nichts davon beeinflusst die Regeln Ihrer Evaluierung." },
    { type: "heading",text: "Workspace auf Standard zurücksetzen: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Aktuellen Workspace sichern", html: "Bevor Sie etwas zurücksetzen, speichern Sie Ihren aktuellen Stand. Klicken Sie auf das <strong class='text-white'>+</strong> (Neu) in der oberen linken Ecke der Plattform, geben Sie einen Namen ein, den Sie später wiedererkennen (zum Beispiel „Backup-Juli“), und klicken Sie auf <strong class='text-white'>Save</strong>. Dieses Layout liegt nun als eigener benannter Workspace vor und lässt sich jederzeit wieder laden. Überspringen Sie diesen Schritt nur, wenn Ihnen Ihre aktuelle Anordnung wirklich egal ist.", image: {"src":`${IMG}/tradovate-reset-workspaces-1.png`,"alt":"Aktuelles Tradovate-Layout als benannter Backup-Workspace über das Plus-Menü „New“ gespeichert"} },
        { title: "Das +-Menü (New) öffnen", html: "Klicken Sie erneut auf das <strong class='text-white'>+</strong> in der oberen linken Ecke. In diesem Menü erstellen, speichern, laden, importieren und verwalten Sie jeden Workspace. Hier sehen Sie Ihre gespeicherten Workspaces und erreichen das Standard-Layout, das mit der Plattform ausgeliefert wird.", image: {"src":`${IMG}/tradovate-reset-workspaces-2.png`,"alt":"Das Tradovate-Workspace-Menü mit dem Plus „New“ in der oberen linken Ecke der Plattform geöffnet"} },
        { title: "Auf „Reset Default Workspace“ klicken", html: "Wählen Sie in diesem Menü <strong class='text-white'>Reset Default Workspace</strong>. Dadurch wird das Standard-Layout auf seine ursprünglichen Einstellungen zurückgesetzt und alle Änderungen daran werden verworfen. Der Bildschirm baut sich auf die Standardanordnung aus Charts und Modulen neu auf. Genau deshalb ist Schritt 1 wichtig: Ihre eigenen Workspaces stellen Sie über die Sicherung wieder her, nicht über das Zurücksetzen.", image: {"src":`${IMG}/tradovate-reset-workspaces-3.png`,"alt":"Klick auf Reset Default Workspace im Tradovate-Workspace-Menü"} },
        { title: "Layout prüfen oder das eigene wieder laden", html: "Sie sehen jetzt die saubere Standardanordnung. Wenn Sie nur das wollten, sind Sie fertig. Falls Sie nur einen Fehler beheben wollten und Ihr eigenes Setup zurückhaben möchten, öffnen Sie das <strong class='text-white'>+</strong>-Menü, suchen Sie die in Schritt 1 gespeicherte Sicherung und klicken Sie auf <strong class='text-white'>Load</strong>. Ihr Layout kehrt genau so zurück, wie es war.", image: {"src":`${IMG}/tradovate-reset-workspaces-4.png`,"alt":"Tradovate zeigt das wiederhergestellte Standard-Layout mit der Option, einen gespeicherten Workspace erneut zu laden"} },
      ],
    },
    { type: "heading",text: "Was das Zurücksetzen ändert und was unberührt bleibt" },
    { type: "table", headers: ["Das Zurücksetzen ändert","Das Zurücksetzen lässt unberührt"], rows: [
      ["Position und Größe von Charts, DOMs und Modulen","Offene Positionen und aktive Orders"],
      ["Indikatoren und Zeichnungen, die zum Standard-Layout gehören","Kontostand, Guthaben und Kontoauszüge"],
      ["Alle Änderungen, die Sie am integrierten Standard-Workspace vorgenommen haben","Risikoeinstellungen, Verlustlimits und maximale Positionsgröße"],
      ["Zeitrahmen und Chartstile in den Standard-Charts","Ihre anderen benannten Workspaces (sofern Sie sie nicht löschen)"],
    ] },
    { type: "paragraph",html: "Stellen Sie sich einen Workspace als gespeichertes Bild Ihres Bildschirms vor, nicht mehr. Ihre benannten Workspaces bleiben bestehen, bis Sie sie selbst entfernen. Um einen zu löschen, fahren Sie im <strong class='text-white'>+</strong>-Menü mit der Maus über seinen Namen und klicken Sie auf das Papierkorb-Symbol. Beachten Sie jedoch, dass das Löschen endgültig ist und nicht rückgängig gemacht werden kann." },
    { type: "heading",text: "Wenn das Zurücksetzen nicht greift" },
    { type: "paragraph",html: "Nach einem Reset stolpern manche über ein paar Dinge:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Nach jeder Änderung speichern.</strong> Ein Layout, das Sie aufbauen, aber nie speichern, kann sich beim nächsten Login von selbst zurücksetzen. Sobald Ihr Standard passt, klicken Sie auf + und speichern Sie ihn als benannten Workspace.",
        "<strong class='text-white'>Wechsel zwischen Rechnern?</strong> Nutzen Sie Import From File im +-Menü, um eine anderswo exportierte Workspace-<code>.json</code> zu laden, statt alles von Hand neu aufzubauen.",
        "<strong class='text-white'>Ein Chart oder Indikator macht weiterhin Probleme?</strong> Das kann eine separate Synchronisierungsmacke sein und kein fehlerhaftes Layout. Laden Sie den Chart neu oder scrollen Sie durch seine Historie, damit die Daten neu gezeichnet werden, bevor Sie dem Workspace die Schuld geben.",
      ],
    },
    { type: "paragraph",html: "Sobald Ihr Layout stabil ist, lohnt es sich, die Werkzeuge kennenzulernen, die darauf aufbauen. Richten Sie Ihre Tradovate-Hotkeys ein, damit Sie nicht nach Schaltflächen suchen müssen, machen Sie sich mit den Grundlagen der Tradovate-Charts vertraut und fügen Sie die Chart-Indikatoren hinzu, mit denen Sie tatsächlich handeln. Speichern Sie dann das Ganze als neuen Workspace." },
    { type: "heading",text: "Automatisieren Sie das mit PickMyTrade" },
    { type: "paragraph",html: "Sollen Ihre Einstiege und Ausstiege automatisch ausgelöst werden, sobald Ihr Layout steht? <strong class='text-white'>Sehen Sie, wie PickMyTrade Ihre Tradovate-Orders direkt aus TradingView automatisiert.</strong>" },
  ], es: [
    { type: "paragraph",html: "Un diseño de trading se desordena rápido. Arrastra un gráfico a un lugar extraño, un indicador deja de cargarse donde debería, un DOM acaba medio fuera de la pantalla y, de repente, toda la plataforma le complica la vida en plena sesión en vivo. Restablecer su workspace elimina todo eso y le devuelve al diseño predeterminado limpio que trae la plataforma." },
    { type: "paragraph",html: "El restablecimiento en sí lleva unos treinta segundos. Lo único que debe hacer bien es respaldar primero su configuración actual, para que un restablecimiento que no le guste no le cueste un diseño en el que invirtió horas. Este es todo el proceso." },
    { type: "heading",text: "Cuándo conviene restablecer" },
    {
      type: "list",
      items: [
        "Los gráficos, el DOM o los indicadores no se muestran, o quedan en el lugar equivocado hagan lo que hagan.",
        "Su diseño arrastra desorden de una plantilla antigua que ya no utiliza.",
        "Un workspace guardado se carga dañado, en blanco o a medias.",
        "Simplemente quiere una pizarra limpia para reconstruir desde cero.",
      ],
    },
    { type: "paragraph",html: "Restablecer solo afecta al diseño visual. No cierra sus posiciones, no cancela órdenes ni cambia su cuenta o su configuración de riesgo. Si utiliza una cuenta de evaluación de una prop firm, se aplican los mismos controles de workspace y nada de esto afecta a las reglas de su evaluación." },
    { type: "heading",text: "Restablecer su workspace al diseño predeterminado: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Respalde su workspace actual", html: "Antes de restablecer nada, guarde lo que tiene. Haga clic en el signo <strong class='text-white'>+</strong> (New) en la esquina superior izquierda de la plataforma, escriba un nombre que reconozca más adelante (por ejemplo, «respaldo-julio») y haga clic en <strong class='text-white'>Save</strong>. Ese diseño queda ahora como un workspace con nombre propio y puede volver a cargarlo cuando quiera. Omita este paso solo si de verdad no le importa su disposición actual.", image: {"src":`${IMG}/tradovate-reset-workspaces-1.png`,"alt":"Guardar el diseño actual de Tradovate como workspace de respaldo con nombre desde el menú más New"} },
        { title: "Abra el menú + (New)", html: "Haga clic de nuevo en el signo <strong class='text-white'>+</strong> de la esquina superior izquierda. Es el mismo menú donde crea, guarda, carga, importa y administra cada workspace. Desde aquí puede ver sus workspaces guardados y acceder al diseño predeterminado que trae la plataforma.", image: {"src":`${IMG}/tradovate-reset-workspaces-2.png`,"alt":"El menú de workspaces más New de Tradovate abierto en la esquina superior izquierda de la plataforma"} },
        { title: "Haga clic en Reset Default Workspace", html: "En ese menú, elija <strong class='text-white'>Reset Default Workspace</strong>. Esto devuelve el diseño predeterminado a su configuración original y descarta los cambios que le hubiera hecho. La pantalla se reconstruye con la disposición estándar de gráficos y módulos. Por eso el paso 1 es importante: sus propios workspaces se restauran con el respaldo, no con el restablecimiento.", image: {"src":`${IMG}/tradovate-reset-workspaces-3.png`,"alt":"Clic en Reset Default Workspace en el menú de workspaces de Tradovate"} },
        { title: "Compruebe el diseño o cargue el suyo", html: "Ahora debería ver la disposición predeterminada limpia. Si eso era todo lo que quería, ha terminado. Si solo restableció para corregir un fallo y quiere recuperar su configuración, abra el menú <strong class='text-white'>+</strong>, busque el respaldo que guardó en el paso 1 y haga clic en <strong class='text-white'>Load</strong>. Su diseño vuelve exactamente como estaba.", image: {"src":`${IMG}/tradovate-reset-workspaces-4.png`,"alt":"Tradovate mostrando el diseño predeterminado restaurado con la opción de volver a cargar un workspace guardado"} },
      ],
    },
    { type: "heading",text: "Qué cambia el restablecimiento y qué deja intacto" },
    { type: "table", headers: ["El restablecimiento cambia esto","El restablecimiento no toca esto"], rows: [
      ["Posición y tamaño de gráficos, DOMs y módulos","Posiciones abiertas y órdenes activas"],
      ["Indicadores y dibujos vinculados al diseño predeterminado","Saldo de la cuenta, fondos y estados de cuenta"],
      ["Cualquier ajuste que haya hecho al workspace predeterminado integrado","Configuración de riesgo, límites de pérdida y tamaño máximo de posición"],
      ["Marcos temporales y estilos de gráfico de los gráficos predeterminados","Sus otros workspaces con nombre (a menos que los elimine)"],
    ] },
    { type: "paragraph",html: "Piense en un workspace como una foto guardada de su pantalla, nada más. Sus workspaces con nombre permanecen donde están hasta que usted los elimine. Para borrar uno, pase el cursor sobre su nombre en el menú <strong class='text-white'>+</strong> y haga clic en el icono de la papelera, pero tenga en cuenta que la eliminación es permanente y no se puede deshacer." },
    { type: "heading",text: "Si el restablecimiento no se mantiene" },
    { type: "paragraph",html: "Un par de cosas suelen confundir después de un restablecimiento:" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Guarde después de cada cambio.</strong> Un diseño que construye pero nunca guarda puede revertirse por sí solo la próxima vez que inicie sesión. Cuando su diseño predeterminado quede bien, haga clic en + y guárdelo como workspace con nombre.",
        "<strong class='text-white'>¿Cambia de equipo?</strong> Use Import From File en el menú + para cargar un <code>.json</code> de workspace que exportó en otro lugar, en lugar de reconstruirlo a mano.",
        "<strong class='text-white'>¿Algún gráfico o indicador sigue fallando?</strong> Puede ser un problema de sincronización aparte y no un diseño defectuoso. Recargue el gráfico o desplace su historial para forzar que los datos se redibujen antes de culpar al workspace.",
      ],
    },
    { type: "paragraph",html: "Una vez que su diseño sea estable, conviene conocer las herramientas que se apoyan en él. Configure sus atajos de teclado de Tradovate para no tener que buscar botones, familiarícese con los fundamentos de los gráficos de Tradovate y añada los indicadores de gráfico que realmente utiliza; después guarde todo como un workspace nuevo." },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "¿Quiere que sus entradas y salidas se ejecuten automáticamente una vez que su diseño esté listo? <strong class='text-white'>Descubra cómo PickMyTrade automatiza sus órdenes de Tradovate directamente desde TradingView.</strong>" },
  ], fr: [
    { type: "paragraph",html: "Une disposition de trading devient vite désordonnée. Vous faites glisser un graphique à un endroit bizarre, un indicateur ne se charge plus où il le devrait, un DOM se retrouve à moitié hors de l'écran, et soudain toute la plateforme vous met des bâtons dans les roues en pleine session live. Réinitialiser votre workspace efface tout cela et vous ramène à la disposition par défaut propre livrée avec la plateforme." },
    { type: "paragraph",html: "La réinitialisation elle-même prend une trentaine de secondes. Le seul point à ne pas rater est la sauvegarde préalable de votre configuration actuelle, afin qu'une réinitialisation qui ne vous convient pas ne vous coûte pas une disposition construite en plusieurs heures. Voici tout le processus." },
    { type: "heading",text: "Quand réinitialiser" },
    {
      type: "list",
      items: [
        "Les graphiques, le DOM ou les indicateurs ne s'affichent pas, ou restent au mauvais endroit quoi que vous fassiez.",
        "Votre disposition traîne le désordre d'un ancien modèle que vous n'utilisez plus.",
        "Un workspace enregistré se charge corrompu, vide ou à moitié rempli.",
        "Vous voulez simplement repartir de zéro pour tout reconstruire.",
      ],
    },
    { type: "paragraph",html: "La réinitialisation ne touche que la disposition visuelle. Elle ne ferme pas vos positions, n'annule pas vos ordres et ne modifie ni votre compte ni vos paramètres de risque. Si vous utilisez un compte d'évaluation de prop firm, les mêmes contrôles de workspace s'appliquent et rien ici n'affecte les règles de votre évaluation." },
    { type: "heading",text: "Réinitialiser votre workspace par défaut : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Sauvegardez votre workspace actuel", html: "Avant de réinitialiser quoi que ce soit, enregistrez ce que vous avez. Cliquez sur le signe <strong class='text-white'>+</strong> (New) dans le coin supérieur gauche de la plateforme, saisissez un nom que vous reconnaîtrez plus tard (par exemple « sauvegarde-juillet ») et cliquez sur <strong class='text-white'>Save</strong>. Cette disposition existe désormais comme workspace nommé à part entière et vous pouvez la recharger à tout moment. Ne sautez cette étape que si votre disposition actuelle vous importe vraiment peu.", image: {"src":`${IMG}/tradovate-reset-workspaces-1.png`,"alt":"Enregistrement de la disposition Tradovate actuelle comme workspace de sauvegarde nommé depuis le menu plus New"} },
        { title: "Ouvrez le menu + (New)", html: "Cliquez de nouveau sur le signe <strong class='text-white'>+</strong> dans le coin supérieur gauche. C'est le même menu où vous créez, enregistrez, chargez, importez et gérez chaque workspace. Vous y voyez vos workspaces enregistrés et accédez à la disposition par défaut livrée avec la plateforme.", image: {"src":`${IMG}/tradovate-reset-workspaces-2.png`,"alt":"Le menu de workspaces plus New de Tradovate ouvert dans le coin supérieur gauche de la plateforme"} },
        { title: "Cliquez sur Reset Default Workspace", html: "Dans ce menu, choisissez <strong class='text-white'>Reset Default Workspace</strong>. Cela ramène la disposition par défaut à ses réglages d'origine et supprime les modifications que vous y aviez apportées. L'écran se reconstruit selon l'agencement standard de graphiques et de modules. C'est pourquoi l'étape 1 compte : ce sont vos sauvegardes qui restaurent vos propres workspaces, pas la réinitialisation.", image: {"src":`${IMG}/tradovate-reset-workspaces-3.png`,"alt":"Clic sur Reset Default Workspace dans le menu des workspaces Tradovate"} },
        { title: "Vérifiez la disposition ou rechargez la vôtre", html: "Vous devriez maintenant voir la disposition par défaut propre. Si c'est tout ce que vous vouliez, c'est terminé. Si vous n'avez réinitialisé que pour corriger un problème et souhaitez retrouver votre configuration, ouvrez le menu <strong class='text-white'>+</strong>, repérez la sauvegarde enregistrée à l'étape 1 et cliquez sur <strong class='text-white'>Load</strong>. Votre disposition revient exactement comme elle était.", image: {"src":`${IMG}/tradovate-reset-workspaces-4.png`,"alt":"Tradovate affichant la disposition par défaut restaurée avec l'option de recharger un workspace enregistré"} },
