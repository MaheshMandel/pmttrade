---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-ninjatrader-multi";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Enable Multiple Tradovate Connections in NinjaTrader";
const META_DESCRIPTION =
  "Turn on Multi-provider in NinjaTrader to connect multiple Tradovate and prop firm accounts at once. Step-by-step setup to run several accounts live.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Mehrere Tradovate-Verbindungen in NinjaTrader aktivieren", es: "Habilitar varias conexiones de Tradovate en NinjaTrader", fr: "Activer plusieurs connexions Tradovate dans NinjaTrader", it: "Abilitare più connessioni Tradovate in NinjaTrader" },
  dek: { en: "Turn on Multi-provider in NinjaTrader to connect multiple Tradovate and prop firm accounts at once. Step-by-step setup to run several accounts live.", de: "Aktivieren Sie Multi-provider in NinjaTrader, um mehrere Tradovate- und Prop-Firm-Konten gleichzeitig zu verbinden. Schritt-für-Schritt-Einrichtung für mehrere Live-Konten.", es: "Active Multi-provider en NinjaTrader para conectar varias cuentas de Tradovate y de prop firms a la vez. Configuración paso a paso para operar varias cuentas en vivo.", fr: "Activez Multi-provider dans NinjaTrader pour connecter plusieurs comptes Tradovate et de prop firms en même temps. Configuration pas à pas pour faire tourner plusieurs comptes en direct.", it: "Attivi Multi-provider in NinjaTrader per collegare più conti Tradovate e prop firm contemporaneamente. Configurazione passo dopo passo per gestire più conti live." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "NinjaTrader connects to one account at a time out of the box. If you're running two prop firm evaluations, a funded account next to a personal sim, or a handful of separate Tradovate logins, that single-connection limit gets in the way fast. The fix is a setting called <strong class='text-white'>Multi-provider</strong>. Turn it on, restart, and NinjaTrader will hold several Tradovate connections open at once so you can watch and trade all of them from one Control Center." },
    { type: "heading", text: "Before You Start" },
    {
      type: "list",
      items: [
        "A current build of NinjaTrader Desktop. Older 8.0 builds can't connect to Tradovate at all, so update first if your version is dated.",
        "The username and password for each Tradovate or prop firm account you want to add.",
        "A note of whether each account is a simulation/evaluation account or a live-funded one. You'll match that in setup.",
      ],
    },
    { type: "heading", text: "Enable Multiple Tradovate Connections: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Turn On Multi-Provider", html: "Open the Control Center, click <strong class='text-white'>Tools</strong>, then <strong class='text-white'>Settings</strong>. Newer NinjaTrader builds renamed this menu from Options to Settings, so if you're on an older version look for <strong class='text-white'>Options</strong> instead. On the <strong class='text-white'>General</strong> tab, find the <strong class='text-white'>Multi-provider</strong> checkbox, tick it, and click <strong class='text-white'>OK</strong>." },
        { title: "Restart, Then Open the Connection Setup", html: "Multi-provider only takes effect after a restart, so close NinjaTrader Desktop and reopen it. Back in the Control Center, click <strong class='text-white'>Connections</strong>, then <strong class='text-white'>Configure</strong>. This window is where you add one entry per account, and it's where all your Tradovate connections will live." },
        { title: "Add Your First Tradovate Account", html: "In the configuration window, double-click <strong class='text-white'>NinjaTrader</strong> in the Available list to add it. Use the \"NinjaTrader\" (NinjaTrader Brokerage) connection type rather than the older direct \"Tradovate\" one. It routes through NinjaTrader's own gateway, which lets you keep several accounts connected without tripping Tradovate's two-session limit. Enter the Tradovate username and password for that account. Set <strong class='text-white'>Account Type</strong> to match what the account actually is: choose <strong class='text-white'>Simulation</strong> for prop firm evaluations and funded-sim accounts, or <strong class='text-white'>Live</strong> for a personal live-funded Tradovate account. Give the connection a clear name so you can tell your accounts apart later, then click <strong class='text-white'>OK</strong>." },
        { title: "Repeat and Connect Everything", html: "Do the same for each additional account, whether they share a login or not. Every account gets its own connection entry. When you're finished adding them, open the <strong class='text-white'>Connections</strong> menu and connect them one at a time. With Multi-provider on, they'll stay green together instead of knocking each other offline the way a single-connection setup does." },
      ],
    },
    { type: "quote", html: "<strong>Match Account Type to reality.</strong> Prop evaluations and funded-sim accounts run inside Tradovate's simulation environment, so they connect as <strong>Simulation</strong> even when real payout money rides on them. If one account shows delayed quotes or rejects orders while the others are fine, that's almost always a per-account data subscription or agreement issue, not the Multi-provider setting." },
    { type: "heading", text: "How Many Accounts Can You Connect?" },
    { type: "paragraph", html: "There's no hard cap baked into the NinjaTrader Brokerage connection type for Tradovate. The real ceilings are your machine's memory and CPU, plus whatever your prop firm allows. Add accounts gradually and keep an eye on performance rather than loading a dozen at once and hoping." },
    { type: "paragraph", html: "One thing to sort out before you mirror trades: prop firms set their own rules on how many accounts you can trade at the same time and whether copy trading across them is even permitted. Those limits vary by firm and account size, so check your firm's current rules first." },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Running the same strategy across several accounts by hand gets old quickly. <strong class='text-white'>PickMyTrade takes one TradingView alert and fires it into every connected Tradovate or prop account at once</strong>, so your setups stay in sync without you clicking through each connection." },
  ], de: [
    { type: "paragraph",html: "NinjaTrader verbindet sich standardmäßig nur mit einem Konto gleichzeitig. Wenn Sie zwei Prop-Firm-Evaluierungen, ein finanziertes Konto neben einer privaten Simulation oder mehrere getrennte Tradovate-Logins betreiben, wird diese Einzelverbindungs-Grenze schnell hinderlich. Die Lösung ist eine Einstellung namens <strong class='text-white'>Multi-provider</strong>. Aktivieren Sie sie, starten Sie neu, und NinjaTrader hält mehrere Tradovate-Verbindungen gleichzeitig offen, sodass Sie alle aus einem Control Center beobachten und handeln können." },
    { type: "heading",text: "Bevor Sie beginnen" },
    {
      type: "list",
      items: [
        "Ein aktueller Build von NinjaTrader Desktop. Ältere 8.0-Builds können sich überhaupt nicht mit Tradovate verbinden; aktualisieren Sie daher zuerst, falls Ihre Version veraltet ist.",
        "Benutzername und Passwort für jedes Tradovate- oder Prop-Firm-Konto, das Sie hinzufügen möchten.",
        "Ein Vermerk, ob es sich bei jedem Konto um ein Simulations-/Evaluierungskonto oder ein live finanziertes Konto handelt. Das gleichen Sie bei der Einrichtung ab.",
      ],
    },
    { type: "heading",text: "Mehrere Tradovate-Verbindungen aktivieren: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Multi-Provider einschalten", html: "Öffnen Sie das Control Center, klicken Sie auf <strong class='text-white'>Tools</strong> und dann auf <strong class='text-white'>Settings</strong>. Neuere NinjaTrader-Builds haben dieses Menü von Options in Settings umbenannt; bei einer älteren Version suchen Sie stattdessen nach <strong class='text-white'>Options</strong>. Suchen Sie auf dem Reiter <strong class='text-white'>General</strong> das Kontrollkästchen <strong class='text-white'>Multi-provider</strong>, aktivieren Sie es und klicken Sie auf <strong class='text-white'>OK</strong>." },
        { title: "Neu starten, dann die Verbindungseinrichtung öffnen", html: "Multi-provider wird erst nach einem Neustart wirksam; schließen Sie also NinjaTrader Desktop und öffnen Sie es erneut. Klicken Sie zurück im Control Center auf <strong class='text-white'>Connections</strong> und dann auf <strong class='text-white'>Configure</strong>. In diesem Fenster fügen Sie pro Konto einen Eintrag hinzu, und hier befinden sich alle Ihre Tradovate-Verbindungen." },
        { title: "Ihr erstes Tradovate-Konto hinzufügen", html: "Doppelklicken Sie im Konfigurationsfenster in der Liste Available auf <strong class='text-white'>NinjaTrader</strong>, um die Verbindung hinzuzufügen. Verwenden Sie den Verbindungstyp „NinjaTrader“ (NinjaTrader Brokerage) statt des älteren direkten Typs „Tradovate“. Er läuft über das eigene Gateway von NinjaTrader, wodurch Sie mehrere Konten verbunden halten können, ohne das Zwei-Sitzungen-Limit von Tradovate auszulösen. Geben Sie den Tradovate-Benutzernamen und das Passwort für dieses Konto ein. Stellen Sie <strong class='text-white'>Account Type</strong> passend zum tatsächlichen Kontotyp ein: Wählen Sie <strong class='text-white'>Simulation</strong> für Prop-Firm-Evaluierungen und finanzierte Sim-Konten oder <strong class='text-white'>Live</strong> für ein persönliches, live finanziertes Tradovate-Konto. Geben Sie der Verbindung einen eindeutigen Namen, damit Sie Ihre Konten später unterscheiden können, und klicken Sie auf <strong class='text-white'>OK</strong>." },
        { title: "Wiederholen und alles verbinden", html: "Gehen Sie für jedes weitere Konto genauso vor, egal ob sie sich einen Login teilen oder nicht. Jedes Konto erhält einen eigenen Verbindungseintrag. Wenn Sie alle hinzugefügt haben, öffnen Sie das Menü <strong class='text-white'>Connections</strong> und verbinden Sie sie nacheinander. Mit aktiviertem Multi-provider bleiben sie gemeinsam grün, statt sich gegenseitig offline zu werfen, wie es bei einer Einzelverbindung der Fall ist." },
      ],
    },
    { type: "quote",html: "<strong>Kontotyp an die Realität anpassen.</strong> Prop-Evaluierungen und finanzierte Sim-Konten laufen in der Simulationsumgebung von Tradovate und verbinden sich daher als <strong>Simulation</strong>, selbst wenn echtes Auszahlungsgeld daran hängt. Wenn ein Konto verzögerte Kurse zeigt oder Orders ablehnt, während die anderen einwandfrei laufen, liegt das fast immer an einem Datenabonnement oder einer Vereinbarung pro Konto, nicht an der Multi-provider-Einstellung." },
    { type: "heading",text: "Wie viele Konten können Sie verbinden?" },
    { type: "paragraph",html: "Für den Verbindungstyp NinjaTrader Brokerage bei Tradovate gibt es keine feste Obergrenze. Die tatsächlichen Grenzen sind der Arbeitsspeicher und die CPU Ihres Rechners sowie das, was Ihre Prop-Firm erlaubt. Fügen Sie Konten nach und nach hinzu und beobachten Sie die Leistung, statt ein Dutzend auf einmal zu laden und auf das Beste zu hoffen." },
    { type: "paragraph",html: "Eines sollten Sie klären, bevor Sie Trades spiegeln: Prop-Firms legen eigene Regeln fest, wie viele Konten Sie gleichzeitig handeln dürfen und ob Copy-Trading über diese Konten überhaupt erlaubt ist. Diese Grenzen unterscheiden sich je nach Firma und Kontogröße; prüfen Sie daher zuerst die aktuellen Regeln Ihrer Firma." },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "Dieselbe Strategie von Hand über mehrere Konten laufen zu lassen, wird schnell lästig. <strong class='text-white'>PickMyTrade nimmt einen TradingView-Alert und löst ihn gleichzeitig in jedem verbundenen Tradovate- oder Prop-Konto aus</strong>, sodass Ihre Setups synchron bleiben, ohne dass Sie sich durch jede Verbindung klicken müssen." },
  ], es: [
    { type: "paragraph",html: "NinjaTrader se conecta a una cuenta a la vez de forma predeterminada. Si está ejecutando dos evaluaciones de prop firms, una cuenta fondeada junto a una simulada personal o varios inicios de sesión de Tradovate independientes, ese límite de una sola conexión estorba rápido. La solución es un ajuste llamado <strong class='text-white'>Multi-provider</strong>. Actívelo, reinicie y NinjaTrader mantendrá abiertas varias conexiones de Tradovate a la vez para que pueda vigilarlas y operarlas todas desde un único Control Center." },
    { type: "heading",text: "Antes de empezar" },
    {
      type: "list",
      items: [
        "Una versión actual de NinjaTrader Desktop. Las versiones 8.0 anteriores no pueden conectarse a Tradovate en absoluto, así que actualice primero si su versión es antigua.",
        "El usuario y la contraseña de cada cuenta de Tradovate o de prop firm que quiera añadir.",
        "Una nota de si cada cuenta es de simulación/evaluación o está fondeada en vivo. Lo indicará en la configuración.",
      ],
    },
    { type: "heading",text: "Habilitar varias conexiones de Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Active Multi-Provider", html: "Abra el Control Center, haga clic en <strong class='text-white'>Tools</strong> y luego en <strong class='text-white'>Settings</strong>. Las versiones más recientes de NinjaTrader cambiaron el nombre de este menú de Options a Settings, así que, si usa una versión anterior, busque <strong class='text-white'>Options</strong>. En la pestaña <strong class='text-white'>General</strong>, busque la casilla <strong class='text-white'>Multi-provider</strong>, márquela y haga clic en <strong class='text-white'>OK</strong>." },
        { title: "Reinicie y abra la configuración de conexiones", html: "Multi-provider solo surte efecto tras reiniciar, así que cierre NinjaTrader Desktop y vuelva a abrirlo. De vuelta en el Control Center, haga clic en <strong class='text-white'>Connections</strong> y luego en <strong class='text-white'>Configure</strong>. En esta ventana añadirá una entrada por cuenta, y aquí vivirán todas sus conexiones de Tradovate." },
        { title: "Añada su primera cuenta de Tradovate", html: "En la ventana de configuración, haga doble clic en <strong class='text-white'>NinjaTrader</strong> en la lista Available para añadirla. Use el tipo de conexión «NinjaTrader» (NinjaTrader Brokerage) en lugar del antiguo «Tradovate» directo. Se enruta a través de la propia pasarela de NinjaTrader, lo que le permite mantener varias cuentas conectadas sin activar el límite de dos sesiones de Tradovate. Introduzca el usuario y la contraseña de Tradovate de esa cuenta. Ajuste <strong class='text-white'>Account Type</strong> según lo que sea realmente la cuenta: elija <strong class='text-white'>Simulation</strong> para evaluaciones de prop firms y cuentas simuladas fondeadas, o <strong class='text-white'>Live</strong> para una cuenta personal de Tradovate fondeada en vivo. Dé a la conexión un nombre claro para distinguir luego sus cuentas y haga clic en <strong class='text-white'>OK</strong>." },
        { title: "Repita y conecte todo", html: "Haga lo mismo con cada cuenta adicional, compartan o no el mismo inicio de sesión. Cada cuenta tiene su propia entrada de conexión. Cuando termine de añadirlas, abra el menú <strong class='text-white'>Connections</strong> y conéctelas una por una. Con Multi-provider activado, permanecerán en verde a la vez en lugar de desconectarse entre sí como ocurre con una configuración de conexión única." },
      ],
    },
    { type: "quote",html: "<strong>Haga coincidir Account Type con la realidad.</strong> Las evaluaciones de prop firms y las cuentas simuladas fondeadas funcionan dentro del entorno de simulación de Tradovate, por lo que se conectan como <strong>Simulation</strong> aunque haya dinero real de pagos en juego. Si una cuenta muestra cotizaciones retrasadas o rechaza órdenes mientras las demás van bien, casi siempre es un problema de suscripción de datos o de acuerdo de esa cuenta, no del ajuste Multi-provider." },
    { type: "heading",text: "¿Cuántas cuentas puede conectar?" },
    { type: "paragraph",html: "No hay un tope fijo integrado en el tipo de conexión NinjaTrader Brokerage para Tradovate. Los verdaderos límites son la memoria y la CPU de su equipo, además de lo que permita su prop firm. Añada cuentas gradualmente y vigile el rendimiento en lugar de cargar una docena de golpe y esperar lo mejor." },
    { type: "paragraph",html: "Hay algo que conviene aclarar antes de replicar operaciones: las prop firms fijan sus propias reglas sobre cuántas cuentas puede operar al mismo tiempo y si el copy trading entre ellas está siquiera permitido. Esos límites varían según la firma y el tamaño de la cuenta, así que consulte primero las reglas vigentes de su firma." },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Ejecutar la misma estrategia en varias cuentas a mano cansa enseguida. <strong class='text-white'>PickMyTrade toma una alerta de TradingView y la dispara en todas las cuentas de Tradovate o de prop firms conectadas a la vez</strong>, de modo que sus setups se mantienen sincronizados sin tener que ir clic a clic por cada conexión." },
  ], fr: [
    { type: "paragraph",html: "NinjaTrader ne se connecte par défaut qu'à un seul compte à la fois. Si vous menez deux évaluations de prop firms, un compte financé à côté d'un compte de simulation personnel, ou plusieurs connexions Tradovate distinctes, cette limite d'une seule connexion devient vite gênante. La solution est un réglage appelé <strong class='text-white'>Multi-provider</strong>. Activez-le, redémarrez, et NinjaTrader maintiendra plusieurs connexions Tradovate ouvertes en même temps afin que vous puissiez toutes les surveiller et les trader depuis un seul Control Center." },
    { type: "heading",text: "Avant de commencer" },
    {
      type: "list",
      items: [
        "Une version récente de NinjaTrader Desktop. Les anciennes versions 8.0 ne peuvent pas du tout se connecter à Tradovate ; mettez donc à jour d'abord si votre version est ancienne.",
        "Le nom d'utilisateur et le mot de passe de chaque compte Tradovate ou de prop firm que vous souhaitez ajouter.",
        "Une note indiquant si chaque compte est un compte de simulation/évaluation ou un compte financé en réel. Vous l'indiquerez lors de la configuration.",
      ],
    },
    { type: "heading",text: "Activer plusieurs connexions Tradovate : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Activez Multi-Provider", html: "Ouvrez le Control Center, cliquez sur <strong class='text-white'>Tools</strong>, puis sur <strong class='text-white'>Settings</strong>. Les versions récentes de NinjaTrader ont renommé ce menu d'Options en Settings ; si vous utilisez une version plus ancienne, cherchez plutôt <strong class='text-white'>Options</strong>. Dans l'onglet <strong class='text-white'>General</strong>, repérez la case <strong class='text-white'>Multi-provider</strong>, cochez-la et cliquez sur <strong class='text-white'>OK</strong>." },
        { title: "Redémarrez, puis ouvrez la configuration des connexions", html: "Multi-provider ne prend effet qu'après un redémarrage : fermez donc NinjaTrader Desktop et rouvrez-le. De retour dans le Control Center, cliquez sur <strong class='text-white'>Connections</strong>, puis sur <strong class='text-white'>Configure</strong>. C'est dans cette fenêtre que vous ajoutez une entrée par compte, et c'est là que résideront toutes vos connexions Tradovate." },
        { title: "Ajoutez votre premier compte Tradovate", html: "Dans la fenêtre de configuration, double-cliquez sur <strong class='text-white'>NinjaTrader</strong> dans la liste Available pour l'ajouter. Utilisez le type de connexion « NinjaTrader » (NinjaTrader Brokerage) plutôt que l'ancien type direct « Tradovate ». Il passe par la passerelle propre à NinjaTrader, ce qui vous permet de garder plusieurs comptes connectés sans déclencher la limite de deux sessions de Tradovate. Saisissez le nom d'utilisateur et le mot de passe Tradovate de ce compte. Réglez <strong class='text-white'>Account Type</strong> selon la nature réelle du compte : choisissez <strong class='text-white'>Simulation</strong> pour les évaluations de prop firms et les comptes de simulation financés, ou <strong class='text-white'>Live</strong> pour un compte Tradovate personnel financé en réel. Donnez à la connexion un nom clair pour distinguer vos comptes par la suite, puis cliquez sur <strong class='text-white'>OK</strong>." },
        { title: "Répétez et connectez tout", html: "Faites de même pour chaque compte supplémentaire, qu'ils partagent ou non le même identifiant. Chaque compte a sa propre entrée de connexion. Lorsque vous avez terminé, ouvrez le menu <strong class='text-white'>Connections</strong> et connectez-les un par un. Avec Multi-provider activé, ils restent verts ensemble au lieu de se déconnecter mutuellement comme dans une configuration à connexion unique." },
      ],
    },
    { type: "quote",html: "<strong>Faites correspondre Account Type à la réalité.</strong> Les évaluations de prop firms et les comptes de simulation financés tournent dans l'environnement de simulation de Tradovate ; ils se connectent donc en <strong>Simulation</strong>, même lorsque de l'argent réel de paiement est en jeu. Si un compte affiche des cotations différées ou rejette des ordres alors que les autres fonctionnent, c'est presque toujours un problème d'abonnement aux données ou d'accord propre à ce compte, et non le réglage Multi-provider." },
    { type: "heading",text: "Combien de comptes pouvez-vous connecter ?" },
    { type: "paragraph",html: "Le type de connexion NinjaTrader Brokerage pour Tradovate n'impose aucune limite stricte. Les vrais plafonds sont la mémoire et le processeur de votre machine, ainsi que ce que votre prop firm autorise. Ajoutez les comptes progressivement et surveillez les performances plutôt que d'en charger une douzaine d'un coup en espérant que tout se passe bien." },
    { type: "paragraph",html: "Un point à clarifier avant de répliquer des trades : les prop firms fixent leurs propres règles sur le nombre de comptes que vous pouvez trader simultanément et sur l'autorisation même du copy trading entre eux. Ces limites varient selon la société et la taille du compte ; consultez donc d'abord les règles en vigueur de votre société." },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Faire tourner la même stratégie sur plusieurs comptes à la main devient vite lassant. <strong class='text-white'>PickMyTrade prend une alerte TradingView et la déclenche sur tous vos comptes Tradovate ou prop connectés en même temps</strong>, afin que vos setups restent synchronisés sans que vous ayez à cliquer sur chaque connexion." },
  ], it: [
    { type: "paragraph",html: "NinjaTrader di default si collega a un solo conto alla volta. Se gestisce due valutazioni prop firm, un conto finanziato accanto a un conto simulato personale o più login Tradovate separati, questo limite di connessione singola diventa presto un ostacolo. La soluzione è un'impostazione chiamata <strong class='text-white'>Multi-provider</strong>. La attivi, riavvii, e NinjaTrader terrà aperte più connessioni Tradovate contemporaneamente, così potrà osservarle e operare su tutte da un unico Control Center." },
    { type: "heading",text: "Prima di iniziare" },
    {
      type: "list",
      items: [
        "Una build attuale di NinjaTrader Desktop. Le vecchie build 8.0 non possono collegarsi a Tradovate affatto, quindi aggiorni prima se la Sua versione è datata.",
        "Nome utente e password di ogni conto Tradovate o prop firm che desidera aggiungere.",
        "Un appunto che indichi se ciascun conto è di simulazione/valutazione o finanziato live. Lo farà corrispondere durante la configurazione.",
      ],
    },
    { type: "heading",text: "Abilitare più connessioni Tradovate: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Attivi Multi-Provider", html: "Apra il Control Center, clicchi su <strong class='text-white'>Tools</strong> e poi su <strong class='text-white'>Settings</strong>. Le build più recenti di NinjaTrader hanno rinominato questo menu da Options a Settings, quindi se ha una versione meno recente cerchi <strong class='text-white'>Options</strong>. Nella scheda <strong class='text-white'>General</strong>, trovi la casella <strong class='text-white'>Multi-provider</strong>, la spunti e clicchi su <strong class='text-white'>OK</strong>." },
        { title: "Riavvii, poi apra la configurazione delle connessioni", html: "Multi-provider ha effetto solo dopo un riavvio, quindi chiuda NinjaTrader Desktop e lo riapra. Tornato nel Control Center, clicchi su <strong class='text-white'>Connections</strong> e poi su <strong class='text-white'>Configure</strong>. In questa finestra aggiunge una voce per ciascun conto, ed è qui che risiederanno tutte le Sue connessioni Tradovate." },
        { title: "Aggiunga il Suo primo conto Tradovate", html: "Nella finestra di configurazione, faccia doppio clic su <strong class='text-white'>NinjaTrader</strong> nell'elenco Available per aggiungerlo. Usi il tipo di connessione «NinjaTrader» (NinjaTrader Brokerage) anziché il vecchio «Tradovate» diretto. Passa attraverso il gateway di NinjaTrader, che Le consente di mantenere più conti collegati senza far scattare il limite di due sessioni di Tradovate. Inserisca nome utente e password Tradovate di quel conto. Imposti <strong class='text-white'>Account Type</strong> in base alla natura reale del conto: scelga <strong class='text-white'>Simulation</strong> per le valutazioni prop firm e i conti simulati finanziati, oppure <strong class='text-white'>Live</strong> per un conto Tradovate personale finanziato live. Assegni alla connessione un nome chiaro per distinguere i conti in seguito, quindi clicchi su <strong class='text-white'>OK</strong>." },
        { title: "Ripeta e colleghi tutto", html: "Faccia lo stesso per ogni conto aggiuntivo, che condividano o meno lo stesso login. Ogni conto ha la propria voce di connessione. Quando ha finito di aggiungerli, apra il menu <strong class='text-white'>Connections</strong> e li colleghi uno alla volta. Con Multi-provider attivo, resteranno verdi insieme invece di scollegarsi a vicenda come accade con una configurazione a connessione singola." },
      ],
    },
    { type: "quote",html: "<strong>Faccia corrispondere Account Type alla realtà.</strong> Le valutazioni prop e i conti simulati finanziati girano nell'ambiente di simulazione di Tradovate, quindi si collegano come <strong>Simulation</strong> anche quando in gioco c'è denaro reale di payout. Se un conto mostra quotazioni ritardate o rifiuta ordini mentre gli altri vanno bene, quasi sempre si tratta di un problema di abbonamento ai dati o di accordo del singolo conto, non dell'impostazione Multi-provider." },
    { type: "heading",text: "Quanti conti può collegare?" },
    { type: "paragraph",html: "Per il tipo di connessione NinjaTrader Brokerage con Tradovate non esiste un limite massimo rigido. I veri limiti sono la memoria e la CPU del Suo computer, oltre a ciò che consente la Sua prop firm. Aggiunga i conti gradualmente e tenga d'occhio le prestazioni invece di caricarne una dozzina in una volta sperando per il meglio." },
    { type: "paragraph",html: "Una cosa da chiarire prima di replicare i trade: le prop firm stabiliscono regole proprie su quanti conti può operare contemporaneamente e se il copy trading tra di essi sia consentito. Questi limiti variano in base alla società e alle dimensioni del conto, quindi verifichi prima le regole attuali della Sua società." },
    { type: "heading",text: "Automatizzi tutto con PickMyTrade" },
    { type: "paragraph",html: "Eseguire la stessa strategia su più conti a mano stanca presto. <strong class='text-white'>PickMyTrade prende un alert di TradingView e lo lancia su ogni conto Tradovate o prop collegato contemporaneamente</strong>, così i Suoi setup restano sincronizzati senza dover cliccare su ogni connessione." },
  ] },
  ctaHeading: { en: "Automate Your Tradovate Trades", de: "Automatisieren Sie Ihre Tradovate-Trades", es: "Automatice sus operaciones en Tradovate", fr: "Automatisez vos trades Tradovate", it: "Automatizzi i Suoi trade su Tradovate" },
