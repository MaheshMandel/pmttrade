---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-event-contracts";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Trade CME Event Contracts on Tradovate";
const META_DESCRIPTION =
  "Trade yes/no CME event contracts on daily market closes via the dedicated mobile app: pick a market, choose over or under, and cap your risk upfront.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "CME-Event-Kontrakte bei Tradovate handeln", es: "Opere contratos de eventos de CME en Tradovate", fr: "Trader les contrats d'événements du CME sur Tradovate", it: "Operare con i contratti sugli eventi CME su Tradovate" },
  dek: { en: "Want to trade CME's yes/no event contracts on Tradovate? They live in a separate mobile app. Here's how to download it, fund an account, and place your first over/under trade with your risk capped upfront.", de: "Sie möchten die Ja/Nein-Event-Kontrakte der CME bei Tradovate handeln? Sie befinden sich in einer separaten Mobile-App. So laden Sie sie herunter, finanzieren ein Konto und platzieren Ihren ersten Over/Under-Trade mit von vornherein begrenztem Risiko.", es: "¿Quiere operar los contratos de eventos de sí/no de CME en Tradovate? Viven en una aplicación móvil independiente. Aquí le explicamos cómo descargarla, fondear una cuenta y realizar su primera operación de over/under con el riesgo limitado desde el principio.", fr: "Vous voulez trader les contrats d'événements oui/non du CME sur Tradovate ? Ils se trouvent dans une application mobile distincte. Voici comment la télécharger, alimenter un compte et passer votre premier trade over/under avec un risque plafonné dès le départ.", it: "Desidera operare con i contratti sugli eventi sì/no di CME su Tradovate? Si trovano in un'app mobile separata. Ecco come scaricarla, finanziare un conto ed effettuare il suo primo trade over/under con il rischio limitato fin dall'inizio." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Event contracts are the simplest thing Tradovate offers, and also the easiest to get wrong before you start. They're daily yes/no bets on where a major market closes. Pick gold, crude, the S&P 500, whatever. Decide if it finishes the day above or below a price you choose. If you're right, the contract pays out. If you're wrong, you lose what you paid and nothing more." },
    { type: "paragraph", html: "Here's the part that trips people up: you don't trade these inside the regular Tradovate Trader web or desktop app. Event contracts live in their own separate mobile app, with their own account. If you've been hunting for them on the DOM or in your futures workspace, that's why you can't find them." },
    { type: "heading", text: "What a CME Event Contract Actually Is" },
    { type: "paragraph", html: "Each contract is a single question with a yes-or-no answer: will this market close over your chosen level today? These are listed by CME Group, so you're trading a real exchange product, not a house book." },
    { type: "paragraph", html: "Pricing is what makes them click. A contract costs somewhere between $0 and $1, and that price roughly tracks the odds. Something the market sees as a coin flip sits near $0.50; a long shot sits closer to a few cents. If your prediction lands, the contract settles at $1. If it doesn't, it settles at $0. So the price you pay is your maximum loss, and the gap between that price and $1 is your maximum profit. Both numbers are shown before you commit." },
    { type: "paragraph", html: "Ten markets are available across four groups:" },
    {
      type: "table",
      headers: ["Group", "Markets"],
      rows: [
        ["Equity indices", "E-mini S&P 500, Nasdaq-100, Russell 2000, Dow"],
        ["Metals", "Gold, Silver, Copper"],
        ["Energy", "WTI Crude Oil, Natural Gas"],
        ["FX", "EUR/USD"],
      ],
    },
    { type: "heading", text: "How to Trade Event Contracts on Tradovate" },
    {
      type: "steps",
      items: [
        { title: "Download the Event Contracts App", html: "Grab the dedicated Event Contracts app from the App Store (iPhone) or Google Play (Android). It's a different download from Tradovate Trader, and it's built for phone screens. If you already use Tradovate for futures, this is still a separate install." },
        { title: "Open and Fund a Separate Account", html: "Open the app and tap the wallet icon to start the online application. You're opening a standalone event contracts account here, not reusing your futures login, so plan to complete the short application and fund it from inside the app before you can place anything live." },
        { title: "Pick a Market and a Price Level", html: "Choose one of the ten markets, then pick the day's price level you want to trade around. Think of that level as the line in the sand: everything from here is just deciding which side of it the market lands on by the close." },
        { title: "Choose Yes or No and Set Your Size", html: "Now answer the question. Over means you think it closes above your level; under means at or below it. Set how many contracts you want. Before you confirm, the app shows the price per contract (your max loss) and the payout if you're right (your max profit). Read those two numbers every time. That's the whole risk picture, laid out before you click." },
        { title: "Submit and Let It Settle", html: "Submit the order and you're in. Each market settles at its own daily close, and the app resolves the contract automatically once that close prints. There's no stop to manage and no rollover to babysit. Win or lose, it's decided at the close, and the payout hits your account." },
      ],
    },
    { type: "heading", text: "Fees, Risk, and a Few Honest Caveats" },
    { type: "paragraph", html: "Event contracts are commission-free, but that doesn't mean free. Exchange, clearing, and NFA fees apply to every trade, so a winning contract nets slightly less than the full dollar, and those fees matter more when you're trading a lot of cheap contracts. Factor them in." },
    { type: "paragraph", html: "Your risk really is capped at the price you pay, which is the honest appeal of these things. There's no margin call, no liquidation, no drawdown spiral. But capped risk isn't the same as low risk. Buy enough contracts at fifty cents that never hit, and the losses add up like anything else. Trade these with the same size discipline you'd use anywhere." },
    { type: "quote", html: "Settlement times differ by market, and exact cutoffs can shift with exchange schedules and holidays. Confirm the current close time for your market inside the app before you rely on it." },
    { type: "heading", text: "Automate Your Futures Trades with PickMyTrade" },
    { type: "paragraph", html: "Event contracts are a manual, tap-it-yourself product. For your regular Tradovate futures trading, <strong class='text-white'>you can automate entries and exits straight from TradingView alerts</strong>, no coding, no sitting at the screen." },
  ], de: [
    { type: "paragraph",html: "Event-Kontrakte sind das Einfachste, was Tradovate anbietet – und zugleich das, bei dem man vor dem Start am leichtesten etwas falsch macht. Es sind tägliche Ja/Nein-Wetten darauf, wo ein großer Markt schließt. Wählen Sie Gold, Rohöl, den S&P 500, was auch immer. Entscheiden Sie, ob er den Tag über oder unter einem von Ihnen gewählten Preis beendet. Liegen Sie richtig, wird der Kontrakt ausgezahlt. Liegen Sie falsch, verlieren Sie, was Sie bezahlt haben, und nicht mehr." },
    { type: "paragraph",html: "Und hier stolpern viele: Sie handeln diese Kontrakte nicht in der regulären Web- oder Desktop-App Tradovate Trader. Event-Kontrakte befinden sich in einer eigenen, separaten Mobile-App mit eigenem Konto. Wenn Sie sie im DOM oder in Ihrem Futures-Workspace gesucht haben, erklärt das, warum Sie sie nicht finden." },
    { type: "heading",text: "Was ein CME-Event-Kontrakt tatsächlich ist" },
    { type: "paragraph",html: "Jeder Kontrakt ist eine einzelne Frage mit Ja-oder-Nein-Antwort: Wird dieser Markt heute über Ihrem gewählten Niveau schließen? Sie werden von der CME Group gelistet, Sie handeln also ein echtes Börsenprodukt, kein Hausbuch." },
    { type: "paragraph",html: "Die Preisgestaltung macht den Reiz aus. Ein Kontrakt kostet zwischen 0 und 1 $, und dieser Preis spiegelt grob die Wahrscheinlichkeit wider. Was der Markt als Münzwurf sieht, liegt bei etwa 0,50 $, ein Außenseiter eher bei wenigen Cent. Trifft Ihre Prognose zu, wird der Kontrakt bei 1 $ abgerechnet. Wenn nicht, bei 0 $. Der Preis, den Sie zahlen, ist also Ihr maximaler Verlust, und die Differenz zwischen diesem Preis und 1 $ ist Ihr maximaler Gewinn. Beide Zahlen werden angezeigt, bevor Sie sich festlegen." },
    { type: "paragraph",html: "Zehn Märkte sind in vier Gruppen verfügbar:" },
    { type: "table", headers: ["Gruppe","Märkte"], rows: [
      ["Aktienindizes","E-mini S&P 500, Nasdaq-100, Russell 2000, Dow"],
      ["Metalle","Gold, Silber, Kupfer"],
      ["Energie","WTI-Rohöl, Erdgas"],
      ["Devisen","EUR/USD"],
    ] },
    { type: "heading",text: "So handeln Sie Event-Kontrakte bei Tradovate" },
    {
      type: "steps",
      items: [
        { title: "Die Event-Contracts-App herunterladen", html: "Laden Sie die dedizierte Event-Contracts-App aus dem App Store (iPhone) oder von Google Play (Android) herunter. Es ist ein anderer Download als Tradovate Trader und für Smartphone-Bildschirme gebaut. Auch wenn Sie Tradovate bereits für Futures nutzen, ist dies eine separate Installation." },
        { title: "Ein separates Konto eröffnen und finanzieren", html: "Öffnen Sie die App und tippen Sie auf das Geldbörsen-Symbol, um den Online-Antrag zu starten. Sie eröffnen hier ein eigenständiges Event-Kontrakte-Konto und verwenden nicht Ihre Futures-Anmeldung weiter. Planen Sie also ein, den kurzen Antrag auszufüllen und das Konto in der App zu finanzieren, bevor Sie etwas live platzieren können." },
        { title: "Einen Markt und ein Preisniveau wählen", html: "Wählen Sie einen der zehn Märkte und dann das Tagespreisniveau, um das Sie handeln möchten. Sehen Sie dieses Niveau als die Linie im Sand: Alles Weitere ist nur die Entscheidung, auf welcher Seite davon der Markt zum Handelsschluss landet." },
        { title: "Ja oder Nein wählen und die Größe festlegen", html: "Beantworten Sie nun die Frage. Over bedeutet, dass Sie einen Schluss über Ihrem Niveau erwarten, Under bedeutet auf oder darunter. Legen Sie fest, wie viele Kontrakte Sie möchten. Vor der Bestätigung zeigt die App den Preis pro Kontrakt (Ihr maximaler Verlust) und die Auszahlung bei Erfolg (Ihr maximaler Gewinn). Lesen Sie diese beiden Zahlen jedes Mal. Das ist das gesamte Risikobild, vor dem Klick offengelegt." },
        { title: "Absenden und abrechnen lassen", html: "Senden Sie die Order ab, und Sie sind dabei. Jeder Markt wird zu seinem eigenen täglichen Schluss abgerechnet, und die App löst den Kontrakt automatisch auf, sobald dieser Schlusskurs feststeht. Es gibt keinen Stopp zu verwalten und keinen Rollover zu überwachen. Ob Gewinn oder Verlust, es wird zum Schluss entschieden, und die Auszahlung landet auf Ihrem Konto." },
      ],
    },
    { type: "heading",text: "Gebühren, Risiko und einige ehrliche Vorbehalte" },
    { type: "paragraph",html: "Event-Kontrakte sind provisionsfrei, das heißt aber nicht kostenlos. Für jeden Trade fallen Börsen-, Clearing- und NFA-Gebühren an. Ein gewinnender Kontrakt bringt also etwas weniger als den vollen Dollar, und diese Gebühren fallen stärker ins Gewicht, wenn Sie viele günstige Kontrakte handeln. Rechnen Sie sie ein." },
    { type: "paragraph",html: "Ihr Risiko ist tatsächlich auf den gezahlten Preis begrenzt, was der ehrliche Reiz dieser Produkte ist. Es gibt keinen Margin Call, keine Liquidation und keine Drawdown-Spirale. Aber begrenztes Risiko ist nicht dasselbe wie geringes Risiko. Kaufen Sie genug Kontrakte zu fünfzig Cent, die nie ins Ziel kommen, summieren sich die Verluste wie überall sonst. Handeln Sie sie mit derselben Disziplin bei der Positionsgröße, die Sie überall anwenden würden." },
    { type: "quote",html: "Die Abrechnungszeiten unterscheiden sich je nach Markt, und die genauen Fristen können sich mit Börsenplänen und Feiertagen verschieben. Bestätigen Sie die aktuelle Handelsschlusszeit Ihres Marktes in der App, bevor Sie sich darauf verlassen." },
    { type: "heading",text: "Automatisieren Sie Ihre Futures-Trades mit PickMyTrade" },
    { type: "paragraph",html: "Event-Kontrakte sind ein manuelles Produkt, das Sie selbst eintippen. Für Ihren regulären Tradovate-Futures-Handel <strong class='text-white'>können Sie Einstiege und Ausstiege direkt aus TradingView-Alerts automatisieren</strong>, ohne Programmierung und ohne am Bildschirm zu sitzen." },
  ], es: [
    { type: "paragraph",html: "Los contratos de eventos son lo más sencillo que ofrece Tradovate, y también lo más fácil de hacer mal antes de empezar. Son apuestas diarias de sí/no sobre dónde cierra un mercado importante. Elija oro, petróleo, el S&P 500, lo que quiera. Decida si termina el día por encima o por debajo de un precio que usted elige. Si acierta, el contrato paga. Si se equivoca, pierde lo que pagó y nada más." },
    { type: "paragraph",html: "Y aquí está lo que confunde a la gente: estos contratos no se operan dentro de la aplicación web o de escritorio normal de Tradovate Trader. Los contratos de eventos viven en su propia aplicación móvil independiente, con su propia cuenta. Si los ha estado buscando en el DOM o en su espacio de trabajo de futuros, por eso no los encuentra." },
    { type: "heading",text: "Qué es realmente un contrato de eventos de CME" },
    { type: "paragraph",html: "Cada contrato es una única pregunta con respuesta de sí o no: ¿cerrará este mercado hoy por encima del nivel que usted elija? Los lista CME Group, así que opera un producto real de una bolsa, no un libro interno de la casa." },
    { type: "paragraph",html: "El precio es lo que lo hace atractivo. Un contrato cuesta entre 0 y 1 $, y ese precio refleja aproximadamente las probabilidades. Algo que el mercado ve como cara o cruz ronda los 0,50 $; una apuesta improbable ronda unos pocos centavos. Si su predicción se cumple, el contrato se liquida a 1 $. Si no, a 0 $. Así, el precio que paga es su pérdida máxima, y la diferencia entre ese precio y 1 $ es su ganancia máxima. Ambas cifras se muestran antes de que se comprometa." },
    { type: "paragraph",html: "Hay diez mercados disponibles en cuatro grupos:" },
    { type: "table", headers: ["Grupo","Mercados"], rows: [
      ["Índices bursátiles","E-mini S&P 500, Nasdaq-100, Russell 2000, Dow"],
      ["Metales","Oro, plata, cobre"],
      ["Energía","Petróleo crudo WTI, gas natural"],
      ["Divisas","EUR/USD"],
    ] },
    { type: "heading",text: "Cómo operar contratos de eventos en Tradovate" },
    {
      type: "steps",
      items: [
        { title: "Descargue la aplicación Event Contracts", html: "Descargue la aplicación dedicada Event Contracts desde la App Store (iPhone) o Google Play (Android). Es una descarga distinta de Tradovate Trader y está pensada para pantallas de móvil. Si ya usa Tradovate para futuros, esta sigue siendo una instalación aparte." },
        { title: "Abra y fondee una cuenta independiente", html: "Abra la aplicación y toque el icono de la cartera para iniciar la solicitud en línea. Aquí está abriendo una cuenta independiente de contratos de eventos, no reutilizando su acceso de futuros, así que prevea completar la breve solicitud y fondearla desde la propia aplicación antes de poder colocar algo en vivo." },
        { title: "Elija un mercado y un nivel de precio", html: "Elija uno de los diez mercados y luego el nivel de precio del día en torno al cual quiere operar. Piense en ese nivel como la línea en la arena: a partir de ahí, solo se trata de decidir de qué lado cerrará el mercado." },
        { title: "Elija sí o no y fije su tamaño", html: "Ahora responda a la pregunta. Over significa que cree que cierra por encima de su nivel; under, que cierra en él o por debajo. Fije cuántos contratos desea. Antes de confirmar, la aplicación muestra el precio por contrato (su pérdida máxima) y el pago si acierta (su ganancia máxima). Lea esas dos cifras cada vez. Es todo el panorama de riesgo, expuesto antes de hacer clic." },
        { title: "Envíe y deje que se liquide", html: "Envíe la orden y ya está dentro. Cada mercado se liquida en su propio cierre diario, y la aplicación resuelve el contrato automáticamente cuando se publica ese cierre. No hay stop que gestionar ni rollover que vigilar. Gane o pierda, se decide en el cierre y el pago llega a su cuenta." },
      ],
    },
    { type: "heading",text: "Comisiones, riesgo y algunas advertencias honestas" },
    { type: "paragraph",html: "Los contratos de eventos no tienen comisión, pero eso no significa que sean gratis. Se aplican tarifas de bolsa, de compensación y de la NFA a cada operación, por lo que un contrato ganador deja algo menos que el dólar completo, y esas tarifas pesan más cuando se operan muchos contratos baratos. Téngalas en cuenta." },
    { type: "paragraph",html: "Su riesgo realmente está limitado al precio que paga, que es el atractivo honesto de estos productos. No hay llamada de margen, ni liquidación, ni espiral de drawdown. Pero riesgo limitado no es lo mismo que riesgo bajo. Compre suficientes contratos a cincuenta centavos que nunca lleguen, y las pérdidas se acumulan como en cualquier otro caso. Opérelos con la misma disciplina de tamaño que usaría en cualquier otro sitio." },
    { type: "quote",html: "Los horarios de liquidación difieren según el mercado, y los cortes exactos pueden variar con los calendarios de la bolsa y los festivos. Confirme dentro de la aplicación la hora de cierre vigente de su mercado antes de confiar en ella." },
    { type: "heading",text: "Automatice sus operaciones de futuros con PickMyTrade" },
    { type: "paragraph",html: "Los contratos de eventos son un producto manual, que se opera a mano. Para su trading regular de futuros en Tradovate, <strong class='text-white'>puede automatizar entradas y salidas directamente desde alertas de TradingView</strong>, sin programar y sin estar sentado frente a la pantalla." },
  ], fr: [
    { type: "paragraph",html: "Les contrats d'événements sont ce que Tradovate propose de plus simple, et aussi ce qu'il est le plus facile de mal aborder avant de commencer. Ce sont des paris quotidiens oui/non sur la clôture d'un grand marché. Choisissez l'or, le pétrole, le S&P 500, peu importe. Décidez s'il termine la journée au-dessus ou en dessous d'un prix que vous choisissez. Si vous avez raison, le contrat paie. Si vous avez tort, vous perdez ce que vous avez payé, et rien de plus." },
    { type: "paragraph",html: "Voici ce qui déroute : vous ne tradez pas ces contrats dans l'application web ou de bureau Tradovate Trader habituelle. Les contrats d'événements se trouvent dans leur propre application mobile distincte, avec leur propre compte. Si vous les avez cherchés dans le DOM ou dans votre espace de travail de futures, c'est pourquoi vous ne les trouvez pas." },
    { type: "heading",text: "Ce qu'est réellement un contrat d'événement du CME" },
    { type: "paragraph",html: "Chaque contrat est une seule question à laquelle on répond par oui ou par non : ce marché clôturera-t-il aujourd'hui au-dessus du niveau que vous avez choisi ? Ils sont cotés par CME Group ; vous tradez donc un véritable produit de bourse, et non un carnet interne." },
    { type: "paragraph",html: "La tarification fait tout l'intérêt. Un contrat coûte entre 0 et 1 $, et ce prix suit à peu près les probabilités. Ce que le marché voit comme un pile ou face se situe autour de 0,50 $ ; un outsider se situe plutôt à quelques cents. Si votre prévision se réalise, le contrat se règle à 1 $. Sinon, à 0 $. Le prix que vous payez est donc votre perte maximale, et l'écart entre ce prix et 1 $ est votre gain maximal. Les deux chiffres sont affichés avant que vous vous engagiez." },
    { type: "paragraph",html: "Dix marchés sont disponibles, répartis en quatre groupes :" },
    { type: "table", headers: ["Groupe","Marchés"], rows: [
      ["Indices actions","E-mini S&P 500, Nasdaq-100, Russell 2000, Dow"],
      ["Métaux","Or, argent, cuivre"],
      ["Énergie","Pétrole brut WTI, gaz naturel"],
      ["Devises","EUR/USD"],
    ] },
    { type: "heading",text: "Comment trader les contrats d'événements sur Tradovate" },
    {
      type: "steps",
      items: [
        { title: "Téléchargez l'application Event Contracts", html: "Téléchargez l'application dédiée Event Contracts depuis l'App Store (iPhone) ou Google Play (Android). Il s'agit d'un téléchargement différent de Tradovate Trader, conçu pour les écrans de téléphone. Si vous utilisez déjà Tradovate pour les futures, c'est tout de même une installation distincte." },
        { title: "Ouvrez et alimentez un compte distinct", html: "Ouvrez l'application et touchez l'icône du portefeuille pour lancer la demande en ligne. Vous ouvrez ici un compte de contrats d'événements autonome, et non en réutilisant votre identifiant de futures ; prévoyez donc de remplir la courte demande et de l'alimenter depuis l'application avant de pouvoir passer le moindre ordre réel." },
        { title: "Choisissez un marché et un niveau de prix", html: "Choisissez l'un des dix marchés, puis le niveau de prix du jour autour duquel vous souhaitez trader. Voyez ce niveau comme la ligne tracée dans le sable : tout le reste consiste simplement à décider de quel côté le marché clôturera." },
        { title: "Choisissez oui ou non et définissez votre taille", html: "Répondez maintenant à la question. Over signifie que vous pensez que le marché clôture au-dessus de votre niveau ; under, à ce niveau ou en dessous. Définissez le nombre de contrats souhaité. Avant de confirmer, l'application affiche le prix par contrat (votre perte maximale) et le gain si vous avez raison (votre profit maximal). Lisez ces deux chiffres à chaque fois. C'est tout le tableau du risque, exposé avant de cliquer." },
        { title: "Envoyez et laissez le règlement se faire", html: "Envoyez l'ordre et vous êtes dans la partie. Chaque marché se règle à sa propre clôture quotidienne, et l'application résout automatiquement le contrat une fois cette clôture publiée. Aucun stop à gérer, aucun roulement à surveiller. Gain ou perte, tout se décide à la clôture, et le gain arrive sur votre compte." },
      ],
    },
    { type: "heading",text: "Frais, risque et quelques réserves honnêtes" },
    { type: "paragraph",html: "Les contrats d'événements sont sans commission, mais cela ne veut pas dire gratuits. Des frais de bourse, de compensation et de la NFA s'appliquent à chaque trade ; un contrat gagnant rapporte donc un peu moins que le dollar complet, et ces frais pèsent davantage quand vous tradez beaucoup de contrats bon marché. Tenez-en compte." },
    { type: "paragraph",html: "Votre risque est réellement plafonné au prix que vous payez, ce qui fait l'intérêt honnête de ces produits. Pas d'appel de marge, pas de liquidation, pas de spirale de drawdown. Mais risque plafonné ne veut pas dire risque faible. Achetez suffisamment de contrats à cinquante cents qui n'aboutissent jamais, et les pertes s'accumulent comme n'importe où ailleurs. Tradez-les avec la même discipline de taille que vous appliqueriez partout." },
    { type: "quote",html: "Les heures de règlement varient selon le marché, et les échéances exactes peuvent évoluer avec les calendriers de la bourse et les jours fériés. Vérifiez dans l'application l'heure de clôture actuelle de votre marché avant de vous y fier." },
    { type: "heading",text: "Automatisez vos trades de futures avec PickMyTrade" },
    { type: "paragraph",html: "Les contrats d'événements sont un produit manuel, que l'on trade soi-même. Pour votre trading de futures habituel sur Tradovate, <strong class='text-white'>vous pouvez automatiser vos entrées et sorties directement depuis des alertes TradingView</strong>, sans codage et sans rester devant l'écran." },
  ], it: [
    { type: "paragraph",html: "I contratti sugli eventi sono la cosa più semplice che Tradovate offra, e anche la più facile da sbagliare prima ancora di iniziare. Sono scommesse giornaliere sì/no su dove chiude un grande mercato. Scelga oro, petrolio greggio, l'S&P 500, quello che preferisce. Decida se chiude la giornata sopra o sotto un prezzo da lei scelto. Se ha ragione, il contratto paga. Se sbaglia, perde quanto ha pagato e nient'altro." },
    { type: "paragraph",html: "Ecco la parte che confonde: questi contratti non si operano nell'app web o desktop Tradovate Trader abituale. I contratti sugli eventi risiedono in una propria app mobile separata, con un proprio conto. Se li ha cercati sul DOM o nel suo spazio di lavoro dei futures, ecco perché non li trova." },
    { type: "heading",text: "Cos'è davvero un contratto sugli eventi CME" },
    { type: "paragraph",html: "Ogni contratto è una singola domanda con risposta sì o no: questo mercato chiuderà oggi sopra il livello scelto? Sono quotati da CME Group, quindi opera su un vero prodotto di borsa, non su un book interno." },
    { type: "paragraph",html: "Il prezzo è ciò che li rende efficaci. Un contratto costa tra 0 e 1 $, e quel prezzo segue all'incirca le probabilità. Ciò che il mercato considera un testa o croce sta intorno a 0,50 $; un'opzione improbabile sta più vicino a pochi centesimi. Se la sua previsione si avvera, il contratto si regola a 1 $. Altrimenti a 0 $. Quindi il prezzo che paga è la sua perdita massima, e la differenza tra quel prezzo e 1 $ è il suo profitto massimo. Entrambi i numeri vengono mostrati prima che si impegni." },
    { type: "paragraph",html: "Sono disponibili dieci mercati in quattro gruppi:" },
    { type: "table", headers: ["Gruppo","Mercati"], rows: [
      ["Indici azionari","E-mini S&P 500, Nasdaq-100, Russell 2000, Dow"],
      ["Metalli","Oro, argento, rame"],
      ["Energia","Petrolio greggio WTI, gas naturale"],
      ["Valute","EUR/USD"],
    ] },
    { type: "heading",text: "Come operare con i contratti sugli eventi su Tradovate" },
    {
      type: "steps",
      items: [
        { title: "Scarichi l'app Event Contracts", html: "Scarichi l'app dedicata Event Contracts dall'App Store (iPhone) o da Google Play (Android). È un download diverso da Tradovate Trader ed è pensata per gli schermi dei telefoni. Se usa già Tradovate per i futures, resta comunque un'installazione separata." },
        { title: "Apra e finanzi un conto separato", html: "Apra l'app e tocchi l'icona del portafoglio per avviare la richiesta online. Qui sta aprendo un conto autonomo per i contratti sugli eventi, non riutilizzando l'accesso ai futures, quindi preveda di completare la breve richiesta e di finanziarlo dall'interno dell'app prima di poter inserire qualcosa in tempo reale." },
        { title: "Scelga un mercato e un livello di prezzo", html: "Scelga uno dei dieci mercati, poi il livello di prezzo del giorno attorno al quale desidera operare. Pensi a quel livello come alla linea nella sabbia: da lì in poi si tratta solo di decidere da quale lato il mercato chiuderà." },
        { title: "Scelga sì o no e imposti la dimensione", html: "Ora risponda alla domanda. Over significa che ritiene che chiuda sopra il suo livello; under, al livello o sotto. Imposti quanti contratti desidera. Prima di confermare, l'app mostra il prezzo per contratto (la sua perdita massima) e il pagamento se ha ragione (il suo profitto massimo). Legga questi due numeri ogni volta. È l'intero quadro del rischio, esposto prima del clic." },
        { title: "Invii e lasci che si regoli", html: "Invii l'ordine e ci siete dentro. Ogni mercato si regola alla propria chiusura giornaliera e l'app risolve automaticamente il contratto non appena quella chiusura viene stampata. Non c'è nessuno stop da gestire né rollover da sorvegliare. Vinca o perda, tutto si decide alla chiusura e il pagamento arriva sul suo conto." },
      ],
    },
    { type: "heading",text: "Commissioni, rischio e qualche avvertenza onesta" },
    { type: "paragraph",html: "I contratti sugli eventi sono senza commissioni, ma questo non significa gratuiti. Su ogni trade si applicano costi di borsa, di compensazione e della NFA, quindi un contratto vincente rende un po' meno del dollaro intero, e queste spese pesano di più quando si operano molti contratti economici. Le metta in conto." },
    { type: "paragraph",html: "Il suo rischio è davvero limitato al prezzo che paga, ed è il fascino onesto di questi prodotti. Niente margin call, niente liquidazione, niente spirale di drawdown. Ma rischio limitato non significa rischio basso. Acquisti abbastanza contratti a cinquanta centesimi che non arrivano mai, e le perdite si sommano come ovunque. Li operi con la stessa disciplina nella dimensione che userebbe altrove." },
    { type: "quote",html: "Gli orari di regolamento differiscono da mercato a mercato e le scadenze esatte possono variare con i calendari di borsa e le festività. Confermi nell'app l'orario di chiusura attuale del suo mercato prima di farvi affidamento." },
    { type: "heading",text: "Automatizzi i suoi trade sui futures con PickMyTrade" },
    { type: "paragraph",html: "I contratti sugli eventi sono un prodotto manuale, da operare a mano. Per il suo trading regolare sui futures su Tradovate, <strong class='text-white'>può automatizzare ingressi e uscite direttamente dagli alert di TradingView</strong>, senza programmare e senza restare seduto davanti allo schermo." },
  ] },
  ctaHeading: { en: "Automate Your Regular Futures Trades", de: "Automatisieren Sie Ihre regulären Futures-Trades", es: "Automatice sus operaciones regulares de futuros", fr: "Automatisez vos trades de futures habituels", it: "Automatizzi i suoi trade regolari sui futures" },
  ctaText: { en: "Event contracts are tap-it-yourself, but your regular Tradovate futures trading doesn't have to be. Automate entries and exits straight from TradingView alerts, no coding required.", de: "Event-Kontrakte tippen Sie selbst ein, Ihr regulärer Tradovate-Futures-Handel muss das aber nicht. Automatisieren Sie Einstiege und Ausstiege direkt aus TradingView-Alerts, ganz ohne Programmierung.", es: "Los contratos de eventos se operan a mano, pero su trading regular de futuros en Tradovate no tiene por qué. Automatice entradas y salidas directamente desde alertas de TradingView, sin necesidad de programar.", fr: "Les contrats d'événements se tradent à la main, mais votre trading de futures habituel sur Tradovate n'a pas à l'être. Automatisez vos entrées et sorties directement depuis des alertes TradingView, sans aucun codage.", it: "I contratti sugli eventi si operano a mano, ma il suo trading regolare sui futures su Tradovate non deve esserlo. Automatizzi ingressi e uscite direttamente dagli alert di TradingView, senza bisogno di programmare." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [], de: [], es: [], fr: [], it: [] },
  relatedHeading: { en: "Related Guides", de: "Verwandte Anleitungen", es: "Guías relacionadas", fr: "Guides associés", it: "Guide correlate" },
  disclosureText: { en: `This guide is for educational and informational purposes only and is not financial, investment, or trading advice. Trading futures and other leveraged products carries a substantial risk of loss and is not suitable for every investor. PickMyTrade is an independent third-party automation platform and is not affiliated with, endorsed by, or sponsored by Tradovate, Inc. "Tradovate" and all related names, logos, and trademarks are the property of their respective owners. Platform features and steps change over time, so always confirm the current process in the official Tradovate platform and documentation before acting.`, de: "Dieser Leitfaden dient ausschließlich Bildungs- und Informationszwecken und stellt weder Finanz-, Anlage- noch Handelsberatung dar. Der Handel mit Futures und anderen gehebelten Produkten birgt ein erhebliches Verlustrisiko und ist nicht für jeden Anleger geeignet. PickMyTrade ist eine unabhängige Drittanbieter-Automatisierungsplattform und steht in keiner Verbindung zu Tradovate, Inc., wird von dieser weder unterstützt noch gesponsert. \"Tradovate\" sowie alle zugehörigen Namen, Logos und Marken sind Eigentum ihrer jeweiligen Inhaber. Plattformfunktionen und Schritte ändern sich im Laufe der Zeit. Prüfen Sie daher stets den aktuellen Ablauf in der offiziellen Tradovate-Plattform und -Dokumentation, bevor Sie handeln.", es: "Esta guía tiene fines exclusivamente educativos e informativos y no constituye asesoramiento financiero, de inversión ni de trading. Operar con futuros y otros productos apalancados conlleva un riesgo sustancial de pérdida y no es adecuado para todos los inversores. PickMyTrade es una plataforma de automatización independiente de terceros y no está afiliada, respaldada ni patrocinada por Tradovate, Inc. \"Tradovate\" y todos los nombres, logotipos y marcas relacionados son propiedad de sus respectivos titulares. Las funciones de la plataforma y los pasos cambian con el tiempo, por lo que siempre debe confirmar el proceso vigente en la plataforma y la documentación oficiales de Tradovate antes de actuar.", fr: "Ce guide est fourni à des fins exclusivement éducatives et informatives et ne constitue pas un conseil financier, d'investissement ou de trading. Le trading de contrats à terme et d'autres produits à effet de levier comporte un risque de perte important et ne convient pas à tous les investisseurs. PickMyTrade est une plateforme d'automatisation tierce indépendante et n'est ni affiliée à Tradovate, Inc., ni approuvée ou parrainée par cette dernière. « Tradovate » ainsi que tous les noms, logos et marques associés sont la propriété de leurs détenteurs respectifs. Les fonctionnalités de la plateforme et les étapes évoluent avec le temps ; vérifiez donc toujours la procédure en vigueur dans la plateforme et la documentation officielles de Tradovate avant d'agir.", it: "Questa guida ha esclusivamente scopo educativo e informativo e non costituisce consulenza finanziaria, di investimento o di trading. Il trading di futures e di altri prodotti a leva comporta un rischio sostanziale di perdita e non è adatto a tutti gli investitori. PickMyTrade è una piattaforma di automazione indipendente di terze parti e non è affiliata, approvata né sponsorizzata da Tradovate, Inc. \"Tradovate\" e tutti i nomi, loghi e marchi correlati sono di proprietà dei rispettivi titolari. Le funzionalità della piattaforma e i passaggi cambiano nel tempo, quindi confermi sempre la procedura attuale nella piattaforma e nella documentazione ufficiali di Tradovate prima di agire." },
};
