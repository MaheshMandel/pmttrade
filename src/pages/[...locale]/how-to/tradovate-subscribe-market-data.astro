---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-subscribe-market-data";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Subscribe to Tradovate Real-Time Market Data";
const META_DESCRIPTION =
  "Subscribe to Tradovate market data fast: open Application Settings, pick your CME exchange bundle, and unlock real-time futures quotes and charts.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate-Echtzeit-Marktdaten abonnieren", es: "Suscríbase a los datos de mercado en tiempo real de Tradovate", fr: "S'abonner aux données de marché en temps réel de Tradovate", it: "Abbonarsi ai dati di mercato in tempo reale di Tradovate" },
  dek: { en: "Want real-time quotes and live charts in Tradovate? Here's exactly how to get your market data subscription switched on, step by step.", de: "Sie möchten Echtzeitkurse und Live-Charts in Tradovate? So schalten Sie Ihr Marktdaten-Abonnement Schritt für Schritt frei.", es: "¿Quiere cotizaciones en tiempo real y gráficos en vivo en Tradovate? Aquí tiene exactamente cómo activar su suscripción de datos de mercado, paso a paso.", fr: "Vous souhaitez des cotations en temps réel et des graphiques en direct dans Tradovate ? Voici exactement comment activer votre abonnement aux données de marché, étape par étape.", it: "Desidera quotazioni in tempo reale e grafici live in Tradovate? Ecco esattamente come attivare il suo abbonamento ai dati di mercato, passo dopo passo." },
  readTime: { en: "4 min read", de: "4 Min. Lesezeit", es: "Lectura de 4 min", fr: "Lecture : 4 min", it: "Lettura di 4 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Want real-time quotes and live charts in Tradovate? Whether you're day-trading futures by hand or wiring up automation with PickMyTrade, here's exactly how to get your Tradovate market data subscription switched on, step by step." },
    { type: "heading", text: "What Is Tradovate Market Data?" },
    { type: "paragraph", html: "Market data is the exchange feed that powers your live prices, charts, DOM, and time-and-sales windows. If you don't have an active subscription to the exchange that lists your instrument, Tradovate drops you back to a 10-minute delayed feed. A live subscription is what gets you real-time quotes, and you'll need it to trade properly on both live and simulated accounts." },
    { type: "heading", text: "Subscribe to Tradovate Market Data: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open Application Settings", html: "Log in to the Tradovate Web Trader and open <strong class='text-white'>Application Settings</strong> from the top-right corner of the screen." },
        { title: "Open the Market Data Section", html: "Inside Settings, head to the <strong class='text-white'>Subscriptions</strong> area and find <strong class='text-white'>Market Data</strong>. Click <strong class='text-white'>Subscribe</strong> to open the market data page, or <strong class='text-white'>Change</strong> if you already have a plan running." },
        { title: "Choose Your Exchange and Data Level", html: "Pick the exchange feed you actually trade. Most futures traders go with the CME Group bundle, which covers CME, CBOT, COMEX, and NYMEX. Choose <strong class='text-white'>Level I</strong> for bid/ask and last-trade quotes, or <strong class='text-white'>Level II</strong> if you want full order-book depth. Rather grab individual exchanges instead of the whole bundle? Use the <strong class='text-white'>Customize Data Subscription</strong> option. Fees vary by exchange and data level, so check Tradovate's current market-data rates before you confirm." },
        { title: "Certify Non-Professional Status and Confirm", html: "Tradovate asks you to agree to the exchange market data agreements and certify whether you're a non-professional or professional user. That distinction matters, because the two carry different rates. Read the agreement, confirm your selection, and submit the subscription." },
        { title: "Reload and Verify Live Quotes", html: "Log out and back in, or just reload the platform, so the new feed activates. Then open a chart or DOM. Your subscribed symbols should now tick in real time instead of sitting on delayed data." },
      ],
    },
    { type: "heading", text: "Why You'd Need This" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Real-time execution</strong>, trade off live prices instead of a 10-minute delayed feed.",
        "<strong class='text-white'>Accurate charts and indicators</strong>, EMA, VWAP, and volume tools only mean something on live data.",
        "<strong class='text-white'>DOM and order-flow tools</strong>, Level II depth needs a Level II subscription.",
        "<strong class='text-white'>Automation</strong>, bots and alert bridges need live quotes to fire and route orders correctly.",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Once your live data is flowing, PickMyTrade wires your TradingView alerts straight into your Tradovate account, so entries, stops, and targets fire automatically. No manual clicking on the DOM. It's the fastest way to turn a subscribed, real-time Tradovate account into a hands-free trading setup." },
  ], de: [
    { type: "paragraph",html: "Sie möchten Echtzeitkurse und Live-Charts in Tradovate? Ob Sie Futures von Hand im Daytrading handeln oder eine Automatisierung mit PickMyTrade aufsetzen: So schalten Sie Ihr Tradovate-Marktdaten-Abonnement Schritt für Schritt frei." },
    { type: "heading",text: "Was sind Tradovate-Marktdaten?" },
    { type: "paragraph",html: "Marktdaten sind der Börsenfeed, der Ihre Live-Kurse, Charts, das DOM und die Time-and-Sales-Fenster speist. Wenn Sie kein aktives Abonnement für die Börse haben, an der Ihr Instrument gelistet ist, fällt Tradovate auf einen um 10 Minuten verzögerten Feed zurück. Ein Live-Abonnement liefert Ihnen Echtzeitkurse, und Sie benötigen es, um sowohl auf Live- als auch auf Simulationskonten ordentlich zu handeln." },
    { type: "heading",text: "Tradovate-Marktdaten abonnieren: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Application Settings öffnen", html: "Melden Sie sich im Tradovate Web Trader an und öffnen Sie <strong class='text-white'>Application Settings</strong> in der oberen rechten Ecke des Bildschirms." },
        { title: "Den Bereich Market Data öffnen", html: "Gehen Sie in den Einstellungen zum Bereich <strong class='text-white'>Subscriptions</strong> und suchen Sie <strong class='text-white'>Market Data</strong>. Klicken Sie auf <strong class='text-white'>Subscribe</strong>, um die Marktdaten-Seite zu öffnen, oder auf <strong class='text-white'>Change</strong>, falls bereits ein Tarif läuft." },
        { title: "Börse und Datenlevel wählen", html: "Wählen Sie den Börsenfeed, den Sie tatsächlich handeln. Die meisten Futures-Trader entscheiden sich für das CME-Group-Bundle, das CME, CBOT, COMEX und NYMEX abdeckt. Wählen Sie <strong class='text-white'>Level I</strong> für Bid/Ask und Last-Trade-Kurse oder <strong class='text-white'>Level II</strong>, wenn Sie die volle Orderbuchtiefe wünschen. Möchten Sie lieber einzelne Börsen statt des gesamten Bundles? Nutzen Sie die Option <strong class='text-white'>Customize Data Subscription</strong>. Die Gebühren variieren je nach Börse und Datenlevel, prüfen Sie daher die aktuellen Marktdaten-Preise von Tradovate, bevor Sie bestätigen." },
        { title: "Nicht-professionellen Status bestätigen und abschließen", html: "Tradovate bittet Sie, den Börsen-Marktdatenvereinbarungen zuzustimmen und zu bestätigen, ob Sie ein nicht-professioneller oder ein professioneller Nutzer sind. Diese Unterscheidung ist wichtig, da beide unterschiedliche Preise haben. Lesen Sie die Vereinbarung, bestätigen Sie Ihre Auswahl und senden Sie das Abonnement ab." },
        { title: "Neu laden und Live-Kurse prüfen", html: "Melden Sie sich ab und wieder an oder laden Sie die Plattform einfach neu, damit der neue Feed aktiv wird. Öffnen Sie dann einen Chart oder das DOM. Ihre abonnierten Symbole sollten jetzt in Echtzeit ticken, statt auf verzögerten Daten zu stehen." },
      ],
    },
    { type: "heading",text: "Warum Sie das brauchen" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Ausführung in Echtzeit</strong>, handeln Sie auf Basis von Live-Kursen statt eines um 10 Minuten verzögerten Feeds.",
        "<strong class='text-white'>Präzise Charts und Indikatoren</strong>, EMA, VWAP und Volumen-Tools sind nur auf Live-Daten aussagekräftig.",
        "<strong class='text-white'>DOM- und Orderflow-Tools</strong>, Level-II-Tiefe erfordert ein Level-II-Abonnement.",
        "<strong class='text-white'>Automatisierung</strong>, Bots und Alert-Bridges benötigen Live-Kurse, um Orders korrekt auszulösen und zu routen.",
      ],
    },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "Sobald Ihre Live-Daten fließen, verbindet PickMyTrade Ihre TradingView-Alerts direkt mit Ihrem Tradovate-Konto, sodass Einstiege, Stops und Ziele automatisch ausgelöst werden. Kein manuelles Klicken im DOM. Es ist der schnellste Weg, aus einem abonnierten Echtzeit-Tradovate-Konto ein Hands-free-Trading-Setup zu machen." },
  ], es: [
    { type: "paragraph",html: "¿Quiere cotizaciones en tiempo real y gráficos en vivo en Tradovate? Tanto si hace day trading de futuros a mano como si configura la automatización con PickMyTrade, aquí tiene exactamente cómo activar su suscripción de datos de mercado de Tradovate, paso a paso." },
    { type: "heading",text: "¿Qué son los datos de mercado de Tradovate?" },
    { type: "paragraph",html: "Los datos de mercado son el feed del mercado que alimenta sus precios en vivo, gráficos, DOM y ventanas de time and sales. Si no tiene una suscripción activa al mercado en el que cotiza su instrumento, Tradovate le devuelve a un feed con 10 minutos de retraso. Una suscripción en vivo es lo que le da cotizaciones en tiempo real, y la necesitará para operar correctamente tanto en cuentas reales como simuladas." },
    { type: "heading",text: "Suscribirse a los datos de mercado de Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra Application Settings", html: "Inicie sesión en Tradovate Web Trader y abra <strong class='text-white'>Application Settings</strong> desde la esquina superior derecha de la pantalla." },
        { title: "Abra la sección Market Data", html: "Dentro de la configuración, vaya al área <strong class='text-white'>Subscriptions</strong> y busque <strong class='text-white'>Market Data</strong>. Haga clic en <strong class='text-white'>Subscribe</strong> para abrir la página de datos de mercado, o en <strong class='text-white'>Change</strong> si ya tiene un plan en marcha." },
        { title: "Elija su mercado y nivel de datos", html: "Elija el feed del mercado en el que realmente opera. La mayoría de los traders de futuros optan por el paquete CME Group, que cubre CME, CBOT, COMEX y NYMEX. Elija <strong class='text-white'>Level I</strong> para cotizaciones bid/ask y de último precio, o <strong class='text-white'>Level II</strong> si quiere la profundidad completa del libro de órdenes. ¿Prefiere contratar mercados individuales en lugar del paquete completo? Use la opción <strong class='text-white'>Customize Data Subscription</strong>. Las tarifas varían según el mercado y el nivel de datos, así que consulte las tarifas vigentes de datos de mercado de Tradovate antes de confirmar." },
        { title: "Certifique su condición de no profesional y confirme", html: "Tradovate le pide que acepte los acuerdos de datos de mercado de los mercados y que certifique si es un usuario no profesional o profesional. Esa distinción importa, porque ambos tienen tarifas diferentes. Lea el acuerdo, confirme su selección y envíe la suscripción." },
        { title: "Recargue y verifique las cotizaciones en vivo", html: "Cierre sesión y vuelva a entrar, o simplemente recargue la plataforma, para que el nuevo feed se active. Después abra un gráfico o el DOM. Sus símbolos suscritos deberían moverse ahora en tiempo real en lugar de quedarse en datos con retraso." },
      ],
    },
    { type: "heading",text: "Por qué lo necesitaría" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Ejecución en tiempo real</strong>, opere con precios en vivo en lugar de un feed con 10 minutos de retraso.",
        "<strong class='text-white'>Gráficos e indicadores precisos</strong>, las herramientas de EMA, VWAP y volumen solo significan algo con datos en vivo.",
        "<strong class='text-white'>Herramientas de DOM y order flow</strong>, la profundidad Level II requiere una suscripción Level II.",
        "<strong class='text-white'>Automatización</strong>, los bots y los puentes de alertas necesitan cotizaciones en vivo para ejecutar y enrutar las órdenes correctamente.",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Una vez que sus datos en vivo fluyan, PickMyTrade conecta sus alertas de TradingView directamente con su cuenta de Tradovate, para que las entradas, los stops y los objetivos se ejecuten automáticamente. Sin clics manuales en el DOM. Es la forma más rápida de convertir una cuenta de Tradovate suscrita y en tiempo real en una configuración de trading sin manos." },
  ], fr: [
    { type: "paragraph",html: "Vous souhaitez des cotations en temps réel et des graphiques en direct dans Tradovate ? Que vous fassiez du day trading de contrats à terme à la main ou que vous mettiez en place l'automatisation avec PickMyTrade, voici exactement comment activer votre abonnement aux données de marché Tradovate, étape par étape." },
    { type: "heading",text: "Que sont les données de marché Tradovate ?" },
    { type: "paragraph",html: "Les données de marché sont le flux de la bourse qui alimente vos prix en direct, vos graphiques, votre DOM et vos fenêtres de time and sales. Si vous n'avez pas d'abonnement actif à la bourse sur laquelle votre instrument est coté, Tradovate vous replace sur un flux différé de 10 minutes. Un abonnement en direct est ce qui vous donne des cotations en temps réel, et vous en aurez besoin pour trader correctement sur les comptes réels comme simulés." },
    { type: "heading",text: "S'abonner aux données de marché Tradovate : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir Application Settings", html: "Connectez-vous à Tradovate Web Trader et ouvrez <strong class='text-white'>Application Settings</strong> depuis le coin supérieur droit de l'écran." },
        { title: "Ouvrir la section Market Data", html: "Dans les paramètres, rendez-vous dans la zone <strong class='text-white'>Subscriptions</strong> et repérez <strong class='text-white'>Market Data</strong>. Cliquez sur <strong class='text-white'>Subscribe</strong> pour ouvrir la page des données de marché, ou sur <strong class='text-white'>Change</strong> si vous avez déjà une formule active." },
        { title: "Choisir votre bourse et votre niveau de données", html: "Choisissez le flux de la bourse que vous tradez réellement. La plupart des traders de contrats à terme optent pour le bundle CME Group, qui couvre CME, CBOT, COMEX et NYMEX. Choisissez <strong class='text-white'>Level I</strong> pour les cotations bid/ask et du dernier prix, ou <strong class='text-white'>Level II</strong> si vous voulez la profondeur complète du carnet d'ordres. Vous préférez prendre des bourses individuelles plutôt que tout le bundle ? Utilisez l'option <strong class='text-white'>Customize Data Subscription</strong>. Les frais varient selon la bourse et le niveau de données ; vérifiez donc les tarifs actuels des données de marché de Tradovate avant de confirmer." },
        { title: "Certifier votre statut non professionnel et confirmer", html: "Tradovate vous demande d'accepter les accords de données de marché des bourses et de certifier si vous êtes un utilisateur non professionnel ou professionnel. Cette distinction compte, car les deux ont des tarifs différents. Lisez l'accord, confirmez votre sélection et soumettez l'abonnement." },
        { title: "Recharger et vérifier les cotations en direct", html: "Déconnectez-vous puis reconnectez-vous, ou rechargez simplement la plateforme, afin que le nouveau flux s'active. Ouvrez ensuite un graphique ou le DOM. Vos symboles souscrits devraient maintenant évoluer en temps réel au lieu de rester sur des données différées." },
      ],
    },
    { type: "heading",text: "Pourquoi vous en avez besoin" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Exécution en temps réel</strong>, tradez sur des prix en direct plutôt que sur un flux différé de 10 minutes.",
        "<strong class='text-white'>Graphiques et indicateurs précis</strong>, les outils EMA, VWAP et volume n'ont de sens que sur des données en direct.",
        "<strong class='text-white'>Outils DOM et order flow</strong>, la profondeur Level II nécessite un abonnement Level II.",
        "<strong class='text-white'>Automatisation</strong>, les bots et les passerelles d'alertes ont besoin de cotations en direct pour déclencher et acheminer correctement les ordres.",
      ],
    },
    { type: "heading",text: "Automatisez tout cela avec PickMyTrade" },
    { type: "paragraph",html: "Une fois vos données en direct actives, PickMyTrade relie directement vos alertes TradingView à votre compte Tradovate, afin que les entrées, les stops et les objectifs se déclenchent automatiquement. Aucun clic manuel sur le DOM. C'est le moyen le plus rapide de transformer un compte Tradovate abonné et en temps réel en une configuration de trading mains libres." },
  ], it: [
    { type: "paragraph",html: "Desidera quotazioni in tempo reale e grafici live in Tradovate? Che faccia day trading sui futures a mano o configuri l'automazione con PickMyTrade, ecco esattamente come attivare il suo abbonamento ai dati di mercato Tradovate, passo dopo passo." },
    { type: "heading",text: "Che cosa sono i dati di mercato di Tradovate?" },
    { type: "paragraph",html: "I dati di mercato sono il feed di borsa che alimenta i suoi prezzi live, i grafici, il DOM e le finestre di time and sales. Se non ha un abbonamento attivo alla borsa su cui è quotato il suo strumento, Tradovate la riporta a un feed ritardato di 10 minuti. È un abbonamento live a darle quotazioni in tempo reale, e le servirà per operare correttamente sia su conti reali sia su conti simulati." },
    { type: "heading",text: "Abbonarsi ai dati di mercato di Tradovate: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Apra Application Settings", html: "Acceda a Tradovate Web Trader e apra <strong class='text-white'>Application Settings</strong> dall'angolo in alto a destra dello schermo." },
        { title: "Apra la sezione Market Data", html: "All'interno delle impostazioni, vada nell'area <strong class='text-white'>Subscriptions</strong> e trovi <strong class='text-white'>Market Data</strong>. Clicchi su <strong class='text-white'>Subscribe</strong> per aprire la pagina dei dati di mercato, oppure su <strong class='text-white'>Change</strong> se ha già un piano attivo." },
        { title: "Scelga la borsa e il livello di dati", html: "Scelga il feed della borsa che opera davvero. La maggior parte dei trader di futures opta per il bundle CME Group, che copre CME, CBOT, COMEX e NYMEX. Scelga <strong class='text-white'>Level I</strong> per le quotazioni bid/ask e dell'ultimo prezzo, oppure <strong class='text-white'>Level II</strong> se desidera la profondità completa del book. Preferisce prendere singole borse invece dell'intero bundle? Usi l'opzione <strong class='text-white'>Customize Data Subscription</strong>. Le tariffe variano in base alla borsa e al livello di dati, quindi controlli le tariffe attuali dei dati di mercato di Tradovate prima di confermare." },
        { title: "Certifichi lo status di non professionista e confermi", html: "Tradovate le chiede di accettare gli accordi sui dati di mercato delle borse e di certificare se è un utente non professionale o professionale. Questa distinzione conta, perché i due hanno tariffe diverse. Legga l'accordo, confermi la sua selezione e invii l'abbonamento." },
        { title: "Ricarichi e verifichi le quotazioni live", html: "Esca e rientri, oppure semplicemente ricarichi la piattaforma, in modo che il nuovo feed si attivi. Poi apra un grafico o il DOM. I suoi simboli sottoscritti dovrebbero ora muoversi in tempo reale invece di restare sui dati ritardati." },
      ],
    },
    { type: "heading",text: "Perché le serve" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Esecuzione in tempo reale</strong>, operi sui prezzi live invece che su un feed ritardato di 10 minuti.",
        "<strong class='text-white'>Grafici e indicatori accurati</strong>, gli strumenti EMA, VWAP e volume hanno senso solo su dati live.",
        "<strong class='text-white'>Strumenti DOM e order flow</strong>, la profondità Level II richiede un abbonamento Level II.",
        "<strong class='text-white'>Automazione</strong>, bot e bridge di alert hanno bisogno di quotazioni live per attivarsi e instradare correttamente gli ordini.",
      ],
    },
    { type: "heading",text: "Automatizzi tutto questo con PickMyTrade" },
    { type: "paragraph",html: "Una volta che i suoi dati live sono attivi, PickMyTrade collega i suoi alert di TradingView direttamente al suo conto Tradovate, così che entrate, stop e obiettivi scattino automaticamente. Nessun clic manuale sul DOM. È il modo più rapido per trasformare un conto Tradovate abbonato e in tempo reale in una configurazione di trading hands-free." },
  ] },
  ctaHeading: { en: "Turn Live Data Into a Hands-Free Setup", de: "Machen Sie aus Live-Daten ein Hands-free-Setup", es: "Convierta los datos en vivo en una configuración sin manos", fr: "Transformez les données en direct en une configuration mains libres", it: "Trasformi i dati live in una configurazione hands-free" },
  ctaText: { en: "Once your live data is flowing, let PickMyTrade wire your TradingView alerts straight into your Tradovate account, so entries, stops, and targets fire automatically.", de: "Sobald Ihre Live-Daten fließen, verbindet PickMyTrade Ihre TradingView-Alerts direkt mit Ihrem Tradovate-Konto, sodass Einstiege, Stops und Ziele automatisch ausgelöst werden.", es: "Una vez que sus datos en vivo fluyan, deje que PickMyTrade conecte sus alertas de TradingView directamente con su cuenta de Tradovate, para que las entradas, los stops y los objetivos se ejecuten automáticamente.", fr: "Une fois vos données en direct actives, laissez PickMyTrade relier vos alertes TradingView directement à votre compte Tradovate, afin que les entrées, les stops et les objectifs se déclenchent automatiquement.", it: "Una volta che i suoi dati live sono attivi, lasci che PickMyTrade colleghi i suoi alert di TradingView direttamente al suo conto Tradovate, così che entrate, stop e obiettivi scattino automaticamente." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Do I get any free market data with Tradovate?", a: "A funded live Tradovate account plan typically includes free Level I CME Group (and EUREX) data. Confirm the current inclusions on Tradovate's pricing page, and keep in mind that funded status is what keeps the free feed active." },
    { q: "When am I billed, and is it prorated?", a: "Exchange data subscriptions renew on the 1st of every month and aren't prorated. You're charged for the full month no matter when in the month you subscribe." },
    { q: "I'm on a prop-firm evaluation account, how do I get data?", a: "Prop-firm and evaluation accounts usually ship with Level I CME Group data already enabled by the firm. If your data is missing or delayed, contact your prop firm rather than subscribing yourself." },
  ], de: [
    { q: "Erhalte ich bei Tradovate kostenlose Marktdaten?", a: "Ein finanzierter Live-Kontotarif bei Tradovate enthält in der Regel kostenlose Level-I-Daten der CME Group (und EUREX). Bestätigen Sie die aktuellen Inhalte auf der Preisseite von Tradovate und beachten Sie, dass der finanzierte Status den kostenlosen Feed aktiv hält." },
    { q: "Wann werde ich belastet, und erfolgt eine anteilige Berechnung?", a: "Börsendaten-Abonnements werden am 1. jedes Monats verlängert und nicht anteilig berechnet. Sie zahlen den vollen Monat, unabhängig davon, wann im Monat Sie abonnieren." },
    { q: "Ich habe ein Prop-Firm-Evaluierungskonto, wie erhalte ich Daten?", a: "Prop-Firm- und Evaluierungskonten werden in der Regel mit bereits von der Firma aktivierten Level-I-Daten der CME Group ausgeliefert. Wenn Ihre Daten fehlen oder verzögert sind, wenden Sie sich an Ihre Prop-Firm, statt selbst zu abonnieren." },
