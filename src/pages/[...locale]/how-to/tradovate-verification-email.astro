---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-verification-email";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Resend a Missing Tradovate Verification Email";
const META_DESCRIPTION =
  "Missing your account verification email? Resend it in under a minute with the Forgot Password reset trick, plus fixes for when it still won't arrive.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Fehlende Tradovate-Bestätigungs-E-Mail erneut anfordern", es: "Reenvíe un correo de verificación de Tradovate que no llegó", fr: "Renvoyer un e-mail de vérification Tradovate manquant", it: "Reinviare un'e-mail di verifica Tradovate mancante" },
  dek: { en: "You signed up, you're ready to trade, and the verification email never showed up. There's no obvious \"resend\" button, but a password reset forces a fresh email out and re-verifies your account in the same motion.", de: "Sie haben sich registriert, sind bereit zu handeln, und die Bestätigungs-E-Mail ist nie angekommen. Eine „Erneut senden“-Schaltfläche gibt es nicht, aber ein Zurücksetzen des Passworts löst eine frische E-Mail aus und verifiziert Ihr Konto in einem Zug.", es: "Se registró, está listo para operar y el correo de verificación nunca apareció. No hay un botón evidente de «reenviar», pero restablecer la contraseña fuerza el envío de un correo nuevo y vuelve a verificar su cuenta de una sola vez.", fr: "Vous vous êtes inscrit, vous êtes prêt à trader, et l'e-mail de vérification n'est jamais arrivé. Il n'existe pas de bouton « renvoyer » évident, mais une réinitialisation du mot de passe provoque l'envoi d'un nouvel e-mail et vérifie votre compte du même coup.", it: "Si è registrato, è pronto a operare e l'e-mail di verifica non è mai arrivata. Non c'è un pulsante «reinvia» evidente, ma reimpostare la password forza l'invio di una nuova e-mail e verifica di nuovo il Suo account in un solo passaggio." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You signed up, you're ready to trade, and the verification email never showed up. Or it did, and you deleted it before clicking the link. Either way you're stuck, because there's no obvious \"resend\" button anywhere in the signup flow. That trips up a lot of people. The fix is a small trick: run a password reset. That forces a fresh email out to the address on file and re-verifies your account in the same motion. Here's exactly how to do it." },
    { type: "quote", html: "<strong class='text-white'>Quick answer:</strong> From the login screen, click <strong class='text-white'>Need help?</strong>, choose <strong class='text-white'>Forgot Password</strong>, and enter your username or email. A new email goes out right away. Check your spam folder if it's slow to land." },
    { type: "heading", text: "Why There's No \"Resend\" Button" },
    { type: "paragraph", html: "The confirmation email only fires once, at signup. Miss it or trash it and there's no dedicated way to ask for another copy. The password reset is the supported workaround, because it re-issues an email to your registered address. That message does the same job as the original verification link and gets you into the account. If you're brand new to the platform, it helps to first walk through opening a Tradovate account so you know which email and username you registered with." },
    { type: "heading", text: "Resend the Email Step by Step" },
    {
      type: "steps",
      items: [
        { title: "Open the Login Screen", html: "Head to trader.tradovate.com, or open the desktop or mobile app, and land on the sign-in page. Don't bother trying to log in yet. Look for the small <strong class='text-white'>Need help?</strong> link sitting just below the username and password fields.", image: { src: `${IMG}/tradovate-verification-email-1.png`, alt: "Tradovate login screen with the Need help link below the sign-in fields" } },
        { title: "Click \"Need Help?\"", html: "That link opens the account recovery page. You'll see two paths here: one to retrieve your username, and one to reset your password. If you're not totally sure which email or username you signed up with, use <strong class='text-white'>Retrieve Username</strong> first so the reset lands where you expect.", image: { src: `${IMG}/tradovate-verification-email-2.png`, alt: "Tradovate account recovery page showing Retrieve Username and Reset Password options" } },
        { title: "Choose Forgot Password and Enter Your Details", html: "Pick <strong class='text-white'>Forgot Password</strong>, then type in the username or email tied to your account and submit it. A fresh email goes straight to the address Tradovate has on file, and that message doubles as your verification. Prefer a shortcut? The reset request form lives directly at trader.tradovate.com/changepwd/request.", image: { src: `${IMG}/tradovate-verification-email-3.png`, alt: "Tradovate Forgot Password form with a field for a username or email address" } },
        { title: "Open the Email and Confirm", html: "Go to your inbox, open the new message, and follow the link inside to set your password and confirm the account. Once that's done you're verified for good. From there you can log in to Tradovate like normal.", image: { src: `${IMG}/tradovate-verification-email-4.png`, alt: "Verification email from Tradovate open in an inbox with the confirmation link" } },
      ],
    },
    { type: "heading", text: "Still Not Getting the Email?" },
    { type: "paragraph", html: "If the reset ran and nothing showed up, work through these before you assume something's broken:" },
    {
      type: "table",
      headers: ["Where to look", "What to do"],
      rows: [
        ["Spam / junk folder", "Automated emails get filtered constantly. Search your whole mailbox for the sender, not just the inbox."],
        ["Wrong address on file", "If you fat-fingered the email at signup, no reset will ever reach you. Use Retrieve Username, or contact support to correct the address."],
        ["Delivery delay", "It isn't always instant. Give it a few minutes rather than firing off ten resets in a row, which can actually slow delivery down."],
        ["Blocked sender", "Whitelist the sender so future account emails, like device approvals and alerts, land cleanly."],
      ],
    },
    { type: "paragraph", html: "One thing worth knowing: Tradovate will never ask you for your password over email. If a message does, it isn't from them. This verification note isn't the only email that gates your access either. The 2FA device-approval email works the same way, so it's worth keeping that sender whitelisted too." },
    { type: "heading", text: "Prop Firm or Evaluation Account?" },
    { type: "paragraph", html: "If you got your Tradovate login through a prop firm or evaluation program, your credentials and any verification usually come from that firm, not directly from Tradovate. The exact rules, limits, and fees vary by firm and account size, so check your firm's current rules. When the standard reset flow doesn't fit your setup, go to your prop firm's support instead of Tradovate's." },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Once you're verified and logged in, stop babysitting entries. Automate your TradingView strategies straight into Tradovate with fast, hands-off execution." },
  ], de: [
    { type: "paragraph",html: "Sie haben sich registriert, sind bereit zu handeln, und die Bestätigungs-E-Mail ist nie angekommen. Oder sie kam an, und Sie haben sie gelöscht, bevor Sie auf den Link geklickt haben. So oder so stecken Sie fest, denn im gesamten Registrierungsablauf gibt es keine offensichtliche „Erneut senden“-Schaltfläche. Das bringt viele Nutzer ins Stolpern. Die Lösung ist ein kleiner Kniff: ein Zurücksetzen des Passworts. Das veranlasst den Versand einer frischen E-Mail an die hinterlegte Adresse und verifiziert Ihr Konto in einem Zug. So gehen Sie genau vor." },
    { type: "quote",html: "<strong class='text-white'>Kurze Antwort:</strong> Klicken Sie auf dem Anmeldebildschirm auf <strong class='text-white'>Need help?</strong>, wählen Sie <strong class='text-white'>Forgot Password</strong> und geben Sie Ihren Benutzernamen oder Ihre E-Mail-Adresse ein. Sofort wird eine neue E-Mail versendet. Prüfen Sie Ihren Spam-Ordner, falls sie sich Zeit lässt." },
    { type: "heading",text: "Warum es keine „Erneut senden“-Schaltfläche gibt" },
    { type: "paragraph",html: "Die Bestätigungs-E-Mail wird nur ein einziges Mal bei der Registrierung versendet. Verpassen oder löschen Sie sie, gibt es keinen eigens vorgesehenen Weg, eine weitere Kopie anzufordern. Das Zurücksetzen des Passworts ist der unterstützte Umweg, weil dabei eine E-Mail an Ihre registrierte Adresse neu ausgestellt wird. Diese Nachricht erfüllt dieselbe Aufgabe wie der ursprüngliche Bestätigungslink und verschafft Ihnen Zugang zum Konto. Wenn Sie neu auf der Plattform sind, hilft es, zunächst die Anleitung zum Eröffnen eines Tradovate-Kontos durchzugehen, damit Sie wissen, mit welcher E-Mail-Adresse und welchem Benutzernamen Sie sich registriert haben." },
    { type: "heading",text: "E-Mail erneut anfordern, Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Den Anmeldebildschirm öffnen", html: "Rufen Sie trader.tradovate.com auf oder öffnen Sie die Desktop- oder Mobil-App und gelangen Sie zur Anmeldeseite. Versuchen Sie noch nicht, sich anzumelden. Suchen Sie den kleinen Link <strong class='text-white'>Need help?</strong> direkt unterhalb der Felder für Benutzername und Passwort.", image: {"src":`${IMG}/tradovate-verification-email-1.png`,"alt":"Tradovate-Anmeldebildschirm mit dem Link Need help unterhalb der Anmeldefelder"} },
        { title: "Auf „Need Help?“ klicken", html: "Dieser Link öffnet die Seite zur Kontowiederherstellung. Hier sehen Sie zwei Wege: einen, um Ihren Benutzernamen abzurufen, und einen, um Ihr Passwort zurückzusetzen. Wenn Sie nicht ganz sicher sind, mit welcher E-Mail-Adresse oder welchem Benutzernamen Sie sich registriert haben, nutzen Sie zuerst <strong class='text-white'>Retrieve Username</strong>, damit die Zurücksetzung dort ankommt, wo Sie es erwarten.", image: {"src":`${IMG}/tradovate-verification-email-2.png`,"alt":"Tradovate-Seite zur Kontowiederherstellung mit den Optionen Retrieve Username und Reset Password"} },
        { title: "Forgot Password wählen und Ihre Angaben eingeben", html: "Wählen Sie <strong class='text-white'>Forgot Password</strong>, geben Sie dann den mit Ihrem Konto verknüpften Benutzernamen oder die E-Mail-Adresse ein und senden Sie das Formular ab. Eine frische E-Mail geht direkt an die bei Tradovate hinterlegte Adresse, und diese Nachricht dient zugleich als Ihre Bestätigung. Lieber eine Abkürzung? Das Formular für die Zurücksetzung finden Sie direkt unter trader.tradovate.com/changepwd/request.", image: {"src":`${IMG}/tradovate-verification-email-3.png`,"alt":"Tradovate-Formular Forgot Password mit einem Feld für Benutzername oder E-Mail-Adresse"} },
        { title: "E-Mail öffnen und bestätigen", html: "Gehen Sie in Ihren Posteingang, öffnen Sie die neue Nachricht und folgen Sie dem Link darin, um Ihr Passwort festzulegen und das Konto zu bestätigen. Danach sind Sie dauerhaft verifiziert. Von da an können Sie sich wie gewohnt bei Tradovate anmelden.", image: {"src":`${IMG}/tradovate-verification-email-4.png`,"alt":"Bestätigungs-E-Mail von Tradovate in einem Posteingang geöffnet, mit dem Bestätigungslink"} },
      ],
    },
    { type: "heading",text: "Sie erhalten die E-Mail weiterhin nicht?" },
    { type: "paragraph",html: "Wenn die Zurücksetzung durchgelaufen ist und nichts angekommen ist, gehen Sie diese Punkte durch, bevor Sie annehmen, dass etwas defekt ist:" },
    { type: "table", headers: ["Wo Sie nachsehen","Was Sie tun"], rows: [
      ["Spam-/Junk-Ordner","Automatische E-Mails werden ständig herausgefiltert. Durchsuchen Sie Ihr gesamtes Postfach nach dem Absender, nicht nur den Posteingang."],
      ["Falsche Adresse hinterlegt","Haben Sie sich bei der Registrierung bei der E-Mail-Adresse vertippt, erreicht Sie keine Zurücksetzung. Nutzen Sie Retrieve Username oder kontaktieren Sie den Support, um die Adresse zu korrigieren."],
      ["Zustellverzögerung","Es geht nicht immer sofort. Geben Sie ihr ein paar Minuten, statt zehn Zurücksetzungen hintereinander auszulösen, was die Zustellung sogar verlangsamen kann."],
      ["Blockierter Absender","Setzen Sie den Absender auf die Whitelist, damit künftige Konto-E-Mails, etwa Geräte-Freigaben und Alerts, sauber ankommen."],
    ] },
    { type: "paragraph",html: "Eines sollten Sie wissen: Tradovate fragt Sie niemals per E-Mail nach Ihrem Passwort. Tut es eine Nachricht doch, stammt sie nicht von dort. Diese Bestätigungs-E-Mail ist außerdem nicht die einzige E-Mail, die Ihren Zugang absichert. Die E-Mail zur 2FA-Geräte-Freigabe funktioniert genauso, daher lohnt es sich, auch diesen Absender auf der Whitelist zu halten." },
    { type: "heading",text: "Prop-Firm- oder Evaluierungskonto?" },
    { type: "paragraph",html: "Wenn Sie Ihren Tradovate-Zugang über eine Prop Firm oder ein Evaluierungsprogramm erhalten haben, kommen Ihre Zugangsdaten und eine etwaige Bestätigung in der Regel von dieser Firma, nicht direkt von Tradovate. Die genauen Regeln, Limits und Gebühren unterscheiden sich je nach Firma und Kontogröße, prüfen Sie daher die aktuellen Regeln Ihrer Firma. Passt der Standardablauf zur Zurücksetzung nicht zu Ihrem Setup, wenden Sie sich an den Support Ihrer Prop Firm statt an den von Tradovate." },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "Sobald Sie verifiziert und angemeldet sind, müssen Sie Ihre Einstiege nicht mehr beaufsichtigen. Automatisieren Sie Ihre TradingView-Strategien direkt in Tradovate, mit schneller, freihändiger Ausführung." },
  ], es: [
    { type: "paragraph",html: "Se registró, está listo para operar y el correo de verificación nunca apareció. O sí llegó, y lo borró antes de hacer clic en el enlace. De cualquier modo, está atascado, porque no hay un botón evidente de «reenviar» en todo el proceso de registro. Eso desconcierta a mucha gente. La solución es un pequeño truco: restablecer la contraseña. Eso fuerza el envío de un correo nuevo a la dirección registrada y vuelve a verificar su cuenta de una sola vez. Así se hace exactamente." },
    { type: "quote",html: "<strong class='text-white'>Respuesta rápida:</strong> En la pantalla de inicio de sesión, haga clic en <strong class='text-white'>Need help?</strong>, elija <strong class='text-white'>Forgot Password</strong> e introduzca su nombre de usuario o correo electrónico. Se envía un correo nuevo de inmediato. Revise su carpeta de spam si tarda en llegar." },
    { type: "heading",text: "Por qué no hay un botón de «reenviar»" },
    { type: "paragraph",html: "El correo de confirmación se envía una sola vez, en el registro. Si lo pierde o lo borra, no existe una forma específica de pedir otra copia. Restablecer la contraseña es la solución alternativa admitida, porque vuelve a emitir un correo a su dirección registrada. Ese mensaje cumple la misma función que el enlace de verificación original y le da acceso a la cuenta. Si es nuevo en la plataforma, conviene repasar primero cómo abrir una cuenta de Tradovate para saber con qué correo y nombre de usuario se registró." },
    { type: "heading",text: "Reenvíe el correo, paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra la pantalla de inicio de sesión", html: "Vaya a trader.tradovate.com, o abra la aplicación de escritorio o móvil, y llegue a la página de inicio de sesión. No intente iniciar sesión todavía. Busque el pequeño enlace <strong class='text-white'>Need help?</strong> justo debajo de los campos de usuario y contraseña.", image: {"src":`${IMG}/tradovate-verification-email-1.png`,"alt":"Pantalla de inicio de sesión de Tradovate con el enlace Need help debajo de los campos de acceso"} },
        { title: "Haga clic en «Need Help?»", html: "Ese enlace abre la página de recuperación de la cuenta. Verá dos caminos: uno para recuperar su nombre de usuario y otro para restablecer su contraseña. Si no está del todo seguro de con qué correo o nombre de usuario se registró, use primero <strong class='text-white'>Retrieve Username</strong> para que el restablecimiento llegue donde espera.", image: {"src":`${IMG}/tradovate-verification-email-2.png`,"alt":"Página de recuperación de cuenta de Tradovate con las opciones Retrieve Username y Reset Password"} },
        { title: "Elija Forgot Password e introduzca sus datos", html: "Elija <strong class='text-white'>Forgot Password</strong>, escriba el nombre de usuario o el correo asociado a su cuenta y envíelo. Un correo nuevo llega directamente a la dirección que Tradovate tiene registrada, y ese mensaje sirve también como su verificación. ¿Prefiere un atajo? El formulario de solicitud de restablecimiento está directamente en trader.tradovate.com/changepwd/request.", image: {"src":`${IMG}/tradovate-verification-email-3.png`,"alt":"Formulario Forgot Password de Tradovate con un campo para el nombre de usuario o la dirección de correo"} },
        { title: "Abra el correo y confirme", html: "Vaya a su bandeja de entrada, abra el mensaje nuevo y siga el enlace que contiene para establecer su contraseña y confirmar la cuenta. Una vez hecho, queda verificado de forma definitiva. A partir de ahí puede iniciar sesión en Tradovate como de costumbre.", image: {"src":`${IMG}/tradovate-verification-email-4.png`,"alt":"Correo de verificación de Tradovate abierto en una bandeja de entrada con el enlace de confirmación"} },
      ],
    },
    { type: "heading",text: "¿Sigue sin recibir el correo?" },
    { type: "paragraph",html: "Si el restablecimiento se ejecutó y no apareció nada, repase estos puntos antes de suponer que algo está roto:" },
    { type: "table", headers: ["Dónde mirar","Qué hacer"], rows: [
      ["Carpeta de spam / correo no deseado","Los correos automáticos se filtran constantemente. Busque el remitente en todo su buzón, no solo en la bandeja de entrada."],
      ["Dirección incorrecta registrada","Si se equivocó al escribir el correo en el registro, ningún restablecimiento le llegará. Use Retrieve Username o contacte con soporte para corregir la dirección."],
      ["Retraso en la entrega","No siempre es instantáneo. Dele unos minutos en lugar de lanzar diez restablecimientos seguidos, lo que de hecho puede ralentizar la entrega."],
      ["Remitente bloqueado","Añada el remitente a la lista de permitidos para que los correos futuros de la cuenta, como las aprobaciones de dispositivos y las alertas, lleguen sin problemas."],
    ] },
    { type: "paragraph",html: "Algo que conviene saber: Tradovate nunca le pedirá su contraseña por correo electrónico. Si un mensaje lo hace, no es de ellos. Este aviso de verificación tampoco es el único correo que condiciona su acceso. El correo de aprobación de dispositivos de 2FA funciona igual, así que conviene mantener también ese remitente en la lista de permitidos." },
    { type: "heading",text: "¿Cuenta de prop firm o de evaluación?" },
    { type: "paragraph",html: "Si obtuvo su acceso a Tradovate a través de una prop firm o un programa de evaluación, sus credenciales y cualquier verificación suelen provenir de esa empresa, no directamente de Tradovate. Las reglas exactas, los límites y las tarifas varían según la empresa y el tamaño de la cuenta, así que consulte las reglas vigentes de su empresa. Cuando el flujo de restablecimiento estándar no encaja con su configuración, acuda al soporte de su prop firm en lugar de al de Tradovate." },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Una vez verificado y con la sesión iniciada, deje de vigilar las entradas. Automatice sus estrategias de TradingView directamente en Tradovate con una ejecución rápida y sin intervención." },
  ], fr: [
    { type: "paragraph",html: "Vous vous êtes inscrit, vous êtes prêt à trader, et l'e-mail de vérification n'est jamais arrivé. Ou bien il est arrivé, et vous l'avez supprimé avant de cliquer sur le lien. Dans les deux cas, vous êtes bloqué, car il n'existe aucun bouton « renvoyer » évident dans le parcours d'inscription. Cela déroute beaucoup de monde. La solution tient à une petite astuce : lancer une réinitialisation du mot de passe. Cela provoque l'envoi d'un nouvel e-mail à l'adresse enregistrée et vérifie votre compte du même coup. Voici exactement comment procéder." },
    { type: "quote",html: "<strong class='text-white'>Réponse rapide :</strong> Sur l'écran de connexion, cliquez sur <strong class='text-white'>Need help?</strong>, choisissez <strong class='text-white'>Forgot Password</strong> et saisissez votre nom d'utilisateur ou votre adresse e-mail. Un nouvel e-mail est envoyé immédiatement. Consultez votre dossier de courrier indésirable s'il tarde à arriver." },
    { type: "heading",text: "Pourquoi il n'y a pas de bouton « renvoyer »" },
    { type: "paragraph",html: "L'e-mail de confirmation n'est envoyé qu'une seule fois, à l'inscription. Si vous le manquez ou le supprimez, il n'existe aucun moyen dédié d'en demander un autre exemplaire. La réinitialisation du mot de passe est le contournement pris en charge, car elle réémet un e-mail vers votre adresse enregistrée. Ce message remplit la même fonction que le lien de vérification d'origine et vous donne accès au compte. Si vous découvrez la plateforme, il est utile de parcourir d'abord l'ouverture d'un compte Tradovate afin de savoir avec quelle adresse e-mail et quel nom d'utilisateur vous vous êtes inscrit." },
    { type: "heading",text: "Renvoyer l'e-mail, étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez l'écran de connexion", html: "Rendez-vous sur trader.tradovate.com, ou ouvrez l'application de bureau ou mobile, et arrivez sur la page de connexion. N'essayez pas encore de vous connecter. Repérez le petit lien <strong class='text-white'>Need help?</strong> situé juste sous les champs du nom d'utilisateur et du mot de passe.", image: {"src":`${IMG}/tradovate-verification-email-1.png`,"alt":"Écran de connexion de Tradovate avec le lien Need help sous les champs de connexion"} },
        { title: "Cliquez sur « Need Help? »", html: "Ce lien ouvre la page de récupération du compte. Deux voies s'offrent à vous : l'une pour retrouver votre nom d'utilisateur, l'autre pour réinitialiser votre mot de passe. Si vous n'êtes pas tout à fait certain de l'adresse e-mail ou du nom d'utilisateur utilisé à l'inscription, commencez par <strong class='text-white'>Retrieve Username</strong> afin que la réinitialisation arrive là où vous l'attendez.", image: {"src":`${IMG}/tradovate-verification-email-2.png`,"alt":"Page de récupération de compte Tradovate affichant les options Retrieve Username et Reset Password"} },
        { title: "Choisissez Forgot Password et saisissez vos informations", html: "Choisissez <strong class='text-white'>Forgot Password</strong>, puis saisissez le nom d'utilisateur ou l'adresse e-mail associé à votre compte et validez. Un nouvel e-mail part directement vers l'adresse que Tradovate a en dossier, et ce message vaut aussi vérification. Vous préférez un raccourci ? Le formulaire de demande de réinitialisation se trouve directement à l'adresse trader.tradovate.com/changepwd/request.", image: {"src":`${IMG}/tradovate-verification-email-3.png`,"alt":"Formulaire Forgot Password de Tradovate avec un champ pour un nom d'utilisateur ou une adresse e-mail"} },
        { title: "Ouvrez l'e-mail et confirmez", html: "Allez dans votre boîte de réception, ouvrez le nouveau message et suivez le lien qu'il contient pour définir votre mot de passe et confirmer le compte. Une fois cela fait, vous êtes vérifié pour de bon. Vous pouvez ensuite vous connecter à Tradovate normalement.", image: {"src":`${IMG}/tradovate-verification-email-4.png`,"alt":"E-mail de vérification de Tradovate ouvert dans une boîte de réception avec le lien de confirmation"} },
      ],
    },
    { type: "heading",text: "Toujours pas d'e-mail ?" },
    { type: "paragraph",html: "Si la réinitialisation a été effectuée et que rien n'est arrivé, passez en revue ces points avant de supposer qu'il y a une panne :" },
    { type: "table", headers: ["Où regarder","Que faire"], rows: [
      ["Dossier spam / courrier indésirable","Les e-mails automatiques sont filtrés en permanence. Recherchez l'expéditeur dans toute votre messagerie, pas seulement dans la boîte de réception."],
