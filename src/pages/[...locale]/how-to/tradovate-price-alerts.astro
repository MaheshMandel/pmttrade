---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-price-alerts";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Create Price Alerts on Tradovate Charts & DOM";
const META_DESCRIPTION =
  "Tradovate price alerts made easy: set them from the bell icon or by clicking a price on the chart or DOM, and get notified before your level hits.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Preisalarme in Tradovate-Charts und im DOM erstellen", es: "Cree alertas de precio en los gráficos y el DOM de Tradovate", fr: "Créer des alertes de prix sur les graphiques et le DOM de Tradovate", it: "Creare avvisi di prezzo sui grafici e sul DOM di Tradovate" },
  dek: { en: "You can't sit and watch one price level all session, and you shouldn't have to. Here's how to set up Tradovate price alerts, step by step.", de: "Sie können nicht die ganze Session über ein einziges Preisniveau beobachten – und das sollten Sie auch nicht müssen. So richten Sie Tradovate-Preisalarme Schritt für Schritt ein.", es: "No puede pasarse toda la sesión vigilando un único nivel de precio, ni debería tener que hacerlo. Así se configuran, paso a paso, las alertas de precio de Tradovate.", fr: "Vous ne pouvez pas surveiller un seul niveau de prix pendant toute la séance, et vous ne devriez pas avoir à le faire. Voici comment configurer pas à pas les alertes de prix Tradovate.", it: "Non può restare a osservare un solo livello di prezzo per tutta la sessione, e non dovrebbe doverlo fare. Ecco come impostare passo dopo passo gli avvisi di prezzo di Tradovate." },
  readTime: { en: "4 min read", de: "4 Min. Lesezeit", es: "Lectura de 4 min", fr: "Lecture : 4 min", it: "Lettura di 4 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You can't sit and watch one price level all session, and you shouldn't have to. Whether you're tracking support and resistance, waiting to arm a manual entry, or wiring up automation like PickMyTrade, a price alert does the watching for you. Here's how to set them up in Tradovate, step by step." },
    { type: "heading", text: "What Is a Tradovate Price Alert?" },
    { type: "paragraph", html: "A price alert is a notification Tradovate fires the second a condition you set becomes true, usually an instrument's price crossing or touching a level you care about. Every alert has three moving parts: a <strong class='text-white'>price level</strong>, a <strong class='text-white'>condition</strong>, and a <strong class='text-white'>notification type</strong>. And you're not limited to raw price. You can trigger an alert off a position or account parameter instead, so a risk milestone pings you even when you're nowhere near the chart." },
    { type: "heading", text: "Creating Price Alerts in Tradovate: Step by Step" },
    {
      type: "steps",
      items: [
        { title: "Open the Alerts Menu", html: "In the Tradovate web app, click the bell-shaped <strong class='text-white'>Alerts</strong> icon in the top-left of the workspace, right next to the <strong class='text-white'>New +</strong> menu button. That opens the New Alert menu and gets you into your Alerts Log.", image: { src: `${IMG}/tradovate-price-alerts-1.png`, alt: "Tradovate workspace showing the bell-shaped Alerts icon next to the New plus menu" } },
        { title: "Choose What the Alert Watches", html: "Decide what the alert keys off: an <strong class='text-white'>Instrument</strong> price, a <strong class='text-white'>Position</strong> parameter, or an <strong class='text-white'>Account</strong> parameter. For an instrument- or position-based alert, search for the contract by symbol or keyword and select it, so Tradovate knows exactly what to monitor.", image: { src: `${IMG}/tradovate-price-alerts-2.png`, alt: "Tradovate New Alert menu showing instrument, position, and account trigger options" } },
        { title: "Set the Price, Condition, and Notification Type", html: "Type in the <strong class='text-white'>price level</strong>, then pick the <strong class='text-white'>condition</strong>, <em>Price Crosses</em> or <em>Price Touches</em>, for example. Choose how you want to hear about it: sound, popup, or both. Drop in an optional custom message so you'll recognize the alert the instant it fires, and save it.", image: { src: `${IMG}/tradovate-price-alerts-3.png`, alt: "Tradovate alert dialog with price level, condition, and notification type fields" } },
        { title: "Create an Alert Straight From the Chart or DOM", html: "You can skip the menu entirely. Click a price level on a chart, or on the DOM price ladder, and the alert dialog opens pre-filled with that price. Tweak the condition if you need to, save, and a bell marker drops onto the chart at your level so you can spot it at a glance.", image: { src: `${IMG}/tradovate-price-alerts-4.png`, alt: "Tradovate chart price axis with a price alert bell marker placed at a level" } },
        { title: "Manage Alerts in the Alerts Log", html: "Open the <strong class='text-white'>Alerts Log</strong> (the List of Alerts tab) and you'll see every alert in one place, Active, Triggered, and Disabled or expired. Hover over any one to <strong class='text-white'>Edit</strong>, <strong class='text-white'>Reset</strong> to re-arm it, <strong class='text-white'>Disable</strong>, or <strong class='text-white'>Delete</strong> it, so your list stays clean instead of piling up with stale levels.", image: { src: `${IMG}/tradovate-price-alerts-5.png`, alt: "Tradovate Alerts Log listing active and triggered alerts with edit and delete controls" } },
      ],
    },
    { type: "heading", text: "Why You'd Want This" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Watch support and resistance</strong> without babysitting the chart all day.",
        "<strong class='text-white'>Arm a manual entry</strong>, get pinged the second price hits your trigger so you can act on it.",
        "<strong class='text-white'>Track macro levels</strong> around news, session opens, or round numbers.",
        "<strong class='text-white'>Monitor a position or account parameter</strong> so risk milestones don't slip past you.",
        "<strong class='text-white'>Free up your focus</strong>, let the alert watch the ladder while you work other setups.",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "An alert tells you <em>when</em>, but you still have to click. <strong class='text-white'>PickMyTrade closes that gap by wiring your TradingView alerts straight to your Tradovate account</strong>. The moment a level triggers, your order goes in automatically. No manual clicks, no missed fills while you're away from the desk." },
  ], de: [
    { type: "paragraph",html: "Sie können nicht die ganze Session über ein einziges Preisniveau beobachten – und das sollten Sie auch nicht müssen. Ob Sie Unterstützungen und Widerstände verfolgen, auf den Moment für einen manuellen Einstieg warten oder eine Automatisierung wie PickMyTrade einrichten: Ein Preisalarm übernimmt das Beobachten für Sie. So richten Sie ihn in Tradovate Schritt für Schritt ein." },
    { type: "heading",text: "Was ist ein Tradovate-Preisalarm?" },
    { type: "paragraph",html: "Ein Preisalarm ist eine Benachrichtigung, die Tradovate in dem Moment auslöst, in dem eine von Ihnen festgelegte Bedingung eintritt, in der Regel wenn der Kurs eines Instruments ein für Sie wichtiges Niveau kreuzt oder berührt. Jeder Alarm besteht aus drei Bestandteilen: einem <strong class='text-white'>Preisniveau</strong>, einer <strong class='text-white'>Bedingung</strong> und einer <strong class='text-white'>Benachrichtigungsart</strong>. Und Sie sind nicht auf den reinen Kurs beschränkt. Sie können einen Alarm auch über einen Positions- oder Kontoparameter auslösen, sodass Sie ein Risikolimit gemeldet bekommen, selbst wenn Sie nicht in der Nähe des Charts sind." },
    { type: "heading",text: "Preisalarme in Tradovate erstellen: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Das Alerts-Menü öffnen", html: "Klicken Sie in der Tradovate-Web-App auf das glockenförmige Symbol <strong class='text-white'>Alerts</strong> oben links im Workspace, direkt neben der Menü-Schaltfläche <strong class='text-white'>New +</strong>. Dadurch öffnet sich das Menü „New Alert“, und Sie gelangen in Ihr Alerts Log.", image: {"src":`${IMG}/tradovate-price-alerts-1.png`,"alt":"Tradovate-Workspace mit dem glockenförmigen Alerts-Symbol neben dem Menü „New plus“"} },
        { title: "Festlegen, was der Alarm überwacht", html: "Entscheiden Sie, woran sich der Alarm orientiert: am Preis eines <strong class='text-white'>Instrument</strong>, an einem <strong class='text-white'>Position</strong>-Parameter oder an einem <strong class='text-white'>Account</strong>-Parameter. Suchen Sie bei einem instrumenten- oder positionsbasierten Alarm den Kontrakt per Symbol oder Stichwort und wählen Sie ihn aus, damit Tradovate genau weiß, was überwacht werden soll.", image: {"src":`${IMG}/tradovate-price-alerts-2.png`,"alt":"Tradovate-Menü „New Alert“ mit den Auslöseoptionen Instrument, Position und Account"} },
        { title: "Preis, Bedingung und Benachrichtigungsart festlegen", html: "Geben Sie das <strong class='text-white'>Preisniveau</strong> ein und wählen Sie dann die <strong class='text-white'>Bedingung</strong>, zum Beispiel <em>Price Crosses</em> oder <em>Price Touches</em>. Legen Sie fest, wie Sie benachrichtigt werden möchten: per Ton, Popup oder beidem. Fügen Sie optional eine eigene Nachricht hinzu, damit Sie den Alarm im Moment des Auslösens sofort erkennen, und speichern Sie ihn.", image: {"src":`${IMG}/tradovate-price-alerts-3.png`,"alt":"Tradovate-Alarmdialog mit den Feldern für Preisniveau, Bedingung und Benachrichtigungsart"} },
        { title: "Einen Alarm direkt aus dem Chart oder DOM erstellen", html: "Sie können das Menü ganz überspringen. Klicken Sie auf ein Preisniveau im Chart oder auf der DOM-Preisleiter, und der Alarmdialog öffnet sich mit dem vorausgefüllten Preis. Passen Sie bei Bedarf die Bedingung an, speichern Sie, und eine Glockenmarkierung erscheint im Chart auf Ihrem Niveau, sodass Sie es auf einen Blick erkennen.", image: {"src":`${IMG}/tradovate-price-alerts-4.png`,"alt":"Preisachse eines Tradovate-Charts mit einer Alarm-Glockenmarkierung auf einem Preisniveau"} },
        { title: "Alarme im Alerts Log verwalten", html: "Öffnen Sie das <strong class='text-white'>Alerts Log</strong> (den Tab „List of Alerts“), und Sie sehen alle Alarme an einem Ort: Active, Triggered sowie Disabled oder abgelaufen. Fahren Sie über einen Alarm, um ihn zu bearbeiten (<strong class='text-white'>Edit</strong>), per <strong class='text-white'>Reset</strong> erneut scharfzuschalten, zu deaktivieren (<strong class='text-white'>Disable</strong>) oder zu löschen (<strong class='text-white'>Delete</strong>), damit Ihre Liste übersichtlich bleibt und sich keine veralteten Niveaus ansammeln.", image: {"src":`${IMG}/tradovate-price-alerts-5.png`,"alt":"Tradovate Alerts Log mit aktiven und ausgelösten Alarmen sowie Bearbeiten- und Löschen-Steuerelementen"} },
      ],
    },
    { type: "heading",text: "Warum Sie das nutzen sollten" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Unterstützungen und Widerstände überwachen</strong>, ohne den ganzen Tag am Chart zu kleben.",
        "<strong class='text-white'>Einen manuellen Einstieg vorbereiten</strong>: Sie werden benachrichtigt, sobald der Kurs Ihr Trigger-Niveau erreicht, und können handeln.",
        "<strong class='text-white'>Makro-Niveaus verfolgen</strong> rund um Nachrichten, Session-Eröffnungen oder runde Zahlen.",
        "<strong class='text-white'>Eine Position oder einen Kontoparameter überwachen</strong>, damit Ihnen Risikomarken nicht entgehen.",
        "<strong class='text-white'>Konzentration freisetzen</strong>: Lassen Sie den Alarm die Preisleiter beobachten, während Sie andere Setups bearbeiten.",
      ],
    },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "Ein Alarm sagt Ihnen, <em>wann</em>, doch klicken müssen Sie trotzdem selbst. <strong class='text-white'>PickMyTrade schließt diese Lücke, indem es Ihre TradingView-Alarme direkt mit Ihrem Tradovate-Konto verbindet</strong>. Sobald ein Niveau ausgelöst wird, geht Ihre Order automatisch ein. Keine manuellen Klicks, keine verpassten Fills, während Sie nicht am Schreibtisch sind." },
  ], es: [
    { type: "paragraph",html: "No puede pasarse toda la sesión vigilando un único nivel de precio, ni debería tener que hacerlo. Ya sea que esté siguiendo soportes y resistencias, esperando el momento de preparar una entrada manual o configurando una automatización como PickMyTrade, una alerta de precio vigila por usted. Así se configuran en Tradovate, paso a paso." },
    { type: "heading",text: "¿Qué es una alerta de precio de Tradovate?" },
    { type: "paragraph",html: "Una alerta de precio es una notificación que Tradovate dispara en el instante en que se cumple una condición que usted ha definido, normalmente cuando el precio de un instrumento cruza o toca un nivel que le interesa. Toda alerta tiene tres componentes: un <strong class='text-white'>nivel de precio</strong>, una <strong class='text-white'>condición</strong> y un <strong class='text-white'>tipo de notificación</strong>. Y no está limitado al precio puro. También puede activar una alerta a partir de un parámetro de posición o de cuenta, de modo que un hito de riesgo le avise incluso cuando está lejos del gráfico." },
    { type: "heading",text: "Cómo crear alertas de precio en Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra el menú Alerts", html: "En la aplicación web de Tradovate, haga clic en el icono de campana <strong class='text-white'>Alerts</strong> en la parte superior izquierda del espacio de trabajo, justo al lado del botón de menú <strong class='text-white'>New +</strong>. Se abrirá el menú New Alert y accederá a su Alerts Log.", image: {"src":`${IMG}/tradovate-price-alerts-1.png`,"alt":"Espacio de trabajo de Tradovate con el icono de campana Alerts junto al menú New plus"} },
        { title: "Elija qué vigila la alerta", html: "Decida en qué se basa la alerta: el precio de un <strong class='text-white'>Instrument</strong>, un parámetro de <strong class='text-white'>Position</strong> o un parámetro de <strong class='text-white'>Account</strong>. Para una alerta basada en un instrumento o en una posición, busque el contrato por símbolo o palabra clave y selecciónelo, para que Tradovate sepa exactamente qué monitorizar.", image: {"src":`${IMG}/tradovate-price-alerts-2.png`,"alt":"Menú New Alert de Tradovate con las opciones de activación por instrumento, posición y cuenta"} },
        { title: "Defina el precio, la condición y el tipo de notificación", html: "Introduzca el <strong class='text-white'>nivel de precio</strong> y elija después la <strong class='text-white'>condición</strong>, por ejemplo <em>Price Crosses</em> o <em>Price Touches</em>. Elija cómo quiere recibir el aviso: sonido, ventana emergente o ambos. Añada un mensaje personalizado opcional para reconocer la alerta en cuanto se dispare y guárdela.", image: {"src":`${IMG}/tradovate-price-alerts-3.png`,"alt":"Cuadro de diálogo de alerta de Tradovate con los campos de nivel de precio, condición y tipo de notificación"} },
        { title: "Cree una alerta directamente desde el gráfico o el DOM", html: "Puede prescindir del menú por completo. Haga clic en un nivel de precio del gráfico, o de la escalera de precios del DOM, y el cuadro de diálogo de la alerta se abrirá con ese precio ya completado. Ajuste la condición si lo necesita, guarde, y aparecerá una campana en el gráfico en su nivel para que lo localice de un vistazo.", image: {"src":`${IMG}/tradovate-price-alerts-4.png`,"alt":"Eje de precios de un gráfico de Tradovate con una campana de alerta colocada en un nivel"} },
        { title: "Gestione las alertas en el Alerts Log", html: "Abra el <strong class='text-white'>Alerts Log</strong> (la pestaña List of Alerts) y verá todas las alertas en un solo lugar: Active, Triggered y Disabled o caducadas. Pase el cursor sobre cualquiera para <strong class='text-white'>Edit</strong> (editarla), <strong class='text-white'>Reset</strong> (volver a armarla), <strong class='text-white'>Disable</strong> (desactivarla) o <strong class='text-white'>Delete</strong> (eliminarla), y así su lista se mantiene limpia en lugar de llenarse de niveles obsoletos.", image: {"src":`${IMG}/tradovate-price-alerts-5.png`,"alt":"Alerts Log de Tradovate con alertas activas y disparadas y controles de edición y eliminación"} },
      ],
    },
    { type: "heading",text: "Por qué le conviene usarlas" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Vigile soportes y resistencias</strong> sin estar pendiente del gráfico todo el día.",
        "<strong class='text-white'>Prepare una entrada manual</strong>: reciba un aviso en el instante en que el precio alcance su nivel de activación para poder actuar.",
        "<strong class='text-white'>Siga niveles macro</strong> en torno a noticias, aperturas de sesión o números redondos.",
        "<strong class='text-white'>Monitorice un parámetro de posición o de cuenta</strong> para que los hitos de riesgo no se le pasen por alto.",
        "<strong class='text-white'>Libere su atención</strong>: deje que la alerta vigile la escalera mientras usted trabaja otras configuraciones.",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Una alerta le dice <em>cuándo</em>, pero usted aún tiene que hacer clic. <strong class='text-white'>PickMyTrade cierra esa brecha conectando sus alertas de TradingView directamente con su cuenta de Tradovate</strong>. En cuanto se activa un nivel, su orden se envía automáticamente. Sin clics manuales y sin ejecuciones perdidas mientras está lejos del escritorio." },
  ], fr: [
    { type: "paragraph",html: "Vous ne pouvez pas surveiller un seul niveau de prix pendant toute la séance, et vous ne devriez pas avoir à le faire. Que vous suiviez des supports et résistances, que vous attendiez le bon moment pour armer une entrée manuelle ou que vous mettiez en place une automatisation comme PickMyTrade, une alerte de prix surveille à votre place. Voici comment les configurer dans Tradovate, pas à pas." },
    { type: "heading",text: "Qu’est-ce qu’une alerte de prix Tradovate ?" },
    { type: "paragraph",html: "Une alerte de prix est une notification que Tradovate déclenche à l’instant où une condition que vous avez définie devient vraie, généralement lorsque le prix d’un instrument franchit ou touche un niveau qui vous intéresse. Chaque alerte repose sur trois éléments : un <strong class='text-white'>niveau de prix</strong>, une <strong class='text-white'>condition</strong> et un <strong class='text-white'>type de notification</strong>. Et vous n’êtes pas limité au prix brut. Vous pouvez aussi déclencher une alerte à partir d’un paramètre de position ou de compte, afin qu’un seuil de risque vous prévienne même lorsque vous êtes loin du graphique." },
    { type: "heading",text: "Créer des alertes de prix dans Tradovate : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir le menu Alerts", html: "Dans l’application web Tradovate, cliquez sur l’icône en forme de cloche <strong class='text-white'>Alerts</strong> en haut à gauche de l’espace de travail, juste à côté du bouton de menu <strong class='text-white'>New +</strong>. Cela ouvre le menu New Alert et vous donne accès à votre Alerts Log.", image: {"src":`${IMG}/tradovate-price-alerts-1.png`,"alt":"Espace de travail Tradovate avec l’icône en forme de cloche Alerts à côté du menu New plus"} },
        { title: "Choisir ce que l’alerte surveille", html: "Décidez de ce sur quoi repose l’alerte : le prix d’un <strong class='text-white'>Instrument</strong>, un paramètre de <strong class='text-white'>Position</strong> ou un paramètre de <strong class='text-white'>Account</strong>. Pour une alerte basée sur un instrument ou une position, recherchez le contrat par symbole ou mot-clé et sélectionnez-le, afin que Tradovate sache exactement quoi surveiller.", image: {"src":`${IMG}/tradovate-price-alerts-2.png`,"alt":"Menu New Alert de Tradovate affichant les options de déclenchement par instrument, position et compte"} },
        { title: "Définir le prix, la condition et le type de notification", html: "Saisissez le <strong class='text-white'>niveau de prix</strong>, puis choisissez la <strong class='text-white'>condition</strong>, par exemple <em>Price Crosses</em> ou <em>Price Touches</em>. Choisissez comment vous souhaitez être averti : son, fenêtre contextuelle, ou les deux. Ajoutez au besoin un message personnalisé pour reconnaître l’alerte dès qu’elle se déclenche, puis enregistrez-la.", image: {"src":`${IMG}/tradovate-price-alerts-3.png`,"alt":"Boîte de dialogue d’alerte Tradovate avec les champs niveau de prix, condition et type de notification"} },
        { title: "Créer une alerte directement depuis le graphique ou le DOM", html: "Vous pouvez vous passer complètement du menu. Cliquez sur un niveau de prix du graphique, ou de l’échelle de prix du DOM, et la boîte de dialogue d’alerte s’ouvre avec ce prix prérempli. Ajustez la condition si nécessaire, enregistrez, et un repère en forme de cloche apparaît sur le graphique à votre niveau pour le repérer d’un coup d’œil.", image: {"src":`${IMG}/tradovate-price-alerts-4.png`,"alt":"Axe des prix d’un graphique Tradovate avec un repère de cloche d’alerte placé sur un niveau"} },
        { title: "Gérer les alertes dans l’Alerts Log", html: "Ouvrez l’<strong class='text-white'>Alerts Log</strong> (l’onglet List of Alerts) et vous verrez toutes vos alertes au même endroit : Active, Triggered, et Disabled ou expirées. Survolez-en une pour <strong class='text-white'>Edit</strong> (la modifier), <strong class='text-white'>Reset</strong> (la réarmer), <strong class='text-white'>Disable</strong> (la désactiver) ou <strong class='text-white'>Delete</strong> (la supprimer), afin que votre liste reste propre au lieu de s’encombrer de niveaux périmés.", image: {"src":`${IMG}/tradovate-price-alerts-5.png`,"alt":"Alerts Log de Tradovate listant les alertes actives et déclenchées avec les commandes de modification et de suppression"} },
      ],
    },
    { type: "heading",text: "Pourquoi les utiliser" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Surveillez supports et résistances</strong> sans rester collé au graphique toute la journée.",
        "<strong class='text-white'>Armez une entrée manuelle</strong> : soyez averti à la seconde où le prix atteint votre déclencheur pour pouvoir agir.",
        "<strong class='text-white'>Suivez les niveaux macro</strong> autour des annonces, des ouvertures de séance ou des chiffres ronds.",
        "<strong class='text-white'>Surveillez un paramètre de position ou de compte</strong> pour que les seuils de risque ne vous échappent pas.",
        "<strong class='text-white'>Libérez votre attention</strong> : laissez l’alerte surveiller l’échelle pendant que vous travaillez d’autres configurations.",
      ],
    },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Une alerte vous dit <em>quand</em>, mais vous devez encore cliquer. <strong class='text-white'>PickMyTrade comble cet écart en reliant vos alertes TradingView directement à votre compte Tradovate</strong>. Dès qu’un niveau est atteint, votre ordre est envoyé automatiquement. Aucun clic manuel, aucune exécution manquée pendant que vous êtes loin de votre bureau." },
  ], it: [
    { type: "paragraph",html: "Non può restare a osservare un solo livello di prezzo per tutta la sessione, e non dovrebbe doverlo fare. Che stia seguendo supporti e resistenze, aspettando il momento di preparare un’entrata manuale o configurando un’automazione come PickMyTrade, un avviso di prezzo controlla al posto suo. Ecco come impostarli in Tradovate, passo dopo passo." },
    { type: "heading",text: "Che cos’è un avviso di prezzo di Tradovate?" },
    { type: "paragraph",html: "Un avviso di prezzo è una notifica che Tradovate invia nell’istante in cui una condizione da lei impostata diventa vera, di solito quando il prezzo di uno strumento incrocia o tocca un livello che le interessa. Ogni avviso ha tre componenti: un <strong class='text-white'>livello di prezzo</strong>, una <strong class='text-white'>condizione</strong> e un <strong class='text-white'>tipo di notifica</strong>. E non è limitato al solo prezzo. Può far scattare un avviso anche da un parametro di posizione o di conto, così un traguardo di rischio la avvisa anche quando è lontano dal grafico." },
    { type: "heading",text: "Creare avvisi di prezzo in Tradovate: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Aprire il menu Alerts", html: "Nell’app web di Tradovate, clicchi sull’icona a forma di campana <strong class='text-white'>Alerts</strong> in alto a sinistra nell’area di lavoro, accanto al pulsante di menu <strong class='text-white'>New +</strong>. Si apre il menu New Alert e accede al suo Alerts Log.", image: {"src":`${IMG}/tradovate-price-alerts-1.png`,"alt":"Area di lavoro di Tradovate con l’icona a campana Alerts accanto al menu New plus"} },
        { title: "Scegliere cosa monitora l’avviso", html: "Decida su cosa si basa l’avviso: il prezzo di un <strong class='text-white'>Instrument</strong>, un parametro di <strong class='text-white'>Position</strong> o un parametro di <strong class='text-white'>Account</strong>. Per un avviso basato su strumento o posizione, cerchi il contratto per simbolo o parola chiave e lo selezioni, in modo che Tradovate sappia esattamente cosa monitorare.", image: {"src":`${IMG}/tradovate-price-alerts-2.png`,"alt":"Menu New Alert di Tradovate con le opzioni di attivazione per strumento, posizione e conto"} },
        { title: "Impostare prezzo, condizione e tipo di notifica", html: "Inserisca il <strong class='text-white'>livello di prezzo</strong>, quindi scelga la <strong class='text-white'>condizione</strong>, per esempio <em>Price Crosses</em> o <em>Price Touches</em>. Scelga come vuole essere avvisato: suono, popup o entrambi. Aggiunga un messaggio personalizzato facoltativo per riconoscere l’avviso nel momento in cui scatta e lo salvi.", image: {"src":`${IMG}/tradovate-price-alerts-3.png`,"alt":"Finestra dell’avviso di Tradovate con i campi livello di prezzo, condizione e tipo di notifica"} },
        { title: "Creare un avviso direttamente dal grafico o dal DOM", html: "Può saltare del tutto il menu. Clicchi su un livello di prezzo sul grafico, o sulla scala dei prezzi del DOM, e la finestra dell’avviso si apre con quel prezzo già inserito. Modifichi la condizione se necessario, salvi, e sul grafico compare un segnalino a campana al suo livello, così lo individua a colpo d’occhio.", image: {"src":`${IMG}/tradovate-price-alerts-4.png`,"alt":"Asse dei prezzi di un grafico Tradovate con un segnalino a campana dell’avviso posto su un livello"} },
        { title: "Gestire gli avvisi nell’Alerts Log", html: "Apra l’<strong class='text-white'>Alerts Log</strong> (la scheda List of Alerts) e vedrà tutti gli avvisi in un unico posto: Active, Triggered e Disabled o scaduti. Passi il mouse su uno qualsiasi per <strong class='text-white'>Edit</strong> (modificarlo), <strong class='text-white'>Reset</strong> (riarmarlo), <strong class='text-white'>Disable</strong> (disattivarlo) o <strong class='text-white'>Delete</strong> (eliminarlo), così l’elenco resta in ordine invece di riempirsi di livelli obsoleti.", image: {"src":`${IMG}/tradovate-price-alerts-5.png`,"alt":"Alerts Log di Tradovate con avvisi attivi e scattati e controlli di modifica ed eliminazione"} },
      ],
    },
    { type: "heading",text: "Perché le conviene usarli" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Monitori supporti e resistenze</strong> senza stare incollato al grafico tutto il giorno.",
        "<strong class='text-white'>Prepari un’entrata manuale</strong>: venga avvisato nell’istante in cui il prezzo raggiunge il suo livello di attivazione, così può agire.",
        "<strong class='text-white'>Segua i livelli macro</strong> attorno a notizie, aperture di sessione o numeri tondi.",
        "<strong class='text-white'>Monitori un parametro di posizione o di conto</strong> perché i traguardi di rischio non le sfuggano.",
        "<strong class='text-white'>Liberi la sua attenzione</strong>: lasci che sia l’avviso a sorvegliare la scala mentre lei lavora su altri setup.",
      ],
    },
    { type: "heading",text: "Automatizzi tutto questo con PickMyTrade" },
    { type: "paragraph",html: "Un avviso le dice <em>quando</em>, ma deve comunque cliccare lei. <strong class='text-white'>PickMyTrade colma questo divario collegando i suoi avvisi di TradingView direttamente al suo conto Tradovate</strong>. Nel momento in cui un livello viene raggiunto, il suo ordine parte automaticamente. Nessun clic manuale, nessuna esecuzione persa mentre è lontano dalla scrivania." },
  ] },
  ctaHeading: { en: "Turn Alerts Into Automatic Orders", de: "Machen Sie aus Alarmen automatische Orders", es: "Convierta las alertas en órdenes automáticas", fr: "Transformez vos alertes en ordres automatiques", it: "Trasformi gli avvisi in ordini automatici" },
  ctaText: { en: "PickMyTrade wires your TradingView alerts straight to your Tradovate account, so the moment a level triggers, your order goes in automatically.", de: "PickMyTrade verbindet Ihre TradingView-Alarme direkt mit Ihrem Tradovate-Konto, sodass Ihre Order automatisch platziert wird, sobald ein Niveau ausgelöst wird.", es: "PickMyTrade conecta sus alertas de TradingView directamente con su cuenta de Tradovate, de modo que en cuanto se active un nivel, su orden se envía automáticamente.", fr: "PickMyTrade relie vos alertes TradingView directement à votre compte Tradovate : dès qu’un niveau est atteint, votre ordre est envoyé automatiquement.", it: "PickMyTrade collega i suoi avvisi di TradingView direttamente al suo conto Tradovate, così, nel momento in cui un livello viene raggiunto, il suo ordine parte automaticamente." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Can I create a Tradovate price alert by clicking on the chart or DOM?", a: "Yes. Click the price level on a chart or the DOM price ladder and Tradovate opens the alert dialog pre-filled with that price. If the dialog doesn't open on your first click, check the exact interaction in your current build, chart versions can differ slightly." },
    { q: "What notification types do Tradovate price alerts support?", a: "When you build an alert you can pick sound, popup, or both. Once it fires, your browser plays a sound, the bell-shaped Alerts icon shows a red notification dot, and any custom message appears in a small flag beneath the bell." },
    { q: "How do I edit or delete a Tradovate alert?", a: "Open the Alerts Log (the List of Alerts tab) and hover over the alert you want to change. From there you can Edit, Reset, Disable, or Delete it without rebuilding it from scratch." },
  ], de: [
    { q: "Kann ich einen Tradovate-Preisalarm per Klick auf den Chart oder das DOM erstellen?", a: "Ja. Klicken Sie auf ein Preisniveau im Chart oder auf der DOM-Preisleiter, und Tradovate öffnet den Alarmdialog mit dem vorausgefüllten Preis. Öffnet sich der Dialog beim ersten Klick nicht, prüfen Sie die genaue Bedienung in Ihrer aktuellen Version; die Chart-Versionen können sich leicht unterscheiden." },
    { q: "Welche Benachrichtigungsarten unterstützen Tradovate-Preisalarme?", a: "Beim Erstellen eines Alarms können Sie Ton, Popup oder beides wählen. Sobald er ausgelöst wird, spielt Ihr Browser einen Ton ab, das glockenförmige Alerts-Symbol zeigt einen roten Benachrichtigungspunkt, und eine eigene Nachricht erscheint in einem kleinen Fähnchen unter der Glocke." },
    { q: "Wie bearbeite oder lösche ich einen Tradovate-Alarm?", a: "Öffnen Sie das Alerts Log (den Tab „List of Alerts“) und fahren Sie mit der Maus über den gewünschten Alarm. Dort können Sie ihn bearbeiten (Edit), zurücksetzen (Reset), deaktivieren (Disable) oder löschen (Delete), ohne ihn neu aufbauen zu müssen." },
  ], es: [
    { q: "¿Puedo crear una alerta de precio en Tradovate haciendo clic en el gráfico o en el DOM?", a: "Sí. Haga clic en un nivel de precio del gráfico o de la escalera de precios del DOM y Tradovate abrirá el cuadro de diálogo de la alerta con ese precio ya completado. Si el cuadro no se abre con el primer clic, compruebe la interacción exacta en su versión actual; las versiones del gráfico pueden diferir ligeramente." },
    { q: "¿Qué tipos de notificación admiten las alertas de precio de Tradovate?", a: "Al crear una alerta puede elegir sonido, ventana emergente o ambos. Cuando se dispara, su navegador reproduce un sonido, el icono de campana Alerts muestra un punto rojo de notificación y cualquier mensaje personalizado aparece en una pequeña bandera bajo la campana." },
    { q: "¿Cómo edito o elimino una alerta de Tradovate?", a: "Abra el Alerts Log (la pestaña List of Alerts) y pase el cursor sobre la alerta que desea cambiar. Desde ahí puede editarla (Edit), restablecerla (Reset), desactivarla (Disable) o eliminarla (Delete) sin tener que crearla de nuevo." },
  ], fr: [
    { q: "Puis-je créer une alerte de prix Tradovate en cliquant sur le graphique ou le DOM ?", a: "Oui. Cliquez sur un niveau de prix du graphique ou de l’échelle de prix du DOM, et Tradovate ouvre la boîte de dialogue d’alerte avec ce prix prérempli. Si la boîte de dialogue ne s’ouvre pas au premier clic, vérifiez l’interaction exacte dans votre version actuelle ; les versions du graphique peuvent différer légèrement." },
    { q: "Quels types de notification les alertes de prix Tradovate prennent-elles en charge ?", a: "Lors de la création d’une alerte, vous pouvez choisir un son, une fenêtre contextuelle, ou les deux. Une fois l’alerte déclenchée, votre navigateur émet un son, l’icône en forme de cloche Alerts affiche un point de notification rouge, et tout message personnalisé apparaît dans un petit fanion sous la cloche." },
    { q: "Comment modifier ou supprimer une alerte Tradovate ?", a: "Ouvrez l’Alerts Log (l’onglet List of Alerts) et survolez l’alerte à modifier. Vous pouvez alors la modifier (Edit), la réinitialiser (Reset), la désactiver (Disable) ou la supprimer (Delete) sans avoir à la recréer." },
  ], it: [
    { q: "Posso creare un avviso di prezzo Tradovate cliccando sul grafico o sul DOM?", a: "Sì. Clicchi su un livello di prezzo sul grafico o sulla scala dei prezzi del DOM e Tradovate apre la finestra dell’avviso con quel prezzo già inserito. Se la finestra non si apre al primo clic, verifichi l’interazione esatta nella sua versione attuale; le versioni del grafico possono differire leggermente." },
    { q: "Quali tipi di notifica supportano gli avvisi di prezzo di Tradovate?", a: "Quando crea un avviso può scegliere suono, popup o entrambi. Quando scatta, il suo browser riproduce un suono, l’icona a forma di campana Alerts mostra un puntino rosso di notifica e l’eventuale messaggio personalizzato appare in una piccola bandierina sotto la campana." },
    { q: "Come modifico o elimino un avviso di Tradovate?", a: "Apra l’Alerts Log (la scheda List of Alerts) e passi il mouse sull’avviso da modificare. Da lì può modificarlo (Edit), reimpostarlo (Reset), disattivarlo (Disable) o eliminarlo (Delete) senza doverlo ricreare da zero." },
  ] },
  relatedHeading: { en: "Related Guides", de: "Verwandte Leitfäden", es: "Guías relacionadas", fr: "Guides associés", it: "Guide correlate" },
  disclosureText: { en: `This guide is for educational and informational purposes only and is not financial, investment, or trading advice. Trading futures and other leveraged products carries a substantial risk of loss and is not suitable for every investor. PickMyTrade is an independent third-party automation platform and is not affiliated with, endorsed by, or sponsored by Tradovate, Inc. "Tradovate" and all related names, logos, and trademarks are the property of their respective owners. Platform features and steps change over time, so always confirm the current process in the official Tradovate platform and documentation before acting.`, de: "Dieser Leitfaden dient ausschließlich Bildungs- und Informationszwecken und stellt keine Finanz-, Anlage- oder Handelsberatung dar. Der Handel mit Futures und anderen gehebelten Produkten birgt ein erhebliches Verlustrisiko und ist nicht für jeden Anleger geeignet. PickMyTrade ist eine unabhängige Automatisierungsplattform eines Drittanbieters und steht in keiner Verbindung zu Tradovate, Inc., wird von dieser weder unterstützt noch gesponsert. „Tradovate“ und alle zugehörigen Namen, Logos und Marken sind Eigentum ihrer jeweiligen Inhaber. Funktionen und Schritte der Plattform ändern sich im Laufe der Zeit; bestätigen Sie daher vor jeder Handlung stets den aktuellen Ablauf in der offiziellen Tradovate-Plattform und -Dokumentation.", es: "Esta guía tiene fines exclusivamente educativos e informativos y no constituye asesoramiento financiero, de inversión ni de trading. Operar con futuros y otros productos apalancados conlleva un riesgo sustancial de pérdida y no es adecuado para todos los inversores. PickMyTrade es una plataforma de automatización independiente de terceros y no está afiliada, respaldada ni patrocinada por Tradovate, Inc. «Tradovate» y todos los nombres, logotipos y marcas relacionados son propiedad de sus respectivos titulares. Las funciones y los pasos de la plataforma cambian con el tiempo, así que confirme siempre el proceso vigente en la plataforma y la documentación oficiales de Tradovate antes de actuar.", fr: "Ce guide est fourni à des fins strictement éducatives et informatives et ne constitue pas un conseil financier, d’investissement ou de trading. Le trading de contrats à terme et d’autres produits à effet de levier comporte un risque de perte important et ne convient pas à tous les investisseurs. PickMyTrade est une plateforme d’automatisation tierce indépendante et n’est ni affiliée à Tradovate, Inc., ni approuvée ou parrainée par celle-ci. « Tradovate » ainsi que tous les noms, logos et marques associés sont la propriété de leurs détenteurs respectifs. Les fonctionnalités et les étapes de la plateforme évoluent avec le temps ; vérifiez donc toujours la procédure en vigueur dans la plateforme et la documentation officielles de Tradovate avant d’agir.", it: "Questa guida ha esclusivamente scopo educativo e informativo e non costituisce consulenza finanziaria, di investimento o di trading. Il trading di futures e di altri prodotti a leva comporta un rischio di perdita significativo e non è adatto a tutti gli investitori. PickMyTrade è una piattaforma di automazione indipendente di terze parti e non è affiliata a Tradovate, Inc., né approvata o sponsorizzata da essa. “Tradovate” e tutti i nomi, loghi e marchi correlati sono di proprietà dei rispettivi titolari. Le funzionalità e i passaggi della piattaforma cambiano nel tempo, perciò verifichi sempre la procedura attuale nella piattaforma e nella documentazione ufficiali di Tradovate prima di agire." },
};
const data: GuideArticleData = resolveGuideContent(content, locale, related);

