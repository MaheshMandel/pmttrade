---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-multi-chart-layout";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Build a Multi-Chart Layout in Tradovate";
const META_DESCRIPTION =
  "Open several Tradovate charts in one window, arrange them into a grid, link symbols, sync crosshairs, and save the setup as a reusable workspace.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Multi-Chart-Layout in Tradovate erstellen", es: "Cree un diseño de varios gráficos en Tradovate", fr: "Créer une disposition multi-graphiques dans Tradovate", it: "Creare un layout multi-grafico in Tradovate" },
  dek: { en: "Running one chart at a time works fine until you're trying to read a 5-minute setup against the 1-hour trend and the daily level all at once. Here's how to put every timeframe you care about in a single window.", de: "Ein einzelnes Chart funktioniert gut, bis Sie ein 5-Minuten-Setup gegen den 1-Stunden-Trend und das Tagesniveau gleichzeitig lesen wollen. So bringen Sie jeden Zeitrahmen, der Ihnen wichtig ist, in ein einziges Fenster.", es: "Trabajar con un solo gráfico a la vez funciona bien hasta que necesita leer una configuración de 5 minutos frente a la tendencia de 1 hora y el nivel diario al mismo tiempo. Así se colocan todos los marcos temporales que le interesan en una sola ventana.", fr: "Travailler avec un seul graphique à la fois fonctionne bien, jusqu'au moment où vous voulez lire un setup en 5 minutes face à la tendance en 1 heure et au niveau journalier en même temps. Voici comment réunir toutes les unités de temps qui comptent pour vous dans une seule fenêtre.", it: "Lavorare con un solo grafico alla volta va bene finché non deve leggere un setup a 5 minuti rispetto al trend a 1 ora e al livello giornaliero tutto insieme. Ecco come portare ogni timeframe che le interessa in un'unica finestra." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Running one chart at a time works fine until you're trying to read a 5-minute setup against the 1-hour trend and the daily level all at once. A multi-chart layout puts every timeframe you care about in a single window, so you stop flipping tabs and start seeing the whole picture. Here's how to build one, tie the panes together, and save it so it's waiting for you next session." },
    { type: "heading", text: "Build a Multi-Chart Layout in Tradovate: Step by Step" },
    {
      type: "steps",
      items: [
        { title: "Open Your First Chart Module", html: "Start from a blank or an existing workspace. Click the <strong class='text-white'>New (+)</strong> button in the top-left corner of the web app and drag a <strong class='text-white'>Chart</strong> module onto the screen. It'll fill the available space to begin with, and that's fine, you'll carve it up in a moment. Two other ways to drop in a chart: type a symbol into the search bar at the top of the page, or right-click an instrument inside a Market Analyzer module.", image: { src: `${IMG}/tradovate-multi-chart-layout-1.png`, alt: "Tradovate web app with the New (+) button highlighted and a Chart module being dragged onto a blank workspace" } },
        { title: "Add More Charts to the Same Window", html: "To get a second pane, right-click inside the chart you just opened and choose <strong class='text-white'>Add Chart</strong>, or head back to the <strong class='text-white'>New (+)</strong> menu and drag in another Chart module. Repeat for however many panes you want. Four is a common choice for a top-down view, say daily, 1-hour, 15-minute, and 5-minute, but there's no hard rule. Add them all first, then worry about placement.", image: { src: `${IMG}/tradovate-multi-chart-layout-2.png`, alt: "Tradovate chart right-click menu showing the Add Chart option to insert a second chart pane" } },
        { title: "Drag the Borders to Build Your Grid", html: "Every module in Tradovate is resizable. Hover over the border between two charts until the cursor changes, then click and drag to split the space. Vertical borders set the left/right width, horizontal borders set the top/bottom height. Push and pull those edges until you've got the grid you want, whether that's a clean two-by-two, or one big chart with a couple of small ones stacked beside it. If you'd rather stack panes than tile them, you can group modules into tabs and click between them.", image: { src: `${IMG}/tradovate-multi-chart-layout-3.png`, alt: "Four Tradovate chart panes arranged in a two-by-two grid with a border being dragged to resize them" } },
        { title: "Set a Symbol and Interval on Each Pane", html: "Click into each chart and set its instrument in the chart's search bar, then pick the timeframe from the <strong class='text-white'>Chart Interval</strong> control. This is where the layout earns its keep: put the same symbol on four different intervals for a top-down read, or four different instruments if you're watching a basket.", image: { src: `${IMG}/tradovate-multi-chart-layout-4.png`, alt: "Tradovate chart pane with the symbol search bar and Chart Interval control highlighted for setting timeframe" } },
        { title: "Link Charts and Sync the Crosshair", html: "Tradovate can tie your panes together so they move as a set. The color-coded dot next to the Chart Interval links charts by instrument, so put two charts on the same color and changing the symbol on one changes it on the others. To line up your cursor across panes, turn on the <strong class='text-white'>Global Crosshair</strong> setting on each chart, so hovering over a candle on one timeframe marks the same moment on the rest. Leave both off if you'd rather each pane stay independent. Adding studies? Set them per chart, since each module keeps its own indicators.", image: { src: `${IMG}/tradovate-multi-chart-layout-5.png`, alt: "Tradovate charts linked by a color-coded instrument dot with the Global Crosshair setting enabled across panes" } },
        { title: "Save the Layout as a Workspace", html: "Once the grid looks right, save it so you're not rebuilding it every morning. Open the <strong class='text-white'>New (+) / Workspaces</strong> menu, give the layout a name in the template-name field, and save. The active workspace name shows up in your browser tab, and you can switch between saved layouts from that same menu. If you trade directly from your charts, your order buttons and drawings save right along with the layout.", image: { src: `${IMG}/tradovate-multi-chart-layout-6.png`, alt: "Tradovate Workspaces menu with a name entered in the template field to save the multi-chart layout" } },
      ],
    },
    { type: "heading", text: "A Few Things Worth Knowing" },
    { type: "table", headers: ["What you see", "What's going on"], rows: [
      ["Every chart changed symbol at once", "Those panes share the same color link. Give them different color dots (or none) to keep symbols independent."],
      ["Crosshair only moves on one chart", "Global Crosshair is a per-module setting. Turn it on for each pane you want linked."],
      ["Layout vanished after you logged out", "You didn't save it. Save the grid as a named workspace so it reloads next session."],
    ] },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Once your charts are dialed in, the manual part, actually firing orders across all those panes, is where mistakes creep in. <strong class='text-white'>PickMyTrade automates your Tradovate execution</strong> straight from TradingView alerts, so your strategy triggers while you read the setup instead of racing the mouse." },
  ], de: [
    { type: "paragraph",html: "Immer nur ein Chart gleichzeitig zu betrachten funktioniert gut, bis Sie ein 5-Minuten-Setup gegen den 1-Stunden-Trend und das Tagesniveau auf einmal lesen wollen. Ein Multi-Chart-Layout bringt jeden Zeitrahmen, der Ihnen wichtig ist, in ein einziges Fenster, sodass Sie nicht mehr zwischen Tabs wechseln, sondern das ganze Bild sehen. So bauen Sie eines auf, verbinden die Fenster miteinander und speichern es, damit es in der nächsten Sitzung bereitsteht." },
    { type: "heading",text: "Multi-Chart-Layout in Tradovate erstellen: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Ersten Chart-Baustein öffnen", html: "Beginnen Sie mit einem leeren oder bestehenden Workspace. Klicken Sie oben links in der Web-App auf die Schaltfläche <strong class='text-white'>New (+)</strong> und ziehen Sie ein <strong class='text-white'>Chart</strong>-Modul auf den Bildschirm. Es füllt zunächst den gesamten verfügbaren Platz aus, und das ist in Ordnung, Sie unterteilen es gleich. Zwei weitere Wege, ein Chart einzufügen: Geben Sie ein Symbol in die Suchleiste oben auf der Seite ein, oder klicken Sie mit der rechten Maustaste auf ein Instrument in einem Market-Analyzer-Modul.", image: {"src":`${IMG}/tradovate-multi-chart-layout-1.png`,"alt":"Tradovate-Web-App mit hervorgehobener Schaltfläche New (+) und einem Chart-Modul, das auf einen leeren Workspace gezogen wird"} },
        { title: "Weitere Charts im selben Fenster hinzufügen", html: "Für ein zweites Fenster klicken Sie mit der rechten Maustaste in das gerade geöffnete Chart und wählen <strong class='text-white'>Add Chart</strong>, oder Sie gehen zurück zum Menü <strong class='text-white'>New (+)</strong> und ziehen ein weiteres Chart-Modul hinein. Wiederholen Sie das für so viele Fenster, wie Sie möchten. Vier sind eine gängige Wahl für eine Top-down-Ansicht, etwa Tages-, 1-Stunden-, 15-Minuten- und 5-Minuten-Chart, aber es gibt keine feste Regel. Fügen Sie zuerst alle hinzu und kümmern Sie sich danach um die Anordnung.", image: {"src":`${IMG}/tradovate-multi-chart-layout-2.png`,"alt":"Rechtsklick-Menü eines Tradovate-Charts mit der Option Add Chart zum Einfügen eines zweiten Chart-Fensters"} },
        { title: "Ränder ziehen, um Ihr Raster zu bauen", html: "Jedes Modul in Tradovate lässt sich in der Größe ändern. Fahren Sie mit der Maus über den Rand zwischen zwei Charts, bis sich der Cursor ändert, und klicken und ziehen Sie dann, um den Platz aufzuteilen. Vertikale Ränder bestimmen die Breite links/rechts, horizontale Ränder die Höhe oben/unten. Schieben und ziehen Sie die Kanten, bis Sie das gewünschte Raster haben, sei es ein sauberes Zwei-mal-zwei oder ein großes Chart mit ein paar kleinen daneben. Wenn Sie die Fenster lieber stapeln als nebeneinander anordnen, können Sie Module zu Tabs gruppieren und zwischen ihnen wechseln.", image: {"src":`${IMG}/tradovate-multi-chart-layout-3.png`,"alt":"Vier Tradovate-Chart-Fenster in einem Zwei-mal-zwei-Raster, wobei ein Rand zur Größenänderung gezogen wird"} },
        { title: "Symbol und Intervall für jedes Fenster festlegen", html: "Klicken Sie in jedes Chart und legen Sie das Instrument in der Suchleiste des Charts fest. Wählen Sie dann den Zeitrahmen über das Steuerelement <strong class='text-white'>Chart Interval</strong>. Hier zahlt sich das Layout aus: Legen Sie dasselbe Symbol auf vier verschiedene Intervalle für eine Top-down-Analyse, oder vier verschiedene Instrumente, wenn Sie einen Korb beobachten.", image: {"src":`${IMG}/tradovate-multi-chart-layout-4.png`,"alt":"Tradovate-Chart-Fenster mit hervorgehobener Symbolsuche und hervorgehobenem Chart-Interval-Steuerelement zur Einstellung des Zeitrahmens"} },
        { title: "Charts verknüpfen und das Fadenkreuz synchronisieren", html: "Tradovate kann Ihre Fenster miteinander verbinden, sodass sie sich als Gruppe bewegen. Der farbcodierte Punkt neben Chart Interval verknüpft Charts nach Instrument: Legen Sie zwei Charts auf dieselbe Farbe, und ein Symbolwechsel in einem Chart ändert es auch in den anderen. Um Ihren Cursor über die Fenster hinweg auszurichten, aktivieren Sie in jedem Chart die Einstellung <strong class='text-white'>Global Crosshair</strong>, sodass das Überfahren einer Kerze in einem Zeitrahmen denselben Zeitpunkt in allen anderen markiert. Lassen Sie beides ausgeschaltet, wenn jedes Fenster unabhängig bleiben soll. Studien hinzufügen? Stellen Sie sie pro Chart ein, da jedes Modul seine eigenen Indikatoren behält.", image: {"src":`${IMG}/tradovate-multi-chart-layout-5.png`,"alt":"Tradovate-Charts, die durch einen farbcodierten Instrumentenpunkt verknüpft sind, mit aktivierter Einstellung Global Crosshair in allen Fenstern"} },
        { title: "Layout als Workspace speichern", html: "Sobald das Raster passt, speichern Sie es, damit Sie es nicht jeden Morgen neu aufbauen müssen. Öffnen Sie das Menü <strong class='text-white'>New (+) / Workspaces</strong>, geben Sie dem Layout im Feld für den Vorlagennamen einen Namen und speichern Sie. Der Name des aktiven Workspace erscheint in Ihrem Browser-Tab, und über dasselbe Menü können Sie zwischen gespeicherten Layouts wechseln. Wenn Sie direkt aus Ihren Charts handeln, werden Ihre Order-Schaltflächen und Zeichnungen zusammen mit dem Layout gespeichert.", image: {"src":`${IMG}/tradovate-multi-chart-layout-6.png`,"alt":"Tradovate-Menü Workspaces mit einem im Vorlagenfeld eingegebenen Namen zum Speichern des Multi-Chart-Layouts"} },
      ],
    },
    { type: "heading",text: "Gut zu wissen" },
    { type: "table", headers: ["Was Sie sehen","Was dahintersteckt"], rows: [
      ["Alle Charts haben gleichzeitig das Symbol gewechselt","Diese Fenster teilen dieselbe Farbverknüpfung. Geben Sie ihnen unterschiedliche Farbpunkte (oder keine), damit die Symbole unabhängig bleiben."],
      ["Das Fadenkreuz bewegt sich nur in einem Chart","Global Crosshair ist eine Einstellung pro Modul. Aktivieren Sie sie für jedes Fenster, das verknüpft sein soll."],
      ["Das Layout war nach dem Abmelden weg","Sie haben es nicht gespeichert. Speichern Sie das Raster als benannten Workspace, damit es in der nächsten Sitzung wieder geladen wird."],
    ] },
    { type: "heading",text: "Mit PickMyTrade automatisieren" },
    { type: "paragraph",html: "Sobald Ihre Charts eingerichtet sind, ist der manuelle Teil, nämlich das tatsächliche Auslösen von Orders über all diese Fenster hinweg, die Stelle, an der sich Fehler einschleichen. <strong class='text-white'>PickMyTrade automatisiert Ihre Tradovate-Ausführung</strong> direkt aus TradingView-Alerts, sodass Ihre Strategie auslöst, während Sie das Setup lesen, statt mit der Maus zu hetzen." },
  ], es: [
    { type: "paragraph",html: "Trabajar con un solo gráfico a la vez funciona bien hasta que necesita leer una configuración de 5 minutos frente a la tendencia de 1 hora y el nivel diario al mismo tiempo. Un diseño de varios gráficos reúne todos los marcos temporales que le interesan en una sola ventana, de modo que deja de cambiar de pestaña y empieza a ver el panorama completo. Aquí le explicamos cómo crear uno, vincular los paneles entre sí y guardarlo para que le espere en la próxima sesión." },
    { type: "heading",text: "Cree un diseño de varios gráficos en Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra su primer módulo de gráfico", html: "Comience desde un espacio de trabajo en blanco o uno existente. Haga clic en el botón <strong class='text-white'>New (+)</strong> en la esquina superior izquierda de la aplicación web y arrastre un módulo <strong class='text-white'>Chart</strong> a la pantalla. Al principio ocupará todo el espacio disponible, y no pasa nada, lo dividirá en un momento. Hay otras dos formas de añadir un gráfico: escriba un símbolo en la barra de búsqueda de la parte superior de la página o haga clic con el botón derecho en un instrumento dentro de un módulo Market Analyzer.", image: {"src":`${IMG}/tradovate-multi-chart-layout-1.png`,"alt":"Aplicación web de Tradovate con el botón New (+) resaltado y un módulo Chart arrastrado a un espacio de trabajo en blanco"} },
        { title: "Añada más gráficos a la misma ventana", html: "Para obtener un segundo panel, haga clic con el botón derecho dentro del gráfico que acaba de abrir y elija <strong class='text-white'>Add Chart</strong>, o vuelva al menú <strong class='text-white'>New (+)</strong> y arrastre otro módulo Chart. Repita el proceso con tantos paneles como desee. Cuatro es una elección habitual para una vista descendente, por ejemplo diario, 1 hora, 15 minutos y 5 minutos, pero no hay ninguna regla estricta. Añádalos todos primero y preocúpese de la colocación después.", image: {"src":`${IMG}/tradovate-multi-chart-layout-2.png`,"alt":"Menú contextual de un gráfico de Tradovate con la opción Add Chart para insertar un segundo panel de gráfico"} },
        { title: "Arrastre los bordes para construir su cuadrícula", html: "Todos los módulos de Tradovate se pueden redimensionar. Coloque el cursor sobre el borde entre dos gráficos hasta que cambie, y luego haga clic y arrastre para dividir el espacio. Los bordes verticales definen el ancho izquierdo/derecho y los horizontales la altura superior/inferior. Mueva esos bordes hasta obtener la cuadrícula que desea, ya sea un dos por dos limpio o un gráfico grande con un par de pequeños a su lado. Si prefiere apilar los paneles en lugar de colocarlos en mosaico, puede agrupar los módulos en pestañas y alternar entre ellas.", image: {"src":`${IMG}/tradovate-multi-chart-layout-3.png`,"alt":"Cuatro paneles de gráfico de Tradovate dispuestos en una cuadrícula de dos por dos, con un borde que se arrastra para redimensionarlos"} },
        { title: "Establezca un símbolo y un intervalo en cada panel", html: "Haga clic en cada gráfico y establezca su instrumento en la barra de búsqueda del gráfico; después elija el marco temporal en el control <strong class='text-white'>Chart Interval</strong>. Aquí es donde el diseño demuestra su valor: ponga el mismo símbolo en cuatro intervalos distintos para una lectura descendente, o cuatro instrumentos diferentes si está vigilando una cesta.", image: {"src":`${IMG}/tradovate-multi-chart-layout-4.png`,"alt":"Panel de gráfico de Tradovate con la barra de búsqueda de símbolos y el control Chart Interval resaltados para establecer el marco temporal"} },
        { title: "Vincule los gráficos y sincronice el cursor en cruz", html: "Tradovate puede vincular sus paneles para que se muevan como un conjunto. El punto de color junto a Chart Interval vincula los gráficos por instrumento, así que si pone dos gráficos con el mismo color, al cambiar el símbolo en uno cambia en los demás. Para alinear su cursor entre paneles, active la opción <strong class='text-white'>Global Crosshair</strong> en cada gráfico, de modo que al pasar sobre una vela en un marco temporal se marque el mismo momento en el resto. Deje ambas desactivadas si prefiere que cada panel sea independiente. ¿Va a añadir estudios? Configúrelos por gráfico, ya que cada módulo mantiene sus propios indicadores.", image: {"src":`${IMG}/tradovate-multi-chart-layout-5.png`,"alt":"Gráficos de Tradovate vinculados por un punto de color de instrumento con la opción Global Crosshair activada en todos los paneles"} },
        { title: "Guarde el diseño como espacio de trabajo", html: "Cuando la cuadrícula esté a su gusto, guárdela para no tener que reconstruirla cada mañana. Abra el menú <strong class='text-white'>New (+) / Workspaces</strong>, asigne un nombre al diseño en el campo del nombre de plantilla y guarde. El nombre del espacio de trabajo activo aparece en la pestaña del navegador, y puede cambiar entre los diseños guardados desde ese mismo menú. Si opera directamente desde sus gráficos, los botones de órdenes y los dibujos se guardan junto con el diseño.", image: {"src":`${IMG}/tradovate-multi-chart-layout-6.png`,"alt":"Menú Workspaces de Tradovate con un nombre introducido en el campo de plantilla para guardar el diseño de varios gráficos"} },
      ],
    },
    { type: "heading",text: "Algunas cosas que conviene saber" },
    { type: "table", headers: ["Lo que ve","Lo que ocurre"], rows: [
      ["Todos los gráficos cambiaron de símbolo a la vez","Esos paneles comparten el mismo vínculo de color. Asígneles puntos de colores distintos (o ninguno) para mantener los símbolos independientes."],
      ["El cursor en cruz solo se mueve en un gráfico","Global Crosshair es una opción por módulo. Actívela en cada panel que desee vincular."],
      ["El diseño desapareció tras cerrar sesión","No lo guardó. Guarde la cuadrícula como un espacio de trabajo con nombre para que se cargue de nuevo en la próxima sesión."],
    ] },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Una vez que sus gráficos están a punto, la parte manual, es decir, enviar órdenes entre todos esos paneles, es donde se cuelan los errores. <strong class='text-white'>PickMyTrade automatiza su ejecución en Tradovate</strong> directamente desde las alertas de TradingView, de modo que su estrategia se activa mientras usted lee la configuración en lugar de competir con el ratón." },
  ], fr: [
    { type: "paragraph",html: "Travailler avec un seul graphique à la fois fonctionne bien, jusqu'au moment où vous voulez lire un setup en 5 minutes face à la tendance en 1 heure et au niveau journalier en même temps. Une disposition multi-graphiques réunit toutes les unités de temps qui comptent pour vous dans une seule fenêtre : vous cessez de changer d'onglet et vous voyez enfin le tableau complet. Voici comment en créer une, relier les volets entre eux et l'enregistrer pour la retrouver à la prochaine session." },
    { type: "heading",text: "Créer une disposition multi-graphiques dans Tradovate : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir votre premier module Chart", html: "Partez d'un espace de travail vide ou existant. Cliquez sur le bouton <strong class='text-white'>New (+)</strong> en haut à gauche de l'application web et faites glisser un module <strong class='text-white'>Chart</strong> à l'écran. Il occupera d'abord tout l'espace disponible, ce n'est pas un problème, vous le découperez dans un instant. Deux autres façons d'ajouter un graphique : saisir un symbole dans la barre de recherche en haut de la page, ou faire un clic droit sur un instrument dans un module Market Analyzer.", image: {"src":`${IMG}/tradovate-multi-chart-layout-1.png`,"alt":"Application web Tradovate avec le bouton New (+) en surbrillance et un module Chart glissé sur un espace de travail vide"} },
        { title: "Ajouter d'autres graphiques à la même fenêtre", html: "Pour obtenir un deuxième volet, faites un clic droit dans le graphique que vous venez d'ouvrir et choisissez <strong class='text-white'>Add Chart</strong>, ou retournez dans le menu <strong class='text-white'>New (+)</strong> et faites glisser un autre module Chart. Répétez l'opération autant de fois que vous voulez de volets. Quatre est un choix courant pour une vue descendante, par exemple journalier, 1 heure, 15 minutes et 5 minutes, mais il n'y a pas de règle stricte. Ajoutez-les tous d'abord, puis occupez-vous de leur placement.", image: {"src":`${IMG}/tradovate-multi-chart-layout-2.png`,"alt":"Menu contextuel d'un graphique Tradovate affichant l'option Add Chart pour insérer un deuxième volet de graphique"} },
        { title: "Faire glisser les bordures pour construire votre grille", html: "Chaque module de Tradovate est redimensionnable. Survolez la bordure entre deux graphiques jusqu'à ce que le curseur change, puis cliquez et faites glisser pour répartir l'espace. Les bordures verticales règlent la largeur gauche/droite, les bordures horizontales la hauteur haut/bas. Déplacez ces bords jusqu'à obtenir la grille voulue, qu'il s'agisse d'un deux par deux bien net ou d'un grand graphique avec quelques petits empilés à côté. Si vous préférez empiler les volets plutôt que les juxtaposer, vous pouvez regrouper les modules en onglets et passer de l'un à l'autre.", image: {"src":`${IMG}/tradovate-multi-chart-layout-3.png`,"alt":"Quatre volets de graphique Tradovate disposés en grille deux par deux, avec une bordure que l'on fait glisser pour les redimensionner"} },
        { title: "Définir un symbole et un intervalle pour chaque volet", html: "Cliquez dans chaque graphique et définissez son instrument dans la barre de recherche du graphique, puis choisissez l'unité de temps dans le contrôle <strong class='text-white'>Chart Interval</strong>. C'est là que la disposition prend tout son sens : placez le même symbole sur quatre intervalles différents pour une lecture descendante, ou quatre instruments différents si vous surveillez un panier.", image: {"src":`${IMG}/tradovate-multi-chart-layout-4.png`,"alt":"Volet de graphique Tradovate avec la barre de recherche de symbole et le contrôle Chart Interval en surbrillance pour définir l'unité de temps"} },
        { title: "Lier les graphiques et synchroniser le réticule", html: "Tradovate peut relier vos volets pour qu'ils se déplacent ensemble. Le point de couleur à côté de Chart Interval lie les graphiques par instrument : placez deux graphiques sur la même couleur et le changement de symbole dans l'un le change dans les autres. Pour aligner votre curseur d'un volet à l'autre, activez le paramètre <strong class='text-white'>Global Crosshair</strong> sur chaque graphique, de sorte que survoler une bougie dans une unité de temps marque le même moment sur les autres. Laissez les deux désactivés si vous préférez que chaque volet reste indépendant. Vous ajoutez des études ? Réglez-les graphique par graphique, car chaque module conserve ses propres indicateurs.", image: {"src":`${IMG}/tradovate-multi-chart-layout-5.png`,"alt":"Graphiques Tradovate reliés par un point de couleur d'instrument avec le paramètre Global Crosshair activé sur tous les volets"} },
        { title: "Enregistrer la disposition comme espace de travail", html: "Une fois la grille satisfaisante, enregistrez-la pour ne pas la reconstruire chaque matin. Ouvrez le menu <strong class='text-white'>New (+) / Workspaces</strong>, donnez un nom à la disposition dans le champ du nom de modèle, puis enregistrez. Le nom de l'espace de travail actif s'affiche dans l'onglet de votre navigateur, et vous pouvez passer d'une disposition enregistrée à l'autre depuis ce même menu. Si vous tradez directement depuis vos graphiques, vos boutons d'ordre et vos dessins sont enregistrés avec la disposition.", image: {"src":`${IMG}/tradovate-multi-chart-layout-6.png`,"alt":"Menu Workspaces de Tradovate avec un nom saisi dans le champ de modèle pour enregistrer la disposition multi-graphiques"} },
      ],
    },
    { type: "heading",text: "Quelques points à connaître" },
    { type: "table", headers: ["Ce que vous voyez","Ce qui se passe"], rows: [
      ["Tous les graphiques ont changé de symbole en même temps","Ces volets partagent le même lien de couleur. Donnez-leur des points de couleurs différentes (ou aucun) pour garder des symboles indépendants."],
      ["Le réticule ne bouge que sur un graphique","Global Crosshair est un paramètre propre à chaque module. Activez-le sur chaque volet que vous souhaitez lier."],
      ["La disposition a disparu après la déconnexion","Vous ne l'aviez pas enregistrée. Enregistrez la grille comme espace de travail nommé pour qu'elle se recharge à la prochaine session."],
    ] },
    { type: "heading",text: "Automatisez tout cela avec PickMyTrade" },
    { type: "paragraph",html: "Une fois vos graphiques au point, c'est la partie manuelle, c'est-à-dire l'envoi réel des ordres sur tous ces volets, qui expose aux erreurs. <strong class='text-white'>PickMyTrade automatise votre exécution sur Tradovate</strong> directement depuis les alertes TradingView, afin que votre stratégie se déclenche pendant que vous lisez le setup plutôt que de courir après la souris." },
  ], it: [
    { type: "paragraph",html: "Lavorare con un solo grafico alla volta va bene finché non deve leggere un setup a 5 minuti rispetto al trend a 1 ora e al livello giornaliero tutto insieme. Un layout multi-grafico porta ogni timeframe che le interessa in un'unica finestra, così smette di passare da una scheda all'altra e inizia a vedere il quadro completo. Ecco come costruirne uno, collegare i pannelli tra loro e salvarlo in modo che lo ritrovi alla sessione successiva." },
    { type: "heading",text: "Creare un layout multi-grafico in Tradovate: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Aprire il primo modulo Chart", html: "Parta da un workspace vuoto o già esistente. Clicchi sul pulsante <strong class='text-white'>New (+)</strong> nell'angolo in alto a sinistra dell'app web e trascini un modulo <strong class='text-white'>Chart</strong> sullo schermo. All'inizio occuperà tutto lo spazio disponibile, e va bene così: lo dividerà tra un attimo. Altri due modi per inserire un grafico: digitare un simbolo nella barra di ricerca in cima alla pagina, oppure fare clic con il tasto destro su uno strumento all'interno di un modulo Market Analyzer.", image: {"src":`${IMG}/tradovate-multi-chart-layout-1.png`,"alt":"App web di Tradovate con il pulsante New (+) evidenziato e un modulo Chart trascinato su un workspace vuoto"} },
        { title: "Aggiungere altri grafici alla stessa finestra", html: "Per ottenere un secondo pannello, faccia clic con il tasto destro all'interno del grafico appena aperto e scelga <strong class='text-white'>Add Chart</strong>, oppure torni al menu <strong class='text-white'>New (+)</strong> e trascini un altro modulo Chart. Ripeta l'operazione per tutti i pannelli che desidera. Quattro è una scelta comune per una vista top-down, ad esempio giornaliero, 1 ora, 15 minuti e 5 minuti, ma non esiste una regola rigida. Li aggiunga tutti prima e si preoccupi del posizionamento dopo.", image: {"src":`${IMG}/tradovate-multi-chart-layout-2.png`,"alt":"Menu contestuale di un grafico Tradovate con l'opzione Add Chart per inserire un secondo pannello grafico"} },
        { title: "Trascinare i bordi per costruire la griglia", html: "Ogni modulo di Tradovate è ridimensionabile. Passi il cursore sul bordo tra due grafici finché non cambia, poi clicchi e trascini per suddividere lo spazio. I bordi verticali impostano la larghezza sinistra/destra, quelli orizzontali l'altezza superiore/inferiore. Sposti i bordi finché non ottiene la griglia desiderata, che sia un pulito due per due o un grande grafico con un paio di piccoli impilati accanto. Se preferisce sovrapporre i pannelli anziché affiancarli, può raggruppare i moduli in schede e passare dall'una all'altra.", image: {"src":`${IMG}/tradovate-multi-chart-layout-3.png`,"alt":"Quattro pannelli grafici di Tradovate disposti in una griglia due per due, con un bordo trascinato per ridimensionarli"} },
        { title: "Impostare simbolo e intervallo su ogni pannello", html: "Clicchi su ciascun grafico e imposti il suo strumento nella barra di ricerca del grafico, poi scelga il timeframe dal controllo <strong class='text-white'>Chart Interval</strong>. È qui che il layout dimostra il suo valore: metta lo stesso simbolo su quattro intervalli diversi per una lettura top-down, oppure quattro strumenti diversi se sta seguendo un paniere.", image: {"src":`${IMG}/tradovate-multi-chart-layout-4.png`,"alt":"Pannello grafico di Tradovate con la barra di ricerca dei simboli e il controllo Chart Interval evidenziati per impostare il timeframe"} },
        { title: "Collegare i grafici e sincronizzare il cursore a croce", html: "Tradovate può collegare i pannelli in modo che si muovano insieme. Il punto colorato accanto a Chart Interval collega i grafici per strumento: metta due grafici sullo stesso colore e cambiando il simbolo in uno cambierà anche negli altri. Per allineare il cursore tra i pannelli, attivi l'impostazione <strong class='text-white'>Global Crosshair</strong> su ciascun grafico, così passando sopra una candela in un timeframe si evidenzia lo stesso momento negli altri. Lasci entrambe disattivate se preferisce che ogni pannello resti indipendente. Aggiunge degli studi? Li imposti per ogni grafico, poiché ogni modulo mantiene i propri indicatori.", image: {"src":`${IMG}/tradovate-multi-chart-layout-5.png`,"alt":"Grafici Tradovate collegati da un punto colorato dello strumento con l'impostazione Global Crosshair attivata su tutti i pannelli"} },
        { title: "Salvare il layout come workspace", html: "Quando la griglia è come desidera, la salvi per non doverla ricostruire ogni mattina. Apra il menu <strong class='text-white'>New (+) / Workspaces</strong>, assegni un nome al layout nel campo del nome del modello e salvi. Il nome del workspace attivo compare nella scheda del browser e può passare da un layout salvato all'altro dallo stesso menu. Se opera direttamente dai grafici, i pulsanti degli ordini e i disegni vengono salvati insieme al layout.", image: {"src":`${IMG}/tradovate-multi-chart-layout-6.png`,"alt":"Menu Workspaces di Tradovate con un nome inserito nel campo del modello per salvare il layout multi-grafico"} },
      ],
    },
    { type: "heading",text: "Alcune cose da sapere" },
    { type: "table", headers: ["Cosa vede","Cosa sta succedendo"], rows: [
      ["Tutti i grafici hanno cambiato simbolo contemporaneamente","Quei pannelli condividono lo stesso collegamento di colore. Assegni loro punti di colore diversi (o nessuno) per mantenere i simboli indipendenti."],
      ["Il cursore a croce si muove solo su un grafico","Global Crosshair è un'impostazione per singolo modulo. La attivi su ogni pannello che desidera collegare."],
      ["Il layout è sparito dopo il logout","Non lo ha salvato. Salvi la griglia come workspace con nome in modo che venga ricaricata alla sessione successiva."],
    ] },
    { type: "heading",text: "Automatizzi tutto con PickMyTrade" },
    { type: "paragraph",html: "Una volta messi a punto i grafici, la parte manuale, cioè inviare effettivamente gli ordini su tutti quei pannelli, è dove si insinuano gli errori. <strong class='text-white'>PickMyTrade automatizza la sua esecuzione su Tradovate</strong> direttamente dagli alert di TradingView, così la sua strategia scatta mentre lei legge il setup invece di rincorrere il mouse." },
  ] },
  ctaHeading: { en: "Read the Setup, Not the Mouse", de: "Das Setup lesen, nicht die Maus", es: "Lea la configuración, no el ratón", fr: "Lisez le setup, pas la souris", it: "Legga il setup, non il mouse" },
  ctaText: { en: "Once your multi-chart layout is dialed in, let PickMyTrade fire the trade straight from your TradingView alerts.", de: "Sobald Ihr Multi-Chart-Layout steht, lassen Sie PickMyTrade den Trade direkt aus Ihren TradingView-Alerts auslösen.", es: "Una vez que su diseño de varios gráficos esté listo, deje que PickMyTrade ejecute la operación directamente desde sus alertas de TradingView.", fr: "Une fois votre disposition multi-graphiques au point, laissez PickMyTrade déclencher le trade directement depuis vos alertes TradingView.", it: "Una volta messo a punto il suo layout multi-grafico, lasci che PickMyTrade esegua il trade direttamente dai suoi alert di TradingView." },
