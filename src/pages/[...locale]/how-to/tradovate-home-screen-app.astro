---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-home-screen-app";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Add Tradovate to Your Phone Home Screen (PWA)";
const META_DESCRIPTION =
  "Pin the futures web trader to your phone home screen as a full-screen app on iPhone or Android in a few taps. No app store download needed.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate zum Startbildschirm Ihres Smartphones hinzufügen (PWA)", es: "Añada Tradovate a la pantalla de inicio de su teléfono (PWA)", fr: "Ajouter Tradovate à l'écran d'accueil de votre téléphone (PWA)", it: "Aggiungere Tradovate alla schermata Home del telefono (PWA)" },
  dek: { en: "The Tradovate web trader is the same full platform you run on desktop, and you can pin it to your phone home screen so it opens full-screen with its own icon.", de: "Der Tradovate Web Trader ist dieselbe vollständige Plattform wie auf dem Desktop, und Sie können ihn an den Startbildschirm Ihres Smartphones anheften, sodass er im Vollbild mit eigenem Symbol startet.", es: "El web trader de Tradovate es la misma plataforma completa que utiliza en el escritorio, y puede anclarlo a la pantalla de inicio de su teléfono para que se abra a pantalla completa con su propio icono.", fr: "Le web trader de Tradovate est la même plateforme complète que sur ordinateur, et vous pouvez l'épingler à l'écran d'accueil de votre téléphone pour qu'il s'ouvre en plein écran avec sa propre icône.", it: "Il web trader di Tradovate è la stessa piattaforma completa che usa sul desktop, e può aggiungerlo alla schermata Home del telefono in modo che si apra a schermo intero con una propria icona." },
  readTime: { en: "4 min read", de: "4 Min. Lesezeit", es: "Lectura de 4 min", fr: "Lecture : 4 min", it: "Lettura di 4 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "The web trader at <strong class='text-white'>trader.tradovate.com</strong> is the same full platform you run on desktop. Charts, the SuperDOM, order tickets, ATM strategies, risk settings, all of it, just loaded in your phone's browser. What most people miss is that you can pin it to your home screen so it opens full-screen with its own icon, no App Store or Play Store download involved." },
    { type: "paragraph", html: "Why bother when there's already a native app? Two reasons. The web trader gives you the complete layout instead of the trimmed-down mobile app, and if your prop firm handed you web-only credentials, this is often the cleanest way to trade from your phone. The whole thing takes under a minute. Here it is." },
    { type: "heading", text: "What You'll Need" },
    {
      type: "table",
      headers: ["Item", "Details"],
      rows: [
        ["A phone", "iPhone with Safari, or Android with Chrome"],
        ["Your login", "Tradovate or your prop firm's credentials"],
        ["Internet", "The shortcut always loads the live site, so you need a connection"],
      ],
    },
    { type: "heading", text: "Add Tradovate to Your Home Screen: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open the Web Trader in Your Browser", html: "Open Safari on an iPhone or Chrome on Android and type <strong class='text-white'>trader.tradovate.com</strong> into the address bar. You can log in first or leave it on the login screen, either way works for pinning it." },
        { title: "Add It to Your Home Screen on iPhone", html: "Tap the <strong class='text-white'>Share</strong> button, the square with an arrow pointing up. Depending on your iOS version it sits in the address bar or along the bottom of the screen. Scroll down the share sheet and tap <strong class='text-white'>Add to Home Screen</strong>. Give the shortcut a short name like \"Tradovate,\" then tap <strong class='text-white'>Add</strong>. On newer iOS versions you'll see an <strong class='text-white'>Open as Web App</strong> toggle that's already switched on. Leave it on. That's what makes the shortcut open full-screen instead of inside a regular browser tab. If you don't see Add to Home Screen at all, scroll to the bottom of the share sheet, tap <strong class='text-white'>Edit Actions</strong>, and add it there first." },
        { title: "Add It to Your Home Screen on Android", html: "Tap the <strong class='text-white'>three-dot menu</strong> in the top-right corner of Chrome. Look for <strong class='text-white'>Add to Home screen</strong>. Recent Chrome builds sometimes label this <strong class='text-white'>Install app</strong> or <strong class='text-white'>Install and create shortcut</strong> when a site qualifies as a web app, but they do the same job. Tap it, confirm the name, then tap <strong class='text-white'>Add</strong> or <strong class='text-white'>Install</strong>. Chrome drops the icon onto your home screen, or lets you place it where you want." },
        { title: "Open It Like an App and Log In", html: "You'll now have a Tradovate icon sitting next to your other apps. Tap it and the web trader opens full-screen with the browser bar tucked away, so it looks and behaves like a native app. Log in and you're trading." },
      ],
    },
    { type: "heading", text: "A Few Things Worth Knowing" },
    {
      type: "list",
      items: [
        "This is the full web platform, not the stripped native app, so you keep the same charts, SuperDOM, ATM strategies, and risk settings you use on desktop.",
        "The shortcut is essentially a bookmark with an icon. There's nothing to update because it always loads the live site.",
        "Want your phone to buzz when price hits a level while the app is closed? Set price alerts on your Tradovate charts before you step away.",
        "Getting signed out when you open it? That's usually the active-session limit. Sign out of the platform on other devices and TradingView, then log back in on your phone only.",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Your home-screen shortcut lets you watch the market from anywhere. Want your phone to actually place the trades for you from a TradingView alert? PickMyTrade automates Tradovate so your strategy fires whether the app is open or not." },
  ], de: [
    { type: "paragraph",html: "Der Web Trader unter <strong class='text-white'>trader.tradovate.com</strong> ist dieselbe vollständige Plattform wie auf dem Desktop. Charts, SuperDOM, Orderfenster, ATM-Strategien, Risikoeinstellungen, einfach alles, nur eben im Browser Ihres Smartphones geladen. Was die meisten übersehen: Sie können ihn an Ihren Startbildschirm anheften, sodass er im Vollbild mit eigenem Symbol startet, ganz ohne Download aus dem App Store oder Play Store." },
    { type: "paragraph",html: "Warum der Aufwand, wenn es doch schon eine native App gibt? Aus zwei Gründen. Der Web Trader bietet Ihnen das vollständige Layout statt der abgespeckten Mobile-App, und wenn Ihre Prop-Firma Ihnen nur Web-Zugangsdaten gegeben hat, ist dies oft der sauberste Weg, vom Smartphone aus zu handeln. Das Ganze dauert weniger als eine Minute. So geht es." },
    { type: "heading",text: "Was Sie benötigen" },
    { type: "table", headers: ["Element","Details"], rows: [
      ["Ein Smartphone","iPhone mit Safari oder Android mit Chrome"],
      ["Ihre Zugangsdaten","Zugangsdaten von Tradovate oder Ihrer Prop-Firma"],
      ["Internet","Die Verknüpfung lädt immer die Live-Seite, daher benötigen Sie eine Verbindung"],
    ] },
    { type: "heading",text: "Tradovate zum Startbildschirm hinzufügen: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Öffnen Sie den Web Trader in Ihrem Browser", html: "Öffnen Sie Safari auf einem iPhone oder Chrome auf Android und geben Sie <strong class='text-white'>trader.tradovate.com</strong> in die Adressleiste ein. Sie können sich zuerst anmelden oder den Anmeldebildschirm geöffnet lassen, beides funktioniert zum Anheften." },
        { title: "Auf dem iPhone zum Startbildschirm hinzufügen", html: "Tippen Sie auf die Schaltfläche <strong class='text-white'>Share</strong>, das Quadrat mit einem nach oben zeigenden Pfeil. Je nach iOS-Version befindet sie sich in der Adressleiste oder am unteren Bildschirmrand. Scrollen Sie im Share-Menü nach unten und tippen Sie auf <strong class='text-white'>Add to Home Screen</strong>. Geben Sie der Verknüpfung einen kurzen Namen wie \"Tradovate\" und tippen Sie dann auf <strong class='text-white'>Add</strong>. Bei neueren iOS-Versionen sehen Sie einen Schalter <strong class='text-white'>Open as Web App</strong>, der bereits eingeschaltet ist. Lassen Sie ihn eingeschaltet. Dadurch öffnet sich die Verknüpfung im Vollbild statt in einem normalen Browser-Tab. Wenn Sie Add to Home Screen gar nicht sehen, scrollen Sie ans Ende des Share-Menüs, tippen Sie auf <strong class='text-white'>Edit Actions</strong> und fügen Sie es dort zuerst hinzu." },
        { title: "Auf Android zum Startbildschirm hinzufügen", html: "Tippen Sie in Chrome oben rechts auf das <strong class='text-white'>Drei-Punkte-Menü</strong>. Suchen Sie nach <strong class='text-white'>Add to Home screen</strong>. Neuere Chrome-Versionen bezeichnen dies manchmal als <strong class='text-white'>Install app</strong> oder <strong class='text-white'>Install and create shortcut</strong>, wenn eine Website als Web-App gilt, aber sie erfüllen denselben Zweck. Tippen Sie darauf, bestätigen Sie den Namen und tippen Sie dann auf <strong class='text-white'>Add</strong> oder <strong class='text-white'>Install</strong>. Chrome legt das Symbol auf Ihrem Startbildschirm ab oder lässt Sie es dort platzieren, wo Sie möchten." },
        { title: "Wie eine App öffnen und anmelden", html: "Jetzt befindet sich ein Tradovate-Symbol neben Ihren anderen Apps. Tippen Sie darauf, und der Web Trader öffnet sich im Vollbild mit ausgeblendeter Browserleiste, sodass er aussieht und sich verhält wie eine native App. Melden Sie sich an, und Sie können handeln." },
      ],
    },
    { type: "heading",text: "Einige Dinge, die Sie wissen sollten" },
    {
      type: "list",
      items: [
        "Dies ist die vollständige Web-Plattform, nicht die abgespeckte native App, sodass Sie dieselben Charts, dasselbe SuperDOM, dieselben ATM-Strategien und Risikoeinstellungen wie auf dem Desktop behalten.",
        "Die Verknüpfung ist im Grunde ein Lesezeichen mit einem Symbol. Es gibt nichts zu aktualisieren, da immer die Live-Seite geladen wird.",
        "Möchten Sie, dass Ihr Smartphone vibriert, wenn der Kurs ein Level erreicht, während die App geschlossen ist? Richten Sie Preis-Alerts in Ihren Tradovate-Charts ein, bevor Sie sich entfernen.",
        "Werden Sie beim Öffnen abgemeldet? Das liegt meist am Limit für aktive Sitzungen. Melden Sie sich auf anderen Geräten und bei TradingView von der Plattform ab und melden Sie sich dann nur auf Ihrem Smartphone wieder an.",
      ],
    },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "Mit Ihrer Startbildschirm-Verknüpfung können Sie den Markt von überall aus beobachten. Möchten Sie, dass Ihr Smartphone die Trades auf Basis eines TradingView-Alerts tatsächlich für Sie platziert? PickMyTrade automatisiert Tradovate, sodass Ihre Strategie auslöst, egal ob die App geöffnet ist oder nicht." },
  ], es: [
    { type: "paragraph",html: "El web trader en <strong class='text-white'>trader.tradovate.com</strong> es la misma plataforma completa que utiliza en el escritorio. Gráficos, SuperDOM, tickets de órdenes, estrategias ATM, ajustes de riesgo, todo, solo que cargado en el navegador de su teléfono. Lo que la mayoría pasa por alto es que puede anclarlo a la pantalla de inicio para que se abra a pantalla completa con su propio icono, sin descargar nada del App Store ni de Play Store." },
    { type: "paragraph",html: "¿Por qué molestarse si ya existe una aplicación nativa? Por dos razones. El web trader le ofrece el diseño completo en lugar de la aplicación móvil reducida, y si su prop firm le entregó credenciales solo para web, esta suele ser la forma más limpia de operar desde el teléfono. Todo el proceso lleva menos de un minuto. Aquí lo tiene." },
    { type: "heading",text: "Qué necesitará" },
    { type: "table", headers: ["Elemento","Detalles"], rows: [
      ["Un teléfono","iPhone con Safari, o Android con Chrome"],
      ["Sus credenciales","Las de Tradovate o las de su prop firm"],
      ["Internet","El acceso directo siempre carga el sitio en vivo, así que necesita conexión"],
    ] },
    { type: "heading",text: "Añadir Tradovate a la pantalla de inicio: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra el web trader en su navegador", html: "Abra Safari en un iPhone o Chrome en Android y escriba <strong class='text-white'>trader.tradovate.com</strong> en la barra de direcciones. Puede iniciar sesión primero o dejarlo en la pantalla de inicio de sesión; ambas opciones sirven para anclarlo." },
        { title: "Añádalo a la pantalla de inicio en iPhone", html: "Toque el botón <strong class='text-white'>Share</strong>, el cuadrado con una flecha hacia arriba. Según su versión de iOS, se encuentra en la barra de direcciones o en la parte inferior de la pantalla. Desplácese hacia abajo en la hoja de compartir y toque <strong class='text-white'>Add to Home Screen</strong>. Asigne al acceso directo un nombre corto como \"Tradovate\" y toque <strong class='text-white'>Add</strong>. En versiones más recientes de iOS verá un interruptor <strong class='text-white'>Open as Web App</strong> que ya está activado. Déjelo activado. Eso es lo que hace que el acceso directo se abra a pantalla completa en lugar de en una pestaña normal del navegador. Si no ve Add to Home Screen, desplácese hasta el final de la hoja de compartir, toque <strong class='text-white'>Edit Actions</strong> y añádalo primero allí." },
        { title: "Añádalo a la pantalla de inicio en Android", html: "Toque el <strong class='text-white'>menú de tres puntos</strong> en la esquina superior derecha de Chrome. Busque <strong class='text-white'>Add to Home screen</strong>. Las versiones recientes de Chrome a veces lo llaman <strong class='text-white'>Install app</strong> o <strong class='text-white'>Install and create shortcut</strong> cuando un sitio cumple los requisitos de aplicación web, pero cumplen la misma función. Tóquelo, confirme el nombre y luego toque <strong class='text-white'>Add</strong> o <strong class='text-white'>Install</strong>. Chrome coloca el icono en su pantalla de inicio o le permite ubicarlo donde quiera." },
        { title: "Ábralo como una aplicación e inicie sesión", html: "Ahora tendrá un icono de Tradovate junto a sus otras aplicaciones. Tóquelo y el web trader se abre a pantalla completa con la barra del navegador oculta, por lo que se ve y se comporta como una aplicación nativa. Inicie sesión y ya puede operar." },
      ],
    },
    { type: "heading",text: "Algunas cosas que conviene saber" },
    {
      type: "list",
      items: [
        "Esta es la plataforma web completa, no la aplicación nativa reducida, así que conserva los mismos gráficos, SuperDOM, estrategias ATM y ajustes de riesgo que usa en el escritorio.",
        "El acceso directo es básicamente un marcador con un icono. No hay nada que actualizar porque siempre carga el sitio en vivo.",
        "¿Quiere que su teléfono vibre cuando el precio alcance un nivel con la aplicación cerrada? Configure alertas de precio en sus gráficos de Tradovate antes de alejarse.",
        "¿Se cierra su sesión al abrirlo? Suele deberse al límite de sesiones activas. Cierre sesión en la plataforma en otros dispositivos y en TradingView, y luego vuelva a iniciar sesión solo en su teléfono.",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Su acceso directo en la pantalla de inicio le permite vigilar el mercado desde cualquier lugar. ¿Quiere que su teléfono realmente ejecute las operaciones por usted a partir de una alerta de TradingView? PickMyTrade automatiza Tradovate para que su estrategia se ejecute con la aplicación abierta o sin ella." },
  ], fr: [
    { type: "paragraph",html: "Le web trader sur <strong class='text-white'>trader.tradovate.com</strong> est la même plateforme complète que sur ordinateur. Graphiques, SuperDOM, tickets d'ordre, stratégies ATM, paramètres de risque, tout y est, simplement chargé dans le navigateur de votre téléphone. Ce que la plupart des gens ignorent, c'est que vous pouvez l'épingler à votre écran d'accueil pour qu'il s'ouvre en plein écran avec sa propre icône, sans aucun téléchargement depuis l'App Store ou le Play Store." },
    { type: "paragraph",html: "Pourquoi s'en préoccuper alors qu'il existe déjà une application native ? Pour deux raisons. Le web trader vous donne la disposition complète plutôt que l'application mobile allégée, et si votre prop firm vous a remis des identifiants réservés au web, c'est souvent le moyen le plus propre de trader depuis votre téléphone. L'ensemble prend moins d'une minute. Voici comment faire." },
    { type: "heading",text: "Ce dont vous aurez besoin" },
    { type: "table", headers: ["Élément","Détails"], rows: [
      ["Un téléphone","iPhone avec Safari, ou Android avec Chrome"],
      ["Vos identifiants","Ceux de Tradovate ou de votre prop firm"],
      ["Internet","Le raccourci charge toujours le site en direct, vous avez donc besoin d'une connexion"],
    ] },
    { type: "heading",text: "Ajouter Tradovate à votre écran d'accueil : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez le web trader dans votre navigateur", html: "Ouvrez Safari sur un iPhone ou Chrome sur Android et saisissez <strong class='text-white'>trader.tradovate.com</strong> dans la barre d'adresse. Vous pouvez vous connecter d'abord ou le laisser sur l'écran de connexion : les deux fonctionnent pour l'épingler." },
        { title: "Ajoutez-le à l'écran d'accueil sur iPhone", html: "Appuyez sur le bouton <strong class='text-white'>Share</strong>, le carré avec une flèche pointant vers le haut. Selon votre version d'iOS, il se trouve dans la barre d'adresse ou en bas de l'écran. Faites défiler la feuille de partage vers le bas et appuyez sur <strong class='text-white'>Add to Home Screen</strong>. Donnez au raccourci un nom court comme « Tradovate », puis appuyez sur <strong class='text-white'>Add</strong>. Sur les versions récentes d'iOS, vous verrez un interrupteur <strong class='text-white'>Open as Web App</strong> déjà activé. Laissez-le activé. C'est ce qui permet au raccourci de s'ouvrir en plein écran plutôt que dans un onglet de navigateur classique. Si vous ne voyez pas du tout Add to Home Screen, faites défiler jusqu'au bas de la feuille de partage, appuyez sur <strong class='text-white'>Edit Actions</strong> et ajoutez-le d'abord à cet endroit." },
        { title: "Ajoutez-le à l'écran d'accueil sur Android", html: "Appuyez sur le <strong class='text-white'>menu à trois points</strong> dans le coin supérieur droit de Chrome. Cherchez <strong class='text-white'>Add to Home screen</strong>. Les versions récentes de Chrome l'appellent parfois <strong class='text-white'>Install app</strong> ou <strong class='text-white'>Install and create shortcut</strong> lorsqu'un site est reconnu comme application web, mais elles remplissent la même fonction. Appuyez dessus, confirmez le nom, puis appuyez sur <strong class='text-white'>Add</strong> ou <strong class='text-white'>Install</strong>. Chrome dépose l'icône sur votre écran d'accueil ou vous laisse la placer où vous le souhaitez." },
        { title: "Ouvrez-le comme une application et connectez-vous", html: "Vous avez maintenant une icône Tradovate à côté de vos autres applications. Appuyez dessus : le web trader s'ouvre en plein écran, la barre du navigateur étant masquée, si bien qu'il ressemble et se comporte comme une application native. Connectez-vous et vous pouvez trader." },
      ],
    },
    { type: "heading",text: "Quelques points à connaître" },
    {
      type: "list",
      items: [
        "Il s'agit de la plateforme web complète, et non de l'application native allégée : vous conservez donc les mêmes graphiques, le même SuperDOM, les mêmes stratégies ATM et les mêmes paramètres de risque que sur ordinateur.",
        "Le raccourci est en réalité un signet doté d'une icône. Il n'y a rien à mettre à jour, car il charge toujours le site en direct.",
        "Vous voulez que votre téléphone vibre lorsque le prix atteint un niveau alors que l'application est fermée ? Configurez des alertes de prix sur vos graphiques Tradovate avant de vous éloigner.",
        "Vous êtes déconnecté à l'ouverture ? Cela vient généralement de la limite de sessions actives. Déconnectez-vous de la plateforme sur vos autres appareils et de TradingView, puis reconnectez-vous uniquement sur votre téléphone.",
      ],
    },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Votre raccourci sur l'écran d'accueil vous permet de surveiller le marché de n'importe où. Vous voulez que votre téléphone passe réellement les ordres à votre place à partir d'une alerte TradingView ? PickMyTrade automatise Tradovate pour que votre stratégie s'exécute, que l'application soit ouverte ou non." },
  ], it: [
    { type: "paragraph",html: "Il web trader su <strong class='text-white'>trader.tradovate.com</strong> è la stessa piattaforma completa che usa sul desktop. Grafici, SuperDOM, ticket degli ordini, strategie ATM, impostazioni di rischio, tutto, solo caricato nel browser del suo telefono. Ciò che la maggior parte delle persone non sa è che può aggiungerlo alla schermata Home in modo che si apra a schermo intero con una propria icona, senza alcun download dall'App Store o dal Play Store." },
    { type: "paragraph",html: "Perché prendersi il disturbo, se esiste già un'app nativa? Per due motivi. Il web trader le offre il layout completo anziché l'app mobile ridotta, e se la sua prop firm le ha fornito credenziali solo web, questo è spesso il modo più pulito per operare dal telefono. Il tutto richiede meno di un minuto. Ecco come fare." },
    { type: "heading",text: "Che cosa le serve" },
    { type: "table", headers: ["Elemento","Dettagli"], rows: [
      ["Un telefono","iPhone con Safari, oppure Android con Chrome"],
      ["Le sue credenziali","Quelle di Tradovate o della sua prop firm"],
      ["Internet","Il collegamento carica sempre il sito live, quindi serve una connessione"],
    ] },
    { type: "heading",text: "Aggiungere Tradovate alla schermata Home: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Apra il web trader nel browser", html: "Apra Safari su un iPhone o Chrome su Android e digiti <strong class='text-white'>trader.tradovate.com</strong> nella barra degli indirizzi. Può accedere prima oppure lasciarlo sulla schermata di login: in entrambi i casi funziona per aggiungerlo." },
        { title: "Lo aggiunga alla schermata Home su iPhone", html: "Tocchi il pulsante <strong class='text-white'>Share</strong>, il quadrato con una freccia rivolta verso l'alto. A seconda della versione di iOS si trova nella barra degli indirizzi o nella parte inferiore dello schermo. Scorra verso il basso nel foglio di condivisione e tocchi <strong class='text-white'>Add to Home Screen</strong>. Dia al collegamento un nome breve come \"Tradovate\", quindi tocchi <strong class='text-white'>Add</strong>. Sulle versioni più recenti di iOS vedrà un interruttore <strong class='text-white'>Open as Web App</strong> già attivato. Lo lasci attivo. È ciò che fa aprire il collegamento a schermo intero anziché in una normale scheda del browser. Se non vede affatto Add to Home Screen, scorra in fondo al foglio di condivisione, tocchi <strong class='text-white'>Edit Actions</strong> e lo aggiunga prima lì." },
        { title: "Lo aggiunga alla schermata Home su Android", html: "Tocchi il <strong class='text-white'>menu a tre puntini</strong> nell'angolo in alto a destra di Chrome. Cerchi <strong class='text-white'>Add to Home screen</strong>. Le versioni recenti di Chrome a volte lo chiamano <strong class='text-white'>Install app</strong> o <strong class='text-white'>Install and create shortcut</strong> quando un sito si qualifica come app web, ma svolgono la stessa funzione. Lo tocchi, confermi il nome, poi tocchi <strong class='text-white'>Add</strong> o <strong class='text-white'>Install</strong>. Chrome colloca l'icona nella schermata Home oppure le permette di posizionarla dove preferisce." },
        { title: "Lo apra come un'app e acceda", html: "Ora avrà un'icona di Tradovate accanto alle altre app. La tocchi e il web trader si apre a schermo intero con la barra del browser nascosta, così appare e si comporta come un'app nativa. Acceda e potrà operare." },
      ],
    },
    { type: "heading",text: "Alcune cose utili da sapere" },
    {
      type: "list",
