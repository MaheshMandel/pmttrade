---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-customize-superdom";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Customize Tradovate SuperDOM Columns & Colors";
const META_DESCRIPTION =
  "Set up your Tradovate SuperDOM the way you trade: show or hide columns, turn on bid and ask histograms, switch P/L to ticks, and color-code your orders.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate SuperDOM anpassen: Spalten und Farben", es: "Personalice las columnas y los colores del SuperDOM de Tradovate", fr: "Personnaliser les colonnes et les couleurs du SuperDOM Tradovate", it: "Personalizzare colonne e colori del SuperDOM di Tradovate" },
  dek: { en: "Out of the box the SuperDOM shows more than you need. Here's how to show only the columns you use, turn on the bid/ask histogram, set how P/L reads, and color-code your orders and rows, step by step.", de: "Standardmäßig zeigt das SuperDOM mehr an, als Sie brauchen. So blenden Sie nur die Spalten ein, die Sie nutzen, aktivieren das Bid/Ask-Histogramm, legen die G/V-Anzeige fest und färben Ihre Orders und Zeilen ein, Schritt für Schritt.", es: "De fábrica, el SuperDOM muestra más de lo que necesita. Así puede mostrar solo las columnas que usa, activar el histograma bid/ask, definir cómo se lee el P/L y asignar colores a sus órdenes y filas, paso a paso.", fr: "Par défaut, le SuperDOM affiche plus que nécessaire. Voici comment n'afficher que les colonnes que vous utilisez, activer l'histogramme bid/ask, définir l'affichage du P/L et attribuer des couleurs à vos ordres et à vos lignes, étape par étape.", it: "Di default il SuperDOM mostra più del necessario. Ecco come mostrare solo le colonne che utilizza, attivare l'istogramma bid/ask, impostare la visualizzazione del P/L e colorare i Suoi ordini e le righe, passo dopo passo." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "The SuperDOM is where a lot of futures traders spend the whole session, so it pays to make it read the way your eyes work. Out of the box it shows more columns than you need and uses default colors that don't always separate your working orders from your fills at a glance. A few minutes in the settings panel gets you a ladder that shows only what matters and flags every order clearly. Here's how to set it up." },
    { type: "paragraph", html: "The steps below are for Tradovate Web; the desktop app follows the same layout. If you're still learning the click-to-trade mechanics first, start with <a href='https://pickmytrade.trade/how-to/tradovate-superdom-basics/'>placing orders on the SuperDOM ladder</a>, then come back to dial in the display." },
    { type: "heading", text: "What You Can Customize on the SuperDOM" },
    { type: "paragraph", html: "The SuperDOM settings break down into three areas: which <strong class='text-white'>columns</strong> appear, how the ladder <strong class='text-white'>looks</strong> (histograms, colors, P/L), and how <strong class='text-white'>orders</strong> behave when you click. This guide covers the display side, columns, histograms, colors, and P/L. Every change applies to the DOM you're editing, so you can run one ladder for scalping and another for swing entries with different setups." },
    { type: "heading", text: "Customizing Your SuperDOM: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open the SuperDOM Settings", html: "Load a SuperDOM for the contract you trade. Look for the gear (settings) icon in the top-right corner of the DOM module and click <strong class='text-white'>Settings</strong> to open the panel. On some builds this lives behind a three-dot menu or a right-click on the ladder itself, either way you're after the same Settings window. If you don't see it right away, hover over the module's title bar and the icon should appear." },
        { title: "Show Only the Columns You Use", html: "The settings group your columns together with on/off toggles. A standard ladder runs Bid Size, Bid, Price, Ask, Ask Size, and an optional Position/P&amp;L column. Turn off anything you don't actually read, a clean size / price / size layout is far faster to scan when the market's moving fast." },
        { title: "Turn On the Bid/Ask Histogram", html: "Flip on <strong class='text-white'>Show Bid/Ask Histogram</strong> to draw green and red size bars inside the Bid and Ask columns. Instead of reading raw numbers, you see resting liquidity as bar length, which makes big walls of size jump out immediately. There's a separate toggle to print the volume number inside each bar if you want the count and the bar together." },
        { title: "Set How P/L Reads", html: "Decide how your open profit and loss shows on the ladder. You can display it as a dollar amount or in <strong class='text-white'>ticks</strong>, ticks is handy if you think in points rather than currency. Turn on <strong class='text-white'>Show Estimated P/L</strong> and the DOM projects what your open position would be worth at each price level, so you can eyeball your risk and reward straight off the ladder before you even set a stop." },
        { title: "Color-Code Your Orders and Rows", html: "This is where the ladder becomes readable under pressure. In the appearance settings you can set the fill color for the bid and ask sides, the best-bid and best-ask rows, and the hover highlight that follows your cursor down the price column. Separately, give each order type its own color, working limits, stops, and filled orders, so you can tell a stop from a target without reading a single label. Pick colors with enough contrast that you never confuse the two mid-trade. If you run bracket orders, this pairs well with an <a href='https://pickmytrade.trade/how-to/tradovate-atm-strategies/'>ATM strategy</a> so your stop and target auto-attach and show up on the ladder in their own colors on every entry." },
        { title: "Save Your Layout", html: "Your changes apply to the DOM you edited. Once it looks right, save your workspace or layout so the same columns and colors come back next session instead of snapping to defaults. If you trade more than one instrument, save a separate layout for each so every ladder opens ready to go." },
      ],
    },
    { type: "table", headers: ["Column", "What it shows"], rows: [
      ["Bid Size", "Resting buy quantity at each price"],
      ["Bid", "The buy side of the ladder"],
      ["Price", "The price ladder itself, centered on the last trade"],
      ["Ask", "The sell side of the ladder"],
      ["Ask Size", "Resting sell quantity at each price"],
      ["Position / P&L", "Your open size and running profit or loss"],
    ] },
    { type: "heading", text: "Why You'd Set This Up" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Read the ladder faster</strong>, fewer columns and clear histograms mean less to process when you're clicking fills.",
        "<strong class='text-white'>Cut order mistakes</strong>, color-coded stops and targets are hard to mix up in a fast market.",
        "<strong class='text-white'>Match your mental math</strong>, P/L in ticks or dollars, whichever way you actually think about risk.",
        "<strong class='text-white'>Stay consistent</strong>, a saved layout means the same setup every session, on every contract you trade.",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "A clean SuperDOM helps most when you're clicking your own entries. If you'd rather have your strategy fire on its own, <strong class='text-white'>PickMyTrade routes your TradingView alerts straight to your Tradovate account</strong> so entries, stops, and targets execute without you touching the ladder." },
  ], de: [
    { type: "paragraph",html: "Das SuperDOM ist der Ort, an dem viele Futures-Trader die gesamte Sitzung verbringen, daher lohnt es sich, es so einzurichten, wie Ihre Augen arbeiten. Standardmäßig zeigt es mehr Spalten an, als Sie brauchen, und verwendet Standardfarben, die Ihre aktiven Orders nicht immer auf einen Blick von Ihren Fills unterscheiden. Ein paar Minuten im Einstellungsfenster genügen für eine Leiter, die nur das Wesentliche zeigt und jede Order klar kennzeichnet. So richten Sie sie ein." },
    { type: "paragraph",html: "Die folgenden Schritte gelten für Tradovate Web; die Desktop-App hat dasselbe Layout. Wenn Sie zuerst die Click-to-Trade-Mechanik lernen möchten, beginnen Sie mit <a href='https://pickmytrade.trade/how-to/tradovate-superdom-basics/'>Orders auf der SuperDOM-Leiter platzieren</a> und kehren Sie dann zurück, um die Anzeige zu optimieren." },
    { type: "heading",text: "Was Sie am SuperDOM anpassen können" },
    { type: "paragraph",html: "Die SuperDOM-Einstellungen gliedern sich in drei Bereiche: welche <strong class='text-white'>Spalten</strong> erscheinen, wie die Leiter <strong class='text-white'>aussieht</strong> (Histogramme, Farben, G/V) und wie sich <strong class='text-white'>Orders</strong> beim Klicken verhalten. Diese Anleitung behandelt die Anzeigeseite: Spalten, Histogramme, Farben und G/V. Jede Änderung gilt für das DOM, das Sie gerade bearbeiten, sodass Sie eine Leiter für das Scalping und eine andere für Swing-Einstiege mit unterschiedlichen Setups betreiben können." },
    { type: "heading",text: "SuperDOM anpassen: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "SuperDOM-Einstellungen öffnen", html: "Laden Sie ein SuperDOM für den Kontrakt, den Sie handeln. Suchen Sie das Zahnrad-Symbol (Einstellungen) in der oberen rechten Ecke des DOM-Moduls und klicken Sie auf <strong class='text-white'>Settings</strong>, um das Fenster zu öffnen. In manchen Versionen befindet es sich hinter einem Drei-Punkte-Menü oder einem Rechtsklick auf die Leiter selbst, in jedem Fall suchen Sie dasselbe Settings-Fenster. Wenn Sie es nicht sofort sehen, fahren Sie mit der Maus über die Titelleiste des Moduls, dann sollte das Symbol erscheinen." },
        { title: "Nur die genutzten Spalten anzeigen", html: "Die Einstellungen gruppieren Ihre Spalten mit Ein/Aus-Schaltern. Eine Standardleiter besteht aus Bid Size, Bid, Price, Ask, Ask Size und einer optionalen Position/P&amp;L-Spalte. Schalten Sie alles aus, was Sie nicht wirklich lesen, ein klares Layout aus Größe / Preis / Größe lässt sich bei schnellem Markt deutlich schneller erfassen." },
        { title: "Bid/Ask-Histogramm aktivieren", html: "Aktivieren Sie <strong class='text-white'>Show Bid/Ask Histogram</strong>, um grüne und rote Größenbalken in den Spalten Bid und Ask darzustellen. Statt reine Zahlen zu lesen, sehen Sie die ruhende Liquidität als Balkenlänge, wodurch große Größenwände sofort auffallen. Es gibt einen separaten Schalter, um die Volumenzahl innerhalb jedes Balkens anzuzeigen, wenn Sie Anzahl und Balken zusammen sehen möchten." },
        { title: "Festlegen, wie G/V angezeigt wird", html: "Legen Sie fest, wie Ihr offener Gewinn und Verlust auf der Leiter erscheint. Sie können ihn als Dollarbetrag oder in <strong class='text-white'>Ticks</strong> anzeigen, Ticks sind praktisch, wenn Sie in Punkten statt in Währung denken. Aktivieren Sie <strong class='text-white'>Show Estimated P/L</strong>, und das DOM projiziert, was Ihre offene Position auf jedem Preisniveau wert wäre, sodass Sie Risiko und Chance direkt von der Leiter ablesen können, noch bevor Sie einen Stop setzen." },
        { title: "Orders und Zeilen farblich kennzeichnen", html: "Hier wird die Leiter auch unter Druck lesbar. In den Darstellungseinstellungen können Sie die Füllfarbe für die Bid- und Ask-Seite, die Zeilen mit dem besten Bid und besten Ask sowie die Hover-Hervorhebung festlegen, die Ihrem Cursor die Preisspalte entlang folgt. Geben Sie außerdem jedem Ordertyp eine eigene Farbe, aktive Limits, Stops und ausgeführte Orders, damit Sie einen Stop von einem Ziel unterscheiden, ohne ein einziges Label zu lesen. Wählen Sie Farben mit ausreichend Kontrast, damit Sie die beiden mitten im Trade nie verwechseln. Wenn Sie Bracket-Orders nutzen, passt dazu gut eine <a href='https://pickmytrade.trade/how-to/tradovate-atm-strategies/'>ATM-Strategie</a>, sodass Stop und Ziel automatisch angehängt werden und bei jedem Einstieg in ihren eigenen Farben auf der Leiter erscheinen." },
        { title: "Layout speichern", html: "Ihre Änderungen gelten für das DOM, das Sie bearbeitet haben. Sobald es passt, speichern Sie Ihren Workspace oder Ihr Layout, damit dieselben Spalten und Farben in der nächsten Sitzung zurückkehren, statt auf die Standardwerte zurückzuspringen. Wenn Sie mehrere Instrumente handeln, speichern Sie für jedes ein eigenes Layout, damit jede Leiter einsatzbereit öffnet." },
      ],
    },
    { type: "table", headers: ["Spalte","Was sie zeigt"], rows: [
      ["Bid Size","Ruhende Kaufmenge auf jedem Preisniveau"],
      ["Bid","Die Kaufseite der Leiter"],
      ["Price","Die Preisleiter selbst, zentriert auf den letzten Trade"],
      ["Ask","Die Verkaufsseite der Leiter"],
      ["Ask Size","Ruhende Verkaufsmenge auf jedem Preisniveau"],
      ["Position / P&L","Ihre offene Größe und der laufende Gewinn oder Verlust"],
    ] },
    { type: "heading",text: "Warum Sie dies einrichten sollten" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Die Leiter schneller lesen</strong>, weniger Spalten und klare Histogramme bedeuten weniger zu verarbeiten, wenn Sie Fills klicken.",
        "<strong class='text-white'>Orderfehler reduzieren</strong>, farblich gekennzeichnete Stops und Ziele lassen sich im schnellen Markt kaum verwechseln.",
        "<strong class='text-white'>Zur eigenen Denkweise passen</strong>, G/V in Ticks oder Dollar, so wie Sie Risiko tatsächlich betrachten.",
        "<strong class='text-white'>Konsistent bleiben</strong>, ein gespeichertes Layout bedeutet in jeder Sitzung und bei jedem Kontrakt dasselbe Setup.",
      ],
    },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "Ein aufgeräumtes SuperDOM hilft am meisten, wenn Sie Ihre Einstiege selbst klicken. Wenn Sie lieber möchten, dass Ihre Strategie von selbst auslöst, <strong class='text-white'>leitet PickMyTrade Ihre TradingView-Alerts direkt an Ihr Tradovate-Konto weiter</strong>, sodass Einstiege, Stops und Ziele ausgeführt werden, ohne dass Sie die Leiter anfassen." },
  ], es: [
    { type: "paragraph",html: "El SuperDOM es donde muchos traders de futuros pasan toda la sesión, así que conviene configurarlo para que se lea como trabaja su vista. De fábrica muestra más columnas de las que necesita y usa colores predeterminados que no siempre distinguen de un vistazo sus órdenes pendientes de sus ejecuciones. Unos minutos en el panel de ajustes le dan una escalera que muestra solo lo importante y señala cada orden con claridad. Así se configura." },
    { type: "paragraph",html: "Los pasos siguientes son para Tradovate Web; la aplicación de escritorio sigue el mismo diseño. Si primero quiere aprender la mecánica del click-to-trade, empiece con <a href='https://pickmytrade.trade/how-to/tradovate-superdom-basics/'>cómo colocar órdenes en la escalera del SuperDOM</a> y luego vuelva para afinar la visualización." },
    { type: "heading",text: "Qué puede personalizar en el SuperDOM" },
    { type: "paragraph",html: "Los ajustes del SuperDOM se dividen en tres áreas: qué <strong class='text-white'>columnas</strong> aparecen, cómo se <strong class='text-white'>ve</strong> la escalera (histogramas, colores, P/L) y cómo se comportan las <strong class='text-white'>órdenes</strong> al hacer clic. Esta guía cubre la parte visual: columnas, histogramas, colores y P/L. Cada cambio se aplica al DOM que está editando, de modo que puede usar una escalera para scalping y otra para entradas swing con configuraciones distintas." },
    { type: "heading",text: "Personalizar su SuperDOM: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra los ajustes del SuperDOM", html: "Cargue un SuperDOM para el contrato que opera. Busque el icono de engranaje (ajustes) en la esquina superior derecha del módulo DOM y haga clic en <strong class='text-white'>Settings</strong> para abrir el panel. En algunas versiones está detrás de un menú de tres puntos o de un clic derecho sobre la propia escalera; en cualquier caso, busca la misma ventana de Settings. Si no lo ve de inmediato, pase el cursor sobre la barra de título del módulo y el icono debería aparecer." },
        { title: "Muestre solo las columnas que usa", html: "Los ajustes agrupan sus columnas con interruptores de activación. Una escalera estándar incluye Bid Size, Bid, Price, Ask, Ask Size y una columna opcional de Position/P&amp;L. Desactive todo lo que no lea realmente; un diseño limpio de tamaño / precio / tamaño es mucho más rápido de escanear cuando el mercado se mueve deprisa." },
        { title: "Active el histograma bid/ask", html: "Active <strong class='text-white'>Show Bid/Ask Histogram</strong> para dibujar barras de tamaño verdes y rojas dentro de las columnas Bid y Ask. En lugar de leer números en bruto, ve la liquidez pendiente como longitud de barra, lo que hace que los grandes muros de tamaño destaquen de inmediato. Hay un interruptor aparte para imprimir el número de volumen dentro de cada barra si quiere ver la cifra y la barra juntas." },
        { title: "Defina cómo se lee el P/L", html: "Decida cómo se muestran sus ganancias y pérdidas abiertas en la escalera. Puede verlas como un importe en dólares o en <strong class='text-white'>ticks</strong>; los ticks son prácticos si piensa en puntos en lugar de moneda. Active <strong class='text-white'>Show Estimated P/L</strong> y el DOM proyecta cuánto valdría su posición abierta en cada nivel de precio, de modo que puede evaluar su riesgo y beneficio directamente en la escalera antes incluso de colocar un stop." },
        { title: "Asigne colores a sus órdenes y filas", html: "Aquí es donde la escalera se vuelve legible bajo presión. En los ajustes de apariencia puede definir el color de relleno de los lados bid y ask, de las filas del mejor bid y del mejor ask, y del resaltado al pasar el cursor que sigue su puntero por la columna de precios. Además, dé a cada tipo de orden su propio color, límites pendientes, stops y órdenes ejecutadas, para distinguir un stop de un objetivo sin leer una sola etiqueta. Elija colores con suficiente contraste para no confundirlos nunca en pleno trade. Si usa órdenes bracket, esto combina bien con una <a href='https://pickmytrade.trade/how-to/tradovate-atm-strategies/'>estrategia ATM</a>, de modo que su stop y su objetivo se adjunten automáticamente y aparezcan en la escalera con sus propios colores en cada entrada." },
        { title: "Guarde su diseño", html: "Sus cambios se aplican al DOM que editó. Cuando todo esté bien, guarde su espacio de trabajo o diseño para que las mismas columnas y colores vuelvan en la próxima sesión en lugar de restablecerse a los valores predeterminados. Si opera más de un instrumento, guarde un diseño distinto para cada uno, de modo que cada escalera se abra lista para usar." },
      ],
    },
    { type: "table", headers: ["Columna","Qué muestra"], rows: [
      ["Bid Size","Cantidad de compra pendiente en cada precio"],
      ["Bid","El lado comprador de la escalera"],
      ["Price","La propia escalera de precios, centrada en la última operación"],
      ["Ask","El lado vendedor de la escalera"],
      ["Ask Size","Cantidad de venta pendiente en cada precio"],
      ["Position / P&L","Su tamaño abierto y la ganancia o pérdida en curso"],
    ] },
    { type: "heading",text: "Por qué conviene configurarlo" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Lea la escalera más rápido</strong>, menos columnas e histogramas claros significan menos que procesar mientras hace clic en las ejecuciones.",
        "<strong class='text-white'>Reduzca los errores de orden</strong>, los stops y objetivos con colores son difíciles de confundir en un mercado rápido.",
        "<strong class='text-white'>Ajústese a su cálculo mental</strong>, P/L en ticks o en dólares, como realmente piense en el riesgo.",
        "<strong class='text-white'>Mantenga la coherencia</strong>, un diseño guardado significa la misma configuración en cada sesión y en cada contrato que opere.",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Un SuperDOM limpio ayuda más cuando hace clic en sus propias entradas. Si prefiere que su estrategia se dispare sola, <strong class='text-white'>PickMyTrade envía sus alertas de TradingView directamente a su cuenta de Tradovate</strong> para que las entradas, los stops y los objetivos se ejecuten sin que usted toque la escalera." },
  ], fr: [
    { type: "paragraph",html: "Le SuperDOM est l'endroit où de nombreux traders de futures passent toute la session ; il vaut donc la peine de le configurer pour qu'il se lise comme votre regard fonctionne. Par défaut, il affiche plus de colonnes que nécessaire et utilise des couleurs standard qui ne distinguent pas toujours d'un coup d'œil vos ordres en attente de vos exécutions. Quelques minutes dans le panneau des paramètres suffisent pour obtenir une échelle qui n'affiche que l'essentiel et signale clairement chaque ordre. Voici comment la configurer." },
    { type: "paragraph",html: "Les étapes ci-dessous concernent Tradovate Web ; l'application de bureau suit la même disposition. Si vous souhaitez d'abord apprendre la mécanique du click-to-trade, commencez par <a href='https://pickmytrade.trade/how-to/tradovate-superdom-basics/'>passer des ordres sur l'échelle du SuperDOM</a>, puis revenez affiner l'affichage." },
    { type: "heading",text: "Ce que vous pouvez personnaliser sur le SuperDOM" },
    { type: "paragraph",html: "Les paramètres du SuperDOM se répartissent en trois domaines : les <strong class='text-white'>colonnes</strong> affichées, l'<strong class='text-white'>apparence</strong> de l'échelle (histogrammes, couleurs, P/L) et le comportement des <strong class='text-white'>ordres</strong> lorsque vous cliquez. Ce guide couvre le volet affichage : colonnes, histogrammes, couleurs et P/L. Chaque modification s'applique au DOM que vous modifiez ; vous pouvez donc utiliser une échelle pour le scalping et une autre pour des entrées swing avec des configurations différentes." },
    { type: "heading",text: "Personnaliser votre SuperDOM : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir les paramètres du SuperDOM", html: "Chargez un SuperDOM pour le contrat que vous tradez. Repérez l'icône d'engrenage (paramètres) dans le coin supérieur droit du module DOM et cliquez sur <strong class='text-white'>Settings</strong> pour ouvrir le panneau. Dans certaines versions, elle se trouve derrière un menu à trois points ou un clic droit sur l'échelle elle-même ; dans tous les cas, vous cherchez la même fenêtre Settings. Si vous ne la voyez pas tout de suite, survolez la barre de titre du module et l'icône devrait apparaître." },
        { title: "N'afficher que les colonnes que vous utilisez", html: "Les paramètres regroupent vos colonnes avec des interrupteurs d'activation. Une échelle standard comprend Bid Size, Bid, Price, Ask, Ask Size et une colonne facultative Position/P&amp;L. Désactivez tout ce que vous ne lisez pas réellement ; une disposition épurée taille / prix / taille se parcourt bien plus vite quand le marché s'emballe." },
        { title: "Activer l'histogramme bid/ask", html: "Activez <strong class='text-white'>Show Bid/Ask Histogram</strong> pour dessiner des barres de taille vertes et rouges dans les colonnes Bid et Ask. Au lieu de lire des chiffres bruts, vous voyez la liquidité en attente sous forme de longueur de barre, ce qui fait immédiatement ressortir les gros murs de taille. Un interrupteur distinct permet d'afficher le volume à l'intérieur de chaque barre si vous souhaitez voir le chiffre et la barre ensemble." },
        { title: "Définir l'affichage du P/L", html: "Décidez comment vos gains et pertes ouverts s'affichent sur l'échelle. Vous pouvez les afficher en montant en dollars ou en <strong class='text-white'>ticks</strong> ; les ticks sont pratiques si vous raisonnez en points plutôt qu'en devise. Activez <strong class='text-white'>Show Estimated P/L</strong> et le DOM projette ce que vaudrait votre position ouverte à chaque niveau de prix, ce qui vous permet d'évaluer votre risque et votre gain directement sur l'échelle avant même de placer un stop." },
        { title: "Attribuer des couleurs à vos ordres et à vos lignes", html: "C'est ici que l'échelle devient lisible sous pression. Dans les paramètres d'apparence, vous pouvez définir la couleur de remplissage des côtés bid et ask, des lignes du meilleur bid et du meilleur ask, ainsi que la surbrillance au survol qui suit votre curseur le long de la colonne des prix. Par ailleurs, donnez à chaque type d'ordre sa propre couleur, limites en attente, stops et ordres exécutés, afin de distinguer un stop d'un objectif sans lire la moindre étiquette. Choisissez des couleurs suffisamment contrastées pour ne jamais les confondre en plein trade. Si vous utilisez des ordres bracket, cela se combine bien avec une <a href='https://pickmytrade.trade/how-to/tradovate-atm-strategies/'>stratégie ATM</a> : votre stop et votre objectif se rattachent automatiquement et apparaissent sur l'échelle dans leurs propres couleurs à chaque entrée." },
        { title: "Enregistrer votre disposition", html: "Vos modifications s'appliquent au DOM que vous avez modifié. Une fois le résultat satisfaisant, enregistrez votre espace de travail ou votre disposition afin que les mêmes colonnes et couleurs reviennent à la prochaine session au lieu de revenir aux valeurs par défaut. Si vous tradez plusieurs instruments, enregistrez une disposition distincte pour chacun afin que chaque échelle s'ouvre prête à l'emploi." },
      ],
    },
    { type: "table", headers: ["Colonne","Ce qu'elle affiche"], rows: [
      ["Bid Size","Quantité d'achat en attente à chaque prix"],
      ["Bid","Le côté acheteur de l'échelle"],
      ["Price","L'échelle de prix elle-même, centrée sur la dernière transaction"],
      ["Ask","Le côté vendeur de l'échelle"],
      ["Ask Size","Quantité de vente en attente à chaque prix"],
      ["Position / P&L","Votre taille ouverte et le gain ou la perte en cours"],
    ] },
    { type: "heading",text: "Pourquoi le configurer" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Lire l'échelle plus vite</strong>, moins de colonnes et des histogrammes clairs signifient moins à traiter lorsque vous cliquez vos exécutions.",
        "<strong class='text-white'>Réduire les erreurs d'ordre</strong>, des stops et des objectifs codés par couleur se confondent difficilement sur un marché rapide.",
        "<strong class='text-white'>Coller à votre calcul mental</strong>, P/L en ticks ou en dollars, selon votre façon réelle d'envisager le risque.",
        "<strong class='text-white'>Rester cohérent</strong>, une disposition enregistrée garantit la même configuration à chaque session et sur chaque contrat que vous tradez.",
      ],
    },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Un SuperDOM épuré aide surtout lorsque vous cliquez vos propres entrées. Si vous préférez que votre stratégie se déclenche seule, <strong class='text-white'>PickMyTrade achemine vos alertes TradingView directement vers votre compte Tradovate</strong> afin que les entrées, les stops et les objectifs s'exécutent sans que vous touchiez à l'échelle." },
  ], it: [
    { type: "paragraph",html: "Il SuperDOM è il luogo in cui molti trader di futures trascorrono l'intera sessione, quindi vale la pena configurarlo in modo che si legga come lavora il Suo occhio. Di default mostra più colonne del necessario e usa colori predefiniti che non sempre distinguono a colpo d'occhio i Suoi ordini attivi dalle esecuzioni. Pochi minuti nel pannello delle impostazioni bastano per ottenere una scala che mostra solo ciò che conta e segnala chiaramente ogni ordine. Ecco come configurarla." },
    { type: "paragraph",html: "I passaggi seguenti riguardano Tradovate Web; l'app desktop segue lo stesso layout. Se desidera prima imparare la meccanica del click-to-trade, inizi con <a href='https://pickmytrade.trade/how-to/tradovate-superdom-basics/'>come piazzare ordini sulla scala del SuperDOM</a>, poi torni qui per perfezionare la visualizzazione." },
    { type: "heading",text: "Cosa può personalizzare nel SuperDOM" },
    { type: "paragraph",html: "Le impostazioni del SuperDOM si dividono in tre aree: quali <strong class='text-white'>colonne</strong> compaiono, come appare la scala (<strong class='text-white'>aspetto</strong>: istogrammi, colori, P/L) e come si comportano gli <strong class='text-white'>ordini</strong> quando clicca. Questa guida tratta il lato visualizzazione: colonne, istogrammi, colori e P/L. Ogni modifica si applica al DOM che sta modificando, quindi può usare una scala per lo scalping e un'altra per entrate swing con configurazioni diverse." },
    { type: "heading",text: "Personalizzare il SuperDOM: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Aprire le impostazioni del SuperDOM", html: "Carichi un SuperDOM per il contratto che negozia. Cerchi l'icona a forma di ingranaggio (impostazioni) nell'angolo in alto a destra del modulo DOM e clicchi su <strong class='text-white'>Settings</strong> per aprire il pannello. In alcune versioni si trova dietro un menu a tre puntini o un clic destro sulla scala stessa; in ogni caso sta cercando la stessa finestra Settings. Se non la vede subito, passi il mouse sulla barra del titolo del modulo e l'icona dovrebbe comparire." },
        { title: "Mostrare solo le colonne utilizzate", html: "Le impostazioni raggruppano le colonne con interruttori di attivazione. Una scala standard comprende Bid Size, Bid, Price, Ask, Ask Size e una colonna facoltativa Position/P&amp;L. Disattivi tutto ciò che non legge davvero; un layout pulito quantità / prezzo / quantità è molto più veloce da scorrere quando il mercato si muove velocemente." },
        { title: "Attivare l'istogramma bid/ask", html: "Attivi <strong class='text-white'>Show Bid/Ask Histogram</strong> per disegnare barre di quantità verdi e rosse all'interno delle colonne Bid e Ask. Invece di leggere numeri grezzi, vede la liquidità in attesa come lunghezza della barra, così i grandi muri di quantità saltano subito all'occhio. Esiste un interruttore separato per mostrare il numero del volume all'interno di ogni barra, se desidera vedere insieme il conteggio e la barra." },
        { title: "Impostare come viene letto il P/L", html: "Decida come mostrare il Suo profitto e la Sua perdita aperti sulla scala. Può visualizzarli come importo in dollari o in <strong class='text-white'>tick</strong>; i tick sono comodi se ragiona in punti anziché in valuta. Attivi <strong class='text-white'>Show Estimated P/L</strong> e il DOM proietta quanto varrebbe la Sua posizione aperta a ogni livello di prezzo, così può valutare rischio e rendimento direttamente dalla scala prima ancora di impostare uno stop." },
        { title: "Colorare ordini e righe", html: "È qui che la scala diventa leggibile sotto pressione. Nelle impostazioni di aspetto può impostare il colore di riempimento per i lati bid e ask, per le righe del miglior bid e del miglior ask e per l'evidenziazione al passaggio del mouse che segue il cursore lungo la colonna dei prezzi. Inoltre, assegni a ogni tipo di ordine il suo colore, limit attivi, stop e ordini eseguiti, così da distinguere uno stop da un target senza leggere alcuna etichetta. Scelga colori con contrasto sufficiente per non confonderli mai a trade in corso. Se utilizza ordini bracket, questo si abbina bene a una <a href='https://pickmytrade.trade/how-to/tradovate-atm-strategies/'>strategia ATM</a>, in modo che stop e target si colleghino automaticamente e compaiano sulla scala nei propri colori a ogni entrata." },
        { title: "Salvare il layout", html: "Le modifiche si applicano al DOM che ha modificato. Una volta soddisfatto, salvi il Suo workspace o layout affinché le stesse colonne e gli stessi colori tornino alla sessione successiva invece di tornare ai valori predefiniti. Se negozia più strumenti, salvi un layout separato per ciascuno, così ogni scala si apre già pronta." },
      ],
    },
    { type: "table", headers: ["Colonna","Cosa mostra"], rows: [
      ["Bid Size","Quantità in acquisto in attesa a ogni prezzo"],
      ["Bid","Il lato acquirente della scala"],
      ["Price","La scala dei prezzi stessa, centrata sull'ultimo scambio"],
      ["Ask","Il lato venditore della scala"],
      ["Ask Size","Quantità in vendita in attesa a ogni prezzo"],
      ["Position / P&L","La Sua dimensione aperta e il profitto o la perdita in corso"],
    ] },
    { type: "heading",text: "Perché configurarlo" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Leggere la scala più velocemente</strong>, meno colonne e istogrammi chiari significano meno da elaborare mentre clicca le esecuzioni.",
        "<strong class='text-white'>Ridurre gli errori sugli ordini</strong>, stop e target colorati sono difficili da confondere in un mercato veloce.",
        "<strong class='text-white'>Adattarsi al calcolo mentale</strong>, P/L in tick o in dollari, come ragiona realmente sul rischio.",
        "<strong class='text-white'>Restare coerenti</strong>, un layout salvato significa la stessa configurazione a ogni sessione e su ogni contratto che negozia.",
      ],
    },
    { type: "heading",text: "Automatizzi tutto questo con PickMyTrade" },
    { type: "paragraph",html: "Un SuperDOM ordinato è più utile quando clicca le Sue entrate manualmente. Se preferisce che la Sua strategia scatti da sola, <strong class='text-white'>PickMyTrade instrada i Suoi alert di TradingView direttamente al Suo conto Tradovate</strong>, così entrate, stop e target vengono eseguiti senza che debba toccare la scala." },
  ] },
  ctaHeading: { en: "Automate Your Tradovate Trades", de: "Automatisieren Sie Ihre Tradovate-Trades", es: "Automatice sus operaciones en Tradovate", fr: "Automatisez vos trades Tradovate", it: "Automatizzi i Suoi trade su Tradovate" },
  ctaText: { en: "A clean SuperDOM helps most when you're clicking your own entries. Let PickMyTrade route your TradingView alerts straight to your Tradovate account so entries, stops, and targets execute without you touching the ladder.", de: "Ein aufgeräumtes SuperDOM hilft am meisten, wenn Sie Ihre Einstiege selbst klicken. Lassen Sie PickMyTrade Ihre TradingView-Alerts direkt an Ihr Tradovate-Konto weiterleiten, damit Einstiege, Stops und Ziele ausgeführt werden, ohne dass Sie die Leiter anfassen.", es: "Un SuperDOM limpio ayuda más cuando hace clic en sus propias entradas. Deje que PickMyTrade envíe sus alertas de TradingView directamente a su cuenta de Tradovate para que las entradas, los stops y los objetivos se ejecuten sin que usted toque la escalera.", fr: "Un SuperDOM épuré aide surtout lorsque vous cliquez vos propres entrées. Laissez PickMyTrade acheminer vos alertes TradingView directement vers votre compte Tradovate afin que les entrées, les stops et les objectifs s'exécutent sans que vous touchiez à l'échelle.", it: "Un SuperDOM ordinato è più utile quando clicca le Sue entrate manualmente. Lasci che PickMyTrade instradi i Suoi alert di TradingView direttamente al Suo conto Tradovate, così entrate, stop e target vengono eseguiti senza che debba toccare la scala." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Where are the SuperDOM settings in Tradovate?", a: "Open a SuperDOM and click the gear (settings) icon in the top-right of the module, then choose Settings. Depending on your build it may sit behind a three-dot menu or a right-click on the ladder, the panel it opens is the same either way." },
    { q: "Can I show profit and loss in ticks instead of dollars?", a: "Yes. In the DOM settings you can switch the open P/L display between a currency amount and a number of ticks, and turn on Show Estimated P/L to see your projected result at each price level." },
    { q: "Do my SuperDOM settings save between sessions?", a: "Settings apply to the DOM you edit, so save your workspace or layout once it's set up. That way your columns, histogram, and colors reload the next time instead of resetting to the defaults." },
  ], de: [
    { q: "Wo finde ich die SuperDOM-Einstellungen in Tradovate?", a: "Öffnen Sie ein SuperDOM und klicken Sie oben rechts im Modul auf das Zahnrad-Symbol (Einstellungen), und wählen Sie dann Settings. Je nach Version befindet es sich hinter einem Drei-Punkte-Menü oder einem Rechtsklick auf die Leiter, das sich öffnende Fenster ist in beiden Fällen dasselbe." },
    { q: "Kann ich Gewinn und Verlust in Ticks statt in Dollar anzeigen?", a: "Ja. In den DOM-Einstellungen können Sie die Anzeige des offenen G/V zwischen einem Währungsbetrag und einer Anzahl von Ticks umschalten und Show Estimated P/L aktivieren, um Ihr voraussichtliches Ergebnis auf jedem Preisniveau zu sehen." },
    { q: "Bleiben meine SuperDOM-Einstellungen zwischen Sitzungen erhalten?", a: "Die Einstellungen gelten für das DOM, das Sie bearbeiten. Speichern Sie daher Ihren Workspace oder Ihr Layout, sobald alles eingerichtet ist. So werden Ihre Spalten, das Histogramm und die Farben beim nächsten Mal wieder geladen, statt auf die Standardwerte zurückzuspringen." },
  ], es: [
    { q: "¿Dónde están los ajustes del SuperDOM en Tradovate?", a: "Abra un SuperDOM y haga clic en el icono de engranaje (ajustes) en la esquina superior derecha del módulo; después elija Settings. Según su versión, puede estar detrás de un menú de tres puntos o de un clic derecho sobre la escalera; el panel que se abre es el mismo en ambos casos." },
    { q: "¿Puedo mostrar las ganancias y pérdidas en ticks en lugar de dólares?", a: "Sí. En los ajustes del DOM puede alternar la visualización del P/L abierto entre un importe en moneda y un número de ticks, y activar Show Estimated P/L para ver su resultado proyectado en cada nivel de precio." },
    { q: "¿Se guardan mis ajustes del SuperDOM entre sesiones?", a: "Los ajustes se aplican al DOM que edita, por lo que debe guardar su espacio de trabajo o diseño una vez configurado. Así, sus columnas, histograma y colores se cargarán la próxima vez en lugar de volver a los valores predeterminados." },
  ], fr: [
    { q: "Où se trouvent les paramètres du SuperDOM dans Tradovate ?", a: "Ouvrez un SuperDOM et cliquez sur l'icône d'engrenage (paramètres) en haut à droite du module, puis choisissez Settings. Selon votre version, elle peut se trouver derrière un menu à trois points ou un clic droit sur l'échelle ; le panneau qui s'ouvre est le même dans les deux cas." },
    { q: "Puis-je afficher les gains et pertes en ticks plutôt qu'en dollars ?", a: "Oui. Dans les paramètres du DOM, vous pouvez basculer l'affichage du P/L ouvert entre un montant en devise et un nombre de ticks, et activer Show Estimated P/L pour voir votre résultat projeté à chaque niveau de prix." },
    { q: "Mes paramètres du SuperDOM sont-ils conservés d'une session à l'autre ?", a: "Les paramètres s'appliquent au DOM que vous modifiez ; enregistrez donc votre espace de travail ou votre disposition une fois la configuration terminée. Ainsi, vos colonnes, votre histogramme et vos couleurs se rechargeront la prochaine fois au lieu de revenir aux valeurs par défaut." },
  ], it: [
    { q: "Dove si trovano le impostazioni del SuperDOM in Tradovate?", a: "Apra un SuperDOM e clicchi sull'icona a forma di ingranaggio (impostazioni) in alto a destra nel modulo, quindi scelga Settings. A seconda della versione, può trovarsi dietro un menu a tre puntini o un clic destro sulla scala; il pannello che si apre è lo stesso in entrambi i casi." },
    { q: "Posso mostrare profitti e perdite in tick anziché in dollari?", a: "Sì. Nelle impostazioni del DOM può alternare la visualizzazione del P/L aperto tra un importo in valuta e un numero di tick, e attivare Show Estimated P/L per vedere il Suo risultato previsto a ogni livello di prezzo." },
    { q: "Le mie impostazioni del SuperDOM vengono salvate tra le sessioni?", a: "Le impostazioni si applicano al DOM che modifica, quindi salvi il Suo workspace o layout una volta configurato. In questo modo colonne, istogramma e colori verranno ricaricati la volta successiva invece di tornare ai valori predefiniti." },
  ] },
  relatedHeading: { en: "Related Guides", de: "Verwandte Anleitungen", es: "Guías relacionadas", fr: "Guides associés", it: "Guide correlate" },
  disclosureText: { en: `This guide is for educational and informational purposes only and is not financial, investment, or trading advice. Trading futures and other leveraged products carries a substantial risk of loss and is not suitable for every investor. PickMyTrade is an independent third-party automation platform and is not affiliated with, endorsed by, or sponsored by Tradovate, Inc. "Tradovate" and all related names, logos, and trademarks are the property of their respective owners. Platform features and steps change over time, so always confirm the current process in the official Tradovate platform and documentation before acting.`, de: "Diese Anleitung dient ausschließlich Bildungs- und Informationszwecken und stellt keine Finanz-, Anlage- oder Handelsberatung dar. Der Handel mit Futures und anderen gehebelten Produkten birgt ein erhebliches Verlustrisiko und ist nicht für jeden Anleger geeignet. PickMyTrade ist eine unabhängige Automatisierungsplattform eines Drittanbieters und steht in keiner Verbindung zu Tradovate, Inc., wird weder von Tradovate, Inc. unterstützt noch gesponsert. „Tradovate“ und alle zugehörigen Namen, Logos und Marken sind Eigentum der jeweiligen Inhaber. Funktionen und Schritte der Plattform ändern sich im Laufe der Zeit. Prüfen Sie daher stets den aktuellen Ablauf in der offiziellen Tradovate-Plattform und -Dokumentation, bevor Sie handeln.", es: "Esta guía tiene fines exclusivamente educativos e informativos y no constituye asesoramiento financiero, de inversión ni de trading. Operar con futuros y otros productos apalancados conlleva un riesgo sustancial de pérdida y no es adecuado para todos los inversores. PickMyTrade es una plataforma de automatización independiente de terceros y no está afiliada, respaldada ni patrocinada por Tradovate, Inc. «Tradovate» y todos los nombres, logotipos y marcas relacionados son propiedad de sus respectivos titulares. Las funciones y los pasos de la plataforma cambian con el tiempo, por lo que debe confirmar siempre el proceso vigente en la plataforma y la documentación oficiales de Tradovate antes de actuar.", fr: "Ce guide est fourni à des fins éducatives et informatives uniquement et ne constitue pas un conseil financier, d'investissement ou de trading. Le trading de contrats à terme et d'autres produits à effet de levier comporte un risque de perte important et ne convient pas à tous les investisseurs. PickMyTrade est une plateforme d'automatisation tierce indépendante et n'est ni affiliée à Tradovate, Inc., ni approuvée ou parrainée par cette dernière. « Tradovate » ainsi que tous les noms, logos et marques associés sont la propriété de leurs détenteurs respectifs. Les fonctionnalités et les étapes de la plateforme évoluent avec le temps ; vérifiez donc toujours la procédure en vigueur dans la plateforme et la documentation officielles de Tradovate avant d'agir.", it: "Questa guida ha esclusivamente scopo educativo e informativo e non costituisce consulenza finanziaria, di investimento o di trading. Il trading di futures e di altri prodotti a leva comporta un rischio di perdita sostanziale e non è adatto a tutti gli investitori. PickMyTrade è una piattaforma di automazione indipendente di terze parti e non è affiliata, approvata né sponsorizzata da Tradovate, Inc. «Tradovate» e tutti i nomi, loghi e marchi correlati sono di proprietà dei rispettivi titolari. Le funzionalità e i passaggi della piattaforma cambiano nel tempo, quindi verifichi sempre la procedura attuale nella piattaforma e nella documentazione ufficiali di Tradovate prima di agire." },
};
const data: GuideArticleData = resolveGuideContent(content, locale, related);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: data.faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}${withSlash(localizedPath(locale))}` },
    { "@type": "ListItem", position: 2, name: "How-To", item: `${SITE_URL}${withSlash(localizedPath(locale, "how-to"))}` },
    { "@type": "ListItem", position: 3, name: content.h1[locale], item: `${SITE_URL}${withSlash(localizedPath(locale, `how-to/${SLUG}`))}` },
  ],
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: content.h1[locale],
  description: content.dek[locale],
  image: `${SITE_URL}/assets/og-default.webp`,
  publisher: { "@type": "Organization", name: "PickMyTrade", logo: { "@type": "ImageObject", url: `${SITE_URL}/assets/logo.png` } },
  datePublished: "2026-07-08",
  dateModified: "2026-07-08",
  mainEntityOfPage: { "@type": "WebPage", "@id": `${SITE_URL}${withSlash(localizedPath(locale, `how-to/${SLUG}`))}` },
};
---

<BaseLayout
  locale={locale}
  title={`${content.h1[locale]} | PickMyTrade`}
  description={content.dek[locale]}
  ogType="article"
  ogImage="/assets/og-default.webp"
  ldJson={[breadcrumbSchema, faqSchema, articleSchema]}
>
  <GuideArticle locale={locale} data={data} sectionPath="how-to" />
</BaseLayout>
