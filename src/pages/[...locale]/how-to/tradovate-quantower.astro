---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-quantower";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Connect Tradovate to Quantower (Workaround)";
const META_DESCRIPTION =
  "Connect a Tradovate account to Quantower with the unofficial prop-firm workaround: setup steps, credentials, environment, and the risks to know first.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Tradovate mit Quantower verbinden (Workaround)", es: "Conecte Tradovate a Quantower (solución alternativa)", fr: "Connecter Tradovate à Quantower (solution de contournement)", it: "Collegare Tradovate a Quantower (soluzione alternativa)" },
  dek: { en: "Quantower doesn't publish a plain Tradovate connection, but there's a workaround that leans on your prop firm. Here's how it actually works, plus the caveats worth knowing first.", de: "Quantower bietet keine einfache Tradovate-Verbindung an, aber es gibt einen Workaround über Ihre Prop Firm. So funktioniert er tatsächlich, plus die Einschränkungen, die Sie vorab kennen sollten.", es: "Quantower no publica una conexión directa con Tradovate, pero existe una solución alternativa que se apoya en su prop firm. Así funciona en realidad, junto con las salvedades que conviene conocer primero.", fr: "Quantower ne propose pas de connexion directe à Tradovate, mais il existe une solution de contournement qui s'appuie sur votre prop firm. Voici comment elle fonctionne réellement, ainsi que les réserves à connaître d'abord.", it: "Quantower non pubblica una connessione diretta a Tradovate, ma esiste una soluzione alternativa che si appoggia alla sua prop firm. Ecco come funziona davvero, insieme alle avvertenze da conoscere prima." },
  readTime: { en: "6 min read", de: "6 Min. Lesezeit", es: "Lectura de 6 min", fr: "Lecture : 6 min", it: "Lettura di 6 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Quantower is a genuinely good multi-broker platform, so it stings when you open its connection list and there's no plain \"Tradovate\" entry to click. Plenty of Tradovate and prop-firm traders hit that wall the moment they try to move their charts and DOM over. There is a way in, but it's a workaround that leans on your prop firm rather than a supported, one-click integration. Here's how the route actually works, step by step, plus the caveats worth knowing before you trust it with real money." },
    { type: "heading", text: "Why There's No Direct Tradovate Login" },
    { type: "paragraph", html: "Quantower connects natively to the usual futures plumbing: Rithmic, CQG, Interactive Brokers, ProjectX and a handful of others. Tradovate isn't on that native list, and your everyday retail Tradovate username and password won't sign a standard connection in. The practical path is through a prop firm that runs on Tradovate and has switched Quantower on from its side. When that's in place, Quantower talks to Tradovate's API and routes your orders to the Tradovate sub-account the firm issued you. It works, but it sits in an unsupported grey zone, so treat it as \"use at your own risk\" rather than an officially blessed setup." },
    { type: "heading", text: "Before You Start" },
    {
      type: "list",
      items: [
        "An evaluation or funded account with a firm that runs on Tradovate <em>and</em> permits Quantower. Whether that's allowed varies by firm and account size, so check your firm's current rules first.",
        "The Tradovate-linked credentials from your firm dashboard. These are the platform credentials, not your firm-portal or TradingView password.",
        "The latest Quantower desktop build, downloaded from the official Quantower site.",
        "Realistic expectations: this route usually isn't covered by the firm's support or SLA, so you own any troubleshooting that comes up.",
      ],
    },
    { type: "heading", text: "Connect Tradovate to Quantower: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Confirm Your Firm Supports It and Get Your Credentials", html: "Start on the prop firm's side, not Quantower's. Confirm the firm actually runs on Tradovate and doesn't ban third-party platforms, then open your dashboard and find the Tradovate-linked login and password tied to your account. Copy them exactly. Some firms hand these out only after you clear an evaluation stage, so if you can't see them yet, that's usually why." },
        { title: "Install and Open Quantower", html: "Grab the current Quantower desktop installer from the official site, run it, and open the platform. If you already had an older build sitting around, update it first. An out-of-date client is a common reason a connection that should exist simply doesn't show up in the list." },
        { title: "Open the Connections Manager", html: "Right-click any empty part of the workspace and choose Connections, or click the connection name in the top toolbar to bring up the Connections manager. This is the screen that lists every integration Quantower can reach, each with its own login form, a gear icon for settings, and a Connect button." },
        { title: "Pick the Connection That Routes to Tradovate", html: "This is the part that trips people up. You're not looking for a generic \"Tradovate\" button, because Quantower doesn't publish one. You're selecting the specific connection your firm uses to reach your Tradovate-based account, which is often listed under the firm's own name or a partner data feed. If the connection offers an environment choice, pick the one that matches your account, whether that's Demo or Live. Get this wrong and the login will fail even with perfect credentials." },
        { title: "Enter Your Credentials and Connect", html: "Type in the Login and password from Step 1. Both are case-sensitive, so watch for a stray trailing space if you pasted them. Hit Connect and give it a few seconds. A green status dot next to the connection name, plus a live ping reading, tells you the handshake with Tradovate went through. Quantower remembers the credentials for auto-reconnects after that." },
        { title: "Verify the Account and Place a Test Order", html: "Don't assume a green dot means everything's wired correctly. Open a DOM or a chart, then check the account dropdown actually shows your Tradovate sub-account and the right balance. If your firm gave you a Demo or practice account, place one small test order and confirm it fills and appears in your Tradovate order history. Only then move to anything live." },
      ],
    },
    { type: "heading", text: "Common Snags" },
    { type: "paragraph", html: "<strong class='text-white'>The green dot never appears.</strong> Nine times out of ten it's the credentials. Retype them by hand instead of pasting, confirm the correct firm or server is selected in the connection, and make sure you're on the environment that matches your account." },
    { type: "paragraph", html: "<strong class='text-white'>You keep getting bumped off.</strong> Running Quantower alongside Tradovate web or a TradingView session at the same time can trip Tradovate's session cap. If connections drop or charts freeze, sign out of the other sessions first." },
    { type: "paragraph", html: "<strong class='text-white'>Rules risk on funded live.</strong> An unsupported platform can complicate a payout dispute if a firm decides it wasn't sanctioned. Re-read your firm's current platform rules before you route a funded live account this way, and remember the whole path relies on Tradovate's API." },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Want automation that doesn't live in a grey zone? <strong class='text-white'>PickMyTrade routes your TradingView alerts straight to Tradovate</strong> without wiring up an unsupported third-party platform." },
    { type: "paragraph", html: "If your firm doesn't allow this route, the cleaner alternative is to stay on a supported connection. Many traders just run their strategy on TradingView instead, connecting Tradovate to TradingView is a fully supported path and sidesteps the whole workaround." },
  ], de: [
    { type: "paragraph",html: "Quantower ist eine wirklich gute Multi-Broker-Plattform, daher ist es ärgerlich, wenn man die Verbindungsliste öffnet und dort kein einfacher Eintrag „Tradovate“ zum Anklicken steht. Viele Tradovate- und Prop-Firm-Trader stoßen genau darauf, sobald sie ihre Charts und das DOM umziehen wollen. Es gibt einen Weg hinein, doch es ist ein Workaround über Ihre Prop Firm und keine unterstützte Ein-Klick-Integration. So funktioniert die Route Schritt für Schritt, plus die Einschränkungen, die Sie kennen sollten, bevor Sie ihr echtes Geld anvertrauen." },
    { type: "heading",text: "Warum es keinen direkten Tradovate-Login gibt" },
    { type: "paragraph",html: "Quantower verbindet sich nativ mit der üblichen Futures-Infrastruktur: Rithmic, CQG, Interactive Brokers, ProjectX und einigen weiteren. Tradovate steht nicht auf dieser nativen Liste, und Ihr normaler Retail-Benutzername und Ihr Passwort für Tradovate funktionieren bei einer Standardverbindung nicht. Der praktikable Weg führt über eine Prop Firm, die auf Tradovate läuft und Quantower auf ihrer Seite freigeschaltet hat. Ist das der Fall, kommuniziert Quantower mit der Tradovate-API und leitet Ihre Orders an das Tradovate-Unterkonto weiter, das die Firma Ihnen ausgestellt hat. Es funktioniert, bewegt sich aber in einer nicht unterstützten Grauzone. Betrachten Sie es daher als „Nutzung auf eigenes Risiko“ und nicht als offiziell abgesegnetes Setup." },
    { type: "heading",text: "Bevor Sie beginnen" },
    {
      type: "list",
      items: [
        "Ein Evaluierungs- oder Funded-Konto bei einer Firma, die auf Tradovate läuft <em>und</em> Quantower erlaubt. Ob das zulässig ist, hängt von der Firma und der Kontogröße ab, prüfen Sie daher zuerst die aktuellen Regeln Ihrer Firma.",
        "Die mit Tradovate verknüpften Zugangsdaten aus dem Dashboard Ihrer Firma. Das sind die Plattform-Zugangsdaten, nicht Ihr Passwort für das Firmenportal oder TradingView.",
        "Der neueste Quantower-Desktop-Build, heruntergeladen von der offiziellen Quantower-Website.",
        "Realistische Erwartungen: Diese Route wird in der Regel weder vom Support noch von einem SLA der Firma abgedeckt, Sie sind also selbst für die Fehlerbehebung zuständig.",
      ],
    },
    { type: "heading",text: "Tradovate mit Quantower verbinden: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Prüfen, ob Ihre Firma es unterstützt, und Zugangsdaten besorgen", html: "Beginnen Sie bei der Prop Firm, nicht bei Quantower. Vergewissern Sie sich, dass die Firma tatsächlich auf Tradovate läuft und Drittplattformen nicht verbietet, öffnen Sie dann Ihr Dashboard und suchen Sie den mit Ihrem Konto verknüpften Tradovate-Login samt Passwort. Kopieren Sie beides exakt. Manche Firmen geben diese erst heraus, nachdem Sie eine Evaluierungsphase bestanden haben. Wenn Sie sie noch nicht sehen, ist das meist der Grund." },
        { title: "Quantower installieren und öffnen", html: "Laden Sie das aktuelle Quantower-Desktop-Installationsprogramm von der offiziellen Website herunter, führen Sie es aus und öffnen Sie die Plattform. Falls bereits ein älterer Build vorhanden ist, aktualisieren Sie ihn zuerst. Ein veralteter Client ist ein häufiger Grund dafür, dass eine Verbindung, die vorhanden sein sollte, einfach nicht in der Liste erscheint." },
        { title: "Den Connections-Manager öffnen", html: "Klicken Sie mit der rechten Maustaste auf eine leere Stelle des Arbeitsbereichs und wählen Sie Connections, oder klicken Sie in der oberen Symbolleiste auf den Verbindungsnamen, um den Connections-Manager aufzurufen. Dieser Bildschirm listet jede Integration auf, die Quantower erreichen kann, jeweils mit eigenem Login-Formular, einem Zahnradsymbol für die Einstellungen und einer Schaltfläche Connect." },
        { title: "Die Verbindung wählen, die zu Tradovate routet", html: "Hier stolpern die meisten. Sie suchen nicht nach einer allgemeinen Schaltfläche „Tradovate“, denn Quantower bietet keine an. Sie wählen die spezifische Verbindung, über die Ihre Firma Ihr Tradovate-basiertes Konto erreicht und die oft unter dem Namen der Firma oder eines Partner-Datenfeeds aufgeführt ist. Bietet die Verbindung eine Umgebungsauswahl, wählen Sie die, die zu Ihrem Konto passt, also Demo oder Live. Wählen Sie falsch, schlägt der Login selbst mit perfekten Zugangsdaten fehl." },
        { title: "Zugangsdaten eingeben und verbinden", html: "Geben Sie Login und Passwort aus Schritt 1 ein. Beide unterscheiden zwischen Groß- und Kleinschreibung. Achten Sie daher auf ein versehentliches Leerzeichen am Ende, wenn Sie sie eingefügt haben. Klicken Sie auf Connect und warten Sie einige Sekunden. Ein grüner Statuspunkt neben dem Verbindungsnamen samt Live-Ping-Anzeige zeigt, dass der Handshake mit Tradovate erfolgreich war. Danach merkt sich Quantower die Zugangsdaten für automatische Wiederverbindungen." },
        { title: "Konto prüfen und Testorder platzieren", html: "Gehen Sie nicht davon aus, dass ein grüner Punkt bedeutet, dass alles korrekt verbunden ist. Öffnen Sie ein DOM oder einen Chart und prüfen Sie, ob das Konto-Dropdown tatsächlich Ihr Tradovate-Unterkonto und den richtigen Kontostand anzeigt. Wenn Ihnen Ihre Firma ein Demo- oder Übungskonto gegeben hat, platzieren Sie eine kleine Testorder und bestätigen Sie, dass sie ausgeführt wird und in Ihrem Tradovate-Orderverlauf erscheint. Erst dann gehen Sie zu etwas Live-Handel über." },
      ],
    },
    { type: "heading",text: "Häufige Stolpersteine" },
    { type: "paragraph",html: "<strong class='text-white'>Der grüne Punkt erscheint nie.</strong> In neun von zehn Fällen liegt es an den Zugangsdaten. Geben Sie sie von Hand neu ein, statt sie einzufügen, bestätigen Sie, dass in der Verbindung die richtige Firma oder der richtige Server ausgewählt ist, und stellen Sie sicher, dass Sie die zu Ihrem Konto passende Umgebung verwenden." },
    { type: "paragraph",html: "<strong class='text-white'>Sie werden ständig getrennt.</strong> Wenn Quantower gleichzeitig mit Tradovate Web oder einer TradingView-Sitzung läuft, kann das die Sitzungsgrenze von Tradovate auslösen. Brechen Verbindungen ab oder frieren Charts ein, melden Sie sich zuerst aus den anderen Sitzungen ab." },
    { type: "paragraph",html: "<strong class='text-white'>Regelrisiko bei Funded Live.</strong> Eine nicht unterstützte Plattform kann einen Auszahlungsstreit verkomplizieren, falls eine Firma entscheidet, dass sie nicht genehmigt war. Lesen Sie die aktuellen Plattformregeln Ihrer Firma erneut, bevor Sie ein Funded-Live-Konto auf diesem Weg routen, und denken Sie daran, dass der gesamte Weg auf der Tradovate-API beruht." },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "Sie möchten Automatisierung, die nicht in einer Grauzone liegt? <strong class='text-white'>PickMyTrade leitet Ihre TradingView-Alerts direkt an Tradovate weiter</strong>, ohne dass Sie eine nicht unterstützte Drittplattform einrichten müssen." },
    { type: "paragraph",html: "Erlaubt Ihre Firma diese Route nicht, ist die sauberere Alternative eine unterstützte Verbindung. Viele Trader führen ihre Strategie einfach auf TradingView aus, denn die Verbindung von Tradovate mit TradingView ist ein vollständig unterstützter Weg und umgeht den gesamten Workaround." },
  ], es: [
    { type: "paragraph",html: "Quantower es una plataforma multibróker realmente buena, así que duele abrir su lista de conexiones y no encontrar una entrada \"Tradovate\" simple en la que hacer clic. Muchos traders de Tradovate y de prop firms se topan con ese muro justo cuando intentan trasladar sus gráficos y el DOM. Hay una vía de entrada, pero es una solución alternativa que se apoya en su prop firm y no una integración compatible de un solo clic. Aquí le explicamos cómo funciona la ruta, paso a paso, además de las salvedades que conviene conocer antes de confiarle dinero real." },
    { type: "heading",text: "Por qué no existe un inicio de sesión directo en Tradovate" },
    { type: "paragraph",html: "Quantower se conecta de forma nativa con la infraestructura habitual de futuros: Rithmic, CQG, Interactive Brokers, ProjectX y algunas más. Tradovate no figura en esa lista nativa, y su usuario y contraseña minoristas habituales de Tradovate no sirven para una conexión estándar. La vía práctica es una prop firm que opere sobre Tradovate y haya habilitado Quantower por su parte. Cuando eso ocurre, Quantower se comunica con la API de Tradovate y enruta sus órdenes a la subcuenta de Tradovate que la firma le asignó. Funciona, pero se sitúa en una zona gris no compatible, así que trátelo como \"úselo bajo su propio riesgo\" y no como una configuración respaldada oficialmente." },
    { type: "heading",text: "Antes de empezar" },
    {
      type: "list",
      items: [
        "Una cuenta de evaluación o fondeada con una firma que opere sobre Tradovate <em>y</em> permita Quantower. Que esté permitido varía según la firma y el tamaño de la cuenta, así que consulte primero las reglas vigentes de su firma.",
        "Las credenciales vinculadas a Tradovate desde el panel de su firma. Son las credenciales de la plataforma, no la contraseña del portal de la firma ni la de TradingView.",
        "La última versión de escritorio de Quantower, descargada del sitio oficial de Quantower.",
        "Expectativas realistas: esta ruta normalmente no está cubierta por el soporte ni por el SLA de la firma, por lo que usted se encarga de resolver cualquier problema que surja.",
      ],
    },
    { type: "heading",text: "Conectar Tradovate a Quantower: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Confirme que su firma lo admite y obtenga sus credenciales", html: "Empiece por la prop firm, no por Quantower. Confirme que la firma realmente opera sobre Tradovate y no prohíbe plataformas de terceros; luego abra su panel y busque el usuario y la contraseña de Tradovate vinculados a su cuenta. Cópielos exactamente. Algunas firmas los entregan solo después de superar una fase de evaluación, así que si todavía no los ve, suele ser por eso." },
        { title: "Instale y abra Quantower", html: "Descargue el instalador de escritorio actual de Quantower desde el sitio oficial, ejecútelo y abra la plataforma. Si ya tenía una versión anterior, actualícela primero. Un cliente desactualizado es una causa habitual de que una conexión que debería existir simplemente no aparezca en la lista." },
        { title: "Abra el administrador de Connections", html: "Haga clic con el botón derecho en cualquier zona vacía del espacio de trabajo y elija Connections, o haga clic en el nombre de la conexión en la barra de herramientas superior para abrir el administrador de Connections. Esta pantalla muestra todas las integraciones a las que Quantower puede llegar, cada una con su propio formulario de acceso, un icono de engranaje para los ajustes y un botón Connect." },
        { title: "Elija la conexión que enruta a Tradovate", html: "Aquí es donde la gente se atasca. No busca un botón genérico \"Tradovate\", porque Quantower no publica ninguno. Selecciona la conexión específica que su firma utiliza para llegar a su cuenta basada en Tradovate, que a menudo aparece con el nombre de la firma o de un proveedor de datos asociado. Si la conexión ofrece elegir entorno, seleccione el que corresponda a su cuenta, ya sea Demo o Live. Si se equivoca, el inicio de sesión fallará incluso con credenciales perfectas." },
        { title: "Introduzca sus credenciales y conéctese", html: "Escriba el Login y la contraseña del paso 1. Ambos distinguen mayúsculas de minúsculas, así que vigile que no haya un espacio final si los pegó. Pulse Connect y espere unos segundos. Un punto de estado verde junto al nombre de la conexión, más una lectura de ping en vivo, indica que el enlace con Tradovate se estableció. A partir de ahí, Quantower recuerda las credenciales para las reconexiones automáticas." },
        { title: "Verifique la cuenta y coloque una orden de prueba", html: "No dé por hecho que un punto verde significa que todo está bien conectado. Abra un DOM o un gráfico y compruebe que el desplegable de cuentas muestre realmente su subcuenta de Tradovate y el saldo correcto. Si su firma le dio una cuenta Demo o de práctica, coloque una orden de prueba pequeña y confirme que se ejecuta y aparece en su historial de órdenes de Tradovate. Solo entonces pase a algo en vivo." },
      ],
    },
    { type: "heading",text: "Problemas habituales" },
    { type: "paragraph",html: "<strong class='text-white'>El punto verde nunca aparece.</strong> Nueve de cada diez veces son las credenciales. Vuelva a escribirlas a mano en lugar de pegarlas, confirme que la firma o el servidor correctos están seleccionados en la conexión y asegúrese de estar en el entorno que corresponde a su cuenta." },
    { type: "paragraph",html: "<strong class='text-white'>Le desconectan continuamente.</strong> Ejecutar Quantower a la vez que Tradovate web o una sesión de TradingView puede activar el límite de sesiones de Tradovate. Si las conexiones se caen o los gráficos se congelan, cierre primero las demás sesiones." },
    { type: "paragraph",html: "<strong class='text-white'>Riesgo de reglas en cuentas fondeadas en vivo.</strong> Una plataforma no compatible puede complicar una disputa de pago si la firma decide que no estaba autorizada. Vuelva a leer las reglas vigentes de plataformas de su firma antes de enrutar una cuenta fondeada en vivo de esta manera, y recuerde que todo el camino depende de la API de Tradovate." },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "¿Quiere una automatización que no viva en una zona gris? <strong class='text-white'>PickMyTrade enruta sus alertas de TradingView directamente a Tradovate</strong> sin necesidad de configurar una plataforma de terceros no compatible." },
    { type: "paragraph",html: "Si su firma no permite esta ruta, la alternativa más limpia es quedarse con una conexión compatible. Muchos traders simplemente ejecutan su estrategia en TradingView; conectar Tradovate a TradingView es una vía totalmente compatible y evita toda la solución alternativa." },
  ], fr: [
    { type: "paragraph",html: "Quantower est une très bonne plateforme multi-courtiers, ce qui rend d'autant plus frustrant le fait d'ouvrir sa liste de connexions et de n'y trouver aucune entrée « Tradovate » sur laquelle cliquer. De nombreux traders Tradovate et de prop firms se heurtent à ce mur au moment de transférer leurs graphiques et leur DOM. Il existe une voie d'accès, mais c'est une solution de contournement qui s'appuie sur votre prop firm, et non une intégration prise en charge en un clic. Voici comment fonctionne cette voie, étape par étape, ainsi que les réserves à connaître avant de lui confier de l'argent réel." },
    { type: "heading",text: "Pourquoi il n'y a pas de connexion directe à Tradovate" },
    { type: "paragraph",html: "Quantower se connecte nativement à l'infrastructure habituelle des futures : Rithmic, CQG, Interactive Brokers, ProjectX et quelques autres. Tradovate ne figure pas dans cette liste native, et votre identifiant et mot de passe Tradovate de particulier ne permettront pas d'établir une connexion standard. La voie pratique passe par une prop firm qui fonctionne sur Tradovate et qui a activé Quantower de son côté. Une fois cela en place, Quantower communique avec l'API de Tradovate et achemine vos ordres vers le sous-compte Tradovate que la firme vous a attribué. Cela fonctionne, mais c'est une zone grise non prise en charge ; considérez-le donc comme une solution « à vos propres risques » plutôt qu'une configuration officiellement approuvée." },
    { type: "heading",text: "Avant de commencer" },
    {
      type: "list",
      items: [
        "Un compte d'évaluation ou financé auprès d'une firme qui fonctionne sur Tradovate <em>et</em> autorise Quantower. Cette autorisation varie selon la firme et la taille du compte ; vérifiez donc d'abord les règles en vigueur de votre firme.",
        "Les identifiants liés à Tradovate depuis le tableau de bord de votre firme. Ce sont les identifiants de la plateforme, et non votre mot de passe du portail de la firme ou de TradingView.",
        "La dernière version de bureau de Quantower, téléchargée depuis le site officiel de Quantower.",
        "Des attentes réalistes : cette voie n'est généralement pas couverte par le support ni par le SLA de la firme ; vous êtes donc responsable de tout dépannage.",
      ],
    },
    { type: "heading",text: "Connecter Tradovate à Quantower : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Vérifier que votre firme le permet et obtenir vos identifiants", html: "Commencez du côté de la prop firm, pas de Quantower. Vérifiez que la firme fonctionne bien sur Tradovate et n'interdit pas les plateformes tierces, puis ouvrez votre tableau de bord et trouvez l'identifiant et le mot de passe Tradovate liés à votre compte. Copiez-les exactement. Certaines firmes ne les communiquent qu'après la réussite d'une phase d'évaluation ; si vous ne les voyez pas encore, c'est généralement la raison." },
        { title: "Installer et ouvrir Quantower", html: "Téléchargez le programme d'installation de bureau actuel de Quantower depuis le site officiel, exécutez-le et ouvrez la plateforme. Si vous aviez déjà une ancienne version, mettez-la d'abord à jour. Un client obsolète est une cause fréquente de connexion qui devrait exister mais n'apparaît tout simplement pas dans la liste." },
        { title: "Ouvrir le gestionnaire de Connections", html: "Faites un clic droit sur une zone vide de l'espace de travail et choisissez Connections, ou cliquez sur le nom de la connexion dans la barre d'outils supérieure pour afficher le gestionnaire de Connections. Cet écran liste toutes les intégrations que Quantower peut atteindre, chacune avec son propre formulaire de connexion, une icône d'engrenage pour les paramètres et un bouton Connect." },
        { title: "Choisir la connexion qui achemine vers Tradovate", html: "C'est là que beaucoup butent. Vous ne cherchez pas un bouton « Tradovate » générique, car Quantower n'en propose pas. Vous sélectionnez la connexion précise que votre firme utilise pour atteindre votre compte basé sur Tradovate, souvent listée sous le nom de la firme ou d'un flux de données partenaire. Si la connexion propose un choix d'environnement, sélectionnez celui qui correspond à votre compte, Demo ou Live. Si vous vous trompez, la connexion échouera même avec des identifiants parfaits." },
        { title: "Saisir vos identifiants et vous connecter", html: "Saisissez le Login et le mot de passe de l'étape 1. Tous deux sont sensibles à la casse ; surveillez donc un éventuel espace final si vous les avez collés. Cliquez sur Connect et patientez quelques secondes. Un voyant vert à côté du nom de la connexion, accompagné d'une valeur de ping en direct, indique que la poignée de main avec Tradovate a réussi. Ensuite, Quantower mémorise les identifiants pour les reconnexions automatiques." },
        { title: "Vérifier le compte et passer un ordre de test", html: "Ne partez pas du principe qu'un voyant vert signifie que tout est correctement relié. Ouvrez un DOM ou un graphique, puis vérifiez que la liste déroulante des comptes affiche bien votre sous-compte Tradovate et le bon solde. Si votre firme vous a fourni un compte Demo ou d'entraînement, passez un petit ordre de test et vérifiez qu'il est exécuté et apparaît dans votre historique d'ordres Tradovate. Ce n'est qu'ensuite que vous pouvez passer au réel." },
      ],
    },
    { type: "heading",text: "Problèmes courants" },
    { type: "paragraph",html: "<strong class='text-white'>Le voyant vert n'apparaît jamais.</strong> Neuf fois sur dix, ce sont les identifiants. Ressaisissez-les à la main plutôt que de les coller, vérifiez que la bonne firme ou le bon serveur est sélectionné dans la connexion, et assurez-vous d'être dans l'environnement qui correspond à votre compte." },
    { type: "paragraph",html: "<strong class='text-white'>Vous êtes sans cesse déconnecté.</strong> Exécuter Quantower en même temps que Tradovate web ou une session TradingView peut déclencher la limite de sessions de Tradovate. Si les connexions sautent ou que les graphiques se figent, déconnectez-vous d'abord des autres sessions." },
    { type: "paragraph",html: "<strong class='text-white'>Risque lié aux règles sur un compte financé en réel.</strong> Une plateforme non prise en charge peut compliquer un litige de paiement si une firme décide qu'elle n'était pas autorisée. Relisez les règles de plateforme en vigueur de votre firme avant d'acheminer un compte financé en réel de cette manière, et rappelez-vous que tout le parcours repose sur l'API de Tradovate." },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Vous voulez une automatisation qui ne vit pas dans une zone grise ? <strong class='text-white'>PickMyTrade achemine vos alertes TradingView directement vers Tradovate</strong>, sans passer par une plateforme tierce non prise en charge." },
    { type: "paragraph",html: "Si votre firme n'autorise pas cette voie, l'alternative la plus propre consiste à rester sur une connexion prise en charge. De nombreux traders exécutent simplement leur stratégie sur TradingView : connecter Tradovate à TradingView est une voie entièrement prise en charge qui évite toute la solution de contournement." },
  ], it: [
    { type: "paragraph",html: "Quantower è una piattaforma multi-broker davvero valida, quindi dispiace aprire l'elenco delle connessioni e non trovare una semplice voce \"Tradovate\" su cui cliccare. Molti trader di Tradovate e delle prop firm si scontrano con questo ostacolo non appena provano a spostare grafici e DOM. Esiste una via d'accesso, ma è una soluzione alternativa che si appoggia alla sua prop firm e non un'integrazione supportata con un solo clic. Ecco come funziona il percorso, passo dopo passo, più le avvertenze da conoscere prima di affidargli denaro reale." },
    { type: "heading",text: "Perché non esiste un login diretto a Tradovate" },
    { type: "paragraph",html: "Quantower si collega in modo nativo alla consueta infrastruttura dei futures: Rithmic, CQG, Interactive Brokers, ProjectX e alcune altre. Tradovate non è in questo elenco nativo, e il suo normale nome utente e password retail di Tradovate non permettono una connessione standard. La strada pratica passa da una prop firm che opera su Tradovate e che ha abilitato Quantower dal proprio lato. Quando ciò avviene, Quantower dialoga con l'API di Tradovate e instrada i suoi ordini al sub-account Tradovate che la società le ha assegnato. Funziona, ma si trova in una zona grigia non supportata, quindi lo consideri \"a proprio rischio\" e non una configurazione approvata ufficialmente." },
    { type: "heading",text: "Prima di iniziare" },
    {
      type: "list",
      items: [
        "Un account di valutazione o finanziato presso una società che opera su Tradovate <em>e</em> consente Quantower. Se ciò sia permesso varia in base alla società e alla dimensione dell'account, quindi controlli prima le regole attuali della sua società.",
        "Le credenziali collegate a Tradovate dalla dashboard della sua società. Sono le credenziali della piattaforma, non la password del portale della società né quella di TradingView.",
        "L'ultima versione desktop di Quantower, scaricata dal sito ufficiale di Quantower.",
        "Aspettative realistiche: questo percorso di solito non è coperto dal supporto né dallo SLA della società, quindi la risoluzione di eventuali problemi spetta a Lei.",
      ],
    },
    { type: "heading",text: "Collegare Tradovate a Quantower: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Verificare che la società lo supporti e ottenere le credenziali", html: "Parta dal lato della prop firm, non da Quantower. Verifichi che la società operi davvero su Tradovate e non vieti piattaforme di terze parti, poi apra la dashboard e trovi login e password di Tradovate associati al suo account. Li copi esattamente. Alcune società li forniscono solo dopo aver superato una fase di valutazione, quindi se non li vede ancora, di solito è questo il motivo." },
        { title: "Installare e aprire Quantower", html: "Scarichi dal sito ufficiale l'installer desktop attuale di Quantower, lo esegua e apra la piattaforma. Se aveva già una versione più vecchia, la aggiorni prima. Un client non aggiornato è una causa frequente per cui una connessione che dovrebbe esistere semplicemente non compare nell'elenco." },
        { title: "Aprire il gestore di Connections", html: "Clicchi con il tasto destro su una qualsiasi area vuota dello spazio di lavoro e scelga Connections, oppure clicchi sul nome della connessione nella barra degli strumenti in alto per aprire il gestore di Connections. Questa schermata elenca ogni integrazione raggiungibile da Quantower, ciascuna con il proprio modulo di login, un'icona a forma di ingranaggio per le impostazioni e un pulsante Connect." },
        { title: "Scegliere la connessione che instrada a Tradovate", html: "È qui che molti si bloccano. Non sta cercando un generico pulsante \"Tradovate\", perché Quantower non ne pubblica uno. Sta selezionando la connessione specifica che la sua società usa per raggiungere il suo account basato su Tradovate, spesso elencata con il nome della società o di un feed dati partner. Se la connessione offre la scelta dell'ambiente, selezioni quello corrispondente al suo account, Demo o Live. Se sbaglia, il login fallirà anche con credenziali perfette." },
        { title: "Inserire le credenziali e connettersi", html: "Inserisca Login e password del passaggio 1. Entrambi distinguono tra maiuscole e minuscole, quindi faccia attenzione a un eventuale spazio finale se li ha incollati. Prema Connect e attenda qualche secondo. Un indicatore verde accanto al nome della connessione, insieme a una lettura del ping in tempo reale, indica che l'handshake con Tradovate è andato a buon fine. Dopodiché Quantower ricorda le credenziali per le riconnessioni automatiche." },
        { title: "Verificare l'account e inviare un ordine di prova", html: "Non dia per scontato che un indicatore verde significhi che tutto è collegato correttamente. Apra un DOM o un grafico, poi verifichi che il menu a tendina degli account mostri davvero il suo sub-account Tradovate e il saldo corretto. Se la sua società le ha fornito un account Demo o di prova, invii un piccolo ordine di prova e verifichi che venga eseguito e compaia nello storico ordini di Tradovate. Solo allora passi a qualcosa di reale." },
      ],
    },
    { type: "heading",text: "Problemi comuni" },
    { type: "paragraph",html: "<strong class='text-white'>L'indicatore verde non compare mai.</strong> Nove volte su dieci sono le credenziali. Le digiti di nuovo a mano invece di incollarle, verifichi che nella connessione siano selezionati la società o il server corretti e si assicuri di usare l'ambiente corrispondente al suo account." },
    { type: "paragraph",html: "<strong class='text-white'>Viene continuamente disconnesso.</strong> Eseguire Quantower contemporaneamente a Tradovate web o a una sessione di TradingView può far scattare il limite di sessioni di Tradovate. Se le connessioni cadono o i grafici si bloccano, esca prima dalle altre sessioni." },
    { type: "paragraph",html: "<strong class='text-white'>Rischio regole su account finanziato live.</strong> Una piattaforma non supportata può complicare una controversia sul pagamento se una società decide che non era autorizzata. Rilegga le regole attuali della sua società sulle piattaforme prima di instradare un account finanziato live in questo modo, e ricordi che l'intero percorso si basa sull'API di Tradovate." },
    { type: "heading",text: "Automatizzi tutto questo con PickMyTrade" },
    { type: "paragraph",html: "Vuole un'automazione che non viva in una zona grigia? <strong class='text-white'>PickMyTrade instrada i suoi alert di TradingView direttamente a Tradovate</strong> senza dover configurare una piattaforma di terze parti non supportata." },
    { type: "paragraph",html: "Se la sua società non consente questo percorso, l'alternativa più pulita è restare su una connessione supportata. Molti trader eseguono semplicemente la propria strategia su TradingView: collegare Tradovate a TradingView è un percorso pienamente supportato e aggira l'intera soluzione alternativa." },
  ] },
  ctaHeading: { en: "Automate Without the Grey Zone", de: "Automatisieren ohne Grauzone", es: "Automatice sin zonas grises", fr: "Automatisez sans zone grise", it: "Automatizzi senza zone grigie" },
  ctaText: { en: "PickMyTrade routes your TradingView alerts straight to Tradovate without wiring up an unsupported third-party platform.", de: "PickMyTrade leitet Ihre TradingView-Alerts direkt an Tradovate weiter, ohne dass Sie eine nicht unterstützte Drittplattform einrichten müssen.", es: "PickMyTrade enruta sus alertas de TradingView directamente a Tradovate sin necesidad de configurar una plataforma de terceros no compatible.", fr: "PickMyTrade achemine vos alertes TradingView directement vers Tradovate, sans passer par une plateforme tierce non prise en charge.", it: "PickMyTrade instrada i suoi alert di TradingView direttamente a Tradovate senza dover configurare una piattaforma di terze parti non supportata." },
