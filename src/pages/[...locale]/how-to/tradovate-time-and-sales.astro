---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-time-and-sales";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Use the Tradovate Time & Sales (T&S) Module";
const META_DESCRIPTION =
  "Add a Time & Sales tape, pick a contract, and read every print by price, size and time. Filter the noise with a minimum-size volume filter.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Das Tradovate Time & Sales (T&S) Modul verwenden", es: "Use el módulo Time & Sales (T&S) de Tradovate", fr: "Utiliser le module Time & Sales (T&S) de Tradovate", it: "Usare il modulo Time & Sales (T&S) di Tradovate" },
  dek: { en: "Time & Sales streams every executed trade in real time, so you see the actual prints hitting the market. Here's how to add the module, load your contract, and read the flow.", de: "Time & Sales streamt jeden ausgeführten Trade in Echtzeit, sodass Sie die tatsächlichen Prints im Markt sehen. So fügen Sie das Modul hinzu, laden Ihren Kontrakt und lesen den Fluss.", es: "Time & Sales muestra en tiempo real cada operación ejecutada, de modo que ve las transacciones reales que llegan al mercado. Aquí le explicamos cómo añadir el módulo, cargar su contrato e interpretar el flujo.", fr: "Time & Sales diffuse en temps réel chaque transaction exécutée, afin que vous voyiez les prints réels qui touchent le marché. Voici comment ajouter le module, charger votre contrat et lire le flux.", it: "Time & Sales trasmette in tempo reale ogni operazione eseguita, così lei vede i print effettivi che colpiscono il mercato. Ecco come aggiungere il modulo, caricare il suo contratto e leggere il flusso." },
  readTime: { en: "4 min read", de: "4 Min. Lesezeit", es: "Lectura de 4 min", fr: "Lecture : 4 min", it: "Lettura di 4 min" },
  lastUpdated: "2026-07-10",
  blocks: { en: [
    { type: "paragraph", html: "The tape tells you what the chart can't. Time &amp; Sales streams every executed trade in real time, so you see the actual prints hitting the market: the price, how many contracts changed hands, and the exact moment it happened. Here's how to add the module in Tradovate Web, load your contract, and read the flow." },
    { type: "heading", text: "What the T&S Module Shows" },
    { type: "paragraph", html: "T&amp;S stands for Time &amp; Sales. Other platforms call it the tape or the data stream. It's a market-data tool that lists trades as they execute for whichever instrument you point it at. One glance tells you where trades are actually filling and whether size is showing up on the bid or the ask, which is why order-flow traders keep it open next to the DOM. One thing to sort out first: the tape only prints live trades if your account has a real-time market data subscription. On delayed data you'll still see prints, just behind the live market." },
    { type: "heading", text: "Add and Use Time & Sales: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open a Time & Sales Module", html: "Click the <strong class='text-white'>+ (New)</strong> button at the top-left of the platform, then drag and drop the <strong class='text-white'>T&amp;S (Time &amp; Sales)</strong> module into your workspace and drop it wherever you want it to sit. There's a faster route too: right-click an instrument in a chart, SuperDOM, or Market Analyzer, and near the bottom of that menu you can drag out a new T&amp;S module with the instrument already loaded.", image: { src: `${IMG}/tradovate-time-and-sales-1.png`, alt: "Tradovate New module menu with the T&S Time and Sales option being dragged into the workspace" } },
        { title: "Load Your Instrument", html: "Left-click the instrument name in the tab at the top-left of the module. A search box drops down. Type the contract you want, say <strong class='text-white'>ESU5</strong>, and pick it from the list. The tape switches over and starts printing that market's trades right away.", image: { src: `${IMG}/tradovate-time-and-sales-2.png`, alt: "Tradovate T&S module tab with the instrument search dropdown open to select a futures contract" } },
        { title: "Track More Than One Market", html: "Watching a few instruments at once? Add another tab inside the same T&amp;S module and load a second contract into it. Now one panel holds every market you follow, and you flip between them with a click instead of cluttering the screen with separate windows.", image: { src: `${IMG}/tradovate-time-and-sales-3.png`, alt: "Tradovate T&S module showing multiple instrument tabs for tracking several contracts" } },
        { title: "Read the Tape", html: "Every row is a single executed trade, and it carries four things: Time (when the trade printed, down to the thousandth of a second), Price (the price the trade executed at), Size (how many contracts were in that trade), and Acc (accumulated volume traded at that price so far this session). Color does the heavy lifting: green rows are buys, red rows are sells. Across the top of the module you'll see the last trade price, the net change for the session in points and percent, and the total volume traded.", image: { src: `${IMG}/tradovate-time-and-sales-4.png`, alt: "Tradovate T&S tape showing Time, Price, Size and Acc columns with green buy and red sell rows" } },
        { title: "Filter Out the Small Trades", html: "In a fast market the tape scrolls too quickly to read every clip. Use the <strong class='text-white'>Volume Filter</strong> to set a minimum contract size, and only prints at or above that number show up. It's set to <strong class='text-white'>1</strong> by default, so bump it to something like 10 or 25 and the single-lot noise drops away, leaving the larger orders that actually move price.", image: { src: `${IMG}/tradovate-time-and-sales-5.png`, alt: "Tradovate T&S Volume Filter set to a minimum contract size to hide small trades" } },
      ],
    },
    {
      type: "table",
      headers: ["Column", "What it tells you"],
      rows: [
        ["Time", "When the trade printed, down to the thousandth of a second."],
        ["Price", "The price the trade executed at."],
        ["Size", "How many contracts were in that trade."],
        ["Acc", "Accumulated volume traded at that price so far this session."],
      ],
    },
    { type: "heading", text: "Handy Things to Know" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Pair it with the ladder.</strong> The tape shows what already traded; the SuperDOM ladder shows the resting orders. Reading them side by side is where order flow gets useful.",
        "<strong class='text-white'>Keep a chart open too.</strong> Confirm what the tape is hinting at against price on your Tradovate chart before you commit.",
        "<strong class='text-white'>No extra columns.</strong> The T&amp;S module keeps a fixed layout. There's no column picker, so what you get is Time, Price, Size, and Acc, plus the volume filter.",
      ],
    },
    { type: "heading", text: "Let Your Strategy Trade the Tape for You" },
    { type: "paragraph", html: "Reading the tape by hand takes real screen time, and by the time you've confirmed a print and clicked, the move's often gone. PickMyTrade sends your TradingView alerts straight into Tradovate, so your entries and exits fire the moment your setup triggers, no staring at the tape required." },
  ], de: [
    { type: "paragraph",html: "Das Tape zeigt Ihnen, was der Chart nicht kann. Time &amp; Sales streamt jeden ausgeführten Trade in Echtzeit, sodass Sie die tatsächlichen Prints im Markt sehen: den Preis, wie viele Kontrakte den Besitzer wechselten und den genauen Zeitpunkt. So fügen Sie das Modul in Tradovate Web hinzu, laden Ihren Kontrakt und lesen den Fluss." },
    { type: "heading",text: "Was das T&S-Modul anzeigt" },
    { type: "paragraph",html: "T&amp;S steht für Time &amp; Sales. Andere Plattformen nennen es das Tape oder den Datenstrom. Es ist ein Marktdaten-Tool, das Trades in dem Moment auflistet, in dem sie für das jeweils ausgewählte Instrument ausgeführt werden. Ein Blick genügt, um zu sehen, wo Trades tatsächlich gefüllt werden und ob Größe auf der Bid- oder der Ask-Seite auftaucht. Deshalb halten Order-Flow-Trader es neben dem DOM geöffnet. Eines sollten Sie vorab klären: Das Tape zeigt Live-Trades nur, wenn Ihr Konto ein Echtzeit-Marktdaten-Abonnement hat. Bei verzögerten Daten sehen Sie weiterhin Prints, nur eben hinter dem Live-Markt." },
    { type: "heading",text: "Time & Sales hinzufügen und verwenden: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Ein Time-&-Sales-Modul öffnen", html: "Klicken Sie oben links in der Plattform auf die Schaltfläche <strong class='text-white'>+ (New)</strong>, ziehen Sie dann das Modul <strong class='text-white'>T&amp;S (Time &amp; Sales)</strong> per Drag-and-drop in Ihren Arbeitsbereich und legen Sie es dort ab, wo es sitzen soll. Es gibt auch einen schnelleren Weg: Klicken Sie mit der rechten Maustaste auf ein Instrument in einem Chart, SuperDOM oder Market Analyzer, und im unteren Bereich dieses Menüs können Sie ein neues T&amp;S-Modul mit bereits geladenem Instrument herausziehen.", image: {"src":`${IMG}/tradovate-time-and-sales-1.png`,"alt":"Tradovate-Menü „New“, in dem die Option T&S Time and Sales in den Arbeitsbereich gezogen wird"} },
        { title: "Ihr Instrument laden", html: "Klicken Sie mit der linken Maustaste auf den Instrumentennamen im Tab oben links im Modul. Ein Suchfeld klappt auf. Geben Sie den gewünschten Kontrakt ein, zum Beispiel <strong class='text-white'>ESU5</strong>, und wählen Sie ihn aus der Liste. Das Tape wechselt und beginnt sofort, die Trades dieses Marktes anzuzeigen.", image: {"src":`${IMG}/tradovate-time-and-sales-2.png`,"alt":"Tradovate-T&S-Modul-Tab mit geöffnetem Dropdown der Instrumentensuche zur Auswahl eines Futures-Kontrakts"} },
        { title: "Mehr als einen Markt verfolgen", html: "Möchten Sie mehrere Instrumente gleichzeitig beobachten? Fügen Sie im selben T&amp;S-Modul einen weiteren Tab hinzu und laden Sie darin einen zweiten Kontrakt. Jetzt hält ein Fenster alle Märkte, die Sie verfolgen, und Sie wechseln per Klick zwischen ihnen, statt den Bildschirm mit separaten Fenstern zu überladen.", image: {"src":`${IMG}/tradovate-time-and-sales-3.png`,"alt":"Tradovate-T&S-Modul mit mehreren Instrumenten-Tabs zur Beobachtung mehrerer Kontrakte"} },
        { title: "Das Tape lesen", html: "Jede Zeile ist ein einzelner ausgeführter Trade und enthält vier Angaben: Time (wann der Trade gedruckt wurde, auf die Tausendstelsekunde genau), Price (der Preis, zu dem der Trade ausgeführt wurde), Size (wie viele Kontrakte der Trade umfasste) und Acc (das akkumulierte Volumen, das in dieser Sitzung bisher zu diesem Preis gehandelt wurde). Die Farbe übernimmt die Hauptarbeit: Grüne Zeilen sind Käufe, rote Zeilen sind Verkäufe. Oben im Modul sehen Sie den letzten Trade-Preis, die Nettoveränderung der Sitzung in Punkten und Prozent sowie das gesamte gehandelte Volumen.", image: {"src":`${IMG}/tradovate-time-and-sales-4.png`,"alt":"Tradovate-T&S-Tape mit den Spalten Time, Price, Size und Acc sowie grünen Kauf- und roten Verkaufszeilen"} },
        { title: "Kleine Trades herausfiltern", html: "In einem schnellen Markt läuft das Tape zu rasch, um jeden Clip zu lesen. Mit dem <strong class='text-white'>Volume Filter</strong> legen Sie eine Mindestkontraktgröße fest, und es werden nur Prints ab dieser Zahl angezeigt. Standardmäßig steht er auf <strong class='text-white'>1</strong>. Erhöhen Sie ihn auf etwa 10 oder 25, und das Rauschen der Einzelkontrakte verschwindet und lässt die größeren Orders übrig, die den Preis tatsächlich bewegen.", image: {"src":`${IMG}/tradovate-time-and-sales-5.png`,"alt":"Tradovate-T&S-Volume-Filter mit eingestellter Mindestkontraktgröße, um kleine Trades auszublenden"} },
      ],
    },
    { type: "table", headers: ["Spalte","Was sie Ihnen sagt"], rows: [
      ["Time","Wann der Trade gedruckt wurde, auf die Tausendstelsekunde genau."],
      ["Price","Der Preis, zu dem der Trade ausgeführt wurde."],
      ["Size","Wie viele Kontrakte der Trade umfasste."],
      ["Acc","Das akkumulierte Volumen, das in dieser Sitzung bisher zu diesem Preis gehandelt wurde."],
    ] },
    { type: "heading",text: "Nützliches zum Mitnehmen" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Kombinieren Sie es mit der Leiter.</strong> Das Tape zeigt, was bereits gehandelt wurde; die SuperDOM-Leiter zeigt die ruhenden Orders. Beides nebeneinander zu lesen, macht Order Flow erst wirklich nützlich.",
        "<strong class='text-white'>Halten Sie auch einen Chart offen.</strong> Prüfen Sie, was das Tape andeutet, am Preis in Ihrem Tradovate-Chart, bevor Sie sich festlegen.",
        "<strong class='text-white'>Keine zusätzlichen Spalten.</strong> Das T&amp;S-Modul hat ein festes Layout. Es gibt keine Spaltenauswahl, Sie erhalten also Time, Price, Size und Acc sowie den Volume Filter.",
      ],
    },
    { type: "heading",text: "Lassen Sie Ihre Strategie das Tape für Sie handeln" },
    { type: "paragraph",html: "Das Tape von Hand zu lesen kostet echte Bildschirmzeit, und bis Sie einen Print bestätigt und geklickt haben, ist die Bewegung oft schon vorbei. PickMyTrade leitet Ihre TradingView-Alarme direkt an Tradovate weiter, sodass Ihre Einstiege und Ausstiege in dem Moment ausgelöst werden, in dem Ihr Setup eintritt, ganz ohne Starren auf das Tape." },
  ], es: [
    { type: "paragraph",html: "La cinta le cuenta lo que el gráfico no puede. Time &amp; Sales muestra en tiempo real cada operación ejecutada, de modo que ve las transacciones reales que llegan al mercado: el precio, cuántos contratos cambiaron de manos y el momento exacto en que ocurrió. Aquí le explicamos cómo añadir el módulo en Tradovate Web, cargar su contrato e interpretar el flujo." },
    { type: "heading",text: "Qué muestra el módulo T&S" },
    { type: "paragraph",html: "T&amp;S significa Time &amp; Sales. Otras plataformas lo llaman la cinta o el flujo de datos. Es una herramienta de datos de mercado que lista las operaciones a medida que se ejecutan para el instrumento que usted elija. De un vistazo le indica dónde se están ejecutando realmente las operaciones y si el volumen aparece en el bid o en el ask, por eso los traders de order flow lo mantienen abierto junto al DOM. Una cosa que debe aclarar primero: la cinta solo muestra operaciones en vivo si su cuenta tiene una suscripción de datos de mercado en tiempo real. Con datos retrasados seguirá viendo transacciones, pero por detrás del mercado en vivo." },
    { type: "heading",text: "Añada y use Time & Sales: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra un módulo Time & Sales", html: "Haga clic en el botón <strong class='text-white'>+ (New)</strong> situado arriba a la izquierda de la plataforma, luego arrastre y suelte el módulo <strong class='text-white'>T&amp;S (Time &amp; Sales)</strong> en su espacio de trabajo y colóquelo donde quiera que quede. También hay una vía más rápida: haga clic con el botón derecho sobre un instrumento en un gráfico, SuperDOM o Market Analyzer, y cerca de la parte inferior de ese menú podrá arrastrar un nuevo módulo T&amp;S con el instrumento ya cargado.", image: {"src":`${IMG}/tradovate-time-and-sales-1.png`,"alt":"Menú New de Tradovate con la opción T&S Time and Sales arrastrándose al espacio de trabajo"} },
        { title: "Cargue su instrumento", html: "Haga clic izquierdo en el nombre del instrumento en la pestaña de la parte superior izquierda del módulo. Se despliega un cuadro de búsqueda. Escriba el contrato que desea, por ejemplo <strong class='text-white'>ESU5</strong>, y selecciónelo de la lista. La cinta cambia y empieza a mostrar de inmediato las operaciones de ese mercado.", image: {"src":`${IMG}/tradovate-time-and-sales-2.png`,"alt":"Pestaña del módulo T&S de Tradovate con el desplegable de búsqueda de instrumentos abierto para seleccionar un contrato de futuros"} },
        { title: "Siga más de un mercado", html: "¿Vigila varios instrumentos a la vez? Añada otra pestaña dentro del mismo módulo T&amp;S y cargue en ella un segundo contrato. Así, un solo panel contiene todos los mercados que sigue y cambia entre ellos con un clic, en lugar de saturar la pantalla con ventanas separadas.", image: {"src":`${IMG}/tradovate-time-and-sales-3.png`,"alt":"Módulo T&S de Tradovate con varias pestañas de instrumentos para seguir varios contratos"} },
        { title: "Lea la cinta", html: "Cada fila es una única operación ejecutada y contiene cuatro datos: Time (cuándo se imprimió la operación, con precisión de milésima de segundo), Price (el precio al que se ejecutó), Size (cuántos contratos tenía esa operación) y Acc (el volumen acumulado negociado a ese precio en lo que va de sesión). El color hace el trabajo pesado: las filas verdes son compras y las rojas, ventas. En la parte superior del módulo verá el precio de la última operación, la variación neta de la sesión en puntos y porcentaje, y el volumen total negociado.", image: {"src":`${IMG}/tradovate-time-and-sales-4.png`,"alt":"Cinta T&S de Tradovate con las columnas Time, Price, Size y Acc y filas verdes de compra y rojas de venta"} },
        { title: "Filtre las operaciones pequeñas", html: "En un mercado rápido, la cinta avanza demasiado deprisa para leer cada operación. Use el <strong class='text-white'>Volume Filter</strong> para fijar un tamaño mínimo de contratos, y solo se mostrarán las transacciones iguales o superiores a esa cifra. Viene configurado en <strong class='text-white'>1</strong> por defecto, así que súbalo a algo como 10 o 25 y el ruido de los lotes sueltos desaparece, dejando las órdenes más grandes que realmente mueven el precio.", image: {"src":`${IMG}/tradovate-time-and-sales-5.png`,"alt":"Volume Filter de T&S de Tradovate configurado con un tamaño mínimo de contratos para ocultar las operaciones pequeñas"} },
      ],
    },
    { type: "table", headers: ["Columna","Qué le indica"], rows: [
      ["Time","Cuándo se imprimió la operación, con precisión de milésima de segundo."],
      ["Price","El precio al que se ejecutó la operación."],
      ["Size","Cuántos contratos tenía esa operación."],
      ["Acc","El volumen acumulado negociado a ese precio en lo que va de sesión."],
    ] },
    { type: "heading",text: "Cosas útiles que conviene saber" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Combínelo con la escalera.</strong> La cinta muestra lo que ya se negoció; la escalera del SuperDOM muestra las órdenes en reposo. Leerlos uno junto al otro es donde el order flow se vuelve realmente útil.",
        "<strong class='text-white'>Mantenga también un gráfico abierto.</strong> Contraste lo que insinúa la cinta con el precio en su gráfico de Tradovate antes de comprometerse.",
        "<strong class='text-white'>Sin columnas adicionales.</strong> El módulo T&amp;S mantiene un diseño fijo. No hay selector de columnas, así que obtiene Time, Price, Size y Acc, además del volume filter.",
      ],
    },
    { type: "heading",text: "Deje que su estrategia opere la cinta por usted" },
    { type: "paragraph",html: "Leer la cinta a mano requiere mucho tiempo frente a la pantalla, y para cuando ha confirmado una transacción y ha hecho clic, el movimiento suele haber pasado. PickMyTrade envía sus alertas de TradingView directamente a Tradovate, de modo que sus entradas y salidas se ejecutan en cuanto se activa su configuración, sin necesidad de mirar la cinta." },
  ], fr: [
    { type: "paragraph",html: "Le tape vous apprend ce que le graphique ne peut pas vous dire. Time &amp; Sales diffuse en temps réel chaque transaction exécutée, afin que vous voyiez les prints réels qui touchent le marché : le prix, le nombre de contrats échangés et l'instant précis où cela s'est produit. Voici comment ajouter le module dans Tradovate Web, charger votre contrat et lire le flux." },
    { type: "heading",text: "Ce qu'affiche le module T&S" },
    { type: "paragraph",html: "T&amp;S signifie Time &amp; Sales. D'autres plateformes l'appellent le tape ou le flux de données. C'est un outil de données de marché qui liste les transactions au fur et à mesure de leur exécution pour l'instrument que vous sélectionnez. Un coup d'œil suffit pour voir où les transactions sont réellement exécutées et si du volume apparaît au bid ou à l'ask, ce qui explique pourquoi les traders d'order flow le gardent ouvert à côté du DOM. Un point à régler d'abord : le tape n'affiche les transactions en direct que si votre compte dispose d'un abonnement aux données de marché en temps réel. Avec des données différées, vous verrez quand même des prints, mais en retard sur le marché en direct." },
    { type: "heading",text: "Ajouter et utiliser Time & Sales : pas à pas" },
    {
      type: "steps",
      items: [
        { title: "Ouvrez un module Time & Sales", html: "Cliquez sur le bouton <strong class='text-white'>+ (New)</strong> en haut à gauche de la plateforme, puis faites glisser le module <strong class='text-white'>T&amp;S (Time &amp; Sales)</strong> dans votre espace de travail et déposez-le à l'endroit souhaité. Il existe aussi un chemin plus rapide : faites un clic droit sur un instrument dans un graphique, un SuperDOM ou un Market Analyzer, et vers le bas de ce menu vous pouvez faire glisser un nouveau module T&amp;S avec l'instrument déjà chargé.", image: {"src":`${IMG}/tradovate-time-and-sales-1.png`,"alt":"Menu New de Tradovate avec l'option T&S Time and Sales glissée dans l'espace de travail"} },
        { title: "Chargez votre instrument", html: "Faites un clic gauche sur le nom de l'instrument dans l'onglet en haut à gauche du module. Une zone de recherche se déroule. Saisissez le contrat voulu, par exemple <strong class='text-white'>ESU5</strong>, et sélectionnez-le dans la liste. Le tape bascule et commence aussitôt à afficher les transactions de ce marché.", image: {"src":`${IMG}/tradovate-time-and-sales-2.png`,"alt":"Onglet du module T&S de Tradovate avec la liste déroulante de recherche d'instruments ouverte pour sélectionner un contrat à terme"} },
        { title: "Suivez plusieurs marchés", html: "Vous surveillez plusieurs instruments à la fois ? Ajoutez un autre onglet dans le même module T&amp;S et chargez-y un second contrat. Un seul panneau contient alors tous les marchés que vous suivez, et vous passez de l'un à l'autre d'un clic plutôt que d'encombrer l'écran de fenêtres séparées.", image: {"src":`${IMG}/tradovate-time-and-sales-3.png`,"alt":"Module T&S de Tradovate avec plusieurs onglets d'instruments pour suivre plusieurs contrats"} },
        { title: "Lisez le tape", html: "Chaque ligne est une transaction exécutée unique et contient quatre informations : Time (l'instant où la transaction a été imprimée, à la milliseconde près), Price (le prix auquel elle a été exécutée), Size (le nombre de contrats de cette transaction) et Acc (le volume cumulé échangé à ce prix depuis le début de la séance). La couleur fait le gros du travail : les lignes vertes sont des achats, les rouges des ventes. En haut du module figurent le prix de la dernière transaction, la variation nette de la séance en points et en pourcentage, ainsi que le volume total échangé.", image: {"src":`${IMG}/tradovate-time-and-sales-4.png`,"alt":"Tape T&S de Tradovate avec les colonnes Time, Price, Size et Acc et des lignes vertes d'achat et rouges de vente"} },
        { title: "Filtrez les petites transactions", html: "Sur un marché rapide, le tape défile trop vite pour lire chaque transaction. Utilisez le <strong class='text-white'>Volume Filter</strong> pour définir une taille minimale en contrats ; seuls les prints égaux ou supérieurs à ce nombre s'affichent. Il est réglé sur <strong class='text-white'>1</strong> par défaut ; portez-le à 10 ou 25 et le bruit des lots unitaires disparaît, ne laissant que les ordres plus importants qui font réellement bouger le prix.", image: {"src":`${IMG}/tradovate-time-and-sales-5.png`,"alt":"Volume Filter du T&S de Tradovate réglé sur une taille minimale de contrats pour masquer les petites transactions"} },
      ],
    },
    { type: "table", headers: ["Colonne","Ce qu'elle vous indique"], rows: [
      ["Time","L'instant où la transaction a été imprimée, à la milliseconde près."],
      ["Price","Le prix auquel la transaction a été exécutée."],
      ["Size","Le nombre de contrats de cette transaction."],
      ["Acc","Le volume cumulé échangé à ce prix depuis le début de la séance."],
    ] },
