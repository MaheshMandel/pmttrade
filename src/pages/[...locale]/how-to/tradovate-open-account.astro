---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-open-account";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "How to Open a Tradovate Trading Account";
const META_DESCRIPTION =
  "Open a Tradovate account in minutes: pick an account type, complete the application, verify your ID, and fund it to start trading futures.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "So eröffnen Sie ein Tradovate-Handelskonto", es: "Cómo abrir una cuenta de trading en Tradovate", fr: "Comment ouvrir un compte de trading Tradovate", it: "Come aprire un conto di trading Tradovate" },
  dek: { en: "Need a live Tradovate account so you can trade real futures, or wire up automation like PickMyTrade? Here's the whole path in order: apply, verify your identity, fund the account.", de: "Sie brauchen ein Live-Konto bei Tradovate, um echte Futures zu handeln oder eine Automatisierung wie PickMyTrade anzubinden? Hier ist der gesamte Weg in der richtigen Reihenfolge: beantragen, Identität verifizieren, Konto finanzieren.", es: "¿Necesita una cuenta real de Tradovate para operar futuros reales o conectar una automatización como PickMyTrade? Aquí tiene todo el proceso en orden: solicitar, verificar su identidad y fondear la cuenta.", fr: "Besoin d'un compte Tradovate réel pour trader de vrais contrats à terme ou connecter une automatisation comme PickMyTrade ? Voici tout le parcours dans l'ordre : faire la demande, vérifier votre identité, alimenter le compte.", it: "Ha bisogno di un conto Tradovate reale per negoziare futures veri o collegare un'automazione come PickMyTrade? Ecco l'intero percorso in ordine: presentare la domanda, verificare l'identità, finanziare il conto." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Need a live Tradovate account so you can trade real futures, or wire up automation like PickMyTrade? Here's the whole path in order: apply, verify your identity, fund the account. Follow it step by step and you'll be approved and trading about as fast as Tradovate's review team can move." },
    { type: "heading", text: "What Is a Tradovate Account?" },
    { type: "paragraph", html: "A Tradovate account is a live futures brokerage account. It lets you trade CME products, E-mini and Micro E-mini index contracts, plus energy, metals, and agricultural futures, from Tradovate's web, desktop, and mobile apps. To open one, you complete a regulated brokerage application (that's the KYC identity check) and fund it before any live order goes through." },
    { type: "heading", text: "Open a Tradovate Account: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Create Your Tradovate User (or Log In With Your Demo)", html: "New here? Head to Tradovate's \"Open Your Trading Account\" page and click <strong class='text-white'>REGISTER</strong> to set up a username and password. Already ran a Tradovate demo? Skip the sign-up, click <strong class='text-white'>LOGIN</strong> and start the application with the same credentials you use for the sim. There's no second account to create." },
        { title: "Select Your Trading Account Type", html: "Pick the structure that matches how you'll trade: <strong class='text-white'>Individual</strong>, <strong class='text-white'>Joint</strong>, <strong class='text-white'>IRA</strong>, or an entity type like Corporate, LLC, Trust, or Partnership. Most people open an Individual account, and it's the quickest, usually just a few minutes start to finish. Going the retirement route? Choose IRA and enter the custodian Tradovate lists when it prompts you." },
        { title: "Complete the Account Application", html: "Now the paperwork. Enter your personal details first, full legal name, address, and date of birth, then your financial background. Tradovate wants income details to confirm you're trading with risk capital: employer name and business type if you're employed, business details if you're self-employed, the investment types you hold, or your retirement income source. Inheritance, allowances, and plain savings don't count as valid income here." },
        { title: "Verify Your Identity (KYC)", html: "Federal regulations require Know Your Customer (KYC) verification, so you'll upload a government-issued photo ID, driver's license, passport, or state ID. Make sure the image is clear and shows your full legal name, photo, and date of birth. Tradovate runs an automated verification system to speed this along. Depending on your situation, it may also ask for a current bank statement or a full-time trader statement." },
        { title: "Submit, Get Approved, and Fund Your Account", html: "Hit submit and the application goes to Tradovate's New Accounts team. They usually review it within a couple of business days and email you the moment your account is approved. Once you're cleared, fund it by ACH, wire transfer, debit card, or mailed check, then place your first live trade. Funding minimums differ by account type and can change, so confirm Tradovate's current requirements before you deposit." },
      ],
    },
    { type: "heading", text: "Why You'd Need This" },
    {
      type: "list",
      items: [
        "Move from simulated trading to a funded, live futures account",
        "Trade index, energy, metals, and agricultural futures on web, desktop, or mobile",
        "Meet the regulatory KYC requirements needed to route live orders",
        "Connect the account to TradingView or automation tools for hands-off trading",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Once your account is live, <strong class='text-white'>PickMyTrade links your TradingView alerts straight to Tradovate</strong> so your entries, stops, and targets fire automatically, no manual clicks, no missed fills." },
  ], de: [
    { type: "paragraph",html: "Sie brauchen ein Live-Konto bei Tradovate, um echte Futures zu handeln oder eine Automatisierung wie PickMyTrade anzubinden? Hier ist der gesamte Weg in der richtigen Reihenfolge: beantragen, Identität verifizieren, Konto finanzieren. Folgen Sie ihm Schritt für Schritt, und Sie sind so schnell genehmigt und handelsbereit, wie das Prüfteam von Tradovate arbeiten kann." },
    { type: "heading",text: "Was ist ein Tradovate-Konto?" },
    { type: "paragraph",html: "Ein Tradovate-Konto ist ein Live-Futures-Brokerkonto. Es ermöglicht Ihnen den Handel mit CME-Produkten, E-mini- und Micro-E-mini-Indexkontrakten sowie Energie-, Metall- und Agrar-Futures über die Web-, Desktop- und Mobil-Apps von Tradovate. Um eines zu eröffnen, füllen Sie einen regulierten Brokerantrag aus (die KYC-Identitätsprüfung) und finanzieren es, bevor eine Live-Order ausgeführt wird." },
    { type: "heading",text: "Ein Tradovate-Konto eröffnen: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Tradovate-Benutzer anlegen (oder mit dem Demo-Login anmelden)", html: "Neu hier? Rufen Sie die Seite „Open Your Trading Account“ von Tradovate auf und klicken Sie auf <strong class='text-white'>REGISTER</strong>, um Benutzernamen und Passwort festzulegen. Haben Sie bereits eine Tradovate-Demo genutzt? Überspringen Sie die Registrierung, klicken Sie auf <strong class='text-white'>LOGIN</strong> und starten Sie den Antrag mit denselben Zugangsdaten, die Sie für die Simulation verwenden. Ein zweites Konto müssen Sie nicht anlegen." },
        { title: "Kontotyp auswählen", html: "Wählen Sie die Struktur, die zu Ihrer Handelsweise passt: <strong class='text-white'>Individual</strong>, <strong class='text-white'>Joint</strong>, <strong class='text-white'>IRA</strong> oder einen Unternehmenstyp wie Corporate, LLC, Trust oder Partnership. Die meisten eröffnen ein Individual-Konto, das ist am schnellsten und dauert meist nur wenige Minuten von Anfang bis Ende. Gehen Sie den Weg der Altersvorsorge? Wählen Sie IRA und geben Sie den Verwahrer an, den Tradovate beim entsprechenden Hinweis nennt." },
        { title: "Kontoantrag ausfüllen", html: "Jetzt folgt der Papierkram. Geben Sie zuerst Ihre persönlichen Daten ein, vollständiger gesetzlicher Name, Adresse und Geburtsdatum, danach Ihren finanziellen Hintergrund. Tradovate verlangt Einkommensangaben, um zu bestätigen, dass Sie mit Risikokapital handeln: Name und Branche des Arbeitgebers, wenn Sie angestellt sind, Geschäftsangaben, wenn Sie selbstständig sind, die Anlageformen, die Sie halten, oder Ihre Quelle des Renteneinkommens. Erbschaften, Zuwendungen und reine Ersparnisse zählen hier nicht als gültiges Einkommen." },
        { title: "Identität verifizieren (KYC)", html: "Bundesvorschriften verlangen eine Know-Your-Customer-Verifizierung (KYC), daher laden Sie einen amtlichen Lichtbildausweis hoch, Führerschein, Reisepass oder staatlichen Ausweis. Achten Sie darauf, dass das Bild klar ist und Ihren vollständigen gesetzlichen Namen, Ihr Foto und Ihr Geburtsdatum zeigt. Tradovate nutzt ein automatisiertes Verifizierungssystem, um den Vorgang zu beschleunigen. Je nach Ihrer Situation kann zusätzlich ein aktueller Kontoauszug oder ein Nachweis als Vollzeit-Trader verlangt werden." },
        { title: "Absenden, genehmigt werden und Konto finanzieren", html: "Klicken Sie auf Absenden, und der Antrag geht an das New-Accounts-Team von Tradovate. Es prüft ihn in der Regel innerhalb weniger Werktage und schickt Ihnen eine E-Mail, sobald Ihr Konto genehmigt ist. Sobald Sie freigegeben sind, finanzieren Sie es per ACH, Überweisung, Debitkarte oder per Post gesendetem Scheck und platzieren Ihren ersten Live-Trade. Die Mindestbeträge unterscheiden sich je nach Kontotyp und können sich ändern. Bestätigen Sie daher die aktuellen Anforderungen von Tradovate, bevor Sie einzahlen." },
      ],
    },
    { type: "heading",text: "Warum Sie das brauchen" },
    {
      type: "list",
      items: [
        "Vom simulierten Handel zu einem finanzierten Live-Futures-Konto wechseln",
        "Index-, Energie-, Metall- und Agrar-Futures im Web, auf dem Desktop oder mobil handeln",
        "Die regulatorischen KYC-Anforderungen erfüllen, die zum Weiterleiten von Live-Orders nötig sind",
        "Das Konto mit TradingView oder Automatisierungstools für freihändigen Handel verbinden",
      ],
    },
    { type: "heading",text: "Automatisieren mit PickMyTrade" },
    { type: "paragraph",html: "Sobald Ihr Konto live ist, <strong class='text-white'>verbindet PickMyTrade Ihre TradingView-Alarme direkt mit Tradovate</strong>, sodass Ihre Einstiege, Stopps und Ziele automatisch ausgelöst werden, ohne manuelle Klicks und ohne verpasste Fills." },
  ], es: [
    { type: "paragraph",html: "¿Necesita una cuenta real de Tradovate para operar futuros reales o conectar una automatización como PickMyTrade? Aquí tiene todo el proceso en orden: solicitar, verificar su identidad y fondear la cuenta. Siga los pasos uno a uno y quedará aprobado y operando tan rápido como el equipo de revisión de Tradovate pueda trabajar." },
    { type: "heading",text: "¿Qué es una cuenta de Tradovate?" },
    { type: "paragraph",html: "Una cuenta de Tradovate es una cuenta de corretaje de futuros real. Le permite operar productos de CME, contratos de índices E-mini y Micro E-mini, además de futuros de energía, metales y agrícolas, desde las aplicaciones web, de escritorio y móvil de Tradovate. Para abrir una, completa una solicitud de corretaje regulada (la verificación de identidad KYC) y la fondea antes de que se ejecute cualquier orden real." },
    { type: "heading",text: "Abrir una cuenta de Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Cree su usuario de Tradovate (o inicie sesión con su demo)", html: "¿Es nuevo? Vaya a la página «Open Your Trading Account» de Tradovate y haga clic en <strong class='text-white'>REGISTER</strong> para crear un nombre de usuario y una contraseña. ¿Ya usó una demo de Tradovate? Omita el registro, haga clic en <strong class='text-white'>LOGIN</strong> e inicie la solicitud con las mismas credenciales que usa para la simulación. No hay que crear una segunda cuenta." },
        { title: "Seleccione el tipo de cuenta de trading", html: "Elija la estructura que corresponda a su forma de operar: <strong class='text-white'>Individual</strong>, <strong class='text-white'>Joint</strong>, <strong class='text-white'>IRA</strong> o un tipo de entidad como Corporate, LLC, Trust o Partnership. La mayoría abre una cuenta Individual, que es la más rápida, normalmente solo unos minutos de principio a fin. ¿Va por la vía de jubilación? Elija IRA e introduzca el custodio que Tradovate indique cuando se lo solicite." },
        { title: "Complete la solicitud de cuenta", html: "Ahora llega el papeleo. Introduzca primero sus datos personales, nombre legal completo, dirección y fecha de nacimiento, y luego su situación financiera. Tradovate pide datos de ingresos para confirmar que opera con capital de riesgo: nombre del empleador y tipo de negocio si es empleado, datos del negocio si es autónomo, los tipos de inversión que posee o su fuente de ingresos de jubilación. Las herencias, las asignaciones y los simples ahorros no cuentan aquí como ingresos válidos." },
        { title: "Verifique su identidad (KYC)", html: "La normativa federal exige la verificación Know Your Customer (KYC), así que subirá una identificación con foto emitida por el gobierno: carnet de conducir, pasaporte o documento de identidad estatal. Asegúrese de que la imagen sea nítida y muestre su nombre legal completo, su foto y su fecha de nacimiento. Tradovate utiliza un sistema de verificación automatizado para acelerar el proceso. Según su situación, también puede pedirle un extracto bancario reciente o un comprobante de trader a tiempo completo." },
        { title: "Envíe, obtenga la aprobación y fondee su cuenta", html: "Pulse enviar y la solicitud pasa al equipo de New Accounts de Tradovate. Normalmente la revisan en un par de días hábiles y le envían un correo en cuanto su cuenta queda aprobada. Una vez autorizado, fondéela por ACH, transferencia bancaria, tarjeta de débito o cheque enviado por correo, y realice su primera operación real. Los mínimos de fondeo difieren según el tipo de cuenta y pueden cambiar, así que confirme los requisitos actuales de Tradovate antes de depositar." },
      ],
    },
    { type: "heading",text: "Por qué lo necesitaría" },
    {
      type: "list",
      items: [
        "Pasar del trading simulado a una cuenta real de futuros fondeada",
        "Operar futuros de índices, energía, metales y agrícolas en web, escritorio o móvil",
        "Cumplir los requisitos regulatorios de KYC necesarios para enviar órdenes reales",
        "Conectar la cuenta a TradingView o a herramientas de automatización para operar sin intervención manual",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Una vez que su cuenta esté activa, <strong class='text-white'>PickMyTrade conecta sus alertas de TradingView directamente con Tradovate</strong> para que sus entradas, stops y objetivos se ejecuten automáticamente, sin clics manuales ni ejecuciones perdidas." },
  ], fr: [
    { type: "paragraph",html: "Besoin d'un compte Tradovate réel pour trader de vrais contrats à terme ou connecter une automatisation comme PickMyTrade ? Voici tout le parcours dans l'ordre : faire la demande, vérifier votre identité, alimenter le compte. Suivez-le étape par étape et vous serez approuvé et prêt à trader aussi vite que l'équipe de vérification de Tradovate le permet." },
    { type: "heading",text: "Qu'est-ce qu'un compte Tradovate ?" },
    { type: "paragraph",html: "Un compte Tradovate est un compte de courtage réel pour contrats à terme. Il vous permet de trader les produits du CME, les contrats d'indices E-mini et Micro E-mini, ainsi que les contrats à terme sur l'énergie, les métaux et les produits agricoles, depuis les applications web, de bureau et mobile de Tradovate. Pour en ouvrir un, vous remplissez une demande de courtage réglementée (la vérification d'identité KYC) et vous l'alimentez avant qu'un ordre réel puisse être exécuté." },
    { type: "heading",text: "Ouvrir un compte Tradovate : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Créer votre utilisateur Tradovate (ou vous connecter avec votre démo)", html: "Nouveau ici ? Rendez-vous sur la page « Open Your Trading Account » de Tradovate et cliquez sur <strong class='text-white'>REGISTER</strong> pour créer un nom d'utilisateur et un mot de passe. Vous avez déjà utilisé une démo Tradovate ? Passez l'inscription, cliquez sur <strong class='text-white'>LOGIN</strong> et lancez la demande avec les mêmes identifiants que ceux de la simulation. Il n'y a pas de second compte à créer." },
        { title: "Sélectionner votre type de compte de trading", html: "Choisissez la structure qui correspond à votre façon de trader : <strong class='text-white'>Individual</strong>, <strong class='text-white'>Joint</strong>, <strong class='text-white'>IRA</strong> ou un type d'entité comme Corporate, LLC, Trust ou Partnership. La plupart des gens ouvrent un compte Individual, le plus rapide, généralement quelques minutes du début à la fin. Vous passez par l'épargne retraite ? Choisissez IRA et saisissez le dépositaire indiqué par Tradovate lorsqu'il vous le demande." },
        { title: "Remplir la demande d'ouverture de compte", html: "Place à la paperasse. Saisissez d'abord vos informations personnelles, nom légal complet, adresse et date de naissance, puis votre situation financière. Tradovate demande des informations sur vos revenus pour confirmer que vous tradez avec du capital à risque : nom de l'employeur et type d'activité si vous êtes salarié, informations sur l'entreprise si vous êtes indépendant, les types d'investissements que vous détenez ou votre source de revenus de retraite. Les héritages, les pensions allouées et la simple épargne ne comptent pas ici comme des revenus valables." },
        { title: "Vérifier votre identité (KYC)", html: "La réglementation fédérale exige une vérification Know Your Customer (KYC) ; vous téléversez donc une pièce d'identité officielle avec photo : permis de conduire, passeport ou carte d'identité d'État. Veillez à ce que l'image soit nette et montre votre nom légal complet, votre photo et votre date de naissance. Tradovate utilise un système de vérification automatisé pour accélérer le processus. Selon votre situation, il peut également demander un relevé bancaire récent ou un justificatif de trader à temps plein." },
        { title: "Soumettre, être approuvé et alimenter votre compte", html: "Cliquez sur soumettre et la demande part vers l'équipe New Accounts de Tradovate. Elle l'examine généralement sous quelques jours ouvrables et vous envoie un e-mail dès que votre compte est approuvé. Une fois la validation obtenue, alimentez-le par ACH, virement bancaire, carte de débit ou chèque envoyé par courrier, puis passez votre premier trade réel. Les minimums de dépôt diffèrent selon le type de compte et peuvent changer ; vérifiez donc les exigences actuelles de Tradovate avant de déposer." },
      ],
    },
    { type: "heading",text: "Pourquoi en avez-vous besoin" },
    {
      type: "list",
      items: [
        "Passer du trading simulé à un compte de contrats à terme réel et alimenté",
        "Trader les contrats à terme sur indices, énergie, métaux et produits agricoles sur le web, le bureau ou le mobile",
        "Satisfaire les exigences réglementaires KYC nécessaires pour acheminer des ordres réels",
        "Connecter le compte à TradingView ou à des outils d'automatisation pour un trading sans intervention manuelle",
      ],
    },
    { type: "heading",text: "Automatiser avec PickMyTrade" },
    { type: "paragraph",html: "Une fois votre compte actif, <strong class='text-white'>PickMyTrade relie vos alertes TradingView directement à Tradovate</strong> pour que vos entrées, stops et objectifs se déclenchent automatiquement, sans clics manuels ni exécutions manquées." },
  ], it: [
    { type: "paragraph",html: "Ha bisogno di un conto Tradovate reale per negoziare futures veri o collegare un'automazione come PickMyTrade? Ecco l'intero percorso in ordine: presentare la domanda, verificare l'identità, finanziare il conto. Lo segua passo dopo passo e sarà approvato e pronto a operare con la stessa rapidità con cui riesce a lavorare il team di revisione di Tradovate." },
    { type: "heading",text: "Che cos'è un conto Tradovate?" },
    { type: "paragraph",html: "Un conto Tradovate è un conto di intermediazione reale sui futures. Le consente di negoziare prodotti CME, contratti su indici E-mini e Micro E-mini, oltre a futures su energia, metalli e prodotti agricoli, dalle app web, desktop e mobile di Tradovate. Per aprirne uno, compila una domanda di intermediazione regolamentata (la verifica d'identità KYC) e lo finanzia prima che qualsiasi ordine reale venga eseguito." },
    { type: "heading",text: "Aprire un conto Tradovate: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Crei il Suo utente Tradovate (oppure acceda con la demo)", html: "È nuovo? Vada alla pagina «Open Your Trading Account» di Tradovate e clicchi su <strong class='text-white'>REGISTER</strong> per creare nome utente e password. Ha già provato una demo di Tradovate? Salti la registrazione, clicchi su <strong class='text-white'>LOGIN</strong> e avvii la domanda con le stesse credenziali che usa per la simulazione. Non c'è un secondo account da creare." },
        { title: "Selezioni il tipo di conto di trading", html: "Scelga la struttura adatta al Suo modo di operare: <strong class='text-white'>Individual</strong>, <strong class='text-white'>Joint</strong>, <strong class='text-white'>IRA</strong> oppure un tipo di entità come Corporate, LLC, Trust o Partnership. La maggior parte delle persone apre un conto Individual, il più rapido, di solito solo pochi minuti dall'inizio alla fine. Se sceglie la via pensionistica, selezioni IRA e inserisca il custode indicato da Tradovate quando richiesto." },
        { title: "Completi la domanda di apertura del conto", html: "Ora tocca alle pratiche. Inserisca prima i Suoi dati personali, nome legale completo, indirizzo e data di nascita, poi la Sua situazione finanziaria. Tradovate richiede informazioni sul reddito per confermare che opera con capitale di rischio: nome del datore di lavoro e tipo di attività se è dipendente, dettagli dell'attività se è lavoratore autonomo, i tipi di investimento che detiene o la fonte del reddito da pensione. Eredità, assegni e semplici risparmi non contano qui come reddito valido." },
        { title: "Verifichi la Sua identità (KYC)", html: "La normativa federale richiede la verifica Know Your Customer (KYC), quindi dovrà caricare un documento d'identità con foto rilasciato dal governo: patente di guida, passaporto o carta d'identità statale. Si assicuri che l'immagine sia nitida e mostri il Suo nome legale completo, la foto e la data di nascita. Tradovate utilizza un sistema di verifica automatizzato per velocizzare il processo. A seconda della Sua situazione, può richiedere anche un estratto conto bancario recente o un attestato di trader a tempo pieno." },
        { title: "Invii, ottenga l'approvazione e finanzi il conto", html: "Clicchi su invia e la domanda passa al team New Accounts di Tradovate. Di solito la esaminano entro un paio di giorni lavorativi e Le inviano un'e-mail non appena il conto viene approvato. Una volta autorizzato, lo finanzi tramite ACH, bonifico bancario, carta di debito o assegno inviato per posta, quindi effettui il Suo primo trade reale. I minimi di finanziamento differiscono in base al tipo di conto e possono cambiare, quindi verifichi i requisiti attuali di Tradovate prima di versare." },
      ],
    },
    { type: "heading",text: "Perché Le serve" },
    {
      type: "list",
      items: [
        "Passare dal trading simulato a un conto reale sui futures finanziato",
        "Negoziare futures su indici, energia, metalli e prodotti agricoli da web, desktop o mobile",
        "Soddisfare i requisiti normativi KYC necessari per instradare ordini reali",
        "Collegare il conto a TradingView o a strumenti di automazione per un trading senza intervento manuale",
      ],
    },
    { type: "heading",text: "Automatizzi con PickMyTrade" },
    { type: "paragraph",html: "Una volta attivo il Suo conto, <strong class='text-white'>PickMyTrade collega i Suoi alert di TradingView direttamente a Tradovate</strong> così ingressi, stop e target scattano automaticamente, senza clic manuali e senza fill mancati." },
  ] },
