---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-eval-data-agreement";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Sign Tradovate's Data Agreement for a Prop Eval";
const META_DESCRIPTION =
  "Sign your prop evaluation account's Tradovate data agreement, pick non-professional, and get live futures quotes flowing from orange to white.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Die Datenvereinbarung von Tradovate für eine Prop-Evaluation unterzeichnen", es: "Firmar el acuerdo de datos de Tradovate para una evaluación prop", fr: "Signer l'accord de données de Tradovate pour une évaluation prop", it: "Firmare l'accordo sui dati di Tradovate per una valutazione prop" },
  dek: { en: "Prices frozen or stuck ten minutes behind on your prop eval account? Here's how to sign Tradovate's market data agreement, pick Non-Professional, and get your symbols flowing from orange to white.", de: "Preise eingefroren oder zehn Minuten verzögert auf Ihrem Prop-Eval-Konto? So unterzeichnen Sie die Marktdatenvereinbarung von Tradovate, wählen Non-Professional und bringen Ihre Symbole von Orange auf Weiß.", es: "¿Precios congelados o con diez minutos de retraso en su cuenta de evaluación prop? Así se firma el acuerdo de datos de mercado de Tradovate, se elige No profesional y se logra que sus símbolos pasen de naranja a blanco.", fr: "Prix figés ou en retard de dix minutes sur votre compte d'évaluation prop ? Voici comment signer l'accord de données de marché de Tradovate, choisir Non-Professional et faire passer vos symboles de l'orange au blanc.", it: "Prezzi bloccati o in ritardo di dieci minuti sul suo conto di valutazione prop? Ecco come firmare l'accordo sui dati di mercato di Tradovate, scegliere Non-Professional e far passare i suoi simboli da arancione a bianco." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You passed the checkout, your prop firm emailed your login, and you fired up Tradovate, but the prices are frozen or stuck ten minutes behind. Nine times out of ten, one form is the holdup. Before an evaluation account will stream live futures quotes, you have to sign Tradovate's market data agreement once, inside the web app, and mark yourself Non-Professional. Do that, wait a bit, and your symbols flip from orange to white. Here's the whole thing, start to finish." },
    { type: "heading", text: "Why the Data Agreement Exists" },
    { type: "paragraph", html: "Tradovate carries CME Group data, and the exchange won't release real-time quotes until every account holder certifies who they are. On a prop eval, the firm creates your login and usually bundles Level 1 CME data with the account, but the certification is personal. Nobody at the firm can sign it for you. Skip it and you're stuck on delayed data, which is why so many \"my charts are broken\" moments trace back to this one screen." },
    { type: "heading", text: "Signing the Agreement: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Log In Through the Tradovate Web App", html: "Do this part in the browser platform, not the desktop app, not mobile, and not through TradingView. The agreement screens only surface in the web app, and you only sign them once. Enter the evaluation credentials your firm sent you (the username often starts with a firm prefix) and sign in. If you land on a \"fund your account\" page instead, you're on the wrong login, go back and use the eval credentials." },
        { title: "Read the Certification and Choose Non-Professional", html: "The first screen is the market data subscriber certification. Scroll through it to the classification step and select <strong class='text-white'>Non-Professional</strong>. That's the right call for a retail trader funded by a prop firm, and it keeps you off the professional data tariff, which runs several hundred dollars a month. Only choose Professional if exchange rules genuinely put you in that bucket, trading on behalf of a firm, registered with a regulator, that kind of thing." },
        { title: "Check the Boxes and Sign Your Name", html: "Next you'll tick a couple of agreement checkboxes and type your name into a signature field. Type it <strong class='text-white'>exactly</strong> as it's printed just above the box, same capitalization, spacing, and any accents. A tiny mismatch is the number-one reason the form won't submit. Once it matches, the <strong class='text-white'>Sign</strong> (or Next) button goes live. Click it." },
        { title: "Accept the License and Confirm Evaluation", html: "Right after the data agreement, Tradovate shows its End User License Agreement. Scroll to the bottom and accept it. Then you'll pick your trading mode, choose <strong class='text-white'>Evaluation</strong> (older builds labeled this Simulation). Heads up: once you're in Evaluation mode, every trade counts toward your eval, so don't throw practice orders at it just to \"test\" the connection." },
        { title: "Wait for Activation and Check Symbol Colors", html: "Live data doesn't switch on the instant you sign. Depending on demand, it can take anywhere from <strong class='text-white'>10 to 90 minutes</strong>. The fastest status check is the color of the instrument name on your chart or DOM: <strong class='text-white'>white means live data is flowing</strong>, and <strong class='text-white'>orange means it's still delayed</strong> or the agreement hasn't cleared. Still orange after 90 minutes? Log out and back in before you do anything else, a fresh session often pulls the entitlement through." },
      ],
    },
    { type: "heading", text: "Still Stuck on Orange Data?" },
    { type: "paragraph", html: "On a prop evaluation account, the firm owns the Tradovate account and controls the data entitlement. If you've signed everything, waited past 90 minutes, and re-logged in but symbols are still orange, the fix usually sits on the firm's side, they may need to enable or re-push the market data entitlement for your account. Which data package ships with your eval, how long provisioning takes, and the exact rules all vary by firm and account size, so check your firm's current setup guide before you open a support ticket." },
    { type: "heading", text: "Automate Your Eval with PickMyTrade" },
    { type: "paragraph", html: "Once your data's live and your account's cleared, <strong class='text-white'>PickMyTrade routes your TradingView alerts straight to Tradovate</strong>, so your strategy fires the moment your chart signals, with no manual clicking during your evaluation." },
  ], de: [
    { type: "paragraph",html: "Sie haben den Checkout bestanden, Ihre Prop-Firma hat Ihnen die Zugangsdaten gemailt, und Sie haben Tradovate gestartet, aber die Kurse sind eingefroren oder zehn Minuten verzögert. In neun von zehn Fällen ist ein einziges Formular schuld. Bevor ein Evaluationskonto Live-Futures-Kurse streamt, müssen Sie die Marktdatenvereinbarung von Tradovate einmalig in der Web-App unterzeichnen und sich als Non-Professional einstufen. Tun Sie das, warten Sie eine Weile, und Ihre Symbole wechseln von Orange auf Weiß. Hier ist alles von Anfang bis Ende." },
    { type: "heading",text: "Warum es die Datenvereinbarung gibt" },
    { type: "paragraph",html: "Tradovate führt CME-Group-Daten, und die Börse gibt keine Echtzeitkurse frei, bevor jeder Kontoinhaber bestätigt hat, wer er ist. Bei einer Prop-Evaluation erstellt die Firma Ihren Zugang und bündelt in der Regel CME-Level-1-Daten mit dem Konto, aber die Zertifizierung ist persönlich. Niemand bei der Firma kann sie für Sie unterschreiben. Wenn Sie sie überspringen, bleiben Sie bei verzögerten Daten, weshalb so viele Momente von „meine Charts sind kaputt“ auf diesen einen Bildschirm zurückgehen." },
    { type: "heading",text: "Die Vereinbarung unterzeichnen: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Über die Tradovate-Web-App anmelden", html: "Erledigen Sie diesen Teil in der Browser-Plattform, nicht in der Desktop-App, nicht mobil und nicht über TradingView. Die Vereinbarungsbildschirme erscheinen nur in der Web-App, und Sie unterzeichnen sie nur einmal. Geben Sie die Evaluations-Zugangsdaten ein, die Ihre Firma Ihnen geschickt hat (der Benutzername beginnt oft mit einem Firmenpräfix), und melden Sie sich an. Wenn Sie stattdessen auf einer Seite „Konto aufladen“ landen, nutzen Sie die falsche Anmeldung. Gehen Sie zurück und verwenden Sie die Eval-Zugangsdaten." },
        { title: "Zertifizierung lesen und Non-Professional wählen", html: "Der erste Bildschirm ist die Zertifizierung als Marktdaten-Abonnent. Scrollen Sie bis zum Schritt der Klassifizierung und wählen Sie <strong class='text-white'>Non-Professional</strong>. Das ist die richtige Wahl für einen privaten Trader, der von einer Prop-Firma finanziert wird, und es hält Sie vom professionellen Datentarif fern, der mehrere hundert Dollar im Monat kostet. Wählen Sie Professional nur, wenn die Börsenregeln Sie tatsächlich in diese Kategorie einordnen, etwa wenn Sie im Auftrag einer Firma handeln oder bei einer Aufsichtsbehörde registriert sind." },
        { title: "Kästchen anhaken und Namen unterschreiben", html: "Als Nächstes haken Sie ein paar Zustimmungskästchen an und geben Ihren Namen in ein Signaturfeld ein. Geben Sie ihn <strong class='text-white'>exakt</strong> so ein, wie er direkt über dem Feld steht – gleiche Groß- und Kleinschreibung, gleiche Abstände und gegebenenfalls Akzente. Eine winzige Abweichung ist der häufigste Grund, warum das Formular sich nicht absenden lässt. Sobald es übereinstimmt, wird die Schaltfläche <strong class='text-white'>Sign</strong> (oder Next) aktiv. Klicken Sie darauf." },
        { title: "Lizenz akzeptieren und Evaluation bestätigen", html: "Direkt nach der Datenvereinbarung zeigt Tradovate seine Endbenutzer-Lizenzvereinbarung an. Scrollen Sie nach unten und akzeptieren Sie sie. Anschließend wählen Sie Ihren Handelsmodus: <strong class='text-white'>Evaluation</strong> (ältere Versionen nannten dies Simulation). Wichtig: Sobald Sie im Evaluationsmodus sind, zählt jeder Trade für Ihre Evaluation. Schicken Sie also keine Übungsorders hinein, nur um die Verbindung zu „testen“." },
        { title: "Auf die Aktivierung warten und Symbolfarben prüfen", html: "Live-Daten werden nicht in dem Moment aktiv, in dem Sie unterzeichnen. Je nach Auslastung kann es <strong class='text-white'>10 bis 90 Minuten</strong> dauern. Die schnellste Statusprüfung ist die Farbe des Instrumentennamens in Ihrem Chart oder DOM: <strong class='text-white'>Weiß bedeutet, dass Live-Daten fließen</strong>, und <strong class='text-white'>Orange bedeutet, dass sie noch verzögert sind</strong> oder die Vereinbarung noch nicht verarbeitet wurde. Nach 90 Minuten immer noch Orange? Melden Sie sich ab und wieder an, bevor Sie etwas anderes tun – eine neue Sitzung übernimmt die Berechtigung oft." },
      ],
    },
    { type: "heading",text: "Immer noch orange Daten?" },
    { type: "paragraph",html: "Bei einem Prop-Evaluationskonto gehört das Tradovate-Konto der Firma, und sie kontrolliert die Datenberechtigung. Wenn Sie alles unterzeichnet, länger als 90 Minuten gewartet und sich neu angemeldet haben, die Symbole aber weiterhin orange sind, liegt die Lösung meist auf Seiten der Firma: Sie muss die Marktdatenberechtigung für Ihr Konto möglicherweise aktivieren oder erneut übermitteln. Welches Datenpaket Ihre Evaluation enthält, wie lange die Bereitstellung dauert und die genauen Regeln unterscheiden sich je nach Firma und Kontogröße. Prüfen Sie daher die aktuelle Einrichtungsanleitung Ihrer Firma, bevor Sie ein Support-Ticket eröffnen." },
    { type: "heading",text: "Automatisieren Sie Ihre Evaluation mit PickMyTrade" },
    { type: "paragraph",html: "Sobald Ihre Daten live sind und Ihr Konto freigegeben ist, <strong class='text-white'>leitet PickMyTrade Ihre TradingView-Alerts direkt an Tradovate weiter</strong>, sodass Ihre Strategie genau dann auslöst, wenn Ihr Chart ein Signal gibt – ganz ohne manuelles Klicken während Ihrer Evaluation." },
  ], es: [
    { type: "paragraph",html: "Superó el pago, su prop firm le envió el acceso por correo y abrió Tradovate, pero los precios están congelados o con diez minutos de retraso. Nueve de cada diez veces, un solo formulario es el culpable. Antes de que una cuenta de evaluación transmita cotizaciones de futuros en vivo, debe firmar una sola vez el acuerdo de datos de mercado de Tradovate dentro de la aplicación web y marcarse como No profesional. Hágalo, espere un poco y sus símbolos pasarán de naranja a blanco. Aquí tiene todo el proceso, de principio a fin." },
    { type: "heading",text: "Por qué existe el acuerdo de datos" },
    { type: "paragraph",html: "Tradovate ofrece datos de CME Group, y el mercado no libera cotizaciones en tiempo real hasta que cada titular de cuenta certifica quién es. En una evaluación prop, la firma crea su acceso y normalmente incluye datos de nivel 1 de CME con la cuenta, pero la certificación es personal. Nadie en la firma puede firmarla por usted. Si la omite, se queda con datos con retraso, por lo que tantos momentos de \"mis gráficos no funcionan\" se deben a esta única pantalla." },
    { type: "heading",text: "Cómo firmar el acuerdo: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Inicie sesión en la aplicación web de Tradovate", html: "Haga esta parte en la plataforma del navegador, no en la aplicación de escritorio, ni en el móvil ni a través de TradingView. Las pantallas del acuerdo solo aparecen en la aplicación web, y solo se firman una vez. Introduzca las credenciales de evaluación que le envió su firma (el nombre de usuario suele empezar con un prefijo de la firma) e inicie sesión. Si aterriza en una página de \"financiar su cuenta\", está en el acceso equivocado: vuelva atrás y use las credenciales de evaluación." },
        { title: "Lea la certificación y elija No profesional", html: "La primera pantalla es la certificación de suscriptor de datos de mercado. Desplácese hasta el paso de clasificación y seleccione <strong class='text-white'>Non-Professional</strong>. Es la opción correcta para un trader minorista financiado por una prop firm y le mantiene fuera de la tarifa de datos profesional, que ronda varios cientos de dólares al mes. Elija Profesional solo si las reglas del mercado realmente le sitúan en esa categoría: operar en nombre de una firma, estar registrado ante un regulador y similares." },
        { title: "Marque las casillas y firme con su nombre", html: "A continuación marcará un par de casillas del acuerdo y escribirá su nombre en un campo de firma. Escríbalo <strong class='text-white'>exactamente</strong> como aparece impreso justo encima del campo: mismas mayúsculas, espacios y acentos. Una diferencia mínima es la causa número uno de que el formulario no se envíe. Cuando coincida, el botón <strong class='text-white'>Sign</strong> (o Next) se activa. Haga clic en él." },
        { title: "Acepte la licencia y confirme Evaluación", html: "Justo después del acuerdo de datos, Tradovate muestra su Acuerdo de licencia de usuario final. Desplácese hasta el final y acéptelo. Después elegirá su modo de trading: seleccione <strong class='text-white'>Evaluation</strong> (las versiones antiguas lo llamaban Simulation). Atención: una vez en modo Evaluación, cada operación cuenta para su evaluación, así que no lance órdenes de prueba solo para \"comprobar\" la conexión." },
        { title: "Espere la activación y revise los colores de los símbolos", html: "Los datos en vivo no se activan en el instante en que firma. Según la demanda, pueden tardar entre <strong class='text-white'>10 y 90 minutos</strong>. La forma más rápida de comprobar el estado es el color del nombre del instrumento en su gráfico o DOM: <strong class='text-white'>blanco significa que los datos en vivo fluyen</strong>, y <strong class='text-white'>naranja significa que siguen con retraso</strong> o que el acuerdo aún no se ha procesado. ¿Sigue naranja pasados 90 minutos? Cierre sesión y vuelva a entrar antes de hacer nada más: una sesión nueva suele traer la autorización." },
      ],
    },
    { type: "heading",text: "¿Sigue atascado en datos naranjas?" },
    { type: "paragraph",html: "En una cuenta de evaluación prop, la firma es la propietaria de la cuenta de Tradovate y controla la autorización de datos. Si ha firmado todo, ha esperado más de 90 minutos y ha vuelto a iniciar sesión, pero los símbolos siguen naranjas, la solución suele estar del lado de la firma: puede que deban habilitar o volver a enviar la autorización de datos de mercado para su cuenta. Qué paquete de datos incluye su evaluación, cuánto tarda el aprovisionamiento y las reglas exactas varían según la firma y el tamaño de la cuenta, así que consulte la guía de configuración vigente de su firma antes de abrir un ticket de soporte." },
    { type: "heading",text: "Automatice su evaluación con PickMyTrade" },
    { type: "paragraph",html: "Una vez que sus datos estén activos y su cuenta aprobada, <strong class='text-white'>PickMyTrade envía sus alertas de TradingView directamente a Tradovate</strong>, de modo que su estrategia se ejecuta en el momento en que su gráfico da la señal, sin clics manuales durante su evaluación." },
  ], fr: [
    { type: "paragraph",html: "Vous avez réussi le paiement, votre prop firm vous a envoyé vos identifiants par e-mail et vous avez lancé Tradovate, mais les prix sont figés ou en retard de dix minutes. Neuf fois sur dix, un seul formulaire est en cause. Avant qu'un compte d'évaluation ne diffuse des cotations de futures en direct, vous devez signer une fois l'accord de données de marché de Tradovate dans l'application web et vous déclarer Non-Professional. Faites-le, patientez un peu, et vos symboles passent de l'orange au blanc. Voici toute la procédure, du début à la fin." },
    { type: "heading",text: "Pourquoi l'accord de données existe" },
    { type: "paragraph",html: "Tradovate diffuse les données du CME Group, et la bourse ne libère pas de cotations en temps réel tant que chaque titulaire de compte n'a pas certifié qui il est. Lors d'une évaluation prop, la société crée vos identifiants et inclut généralement les données CME de niveau 1 avec le compte, mais la certification est personnelle. Personne dans la société ne peut la signer à votre place. Si vous l'ignorez, vous restez sur des données différées, ce qui explique pourquoi tant de « mes graphiques sont cassés » viennent de cet unique écran." },
    { type: "heading",text: "Signer l'accord : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Connectez-vous via l'application web Tradovate", html: "Effectuez cette partie dans la plateforme du navigateur, pas dans l'application de bureau, ni sur mobile, ni via TradingView. Les écrans de l'accord n'apparaissent que dans l'application web, et vous ne les signez qu'une fois. Saisissez les identifiants d'évaluation que votre société vous a envoyés (le nom d'utilisateur commence souvent par un préfixe de société) et connectez-vous. Si vous arrivez sur une page « alimentez votre compte », vous utilisez le mauvais identifiant : revenez en arrière et utilisez les identifiants d'évaluation." },
        { title: "Lisez la certification et choisissez Non-Professional", html: "Le premier écran est la certification d'abonné aux données de marché. Faites-le défiler jusqu'à l'étape de classification et sélectionnez <strong class='text-white'>Non-Professional</strong>. C'est le bon choix pour un trader particulier financé par une prop firm, et cela vous évite le tarif de données professionnel, qui s'élève à plusieurs centaines de dollars par mois. Ne choisissez Professional que si les règles de la bourse vous placent réellement dans cette catégorie : trader pour le compte d'une société, être enregistré auprès d'un régulateur, ce genre de situation." },
        { title: "Cochez les cases et signez de votre nom", html: "Vous cocherez ensuite quelques cases d'accord et saisirez votre nom dans un champ de signature. Saisissez-le <strong class='text-white'>exactement</strong> comme il est imprimé juste au-dessus du champ : mêmes majuscules, mêmes espaces et mêmes accents. Une infime différence est la cause numéro un de l'échec de l'envoi du formulaire. Dès qu'il correspond, le bouton <strong class='text-white'>Sign</strong> (ou Next) devient actif. Cliquez dessus." },
        { title: "Acceptez la licence et confirmez Evaluation", html: "Juste après l'accord de données, Tradovate affiche son contrat de licence utilisateur final. Faites défiler jusqu'en bas et acceptez-le. Vous choisirez ensuite votre mode de trading : sélectionnez <strong class='text-white'>Evaluation</strong> (les anciennes versions l'appelaient Simulation). Attention : une fois en mode Évaluation, chaque trade compte pour votre évaluation ; n'y envoyez donc pas d'ordres d'entraînement uniquement pour « tester » la connexion." },
        { title: "Attendez l'activation et vérifiez la couleur des symboles", html: "Les données en direct ne s'activent pas à l'instant où vous signez. Selon la demande, cela peut prendre de <strong class='text-white'>10 à 90 minutes</strong>. Le contrôle le plus rapide consiste à regarder la couleur du nom de l'instrument sur votre graphique ou votre DOM : <strong class='text-white'>le blanc signifie que les données en direct arrivent</strong>, et <strong class='text-white'>l'orange signifie qu'elles sont encore différées</strong> ou que l'accord n'a pas encore été pris en compte. Toujours orange après 90 minutes ? Déconnectez-vous puis reconnectez-vous avant toute autre chose : une nouvelle session fait souvent remonter l'autorisation." },
      ],
    },
    { type: "heading",text: "Toujours bloqué sur des données orange ?" },
    { type: "paragraph",html: "Sur un compte d'évaluation prop, la société possède le compte Tradovate et contrôle l'autorisation de données. Si vous avez tout signé, attendu plus de 90 minutes et vous êtes reconnecté, mais que les symboles restent orange, la solution se trouve généralement du côté de la société : elle peut devoir activer ou renvoyer l'autorisation de données de marché pour votre compte. Le forfait de données fourni avec votre évaluation, la durée du provisionnement et les règles exactes varient selon la société et la taille du compte ; consultez donc le guide de configuration actuel de votre société avant d'ouvrir un ticket de support." },
    { type: "heading",text: "Automatisez votre évaluation avec PickMyTrade" },
    { type: "paragraph",html: "Une fois vos données actives et votre compte validé, <strong class='text-white'>PickMyTrade achemine vos alertes TradingView directement vers Tradovate</strong>, afin que votre stratégie se déclenche dès que votre graphique émet un signal, sans clic manuel pendant votre évaluation." },
  ], it: [
    { type: "paragraph",html: "Ha superato il checkout, la sua prop firm le ha inviato le credenziali via e-mail e ha avviato Tradovate, ma i prezzi sono bloccati o in ritardo di dieci minuti. Nove volte su dieci, il colpevole è un unico modulo. Prima che un conto di valutazione trasmetta quotazioni di futures in tempo reale, deve firmare una sola volta l'accordo sui dati di mercato di Tradovate nell'app web e dichiararsi Non-Professional. Lo faccia, attenda un po', e i suoi simboli passeranno da arancione a bianco. Ecco tutta la procedura, dall'inizio alla fine." },
    { type: "heading",text: "Perché esiste l'accordo sui dati" },
    { type: "paragraph",html: "Tradovate distribuisce i dati di CME Group e la borsa non rilascia quotazioni in tempo reale finché ogni titolare di conto non certifica chi è. In una valutazione prop, la società crea le sue credenziali e di solito include i dati CME di livello 1 con il conto, ma la certificazione è personale. Nessuno della società può firmarla al suo posto. Se la salta, resta sui dati ritardati, ed è per questo che tanti momenti di \"i miei grafici non funzionano\" risalgono a questa singola schermata." },
    { type: "heading",text: "Come firmare l'accordo: passo dopo passo" },
    {
      type: "steps",
      items: [
        { title: "Acceda tramite l'app web di Tradovate", html: "Svolga questa parte nella piattaforma del browser, non nell'app desktop, non da mobile e non tramite TradingView. Le schermate dell'accordo compaiono solo nell'app web e si firmano una volta sola. Inserisca le credenziali di valutazione che la società le ha inviato (il nome utente spesso inizia con un prefisso della società) e acceda. Se finisce su una pagina \"finanzi il tuo conto\", sta usando l'accesso sbagliato: torni indietro e usi le credenziali di valutazione." },
        { title: "Legga la certificazione e scelga Non-Professional", html: "La prima schermata è la certificazione dell'abbonato ai dati di mercato. La scorra fino al passaggio della classificazione e selezioni <strong class='text-white'>Non-Professional</strong>. È la scelta giusta per un trader retail finanziato da una prop firm e la tiene fuori dalla tariffa dei dati professionali, che costa diverse centinaia di dollari al mese. Scelga Professional solo se le regole della borsa la collocano davvero in quella categoria: operare per conto di una società, essere registrato presso un'autorità di vigilanza e simili." },
        { title: "Spunti le caselle e firmi con il suo nome", html: "Poi dovrà spuntare un paio di caselle dell'accordo e digitare il suo nome in un campo firma. Lo digiti <strong class='text-white'>esattamente</strong> come è stampato appena sopra il campo: stesse maiuscole, spazi ed eventuali accenti. Una minima discrepanza è la causa numero uno del mancato invio del modulo. Quando coincide, il pulsante <strong class='text-white'>Sign</strong> (o Next) si attiva. Lo clicchi." },
        { title: "Accetti la licenza e confermi Evaluation", html: "Subito dopo l'accordo sui dati, Tradovate mostra il suo contratto di licenza per l'utente finale. Scorra fino in fondo e lo accetti. Poi sceglierà la modalità di trading: selezioni <strong class='text-white'>Evaluation</strong> (le versioni più vecchie la chiamavano Simulation). Attenzione: una volta in modalità Valutazione, ogni trade conta per la sua valutazione, quindi non vi invii ordini di prova solo per \"testare\" la connessione." },
        { title: "Attenda l'attivazione e controlli i colori dei simboli", html: "I dati in tempo reale non si attivano nell'istante in cui firma. A seconda della domanda, possono occorrere da <strong class='text-white'>10 a 90 minuti</strong>. Il controllo più rapido è il colore del nome dello strumento sul grafico o sul DOM: <strong class='text-white'>il bianco significa che i dati in tempo reale arrivano</strong>, mentre <strong class='text-white'>l'arancione significa che sono ancora ritardati</strong> o che l'accordo non è ancora stato elaborato. Ancora arancione dopo 90 minuti? Esca e riaccede prima di fare qualsiasi altra cosa: una nuova sessione spesso porta con sé l'autorizzazione." },
      ],
    },
    { type: "heading",text: "Ancora bloccato sui dati arancioni?" },
    { type: "paragraph",html: "In un conto di valutazione prop, la società possiede il conto Tradovate e controlla l'autorizzazione ai dati. Se ha firmato tutto, atteso oltre 90 minuti e riaccesso, ma i simboli restano arancioni, la soluzione di solito è lato società: potrebbe dover abilitare o reinviare l'autorizzazione ai dati di mercato per il suo conto. Quale pacchetto di dati è incluso nella valutazione, quanto dura il provisioning e le regole esatte variano in base alla società e alla dimensione del conto, quindi consulti la guida di configurazione attuale della sua società prima di aprire un ticket di supporto." },
    { type: "heading",text: "Automatizzi la valutazione con PickMyTrade" },
    { type: "paragraph",html: "Una volta attivi i dati e approvato il conto, <strong class='text-white'>PickMyTrade instrada i suoi alert di TradingView direttamente a Tradovate</strong>, così la sua strategia scatta nel momento in cui il grafico dà il segnale, senza clic manuali durante la valutazione." },
  ] },
  ctaHeading: { en: "Automate Your Prop Evaluation", de: "Automatisieren Sie Ihre Prop-Evaluation", es: "Automatice su evaluación prop", fr: "Automatisez votre évaluation prop", it: "Automatizzi la sua valutazione prop" },
  ctaText: { en: "Once your data's live, let PickMyTrade route your TradingView alerts straight to Tradovate, so your strategy fires the moment your chart signals, no manual clicking during your eval.", de: "Sobald Ihre Daten live sind, lassen Sie PickMyTrade Ihre TradingView-Alerts direkt an Tradovate weiterleiten, sodass Ihre Strategie genau dann auslöst, wenn Ihr Chart ein Signal gibt – ganz ohne manuelles Klicken während Ihrer Evaluation.", es: "Una vez que sus datos estén activos, deje que PickMyTrade envíe sus alertas de TradingView directamente a Tradovate, de modo que su estrategia se ejecute en el momento en que su gráfico dé la señal, sin clics manuales durante su evaluación.", fr: "Une fois vos données actives, laissez PickMyTrade acheminer vos alertes TradingView directement vers Tradovate, afin que votre stratégie se déclenche dès que votre graphique émet un signal, sans clic manuel pendant votre évaluation.", it: "Una volta attivi i dati, lasci che PickMyTrade instradi i suoi alert di TradingView direttamente a Tradovate, così la sua strategia scatta nel momento in cui il grafico dà il segnale, senza clic manuali durante la valutazione." },
  ctaButtonText: { en: "Start Your Free 7-Day Trial", de: "Starten Sie Ihre kostenlose 7-Tage-Testphase", es: "Comience su prueba gratuita de 7 días", fr: "Commencez votre essai gratuit de 7 jours", it: "Inizi la prova gratuita di 7 giorni" },
  ctaUrl: "https://app.pickmytrade.trade/?register=true&utm_source=content&utm_medium=how-to",
  faqHeading: { en: "Frequently Asked Questions", de: "Häufig gestellte Fragen", es: "Preguntas frecuentes", fr: "Questions fréquentes", it: "Domande frequenti" },
  faqs: { en: [
    { q: "Do I have to sign the data agreement on a prop account?", a: "Yes. Even though the prop firm sets up the account, the market data certification is tied to you as the account holder and can only be signed once, in the Tradovate web app. Without it you're limited to delayed data." },
    { q: "How long until my data goes live?", a: "Usually somewhere between 10 and 90 minutes after you sign, depending on how busy Tradovate's provisioning is. Wait the full 90 minutes and try a fresh login before assuming something's wrong." },
    { q: "Should I pick Professional or Non-Professional?", a: "Almost every retail prop trader is Non-Professional, which also avoids a steep monthly professional data fee. Only select Professional if exchange rules classify you that way. If you're unsure, check with your firm." },
  ], de: [
    { q: "Muss ich die Datenvereinbarung bei einem Prop-Konto unterzeichnen?", a: "Ja. Auch wenn die Prop-Firma das Konto einrichtet, ist die Marktdaten-Zertifizierung an Sie als Kontoinhaber gebunden und kann nur einmal in der Tradovate-Web-App unterzeichnet werden. Ohne sie sind Sie auf verzögerte Daten beschränkt." },
    { q: "Wie lange dauert es, bis meine Daten live sind?", a: "In der Regel zwischen 10 und 90 Minuten nach der Unterzeichnung, je nachdem, wie ausgelastet die Bereitstellung bei Tradovate ist. Warten Sie die vollen 90 Minuten ab und versuchen Sie eine neue Anmeldung, bevor Sie annehmen, dass etwas nicht stimmt." },
    { q: "Sollte ich Professional oder Non-Professional wählen?", a: "Fast jeder private Prop-Trader ist Non-Professional, was zudem eine hohe monatliche Gebühr für professionelle Daten vermeidet. Wählen Sie Professional nur, wenn die Börsenregeln Sie so einstufen. Wenn Sie unsicher sind, fragen Sie Ihre Firma." },
  ], es: [
    { q: "¿Tengo que firmar el acuerdo de datos en una cuenta prop?", a: "Sí. Aunque la prop firm configure la cuenta, la certificación de datos de mercado está vinculada a usted como titular de la cuenta y solo se puede firmar una vez, en la aplicación web de Tradovate. Sin ella, estará limitado a datos con retraso." },
    { q: "¿Cuánto tarda en activarse mi flujo de datos?", a: "Normalmente entre 10 y 90 minutos después de firmar, según lo ocupado que esté el aprovisionamiento de Tradovate. Espere los 90 minutos completos e intente un nuevo inicio de sesión antes de suponer que algo va mal." },
    { q: "¿Debo elegir Profesional o No profesional?", a: "Casi todos los traders prop minoristas son No profesionales, lo que además evita una elevada tarifa mensual de datos profesionales. Seleccione Profesional solo si las reglas del mercado le clasifican así. Si no está seguro, consulte con su firma." },
  ], fr: [
    { q: "Dois-je signer l'accord de données sur un compte prop ?", a: "Oui. Même si la prop firm configure le compte, la certification des données de marché est liée à vous en tant que titulaire du compte et ne peut être signée qu'une seule fois, dans l'application web de Tradovate. Sans elle, vous êtes limité aux données différées." },
    { q: "Combien de temps avant que mes données soient actives ?", a: "Généralement entre 10 et 90 minutes après la signature, selon la charge du provisionnement chez Tradovate. Attendez les 90 minutes complètes et essayez une nouvelle connexion avant de supposer qu'un problème existe." },
    { q: "Dois-je choisir Professional ou Non-Professional ?", a: "Presque tous les traders prop particuliers sont Non-Professional, ce qui évite aussi des frais mensuels élevés pour les données professionnelles. Ne sélectionnez Professional que si les règles de la bourse vous classent ainsi. En cas de doute, renseignez-vous auprès de votre société." },
  ], it: [
    { q: "Devo firmare l'accordo sui dati su un conto prop?", a: "Sì. Anche se è la prop firm a configurare il conto, la certificazione dei dati di mercato è legata a lei come titolare del conto e può essere firmata una sola volta, nell'app web di Tradovate. Senza di essa è limitato ai dati ritardati." },
    { q: "Quanto ci vuole prima che i miei dati diventino attivi?", a: "Di solito tra 10 e 90 minuti dopo la firma, a seconda di quanto è carico il provisioning di Tradovate. Attenda l'intero intervallo di 90 minuti e provi un nuovo accesso prima di ritenere che ci sia un problema." },
    { q: "Devo scegliere Professional o Non-Professional?", a: "Quasi tutti i trader prop retail sono Non-Professional, il che evita anche una elevata tariffa mensile per i dati professionali. Selezioni Professional solo se le regole della borsa la classificano in questo modo. Se ha dubbi, chieda alla sua società." },
  ] },
  relatedHeading: { en: "Related Guides", de: "Verwandte Anleitungen", es: "Guías relacionadas", fr: "Guides associés", it: "Guide correlate" },
  disclosureText: { en: `This guide is for educational and informational purposes only and is not financial, investment, or trading advice. Trading futures and other leveraged products carries a substantial risk of loss and is not suitable for every investor. PickMyTrade is an independent third-party automation platform and is not affiliated with, endorsed by, or sponsored by Tradovate, Inc. "Tradovate" and all related names, logos, and trademarks are the property of their respective owners. Platform features and steps change over time, so always confirm the current process in the official Tradovate platform and documentation before acting.`, de: "Dieser Leitfaden dient ausschließlich Bildungs- und Informationszwecken und stellt weder Finanz-, Anlage- noch Handelsberatung dar. Der Handel mit Futures und anderen gehebelten Produkten birgt ein erhebliches Verlustrisiko und ist nicht für jeden Anleger geeignet. PickMyTrade ist eine unabhängige Drittanbieter-Automatisierungsplattform und steht in keiner Verbindung zu Tradovate, Inc., wird von dieser weder unterstützt noch gesponsert. \"Tradovate\" sowie alle zugehörigen Namen, Logos und Marken sind Eigentum ihrer jeweiligen Inhaber. Plattformfunktionen und Schritte ändern sich im Laufe der Zeit. Prüfen Sie daher stets den aktuellen Ablauf in der offiziellen Tradovate-Plattform und -Dokumentation, bevor Sie handeln.", es: "Esta guía tiene fines exclusivamente educativos e informativos y no constituye asesoramiento financiero, de inversión ni de trading. Operar con futuros y otros productos apalancados conlleva un riesgo sustancial de pérdida y no es adecuado para todos los inversores. PickMyTrade es una plataforma de automatización independiente de terceros y no está afiliada, respaldada ni patrocinada por Tradovate, Inc. \"Tradovate\" y todos los nombres, logotipos y marcas relacionados son propiedad de sus respectivos titulares. Las funciones de la plataforma y los pasos cambian con el tiempo, por lo que siempre debe confirmar el proceso vigente en la plataforma y la documentación oficiales de Tradovate antes de actuar.", fr: "Ce guide est fourni à des fins exclusivement éducatives et informatives et ne constitue pas un conseil financier, d'investissement ou de trading. Le trading de contrats à terme et d'autres produits à effet de levier comporte un risque de perte important et ne convient pas à tous les investisseurs. PickMyTrade est une plateforme d'automatisation tierce indépendante et n'est ni affiliée à Tradovate, Inc., ni approuvée ou parrainée par cette dernière. « Tradovate » ainsi que tous les noms, logos et marques associés sont la propriété de leurs détenteurs respectifs. Les fonctionnalités de la plateforme et les étapes évoluent avec le temps ; vérifiez donc toujours la procédure en vigueur dans la plateforme et la documentation officielles de Tradovate avant d'agir.", it: "Questa guida ha esclusivamente scopo educativo e informativo e non costituisce consulenza finanziaria, di investimento o di trading. Il trading di futures e di altri prodotti a leva comporta un rischio sostanziale di perdita e non è adatto a tutti gli investitori. PickMyTrade è una piattaforma di automazione indipendente di terze parti e non è affiliata, approvata né sponsorizzata da Tradovate, Inc. \"Tradovate\" e tutti i nomi, loghi e marchi correlati sono di proprietà dei rispettivi titolari. Le funzionalità della piattaforma e i passaggi cambiano nel tempo, quindi confermi sempre la procedura attuale nella piattaforma e nella documentazione ufficiali di Tradovate prima di agire." },
