---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-chart-intervals";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Change Chart Timeframe & Interval in Tradovate";
const META_DESCRIPTION =
  "Switch your futures chart timeframe and build custom minute, tick, volume, range, or second interval bars from the Interval dropdown.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Chart-Zeitrahmen und Intervall in Tradovate ändern", es: "Cambiar el marco temporal y el intervalo del gráfico en Tradovate", fr: "Modifier l'unité de temps et l'intervalle du graphique dans Tradovate", it: "Cambiare timeframe e intervallo del grafico in Tradovate" },
  dek: { en: "Your timeframe decides what the market actually looks like to you. Here's exactly where to click and how to set up the interval you actually trade on, minute presets, custom minutes, tick, volume, range, and second bars.", de: "Ihr Zeitrahmen entscheidet, wie der Markt für Sie tatsächlich aussieht. Hier erfahren Sie genau, wo Sie klicken müssen und wie Sie das Intervall einrichten, in dem Sie wirklich handeln: Minuten-Voreinstellungen, benutzerdefinierte Minuten sowie Tick-, Volumen-, Range- und Sekundenbalken.", es: "Su marco temporal decide cómo ve realmente el mercado. Aquí le explicamos exactamente dónde hacer clic y cómo configurar el intervalo en el que usted opera: preajustes de minutos, minutos personalizados y barras de ticks, volumen, rango y segundos.", fr: "Votre unité de temps détermine à quoi ressemble réellement le marché pour vous. Voici exactement où cliquer et comment configurer l'intervalle sur lequel vous tradez : préréglages en minutes, minutes personnalisées, barres de ticks, de volume, de range et de secondes.", it: "Il Suo timeframe decide come Lei vede realmente il mercato. Ecco esattamente dove cliccare e come impostare l'intervallo su cui opera: preset in minuti, minuti personalizzati e barre a tick, volume, range e secondi." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "Your timeframe decides what the market actually looks like to you. A 1-minute chart is all noise and quick scalps; a 60-minute chart smooths that out and shows the bigger swing. Tradovate lets you flip between them in a couple of clicks, and it goes well past the usual minute presets, you can build tick, volume, range, and second-based bars too. Here's exactly where to click and how to set up the interval you actually trade on." },
    { type: "heading", text: "Where the Interval Control Lives" },
    { type: "paragraph", html: "Every chart in Tradovate carries a small toolbar that only shows up when your cursor is over the chart. Hover over the Chart module and a row of icons appears along the top. The interval control sits near the left of that row, it usually displays your current setting (something like <strong class='text-white'>5m</strong> or <strong class='text-white'>1H</strong>), so you can read your active timeframe at a glance before you change anything." },
    { type: "paragraph", html: "One thing worth getting straight up front: the interval button and the <em>chart style</em> button are two different things. Interval controls the <em>time or size</em> of each bar. Chart style controls how each bar is <em>drawn</em>, candles, bars, line, and so on. This guide is about the interval." },
    { type: "heading", text: "How to Change Your Chart Timeframe" },
    {
      type: "steps",
      items: [
        { title: "Open a Chart and Reveal the Toolbar", html: "Open the Chart module for the contract you're watching, then move your mouse over the chart area. The toolbar fades in across the top. If you don't see it, your cursor probably drifted off the chart, hover back over the price panel and it returns." },
        { title: "Open the Interval Dropdown", html: "Click the interval control near the top-left of the toolbar, the one showing your current interval. That opens the Interval dropdown, which is where every timeframe option lives: the minute presets, the custom builders, and any recent intervals you've used." },
        { title: "Pick a Preset Minute Interval", html: "For most traders the presets are enough. Tradovate gives you 1, 5, 15, 30, and 60-minute bars right in the dropdown. Click one and the chart redraws immediately, no save button, no confirmation. Scalpers usually park on 1 or 5 minutes; if you're swing-reading intraday structure, 15 or 60 gives you cleaner bars." },
        { title: "Build a Custom Minute Interval", html: "Need something the presets skip, a 2-minute, a 3-minute, a 4-hour? Choose the <strong class='text-white'>Custom Time</strong> option and type the minute value you want. A 240-minute chart, for example, gives you a 4-hour bar. Once you've used a custom timeframe, it gets saved to the bottom of the Interval dropdown under your recent timeframes, so you can jump back to it without retyping." },
        { title: "Switch to Tick, Volume, Range, or Second Bars", html: "Time isn't the only way to build a bar. Pick one of the non-minute interval types, <strong class='text-white'>Tick</strong>, <strong class='text-white'>Volume</strong>, <strong class='text-white'>Range</strong>, or <strong class='text-white'>Second</strong>, and a small pop-up asks how much each bar should represent. Enter a number and confirm. A 500-tick bar closes every 500 trades; a range bar closes after price moves a set number of ticks; a volume bar closes after a set number of contracts change hands. These strip the clock out of the picture and let activity, not time, drive when a new bar prints." },
      ],
    },
    { type: "heading", text: "Interval Types at a Glance" },
    {
      type: "table",
      headers: ["Interval type", "What closes a bar", "Good for"],
      rows: [
        ["Minute (presets)", "A fixed number of minutes (1, 5, 15, 30, 60)", "Everyday intraday trading"],
        ["Custom Time", "Any minute value you type (e.g. 2, 3, 240)", "Timeframes the presets skip"],
        ["Tick", "A set number of trades", "Reading fast order flow"],
        ["Volume", "A set number of contracts traded", "Activity-based bars"],
        ["Range", "A set price move in ticks", "Filtering out chop"],
        ["Second", "A set number of seconds", "Sub-minute scalping"],
      ],
    },
    { type: "heading", text: "A Few Things Worth Knowing" },
    { type: "paragraph", html: "The interval you set applies to that one chart. If you want to watch the same contract on two timeframes at once, say a 5-minute for entries and a 60-minute for context, open a second Chart module and set each one separately. They don't fight each other." },
    { type: "paragraph", html: "How far back the history loads on very low timeframes depends on your market-data setup, which varies by account and firm, check your firm's current rules if bars aren't loading as far back as you expect. And remember, changing the interval never changes the contract or the data feed; it only changes how the existing data is bundled into bars." },
    { type: "quote", html: "New to Tradovate charts? Start with the Tradovate charting basics guide to open and lay out the Chart module, then come back here to dial in your timeframe." },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Once your charts are set the way you like, the next step is getting trades in without babysitting the screen. <strong class='text-white'>PickMyTrade automates your Tradovate orders straight from TradingView alerts</strong>, set your strategy, and let the alerts fire the trades for you." },
  ], de: [
    { type: "paragraph",html: "Ihr Zeitrahmen entscheidet, wie der Markt für Sie tatsächlich aussieht. Ein 1-Minuten-Chart ist nur Rauschen und schnelle Scalps; ein 60-Minuten-Chart glättet das und zeigt den größeren Swing. Tradovate lässt Sie mit wenigen Klicks zwischen ihnen wechseln und geht weit über die üblichen Minuten-Voreinstellungen hinaus: Sie können auch Tick-, Volumen-, Range- und sekundenbasierte Balken erstellen. Hier erfahren Sie genau, wo Sie klicken müssen und wie Sie das Intervall einrichten, in dem Sie wirklich handeln." },
    { type: "heading",text: "Wo sich die Intervall-Steuerung befindet" },
    { type: "paragraph",html: "Jeder Chart in Tradovate hat eine kleine Symbolleiste, die nur erscheint, wenn sich Ihr Cursor über dem Chart befindet. Fahren Sie mit der Maus über das Chart-Modul, und am oberen Rand erscheint eine Reihe von Symbolen. Die Intervall-Steuerung befindet sich links in dieser Reihe und zeigt in der Regel Ihre aktuelle Einstellung an (etwa <strong class='text-white'>5m</strong> oder <strong class='text-white'>1H</strong>), sodass Sie Ihren aktiven Zeitrahmen auf einen Blick erkennen, bevor Sie etwas ändern." },
    { type: "paragraph",html: "Eines sollten Sie gleich zu Beginn klarstellen: Die Schaltfläche für das Intervall und die Schaltfläche für den <em>Chart-Stil</em> sind zwei verschiedene Dinge. Das Intervall steuert die <em>Zeit oder Größe</em> jedes Balkens. Der Chart-Stil steuert, wie jeder Balken <em>gezeichnet</em> wird: Kerzen, Balken, Linie und so weiter. In diesem Leitfaden geht es um das Intervall." },
    { type: "heading",text: "So ändern Sie Ihren Chart-Zeitrahmen" },
    {
      type: "steps",
      items: [
        { title: "Chart öffnen und Symbolleiste einblenden", html: "Öffnen Sie das Chart-Modul für den Kontrakt, den Sie beobachten, und bewegen Sie dann die Maus über den Chartbereich. Die Symbolleiste blendet sich am oberen Rand ein. Wenn Sie sie nicht sehen, ist Ihr Cursor wahrscheinlich vom Chart abgewandert; fahren Sie wieder über den Preisbereich, und sie erscheint erneut." },
        { title: "Das Intervall-Dropdown öffnen", html: "Klicken Sie auf die Intervall-Steuerung oben links in der Symbolleiste, also auf die, die Ihr aktuelles Intervall anzeigt. Damit öffnet sich das Intervall-Dropdown, in dem sich alle Zeitrahmen-Optionen befinden: die Minuten-Voreinstellungen, die benutzerdefinierten Builder und alle zuletzt verwendeten Intervalle." },
        { title: "Ein voreingestelltes Minutenintervall wählen", html: "Für die meisten Trader reichen die Voreinstellungen aus. Tradovate bietet Ihnen direkt im Dropdown 1-, 5-, 15-, 30- und 60-Minuten-Balken. Klicken Sie auf eines, und der Chart wird sofort neu gezeichnet, ohne Speichern-Schaltfläche und ohne Bestätigung. Scalper bleiben meist bei 1 oder 5 Minuten; wenn Sie die Intraday-Struktur lesen, liefern 15 oder 60 sauberere Balken." },
        { title: "Ein benutzerdefiniertes Minutenintervall erstellen", html: "Sie brauchen etwas, das die Voreinstellungen auslassen, etwa 2 Minuten, 3 Minuten oder 4 Stunden? Wählen Sie die Option <strong class='text-white'>Custom Time</strong> und geben Sie den gewünschten Minutenwert ein. Ein 240-Minuten-Chart ergibt zum Beispiel einen 4-Stunden-Balken. Sobald Sie einen benutzerdefinierten Zeitrahmen verwendet haben, wird er unten im Intervall-Dropdown unter Ihren zuletzt verwendeten Zeitrahmen gespeichert, sodass Sie ohne erneute Eingabe dorthin zurückspringen können." },
        { title: "Zu Tick-, Volumen-, Range- oder Sekundenbalken wechseln", html: "Zeit ist nicht der einzige Weg, einen Balken zu bilden. Wählen Sie einen der Intervalltypen ohne Minuten, <strong class='text-white'>Tick</strong>, <strong class='text-white'>Volume</strong>, <strong class='text-white'>Range</strong> oder <strong class='text-white'>Second</strong>, und ein kleines Pop-up fragt, was jeder Balken darstellen soll. Geben Sie eine Zahl ein und bestätigen Sie. Ein 500-Tick-Balken schließt alle 500 Trades; ein Range-Balken schließt, nachdem sich der Preis um eine festgelegte Anzahl Ticks bewegt hat; ein Volumenbalken schließt, nachdem eine festgelegte Anzahl Kontrakte den Besitzer gewechselt hat. Diese Balken blenden die Uhr aus und lassen die Aktivität, nicht die Zeit, bestimmen, wann ein neuer Balken entsteht." },
      ],
    },
    { type: "heading",text: "Intervalltypen auf einen Blick" },
    { type: "table", headers: ["Intervalltyp","Was einen Balken schließt","Gut geeignet für"], rows: [
      ["Minuten (Voreinstellungen)","Eine feste Anzahl von Minuten (1, 5, 15, 30, 60)","Alltäglichen Intraday-Handel"],
      ["Custom Time","Jeder eingegebene Minutenwert (z. B. 2, 3, 240)","Zeitrahmen, die die Voreinstellungen auslassen"],
      ["Tick","Eine festgelegte Anzahl von Trades","Das Lesen von schnellem Orderflow"],
      ["Volume","Eine festgelegte Anzahl gehandelter Kontrakte","Aktivitätsbasierte Balken"],
      ["Range","Eine festgelegte Preisbewegung in Ticks","Seitwärtsphasen herausfiltern"],
      ["Second","Eine festgelegte Anzahl von Sekunden","Scalping im Sub-Minuten-Bereich"],
    ] },
    { type: "heading",text: "Einige Dinge, die Sie wissen sollten" },
    { type: "paragraph",html: "Das eingestellte Intervall gilt nur für diesen einen Chart. Wenn Sie denselben Kontrakt gleichzeitig in zwei Zeitrahmen beobachten möchten, etwa 5 Minuten für Einstiege und 60 Minuten für den Kontext, öffnen Sie ein zweites Chart-Modul und stellen Sie jedes separat ein. Sie stören sich nicht gegenseitig." },
    { type: "paragraph",html: "Wie weit die Historie in sehr niedrigen Zeitrahmen zurückreicht, hängt von Ihrer Marktdaten-Konfiguration ab, die je nach Konto und Firma variiert; prüfen Sie die aktuellen Regeln Ihrer Firma, wenn Balken nicht so weit zurück geladen werden, wie Sie erwarten. Und denken Sie daran: Das Ändern des Intervalls ändert niemals den Kontrakt oder den Datenfeed; es ändert nur, wie die vorhandenen Daten zu Balken gebündelt werden." },
    { type: "quote",html: "Neu bei Tradovate-Charts? Beginnen Sie mit dem Leitfaden zu den Tradovate-Charting-Grundlagen, um das Chart-Modul zu öffnen und anzuordnen, und kehren Sie dann hierher zurück, um Ihren Zeitrahmen zu optimieren." },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "Sobald Ihre Charts so eingerichtet sind, wie Sie es möchten, besteht der nächste Schritt darin, Trades zu platzieren, ohne den Bildschirm ständig zu überwachen. <strong class='text-white'>PickMyTrade automatisiert Ihre Tradovate-Orders direkt aus TradingView-Alerts</strong>: Legen Sie Ihre Strategie fest und lassen Sie die Alerts die Trades für Sie auslösen." },
  ], es: [
    { type: "paragraph",html: "Su marco temporal decide cómo ve realmente el mercado. Un gráfico de 1 minuto es puro ruido y scalps rápidos; uno de 60 minutos lo suaviza y muestra el swing más amplio. Tradovate le permite alternar entre ellos con un par de clics y va mucho más allá de los preajustes de minutos habituales: también puede crear barras basadas en ticks, volumen, rango y segundos. Aquí le explicamos exactamente dónde hacer clic y cómo configurar el intervalo en el que usted opera." },
    { type: "heading",text: "Dónde se encuentra el control de intervalo" },
    { type: "paragraph",html: "Cada gráfico de Tradovate incluye una pequeña barra de herramientas que solo aparece cuando el cursor está sobre el gráfico. Pase el cursor sobre el módulo Chart y aparecerá una fila de iconos en la parte superior. El control de intervalo se sitúa cerca de la izquierda de esa fila y normalmente muestra su ajuste actual (algo como <strong class='text-white'>5m</strong> o <strong class='text-white'>1H</strong>), de modo que puede ver su marco temporal activo de un vistazo antes de cambiar nada." },
    { type: "paragraph",html: "Conviene dejar algo claro desde el principio: el botón de intervalo y el botón de <em>estilo de gráfico</em> son dos cosas distintas. El intervalo controla el <em>tiempo o tamaño</em> de cada barra. El estilo de gráfico controla cómo se <em>dibuja</em> cada barra: velas, barras, línea, etc. Esta guía trata del intervalo." },
    { type: "heading",text: "Cómo cambiar el marco temporal de su gráfico" },
    {
      type: "steps",
      items: [
        { title: "Abra un gráfico y muestre la barra de herramientas", html: "Abra el módulo Chart del contrato que está observando y luego mueva el ratón sobre el área del gráfico. La barra de herramientas aparece gradualmente en la parte superior. Si no la ve, es probable que el cursor se haya salido del gráfico; vuelva a pasarlo sobre el panel de precios y reaparecerá." },
        { title: "Abra el menú desplegable de intervalos", html: "Haga clic en el control de intervalo cerca de la parte superior izquierda de la barra de herramientas, el que muestra su intervalo actual. Se abre el menú desplegable de intervalos, donde están todas las opciones de marco temporal: los preajustes de minutos, los constructores personalizados y los intervalos recientes que haya usado." },
        { title: "Elija un intervalo de minutos predefinido", html: "Para la mayoría de los traders, los preajustes son suficientes. Tradovate ofrece barras de 1, 5, 15, 30 y 60 minutos directamente en el menú desplegable. Haga clic en una y el gráfico se redibuja de inmediato, sin botón de guardar ni confirmación. Los scalpers suelen quedarse en 1 o 5 minutos; si usted lee la estructura intradía, 15 o 60 le dan barras más limpias." },
        { title: "Cree un intervalo de minutos personalizado", html: "¿Necesita algo que los preajustes no incluyen, como 2 minutos, 3 minutos o 4 horas? Elija la opción <strong class='text-white'>Custom Time</strong> e introduzca el valor en minutos que desee. Un gráfico de 240 minutos, por ejemplo, le da una barra de 4 horas. Una vez que haya usado un marco temporal personalizado, se guarda al final del menú desplegable de intervalos, entre sus marcos temporales recientes, para que pueda volver a él sin escribirlo de nuevo." },
        { title: "Cambie a barras de ticks, volumen, rango o segundos", html: "El tiempo no es la única forma de construir una barra. Elija uno de los tipos de intervalo que no son de minutos, <strong class='text-white'>Tick</strong>, <strong class='text-white'>Volume</strong>, <strong class='text-white'>Range</strong> o <strong class='text-white'>Second</strong>, y una pequeña ventana emergente le pregunta cuánto debe representar cada barra. Introduzca un número y confirme. Una barra de 500 ticks se cierra cada 500 operaciones; una barra de rango se cierra cuando el precio se mueve un número determinado de ticks; una barra de volumen se cierra cuando cambia de manos un número determinado de contratos. Estas barras eliminan el reloj de la ecuación y dejan que sea la actividad, no el tiempo, la que determine cuándo se imprime una nueva barra." },
      ],
    },
    { type: "heading",text: "Tipos de intervalo de un vistazo" },
    { type: "table", headers: ["Tipo de intervalo","Qué cierra una barra","Ideal para"], rows: [
      ["Minutos (preajustes)","Un número fijo de minutos (1, 5, 15, 30, 60)","Operativa intradía cotidiana"],
      ["Custom Time","Cualquier valor en minutos que introduzca (p. ej., 2, 3, 240)","Marcos temporales que los preajustes no incluyen"],
      ["Tick","Un número determinado de operaciones","Leer el flujo de órdenes rápido"],
      ["Volume","Un número determinado de contratos negociados","Barras basadas en la actividad"],
      ["Range","Un movimiento de precio determinado en ticks","Filtrar el ruido lateral"],
      ["Second","Un número determinado de segundos","Scalping por debajo del minuto"],
    ] },
    { type: "heading",text: "Algunas cosas que conviene saber" },
    { type: "paragraph",html: "El intervalo que configure se aplica solo a ese gráfico. Si desea observar el mismo contrato en dos marcos temporales a la vez, por ejemplo uno de 5 minutos para las entradas y uno de 60 minutos para el contexto, abra un segundo módulo Chart y configure cada uno por separado. No interfieren entre sí." },
    { type: "paragraph",html: "Hasta dónde se carga el historial en marcos temporales muy bajos depende de su configuración de datos de mercado, que varía según la cuenta y la firma; consulte las normas vigentes de su firma si las barras no se cargan tan atrás como esperaba. Y recuerde que cambiar el intervalo nunca cambia el contrato ni el feed de datos; solo cambia la forma en que los datos existentes se agrupan en barras." },
    { type: "quote",html: "¿Es nuevo en los gráficos de Tradovate? Empiece con la guía de conceptos básicos de gráficos de Tradovate para abrir y organizar el módulo Chart, y luego vuelva aquí para ajustar su marco temporal." },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "Una vez que sus gráficos estén configurados a su gusto, el siguiente paso es ejecutar operaciones sin tener que vigilar la pantalla. <strong class='text-white'>PickMyTrade automatiza sus órdenes de Tradovate directamente desde las alertas de TradingView</strong>: defina su estrategia y deje que las alertas disparen las operaciones por usted." },
  ], fr: [
    { type: "paragraph",html: "Votre unité de temps détermine à quoi ressemble réellement le marché pour vous. Un graphique de 1 minute n'est que du bruit et des scalps rapides ; un graphique de 60 minutes lisse tout cela et révèle le swing plus ample. Tradovate vous permet de passer de l'un à l'autre en quelques clics et va bien au-delà des préréglages en minutes habituels : vous pouvez aussi construire des barres de ticks, de volume, de range et de secondes. Voici exactement où cliquer et comment configurer l'intervalle sur lequel vous tradez." },
    { type: "heading",text: "Où se trouve le contrôle de l'intervalle" },
    { type: "paragraph",html: "Chaque graphique Tradovate comporte une petite barre d'outils qui n'apparaît que lorsque votre curseur se trouve sur le graphique. Survolez le module Chart et une rangée d'icônes apparaît en haut. Le contrôle de l'intervalle se situe vers la gauche de cette rangée ; il affiche généralement votre réglage actuel (par exemple <strong class='text-white'>5m</strong> ou <strong class='text-white'>1H</strong>), ce qui vous permet de lire d'un coup d'œil votre unité de temps active avant de modifier quoi que ce soit." },
    { type: "paragraph",html: "Un point à clarifier dès le départ : le bouton d'intervalle et le bouton de <em>style de graphique</em> sont deux choses différentes. L'intervalle contrôle la <em>durée ou la taille</em> de chaque barre. Le style de graphique contrôle la façon dont chaque barre est <em>dessinée</em> : chandeliers, barres, ligne, etc. Ce guide porte sur l'intervalle." },
    { type: "heading",text: "Comment modifier l'unité de temps de votre graphique" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir un graphique et afficher la barre d'outils", html: "Ouvrez le module Chart du contrat que vous suivez, puis déplacez la souris sur la zone du graphique. La barre d'outils apparaît en fondu en haut. Si vous ne la voyez pas, votre curseur a probablement quitté le graphique ; revenez sur le panneau des prix et elle réapparaît." },
        { title: "Ouvrir la liste déroulante des intervalles", html: "Cliquez sur le contrôle de l'intervalle en haut à gauche de la barre d'outils, celui qui affiche votre intervalle actuel. Cela ouvre la liste déroulante des intervalles, où se trouvent toutes les options d'unité de temps : les préréglages en minutes, les générateurs personnalisés et les intervalles récents que vous avez utilisés." },
        { title: "Choisir un intervalle en minutes prédéfini", html: "Pour la plupart des traders, les préréglages suffisent. Tradovate propose directement dans la liste des barres de 1, 5, 15, 30 et 60 minutes. Cliquez sur l'une d'elles et le graphique se redessine immédiatement, sans bouton d'enregistrement ni confirmation. Les scalpeurs restent généralement sur 1 ou 5 minutes ; si vous lisez la structure intrajournalière, 15 ou 60 donnent des barres plus nettes." },
        { title: "Créer un intervalle en minutes personnalisé", html: "Vous avez besoin d'une valeur que les préréglages n'incluent pas, par exemple 2 minutes, 3 minutes ou 4 heures ? Choisissez l'option <strong class='text-white'>Custom Time</strong> et saisissez la valeur en minutes souhaitée. Un graphique de 240 minutes, par exemple, donne une barre de 4 heures. Une fois une unité de temps personnalisée utilisée, elle est enregistrée au bas de la liste des intervalles, parmi vos unités de temps récentes, afin que vous puissiez y revenir sans la ressaisir." },
        { title: "Passer aux barres de ticks, de volume, de range ou de secondes", html: "Le temps n'est pas le seul moyen de construire une barre. Choisissez l'un des types d'intervalle autres que les minutes, <strong class='text-white'>Tick</strong>, <strong class='text-white'>Volume</strong>, <strong class='text-white'>Range</strong> ou <strong class='text-white'>Second</strong>, et une petite fenêtre vous demande ce que chaque barre doit représenter. Saisissez un nombre et confirmez. Une barre de 500 ticks se clôture tous les 500 trades ; une barre de range se clôture lorsque le prix a évolué d'un nombre de ticks défini ; une barre de volume se clôture lorsqu'un nombre défini de contrats a changé de mains. Ces barres retirent l'horloge de l'équation et laissent l'activité, et non le temps, déterminer quand une nouvelle barre se forme." },
      ],
    },
    { type: "heading",text: "Les types d'intervalle en un coup d'œil" },
    { type: "table", headers: ["Type d'intervalle","Ce qui clôture une barre","Idéal pour"], rows: [
      ["Minutes (préréglages)","Un nombre fixe de minutes (1, 5, 15, 30, 60)","Le trading intrajournalier courant"],
      ["Custom Time","Toute valeur en minutes que vous saisissez (p. ex. 2, 3, 240)","Les unités de temps que les préréglages n'incluent pas"],
      ["Tick","Un nombre défini de trades","Lire un flux d'ordres rapide"],
      ["Volume","Un nombre défini de contrats échangés","Les barres basées sur l'activité"],
      ["Range","Un mouvement de prix défini en ticks","Filtrer les phases sans direction"],
      ["Second","Un nombre défini de secondes","Le scalping infra-minute"],
    ] },
    { type: "heading",text: "Quelques points utiles à savoir" },
    { type: "paragraph",html: "L'intervalle que vous définissez s'applique uniquement à ce graphique. Si vous souhaitez suivre le même contrat sur deux unités de temps à la fois, par exemple 5 minutes pour les entrées et 60 minutes pour le contexte, ouvrez un second module Chart et réglez chacun séparément. Ils n'interfèrent pas l'un avec l'autre." },
    { type: "paragraph",html: "La profondeur de l'historique chargé sur de très petites unités de temps dépend de votre configuration de données de marché, qui varie selon le compte et la société ; vérifiez les règles en vigueur de votre société si les barres ne se chargent pas aussi loin que prévu. Et rappelez-vous que modifier l'intervalle ne change jamais le contrat ni le flux de données ; cela change seulement la façon dont les données existantes sont regroupées en barres." },
    { type: "quote",html: "Vous découvrez les graphiques Tradovate ? Commencez par le guide des bases du charting Tradovate pour ouvrir et organiser le module Chart, puis revenez ici pour affiner votre unité de temps." },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "Une fois vos graphiques configurés comme vous le souhaitez, l'étape suivante consiste à passer vos trades sans surveiller l'écran en permanence. <strong class='text-white'>PickMyTrade automatise vos ordres Tradovate directement à partir des alertes TradingView</strong> : définissez votre stratégie et laissez les alertes déclencher les trades à votre place." },
  ], it: [
    { type: "paragraph",html: "Il Suo timeframe decide come Lei vede realmente il mercato. Un grafico a 1 minuto è tutto rumore e scalp veloci; uno a 60 minuti lo attenua e mostra lo swing più ampio. Tradovate Le permette di passare dall'uno all'altro con un paio di clic e va ben oltre i consueti preset in minuti: può creare anche barre basate su tick, volume, range e secondi. Ecco esattamente dove cliccare e come impostare l'intervallo su cui opera." },
    { type: "heading",text: "Dove si trova il controllo dell'intervallo" },
    { type: "paragraph",html: "Ogni grafico in Tradovate ha una piccola barra degli strumenti che compare solo quando il cursore si trova sopra il grafico. Passi il mouse sul modulo Chart e in alto compare una riga di icone. Il controllo dell'intervallo si trova verso sinistra di quella riga e di solito mostra l'impostazione attuale (qualcosa come <strong class='text-white'>5m</strong> o <strong class='text-white'>1H</strong>), così può leggere a colpo d'occhio il timeframe attivo prima di cambiare qualsiasi cosa." },
    { type: "paragraph",html: "Una cosa va chiarita subito: il pulsante dell'intervallo e il pulsante dello <em>stile del grafico</em> sono due cose diverse. L'intervallo controlla il <em>tempo o la dimensione</em> di ogni barra. Lo stile del grafico controlla come ogni barra viene <em>disegnata</em>: candele, barre, linea e così via. Questa guida riguarda l'intervallo." },
    { type: "heading",text: "Come cambiare il timeframe del grafico" },
    {
      type: "steps",
      items: [
        { title: "Aprire un grafico e mostrare la barra degli strumenti", html: "Apra il modulo Chart per il contratto che sta osservando, poi muova il mouse sull'area del grafico. La barra degli strumenti compare in dissolvenza in alto. Se non la vede, probabilmente il cursore è uscito dal grafico: torni sul pannello dei prezzi e riapparirà." },
        { title: "Aprire il menu a discesa dell'intervallo", html: "Clicchi sul controllo dell'intervallo in alto a sinistra nella barra degli strumenti, quello che mostra l'intervallo attuale. Si apre il menu a discesa dell'intervallo, dove si trovano tutte le opzioni di timeframe: i preset in minuti, i generatori personalizzati e gli intervalli recenti che ha usato." },
        { title: "Scegliere un intervallo in minuti predefinito", html: "Per la maggior parte dei trader i preset bastano. Tradovate offre barre da 1, 5, 15, 30 e 60 minuti direttamente nel menu. Ne clicchi una e il grafico si ridisegna subito, senza pulsante di salvataggio né conferma. Gli scalper di solito restano su 1 o 5 minuti; se legge la struttura intraday, 15 o 60 danno barre più pulite." },
        { title: "Creare un intervallo in minuti personalizzato", html: "Le serve qualcosa che i preset non prevedono, come 2 minuti, 3 minuti o 4 ore? Scelga l'opzione <strong class='text-white'>Custom Time</strong> e digiti il valore in minuti desiderato. Un grafico a 240 minuti, ad esempio, dà una barra da 4 ore. Dopo aver usato un timeframe personalizzato, questo viene salvato in fondo al menu degli intervalli, tra i timeframe recenti, così può tornarci senza doverlo digitare di nuovo." },
        { title: "Passare a barre a tick, volume, range o secondi", html: "Il tempo non è l'unico modo per costruire una barra. Scelga uno dei tipi di intervallo non in minuti, <strong class='text-white'>Tick</strong>, <strong class='text-white'>Volume</strong>, <strong class='text-white'>Range</strong> o <strong class='text-white'>Second</strong>, e un piccolo pop-up Le chiede che cosa debba rappresentare ogni barra. Inserisca un numero e confermi. Una barra da 500 tick si chiude ogni 500 trade; una barra range si chiude dopo che il prezzo si è mosso di un numero stabilito di tick; una barra volume si chiude dopo che è passato di mano un numero stabilito di contratti. Queste barre tolgono l'orologio dall'equazione e lasciano che sia l'attività, non il tempo, a decidere quando si forma una nuova barra." },
      ],
    },
    { type: "heading",text: "I tipi di intervallo a colpo d'occhio" },
    { type: "table", headers: ["Tipo di intervallo","Cosa chiude una barra","Ideale per"], rows: [
      ["Minuti (preset)","Un numero fisso di minuti (1, 5, 15, 30, 60)","Il trading intraday di tutti i giorni"],
      ["Custom Time","Qualsiasi valore in minuti inserito (ad es. 2, 3, 240)","Timeframe che i preset non prevedono"],
      ["Tick","Un numero stabilito di trade","Leggere l'order flow veloce"],
      ["Volume","Un numero stabilito di contratti scambiati","Barre basate sull'attività"],
      ["Range","Un movimento di prezzo stabilito in tick","Filtrare i movimenti laterali"],
      ["Second","Un numero stabilito di secondi","Scalping sotto il minuto"],
    ] },
    { type: "heading",text: "Alcune cose utili da sapere" },
    { type: "paragraph",html: "L'intervallo impostato vale solo per quel singolo grafico. Se desidera osservare lo stesso contratto su due timeframe contemporaneamente, ad esempio un 5 minuti per gli ingressi e un 60 minuti per il contesto, apra un secondo modulo Chart e imposti ciascuno separatamente. Non interferiscono tra loro." },
    { type: "paragraph",html: "Quanto indietro si carica lo storico sui timeframe molto bassi dipende dalla configurazione dei dati di mercato, che varia in base al conto e alla società; verifichi le regole attuali della Sua società se le barre non si caricano così indietro come si aspetta. E ricordi che cambiare l'intervallo non modifica mai il contratto né il feed dati; cambia solo il modo in cui i dati esistenti vengono raggruppati in barre." },
    { type: "quote",html: "Non conosce ancora i grafici di Tradovate? Inizi con la guida alle basi del charting di Tradovate per aprire e disporre il modulo Chart, poi torni qui per mettere a punto il Suo timeframe." },
    { type: "heading",text: "Automatizzi tutto questo con PickMyTrade" },
    { type: "paragraph",html: "Una volta impostati i grafici come preferisce, il passo successivo è eseguire i trade senza stare incollato allo schermo. <strong class='text-white'>PickMyTrade automatizza i Suoi ordini Tradovate direttamente dagli alert di TradingView</strong>: definisca la Sua strategia e lasci che siano gli alert a far partire i trade per Lei." },
  ] },
