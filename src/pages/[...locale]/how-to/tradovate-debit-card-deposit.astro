---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GuideArticle from "../../../components/GuideArticle.astro";
import { getLocalePaths, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";
import { relatedGuides } from "../../../data/guides";
import type { GuideArticleI18nData } from "../../../types/guide";
import { resolveGuideContent } from "../../../types/guide";
import type { GuideArticleData } from "../../../types/guide";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };

const SLUG = "tradovate-debit-card-deposit";
const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const IMG = `/assets/how-to/${SLUG}`;

const META_TITLE = "Deposit by Debit Card or Digital Wallet in Tradovate";
const META_DESCRIPTION =
  "Add trading capital in minutes with a debit card, Apple Pay, or Google Pay. Learn the deposit limits, same-day cutoff, fees, and when funds clear.";

const related = relatedGuides(SLUG).map((g) => ({ title: g.title[locale], href: localizedPath(locale, `${g.section}/${g.slug}`) }));
const content: GuideArticleI18nData = {
  badge: { en: "Tradovate", de: "Tradovate", es: "Tradovate", fr: "Tradovate", it: "Tradovate" },
  h1: { en: META_TITLE, de: "Einzahlung per Debitkarte oder digitaler Wallet bei Tradovate", es: "Depósito con tarjeta de débito o billetera digital en Tradovate", fr: "Dépôt par carte de débit ou portefeuille numérique sur Tradovate", it: "Deposito con carta di debito o portafoglio digitale su Tradovate" },
  dek: { en: "You can move money into a Tradovate account in a couple of minutes with a debit card, Apple Pay, or Google Pay, no wire form, no bank login, no waiting on a paper transfer. Here's exactly how, plus the limits, fees, and timing.", de: "Sie können in wenigen Minuten per Debitkarte, Apple Pay oder Google Pay Geld auf ein Tradovate-Konto einzahlen, ohne Überweisungsformular, ohne Bank-Login und ohne Warten auf eine Papierüberweisung. So geht es genau, einschließlich Limits, Gebühren und Dauer.", es: "Puede ingresar dinero en una cuenta de Tradovate en un par de minutos con una tarjeta de débito, Apple Pay o Google Pay, sin formulario de transferencia, sin inicio de sesión bancario y sin esperar una transferencia en papel. Así se hace exactamente, con los límites, las comisiones y los plazos.", fr: "Vous pouvez alimenter un compte Tradovate en quelques minutes avec une carte de débit, Apple Pay ou Google Pay, sans formulaire de virement, sans connexion bancaire et sans attendre un virement papier. Voici comment procéder exactement, avec les plafonds, les frais et les délais.", it: "Può versare denaro su un conto Tradovate in un paio di minuti con una carta di debito, Apple Pay o Google Pay, senza modulo di bonifico, senza accesso alla banca e senza attendere un trasferimento cartaceo. Ecco come procedere esattamente, con limiti, commissioni e tempistiche." },
  readTime: { en: "5 min read", de: "5 Min. Lesezeit", es: "Lectura de 5 min", fr: "Lecture : 5 min", it: "Lettura di 5 min" },
  lastUpdated: "2026-07-08",
  blocks: { en: [
    { type: "paragraph", html: "You can move money into a Tradovate account in a couple of minutes with a debit card, Apple Pay, or Google Pay, no wire form to fill out, no bank login, no waiting on a paper transfer." },
    { type: "heading", text: "What Is a Card or Digital Wallet Deposit?" },
    { type: "paragraph", html: "A card or digital wallet deposit funds your Tradovate <strong class='text-white'>Individual Brokerage</strong> account by charging a debit card directly, either by typing the card in or by tapping Apple Pay or Google Pay. It's the fastest self-serve way to add buying power without wiring or setting up an ACH bank link. Both routes run on debit cards only; credit cards won't go through, even when they're loaded into a wallet." },
    { type: "paragraph", html: "Here's how the two card-based methods compare on limits and timing:" },
    { type: "table", headers: ["Method", "Per-deposit limit", "Tradovate fee", "Same-day cutoff", "Funds usually available"], rows: [
      ["Debit card", "Up to $5,000", "None", "6:00 PM Central", "~1-3 business days"],
      ["Digital wallet (Apple Pay / Google Pay)", "Up to $5,000", "None", "6:00 PM Central", "~1-3 business days"],
    ] },
    { type: "paragraph", html: "One catch worth planning around: money you add by card can't be pulled straight back out to that card. Once it's in, you withdraw it by ACH after a hold of roughly ten days, or by wire after about sixty days. Confirm the current hold windows in the platform before you count on a withdrawal date." },
    { type: "heading", text: "Deposit by Debit Card or Digital Wallet in Tradovate: Step-by-Step" },
    {
      type: "steps",
      items: [
        { title: "Open the Fund Account Screen", html: "Log in to the Tradovate web or desktop app and open <strong class='text-white'>Application Settings</strong> in the top-right corner. Go to the <strong class='text-white'>Accounts</strong> area and choose <strong class='text-white'>Fund Account</strong>. Every deposit method lives on this one screen, so this is your starting point." },
        { title: "Choose Debit Card or Digital Wallet", html: "On the Fund Account screen you'll see the funding methods. Pick <strong class='text-white'>Debit Cards</strong> if you want to type a card in, or <strong class='text-white'>Digital Wallet (Apple Pay / Google Pay)</strong> if you'd rather pay from your phone or browser. Both pull from a debit card behind the scenes, so a credit card won't be accepted either way." },
        { title: "Link the Card and Accept the Disclosure", html: "For a debit card, agree to the deposit disclosure and terms, then enter your card number, expiry, CVV, and billing details. The name on the card has to match the name on your Tradovate account, or the deposit will bounce. For a wallet, you'll authorize the payment with Face ID, a passcode, or your Google account instead of typing anything." },
        { title: "Enter the Amount and Submit", html: "Type the dollar amount you want to add, up to <strong class='text-white'>$5,000 per deposit</strong>, and confirm. Tradovate doesn't charge a fee on the deposit itself. Heads up: the charge shows on your bank or card statement as <strong class='text-white'>Stripe</strong>, the payment processor, so don't panic when you don't see “Tradovate” on the line." },
        { title: "Confirm the Deposit and Check the Timing", html: "Submit before <strong class='text-white'>6:00 PM Central</strong> and your deposit is processed the same day. Funds typically clear into your trading balance within about one to three business days. If you want to confirm it landed, open your transfer or funding history and watch the status move from pending to complete." },
      ],
    },
    { type: "heading", text: "Why You'd Need This" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>You want buying power today</strong> and don't want to wait on a wire or set up an ACH link first.",
        "<strong class='text-white'>You're topping up a smaller amount</strong> where the $5,000 per-deposit cap is more than enough.",
        "<strong class='text-white'>You'd rather tap Apple Pay or Google Pay</strong> than dig up your account and routing numbers.",
        "<strong class='text-white'>You're funding a personal Individual Brokerage account</strong>, prop-firm and evaluation accounts are funded through the firm, and those rules vary by firm and account size, so check your firm's current rules.",
      ],
    },
    { type: "heading", text: "Automate This with PickMyTrade" },
    { type: "paragraph", html: "Funding is only step one. Once there's money in the account, <strong class='text-white'>PickMyTrade takes your TradingView alerts and fires them straight into Tradovate as live orders</strong>, entries, brackets, and exits, with no manual clicking. You fund once, then let your strategy run hands-free." },
  ], de: [
    { type: "paragraph",html: "Sie können in wenigen Minuten per Debitkarte, Apple Pay oder Google Pay Geld auf ein Tradovate-Konto einzahlen, ohne Überweisungsformular, ohne Bank-Login und ohne Warten auf eine Papierüberweisung." },
    { type: "heading",text: "Was ist eine Einzahlung per Karte oder digitaler Wallet?" },
    { type: "paragraph",html: "Bei einer Einzahlung per Karte oder digitaler Wallet wird Ihr Tradovate-Konto <strong class='text-white'>Individual Brokerage</strong> aufgeladen, indem direkt eine Debitkarte belastet wird, entweder durch Eingabe der Karte oder durch Tippen auf Apple Pay oder Google Pay. Es ist der schnellste Self-Service-Weg, Kaufkraft hinzuzufügen, ohne Überweisung oder ACH-Bankverknüpfung. Beide Wege laufen ausschließlich über Debitkarten; Kreditkarten werden nicht akzeptiert, auch nicht, wenn sie in einer Wallet hinterlegt sind." },
    { type: "paragraph",html: "So vergleichen sich die beiden kartenbasierten Methoden bei Limits und Dauer:" },
    { type: "table", headers: ["Methode","Limit pro Einzahlung","Tradovate-Gebühr","Frist für Gutschrift am selben Tag","Guthaben in der Regel verfügbar"], rows: [
      ["Debitkarte","Bis zu $5,000","Keine","6:00 PM Central","~1-3 Werktage"],
      ["Digitale Wallet (Apple Pay / Google Pay)","Bis zu $5,000","Keine","6:00 PM Central","~1-3 Werktage"],
    ] },
    { type: "paragraph",html: "Ein Haken, den Sie einplanen sollten: Per Karte eingezahltes Geld kann nicht direkt auf diese Karte zurückgezahlt werden. Sobald es eingezahlt ist, heben Sie es nach einer Sperrfrist von etwa zehn Tagen per ACH oder nach etwa sechzig Tagen per Überweisung ab. Prüfen Sie die aktuellen Sperrfristen in der Plattform, bevor Sie mit einem Auszahlungsdatum rechnen." },
    { type: "heading",text: "Einzahlung per Debitkarte oder digitaler Wallet bei Tradovate: Schritt für Schritt" },
    {
      type: "steps",
      items: [
        { title: "Den Bildschirm „Fund Account“ öffnen", html: "Melden Sie sich in der Tradovate-Web- oder Desktop-App an und öffnen Sie oben rechts <strong class='text-white'>Application Settings</strong>. Gehen Sie zum Bereich <strong class='text-white'>Accounts</strong> und wählen Sie <strong class='text-white'>Fund Account</strong>. Alle Einzahlungsmethoden befinden sich auf diesem einen Bildschirm, hier beginnen Sie." },
        { title: "Debitkarte oder digitale Wallet wählen", html: "Auf dem Bildschirm Fund Account sehen Sie die Einzahlungsmethoden. Wählen Sie <strong class='text-white'>Debit Cards</strong>, wenn Sie eine Karte eingeben möchten, oder <strong class='text-white'>Digital Wallet (Apple Pay / Google Pay)</strong>, wenn Sie lieber mit Ihrem Telefon oder Browser bezahlen. Beide greifen im Hintergrund auf eine Debitkarte zu, daher wird in keinem Fall eine Kreditkarte akzeptiert." },
        { title: "Karte verknüpfen und Hinweis akzeptieren", html: "Stimmen Sie bei einer Debitkarte dem Einzahlungshinweis und den Bedingungen zu und geben Sie dann Kartennummer, Ablaufdatum, CVV und Rechnungsdaten ein. Der Name auf der Karte muss mit dem Namen auf Ihrem Tradovate-Konto übereinstimmen, sonst wird die Einzahlung abgelehnt. Bei einer Wallet autorisieren Sie die Zahlung per Face ID, Passcode oder Ihrem Google-Konto, ohne etwas einzutippen." },
        { title: "Betrag eingeben und absenden", html: "Geben Sie den Dollarbetrag ein, den Sie einzahlen möchten, bis zu <strong class='text-white'>$5,000 pro Einzahlung</strong>, und bestätigen Sie. Tradovate erhebt keine Gebühr auf die Einzahlung selbst. Hinweis: Die Belastung erscheint auf Ihrem Bank- oder Kartenauszug als <strong class='text-white'>Stripe</strong>, der Zahlungsdienstleister, erschrecken Sie also nicht, wenn Sie „Tradovate“ in der Zeile nicht sehen." },
        { title: "Einzahlung bestätigen und Dauer prüfen", html: "Senden Sie vor <strong class='text-white'>6:00 PM Central</strong> ab, dann wird Ihre Einzahlung noch am selben Tag verarbeitet. Das Guthaben wird in der Regel innerhalb von etwa ein bis drei Werktagen Ihrem Handelssaldo gutgeschrieben. Wenn Sie prüfen möchten, ob es angekommen ist, öffnen Sie Ihren Überweisungs- oder Einzahlungsverlauf und beobachten Sie, wie der Status von „pending“ auf „complete“ wechselt." },
      ],
    },
    { type: "heading",text: "Wann Sie das brauchen" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Sie möchten heute Kaufkraft</strong> und nicht erst auf eine Überweisung warten oder zuerst eine ACH-Verknüpfung einrichten.",
        "<strong class='text-white'>Sie stocken einen kleineren Betrag auf</strong>, bei dem das Limit von $5,000 pro Einzahlung mehr als ausreicht.",
        "<strong class='text-white'>Sie tippen lieber auf Apple Pay oder Google Pay</strong>, als Ihre Konto- und Bankleitzahl herauszusuchen.",
        "<strong class='text-white'>Sie finanzieren ein persönliches Individual-Brokerage-Konto</strong>, Prop-Firm- und Evaluierungskonten werden über die Firma finanziert, und diese Regeln variieren je nach Firma und Kontogröße. Prüfen Sie daher die aktuellen Regeln Ihrer Firma.",
      ],
    },
    { type: "heading",text: "Automatisieren Sie dies mit PickMyTrade" },
    { type: "paragraph",html: "Die Einzahlung ist nur der erste Schritt. Sobald Geld auf dem Konto ist, <strong class='text-white'>nimmt PickMyTrade Ihre TradingView-Alerts und führt sie direkt als Live-Orders in Tradovate aus</strong>, Einstiege, Brackets und Ausstiege, ganz ohne manuelles Klicken. Sie zahlen einmal ein und lassen Ihre Strategie dann freihändig laufen." },
  ], es: [
    { type: "paragraph",html: "Puede ingresar dinero en una cuenta de Tradovate en un par de minutos con una tarjeta de débito, Apple Pay o Google Pay, sin formulario de transferencia, sin inicio de sesión bancario y sin esperar una transferencia en papel." },
    { type: "heading",text: "¿Qué es un depósito con tarjeta o billetera digital?" },
    { type: "paragraph",html: "Un depósito con tarjeta o billetera digital financia su cuenta <strong class='text-white'>Individual Brokerage</strong> de Tradovate cargando directamente una tarjeta de débito, ya sea introduciendo la tarjeta o pulsando Apple Pay o Google Pay. Es la forma de autoservicio más rápida de añadir poder de compra sin transferencia bancaria ni vincular una cuenta por ACH. Ambas vías funcionan solo con tarjetas de débito; las tarjetas de crédito no se procesan, ni siquiera cuando están cargadas en una billetera." },
    { type: "paragraph",html: "Así se comparan los dos métodos basados en tarjeta en cuanto a límites y plazos:" },
    { type: "table", headers: ["Método","Límite por depósito","Comisión de Tradovate","Hora límite del mismo día","Fondos normalmente disponibles"], rows: [
      ["Tarjeta de débito","Hasta $5,000","Ninguna","6:00 PM Central","~1-3 días hábiles"],
      ["Billetera digital (Apple Pay / Google Pay)","Hasta $5,000","Ninguna","6:00 PM Central","~1-3 días hábiles"],
    ] },
    { type: "paragraph",html: "Un inconveniente que conviene tener en cuenta: el dinero que añade con tarjeta no se puede devolver directamente a esa tarjeta. Una vez ingresado, lo retira por ACH tras una retención de unos diez días, o por transferencia bancaria tras unos sesenta días. Confirme los plazos de retención vigentes en la plataforma antes de contar con una fecha de retiro." },
    { type: "heading",text: "Depósito con tarjeta de débito o billetera digital en Tradovate: paso a paso" },
    {
      type: "steps",
      items: [
        { title: "Abra la pantalla Fund Account", html: "Inicie sesión en la aplicación web o de escritorio de Tradovate y abra <strong class='text-white'>Application Settings</strong> en la esquina superior derecha. Vaya al área <strong class='text-white'>Accounts</strong> y elija <strong class='text-white'>Fund Account</strong>. Todos los métodos de depósito están en esta única pantalla, así que este es su punto de partida." },
        { title: "Elija tarjeta de débito o billetera digital", html: "En la pantalla Fund Account verá los métodos de financiación. Elija <strong class='text-white'>Debit Cards</strong> si quiere introducir una tarjeta, o <strong class='text-white'>Digital Wallet (Apple Pay / Google Pay)</strong> si prefiere pagar desde su teléfono o navegador. Ambos cargan a una tarjeta de débito en segundo plano, por lo que no se aceptará una tarjeta de crédito en ningún caso." },
        { title: "Vincule la tarjeta y acepte el aviso", html: "Para una tarjeta de débito, acepte el aviso y los términos del depósito e introduzca el número de la tarjeta, la fecha de caducidad, el CVV y los datos de facturación. El nombre de la tarjeta debe coincidir con el nombre de su cuenta de Tradovate, o el depósito será rechazado. Para una billetera, autorizará el pago con Face ID, un código o su cuenta de Google, sin escribir nada." },
        { title: "Introduzca el importe y envíe", html: "Escriba el importe en dólares que desea añadir, hasta <strong class='text-white'>$5,000 por depósito</strong>, y confirme. Tradovate no cobra ninguna comisión por el depósito en sí. Atención: el cargo aparece en el extracto de su banco o tarjeta como <strong class='text-white'>Stripe</strong>, el procesador de pagos, así que no se alarme si no ve «Tradovate» en la línea." },
        { title: "Confirme el depósito y compruebe el plazo", html: "Envíe antes de las <strong class='text-white'>6:00 PM Central</strong> y su depósito se procesará el mismo día. Los fondos suelen acreditarse en su saldo de trading en aproximadamente uno a tres días hábiles. Si quiere confirmar que llegó, abra su historial de transferencias o de financiación y vea cómo el estado pasa de pending a complete." },
      ],
    },
    { type: "heading",text: "Por qué lo necesitaría" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Quiere poder de compra hoy</strong> y no desea esperar una transferencia ni configurar primero un enlace ACH.",
        "<strong class='text-white'>Está recargando un importe menor</strong>, para el que el límite de $5,000 por depósito es más que suficiente.",
        "<strong class='text-white'>Prefiere pulsar Apple Pay o Google Pay</strong> antes que buscar su número de cuenta y de ruta.",
        "<strong class='text-white'>Está financiando una cuenta personal Individual Brokerage</strong>; las cuentas de prop firm y de evaluación se financian a través de la firma, y esas reglas varían según la firma y el tamaño de la cuenta, así que consulte las reglas vigentes de su firma.",
      ],
    },
    { type: "heading",text: "Automatice esto con PickMyTrade" },
    { type: "paragraph",html: "La financiación es solo el primer paso. Una vez que hay dinero en la cuenta, <strong class='text-white'>PickMyTrade toma sus alertas de TradingView y las envía directamente a Tradovate como órdenes en vivo</strong>, entradas, brackets y salidas, sin hacer clic manualmente. Deposite una vez y deje que su estrategia funcione sola." },
  ], fr: [
    { type: "paragraph",html: "Vous pouvez alimenter un compte Tradovate en quelques minutes avec une carte de débit, Apple Pay ou Google Pay, sans formulaire de virement, sans connexion bancaire et sans attendre un virement papier." },
    { type: "heading",text: "Qu'est-ce qu'un dépôt par carte ou portefeuille numérique ?" },
    { type: "paragraph",html: "Un dépôt par carte ou portefeuille numérique alimente votre compte Tradovate <strong class='text-white'>Individual Brokerage</strong> en débitant directement une carte de débit, soit en saisissant la carte, soit en utilisant Apple Pay ou Google Pay. C'est le moyen en libre-service le plus rapide d'ajouter du pouvoir d'achat sans virement ni liaison bancaire ACH. Les deux voies ne fonctionnent qu'avec des cartes de débit ; les cartes de crédit sont refusées, même lorsqu'elles sont chargées dans un portefeuille." },
    { type: "paragraph",html: "Voici comment les deux méthodes par carte se comparent en matière de plafonds et de délais :" },
    { type: "table", headers: ["Méthode","Plafond par dépôt","Frais Tradovate","Heure limite le jour même","Fonds généralement disponibles"], rows: [
      ["Carte de débit","Jusqu'à $5,000","Aucun","6:00 PM Central","~1 à 3 jours ouvrés"],
      ["Portefeuille numérique (Apple Pay / Google Pay)","Jusqu'à $5,000","Aucun","6:00 PM Central","~1 à 3 jours ouvrés"],
    ] },
    { type: "paragraph",html: "Un point à anticiper : l'argent ajouté par carte ne peut pas être reversé directement sur cette carte. Une fois déposé, vous le retirez par ACH après un blocage d'environ dix jours, ou par virement après environ soixante jours. Confirmez les délais de blocage en vigueur dans la plateforme avant de compter sur une date de retrait." },
    { type: "heading",text: "Dépôt par carte de débit ou portefeuille numérique sur Tradovate : étape par étape" },
    {
      type: "steps",
      items: [
        { title: "Ouvrir l'écran Fund Account", html: "Connectez-vous à l'application web ou de bureau Tradovate et ouvrez <strong class='text-white'>Application Settings</strong> dans le coin supérieur droit. Accédez à la zone <strong class='text-white'>Accounts</strong> et choisissez <strong class='text-white'>Fund Account</strong>. Toutes les méthodes de dépôt se trouvent sur cet écran unique ; c'est donc votre point de départ." },
        { title: "Choisir carte de débit ou portefeuille numérique", html: "Sur l'écran Fund Account, vous verrez les méthodes de financement. Choisissez <strong class='text-white'>Debit Cards</strong> si vous souhaitez saisir une carte, ou <strong class='text-white'>Digital Wallet (Apple Pay / Google Pay)</strong> si vous préférez payer depuis votre téléphone ou votre navigateur. Les deux débitent une carte de débit en arrière-plan ; une carte de crédit ne sera donc acceptée dans aucun cas." },
        { title: "Associer la carte et accepter l'avis", html: "Pour une carte de débit, acceptez l'avis de dépôt et les conditions, puis saisissez le numéro de carte, la date d'expiration, le CVV et les informations de facturation. Le nom figurant sur la carte doit correspondre au nom de votre compte Tradovate, sinon le dépôt sera rejeté. Pour un portefeuille, vous autoriserez le paiement avec Face ID, un code ou votre compte Google, sans rien saisir." },
        { title: "Saisir le montant et valider", html: "Saisissez le montant en dollars que vous souhaitez ajouter, jusqu'à <strong class='text-white'>$5,000 par dépôt</strong>, puis confirmez. Tradovate ne facture aucun frais sur le dépôt lui-même. Attention : le débit apparaît sur votre relevé bancaire ou de carte sous le nom <strong class='text-white'>Stripe</strong>, le prestataire de paiement ; ne vous inquiétez donc pas si vous ne voyez pas « Tradovate » sur la ligne." },
        { title: "Confirmer le dépôt et vérifier le délai", html: "Validez avant <strong class='text-white'>6:00 PM Central</strong> et votre dépôt est traité le jour même. Les fonds sont généralement crédités sur votre solde de trading sous un à trois jours ouvrés environ. Pour vérifier qu'il est bien arrivé, ouvrez votre historique de transferts ou de financement et suivez le passage du statut de pending à complete." },
      ],
    },
    { type: "heading",text: "Pourquoi vous en auriez besoin" },
    {
      type: "list",
      items: [
        "<strong class='text-white'>Vous voulez du pouvoir d'achat aujourd'hui</strong> et ne souhaitez pas attendre un virement ni configurer d'abord une liaison ACH.",
        "<strong class='text-white'>Vous rechargez un montant modeste</strong>, pour lequel le plafond de $5,000 par dépôt est largement suffisant.",
        "<strong class='text-white'>Vous préférez utiliser Apple Pay ou Google Pay</strong> plutôt que de chercher votre numéro de compte et de routage.",
        "<strong class='text-white'>Vous alimentez un compte personnel Individual Brokerage</strong> ; les comptes de prop firm et d'évaluation sont financés via la société, et ces règles varient selon la société et la taille du compte, vérifiez donc les règles en vigueur de votre société.",
      ],
    },
    { type: "heading",text: "Automatisez cela avec PickMyTrade" },
    { type: "paragraph",html: "L'alimentation du compte n'est que la première étape. Une fois les fonds en place, <strong class='text-white'>PickMyTrade prend vos alertes TradingView et les envoie directement dans Tradovate sous forme d'ordres réels</strong>, entrées, brackets et sorties, sans aucun clic manuel. Vous alimentez une fois, puis vous laissez votre stratégie tourner en mains libres." },
  ], it: [
    { type: "paragraph",html: "Può versare denaro su un conto Tradovate in un paio di minuti con una carta di debito, Apple Pay o Google Pay, senza modulo di bonifico, senza accesso alla banca e senza attendere un trasferimento cartaceo." },
    { type: "heading",text: "Che cos'è un deposito con carta o portafoglio digitale?" },
    { type: "paragraph",html: "Un deposito con carta o portafoglio digitale finanzia il Suo conto Tradovate <strong class='text-white'>Individual Brokerage</strong> addebitando direttamente una carta di debito, inserendo i dati della carta oppure toccando Apple Pay o Google Pay. È il modo self-service più rapido per aggiungere potere d'acquisto senza bonifico né collegamento bancario ACH. Entrambi i metodi funzionano solo con carte di debito; le carte di credito non vengono accettate, anche se caricate in un portafoglio." },
    { type: "paragraph",html: "Ecco come si confrontano i due metodi basati su carta per limiti e tempistiche:" },
    { type: "table", headers: ["Metodo","Limite per deposito","Commissione Tradovate","Orario limite per l'accredito in giornata","Fondi generalmente disponibili"], rows: [
