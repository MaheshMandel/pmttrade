---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getLocalePaths, useTranslations, localizedPath } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/config";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
---

<BaseLayout
  locale={locale}
  title={t("broker_faq.hub_meta_title")}
  description={t("broker_faq.hub_meta_description")}
>
<style>
  /* ── Brand tokens ── */
  :root {
    --blue:        #2B77EE;
    --blue-dark:   #1d63d6;
    --blue-10:     rgba(43,119,238,0.10);
    --blue-20:     rgba(43,119,238,0.20);
    --blue-40:     rgba(43,119,238,0.40);
    --blue-glow:   rgba(43,119,238,0.25);
    --navy-deep:   #000a15;
    --navy-mid:    #001429;
    --navy-card:   rgba(0,20,41,0.70);
  }

  /* ── Hero ── */
  .hero-faq-bg {
    position: relative;
    background: radial-gradient(ellipse 80% 60% at 50% -10%, rgba(43,119,238,0.18) 0%, transparent 65%),
                linear-gradient(180deg, #001020 0%, #001a38 55%, #001f40 100%);
    padding-top: 6rem;
    padding-bottom: 7rem;
    overflow: hidden;
  }
  .hero-faq-bg::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(43,119,238,0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(43,119,238,0.05) 1px, transparent 1px);
    background-size: 48px 48px;
    -webkit-mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 30%, transparent 100%);
    mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 30%, transparent 100%);
  }
  /* floating glow orbs */
  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
    opacity: 0.35;
  }
  .orb-1 { width:420px; height:420px; background:#0f3ec3; top:-120px; left:-80px; }
  .orb-2 { width:320px; height:320px; background:#2B77EE; bottom:-60px; right:-60px; }

  /* ── Stat bar ── */
  .stat-bar {
    background: rgba(0,10,21,0.8);
    backdrop-filter: blur(12px);
    border-top: 1px solid rgba(43,119,238,0.15);
    border-bottom: 1px solid rgba(43,119,238,0.15);
  }
  .stat-divider {
    width: 1px;
    height: 32px;
    background: rgba(43,119,238,0.2);
  }

  /* ── Browse section ── */
  .browse-section {
    background: var(--navy-deep);
    padding-top: 6rem;
    padding-bottom: 5rem;
  }

  /* ── Category header ── */
  .cat-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
  }
  .cat-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    background: var(--blue-10);
    border: 1px solid var(--blue-40);
    color: var(--blue);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .cat-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, rgba(43,119,238,0.4) 0%, transparent 100%);
  }
  .cat-count {
    font-size: 0.7rem;
    color: rgba(255,255,255,0.3);
    font-weight: 500;
    white-space: nowrap;
  }

  /* ── Broker card (glass) ── */
  .broker-card {
    position: relative;
    background: var(--navy-card);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 16px;
    padding: 1.25rem;
    transition: border-color 0.25s, box-shadow 0.25s, transform 0.25s, background 0.25s;
    text-decoration: none;
    display: block;
    overflow: hidden;
  }
  .broker-card::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(135deg, rgba(43,119,238,0.07) 0%, transparent 60%);
    opacity: 0;
    transition: opacity 0.25s;
  }
  .broker-card:hover {
    border-color: rgba(43,119,238,0.5);
    box-shadow: 0 0 30px -5px rgba(43,119,238,0.3), 0 8px 32px -8px rgba(0,0,0,0.6);
    transform: translateY(-2px);
    background: rgba(0,24,50,0.85);
  }
  .broker-card:hover::before { opacity: 1; }

  .icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: linear-gradient(135deg, rgba(43,119,238,0.25) 0%, rgba(43,119,238,0.10) 100%);
    border: 1px solid rgba(43,119,238,0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--blue);
    font-size: 1.1rem;
    flex-shrink: 0;
    transition: background 0.2s, border-color 0.2s;
  }
  .broker-card:hover .icon-wrap {
    background: linear-gradient(135deg, rgba(43,119,238,0.40) 0%, rgba(43,119,238,0.20) 100%);
    border-color: rgba(43,119,238,0.5);
  }

  .q-badge {
    display: inline-flex;
    align-items: center;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--blue-10);
    border: 1px solid var(--blue-40);
    color: var(--blue);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    flex-shrink: 0;
  }

  .read-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--blue);
    font-size: 0.72rem;
    font-weight: 600;
    transition: gap 0.2s;
  }
  .broker-card:hover .read-link { gap: 0.55rem; }

  /* ── CTA ── */
  .cta-section {
    position: relative;
    background: linear-gradient(135deg, #0c2f9a 0%, #1652c8 50%, #2B77EE 100%);
    overflow: hidden;
  }
  .cta-section::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
    background-size: 40px 40px;
  }
  .cta-ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.1);
    pointer-events: none;
  }

  .shadow-brand-blue { box-shadow: 0 10px 25px -5px rgba(43,119,238,0.45), 0 6px 12px -6px rgba(43,119,238,0.3); }
  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 2rem;
    background: var(--blue);
    color: #fff;
    font-weight: 700;
    border-radius: 12px;
    transition: background 0.2s, box-shadow 0.2s, transform 0.2s;
  }
  .btn-primary:hover {
    background: var(--blue-dark);
    box-shadow: 0 12px 28px -6px var(--blue-glow);
    transform: translateY(-1px);
  }
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 2rem;
    border: 1px solid rgba(255,255,255,0.18);
    color: #fff;
    font-weight: 700;
    border-radius: 12px;
    transition: border-color 0.2s, background 0.2s;
  }
  .btn-ghost:hover { border-color: rgba(43,119,238,0.5); background: rgba(255,255,255,0.05); }
</style>

<!-- CollectionPage Schema -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Broker FAQ Hub — 490+ Answers Across 9 Brokers",
  "url": "https://pickmytrade.trade/broker-faq/",
  "description": "Comprehensive broker FAQ hub covering 9 brokers with 490+ real trader questions — Rithmic, Interactive Brokers, Tradovate, TradeStation, ProjectX, cTrader, MatchTrader, TradeLocker, and Tradier.",
  "datePublished": "2026-02-01",
  "dateModified": "2026-04-28",
  "inLanguage": "en-US",
  "isPartOf": {
    "@type": "WebSite",
    "name": "PickMyTrade",
    "url": "https://pickmytrade.trade"
  },
  "publisher": { "@id": "https://pickmytrade.trade/#organization" },
  "about": [
    {"@type": "Thing", "name": "ProjectX", "description": "Browser-based futures platform used by multiple prop firms."},
    {"@type": "Thing", "name": "Rithmic", "description": "Ultra-low-latency routing to CME for prop firms and retail."},
    {"@type": "Thing", "name": "TradeStation", "description": "US-regulated broker supporting stocks, options, and futures."},
    {"@type": "Thing", "name": "Interactive Brokers", "description": "Global multi-asset broker with deep futures, stocks, and options coverage."},
    {"@type": "Thing", "name": "Tradovate", "description": "Commission-free futures broker popular with retail and prop traders."},
    {"@type": "Thing", "name": "cTrader", "description": "Multi-broker FX/CFD platform with algo support."},
    {"@type": "Thing", "name": "MatchTrader", "description": "FX/CFD platform favored by prop firms."},
    {"@type": "Thing", "name": "TradeLocker", "description": "Web-based trading platform used by many brokers."},
    {"@type": "Thing", "name": "Tradier", "description": "US equities and options broker with developer-first API."}
  ]
}
</script>

<!-- BreadcrumbList Schema -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": "Home", "item": "https://pickmytrade.trade/"},
    {"@type": "ListItem", "position": 2, "name": "Broker FAQ Hub", "item": "https://pickmytrade.trade/broker-faq/"}
  ]
}
</script>

<main id="main-content" role="main">

  <!-- ── Hero ─────────────────────────────────────────── -->
  <section class="hero-faq-bg">
    <div class="orb orb-1" aria-hidden="true"></div>
    <div class="orb orb-2" aria-hidden="true"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 text-center relative z-10">

      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" class="flex justify-center mb-8">
        <ol class="flex items-center gap-2 text-sm text-gray-500">
          <li><a href={localizedPath(locale)} class="hover:text-[#2B77EE] transition-colors">{t("broker_faq.hub_breadcrumb_home")}</a></li>
          <li><i class="fa-solid fa-chevron-right text-[9px]"></i></li>
          <li class="text-[#2B77EE] font-medium">{t("broker_faq.hub_breadcrumb_current")}</li>
        </ol>
      </nav>

      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-[#2B77EE]/40 bg-[#2B77EE]/10 text-[#2B77EE] text-[10px] font-bold uppercase tracking-[0.18em] mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-[#2B77EE] animate-pulse"></span>
        {t("broker_faq.hub_hero_badge")}
      </div>

      <!-- Headline -->
      <h1 class="text-4xl md:text-6xl font-extrabold mb-5 leading-[1.1] text-white tracking-tight">
        {t("broker_faq.hub_hero_h1_line1")}<br>
        <span class="text-[#2B77EE]">{t("broker_faq.hub_hero_h1_highlight")}</span>
      </h1>
      <p class="text-gray-300 text-base md:text-lg max-w-2xl mx-auto mb-3 leading-relaxed">
        {t("broker_faq.hub_hero_subtitle")}
      </p>
      <p class="text-xs text-white/40 mb-8">
        <i class="far fa-clock mr-1"></i>{t("broker_faq.hub_hero_last_updated")} <time datetime="2026-04-28">{t("broker_faq.hub_hero_date_text")}</time>
      </p>

      <!-- CTAs -->
      <div class="flex flex-wrap gap-3 justify-center">
        <a href="https://app.pickmytrade.trade/?register=true" class="btn-primary shadow-brand-blue">
          {t("broker_faq.hub_cta_start_trial")} <i class="fa-solid fa-arrow-right text-sm"></i>
        </a>
        <a href="#browse" class="btn-ghost">
          {t("broker_faq.hub_cta_browse")} <i class="fa-solid fa-chevron-down text-sm"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- ── Stats bar ─────────────────────────────────────── -->
  <div class="stat-bar py-5 px-4">
    <div class="max-w-4xl mx-auto flex flex-wrap items-center justify-center gap-4 md:gap-0">
      <div class="flex flex-col items-center px-6 md:px-10">
        <span class="text-2xl font-extrabold text-white">490<span class="text-[#2B77EE]">+</span></span>
        <span class="text-[11px] text-gray-500 uppercase tracking-widest mt-0.5">{t("broker_faq.hub_stat_questions_label")}</span>
      </div>
      <div class="stat-divider hidden md:block"></div>
      <div class="flex flex-col items-center px-6 md:px-10">
        <span class="text-2xl font-extrabold text-white">9<span class="text-[#2B77EE]"></span></span>
        <span class="text-[11px] text-gray-500 uppercase tracking-widest mt-0.5">{t("broker_faq.hub_stat_brokers_label")}</span>
      </div>
      <div class="stat-divider hidden md:block"></div>
      <div class="flex flex-col items-center px-6 md:px-10">
        <span class="text-2xl font-extrabold text-white">3</span>
        <span class="text-[11px] text-gray-500 uppercase tracking-widest mt-0.5">{t("broker_faq.hub_stat_categories_label")}</span>
      </div>
      <div class="stat-divider hidden md:block"></div>
      <div class="flex flex-col items-center px-6 md:px-10">
        <span class="text-2xl font-extrabold text-white"><span class="text-[#2B77EE]">&lt;</span>200ms</span>
        <span class="text-[11px] text-gray-500 uppercase tracking-widest mt-0.5">{t("broker_faq.hub_stat_execution_label")}</span>
      </div>
    </div>
  </div>

  <!-- ── Browse Brokers ────────────────────────────────── -->
  <section id="browse" class="browse-section px-4">
    <div class="max-w-7xl mx-auto">

      <!-- Section intro -->
      <div class="text-center mb-14">
        <span class="inline-flex items-center gap-2 px-5 py-2 rounded-full border border-[#2B77EE]/40 bg-[#2B77EE]/10 text-[#2B77EE] text-[10px] font-bold uppercase tracking-[0.18em] mb-5">
          <i class="fa-solid fa-arrow-down text-[9px]"></i> {t("broker_faq.hub_section_badge")}
        </span>
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-3 tracking-tight">
          {t("broker_faq.hub_section_h2")}
        </h2>
        <p class="text-gray-400 text-base md:text-lg max-w-2xl mx-auto leading-relaxed">
          {t("broker_faq.hub_section_subtitle")}
        </p>
      </div>

      <!-- ── Category: Charting & Strategy Platforms ── -->
      <div class="mb-14">
        <div class="cat-header">
          <span class="cat-pill">
            <i class="fa-solid fa-chart-area text-[9px]"></i> {t("broker_faq.hub_cat1_label")}
          </span>
          <div class="cat-line"></div>
          <span class="cat-count">{t("broker_faq.hub_cat1_count")}</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">

          <a href="https://pickmytrade.io/broker-faq/tradingview-faq/" target="_blank" rel="noopener noreferrer" class="broker-card">
            <div class="flex items-start gap-4 relative z-10">
              <div class="icon-wrap"><i class="fa-solid fa-chart-area" aria-hidden="true"></i></div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between gap-2 mb-1.5">
                  <h3 class="text-white font-bold text-base electrolize group-hover:text-[#2B77EE] transition-colors truncate">TradingView</h3>
                  <span class="q-badge">{t("broker_faq.hub_card_tradingview_q_count")}</span>
                </div>
                <p class="text-gray-400 text-sm mb-3 leading-snug">{t("broker_faq.hub_card_tradingview_desc")}</p>
                <span class="read-link">{t("broker_faq.hub_card_read_faq")} <i class="fa-solid fa-arrow-right text-[9px]"></i></span>
              </div>
            </div>
          </a>

        </div>
      </div>

      <!-- ── Category: Futures Brokers ── -->
      <div class="mb-14">
        <div class="cat-header">
          <span class="cat-pill">
            <i class="fa-solid fa-chart-line text-[9px]"></i> {t("broker_faq.hub_cat2_label")}
          </span>
          <div class="cat-line"></div>
          <span class="cat-count">{t("broker_faq.hub_cat2_count")}</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">

          <a href="https://pickmytrade.io/broker-faq/projectx-faq/" target="_blank" rel="noopener noreferrer" class="broker-card">
            <div class="flex items-start gap-4 relative z-10">
              <div class="icon-wrap"><i class="fa-solid fa-square-poll-vertical" aria-hidden="true"></i></div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between gap-2 mb-1.5">
                  <h3 class="text-white font-bold text-base electrolize truncate">ProjectX</h3>
                  <span class="q-badge">{t("broker_faq.hub_card_projectx_q_count")}</span>
                </div>
                <p class="text-gray-400 text-sm mb-3 leading-snug">{t("broker_faq.hub_card_projectx_desc")}</p>
                <span class="read-link">{t("broker_faq.hub_card_read_faq")} <i class="fa-solid fa-arrow-right text-[9px]"></i></span>
              </div>
            </div>
          </a>

          <a href="https://pickmytrade.io/broker-faq/rithmic-faq/" target="_blank" rel="noopener noreferrer" class="broker-card">
            <div class="flex items-start gap-4 relative z-10">
              <div class="icon-wrap"><i class="fa-solid fa-chart-line" aria-hidden="true"></i></div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between gap-2 mb-1.5">
                  <h3 class="text-white font-bold text-base electrolize truncate">Rithmic</h3>
                  <span class="q-badge">{t("broker_faq.hub_card_rithmic_q_count")}</span>
                </div>
                <p class="text-gray-400 text-sm mb-3 leading-snug">{t("broker_faq.hub_card_rithmic_desc")}</p>
                <span class="read-link">{t("broker_faq.hub_card_read_faq")} <i class="fa-solid fa-arrow-right text-[9px]"></i></span>
              </div>
            </div>
          </a>

          <a href="https://pickmytrade.io/broker-faq/tradestation-faq/" target="_blank" rel="noopener noreferrer" class="broker-card">
            <div class="flex items-start gap-4 relative z-10">
              <div class="icon-wrap"><i class="fa-solid fa-building-columns" aria-hidden="true"></i></div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between gap-2 mb-1.5">
                  <h3 class="text-white font-bold text-base electrolize truncate">TradeStation</h3>
                  <span class="q-badge">{t("broker_faq.hub_card_tradestation_q_count")}</span>
                </div>
                <p class="text-gray-400 text-sm mb-3 leading-snug">{t("broker_faq.hub_card_tradestation_desc")}</p>
                <span class="read-link">{t("broker_faq.hub_card_read_faq")} <i class="fa-solid fa-arrow-right text-[9px]"></i></span>
              </div>
            </div>
          </a>

          <a href="https://pickmytrade.io/broker-faq/ib-faq/" target="_blank" rel="noopener noreferrer" class="broker-card">
            <div class="flex items-start gap-4 relative z-10">
              <div class="icon-wrap"><i class="fa-solid fa-globe" aria-hidden="true"></i></div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between gap-2 mb-1.5">
                  <h3 class="text-white font-bold text-base electrolize truncate">Interactive Brokers</h3>
                  <span class="q-badge">{t("broker_faq.hub_card_ib_q_count")}</span>
                </div>
                <p class="text-gray-400 text-sm mb-3 leading-snug">{t("broker_faq.hub_card_ib_desc")}</p>
                <span class="read-link">{t("broker_faq.hub_card_read_faq")} <i class="fa-solid fa-arrow-right text-[9px]"></i></span>
              </div>
            </div>
          </a>

          <a href={localizedPath(locale, "broker-faq/tradovate-faq")} class="broker-card">
            <div class="flex items-start gap-4 relative z-10">
              <div class="icon-wrap"><i class="fa-solid fa-bolt" aria-hidden="true"></i></div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between gap-2 mb-1.5">
                  <h3 class="text-white font-bold text-base electrolize truncate">Tradovate</h3>
                  <span class="q-badge">{t("broker_faq.hub_card_tradovate_q_count")}</span>
                </div>
                <p class="text-gray-400 text-sm mb-3 leading-snug">{t("broker_faq.hub_card_tradovate_desc")}</p>
                <span class="read-link">{t("broker_faq.hub_card_read_faq")} <i class="fa-solid fa-arrow-right text-[9px]"></i></span>
              </div>
            </div>
          </a>

        </div>
      </div>

      <!-- ── Category: Multi-asset & FX/CFD ── -->
      <div class="mb-6">
        <div class="cat-header">
          <span class="cat-pill">
            <i class="fa-solid fa-layer-group text-[9px]"></i> {t("broker_faq.hub_cat3_label")}
          </span>
          <div class="cat-line"></div>
          <span class="cat-count">{t("broker_faq.hub_cat3_count")}</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">

          <a href="https://pickmytrade.io/broker-faq/ctrader-faq/" target="_blank" rel="noopener noreferrer" class="broker-card">
            <div class="flex items-start gap-4 relative z-10">
              <div class="icon-wrap"><i class="fa-solid fa-arrow-trend-up" aria-hidden="true"></i></div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between gap-2 mb-1.5">
                  <h3 class="text-white font-bold text-base electrolize truncate">cTrader</h3>
                  <span class="q-badge">{t("broker_faq.hub_card_ctrader_q_count")}</span>
                </div>
