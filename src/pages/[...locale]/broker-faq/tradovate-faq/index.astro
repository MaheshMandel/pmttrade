---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { getLocalePaths, useTranslations, localizedPath } from "../../../../i18n/utils";
import type { Locale } from "../../../../i18n/config";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
---

<BaseLayout
  locale={locale}
  title={t("broker_faq.tradovate_meta_title")}
  description={t("broker_faq.tradovate_meta_description")}
>
<style is:global>
    :root {
      --bg-deep: #000d1e;
      --bg-surface: #001225;
      --border-subtle: rgba(255,255,255,0.06);
      --border-card: rgba(255,255,255,0.08);
      --border-active: rgba(59,130,246,0.55);
      --text-primary: #f0f6ff;
      --text-secondary: #b8cfe8;
      --text-muted: #5a7494;
      --accent-blue: #3b82f6;
      --accent-blue-2: #2B77EE;
      --accent-cyan: #93c5fd;
      --accent-green: #34d399;
      --accent-amber: #fbbf24;
      --accent-rose: #f87171;
      --accent-purple: #a78bfa;
      --radius: 14px;
      --radius-sm: 10px;
      --transition: 0.26s cubic-bezier(0.4, 0, 0.2, 1);
    }
    body {
      font-family: 'Inter', -apple-system, sans-serif;
      background: var(--bg-deep);
      color: var(--text-primary);
      min-height: 100vh;
      overflow-x: hidden;
    }
    .ambient-glow-1 {
      position: fixed; top: -20%; left: -10%;
      width: 80vw; height: 80vw;
      background: radial-gradient(circle, rgba(43,119,238,0.07) 0%, transparent 65%);
      pointer-events: none; z-index: 0;
      animation: ambientDrift 28s ease-in-out infinite;
    }
    .ambient-glow-2 {
      position: fixed; bottom: -20%; right: -10%;
      width: 65vw; height: 65vw;
      background: radial-gradient(circle, rgba(96,165,250,0.05) 0%, transparent 65%);
      pointer-events: none; z-index: 0;
      animation: ambientDrift 35s ease-in-out infinite reverse;
    }
    @keyframes ambientDrift {
      0%, 100% { transform: translate(0, 0); }
      50% { transform: translate(3vw, 2vh); }
    }
    .page-content { position: relative; z-index: 1; }
    .hero-glow {
      position: absolute; top: 0; left: 50%;
      transform: translateX(-50%);
      width: 800px; height: 420px;
      background: radial-gradient(ellipse, rgba(43,119,238,0.15) 0%, transparent 70%);
      pointer-events: none;
    }

    /* ── Hero badge ── */
    .hero-badge {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 8px 22px;
      background: linear-gradient(135deg, rgba(43,119,238,0.13) 0%, rgba(96,165,250,0.07) 100%);
      border: 1px solid rgba(59,130,246,0.30);
      border-radius: 100px;
      color: #93c5fd; font-size: 0.74rem; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.12em;
      margin-bottom: 24px;
    }

    /* ── Gradient headline text ── */
    .hero-gradient-text {
      background: linear-gradient(135deg, #60a5fa 0%, #93c5fd 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    /* ── Hero stat chips ── */
    .hero-stats {
      display: flex; justify-content: center;
      gap: 10px; flex-wrap: wrap; margin-bottom: 32px;
    }
    .hero-stat {
      display: inline-flex; align-items: center; gap: 7px;
      padding: 7px 16px;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.09);
      border-radius: 100px;
      font-size: 0.8rem; font-weight: 600;
      color: var(--text-secondary); letter-spacing: 0.01em;
    }
    .hero-stat i { color: #60a5fa; font-size: 0.72rem; }

    /* ── Search ── */
    .search-wrap { position: relative; max-width: 620px; margin: 0 auto 14px; }
    .search-wrap .search-icon {
      position: absolute; left: 20px; top: 50%;
      transform: translateY(-50%);
      color: var(--text-muted); font-size: 14px; pointer-events: none;
    }
    .search-input {
      width: 100%; padding: 17px 60px 17px 52px;
      background: rgba(255,255,255,0.04);
      backdrop-filter: blur(16px);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: var(--radius);
      font-size: 0.95rem; color: var(--text-primary);
      font-family: inherit; outline: none;
      transition: var(--transition);
      box-shadow: 0 2px 20px rgba(0,0,0,0.2);
    }
    .search-input::placeholder { color: var(--text-muted); }
    .search-input:focus {
      border-color: rgba(59,130,246,0.55);
      box-shadow: 0 0 0 4px rgba(59,130,246,0.10), 0 4px 24px rgba(0,0,0,0.3);
      background: rgba(255,255,255,0.06);
    }
    .search-shortcut {
      position: absolute; right: 16px; top: 50%;
      transform: translateY(-50%);
      font-size: 0.72rem; color: var(--text-muted);
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.09);
      border-radius: 5px; padding: 3px 8px;
      font-family: monospace;
    }
    .search-count {
      text-align: center; font-size: 0.82rem;
      color: var(--text-muted); min-height: 20px;
    }
    .search-count strong { color: #60a5fa; }

    /* ── Search dropdown ── */
    .search-dropdown {
      position: absolute; top: calc(100% + 8px); left: 0; right: 0;
      background: rgba(0, 13, 30, 0.97);
      backdrop-filter: blur(24px);
      border: 1px solid rgba(59,130,246,0.20);
      border-radius: var(--radius);
      box-shadow: 0 24px 64px rgba(0,0,0,0.65), 0 0 0 1px rgba(59,130,246,0.06);
      max-height: min(60vh, 440px);
      overflow-y: auto;
      z-index: 40;
      display: none;
      padding: 8px;
    }
    .search-dropdown.visible { display: block; }
    .search-dropdown::-webkit-scrollbar { width: 5px; }
    .search-dropdown::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.07); border-radius: 3px; }
    .search-result {
      display: flex; align-items: flex-start; gap: 12px;
      padding: 12px 16px; border-radius: 10px;
      cursor: pointer; transition: background 0.15s ease;
      color: var(--text-secondary);
    }
    .search-result + .search-result { margin-top: 2px; }
    .search-result:hover, .search-result.active { background: rgba(59,130,246,0.10); }
    .search-result .res-dot {
      width: 7px; height: 7px; border-radius: 50%;
      flex-shrink: 0; margin-top: 8px;
    }
    .search-result .res-body { flex: 1; min-width: 0; }
    .search-result .res-q {
      color: var(--text-primary); font-size: 0.9rem;
      font-weight: 500; line-height: 1.4;
      display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2;
      -webkit-box-orient: vertical; overflow: hidden;
    }
    .search-result .res-cat {
      font-size: 0.73rem; color: var(--text-muted);
      margin-top: 3px; display: flex; align-items: center; gap: 5px;
    }
    .search-result mark {
      background: rgba(59,130,246,0.28);
      color: var(--accent-cyan);
      padding: 0 2px; border-radius: 3px;
    }
    .search-empty {
      padding: 28px 16px; text-align: center;
      color: var(--text-muted); font-size: 0.86rem;
    }
    .search-hint {
      padding: 9px 14px 11px;
      border-top: 1px solid var(--border-subtle);
      margin-top: 6px; font-size: 0.72rem;
      color: var(--text-muted); display: flex;
      gap: 14px; flex-wrap: wrap;
    }
    .search-hint kbd {
      background: rgba(255,255,255,0.06);
      border: 1px solid var(--border-subtle);
      border-radius: 4px; padding: 1px 7px;
      font-family: monospace; font-size: 0.7rem;
      color: var(--text-secondary);
    }

    /* ── Flash animation ── */
    .gfaq-item.flash { animation: faqFlash 1.8s ease-out; }
    @keyframes faqFlash {
      0% { box-shadow: 0 0 0 0 rgba(59,130,246,0.55); border-color: rgba(59,130,246,0.55); }
      100% { box-shadow: none; border-color: rgba(255,255,255,0.07); }
    }

    /* ── Filter pills ── */
    .filter-pills {
      display: flex; justify-content: center;
      flex-wrap: wrap; gap: 8px; margin-top: 20px;
    }
    .filter-pill {
      display: inline-flex; align-items: center; gap: 7px;
      padding: 8px 20px; border-radius: 100px;
      border: 1px solid rgba(255,255,255,0.08);
      background: rgba(255,255,255,0.03); color: var(--text-muted);
      font-size: 0.82rem; font-weight: 500;
      cursor: pointer; transition: var(--transition);
      font-family: inherit; letter-spacing: 0.01em;
    }
    .filter-pill:hover {
      border-color: rgba(59,130,246,0.35);
      color: var(--text-secondary);
      background: rgba(59,130,246,0.05);
    }
    .filter-pill.active {
      background: rgba(59,130,246,0.14);
      border-color: rgba(59,130,246,0.45);
      color: #93c5fd;
      box-shadow: 0 0 16px rgba(59,130,246,0.10);
    }
    .pill-dot { width: 7px; height: 7px; border-radius: 50%; display: inline-block; flex-shrink: 0; }
    .dot-green  { background: var(--accent-green); box-shadow: 0 0 6px rgba(52,211,153,0.4); }
    .dot-amber  { background: var(--accent-amber); box-shadow: 0 0 6px rgba(251,191,36,0.4); }
    .dot-rose   { background: var(--accent-rose);  box-shadow: 0 0 6px rgba(248,113,113,0.4); }
    .dot-purple { background: var(--accent-purple); box-shadow: 0 0 6px rgba(167,139,250,0.4); }

    /* ── TOC Section ── */
    .toc-section { padding: 60px 16px 52px; }
    .toc-heading {
      text-align: center; font-size: 1.5rem; font-weight: 700;
      color: var(--text-primary); margin-bottom: 36px;
      font-family: 'Electrolize', sans-serif; letter-spacing: -0.01em;
    }
    .toc-grid {
      display: grid; grid-template-columns: repeat(3, 1fr);
      gap: 12px; max-width: 960px; margin: 0 auto;
    }
    .toc-card {
      position: relative;
      background: linear-gradient(145deg, rgba(255,255,255,0.035) 0%, rgba(43,119,238,0.025) 100%);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: var(--radius);
      padding: 18px 20px;
      cursor: pointer; transition: all 0.28s cubic-bezier(0.4, 0, 0.2, 1);
      display: flex; align-items: center; gap: 16px;
      text-decoration: none; overflow: hidden;
    }
    .toc-card::after {
      content: '';
      position: absolute; top: 0; left: 0; right: 0; height: 1px;
      background: linear-gradient(90deg, transparent 0%, rgba(59,130,246,0.55) 50%, transparent 100%);
      opacity: 0; transition: opacity 0.28s ease;
    }
    .toc-card:hover {
      border-color: rgba(59,130,246,0.28);
      box-shadow: 0 8px 32px rgba(43,119,238,0.10), 0 2px 12px rgba(0,0,0,0.3);
      transform: translateY(-2px);
      background: linear-gradient(145deg, rgba(255,255,255,0.05) 0%, rgba(43,119,238,0.06) 100%);
    }
    .toc-card:hover::after { opacity: 1; }
    .toc-num {
      min-width: 34px; height: 34px; border-radius: 9px;
      background: linear-gradient(135deg, rgba(43,119,238,0.30) 0%, rgba(96,165,250,0.18) 100%);
      border: 1px solid rgba(59,130,246,0.22);
      color: #93c5fd; font-size: 0.8rem;
      font-weight: 700; display: flex;
      align-items: center; justify-content: center;
      flex-shrink: 0; font-family: 'Electrolize', sans-serif;
    }
    .toc-card-body { min-width: 0; }
    .toc-cat-name {
      font-size: 0.875rem; font-weight: 600;
      color: var(--text-primary); line-height: 1.35;
    }
    .toc-cat-count { font-size: 0.74rem; color: var(--text-muted); margin-top: 3px; font-weight: 500; }

    /* ── FAQ Content ── */
    .faq-content-wrap { max-width: 880px; margin: 0 auto; padding: 0 16px 100px; }

    /* ── Category Sections ── */
    .cat-section { margin-bottom: 56px; scroll-margin-top: 90px; }
    .cat-section-header { margin-bottom: 20px; }
    .cat-section-title {
      font-family: 'Electrolize', sans-serif;
      font-size: 1.4rem; font-weight: 700;
      letter-spacing: -0.02em;
      color: var(--text-primary); margin-bottom: 12px;
    }
    .cat-section-hr {
      border: none; height: 1px;
      background: linear-gradient(90deg, rgba(59,130,246,0.40) 0%, rgba(255,255,255,0.06) 55%, transparent 100%);
    }

    /* ── FAQ Items ── */
    .gfaq-item {
      border: 1px solid rgba(255,255,255,0.07);
      border-radius: var(--radius-sm);
      margin-bottom: 6px;
      overflow: hidden; transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      background: rgba(255,255,255,0.025);
    }
    .gfaq-item:hover {
      border-color: rgba(59,130,246,0.20);
      background: rgba(255,255,255,0.035);
    }
    .gfaq-item.open {
      border-color: rgba(59,130,246,0.30);
      background: rgba(59,130,246,0.03);
      box-shadow: 0 4px 24px rgba(43,119,238,0.07);
    }
    .gfaq-btn {
      width: 100%; display: flex; align-items: center;
      gap: 12px; padding: 16px 20px;
      background: none; border: none;
      color: var(--text-primary); font-size: 0.93rem;
      font-weight: 500; font-family: inherit;
      text-align: left; cursor: pointer;
      transition: var(--transition); line-height: 1.55;
    }
    .gfaq-btn:hover { background: rgba(255,255,255,0.02); }
    .diff-dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; margin-top: 2px; }
    .gfaq-toggle {
      margin-left: auto; width: 22px; height: 22px;
      border-radius: 50%;
      background: rgba(59,130,246,0.12);
      border: 1px solid rgba(59,130,246,0.22);
      color: #60a5fa; font-size: 1.05rem; font-weight: 300;
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0; transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      line-height: 1; user-select: none;
    }
    .gfaq-item.open .gfaq-toggle {
      transform: rotate(45deg);
      background: rgba(59,130,246,0.22);
      border-color: rgba(59,130,246,0.42);
      color: #93c5fd;
    }
    .gfaq-answer { max-height: 0; overflow: hidden; transition: max-height 0.42s cubic-bezier(0.4, 0, 0.2, 1); }
    .gfaq-answer-inner {
      padding: 0 20px 20px 38px;
      color: var(--text-secondary);
      font-size: 0.9rem; line-height: 1.85;
    }
    .gfaq-answer-inner p { margin-bottom: 12px; }
    .gfaq-answer-inner p:last-child { margin-bottom: 0; }
    .gfaq-answer-inner strong { color: var(--text-primary); font-weight: 600; }
    .gfaq-answer-inner a {
      color: #60a5fa; text-decoration: none;
      border-bottom: 1px solid rgba(96,165,250,0.28);
      transition: border-color 0.15s;
    }
    .gfaq-answer-inner a:hover { border-color: #60a5fa; }
    .gfaq-answer-inner code {
      font-family: 'JetBrains Mono', 'Fira Code', monospace;
      font-size: 0.83em;
      background: rgba(59,130,246,0.10);
      border: 1px solid rgba(59,130,246,0.18);
      border-radius: 5px; padding: 2px 7px;
      color: #93c5fd;
    }
    .gfaq-answer-inner ul { padding-left: 20px; margin: 10px 0; }
    .gfaq-answer-inner li { margin-bottom: 6px; }

    /* ── No Results ── */
    .no-results {
      display: none; text-align: center;
      padding: 70px 20px; color: var(--text-muted);
    }
    .no-results.visible { display: block; }

    /* ── Back to Top ── */
    .back-to-top {
      position: fixed; bottom: 28px; left: 28px;
      z-index: 50; width: 44px; height: 44px;
      border-radius: 50%;
      background: rgba(0,10,24,0.90);
      border: 1px solid rgba(59,130,246,0.22);
      color: var(--text-muted);
      display: flex; align-items: center; justify-content: center;
      cursor: pointer; transition: var(--transition);
      opacity: 0; transform: translateY(10px);
      backdrop-filter: blur(16px);
      box-shadow: 0 4px 20px rgba(0,0,0,0.4);
    }
    .back-to-top.visible { opacity: 1; transform: translateY(0); }
    .back-to-top:hover {
      border-color: rgba(59,130,246,0.55);
      color: #60a5fa;
      background: rgba(59,130,246,0.12);
      box-shadow: 0 4px 20px rgba(43,119,238,0.18);
    }

    /* ── CTA Strip ── */
    .cta-strip {
      position: relative; overflow: hidden;
      background: linear-gradient(145deg, rgba(15,40,120,0.22) 0%, rgba(43,119,238,0.10) 50%, rgba(8,20,60,0.28) 100%);
      border: 1px solid rgba(59,130,246,0.18);
      border-radius: 24px; padding: 68px 40px;
      text-align: center;
    }
    .cta-strip::before {
      content: ''; position: absolute;
      top: 0; left: 50%; transform: translateX(-50%);
      width: 600px; height: 260px;
      background: radial-gradient(ellipse, rgba(43,119,238,0.16) 0%, transparent 70%);
      pointer-events: none;
    }
    .cta-strip::after {
      content: ''; position: absolute; inset: 0;
      background-image:
        linear-gradient(rgba(59,130,246,0.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(59,130,246,0.04) 1px, transparent 1px);
      background-size: 44px 44px;
      border-radius: 24px; pointer-events: none;
    }

    /* ── Responsive ── */
    @media (max-width: 768px) { .toc-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 520px) {
      .toc-grid { grid-template-columns: 1fr; }
      .gfaq-btn { padding: 13px 16px; font-size: 0.875rem; }
      .gfaq-answer-inner { padding: 0 16px 16px 16px; }
      .filter-pills { gap: 6px; }
      .filter-pill { padding: 7px 14px; font-size: 0.79rem; }
      .cat-section-title { font-size: 1.2rem; }
      .hero-stats { gap: 7px; }
      .hero-stat { padding: 6px 12px; font-size: 0.77rem; }
    }
    @media (max-width: 640px) { .back-to-top { bottom: 16px; left: 16px; } }
    @media print {
      .back-to-top { display: none !important; }
      .gfaq-answer { max-height: none !important; }
      body { background: white; color: #111; }
    }
  </style>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {"@type": "Question", "name": "How do I connect TradingView to Tradovate using PickMyTrade?", "acceptedAnswer": {"@type": "Answer", "text": "Create a PickMyTrade account, link your Tradovate login via OAuth, copy the webhook URL PickMyTrade gives you, and paste it into your TradingView alert's webhook field. Your alert message needs to be JSON formatted so PickMyTrade knows the symbol, side, and quantity. Full setup typically takes about 5 minutes and requires no coding."}},
      {"@type": "Question", "name": "Does PickMyTrade work with Tradovate natively?", "acceptedAnswer": {"@type": "Answer", "text": "Yes — Tradovate is one of PickMyTrade's core supported brokers alongside Rithmic, Interactive Brokers, TradeStation, and others. PickMyTrade costs $50/month flat with unlimited alerts, strategies, and connected accounts."}},
      {"@type": "Question", "name": "How fast is PickMyTrade execution to Tradovate?", "acceptedAnswer": {"@type": "Answer", "text": "PickMyTrade advertises sub-200ms execution from TradingView alert fire to Tradovate order placement under normal conditions. Actual speed varies with TradingView alert latency, your internet connection, and Tradovate API load during news events."}},
      {"@type": "Question", "name": "Do I need TradingView Premium to automate Tradovate via webhook?", "acceptedAnswer": {"@type": "Answer", "text": "You need at least TradingView's Essential (formerly Pro) plan because webhooks are not included in the free tier. Pro+ or Premium gives you more alerts and longer server-side alert expirations, which matters if you run many strategies."}},
      {"@type": "Question", "name": "Can I automate multiple Tradovate accounts with one TradingView alert?", "acceptedAnswer": {"@type": "Answer", "text": "Yes — PickMyTrade supports multi-account copying so one alert fires across every linked Tradovate account you list in the payload. This is the typical setup for traders running multiple prop firm evaluations or combines at once."}},
      {"@type": "Question", "name": "Does PickMyTrade support stop loss and take profit brackets on Tradovate?", "acceptedAnswer": {"@type": "Answer", "text": "Yes — you can include SL and TP values directly in the JSON payload or configure them as defaults inside PickMyTrade. Brackets are sent as OCO orders to Tradovate so the TP cancels when the SL fires and vice versa."}},
      {"@type": "Question", "name": "How does Tradovate's pricing work?", "acceptedAnswer": {"@type": "Answer", "text": "Tradovate offers three plans: a Free plan (no monthly fee but higher per-contract commissions), a Monthly plan (typically $99/month with lower commissions), and a Lifetime plan (one-time payment, commonly $1,499, with the lowest commissions). Check current Tradovate pricing because tier prices and commission rates change."}},
      {"@type": "Question", "name": "What are Tradovate's per-contract commission rates?", "acceptedAnswer": {"@type": "Answer", "text": "As of early 2026, commissions are roughly $1.29 per side on the Free plan, around $0.99 per side on the Monthly plan, and around $0.59 per side on the Lifetime plan for standard contracts, with lower rates on micros. Exchange, NFA, and clearing fees stack on top of these."}},
      {"@type": "Question", "name": "Which prop firms use Tradovate?", "acceptedAnswer": {"@type": "Answer", "text": "Prop firms that clear through Tradovate include Apex Trader Funding, Take Profit Trader, My Funded Futures, Elite Trader Funding, TradeDay, Earn2Trade, Tradeify, Bulenox, and FundedNext Futures. Topstep historically used Tradovate but migrated to its own TopstepX platform."}},
      {"@type": "Question", "name": "Is Tradovate regulated?", "acceptedAnswer": {"@type": "Answer", "text": "Yes — Tradovate LLC is a registered Futures Commission Merchant (FCM) with the CFTC and a member of the NFA. Customer futures funds are held in segregated accounts per CFTC Regulation 1.20."}},
      {"@type": "Question", "name": "Who owns Tradovate?", "acceptedAnswer": {"@type": "Answer", "text": "NinjaTrader acquired Tradovate in January 2022 for $115M. NinjaTrader itself is a portfolio company of Long Ridge Equity Partners. Tradovate's founder Rick Tomsic joined NinjaTrader's executive team."}},
      {"@type": "Question", "name": "Why is my Tradovate order being rejected?", "acceptedAnswer": {"@type": "Answer", "text": "Common rejection reasons: insufficient margin, exceeded max position / daily loss limit, 'No quote available' due to missing data subscription, the contract being in a restricted state (expiring, post-market), or prop firm risk rules blocking it. Tradovate's Orders module shows the exact rejection text per order."}}
    ]
  }
