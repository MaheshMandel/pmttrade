---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FaqItem from "../../components/FaqItem.astro";
import { getLocalePaths, useTranslations, localizedPath } from "../../i18n/utils";
import { DEFAULT_LOCALE, type Locale } from "../../i18n/config";

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
// Default locale (en) is served with no prefix — matches localizedPath()'s routing so
// these links point straight at the canonical URL instead of through the /en/* redirect.
const localePrefix = locale === DEFAULT_LOCALE ? "" : `/${locale}`;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [1, 2, 3, 4, 5, 6, 7, 8].map((n) => ({
    "@type": "Question",
    "name": t(`supported_propfirms.faq_${n}_q` as any),
    "acceptedAnswer": { "@type": "Answer", "text": t(`supported_propfirms.faq_${n}_a` as any) },
  })),
};

const SITE_URL = "https://pickmytrade.trade";
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE_URL}${withSlash(localizedPath(locale))}` },
    { "@type": "ListItem", "position": 2, "name": "Supported Prop Firms", "item": `${SITE_URL}${withSlash(localizedPath(locale, "supported-propfirms"))}` },
  ],
};

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Prop firms that use Tradovate, Rithmic or ProjectX (supported by PickMyTrade)",
  "itemListOrder": "https://schema.org/ItemListUnordered",
  "numberOfItems": 7,
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Apex Trader Funding" },
    { "@type": "ListItem", "position": 2, "name": "Take Profit Trader" },
    { "@type": "ListItem", "position": 3, "name": "MyFundedFutures" },
    { "@type": "ListItem", "position": 4, "name": "TradeDay" },
    { "@type": "ListItem", "position": 5, "name": "Bulenox" },
    { "@type": "ListItem", "position": 6, "name": "Tradeify" },
    { "@type": "ListItem", "position": 7, "name": "FundedNext Futures" },
  ],
};
---

<BaseLayout
  locale={locale}
  title={t("supported_propfirms.meta_title")}
  description={t("supported_propfirms.meta_description")}
  ldJson={[faqSchema, breadcrumbSchema, itemListSchema]}
>
  <style>
    :global(body) { background-color: #001429; }
    .custom-scrollbar::-webkit-scrollbar { width: 8px; height: 8px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: rgba(255,255,255,0.05); border-radius: 4px; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(43,119,238,0.5); border-radius: 4px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: rgba(43,119,238,0.8); }
  </style>

  <div class="electrolize-regular text-white bg-[#001429]">
    <!-- Hero Section -->
    <section class="pt-8 pb-16 px-4 sm:px-6 lg:px-8 text-center relative overflow-hidden">
      <div class="absolute inset-0 opacity-10">
        <div class="absolute top-20 left-1/4 w-96 h-96 bg-blue-500 rounded-full blur-3xl"></div>
        <div class="absolute bottom-20 right-1/4 w-96 h-96 bg-purple-500 rounded-full blur-3xl"></div>
      </div>

      <div class="relative z-10 max-w-7xl mx-auto">
        <div class="inline-block bg-blue-500/15 border border-blue-500/30 px-6 py-2 rounded-full text-xs tracking-widest font-semibold text-blue-400 mb-6 electrolize-regular" data-aos="fade-down">
          {t("supported_propfirms.hero_badge")}
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold mb-6" data-aos="fade-up">
          {t("supported_propfirms.hero_h1_pre")}<span class="bg-gradient-to-r from-blue-400 to-purple-400 bg-clip-text text-transparent">{t("supported_propfirms.hero_h1_gradient")}</span>
        </h1>
        <p class="text-lg sm:text-xl text-gray-300 max-w-3xl mx-auto leading-relaxed mb-8" data-aos="fade-up" data-aos-delay="100">
          {t("supported_propfirms.hero_subtitle_pre")}
          <strong class="text-orange-400">{t("supported_propfirms.hero_pmt_automation")}</strong> {t("supported_propfirms.hero_automation_desc")}
          <strong class="text-blue-400">{t("supported_propfirms.hero_pmt_copier")}</strong> {t("supported_propfirms.hero_copier_desc")}
        </p>

        <div class="flex flex-wrap justify-center gap-4" data-aos="fade-up" data-aos-delay="200">
          <a href="https://app.pickmytrade.trade/?register=true"
             class="px-8 py-4 bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 rounded-xl font-bold text-lg shadow-lg shadow-blue-600/20 transition-all hover:-translate-y-1">
            {t("supported_propfirms.hero_cta")}
          </a>
        </div>
      </div>
    </section>

    <!-- Prop Firms Comparison Table -->
    <section class="py-16 px-4 sm:px-6 lg:px-8 max-w-[1400px] mx-auto">
      <div class="text-center mb-12" data-aos="fade-up">
        <div class="inline-flex items-center gap-2 mb-4 bg-gradient-to-r from-[#0F3EC3]/20 to-[#2B77EE]/20 backdrop-blur-sm border border-[#2B77EE]/30 rounded-full px-4 py-2">
          <i class="fa-solid fa-building text-[#2B77EE]" aria-hidden="true"></i>
          <span class="text-xs sm:text-sm font-semibold text-[#7FB8F9] uppercase tracking-wider electrolize-regular">{t("supported_propfirms.table_badge")}</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold mb-3 text-white">{t("supported_propfirms.table_h2")}</h2>
        <p class="text-gray-400 text-sm sm:text-base max-w-3xl mx-auto">
          {t("supported_propfirms.table_subtitle")}
        </p>
      </div>

      <div class="bg-gradient-to-br from-[#122B75]/40 via-[#0F3EC3]/20 to-[#122B75]/40 backdrop-blur-sm border border-[#2B77EE]/50 rounded-2xl overflow-hidden" data-aos="fade-up" data-aos-delay="100">
        <!-- Desktop Table -->
        <div class="hidden lg:block overflow-x-auto custom-scrollbar">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-gradient-to-r from-[#0F3EC3]/30 to-[#2B77EE]/30 border-b border-[#2B77EE]/50">
                <th class="px-6 py-4 text-left text-xs font-bold text-[#7FB8F9] uppercase tracking-wider electrolize-regular">
                  <i class="fa-solid fa-building mr-2" aria-hidden="true"></i>{t("supported_propfirms.table_col_firm")}
                </th>
                <th class="px-4 py-4 text-center text-xs font-bold text-[#7FB8F9] uppercase tracking-wider electrolize-regular">
                  <i class="fa-solid fa-server mr-2" aria-hidden="true"></i>{t("supported_propfirms.table_col_platform")}
                </th>
                <th class="px-4 py-4 text-center text-xs font-bold text-[#7FB8F9] uppercase tracking-wider electrolize-regular">
                  <i class="fa-solid fa-user-tag mr-2" aria-hidden="true"></i>{t("supported_propfirms.table_col_types")}
                </th>
                <th class="px-4 py-4 text-center text-xs font-bold text-[#7FB8F9] uppercase tracking-wider electrolize-regular">
                  <i class="fa-solid fa-info-circle mr-2" aria-hidden="true"></i>{t("supported_propfirms.table_col_details")}
                </th>
                <th class="px-4 py-4 text-center text-xs font-bold text-[#7FB8F9] uppercase tracking-wider electrolize-regular">
                  <i class="fa-solid fa-check-circle mr-2" aria-hidden="true"></i>{t("supported_propfirms.table_col_status")}
                </th>
                <th class="px-6 py-4 text-center text-xs font-bold text-[#7FB8F9] uppercase tracking-wider electrolize-regular">
                  <i class="fa-solid fa-cogs mr-2" aria-hidden="true"></i>{t("supported_propfirms.table_col_actions")}
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#2B77EE]/20" id="propfirms-table">
              <!-- Rows will be dynamically generated -->
            </tbody>
          </table>
        </div>

        <!-- Mobile Cards -->
        <div class="lg:hidden divide-y divide-[#2B77EE]/20" id="propfirms-mobile">
          <!-- Cards will be dynamically generated -->
        </div>
      </div>

      <p class="text-center text-sm text-gray-400 mt-4 italic">
        <strong class="text-gray-300">{t("supported_propfirms.table_important_label")}</strong> {t("supported_propfirms.table_important_text")}
      </p>
    </section>

    <!-- Features Section -->
    <section class="py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
      <h2 class="text-3xl font-bold text-center mb-12" data-aos="fade-up">{t("supported_propfirms.features_h2")}</h2>

      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-white/5 rounded-2xl p-6 border border-white/10 hover:border-blue-500/50 transition-all" data-aos="fade-up" data-aos-delay="0">
          <div class="w-12 h-12 bg-blue-500/20 rounded-xl flex items-center justify-center text-blue-400 text-xl mb-4">
            <i class="fa-solid fa-bolt" aria-hidden="true"></i>
          </div>
          <h3 class="text-xl font-bold mb-2">{t("supported_propfirms.feat_1_title")}</h3>
          <p class="text-gray-400 text-sm">{t("supported_propfirms.feat_1_text")}</p>
        </div>

        <div class="bg-white/5 rounded-2xl p-6 border border-white/10 hover:border-purple-500/50 transition-all" data-aos="fade-up" data-aos-delay="100">
          <div class="w-12 h-12 bg-purple-500/20 rounded-xl flex items-center justify-center text-purple-400 text-xl mb-4">
            <i class="fa-solid fa-copy" aria-hidden="true"></i>
          </div>
          <h3 class="text-xl font-bold mb-2">{t("supported_propfirms.feat_2_title")}</h3>
          <p class="text-gray-400 text-sm">{t("supported_propfirms.feat_2_text")}</p>
        </div>

        <div class="bg-white/5 rounded-2xl p-6 border border-white/10 hover:border-green-500/50 transition-all" data-aos="fade-up" data-aos-delay="200">
          <div class="w-12 h-12 bg-green-500/20 rounded-xl flex items-center justify-center text-green-400 text-xl mb-4">
            <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
          </div>
          <h3 class="text-xl font-bold mb-2">{t("supported_propfirms.feat_3_title")}</h3>
          <p class="text-gray-400 text-sm">{t("supported_propfirms.feat_3_text")}</p>
        </div>
      </div>
    </section>

    <!-- Prop Firms That Use Rithmic Section -->
    <section class="py-16 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold text-white mb-5">{t("supported_propfirms.rithmic_h2")}</h2>
      <p class="text-gray-300 leading-relaxed mb-4">{t("supported_propfirms.rithmic_p1")}</p>
      <p class="text-gray-300 leading-relaxed">
        {t("supported_propfirms.rithmic_p2_pre")} <a href="https://pickmytrade.io/broker/tradingview-to-rithmic/" class="text-blue-400 hover:text-blue-300 underline">{t("supported_propfirms.rithmic_p2_link_text")}</a>{t("supported_propfirms.rithmic_p2_post")}
      </p>
    </section>

    <!-- Prop Firms That Use ProjectX / TopstepX Section -->
    <section class="py-16 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto bg-[#002040]">
      <h2 class="text-2xl sm:text-3xl font-bold text-white mb-5">{t("supported_propfirms.projectx_h2")}</h2>
      <p class="text-gray-300 leading-relaxed mb-4">{t("supported_propfirms.projectx_p1")}</p>
      <p class="text-gray-300 leading-relaxed">{t("supported_propfirms.projectx_p2")}</p>
    </section>

    <!-- FAQ Section -->
    <section class="py-16 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto">
      <h2 class="text-3xl font-bold text-center mb-12" data-aos="fade-up">{t("supported_propfirms.faq_h2")}</h2>
      <div class="space-y-4">
        {[1, 2, 3, 4, 5, 6, 7, 8].map((n) => (
          <FaqItem question={t(`supported_propfirms.faq_${n}_q` as any)}>
            <p>{t(`supported_propfirms.faq_${n}_a` as any)}</p>
          </FaqItem>
        ))}
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-16 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto text-center">
      <div class="bg-gradient-to-r from-blue-600/20 to-purple-600/20 rounded-3xl p-12 border border-blue-500/30" data-aos="fade-up">
        <h2 class="text-3xl font-bold mb-4">{t("supported_propfirms.cta_h2")}</h2>
        <p class="text-gray-300 mb-8 max-w-2xl mx-auto">
          {t("supported_propfirms.cta_text")}
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <a href={localizedPath(locale, "pages/contact-us")} class="px-8 py-3 bg-white/10 hover:bg-white/20 border border-white/20 rounded-xl font-semibold transition-all">
            {t("supported_propfirms.cta_btn_request")}
          </a>
          <a href="https://app.pickmytrade.trade/?register=true" class="px-8 py-3 bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 rounded-xl font-semibold shadow-lg shadow-blue-600/20 transition-all">
            {t("supported_propfirms.cta_btn_trial")}
          </a>
        </div>
      </div>
    </section>
  </div>

  <!-- AOS Library -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>

  <script define:vars={{ localePrefix, supported: t("supported_propfirms.table_status_supported"), labelTypes: t("supported_propfirms.table_label_types"), labelDetails: t("supported_propfirms.table_label_details"), btnAutomation: t("supported_propfirms.table_btn_automation"), btnCopier: t("supported_propfirms.table_btn_copier") }}>
    if (typeof AOS !== 'undefined') AOS.init({ once: true, duration: 600 });

    // Prop Firms Data with logos for Tradovate (Only firms with actual pages)
    const propFirms = [
      { name: "Apex Trader Funding", slug: "apex-trader-funding", logo: "/assets/propfirmlogos/apex-logo-stack-light.png", platform: "Rithmic, Tradovate", accountTypes: "Evaluation, Funded, PA", details: "Multiple account sizes available" },
      { name: "Blue Guardian Futures", slug: "blue-guardian-futures", logo: "/assets/propfirmlogos/Blue_Guardian_Futures.png", platform: "Tradovate", accountTypes: "Evaluation, Funded", details: "Trusted prop firm" },
      { name: "FundedNext Futures", slug: "fundednext-futures", logo: "/assets/propfirmlogos/fundednext.png", platform: "Rithmic, Tradovate", accountTypes: "Evaluation, Funded", details: "Fast evaluation process" },
      { name: "My Funded Futures", slug: "my-funded-futures", logo: "/assets/propfirmlogos/myfundedfutures.png", platform: "Rithmic, Tradovate", accountTypes: "Evaluation, Funded", details: "Large account sizes available" },
      { name: "Take Profit Trader", slug: "take-profit-trader", logo: "/assets/propfirmlogos/takeprofittrader.svg", platform: "Rithmic, Tradovate", accountTypes: "Evaluation, Funded", details: "Trader-friendly rules" },
      { name: "Top One Futures", slug: "top-one-futures", logo: "/assets/propfirmlogos/Top_One_Futures.png", platform: "Tradovate", accountTypes: "Evaluation, Funded", details: "Competitive profit targets" },
      { name: "Tradeify", slug: "tradeify", logo: "/assets/propfirmlogos/tradeify.png", platform: "Rithmic, Tradovate", accountTypes: "Evaluation, Funded", details: "Modern trading platform" },
      { name: "TradeDay", slug: "tradeday", logo: "/assets/propfirmlogos/tradeday.png", platform: "Tradovate", accountTypes: "Evaluation, Funded", details: "Futures prop firm on Tradovate" }
    ];

    // Generate Desktop Table
    const tableBody = document.getElementById('propfirms-table');
    propFirms.forEach(firm => {
      const row = document.createElement('tr');
      row.className = 'hover:bg-[#0F3EC3]/10 transition-colors';
      row.innerHTML = `
        <td class="px-6 py-4 whitespace-nowrap">
          <div class="flex items-center gap-3">
            <img src="${firm.logo}" alt="${firm.name}" class="w-10 h-10 rounded-lg object-contain bg-white/10 p-1" width="40" height="40" loading="lazy" onerror="this.src='/assets/logo.png'">
            <span class="font-semibold text-white">${firm.name}</span>
          </div>
        </td>
        <td class="px-4 py-4 text-center text-gray-300">${firm.platform}</td>
        <td class="px-4 py-4 text-center text-gray-300">${firm.accountTypes}</td>
        <td class="px-4 py-4 text-center text-gray-300 text-sm">${firm.details}</td>
        <td class="px-4 py-4 text-center">
          <span class="px-3 py-1 bg-green-600/20 text-green-400 rounded-full text-xs font-semibold border border-green-500/30">
            ${supported}
          </span>
        </td>
        <td class="px-6 py-4 text-center">
          <div class="flex items-center justify-center gap-2">
            <a href="${localePrefix}/automation/tradovate-to-${firm.slug}-automation"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-orange-500/20 border border-orange-500/50 rounded-lg text-orange-400 text-xs font-semibold hover:bg-orange-500/30 transition-all" title="${btnAutomation}">
              <i class="fa-solid fa-robot"></i>
            </a>
            <a href="${localePrefix}/copier/tradovate-to-${firm.slug}-copier"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-blue-500/20 border border-blue-500/50 rounded-lg text-blue-400 text-xs font-semibold hover:bg-blue-500/30 transition-all" title="${btnCopier}">
              <i class="fa-solid fa-copy"></i>
            </a>
          </div>
        </td>
      `;
      tableBody.appendChild(row);
    });

    // Generate Mobile Cards
    const mobileContainer = document.getElementById('propfirms-mobile');
    propFirms.forEach(firm => {
      const card = document.createElement('div');
      card.className = 'p-4 hover:bg-white/5 transition-colors';
      card.innerHTML = `
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-3">
            <img src="${firm.logo}" alt="${firm.name}" class="w-10 h-10 rounded-lg object-contain bg-white/10 p-1" width="40" height="40" loading="lazy" onerror="this.src='/assets/logo.png'">
            <div>
              <span class="font-semibold block">${firm.name}</span>
              <div class="text-gray-400 text-xs">${firm.platform}</div>
            </div>
          </div>
          <span class="px-2 py-1 bg-green-600/20 text-green-400 rounded-full text-xs font-semibold border border-green-500/30">
            ${supported}
          </span>
        </div>
        <div class="grid grid-cols-2 gap-2 text-xs text-gray-400 mb-3">
          <div><span class="text-gray-500">${labelTypes}</span> ${firm.accountTypes}</div>
          <div><span class="text-gray-500">${labelDetails}</span> ${firm.details}</div>
        </div>
        <div class="flex gap-2">
          <a href="${localePrefix}/automation/tradovate-to-${firm.slug}-automation"
             class="flex-1 inline-flex items-center justify-center gap-2 px-3 py-2 bg-orange-500/20 border border-orange-500/50 rounded-lg text-orange-400 text-xs font-semibold">
            <i class="fa-solid fa-robot"></i> ${btnAutomation}
          </a>
          <a href="${localePrefix}/copier/tradovate-to-${firm.slug}-copier"
             class="flex-1 inline-flex items-center justify-center gap-2 px-3 py-2 bg-blue-500/20 border border-blue-500/50 rounded-lg text-blue-400 text-xs font-semibold">
            <i class="fa-solid fa-copy"></i> ${btnCopier}
          </a>
        </div>
      `;
      mobileContainer.appendChild(card);
    });
  </script>
</BaseLayout>
