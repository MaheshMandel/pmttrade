---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getLocalePaths, useTranslations, localizedPath } from '../../../i18n/utils';
import type { Locale } from '../../../i18n/config';
import { LOCALE_BCP47 } from '../../../i18n/config';

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
const lastUpdated = new Intl.DateTimeFormat(LOCALE_BCP47[locale], {
  month: 'long',
  year: 'numeric',
}).format(new Date());

const SITE_URL = 'https://pickmytrade.trade';
const withSlash = (p: string) => (p.endsWith('/') ? p : `${p}/`);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': `${SITE_URL}${withSlash(localizedPath(locale))}` },
    { '@type': 'ListItem', 'position': 2, 'name': 'Privacy Policy', 'item': `${SITE_URL}${withSlash(localizedPath(locale, 'legal/privacy'))}` },
  ],
};
---

<BaseLayout
  locale={locale}
  title={t('privacy.meta_title')}
  description={t('privacy.meta_description')}
  ldJson={[breadcrumbSchema]}>
  <div
    class='bg-gradient-to-b from-gray-900 via-gray-900 to-black text-white min-h-screen'>
    <div class='max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16'>
      <!-- Header -->
      <div class='text-center mb-12'>
        <h1
          class='text-3xl md:text-4xl lg:text-5xl font-bold mb-4'
          style='background: linear-gradient(to right, #0055FE, #4A90E2); -webkit-background-clip: text; -webkit-text-fill-color: transparent;'>
          {t('privacy.title')}
        </h1>
        <p class='text-gray-400 text-base md:text-lg'>
          {t('privacy.last_updated')}
          {lastUpdated}
        </p>
      </div>

      <!-- Content Container -->
      <div class='space-y-8 text-gray-300 leading-relaxed'>
        <div class='bg-blue-900/20 border border-blue-600/30 rounded-lg p-4'>
          <p class='font-semibold text-blue-400 mb-2'>
            {t('privacy.notice_title')}
          </p>
          <p class='text-sm'>
            {t('privacy.notice_text')}
          </p>
        </div>

        <!-- Introduction -->
        <section>
          <h2 class='text-xl md:text-2xl font-bold text-white mb-3 md:mb-4'>
            {t('privacy.section_intro_title')}
          </h2>
          <p class='mb-4'>
            {t('privacy.section_intro_p1')}
          </p>
          <p class='mb-4'>
            {t('privacy.section_intro_p2')}
          </p>
        </section>

        <!-- When does this Policy apply -->
        <section>
          <h2 class='text-xl md:text-2xl font-bold text-white mb-3 md:mb-4'>
            {t('privacy.section_when_title')}
          </h2>
          <p>
            {t('privacy.section_when_p1')}
