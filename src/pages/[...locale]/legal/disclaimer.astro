---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getLocalePaths, useTranslations, localizedPath } from '../../../i18n/utils';
import type { Locale } from '../../../i18n/config';
import { LOCALE_BCP47 } from '../../../i18n/config';

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
const lastUpdated = new Intl.DateTimeFormat(LOCALE_BCP47[locale], {
  month: 'long',
  year: 'numeric',
}).format(new Date());

const SITE_URL = 'https://pickmytrade.trade';
const withSlash = (p: string) => (p.endsWith('/') ? p : `${p}/`);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': `${SITE_URL}${withSlash(localizedPath(locale))}` },
    { '@type': 'ListItem', 'position': 2, 'name': 'Disclaimer', 'item': `${SITE_URL}${withSlash(localizedPath(locale, 'legal/disclaimer'))}` },
  ],
};
---

<BaseLayout
  locale={locale}
  title={t('disclaimer.meta_title')}
  description={t('disclaimer.meta_description')}
  ldJson={[breadcrumbSchema]}>
  <div
    class='bg-gradient-to-b from-gray-900 via-gray-900 to-black text-white min-h-screen'>
    <div class='max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16'>
      <!-- Header -->
      <div class='text-center mb-12'>
        <h1
          class='text-3xl md:text-4xl lg:text-5xl font-bold mb-4'
          style='background: linear-gradient(to right, #0055FE, #4A90E2); -webkit-background-clip: text; -webkit-text-fill-color: transparent;'>
          {t('disclaimer.title')}
        </h1>
        <p class='text-gray-400 text-base md:text-lg'>
          {t('disclaimer.last_updated')}
          {lastUpdated}
        </p>
      </div>

      <!-- Content Container -->
      <div class='space-y-8 text-gray-300 leading-relaxed'>
        <!-- Platform Overview -->
        <section>
          <h2 class='text-xl md:text-2xl font-bold text-white mb-3 md:mb-4'>
            {t('disclaimer.section_platform_title')}
          </h2>
          <p>
            {t('disclaimer.section_platform_p1')}
          </p>
        </section>

        <!-- Risk Disclosure -->
        <section>
          <h2 class='text-xl md:text-2xl font-bold text-white mb-3 md:mb-4'>
            {t('disclaimer.section_risk_title')}
          </h2>
          <p class='mb-4'>
            {t('disclaimer.section_risk_p1')}
          </p>
          <p class='mb-4'>
            <strong>{t('disclaimer.section_risk_responsible_intro')}</strong>
          </p>
          <ul class='list-disc list-inside space-y-2 mb-4 pl-4'>
            <li>{t('disclaimer.section_risk_li1')}</li>
            <li>{t('disclaimer.section_risk_li2')}</li>
            <li>{t('disclaimer.section_risk_li3')}</li>
            <li>{t('disclaimer.section_risk_li4')}</li>
            <li>{t('disclaimer.section_risk_li5')}</li>
          </ul>
          <p class='font-semibold text-yellow-400'>
            {t('disclaimer.section_risk_warning')}
          </p>
        </section>

        <!-- No Financial Advice -->
        <section>
          <h2 class='text-xl md:text-2xl font-bold text-white mb-3 md:mb-4'>
            {t('disclaimer.section_no_advice_title')}
          </h2>
          <p class='mb-4'>
            {t('disclaimer.section_no_advice_p1')}
          </p>
          <p>
            {t('disclaimer.section_no_advice_p2')}
          </p>
        </section>

        <!-- Service Provided "As-Is" -->
        <section>
          <h2 class='text-xl md:text-2xl font-bold text-white mb-3 md:mb-4'>
            {t('disclaimer.section_asis_title')}
          </h2>
          <p>
            {t('disclaimer.section_asis_p1')}
          </p>
        </section>

        <!-- Hypothetical Performance -->
        <section>
          <h2 class='text-xl md:text-2xl font-bold text-white mb-3 md:mb-4'>
            {t('disclaimer.section_hypothetical_title')}
          </h2>
          <p>
            {t('disclaimer.section_hypothetical_p1')}
          </p>
        </section>

        <!-- Testimonials -->
        <section>
          <h2 class='text-xl md:text-2xl font-bold text-white mb-3 md:mb-4'>
            {t('disclaimer.section_testimonial_title')}
          </h2>
          <p>
            {t('disclaimer.section_testimonial_p1')}
          </p>
        </section>

        <!-- Third-Party & Prop Firm Disclaimer -->
        <section>
          <h2 class='text-xl md:text-2xl font-bold text-white mb-3 md:mb-4'>
            {t('disclaimer.section_third_party_title')}
          </h2>
          <p>
            {t('disclaimer.section_third_party_p1')}
          </p>
        </section>

        <!-- Limitation of Liability -->
        <section>
          <h2 class='text-xl md:text-2xl font-bold text-white mb-3 md:mb-4'>
            {t('disclaimer.section_liability_title')}
          </h2>
          <p class='mb-4'>
            {t('disclaimer.section_liability_p1')}
          </p>
          <ul class='list-disc list-inside space-y-2 pl-4'>
            <li>{t('disclaimer.section_liability_li1')}</li>
            <li>{t('disclaimer.section_liability_li2')}</li>
            <li>{t('disclaimer.section_liability_li3')}</li>
            <li>{t('disclaimer.section_liability_li4')}</li>
            <li>{t('disclaimer.section_liability_li5')}</li>
            <li>{t('disclaimer.section_liability_li6')}</li>
            <li>{t('disclaimer.section_liability_li7')}</li>
          </ul>
        </section>

        <!-- Agreement Confirmation -->
        <section>
          <h2 class='text-xl md:text-2xl font-bold text-white mb-3 md:mb-4'>
            {t('disclaimer.section_agreement_title')}
          </h2>
          <p class='mb-4'>
            {t('disclaimer.section_agreement_p1')}
          </p>
          <p>
            {t('disclaimer.section_agreement_p2_pre')}<a
              href={localizedPath(locale, 'legal/terms-and-conditions')}
              class='text-blue-400 hover:text-blue-300 underline transition-colors'
              >{t('disclaimer.section_agreement_link_terms')}</a
            >{t('disclaimer.section_agreement_p2_mid')}<a
              href={localizedPath(locale, 'legal/privacy')}
              class='text-blue-400 hover:text-blue-300 underline transition-colors'
              >{t('disclaimer.section_agreement_link_privacy')}</a
            >{t('disclaimer.section_agreement_p2_post')}
          </p>
        </section>

        <!-- Contact -->
        <section class='text-center'>
          <p class='text-gray-400 mb-3'>
            {t('disclaimer.section_contact_p1')}
          </p>
          <p>
            <a
              href='mailto:support@pickmytrade.com'
              class='text-blue-400 hover:text-blue-300 transition-colors font-medium'
              >support@pickmytrade.com</a
            >
          </p>
        </section>
      </div>

      <!-- Back Link -->
      <div class='text-center mt-12 pt-8 border-t border-gray-800'>
        <a
          href='/'
          class='inline-flex items-center gap-2 text-blue-400 hover:text-blue-300 transition-colors font-medium'>
          <span>{t('disclaimer.back_link')}</span>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
