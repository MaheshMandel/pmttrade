---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getLocalePaths, useTranslations, localizedPath } from '../../../i18n/utils';
import type { Locale } from '../../../i18n/config';
import { LOCALE_BCP47 } from '../../../i18n/config';

export const getStaticPaths = getLocalePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
const lastUpdated = new Intl.DateTimeFormat(LOCALE_BCP47[locale], {
  month: 'long',
  year: 'numeric',
}).format(new Date());

const SITE_URL = 'https://pickmytrade.trade';
const withSlash = (p: string) => (p.endsWith('/') ? p : `${p}/`);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': `${SITE_URL}${withSlash(localizedPath(locale))}` },
    { '@type': 'ListItem', 'position': 2, 'name': 'Terms and Conditions', 'item': `${SITE_URL}${withSlash(localizedPath(locale, 'legal/terms-and-conditions'))}` },
  ],
};
---

<BaseLayout
  locale={locale}
  title={t('terms.meta_title')}
  description={t('terms.meta_description')}
  ldJson={[breadcrumbSchema]}>
  <div
    class='bg-gradient-to-b from-gray-900 via-gray-900 to-black text-white min-h-screen'>
    <div class='max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16'>
      <!-- Header -->
      <div class='text-center mb-12'>
        <h1
          class='text-3xl md:text-4xl lg:text-5xl font-bold mb-4'
          style='background: linear-gradient(to right, #0055FE, #4A90E2); -webkit-background-clip: text; -webkit-text-fill-color: transparent;'>
          {t('terms.title')}
        </h1>
        <p class='text-gray-400 text-base md:text-lg'>
          {t('terms.last_updated')}
          {lastUpdated}
        </p>
      </div>

      <!-- Content Container -->
      <div class='space-y-8 text-gray-300 leading-relaxed'>
        <div class='text-center italic text-gray-400 mb-6'>
          <p>{t('terms.welcome_text')}</p>
        </div>

        <div
          class='bg-yellow-900/20 border border-yellow-600/30 rounded-lg p-4 my-6'>
          <p class='font-semibold text-yellow-400 mb-3'>
            {t('terms.important_notice_title')}
          </p>
          <p class='mb-3'>
            <strong>{t('terms.important_notice_p1')}</strong>
          </p>
          <p class='text-sm'>
            {t('terms.important_notice_p2_pre')}<a
              href='mailto:support@pickmytrade.com'
              class='text-blue-400 hover:text-blue-300 underline'
              >support@pickmytrade.com</a
            >{t('terms.important_notice_p2_post')}
          </p>
        </div>

        <!-- Definitions -->
        <section>
          <h2 class='text-xl md:text-2xl font-bold text-white mb-3 md:mb-4'>
            {t('terms.section_1_title')}
          </h2>
          <ul class='space-y-3 pl-4'>
            <li>
              <strong class='text-white'>Affiliate:</strong>
              {t('terms.section_1_affiliate').replace('Affiliate: ', '')}
            </li>
            <li>
              <strong class='text-white'>Documentation:</strong>
              {
                t('terms.section_1_documentation').replace(
                  'Documentation: ',
                  '',
                )
              }
            </li>
            <li>
              <strong class='text-white'>Loss:</strong>
              {t('terms.section_1_loss').replace('Loss: ', '')}
            </li>
            <li>
              <strong class='text-white'>Platform:</strong>
              {t('terms.section_1_platform').replace('Platform: ', '')}
            </li>
            <li>
              <strong class='text-white'>User Data:</strong>
              {t('terms.section_1_user_data').replace('User Data: ', '')}
            </li>
          </ul>
        </section>

        <!-- General Disclaimers -->
        <section>
          <h2 class='text-xl md:text-2xl font-bold text-white mb-3 md:mb-4'>
            {t('terms.section_2_title')}
          </h2>
          <p class='font-semibold text-yellow-400'>
            {t('terms.section_2_p1')}
          </p>
        </section>

        <!-- General Terms -->
        <section>
          <h2 class='text-xl md:text-2xl font-bold text-white mb-3 md:mb-4'>
            {t('terms.section_3_title')}
          </h2>
          <p>{t('terms.section_3_p1')}</p>
        </section>

        <!-- Description of Services -->
        <section>
          <h2 class='text-xl md:text-2xl font-bold text-white mb-3 md:mb-4'>
            {t('terms.section_4_title')}
          </h2>
          <p>{t('terms.section_4_p1')}</p>
        </section>

        <!-- User Responsibilities -->
        <section>
          <h2 class='text-xl md:text-2xl font-bold text-white mb-3 md:mb-4'>
            {t('terms.section_5_title')}
          </h2>
          <p class='mb-3'>
            <strong class='text-white'>{t('terms.section_5_label')}</strong>
            {
              t('terms.section_5_p1').replace(
                t('terms.section_5_label') + ' ',
                '',
              )
            }
          </p>
        </section>

        <!-- License to Use -->
        <section>
          <h2 class='text-xl md:text-2xl font-bold text-white mb-3 md:mb-4'>
            {t('terms.section_6_title')}
          </h2>
          <p class='mb-3'>{t('terms.section_6_p1')}</p>
          <p class='mb-2'>
            <strong class='text-white'
              >{t('terms.section_6_prohibited_label')}</strong>
          </p>
          <ul class='list-disc list-inside space-y-2 pl-4'>
            <li>{t('terms.section_6_prohibited_1')}</li>
            <li>{t('terms.section_6_prohibited_2')}</li>
            <li>{t('terms.section_6_prohibited_3')}</li>
            <li>{t('terms.section_6_prohibited_4')}</li>
            <li>{t('terms.section_6_prohibited_5')}</li>
          </ul>
        </section>

        <!-- Content and Proprietary Rights -->
        <section>
          <h2 class='text-xl md:text-2xl font-bold text-white mb-3 md:mb-4'>
            {t('terms.section_7_title')}
          </h2>
          <p class='mb-3'>{t('terms.section_7_p1')}</p>
          <p>{t('terms.section_7_p2')}</p>
        </section>

        <!-- Payment and Cancellation -->
        <section>
          <h2 class='text-xl md:text-2xl font-bold text-white mb-3 md:mb-4'>
            {t('terms.section_8_title')}
          </h2>

          <h3 class='text-lg font-semibold text-white mb-2 mt-4'>
            {t('terms.section_8_pricing_title')}
          </h3>
          <p class='mb-3'>{t('terms.section_8_pricing_p1')}</p>

          <h3 class='text-lg font-semibold text-white mb-2 mt-4'>
            {t('terms.section_8_taxes_title')}
          </h3>
          <p class='mb-3'>{t('terms.section_8_taxes_p1')}</p>

          <h3 class='text-lg font-semibold text-white mb-2 mt-4'>
            {t('terms.section_8_billing_title')}
          </h3>
          <p class='mb-3'>{t('terms.section_8_billing_p1')}</p>

          <h3 class='text-lg font-semibold text-white mb-2 mt-4'>
            {t('terms.section_8_processor_title')}
          </h3>
          <p class='mb-3'>{t('terms.section_8_processor_p1')}</p>

          <h3 class='text-lg font-semibold text-white mb-2 mt-4'>
            {t('terms.section_8_cancel_title')}
          </h3>
          <p>{t('terms.section_8_cancel_p1')}</p>
        </section>

        <!-- User Obligations -->
        <section>
          <h2 class='text-xl md:text-2xl font-bold text-white mb-3 md:mb-4'>
            {t('terms.section_9_title')}
          </h2>

          <h3 class='text-lg font-semibold text-white mb-2'>
            {t('terms.section_9_security_title')}
          </h3>
          <p class='mb-3'>{t('terms.section_9_security_p1')}</p>

          <h3 class='text-lg font-semibold text-white mb-2'>
            {t('terms.section_9_compliance_title')}
          </h3>
          <p>{t('terms.section_9_compliance_p1')}</p>
        </section>

        <!-- Privacy Policy -->
        <section>
          <h2 class='text-xl md:text-2xl font-bold text-white mb-3 md:mb-4'>
            {t('terms.section_10_title')}
          </h2>
          <p>
            {t('terms.section_10_p1_pre')}<a
              href={localizedPath(locale, 'legal/privacy')}
              class='text-blue-400 hover:text-blue-300 underline transition-colors'
              >{t('terms.section_10_link_text')}</a
            >{t('terms.section_10_p1_post')}
          </p>
        </section>

        <!-- Warranty Disclaimers -->
        <section>
          <h2 class='text-xl md:text-2xl font-bold text-white mb-3 md:mb-4'>
            {t('terms.section_11_title')}
          </h2>
          <p class='mb-3 font-semibold text-yellow-400'>
            {t('terms.section_11_p1')}
          </p>
          <p class='mb-3'>{t('terms.section_11_p2')}</p>
          <p class='mb-3'>{t('terms.section_11_p3')}</p>
          <p class='text-sm'>{t('terms.section_11_p4')}</p>
        </section>

        <!-- Indemnification -->
        <section>
          <h2 class='text-xl md:text-2xl font-bold text-white mb-3 md:mb-4'>
            {t('terms.section_12_title')}
          </h2>
          <p>{t('terms.section_12_p1')}</p>
        </section>

        <!-- Limitation of Liability -->
        <section>
          <h2 class='text-xl md:text-2xl font-bold text-white mb-3 md:mb-4'>
            {t('terms.section_13_title')}
          </h2>
          <p class='mb-3 font-semibold'>{t('terms.section_13_p1')}</p>
          <p class='mb-3'>{t('terms.section_13_p2')}</p>
          <p class='font-semibold'>{t('terms.section_13_p3')}</p>
        </section>

        <!-- Confidentiality -->
        <section>
          <h2 class='text-xl md:text-2xl font-bold text-white mb-3 md:mb-4'>
            {t('terms.section_14_title')}
          </h2>
          <p class='mb-3'>
            <strong class='text-white'>"Confidential Information"</strong>
            {
              t('terms.section_14_p1').replace(
                '"Confidential Information" ',
                '',
              )
            }
          </p>
          <p class='mb-3'>{t('terms.section_14_p2')}</p>
          <p>{t('terms.section_14_p3')}</p>
        </section>

        <!-- Arbitration -->
        <section>
          <h2 class='text-xl md:text-2xl font-bold text-white mb-3 md:mb-4'>
            {t('terms.section_15_title')}
          </h2>
          <p class='mb-3'>{t('terms.section_15_p1')}</p>
          <p class='mb-3'>{t('terms.section_15_p2')}</p>
          <p class='mb-3'>{t('terms.section_15_p3')}</p>
          <p class='mb-3'>{t('terms.section_15_p4')}</p>
          <p>{t('terms.section_15_p5')}</p>
        </section>

        <!-- Other Provisions -->
        <section>
          <h2 class='text-xl md:text-2xl font-bold text-white mb-3 md:mb-4'>
            {t('terms.section_16_title')}
          </h2>

          <h3 class='text-lg font-semibold text-white mb-2 mt-4'>
            {t('terms.section_16_amendments_title')}
          </h3>
          <p class='mb-3'>{t('terms.section_16_amendments_p1')}</p>

          <h3 class='text-lg font-semibold text-white mb-2 mt-4'>
            {t('terms.section_16_entire_title')}
          </h3>
          <p class='mb-3'>{t('terms.section_16_entire_p1')}</p>

          <h3 class='text-lg font-semibold text-white mb-2 mt-4'>
            {t('terms.section_16_assignment_title')}
          </h3>
          <p class='mb-3'>{t('terms.section_16_assignment_p1')}</p>

          <h3 class='text-lg font-semibold text-white mb-2 mt-4'>
            {t('terms.section_16_severability_title')}
          </h3>
          <p class='mb-3'>{t('terms.section_16_severability_p1')}</p>

          <h3 class='text-lg font-semibold text-white mb-2 mt-4'>
            {t('terms.section_16_governing_title')}
          </h3>
          <p class='mb-3'>{t('terms.section_16_governing_p1')}</p>

          <h3 class='text-lg font-semibold text-white mb-2 mt-4'>
            {t('terms.section_16_notice_title')}
          </h3>
          <p class='mb-3'>
            {t('terms.section_16_notice_p1_pre')}<a
              href='mailto:support@pickmytrade.com'
              class='text-blue-400 hover:text-blue-300 underline transition-colors'
              >support@pickmytrade.com</a
            >{t('terms.section_16_notice_p1_post')}
          </p>

          <h3 class='text-lg font-semibold text-white mb-2 mt-4'>
            {t('terms.section_16_survival_title')}
          </h3>
          <p>{t('terms.section_16_survival_p1')}</p>
        </section>

        <!-- Contact -->
        <section class='text-center pt-8'>
          <p class='text-gray-400 mb-3'>
            {t('terms.contact_text')}
          </p>
          <p>
            <a
              href='mailto:support@pickmytrade.com'
              class='text-blue-400 hover:text-blue-300 transition-colors font-medium'
              >support@pickmytrade.com</a
            >
          </p>
        </section>
      </div>

      <!-- Back Link -->
      <div class='text-center mt-12 pt-8 border-t border-gray-800'>
        <a
          href='/'
          class='inline-flex items-center gap-2 text-blue-400 hover:text-blue-300 transition-colors font-medium'>
          <span>{t('terms.back_to_home')}</span>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
