/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdnjs.cloudflare.com https://fonts.googleapis.com https://www.googletagmanager.com https://www.google-analytics.com https://www.youtube.com https://s.ytimg.com https://www.clarity.ms https://scripts.clarity.ms https://pickmytrade.ladesk.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://pickmytrade.ladesk.com; img-src 'self' data: https: blob:; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com https://pickmytrade.ladesk.com data:; connect-src 'self' https://app.pickmytrade.trade https://docs.pickmytrade.trade https://blog.pickmytrade.trade https://www.google-analytics.com https://*.pickmytrade.trade https://*.pickmytrade.io https://www.clarity.ms https://*.clarity.ms https://pickmytrade.ladesk.com wss://pickmytrade.ladesk.com; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://app.pickmytrade.trade https://pickmytrade.ladesk.com; object-src 'none'; base-uri 'self'; form-action 'self' https://app.pickmytrade.trade; frame-ancestors 'self'; upgrade-insecure-requests
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  X-DNS-Prefetch-Control: on

# Static binary assets (images/fonts) are content-addressable enough to cache long-term.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Hashed build assets (JS/CSS) are content-addressable — cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Unhashed CSS/JS: 1 hour cache, then revalidate.
/*.css
  Cache-Control: public, max-age=3600, must-revalidate

/*.js
  Cache-Control: public, max-age=3600, must-revalidate

# HTML: 5 minutes, revalidate.
/*.html
  Cache-Control: public, max-age=300, must-revalidate

/sitemap-index.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600

/llms.txt
  Cache-Control: public, max-age=3600

/llms-full.txt
  Cache-Control: public, max-age=3600
